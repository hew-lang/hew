//! Behavioural tests for std::encoding::msgpack.

import std.encoding.msgpack;

import std.encoding.json;

import std.testing;

// ── from_json / to_json round-trip ────────────────────────────────────
#[test]
fn test_from_json_to_json_round_trip_int_field() {
    // Encode JSON with an integer field → MessagePack bytes → JSON string
    let packed = msgpack.from_json("{\"n\": 42}").unwrap();
    // Must have produced non-empty bytes
    testing.assert_true(packed.len() > 0);
    let recovered = msgpack.to_json(packed).unwrap();
    // The recovered JSON must re-parse successfully and contain the field
    let r = json.parse(recovered);
    match r {
        .Ok(val) => {
            let field = val.get_field("n").unwrap().unwrap();
            testing.assert_eq(field.get_int().unwrap(), 42);
        },
        .Err(_) => panic("msgpack round-trip produced unparseable JSON"),
    }
}

// ── encode_int / encode_string ────────────────────────────────────────
#[test]
fn test_encode_int_produces_nonempty_bytes() {
    let encoded = msgpack.encode_int(7).unwrap();
    testing.assert_true(encoded.len() > 0);
}

#[test]
fn test_encode_string_produces_nonempty_bytes() {
    let encoded = msgpack.encode_string("hello").unwrap();
    testing.assert_true(encoded.len() > 0);
}

// ── Error boundary ────────────────────────────────────────────────────
#[test]
fn test_try_from_json_invalid_surfaces_reason() {
    let result = msgpack.from_json("{not valid json!!!");
    match result {
        .Ok(_) => panic("expected invalid JSON to fail"),
        .Err(msg) => {
            testing.assert_true(msg.contains("msgpack:"));
            testing.assert_true(msg.contains("parse JSON"));
        },
    }
}

#[test]
fn test_try_to_json_empty_surfaces_reason() {
    // An empty buffer holds no MessagePack value at all; decoding it must
    // surface the specific reason rather than an empty JSON string.
    let result = msgpack.to_json(bytes []);
    match result {
        .Ok(_) => panic("expected empty input to fail"),
        .Err(msg) => testing.assert_true(msg.contains("invalid input buffer")),
    }
}

#[test]
fn test_try_from_json_valid_ok() {
    let result = msgpack.from_json("{\"n\": 42}");
    match result {
        .Ok(data) => testing.assert_true(data.len() > 0),
        .Err(_) => panic("expected valid JSON to succeed"),
    }
}

#[test]
fn test_try_to_json_valid_ok() {
    let packed = msgpack.from_json("{\"n\": 42}").unwrap();
    let result = msgpack.to_json(packed);
    match result {
        .Ok(recovered) => {
            let r = json.parse(recovered);
            match r {
                .Ok(val) => {
                    let field = val.get_field("n").unwrap().unwrap();
                    testing.assert_eq(field.get_int().unwrap(), 42);
                },
                .Err(_) => panic("try_to_json round-trip produced unparseable JSON"),
            }
        },
        .Err(_) => panic("expected valid msgpack bytes to succeed"),
    }
}

// ── string root round-trip ────────────────────────────────────────────
#[test]
fn test_string_root_round_trip() {
    // from_json of a JSON string (not an object) → to_json → parse →
    // re-extract the string value.
    let packed = msgpack.from_json("\"hello\"").unwrap();
    testing.assert_true(packed.len() > 0);
    let recovered = msgpack.to_json(packed).unwrap();
    let r = json.parse(recovered);
    match r {
        .Ok(val) => {
            testing.assert_eq_str(val.get_string().unwrap(), "hello");
        },
        .Err(_) => panic("msgpack string round-trip produced unparseable JSON"),
    }
}

// ── Array round-trip ──────────────────────────────────────────────────
#[test]
fn test_array_round_trip_length() {
    // from_json("[1, 2, 3]") → to_json → parse → array_len() == 3
    let packed = msgpack.from_json("[1, 2, 3]").unwrap();
    testing.assert_true(packed.len() > 0);
    let recovered = msgpack.to_json(packed).unwrap();
    let r = json.parse(recovered);
    match r {
        .Ok(val) => {
            testing.assert_eq(val.array_len().unwrap(), 3);
        },
        .Err(_) => panic("msgpack array round-trip produced unparseable JSON"),
    }
}

#[test]
fn test_array_round_trip_elements() {
    // Verify individual array element values survive the round-trip.
    let packed = msgpack.from_json("[10, 20, 30]").unwrap();
    let recovered = msgpack.to_json(packed).unwrap();
    let r = json.parse(recovered);
    match r {
        .Ok(val) => {
            let e0 = val.array_get(0).unwrap().unwrap();
            let e2 = val.array_get(2).unwrap().unwrap();
            testing.assert_eq(e0.get_int().unwrap(), 10);
            testing.assert_eq(e2.get_int().unwrap(), 30);
        },
        .Err(_) => panic("msgpack array element round-trip produced unparseable JSON"),
    }
}

// ── Nested object round-trip ──────────────────────────────────────────
#[test]
fn test_nested_object_round_trip() {
    // from_json("{\"a\": {\"b\": 7}}") → to_json → parse → walk a → b.
    // Each selected field owns an independent value with automatic cleanup.
    let packed = msgpack.from_json("{\"a\": {\"b\": 7}}").unwrap();
    testing.assert_true(packed.len() > 0);
    let recovered = msgpack.to_json(packed).unwrap();
    let r = json.parse(recovered);
    match r {
        .Ok(val) => {
            let a_val = val.get_field("a").unwrap().unwrap();
            let b_val = a_val.get_field("b").unwrap().unwrap();
            testing.assert_eq(b_val.get_int().unwrap(), 7);
        },
        .Err(_) => panic("msgpack nested object round-trip produced unparseable JSON"),
    }
}

// ── Unicode string round-trip ─────────────────────────────────────────
#[test]
fn test_unicode_string_field_round_trip() {
    // Multi-byte UTF-8 value survives msgpack encode → decode → JSON parse.
    // The JSON input uses a JSON-level \uXXXX escape (valid JSON syntax) because
    // Hew source does not support \u{NNNN} escape sequences in string literals
    // (tracked in #1675). Raw UTF-8 literals in .hew source work fine, so the
    // assertion uses "héllo" directly.
    // JSON input: {"k": "h\u00e9llo"} — \u00e9 is the JSON escape for 'é' (U+00E9).
    // After JSON parse → msgpack encode → msgpack decode → JSON serialize →
    // JSON parse, get_string() must return exactly "héllo".
    // Precision contract:
    //   - exact string equality: "héllo"
    //   - byte length 6 (h=1 + é=2 + l=1 + l=1 + o=1 in UTF-8)
    //   - ASCII anchors: starts_with("h"), ends_with("llo")
    // Any corruption of the multi-byte 'é' (U+00E9 → 0xC3 0xA9) fails at
    // least the equality and length assertions.
    let packed = msgpack.from_json("{\"k\": \"h\\u00e9llo\"}").unwrap();
    testing.assert_true(packed.len() > 0);
    let recovered = msgpack.to_json(packed).unwrap();
    let r = json.parse(recovered);
    match r {
        .Ok(val) => {
            let field = val.get_field("k").unwrap().unwrap();
            let s = field.get_string().unwrap();
            testing.assert_eq_str(s, "héllo");
            testing.assert_eq(s.len(), 6);
            testing.assert_true(s.starts_with("h"));
            testing.assert_true(s.ends_with("llo"));
        },
        .Err(_) => panic("msgpack unicode round-trip produced unparseable JSON"),
    }
}

// ── encode_int boundary cases ─────────────────────────────────────────
#[test]
fn test_encode_int_zero_produces_nonempty_bytes() {
    // msgpack positive fixint for 0 is the single byte 0x00.
    let encoded = msgpack.encode_int(0).unwrap();
    testing.assert_true(encoded.len() > 0);
}

#[test]
fn test_encode_int_negative_one_produces_nonempty_bytes() {
    // msgpack negative fixint for -1 is the single byte 0xff.
    let encoded = msgpack.encode_int(-1).unwrap();
    testing.assert_true(encoded.len() > 0);
}

#[test]
fn test_encode_int_127_produces_nonempty_bytes() {
    // 127 is the maximum positive fixint (single byte 0x7f).
    let encoded = msgpack.encode_int(127).unwrap();
    testing.assert_true(encoded.len() > 0);
}

#[test]
fn test_encode_int_zero_round_trip() {
    // Encode 0 as JSON → from_json → to_json → parse → get_int() == 0.
    let packed = msgpack.from_json("0").unwrap();
    testing.assert_true(packed.len() > 0);
    let recovered = msgpack.to_json(packed).unwrap();
    let r = json.parse(recovered);
    match r {
        .Ok(val) => {
            testing.assert_eq(val.get_int().unwrap(), 0);
        },
        .Err(_) => panic("msgpack integer 0 round-trip produced unparseable JSON"),
    }
}

// ── encode_string boundary ────────────────────────────────────────────
#[test]
fn test_encode_string_empty_produces_nonempty_bytes() {
    // msgpack empty-string marker is the single byte 0xa0, so encode_string("")
    // must produce at least 1 byte.
    let encoded = msgpack.encode_string("").unwrap();
    testing.assert_true(encoded.len() > 0);
}

// ── Codec value truth: bin framing and empty-versus-failure ───────────
#[test]
fn test_encode_bytes_frames_a_bin_not_an_array_of_integers() {
    var data: bytes = bytes.new();
    data.push(1);
    data.push(2);
    data.push(3);
    let encoded = msgpack.encode_bytes(data).unwrap();
    testing.assert_eq(encoded.len(), 5);
    testing.assert_eq_u8(encoded[0], 196); // 0xc4 bin8
    testing.assert_eq_u8(encoded[1], 3);
    testing.assert_eq_u8(encoded[2], 1);
    testing.assert_eq_u8(encoded[3], 2);
    testing.assert_eq_u8(encoded[4], 3);
}

#[test]
fn test_encode_bytes_frames_bin16_past_the_bin8_boundary() {
    var data: bytes = bytes.new();
    for _ in 0 .. 256 {
        data.push(127);
    }
    let encoded = msgpack.encode_bytes(data).unwrap();
    testing.assert_eq(encoded.len(), 259);
    testing.assert_eq_u8(encoded[0], 197); // 0xc5 bin16
    testing.assert_eq_u8(encoded[1], 1);
    testing.assert_eq_u8(encoded[2], 0);
}

#[test]
fn test_try_encode_bytes_of_an_empty_value_is_an_empty_bin_not_a_failure() {
    match msgpack.encode_bytes(bytes []) {
        .Ok(encoded) => {
            testing.assert_eq(encoded.len(), 2);
            testing.assert_eq_u8(encoded[0], 196); // 0xc4 bin8
            testing.assert_eq_u8(encoded[1], 0);
        },
        .Err(reason) => panic(f"an empty bytes value must encode: {reason}"),
    }
}

#[test]
fn test_codec_failure_does_not_leak_into_the_next_call() {
    match msgpack.from_json("{not json}") {
        .Ok(_) => panic("expected invalid JSON to fail"),
        .Err(_) => {},
    }
    match msgpack.encode_int(7) {
        .Ok(encoded) => testing.assert_gt(encoded.len(), 0),
        .Err(reason) => panic(f"a later valid call must not inherit the earlier failure: {reason}"),
    }
}

#[test]
fn test_try_to_json_rejects_a_truncated_buffer() {
    // 0x92 opens a 2-element array whose elements never arrive.
    var truncated: bytes = bytes.new();
    truncated.push(146);
    match msgpack.to_json(truncated) {
        .Ok(json) => panic(f"expected a truncated buffer to fail, got {json}"),
        .Err(reason) => testing.assert_true(reason.contains("msgpack:")),
    }
}
