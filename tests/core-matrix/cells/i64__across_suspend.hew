actor Holder {
    var ready: bool;

    receive fn hold(v: i64) -> i64 {
        sleep(2ms);
        println(f"{v}");
        ready = true;
        1
    }
}

fn main() {
    let x: i64 = 42;
    let h = spawn Holder(ready: false);
    match await h.hold(x) {
        Ok(n) => println(f"held {n}"),
        Err(_) => println("err"),
    }
}
