#[resource]
type Connection {
    id: i64,
    name: string,
}

impl Connection {
    fn close(consume self) {
        println(self.name);
    }
}

fn connection(id: i64) -> Connection {
    Connection { id: id, name: f"close {id}" }
}

impl Hash for Connection {
    fn hash(self) -> i64 {
        self.id / 10
    }
}

impl Eq for Connection {
    fn eq(self, other: Connection) -> bool {
        self.id / 10 == other.id / 10
    }
}

fn main() {
    var values: HashSet<Connection> = HashSet.new();
    assert(values.insert(connection(11)));
    assert(!values.insert(connection(12)));
    assert(values.insert(connection(22)));
    let query = connection(15);
    assert(values.contains(query));
    assert(values.remove(query));
    assert(!values.contains(query));
    values.clear();
    assert(values.is_empty());
    println("empty");
}
