type Inner {
    value: string,
}

type Holder {
    n: i64,
    inner: Inner,
}

fn run_cycle(k: i64) -> i64 {
    let h = Holder {
        n: k,
        inner: Inner { value: "skip-record-heap-payload".to_upper() },
    };
    let x = match h {
        Holder { n: x, inner: _ } => x,
    };
    x
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        total = total + run_cycle(i);
        i = i + 1;
    }
    if total >= 0 { 0 } else { 1 }
}
