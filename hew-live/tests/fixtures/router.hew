import std.stream;

actor Counter {
    var accepted: u64;

    receive fn record() {
        accepted += 1;
    }

    receive fn snapshot() -> u64 {
        accepted
    }
}

#[resource]
pub type Router {
    counter: Counter;
}

impl Router {
    fn close(consume self) {
        stop(self.counter);
        stopped(self.counter);
    }
}

pub fn create(accepted: u64) -> Router {
    Router { counter: spawn Counter { accepted: accepted } }
}

pub fn snapshot(router: Router) -> u64 {
    router.counter.snapshot().expect("counter snapshot")
}

pub fn dispose(consume router: Router) {}

extern "C" {
    fn router_destination(source: string, consume status: Sink<i64>, consume value: Sink<string>);
    fn router_emit(destination: string, body: string, consume status: Sink<i64>, consume value: Sink<string>);
}

fn destination(source: string) -> Result<Option<string>, string> {
    let (status, status_input): (Sink<i64>, Stream<i64>) = stream.pipe(1).expect("status pipe");
    let (value, value_input): (Sink<string>, Stream<string>) = stream.pipe(1).expect("value pipe");
    unsafe {
        router_destination(source, status, value);
    };
    match status_input.recv().expect("destination reply") {
        0 => .Ok(.None),
        1 => .Ok(.Some(value_input.recv().expect("destination value"))),
        _ => .Err(value_input.recv().expect("destination error")),
    }
}

fn emit(destination: string, body: string) -> Result<(), string> {
    let (status, status_input): (Sink<i64>, Stream<i64>) = stream.pipe(1).expect("status pipe");
    let (value, value_input): (Sink<string>, Stream<string>) = stream.pipe(1).expect("value pipe");
    unsafe {
        router_emit(destination, body, status, value);
    };
    if status_input.recv().expect("emit reply") == 0 {
        .Ok(())
    } else {
        .Err(value_input.recv().expect("emit error"))
    }
}

pub fn route(router: Router, source: string, body: string) -> bool {
    match destination(source).expect("destination service") {
        .None => false,
        .Some(target) => {
            emit(target, body).expect("delivery service");
            router.counter.record().expect("counter record");
            true
        }
    }
}
