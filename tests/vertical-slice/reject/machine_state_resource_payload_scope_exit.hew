// Machines are pure value evaluators and cannot carry resource identity.
#[resource]
type Handle {
    fd: i64,
}

impl Handle {
    fn close(consume self) {
        println(f"CLOSE fd={self.fd}");
    }
}

machine ConnSession {
    events {
        Connect { fd: i64, }
        ,Disconnect,
    }

    state Idle,
    state Active { h: Handle, },

    on Connect(fd): Idle => Active { h: Handle { fd: fd } }
    on Disconnect: Active => Idle,

    default { state }
}

fn main() {
    var s = ConnSession.Idle;
    let _ = s.step(ConnSessionEvent.Connect { fd: 1 });
    let _ = s.step(ConnSessionEvent.Disconnect);
}
