//! Crash details and recovery decisions for actor lifecycle hooks.
//!
//! Import `std.failure` to name `CrashInfo` or `CrashAction` explicitly
//! in a `#[on(crash)]` hook's signature. The hook observes the actor's last
//! valid state after its handlers drain and chooses the supervisor's recovery
//! action. Actor state is released after the hook returns.
//!
//! A crash hook or failed actor call receives owned diagnostic facts, including
//! an optional source site and optional captured trace.

/// Diagnostic payload passed to `#[on(crash)]` hooks.
///
/// Match `kind` to choose a recovery action. `trap` identifies a known
/// runtime failure, and `site` and `trace` are absent when unavailable. When
/// an actor cannot afford all diagnostic data, the trace is omitted first,
/// then the site; the message is empty if even it cannot be retained.
pub type CrashInfo {
    kind: CrashKind;
    trap: Option<TrapKind>;
    message: string;
    site: Option<SourceLocation>;
    trace: Option<Vec<StackFrame>>;
}

/// A captured Hew frame and its source declaration, when known.
pub type StackFrame {
    function: string;
    site: Option<SourceLocation>;
    /// Consecutive identical physical frames folded into this entry.
    repeat: i64;
}

/// The captured trace, when one was available at the failure origin.
pub fn backtrace(info: CrashInfo) -> Option<Vec<StackFrame>> {
    info.trace
}

// BEGIN GENERATED TRAP KINDS
/// A known runtime failure.
pub enum TrapKind {
    /// An actor's per-dispatch arena cap was exceeded.
    HeapExceeded;
    /// Checked integer arithmetic overflowed.
    IntegerOverflow;
    /// `/` or `%` with a zero divisor.
    DivideByZero;
    /// Signed `MIN / -1`, which is not representable.
    SignedMinDivNegOne;
    /// A shift count outside `[0, width)`.
    ShiftOutOfRange;
    /// An index or range outside its sequence.
    IndexOutOfBounds;
    /// A send to an actor that cannot accept it.
    ActorSendFailed;
    /// A machine step reached a state and event pair with no transition.
    MachineDispatchUnreachable;
    /// A `match` dispatch fell through every arm.
    ExhaustivenessFallthrough;
    /// A synthesized helper hit a compiler-invariant violation.
    ModuleInitRegexFailed;
    /// Bytes that are not a valid wire encoding of the type.
    WireDecodeFailed;
    /// A `join` branch resolved without a value.
    JoinBranchFailed;
    /// An explicit `panic`, `assert` or `expect`.
    UserPanic;
    /// A `fails` handler's error had no caller to receive it.
    ActorUnhandledFailure;
    /// An actor-owned request missed its handler-start deadline.
    ActorTimerOverdue;
    /// A call exhausted its stack, or a thread hit its stack guard.
    StackOverflow;
    /// A `fails` error escaped the program entry.
    Failed;
}
// END GENERATED TRAP KINDS

/// Recovery action returned by a `#[on(crash)]` hook.
///
/// - `Restart`: apply the child's ordinary restart policy, budget and circuit
///   breaker. A `temporary` child is not restarted.
/// - `Escalate`: transfer the failure to the parent supervisor instead of
///   restarting locally. At the root the failure remains unrecovered.
/// - `GiveUp`: permanently spend the child's role and leave the failure
///   unrecovered.
pub enum CrashAction {
    Restart;
    Escalate;
    GiveUp;
}

/// Identity reported by a monitor or link notification.
///
/// `Local` names an actor incarnation's process-local slot, `Remote` names a
/// complete remote incarnation, and `Role` names a stable local supervised
/// role when it has no current actor. Observing an occupied role selects its
/// current incarnation; a vacant-role notification does not subscribe to a
/// later replacement.
pub enum DownTarget {
    /// A process-local actor slot.
    Local(u64);
    /// A complete remote actor location.
    Remote(Location);
    /// A stable local supervised role with no current actor incarnation.
    Role(u64);
}

/// Identity and class of a crash propagated to a linked actor.
///
/// Delivered to the linked actor's `#[on(link)]` hook. Remote identities retain
/// the node, actor slot and session incarnation from the authenticated notice.
/// Signal numbers, fault addresses and other private crash details stay with
/// the crashed actor and its supervisor.
pub type CrashNotification {
    target: DownTarget;
    kind: CrashKind;
}

/// Class of an actor crash, observed by crash and link hooks.
///
/// These variants are the crash classes exposed at the link boundary; more
/// detailed runtime reasons remain private to the crashed actor and supervisor.
pub enum CrashKind {
    /// Generic crash from `panic(...)`, `hew_panic()`, or an
    /// unclassified trap (SEGV / BUS / FPE / ILL / TRAP).
    Fault;
    /// The actor's owned managed values exceeded its byte budget.
    HeapExceeded;
    /// A remote link became unreachable under its partition policy.
    PartitionDetected;
    /// A mailbox handler returned a declared error without a waiting caller.
    HandlerFailed;
    /// An actor-owned timer was discarded or missed its handler-start deadline.
    TimerOverdue;
    /// A call exhausted the actor's stack.
    StackOverflow;
}
