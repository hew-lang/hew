// Reject fixture: a remote call addresses the one receive fn taking the
// actor's `ActorMsg.Msg` and returning its `ActorMsg.Reply`. The remote wire
// carries one message value, so a multi-parameter handler is never that
// member, and the checker refuses the call rather than send a value no
// handler receives.
actor Logger {
    receive fn log_pair(code: i64, label: string) {
        println(f"[{label}] code={code}");
    }
}

impl ActorMsg for Logger {
    type Msg = i64;
    type Reply = ();
}

fn main() {
    let found: Result<RemotePid<Logger>, LookupError> = Node.lookup("logger");
    match found {
        .Ok(peer) => {
            let sent: Result<(), SendError> = peer.send(7);
            match sent {
                .Ok(_) => println("sent"),
                .Err(_) => println("send failed"),
            }
        },
        .Err(_) => println("lookup failed"),
    }
}
