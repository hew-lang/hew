type Boxed { payload: Vec<i64> }

fn make(n: i64) -> Boxed {
    var inner: Vec<i64> = Vec.new();
    inner.push(n);
    inner.push(n + 1);
    Boxed { payload: inner }
}

fn build(n: i64) -> i64 {
    let b = make(n);
    b.payload.len()
}

fn main() -> i64 {
    var total: i64 = 0;
    for i in 0..64 {
        total = total + build(i);
    }
    if total != 128 { return 62; }
    0
}
