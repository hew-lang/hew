//! Status: runnable
//! Description: Summarize a JSON order and report invalid input

import std.encoding.json;
import std.fs;
import std.io;
import std.os;

type Order {
    items: Vec<OrderItem>;
}

type OrderItem {
    units: i64;
    unit_cents: i64;
}

pub type Totals {
    units: i64;
    cents: i64;
}

fn summarize(order: Order) -> Totals fails string {
    var totals = Totals { units: 0, cents: 0 };
    for index in 0..order.items.len() {
        let item = order.items[index];
        if item.units < 0 {
            return error f"item {index + 1}: units must be non-negative";
        }
        if item.unit_cents < 0 {
            return error f"item {index + 1}: unit_cents must be non-negative";
        }
        let line_cents = item.units.checked_mul(item.unit_cents) else {
            return error f"item {index + 1}: line total is too large";
        };
        let next_units = totals.units.checked_add(item.units) else {
            return error "order contains too many units";
        };
        let next_cents = totals.cents.checked_add(line_cents) else {
            return error "order total is too large";
        };
        totals = Totals { units: next_units, cents: next_cents };
    }
    totals
}

pub fn read_order(path: string) -> Totals fails string {
    let input = fs.read(path).map_err(|error| error.fmt());
    let order = input.and_then(|text| json.decode<Order>(text).map_err(|error| error.fmt()));
    order.and_then(summarize).map_err(|error| f"{path}: {error}")?
}

fn main() -> i32 {
    let arguments = os.args();
    let path = arguments.get(1) else {
        io.write_err("usage: order_totals ORDER.json\n").expect("standard error");
        return 2;
    };
    let totals = read_order(path) handle error {
        io.write_err(f"order_totals: {error}\n").expect("standard error");
        return 1;
    };
    println(f"{totals.units} units, {totals.cents} cents");
    0
}
