// Two modules declare Key<T> with incompatible i64/string payload layouts.
// Both instantiations must return their own payloads. The mixed-owner negative
// control in run.sh also rejects substituting one declaration for the other.
import hew.keyleft;

import hew.keyright;

fn main() {
    let a: keyleft.Key<i32> = keyleft.mk(12345);
    let b: keyright.Key<i32> = keyright.mk("hello");
    println(a.v);
    println(b.v);
}
