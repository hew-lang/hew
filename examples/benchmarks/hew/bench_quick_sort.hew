fn partition(var v: Vec<i64>, low: i64, high: i64) -> (Vec<i64>, i64) {
    let pivot = v[high];
    var i = low - 1;
    var j = low;
    while j < high {
        if v[j] <= pivot {
            i = i + 1;
            let tmp = v[i];
            v.set(i, v[j]);
            v.set(j, tmp);
        }
        j = j + 1;
    }
    let tmp = v[i + 1];
    v.set(i + 1, v[high]);
    v.set(high, tmp);
    (v, i + 1)
}

fn quick_sort_range(var v: Vec<i64>, low: i64, high: i64) -> Vec<i64> {
    if low < high {
        let (partitioned, pi) = partition(v, low, high);
        v = partitioned;
        v = quick_sort_range(v, low, pi - 1);
        v = quick_sort_range(v, pi + 1, high);
    }
    v
}

fn quick_sort(var v: Vec<i64>) -> Vec<i64> {
    let n = v.len();
    if n > 1 {
        v = quick_sort_range(v, 0, n - 1);
    }
    v
}

fn make_test_array() -> Vec<i64> {
    var v: Vec<i64> = Vec.new();
    var i = 100;
    while i > 0 {
        v.push(i);
        i = i - 1;
    }
    v
}

const ITERS: i64 = 100000;

fn main() {
    for i in 0 .. ITERS {
        let v = make_test_array();
        let _ = quick_sort(v);
    }
    println(ITERS);
}
