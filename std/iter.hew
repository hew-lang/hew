//! Iterator combinators for `Vec<T>` and any `Iterator` implementation.
//!
//! This module exposes the lazy `Iterator`-based combinator API (`Map`,
//! `Filter`, `Take`, `Skip`, and the terminal helpers `fold`, `count`,
//! `collect`). Each wrapper is a `pub type` record that itself implements
//! the `Iterator` trait declared in `std/builtins.hew`, so adapters compose
//! through chained constructor calls:
//!
//! ```
//! import std.iter;
//!
//! fn main() {
//!     var v: Vec<i64> = Vec.new();
//!     v.push(1);
//!     v.push(2);
//!     v.push(3);
//!     let it = v.iter();
//!     let doubled_first_two = iter.take(iter.map(it, |x: i64| x * 2), 2);
//!     println(iter.collect(doubled_first_two).len());  // 2
//! }
//! ```
//!
//! `Iterator.next` takes a mutable receiver (`fn next(var self) -> Option<Self.Item>`).
//! A manually driven iterator needs a `var` binding; a `for` loop advances it
//! automatically. Adapters and terminal helpers consume their input iterator.
//! After passing an iterator to an adapter, use the returned adapter to continue.
//!
//! ## Lazy combinator surface
//!
//! | Wrapper       | Constructor          | Item projection                |
//! |---------------|----------------------|--------------------------------|
//! | `Map<I,A,B>`  | `map(it, f)`         | `B` from `fn(A) -> B`          |
//! | `Filter<I,A>` | `filter(it, pred)`   | `A` (subset of inner)          |
//! | `Take<I,A>`   | `take(it, n)`        | inner's `Item` (`A`)           |
//! | `Skip<I,A>`   | `skip(it, n)`        | inner's `Item` (`A`)           |
//!
//! Terminal helpers (`fold`, `count`, `collect`, `any`, `all`, `sum`,
//! `sum_f64`, `product`, `product_f64`) consume any `Iterator`. Callers
//! drive a `Vec<T>` through the lazy surface via `Vec.into_iter()`, e.g.
//! `iter.collect(iter.map(v.into_iter(), f))`.

// ---------------------------------------------------------------------------
// Lazy combinator wrappers
// ---------------------------------------------------------------------------
/// Lazy map adapter: yields `f(x)` for each item produced by the inner
/// iterator.
///
/// `A` is the inner `Item` type (carried in the type parameters so the
/// closure's input projection is explicit); `B` is the produced `Item`.
pub type Map<I, A, B> {
    iter: I,
    f: fn(A) -> B,
}

impl<I, A, B> Iterator for Map<I, A, B> where I: Iterator<Item = A> {
    type Item = B;
    fn next(var self) -> Option<B> {

        // Advance the inner iterator in place and lift the item through `f`.
        // The receiver stays whole throughout, so a failing `f` or inner
        // `next` hands this adapter back to its caller intact.
        match self.iter.next() {
            .Some(x) => Some((self.f)(x)),
            .None => None,
        }
    }
}

/// Lazy filter adapter: yields only those items for which `pred` returns
/// `true`. Inner `Item` and produced `Item` agree on `A`.
pub type Filter<I, A> {
    iter: I,
    pred: fn(A) -> bool,
}

impl<I, A> Iterator for Filter<I, A> where I: Iterator<Item = A> {
    type Item = A;
    fn next(var self) -> Option<A> {

        // Pump the inner iterator in place until `pred` accepts an item. A
        // rejected item falls out of scope at the end of its arm and is
        // released exactly once.
        loop {
            match self.iter.next() {
                .Some(x) => {
                    if (self.pred)(x) {
                        return Some(x);
                    }
                },
                .None => {
                    return None;
                },
            }
        }
    }
}

/// Lazy take adapter: yields at most `remaining` items from the inner
/// iterator, then reports `None`.
///
/// `A` is the inner `Item` type. It is carried as a direct type parameter
/// (rather than left projection-only in the impl bound) so a concrete site
/// — `Take<Countdown, i64>` — pins the item type in the record arguments, which
/// is what the cross-module monomorphisation collector keys on. Map/Filter
/// carry their item type the same way; without it a projection-only `A`
/// stays free and terminals (`count`/`collect`/`fold`) fail to monomorphise
/// (mir-gap-where-clause-proj-monomorph).
pub type Take<I, A> {
    iter: I,
    remaining: i64,
}

impl<I, A> Iterator for Take<I, A> where I: Iterator<Item = A> {
    type Item = A;
    fn next(var self) -> Option<A> {

        // Once the quota is exhausted the adapter reports `None` without
        // touching the inner iterator.
        if self.remaining <= 0 {
            return None;
        }
        self.remaining = self.remaining - 1;
        self.iter.next()
    }
}

/// Lazy skip adapter: discards the first `remaining` items, then yields
/// the rest of the inner iterator unchanged.
///
/// `A` is the inner `Item` type, carried as a direct type parameter for
/// the same monomorphisation reason as `Take` (see above): a projection-
/// only item param cannot be pinned by the collector, so terminals over
/// `Skip` fail to monomorphise.
pub type Skip<I, A> {
    iter: I,
    remaining: i64,
}

impl<I, A> Iterator for Skip<I, A> where I: Iterator<Item = A> {
    type Item = A;
    fn next(var self) -> Option<A> {

        // The first call discards the leading `remaining` items; later calls
        // find the quota spent and yield straight from the inner iterator.
        while self.remaining > 0 {
            match self.iter.next() {
                .Some(_) => {
                    self.remaining = self.remaining - 1;
                },
                .None => {
                    return None;
                },
            }
        }
        self.iter.next()
    }
}

/// Lazy enumerate adapter: pairs each item with its zero-based position.
///
/// The index advances only when the inner iterator yields an item, so an
/// exhausted iterator remains exhausted without manufacturing a final index.
pub type Enumerate<I, A> {
    iter: I,
    index: i64,
}

impl<I, A> Iterator for Enumerate<I, A> where I: Iterator<Item = A> {
    type Item = (i64, A);
    fn next(var self) -> Option<(i64, A)> {
        match self.iter.next() {
            .Some(item) => {
                let index = self.index;
                self.index = self.index + 1;
                Some((index, item))
            },
            .None => None,
        }
    }
}

// ── lazy constructors ────────────────────────────────────────────────────
/// Construct a lazy `Map` adapter over `it` applying `f` to each item.
pub fn map<I, A, B>(consume it: I, consume f: fn(A) -> B) -> Map<I, A, B> where I: Iterator<Item = A> {
    Map { iter: it, f: f }
}

/// Construct a lazy `Filter` adapter over `it` keeping items for which
/// `pred` returns `true`.
pub fn filter<I, A>(consume it: I, consume pred: fn(A) -> bool) -> Filter<I, A> where I: Iterator<Item = A> {
    Filter { iter: it, pred: pred }
}

/// Construct a lazy `Take` adapter that yields at most `n` items from
/// `it`.
pub fn take<I, A>(consume it: I, n: i64) -> Take<I, A> where I: Iterator<Item = A> {
    Take { iter: it, remaining: n }
}

/// Construct a lazy `Skip` adapter that discards the first `n` items
/// from `it`.
pub fn skip<I, A>(consume it: I, n: i64) -> Skip<I, A> where I: Iterator<Item = A> {
    Skip { iter: it, remaining: n }
}

/// Construct a lazy `Enumerate` adapter over `it`.
pub fn enumerate<I, A>(consume it: I) -> Enumerate<I, A> where I: Iterator<Item = A> {
    Enumerate { iter: it, index: 0 }
}

// ── terminal helpers ─────────────────────────────────────────────────────
//
// Each helper rebinds its iterator argument as `var` so the receiver of
// `next()` (the `Iterator::next(var self)` shape) writes its advanced state
// back across loop iterations, then drives the inner iterator to exhaustion.
// `<I as Iterator>::Item` projects to the bound's `A`, so the loop sees `A`
// items directly.
/// Left-fold over `it`: walk every item applying `f(acc, item)` and
/// return the accumulated value.
pub fn fold<I, A, B>(consume it: I, init: B, f: fn(B, A) -> B) -> B where I: Iterator<Item = A> {
    var acc = init;
    var iter = it;
    loop {
        match iter.next() {
            .Some(x) => {
                acc = f(acc, x);
            },
            .None => {
                break;
            },
        }
    }
    acc
}

/// Return the number of items produced by `it`.
pub fn count<I, A>(consume it: I) -> i64 where I: Iterator<Item = A> {
    var n: i64 = 0;
    var iter = it;
    loop {
        match iter.next() {
            .Some(_) => {
                n = n + 1;
            },
            .None => {
                break;
            },
        }
    }
    n
}

/// Collect every item produced by `it` into a `Vec<A>`.
pub fn collect<I, A>(consume it: I) -> Vec<A> where I: Iterator<Item = A> {
    var out: Vec<A> = Vec.new();
    var iter = it;
    loop {
        match iter.next() {
            .Some(x) => {
                out.push(x);
            },
            .None => {
                break;
            },
        }
    }
    out
}

/// Return `true` if `f` returns `true` for at least one item produced by
/// `it`. Short-circuits on the first match.
pub fn any<I, A>(consume it: I, f: fn(A) -> bool) -> bool where I: Iterator<Item = A> {
    var iter = it;
    loop {
        match iter.next() {
            .Some(x) => {
                if f(x) {
                    return true;
                }
            },
            .None => {
                break;
            },
        }
    }
    false
}

/// Return `true` if `f` returns `true` for every item produced by `it`.
/// Short-circuits on the first non-match.
pub fn all<I, A>(consume it: I, f: fn(A) -> bool) -> bool where I: Iterator<Item = A> {
    var iter = it;
    loop {
        match iter.next() {
            .Some(x) => {
                if !f(x) {
                    return false;
                }
            },
            .None => {
                break;
            },
        }
    }
    true
}

/// Return the first item for which `pred` returns `true`, or `None`.
///
/// Like `any`, this short-circuits as soon as the predicate matches; items
/// observed before the match are released by their lexical match arms.
pub fn find<I, A>(consume it: I, pred: fn(A) -> bool) -> Option<A> where I: Iterator<Item = A> {
    var iter = it;
    loop {
        match iter.next() {
            .Some(item) => {
                if pred(item) {
                    return Some(item);
                }
            },
            .None => {
                return None;
            },
        }
    }
}

// VecIter method surface ---------------------------------------------------
//
// These are deliberately thin wrappers. `std.iter` remains the sole place
// that defines adapter state machines and terminal semantics; spelling an
// operation as `cursor.map(f)` selects exactly the same implementation as
// `iter.map(cursor, f)`.
impl<T> VecIter<T> {
    pub fn map<U>(consume self, consume f: fn(T) -> U) -> Map<VecIter<T>, T, U> {
        map(self, f)
    }
    pub fn filter(consume self, consume pred: fn(T) -> bool) -> Filter<VecIter<T>, T> {
        filter(self, pred)
    }
    pub fn fold<U>(consume self, init: U, f: fn(U, T) -> U) -> U {
        fold(self, init, f)
    }
    pub fn any(consume self, pred: fn(T) -> bool) -> bool {
        any(self, pred)
    }
    pub fn all(consume self, pred: fn(T) -> bool) -> bool {
        all(self, pred)
    }
    pub fn find(consume self, pred: fn(T) -> bool) -> Option<T> {
        find(self, pred)
    }
    pub fn count(consume self) -> i64 {
        count(self)
    }
    pub fn enumerate(consume self) -> Enumerate<VecIter<T>, T> {
        enumerate(self)
    }
    pub fn take(consume self, n: i64) -> Take<VecIter<T>, T> {
        take(self, n)
    }
    pub fn skip(consume self, n: i64) -> Skip<VecIter<T>, T> {
        skip(self, n)
    }
    pub fn collect(consume self) -> Vec<T> {
        collect(self)
    }
}

// Adapter method surface -----------------------------------------------
//
// Each lazy adapter (`Map`, `Filter`, `Take`, `Skip`, `Enumerate`) gets the
// same thin-wrapper method surface as `VecIter` above, so a chain like
// `v.into_iter().filter(pred).map(f).collect()` keeps dispatching through
// method syntax at every stage instead of only the first one. Every method
// here forwards to the matching free function; the where-clause on each
// `impl` block matches the adapter's own `Iterator` impl exactly, which is
// what lets the free functions' `I: Iterator<Item = A>` bound resolve for
// `self`.
impl<I, A, B> Map<I, A, B> where I: Iterator<Item = A> {
    pub fn map<C>(consume self, consume f: fn(B) -> C) -> Map<Map<I, A, B>, B, C> {
        map(self, f)
    }
    pub fn filter(consume self, consume pred: fn(B) -> bool) -> Filter<Map<I, A, B>, B> {
        filter(self, pred)
    }
    pub fn fold<C>(consume self, init: C, f: fn(C, B) -> C) -> C {
        fold(self, init, f)
    }
    pub fn any(consume self, pred: fn(B) -> bool) -> bool {
        any(self, pred)
    }
    pub fn all(consume self, pred: fn(B) -> bool) -> bool {
        all(self, pred)
    }
    pub fn find(consume self, pred: fn(B) -> bool) -> Option<B> {
        find(self, pred)
    }
    pub fn count(consume self) -> i64 {
        count(self)
    }
    pub fn enumerate(consume self) -> Enumerate<Map<I, A, B>, B> {
        enumerate(self)
    }
    pub fn take(consume self, n: i64) -> Take<Map<I, A, B>, B> {
        take(self, n)
    }
    pub fn skip(consume self, n: i64) -> Skip<Map<I, A, B>, B> {
        skip(self, n)
    }
    pub fn collect(consume self) -> Vec<B> {
        collect(self)
    }
}

impl<I, A> Filter<I, A> where I: Iterator<Item = A> {
    pub fn map<B>(consume self, consume f: fn(A) -> B) -> Map<Filter<I, A>, A, B> {
        map(self, f)
    }
    pub fn filter(consume self, consume pred: fn(A) -> bool) -> Filter<Filter<I, A>, A> {
        filter(self, pred)
    }
    pub fn fold<B>(consume self, init: B, f: fn(B, A) -> B) -> B {
        fold(self, init, f)
    }
    pub fn any(consume self, pred: fn(A) -> bool) -> bool {
        any(self, pred)
    }
    pub fn all(consume self, pred: fn(A) -> bool) -> bool {
        all(self, pred)
    }
    pub fn find(consume self, pred: fn(A) -> bool) -> Option<A> {
        find(self, pred)
    }
    pub fn count(consume self) -> i64 {
        count(self)
    }
    pub fn enumerate(consume self) -> Enumerate<Filter<I, A>, A> {
        enumerate(self)
    }
    pub fn take(consume self, n: i64) -> Take<Filter<I, A>, A> {
        take(self, n)
    }
    pub fn skip(consume self, n: i64) -> Skip<Filter<I, A>, A> {
        skip(self, n)
    }
    pub fn collect(consume self) -> Vec<A> {
        collect(self)
    }
}

impl<I, A> Take<I, A> where I: Iterator<Item = A> {
    pub fn map<B>(consume self, consume f: fn(A) -> B) -> Map<Take<I, A>, A, B> {
        map(self, f)
    }
    pub fn filter(consume self, consume pred: fn(A) -> bool) -> Filter<Take<I, A>, A> {
        filter(self, pred)
    }
    pub fn fold<B>(consume self, init: B, f: fn(B, A) -> B) -> B {
        fold(self, init, f)
    }
    pub fn any(consume self, pred: fn(A) -> bool) -> bool {
        any(self, pred)
    }
    pub fn all(consume self, pred: fn(A) -> bool) -> bool {
        all(self, pred)
    }
    pub fn find(consume self, pred: fn(A) -> bool) -> Option<A> {
        find(self, pred)
    }
    pub fn count(consume self) -> i64 {
        count(self)
    }
    pub fn enumerate(consume self) -> Enumerate<Take<I, A>, A> {
        enumerate(self)
    }
    pub fn take(consume self, n: i64) -> Take<Take<I, A>, A> {
        take(self, n)
    }
    pub fn skip(consume self, n: i64) -> Skip<Take<I, A>, A> {
        skip(self, n)
    }
    pub fn collect(consume self) -> Vec<A> {
        collect(self)
    }
}

impl<I, A> Skip<I, A> where I: Iterator<Item = A> {
    pub fn map<B>(consume self, consume f: fn(A) -> B) -> Map<Skip<I, A>, A, B> {
        map(self, f)
    }
    pub fn filter(consume self, consume pred: fn(A) -> bool) -> Filter<Skip<I, A>, A> {
        filter(self, pred)
    }
    pub fn fold<B>(consume self, init: B, f: fn(B, A) -> B) -> B {
        fold(self, init, f)
    }
    pub fn any(consume self, pred: fn(A) -> bool) -> bool {
        any(self, pred)
    }
    pub fn all(consume self, pred: fn(A) -> bool) -> bool {
        all(self, pred)
    }
    pub fn find(consume self, pred: fn(A) -> bool) -> Option<A> {
        find(self, pred)
    }
    pub fn count(consume self) -> i64 {
        count(self)
    }
    pub fn enumerate(consume self) -> Enumerate<Skip<I, A>, A> {
        enumerate(self)
    }
    pub fn take(consume self, n: i64) -> Take<Skip<I, A>, A> {
        take(self, n)
    }
    pub fn skip(consume self, n: i64) -> Skip<Skip<I, A>, A> {
        skip(self, n)
    }
    pub fn collect(consume self) -> Vec<A> {
        collect(self)
    }
}

impl<I, A> Enumerate<I, A> where I: Iterator<Item = A> {
    pub fn map<B>(consume self, consume f: fn((i64, A)) -> B) -> Map<Enumerate<I, A>, (i64, A), B> {
        map(self, f)
    }
    pub fn filter(consume self, consume pred: fn((i64, A)) -> bool) -> Filter<Enumerate<I, A>, (i64, A)> {
        filter(self, pred)
    }
    pub fn fold<B>(consume self, init: B, f: fn(B, (i64, A)) -> B) -> B {
        fold(self, init, f)
    }
    pub fn any(consume self, pred: fn((i64, A)) -> bool) -> bool {
        any(self, pred)
    }
    pub fn all(consume self, pred: fn((i64, A)) -> bool) -> bool {
        all(self, pred)
    }
    pub fn find(consume self, pred: fn((i64, A)) -> bool) -> Option<(i64, A)> {
        find(self, pred)
    }
    pub fn count(consume self) -> i64 {
        count(self)
    }
    pub fn take(consume self, n: i64) -> Take<Enumerate<I, A>, (i64, A)> {
        take(self, n)
    }
    pub fn skip(consume self, n: i64) -> Skip<Enumerate<I, A>, (i64, A)> {
        skip(self, n)
    }
    pub fn collect(consume self) -> Vec<(i64, A)> {
        collect(self)
    }
}

/// Return the sum of every `i64` item produced by `it`.
pub fn sum<I>(consume it: I) -> i64 where I: Iterator<Item = i64> {
    fold(it, 0, |acc: i64, x: i64| acc + x)
}

/// Return the sum of every `f64` item produced by `it`.
pub fn sum_f64<I>(consume it: I) -> f64 where I: Iterator<Item = f64> {
    fold(it, 0.0, |acc: f64, x: f64| acc + x)
}

/// Return the product of every `i64` item produced by `it`. Returns `1`
/// for an empty iterator (the multiplicative identity).
pub fn product<I>(consume it: I) -> i64 where I: Iterator<Item = i64> {
    fold(it, 1, |acc: i64, x: i64| acc * x)
}

/// Return the product of every `f64` item produced by `it`. Returns `1.0`
/// for an empty iterator (the multiplicative identity).
pub fn product_f64<I>(consume it: I) -> f64 where I: Iterator<Item = f64> {
    fold(it, 1.0, |acc: f64, x: f64| acc * x)
}
