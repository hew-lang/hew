// Selected values and captured copies survive their parent's lexical scope.
import std.encoding.json;

fn early_exit(flag: bool) {
    var value = json.object();
    value.set("n", json.from_int(11)).expect("set succeeds");
    let child = value.get_field("n").expect("get_field succeeds").expect("get_field returns a value");
    if flag {
        return;
    }
    println(child.get_int().expect("get_int succeeds"));
}

fn _panic_exit() {
    var value = json.object();
    value.set("n", json.from_int(12)).expect("set succeeds");
    let _child = value.get_field("n").expect("get_field succeeds").expect("get_field returns a value");
    panic("json value panic probe");
}

fn cancel_exit() {
    var value = json.object();
    value.set("n", json.from_int(13)).expect("set succeeds");
    let _child = value.get_field("n").expect("get_field succeeds").expect("get_field returns a value");
    var i: i64 = 0;
    while i < 2 {
        i = i + 1;
    }
}

actor JsonCancelDriver {
    receive fn drive() {
        scope {
            cancel_exit();
        };
    }
}

fn main() {
    let (read, keys) = {
        var value = json.object();
        value.set("n", json.from_int(7)).expect("set succeeds");
        value.set("flag", json.from_bool(true)).expect("set succeeds");
        let child = value.get_field("n").expect("get_field succeeds").expect("get_field returns a value");
        (|| child.get_int().expect("get_int succeeds"), value.keys().expect("keys succeeds"))
    };
    println(read());
    println(keys.array_len().expect("array_len succeeds"));

    // A parse failure returns an error without an owning value payload.
    match json.parse("{") {
        .Ok(_) => panic("malformed JSON unexpectedly parsed"),
        .Err(_) => {},
    }
    early_exit(true);
}
