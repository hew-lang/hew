//! Checked HTTP service using the suspending network API and HTTP codec.
//! The comparison deliberately uses one HTTP/1.1 request per connection.
import std.os;
import std.net;
import std.net.http.codec;
import std.encoding.utf8;
import std.stream;

fn terms(seed: i64, first: i64, end: i64) -> i64 {
    var total = 0;
    for index in first..end {
        total += (seed + index) % 251;
    }
    total
}

fn dependency(body: string) -> Result<string, string> {
    let address = match os.env("BENCH_BACKEND") {
        .Some(value) => value,
        .None => return .Err("BENCH_BACKEND is required for /io"),
    };
    let connection = match net.connect_timeout(address, 10s) {
        .Ok(value) => value,
        .Err(error) => return .Err(f"dependency connect failed: {error}"),
    };
    if let .Err(error) = connection.set_read_timeout(10s) {
        return .Err(f"dependency read timeout setup failed: {error}");
    }
    if let .Err(error) = connection.set_write_timeout(10s) {
        return .Err(f"dependency write timeout setup failed: {error}");
    }
    let request = match codec.build_request("POST", address, "/echo", body, "application/octet-stream") {
        .Ok(value) => value,
        .Err(error) => return .Err(f"dependency request build failed: {error}"),
    };
    if let .Err(_) = connection.send(request.to_bytes()) {
        return .Err("dependency request send failed");
    }
    var raw = "";
    loop {
        match connection.recv() {
            .Some(chunk) => {
                match utf8.decode(chunk) {
                    .Ok(text) => {
                        raw += text;
                    }
                    .Err(_) => return .Err("dependency response is not valid UTF-8"),
                }
            }
            .None => break,
        }
    }
    match codec.parse_response(raw) {
        .Ok(.Some(response)) => {
            if response.status() == 200 && response.body() == body {
                .Ok(body)
            } else {
                .Err(f"dependency response mismatch: status {response.status()}")
            }
        }
        .Ok(.None) => .Err("dependency response was incomplete"),
        .Err(error) => .Err(f"dependency response parse failed: {error}"),
    }
}

fn reply(consume connection: net.Connection, status: i64, body: string) {
    let response = match codec.response_text(status, body) {
        .Ok(value) => value,
        .Err(_) => {
            connection.close();
            return;
        }
    };
    let _ = connection.send(response.to_bytes());
    connection.close();
}

fn answer(path: string, body: string) -> (i64, string) {
    if body.len() != 64 {
        return (400, "expected 64 ASCII bytes");
    }
    for byte in body.to_bytes() {
        if (byte as i64) > 127 {
            return (400, "expected ASCII bytes");
        }
    }
    let seed = body.to_bytes()[0] as i64;
    match path {
        "/echo" => (200, body),
        "/io" => {
            match dependency(body) {
                .Ok(response) => (200, response),
                .Err(error) => (502, f"backend I/O failed: {error}"),
            }
        }
        "/wait" => {
            sleep(5ms);
            (200, body)
        }
        "/compute" => {
            let total = terms(seed, 0, 200000);
            (200, f"{body}:{total}")
        }
        "/fanout" => {
            var tasks = [fork terms(seed, 0, 25000)];
            for shard in 1..8 {
                tasks.push(fork terms(seed, shard * 25000, (shard + 1) * 25000));
            }
            let values = await tasks;
            var total = 0;
            for value in values {
                total += value;
            }
            (200, f"{body}:{total}")
        }
        _ => (404, "not found"),
    }
}

fn serve(consume connection: net.Connection) {
    if let .Err(_) = connection.set_read_timeout(10s) {
        connection.close();
        return;
    }
    if let .Err(_) = connection.set_write_timeout(10s) {
        connection.close();
        return;
    }
    var raw = "";
    // recv exposes orderly EOF as None; transport errors trap in the public API.
    while !codec.request_complete(raw) {
        match connection.recv() {
            .Some(chunk) => {
                match utf8.decode(chunk) {
                    .Ok(text) => {
                        raw += text;
                    }
                    .Err(_) => {
                        reply(connection, 400, "expected ASCII bytes");
                        return;
                    }
                }
                if codec.over_limit(raw) {
                    reply(connection, 413, "request too large");
                    return;
                }
            }
            .None => {
                // EOF before a complete request is parsed as incomplete below.
                // Sending its 400 response is best-effort when the peer has left.
                break;
            }
        }
    }
    let (status, body) = match codec.parse_request(raw) {
        .Ok(.Some(request)) => {
            if request.method() == "POST" {
                answer(request.path(), request.body())
            } else {
                (405, "method not allowed")
            }
        }
        .Ok(.None) => (400, "incomplete request"),
        .Err(error) => (error.status(), "invalid request"),
    };
    reply(connection, status, body);
}

fn worker(consume input: stream.Stream<net.Connection>) {
    loop {
        match input.recv() {
            .Some(connection) => serve(connection),
            .None => return,
        }
    }
}

fn main() {
    let address = os.env("BENCH_BIND") ?? "127.0.0.1:18080";
    let listener = net.listen(address).expect("listen");
    let (first_sink, first_input): (stream.Sink<net.Connection>, stream.Stream<net.Connection>) = stream.pipe(1).expect("worker pipe");
    var sinks = [first_sink];
    var workers = [fork worker(first_input)];
    for _ in 1..32 {
        let (sink, input): (stream.Sink<net.Connection>, stream.Stream<net.Connection>) = stream.pipe(1).expect("worker pipe");
        sinks.push(sink);
        workers.push(fork worker(input));
    }
    println(f"READY {address}");
    var next = 0;
    loop {
        let connection = listener.accept().expect("accept");
        sinks[next].send(connection).expect("worker admission");
        next = (next + 1) % 32;
    }
}
