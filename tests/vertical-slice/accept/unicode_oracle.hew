import std.iter;

fn main() {
    println(f"upper_A={(65).try_to_char().expect("scalar").is_upper()} upper_eacute={(201).try_to_char().expect("scalar").is_upper()} lower_A={(65).try_to_char().expect("scalar").is_lower()}");
    println(f"lower_a={(97).try_to_char().expect("scalar").is_lower()} lower_eacute={(233).try_to_char().expect("scalar").is_lower()} upper_a={(97).try_to_char().expect("scalar").is_upper()}");
    println(f"space_tab={(9).try_to_char().expect("scalar").is_whitespace()} space_nbsp={(160).try_to_char().expect("scalar").is_whitespace()} space_A={(65).try_to_char().expect("scalar").is_whitespace()}");
    println(f"letter_A={(65).try_to_char().expect("scalar").is_letter()} letter_cjk={(26085).try_to_char().expect("scalar").is_letter()} letter_digit={(49).try_to_char().expect("scalar").is_letter()}");
    println(f"letter_latin_ext_add={(0x1E17).try_to_char().expect("scalar").is_letter()} lower_latin_ext_add={(0x1E17).try_to_char().expect("scalar").is_lower()} upper_latin_ext_add={(0x1E17).try_to_char().expect("scalar").to_upper().as_i64()}");
    println(f"letter_thai={(0xE01).try_to_char().expect("scalar").is_letter()} letter_armenian={(0x531).try_to_char().expect("scalar").is_letter()} letter_cjk_ext_b={(0x20000).try_to_char().expect("scalar").is_letter()}");
    println(f"punct_bang={(33).try_to_char().expect("scalar").is_punctuation()} punct_ideo={(12290).try_to_char().expect("scalar").is_punctuation()} punct_A={(65).try_to_char().expect("scalar").is_punctuation()}");
    println(f"punct_pc={(0x5F).try_to_char().expect("scalar").is_punctuation()} punct_pd={(0x2E17).try_to_char().expect("scalar").is_punctuation()} punct_ps={(0x2045).try_to_char().expect("scalar").is_punctuation()} punct_pe={(0x2046).try_to_char().expect("scalar").is_punctuation()}");
    println(f"punct_pi={(0x2018).try_to_char().expect("scalar").is_punctuation()} punct_pf={(0x2019).try_to_char().expect("scalar").is_punctuation()} punct_po={(0x589).try_to_char().expect("scalar").is_punctuation()} punct_astral={(0x10100).try_to_char().expect("scalar").is_punctuation()}");
    println(f"punct_u18_2e60={(0x2E60).try_to_char().expect("scalar").is_punctuation()} punct_u18_2e61={(0x2E61).try_to_char().expect("scalar").is_punctuation()} punct_u18_2e62={(0x2E62).try_to_char().expect("scalar").is_punctuation()} punct_u18_2e63={(0x2E63).try_to_char().expect("scalar").is_punctuation()}");
    println(f"punct_sm={(0x2B).try_to_char().expect("scalar").is_punctuation()} punct_sc={(0x24).try_to_char().expect("scalar").is_punctuation()} punct_surrogate={(0xD800).try_to_char().is_some()} punct_wrapped={(4294967329).try_to_char().is_some()}");
    println(f"title_a={(97).try_to_char().expect("scalar").to_title().as_i64()} title_eacute={(233).try_to_char().expect("scalar").to_title().as_i64()} title_digit={(49).try_to_char().expect("scalar").to_title().as_i64()}");
    let ascii_width = (65).try_to_char().expect("scalar").len_utf8();
    let latin_width = (233).try_to_char().expect("scalar").len_utf8();
    let cjk_width = (26085).try_to_char().expect("scalar").len_utf8();
    let emoji_width = (128578).try_to_char().expect("scalar").len_utf8();
    println(f"rune_len={ascii_width},{latin_width},{cjk_width},{emoji_width}");
    let text = "Aé日🙂";
    let rs = iter.collect(text.iter());
    println(f"rune_count={text.len()} runes_len={rs.len()}");
    println(f"runes={rs[0].as_i64()},{rs[1].as_i64()},{rs[2].as_i64()},{rs[3].as_i64()}");
    let first = text.get(0).expect("scalar").as_i64();
    let second = text.get(1).expect("scalar").as_i64();
    let third = text.get(2).expect("scalar").as_i64();
    let fourth = text.get(3).expect("scalar").as_i64();
    println(f"codepoint_at={first},{second},{third},{fourth}");
    let empty_text = "";
    let empty = iter.collect(empty_text.iter());
    println(f"empty_rune_count={empty_text.len()} empty_runes_len={empty.len()}");
}
