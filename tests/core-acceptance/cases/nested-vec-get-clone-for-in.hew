fn frame() -> i64 {
    var vv: [[i64]] = [];
    vv.push([1, 2, 3]);
    vv.push([4, 5, 6]);
    let inner = vv[0];
    var sum: i64 = 0;
    for v in inner { sum = sum + v; }
    sum
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        total = total + frame();
        i = i + 1;
    }
    if total < 0 { 72 } else { 0 }
}
