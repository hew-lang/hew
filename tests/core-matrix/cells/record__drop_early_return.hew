#[resource]
type Tok {
    id: i64
}

impl Tok {
    fn close(self) {
        println(f"close {self.id}");
    }
}

type ResRec {
    t: Tok,
}

fn run(early: bool) -> i64 {
    let h = ResRec { t: Tok { id: 1 } };
    if early {
        println("early");
        return 1;
    }
    println("late");
    2
}

fn main() {
    let n = run(true);
    println(f"n={n}");
}
