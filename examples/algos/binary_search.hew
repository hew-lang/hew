// Find a value in a sorted list. The remaining candidates occupy [low, high).
fn binary_search(values: Vec<i64>, target: i64) -> Option<i64> {
    var low = 0;
    var high = values.len();
    while low < high {
        let middle = low + (high - low) / 2;
        let value = values[middle];
        if value == target {
            return .Some(middle);
        }
        if value < target {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    .None
}

fn main() {
    let values = [2, 5, 8, 12, 16, 23, 38, 56, 72, 91];
    for target in [23, 10] {
        match binary_search(values, target) {
            .Some(index) => println(f"{target} is at index {index}"),
            .None => println(f"{target} is missing"),
        }
    }
    assert(binary_search(values, 2) == .Some(0));
    assert(binary_search(values, 91) == .Some(9));
    assert(binary_search([], 5).is_none());
    assert(binary_search([42], 42) == .Some(0));
    assert(binary_search([42], 99).is_none());
}
