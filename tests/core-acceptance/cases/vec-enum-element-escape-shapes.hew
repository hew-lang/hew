enum Colour { Red, Green, Blue, }

fn tag(c: Colour) -> i64 {
    match c {
        Colour.Red => 1,
        Colour.Green => 2,
        Colour.Blue => 3,
    }
}

fn make() -> Vec<Colour> {
    var v: Vec<Colour> = Vec.new();
    v.push(Colour.Green);
    v.push(Colour.Blue);
    return v;
}

fn total(xs: Vec<Colour>) -> i64 {
    tag(xs[0]) + tag(xs[1])
}

fn main() {
    let made = make();
    let a = tag(made[0]) + tag(made[1]);
    var v: Vec<Colour> = Vec.new();
    v.push(Colour.Blue);
    v.push(Colour.Blue);
    let b = total(v);
    print(a + b);
    print("OK");
}
