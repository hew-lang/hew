// Re-initialisation is the escape hatch for a consumed actor state field: the
// handler plugs the hole it made, so the next message finds an owned socket.
// An assignment target is written, not read, which is what lets the moved-out
// place be named on the left-hand side.
#[resource]
type Socket {
    fd: i64;
}

impl Socket {
    fn close(consuming self) {}
    fn detach(consuming self) -> i64 {
        self.fd
    }
}

actor Vault {
    var sock: Socket;
    receive fn swap() -> i64 {
        let fd = sock.detach();
        sock = Socket { fd: fd + 1 };
        return fd;
    }
}

fn main() {
    let vault = spawn Vault(sock: Socket { fd: 3 });
    match await vault.swap() {
        .Ok(v) => println(f"first={v}"),
        .Err(_) => println("swap failed"),
    }
    match await vault.swap() {
        .Ok(v) => println(f"second={v}"),
        .Err(_) => println("swap failed"),
    }
}
