// A live string needs a retain; a fresh string transfers its existing owner;
// the integer payload uses a bit copy. The report reads these verified facts.
actor Printer {
    receive fn print_message(msg: string) {}
}

actor Counter {
    receive fn increment(amount: i64) {}
}

fn main() {
    let printer = spawn Printer;
    let counter = spawn Counter;
    let greeting = "hello";
    let _ = printer.print_message(greeting);
    println(greeting);
    let _ = printer.print_message("fresh");
    let _ = counter.increment(42);
}
