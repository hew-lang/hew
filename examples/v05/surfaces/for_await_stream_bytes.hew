//! Status: runnable (v0.5 for-await over Stream<bytes>)
//! Description: Drains a byte stream with `for await`.

import std.encoding.utf8;

import std.stream;

actor DrainBytes {
    let frames: i64,

    receive fn run(unused: i64) {
        let (sink, input) = match stream.bytes_pipe(8) {
            .Ok(pair) => pair,
            .Err(error) => panic(error),
        };
        for i in 0 .. frames {
            let frame = f"frame-{i}".to_bytes();
            await sink.send(frame);
        }
        sink.close();
        for await frame in input {
            let decoded_frame = utf8.decode(frame) handle error {
                println(f"invalid UTF-8: {error}");
                return;
            };
            println(f"recv {decoded_frame}");
        }
        println("done");
    }
}

fn main() {
    let worker = spawn DrainBytes(frames: 3);
    worker.run(0);
    sleep(500ms);
}
