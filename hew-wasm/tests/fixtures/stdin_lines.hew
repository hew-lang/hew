import std.io;

fn main() {
    let first = io.read_line() ?? "<none>";
    let second = io.read_line() ?? "<none>";
    println(f"first=[{first}] second=[{second}]");
    let rest = io.read_all();
    println(f"rest=[{rest}]");
    match io.read_line() {
        .Some(line) => println(f"after=[{line}]"),
        .None => println("after end"),
    }
}
