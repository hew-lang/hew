fn make_vec(n: i64) -> Vec<bool> {
    var v: Vec<bool> = Vec.new();
    v.push(true);
    v.push(false);
    return v;
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        for b in make_vec(i) {
            if b {
                total = total + 1;
            }
        }
        i = i + 1;
    }
    total
}
