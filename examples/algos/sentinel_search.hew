// Sentinel Search - place target at end to eliminate bounds check in loop
//
// `arr` is this function's own copy, so writing the sentinel into it cannot
// disturb the caller's vector, and the copy is dropped when the search
// returns, so nothing has to be restored.
fn sentinel_search(var arr: Vec<i64>, target: i64) -> i64 {
    let n = arr.len();
    if n == 0 {
        return 0 - 1;
    }
    // Save last element and replace with target (sentinel)
    let last = arr[n - 1];
    arr.set(n - 1, target);
    var i = 0;
    while arr[i] != target {
        i = i + 1;
    }
    if i < n - 1 {
        return i;
    }
    if last == target {
        return n - 1;
    }
    0 - 1
}

fn main() {
    var passed = 0;
    var failed = 0;
    // Test 1: find element in middle
    let v1: Vec<i64> = [10, 20, 30, 40, 50];
    let r1 = sentinel_search(v1, 30);
    if r1 == 2 {
        println("Test 1 - find middle: PASS");
        passed = passed + 1;
    } else {
        print("Test 1 - find middle: FAIL (got ");
        print(r1);
        println(")");
        failed = failed + 1;
    }
    // Test 2: find first element
    let v2: Vec<i64> = [10, 20, 30];
    let r2 = sentinel_search(v2, 10);
    if r2 == 0 {
        println("Test 2 - find first: PASS");
        passed = passed + 1;
    } else {
        print("Test 2 - find first: FAIL (got ");
        print(r2);
        println(")");
        failed = failed + 1;
    }
    // Test 3: find last element
    let v3: Vec<i64> = [10, 20, 30];
    let r3 = sentinel_search(v3, 30);
    if r3 == 2 {
        println("Test 3 - find last: PASS");
        passed = passed + 1;
    } else {
        print("Test 3 - find last: FAIL (got ");
        print(r3);
        println(")");
        failed = failed + 1;
    }
    // Test 4: not found
    let v4: Vec<i64> = [10, 20, 30];
    let r4 = sentinel_search(v4, 99);
    if r4 == 0 - 1 {
        println("Test 4 - not found: PASS");
        passed = passed + 1;
    } else {
        print("Test 4 - not found: FAIL (got ");
        print(r4);
        println(")");
        failed = failed + 1;
    }
    // Test 5: empty array
    let v5: Vec<i64> = Vec.new();
    let r5 = sentinel_search(v5, 5);
    if r5 == 0 - 1 {
        println("Test 5 - empty array: PASS");
        passed = passed + 1;
    } else {
        print("Test 5 - empty array: FAIL (got ");
        print(r5);
        println(")");
        failed = failed + 1;
    }
    // Test 6: single element found
    let v6: Vec<i64> = [42];
    let r6 = sentinel_search(v6, 42);
    if r6 == 0 {
        println("Test 6 - single found: PASS");
        passed = passed + 1;
    } else {
        print("Test 6 - single found: FAIL (got ");
        print(r6);
        println(")");
        failed = failed + 1;
    }
    // Test 7: single element not found
    let v7: Vec<i64> = [42];
    let r7 = sentinel_search(v7, 99);
    if r7 == 0 - 1 {
        println("Test 7 - single not found: PASS");
        passed = passed + 1;
    } else {
        print("Test 7 - single not found: FAIL (got ");
        print(r7);
        println(")");
        failed = failed + 1;
    }
    // Summary
    println("");
    print(passed);
    print(" passed, ");
    print(failed);
    println(" failed");
    if failed == 0 {
        println("ALL PASS");
    } else {
        println("SOME FAILED");
    }
}
