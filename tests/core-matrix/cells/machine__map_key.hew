machine Counter {
    events { Inc, Reset, }
    state Zero,
    state NonZero { value: i64, },
    on Inc: Zero => NonZero { value: 1 }
    on Inc: NonZero => NonZero reenter { value: state.value + 1 }
    on Reset: NonZero => Zero,
    default { state }
}

fn main() {
    var k = Zero;
    k.step(.Inc);
    var m: HashMap<Counter, i64> = HashMap.new();
    m.insert(k, 9);
    match m.get(k) {
        Option.Some(v) => println(f"got {v}"),
        Option.None => println("missing"),
    }
}
