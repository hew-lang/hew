machine Retry {
    events {
        Fail;
        Reset;
    }
    state Idle;
    state Failing { attempts: i64; }
    on Fail: Idle => Failing { attempts: 1 }
    on Fail: Failing => Failing { attempts: state.attempts + 1 }
    on Reset: Failing => Failing {
        state
    }
    on Reset: Idle => Idle {
        state
    }
}

fn report(current: Retry) {
    match current {
        .Idle => println("idle"),
        .Failing { attempts } => println(f"failing {attempts}"),
    }
}

fn main() {
    var retry: Retry = .Idle;
    let _ = retry.step(.Reset).expect("machine step failed");
    report(retry);
    let _ = retry.step(.Fail).expect("machine step failed");
    let _ = retry.step(.Fail).expect("machine step failed");
    report(retry);
    let _ = retry.step(.Reset).expect("machine step failed");
    report(retry);
}
