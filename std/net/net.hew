//! TCP networking.
//!
//! Create TCP servers and clients for bidirectional byte-stream
//! communication. Handle types (`Listener`, `Connection`) provide
//! type-safe wrappers over raw file descriptors.
//!
//! # Error Handling
//!
//! `listen` and `connect` return `Result` with `net.NetError`. A connection
//! speaks the pipe verbs: `recv()` yields `Option<bytes>` (`None` is EOF, a
//! transport failure traps), `send(bytes)` returns `Result<(), SendError>`
//! and `finish()` half-closes. Other protocol modules have their own result
//! types; check their signatures when handling errors:
//!
//! ```
//! import std.net;
//!
//! fn dial(addr: string) -> Result<net.Connection, net.NetError> {
//!     net.connect(addr)
//! }
//!
//! fn main() {
//!     match dial("localhost:9000") {
//!         .Ok(conn) => println("connected"),
//!         .Err(e) => {
//!             match e {
//!                 NetError.ConnectionRefused(_) => println("nobody home"),
//!                 NetError.TimedOut(_)          => println("timed out"),
//!                 _                              => println("network error"),
//!             }
//!         },
//!     }
//! }
//! ```
//!
//! # Examples
//!
//! ```
//! import std.net;
//!
//! fn main() {
//!     let listener = match net.listen(":9000") { .Ok(value) => value, .Err(error) => panic("network operation failed"), };
//!     let conn = listener.accept();
//!     // An echo turn: `None` is the peer's EOF; `send` answers `Closed` once
//!     // the peer is gone, which an echo server treats as the end.
//!     if let .Some(data) = conn.recv() {
//!         let _ = conn.send(data);
//!     }
//!     conn.close();
//! }
//! ```

import std.string;

import std.stream;

// ── Network error type ────────────────────────────────────────────────
/// Structured error type for network operations.
///
/// Returned by all `try_*` functions in `net`, `net.tls`, `net.quic`,
/// `net.http`, `net.websocket`, and `net.dns`.  Use
/// `Result<T, NetError>` return types with the `?` operator for
/// structured error propagation.
///
/// For file-system errors see `fs.IoError`.
pub enum NetError {
    /// The remote host actively refused the connection (ECONNREFUSED).
    ConnectionRefused(i64),
    /// The local address is already in use (EADDRINUSE).
    AddressInUse(i64),
    /// The address or hostname could not be resolved (EADDRNOTAVAIL).
    AddressNotAvailable(i64),
    /// The connection attempt or I/O operation timed out (ETIMEDOUT).
    TimedOut(i64),
    /// Operation was cancelled (e.g., a deadline expired before the I/O
    /// could complete).
    ///
    /// Distinct from `TimedOut`: `TimedOut` means the OS deadline expired;
    /// `Cancelled` means the operation was abandoned for another reason
    /// (e.g. the blocking pool was shut down mid-call).
    Cancelled(i64),
    /// An argument was rejected before it reached the operating system.
    ///
    /// Carries the rejection detail rather than an errno: no syscall was
    /// made, so there is no platform error code to report. Produced by the
    /// endpoint and duration validation below, which run before every native
    /// call whose C ABI narrows an `i64` to an `i32`.
    InvalidArgument(string),
    /// Any other network-level failure.
    Other(i64),
}

/// Failure to transfer a TCP connection into active mode.
///
/// A refused attach has already closed the consumed connection. The caller
/// receives no connection back and must not attempt a second close.
pub enum AttachError {
    /// The runtime refused the active-mode registration.
    Refused,
}

impl Display for AttachError {
    fn fmt(err: AttachError) -> string {
        match err {
            AttachError.Refused => "the runtime refused the active-mode registration",
        }
    }
}

// WASM-TODO(wasi-errno): WASI uses wasi_errno codes; add a target-aware mapping.
/// Map an OS errno integer to a structured `NetError` variant.
///
/// The i64 payload carried in each variant is the raw OS errno so callers
/// can inspect the platform value. errno=0 (no OS error) maps to `Other(0)`.
///
/// Covers TCP, QUIC, TLS, HTTP, WebSocket, and DNS failure codes.
pub fn net_error_from_errno(errno: i64) -> NetError {
    // ECONNREFUSED: Linux=111, macOS=61, Windows=10061
    if errno == 111 || errno == 61 || errno == 10061 {
        NetError.ConnectionRefused(errno)
    // EADDRINUSE: Linux=98, macOS=48, Windows=10048
    } else if errno == 98 || errno == 48 || errno == 10048 {
        NetError.AddressInUse(errno)
    // ETIMEDOUT: Linux=110, macOS=60, Windows=10060
    } else if errno == 110 || errno == 60 || errno == 10060 {
        NetError.TimedOut(errno)
    // ECANCELED: Linux=125, macOS=89. Windows has no WSABASEERR-offset
    // ECANCELED; a cancelled/aborted overlapped net op surfaces as
    // ERROR_OPERATION_ABORTED (995) or WSAECANCELLED (10103) instead.
    } else if errno == 125 || errno == 89 || errno == 995 || errno == 10103 {
        NetError.Cancelled(errno)
    // EADDRNOTAVAIL: Linux=99, macOS=49, Windows=10049
    } else if errno == 99 || errno == 49 || errno == 10049 {
        NetError.AddressNotAvailable(errno)
    } else {
        NetError.Other(errno)
    }
}

/// Print a `NetError`'s variant name and raw OS errno.
impl Display for NetError {
    fn fmt(e: NetError) -> string {
        match e {
            NetError.ConnectionRefused(code) => f"ConnectionRefused({code})",
            NetError.AddressInUse(code) => f"AddressInUse({code})",
            NetError.AddressNotAvailable(code) => f"AddressNotAvailable({code})",
            NetError.TimedOut(code) => f"TimedOut({code})",
            NetError.Cancelled(code) => f"Cancelled({code})",
            NetError.InvalidArgument(detail) => f"InvalidArgument({detail})",
            NetError.Other(code) => f"Other({code})",
        }
    }
}

// ── Scalar and endpoint validation ────────────────────────────────────
//
// Every native networking entry point below narrows an `i64` to the `i32`
// its C ABI declares. Narrowing first and validating afterwards is not
// validation: `2^32 + 500` narrows to `500`, so an unrepresentable timeout
// silently becomes a plausible one, and a port of `2^32 + 80` becomes `80`.
// These helpers are the single authority every such call site runs first,
// so an unrepresentable value is reported and never reaches the runtime.
/// Largest value the `i32` parameters of the networking C ABI can carry.
pub fn abi_i32_max() -> i64 {
    2147483647
}

/// Validate a millisecond duration that the C ABI carries as an `i32`.
///
/// `context` names the calling API so the rejection identifies its origin.
pub fn duration_ms(context: string, ms: i64) -> Result<i64, NetError> {
    if ms < 0 {
        return Err(NetError.InvalidArgument(f"{context}: invalid duration {ms} ms (must be >= 0)"));
    }
    if ms > abi_i32_max() {
        return Err(NetError.InvalidArgument(f"{context}: invalid duration {ms} ms (must be <= {abi_i32_max()})"));
    }
    Ok(ms)
}

/// Validate a TCP connection timeout, preserving its negative "clear" sentinel.
///
/// The public API deliberately accepts any negative `i64` to clear an existing
/// timeout. Normalize that whole domain to `-1` before narrowing to the runtime
/// ABI, so values such as `i64::MIN` cannot wrap to a non-negative timeout.
fn try_connection_timeout_ms(context: string, ms: i64) -> Result<i64, NetError> {
    if ms < 0 {
        return Ok(-1);
    }
    duration_ms(context, ms)
}

/// Validate a byte count that the C ABI carries as an `i32`.
pub fn size_arg(context: string, size: i64) -> Result<i64, NetError> {
    if size < 0 {
        return Err(NetError.InvalidArgument(f"{context}: invalid size {size} (must be >= 0)"));
    }
    if size > abi_i32_max() {
        return Err(NetError.InvalidArgument(f"{context}: invalid size {size} (must be <= {abi_i32_max()})"));
    }
    Ok(size)
}

/// Validate a TCP/UDP port number.
pub fn port_arg(context: string, port: i64) -> Result<i64, NetError> {
    if port < 0 || port > 65535 {
        return Err(NetError.InvalidArgument(f"{context}: invalid port {port} (must be 0..=65535)"));
    }
    Ok(port)
}

/// A validated `host` / `port` pair.
///
/// `host` never carries the IPv6 bracket form: `[::1]:9000` yields host
/// `::1`, which is what the resolver expects.
pub type Endpoint {
    host: string,
    port: i64,
}

/// Longest address string the endpoint grammar accepts.
///
/// A DNS name is bounded at 253 octets and an IPv6 literal with brackets,
/// a zone and a port stays well inside this; anything longer is malformed
/// input, not an address, and is rejected before any resolver call.
fn max_endpoint_len() -> i64 {
    320
}

fn endpoint_reject(context: string, addr: string, reason: string) -> NetError {
    NetError.InvalidArgument(f"{context}: invalid endpoint '{addr}' ({reason})")
}

fn try_endpoint_port(context: string, addr: string, text: string) -> Result<i64, NetError> {
    if text == "" {
        return Err(endpoint_reject(context, addr, "empty port"));
    }
    match string.to_int(text) {
        .Ok(port) => port_arg(context, port),
        .Err(_) => Err(endpoint_reject(context, addr, f"port '{text}' is not a number")),
    }
}

/// Parse `host:port`, `:port`, or `[ipv6]:port` into a validated `Endpoint`.
///
/// This is the single endpoint grammar for the networking modules. A missing
/// port, a non-numeric port, a port outside `0..=65535`, an unbracketed IPv6
/// literal, and an unterminated bracket are all rejected here, before any
/// address string reaches a resolver or a native connect.
///
/// An empty host means "this machine": `:9000` yields host `127.0.0.1`.
///
/// # Examples
///
/// ```
/// import std.net;
///
/// fn main() {
///     match net.parse_endpoint("net.connect_timeout", "[::1]:9000") {
///         .Ok(ep) => println(f"{ep.host} {ep.port}"),
///         .Err(err) => println(err),
///     }
/// }
/// ```
pub fn parse_endpoint(context: string, addr: string) -> Result<Endpoint, NetError> {
    if addr == "" {
        return Err(endpoint_reject(context, addr, "empty address"));
    }
    if addr.len() > max_endpoint_len() {
        return Err(endpoint_reject(context, "<oversized>", f"address length {addr.len()} exceeds {max_endpoint_len()}"));
    }
    if addr.starts_with("[") {
        return try_parse_bracketed_endpoint(context, addr);
    }
    let colon = addr.find(":");
    match colon {
        .Some(i) => {
            let host = addr.slice(0, i);
            let port_text = addr.slice(i + 1, addr.len());
            // A second colon outside brackets is an unbracketed IPv6 literal:
            // its grammar is ambiguous with `host:port` and it is rejected
            // rather than silently split at the first colon.
            if port_text.contains(":") {
                return Err(endpoint_reject(context, addr, "unbracketed IPv6 literal; write [address]:port"));
            }
            let port = try_endpoint_port(context, addr, port_text)?;
            if host == "" {
                Ok(Endpoint { host: "127.0.0.1", port: port })
            } else {
                Ok(Endpoint { host: host, port: port })
            }
        },
        .None => Err(endpoint_reject(context, addr, "missing ':port'")),
    }
}

fn try_parse_bracketed_endpoint(context: string, addr: string) -> Result<Endpoint, NetError> {
    let close = addr.find("]");
    match close {
        .Some(end) => {
            let host = addr.slice(1, end);
            if host == "" {
                return Err(endpoint_reject(context, addr, "empty bracketed host"));
            }
            let rest = addr.slice(end + 1, addr.len());
            if rest == "" {
                return Err(endpoint_reject(context, addr, "missing ':port'"));
            }
            if !rest.starts_with(":") {
                return Err(endpoint_reject(context, addr, "expected ':port' after ']'"));
            }
            let port = try_endpoint_port(context, addr, rest.slice(1, rest.len()))?;
            Ok(Endpoint { host: host, port: port })
        },
        .None => Err(endpoint_reject(context, addr, "unterminated '[' in IPv6 literal")),
    }
}

/// Construct a `NetError.TimedOut(0)` value without a platform-specific
/// errno. Useful for in-process deadline expiry where there is no OS error
/// to map.
pub fn net_error_timed_out() -> NetError {
    NetError.TimedOut(0)
}

/// Construct a `NetError.Cancelled(0)` value without a platform-specific
/// errno. Useful for in-process cancellation where there is no OS error
/// to map.
pub fn net_error_cancelled() -> NetError {
    NetError.Cancelled(0)
}

// ── Write error type ──────────────────────────────────────────────────
fn net_result_from_status(status: i32) -> Result<(), NetError> { // INTERNAL-ABI: status from C ABI is i32; internal helper only
    if status < 0 {
        // Read errno before the message: hew_stream_last_error clears errno as a
        // side-effect (they share a paired thread-local), so errno must be
        // consumed first.
        let errno = unsafe {
            hew_stream_last_errno()
        };
        let _ = unsafe {
            hew_stream_last_error()
        };
        Err(net_error_from_errno(errno as i64))
    } else {
        Ok(())
    }
}

/// A TCP listener bound to an address, waiting for connections.
///
/// Created by `net.listen(addr)`. Returns a negative value (as i32)
/// on failure when cast; use comparison to check success.
#[resource]
#[opaque]
pub type Listener {
}

/// An established TCP connection for reading and writing.
///
/// Obtained from `listener.accept()` or `net.connect(addr)`.
#[resource]
#[opaque]
pub type Connection {
}

// ── Listener methods ──────────────────────────────────────────────────
/// Methods available on a TCP `Listener`.
trait ListenerMethods {
    /// Wait until a client connects and return the new `Connection`.
    fn accept(self) -> Connection;

    /// Return the port selected for this listener, including an ephemeral port
    /// chosen by `listen("...:0")`. This is a borrowing inspection; it does
    /// not alter the listener's close authority.
    fn local_port(self) -> i64;
}

impl ListenerMethods for Listener {
    /// Wait until a client connects and return the new `Connection`.
    fn accept(ln: Listener) -> Connection {
        unsafe {
            hew_tcp_accept(ln)
        }
    }
    fn local_port(ln: Listener) -> i64 {
        unsafe {
            hew_tcp_listener_local_port(ln) as i64
        }
    }
}

// `Listener` owns a TCP table entry.  Keep its close ritual inherent so the
// resource marker can make it the compiler's exactly-once scope-exit/crash
// authority; the trait above remains intentionally borrowing-only.
impl Listener {
    /// Close the listener and release the listening socket.
    fn close(consume self) {
        unsafe {
            hew_tcp_listener_close(self)
        };
    }
}

// ── Connection methods ────────────────────────────────────────────────
/// Methods available on a TCP `Connection`: the pipe verbs on one
/// bidirectional handle. `split` gives the two halves separate owners.
trait ConnectionMethods {
    /// Receive the next chunk of bytes from the peer.
    ///
    /// Waits until data is available. `None` is an orderly EOF: the peer
    /// finished writing. A transport failure traps the calling actor with
    /// the OS error, so the loop never sees an error value.
    fn recv(self) -> Option<bytes>;

    /// Send raw bytes to the peer.
    ///
    /// Returns `Ok(())` once the payload is handed to the OS send buffer.
    /// `Err(SendError.Closed)` means the peer reset or closed the
    /// connection; `Err(SendError.Full)` means the send buffer stayed full
    /// past the write deadline set by `set_write_timeout` (without a
    /// deadline a full buffer waits until it drains). Any other failure
    /// traps the calling actor. The connection may have committed a prefix
    /// of the payload before `Full`, so a whole-payload retry is unsafe.
    fn send(self, data: bytes) -> Result<(), SendError>;

    /// Half-close: send FIN to the peer while this side keeps reading.
    fn finish(self);

    /// Set the read timeout in milliseconds.
    ///
    /// Pass a negative value to clear the timeout.
    fn set_read_timeout(self, ms: i64) -> Result<(), NetError>;

    /// Set the write timeout in milliseconds.
    ///
    /// Pass a negative value to clear the timeout.
    fn set_write_timeout(self, ms: i64) -> Result<(), NetError>;
}

// ── Connection handler trait (active mode) ────────────────────────────
/// Trait for actors that handle a TCP connection in active mode.
///
/// Implement this on an actor (declare matching `receive fn on_data(bytes)` /
/// `receive fn on_close()`) and call `conn.attach(self)` to have the runtime
/// deliver socket data as actor messages. The actor never calls `recv`: the
/// runtime owns the entire connection after the consuming attach and closes it
/// on terminal readiness or actor teardown. No `Connection` remains available
/// for outbound writes. Use `split` for a bidirectional actor protocol.
///
/// Pass the connection as a handler-local parameter to the code that calls
/// `attach`; do not store it in actor state first. Consuming moves are enforced
/// within one handler, but field bindings are reconstructed for each handler
/// activation and currently do not carry a prior handler's move state.
///
/// Declared `pub` so the type checker can recognise that a concrete actor's
/// `receive fn`s structurally satisfy this handler trait at the
/// Actor-handle narrowing `Actor` → `ConnectionHandler` coercion site (the
/// `conn.attach(self)` surface).
///
/// # Example
///
/// ```
/// import std.net;
///
/// actor InboundLogger {
///     receive fn on_data(data: bytes) {
///         println(f"received {data.len()} bytes");
///     }
///     receive fn on_close() {
///         println("client disconnected");
///     }
/// }
///
/// fn main() {
///     let conn = match net.connect("localhost:9000") { .Ok(value) => value, .Err(error) => panic("network operation failed"), };
///     let handler: InboundLogger = spawn InboundLogger;
///     match conn.attach(handler) {
///         .Ok(()) => {},
///         .Err(net.AttachError.Refused) => println("attach refused"),
///     }
/// }
/// ```
pub trait ConnectionHandler {
    /// Called when a chunk of bytes arrives from the peer.
    fn on_data(data: bytes);

    /// Called once when the connection closes or errors.
    fn on_close();
}

impl ConnectionMethods for Connection {
    /// Receive the next chunk; `None` is EOF, a failure traps.
    fn recv(conn: Connection) -> Option<bytes> {
        unsafe {
            // Drop any status left by an earlier operation so the status read
            // after the call describes this read and nothing else.
            let _ = hew_stream_last_errno();
            let data = hew_tcp_read(conn);
            let errno = hew_stream_last_errno();
            if errno != 0 {
                let detail = hew_stream_last_error();
                panic(f"net.Connection.recv: {to_string(net_error_from_errno(errno as i64))}: {detail}");
            }
            if data.len() == 0 {
                None
            } else {
                Some(data)
            }
        }
    }
    /// Send raw bytes; `Closed` and `Full` are the peer's answers, anything
    /// else traps.
    fn send(conn: Connection, data: bytes) -> Result<(), SendError> {
        let status = unsafe {
            hew_tcp_write(conn, data)
        };
        if status >= 0 {
            return Ok(());
        }
        let errno = unsafe {
            hew_stream_last_errno()
        } as i64;
        let detail = unsafe {
            hew_stream_last_error()
        };
        // EAGAIN/EWOULDBLOCK: Linux=11, macOS=35. ETIMEDOUT: Linux=110,
        // macOS=60, Windows WSAETIMEDOUT=10060. The send buffer stayed full
        // past the deadline.
        if errno == 11 || errno == 35 || errno == 110 || errno == 60 || errno == 10060 {
            return Err(SendError.Full);
        }
        // ECONNRESET: Linux=104, macOS=54, Windows=10054. EPIPE: 32.
        // ENOTCONN: Linux=107, macOS=57, Windows=10057.
        if errno == 104 || errno == 54 || errno == 10054 || errno == 32 || errno == 107 || errno == 57 || errno == 10057 {
            return Err(SendError.Closed);
        }
        panic(f"net.Connection.send: {to_string(net_error_from_errno(errno))}: {detail}")
    }
    /// Half-close the write side.
    fn finish(conn: Connection) {
        let status = unsafe {
            hew_tcp_shutdown_write(conn)
        };
        if status < 0 {
            let errno = unsafe {
                hew_stream_last_errno()
            } as i64;
            let detail = unsafe {
                hew_stream_last_error()
            };
            panic(f"net.Connection.finish: {to_string(net_error_from_errno(errno))}: {detail}");
        }
    }
    /// Set the read timeout in milliseconds.
    fn set_read_timeout(conn: Connection, ms: i64) -> Result<(), NetError> {
        let checked = try_connection_timeout_ms("net.Connection.set_read_timeout", ms)?;
        net_result_from_status(unsafe {
            hew_tcp_set_read_timeout(conn, checked as i32) // INTERNAL-ABI: range-checked above
        })
    }
    /// Set the write timeout in milliseconds.
    fn set_write_timeout(conn: Connection, ms: i64) -> Result<(), NetError> {
        let checked = try_connection_timeout_ms("net.Connection.set_write_timeout", ms)?;
        net_result_from_status(unsafe {
            hew_tcp_set_write_timeout(conn, checked as i32) // INTERNAL-ABI: range-checked above
        })
    }
}

// `Connection` owns a TCP table entry.  This must be an inherent consuming
// ritual (rather than a trait method) so `#[resource]` can disarm the local
// after an explicit close and synthesize the same close on lexical, crash,
// cancellation, and suspended-frame exits.
impl Connection {
    /// Close the connection and release resources.
    fn close(consume self) {
        unsafe {
            hew_tcp_close(self)
        };
    }
    /// Attach this connection to an actor for active-mode delivery.
    ///
    /// The runtime takes over the connection's lifecycle on success, so this
    /// is a terminal transfer just like `close` and `split`. On
    /// refusal the runtime closes the consumed connection before returning
    /// `Err(AttachError.Refused)`.
    #[runtime(family = TcpAttachLocal, symbol = hew_tcp_attach_native, lowering = actor_ingress, target = native, classification = "non-declarable", receiver = connection, data = on_data, close = on_close, result = status_result, error_type = "std.net.AttachError", error_variant = Refused)]
    fn attach(consume self, handler: ConnectionHandler) -> Result<(), AttachError> {
        Err(AttachError.Refused)
    }
    /// Consume the connection and give its two directions separate owners:
    /// a `Stream<bytes>` for inbound data and a `Sink<bytes>` for outbound.
    /// Either half may move to another actor; `Sink.finish()` sends FIN.
    fn split(consume self) -> (Stream<bytes>, Sink<bytes>) {
        unsafe {
            let pair = hew_tcp_stream_from_conn(self);
            let input: Stream<bytes> = stream.pair_stream(pair);
            let output: Sink<bytes> = stream.pair_sink(pair);
            pair.close();
            (input, output)
        }
    }
}

// ── Module-level functions ────────────────────────────────────────────
/// Create a TCP listener bound to the given address.
///
/// Returns `Err(NetError)` instead of panicking on bind failure.
///
/// # Examples
///
/// ```
/// import std.net;
///
/// fn main() {
///     match net.listen(":9000") {
///         .Ok(ln) => { /* accept connections */ },
///         .Err(net.NetError.AddressInUse(_)) => println("port already taken"),
///         .Err(e) => println("bind failed"),
///     }
/// }
/// ```
pub fn listen(addr: string) -> Result<Listener, NetError> {
    unsafe {
        let ln = hew_tcp_listen(addr);
        if hew_listener_is_valid(ln) {
            Ok(ln)
        } else {
            let errno = hew_stream_last_errno();
            let _ = hew_stream_last_error();
            Err(net_error_from_errno(errno as i64))
        }
    }
}

/// Connect to a TCP server at the given address.
///
/// Returns `Err(NetError)` instead of panicking on failure.
///
/// # Examples
///
/// ```
/// import std.net;
///
/// fn main() {
///     match net.connect("localhost:9000") {
///         .Ok(conn) => { /* use conn */ },
///         .Err(net.NetError.ConnectionRefused(_)) => println("nothing listening"),
///         .Err(e) => println("connect failed"),
///     }
/// }
/// ```
pub fn connect(addr: string) -> Result<Connection, NetError> {
    unsafe {
        let conn = hew_tcp_connect(addr);
        if hew_connection_is_valid(conn) {
            Ok(conn)
        } else {
            let errno = hew_stream_last_errno();
            let _ = hew_stream_last_error();
            Err(net_error_from_errno(errno as i64))
        }
    }
}

/// Connect to a TCP server with a timeout, reporting invalid input and
/// connect failure instead of fabricating a default.
///
/// The address is parsed by the shared endpoint authority, so an unbracketed
/// IPv6 literal, a non-numeric port, and a missing port are all rejected
/// before the native connect rather than becoming host `127.0.0.1` port `0`.
/// The deadline is accumulated with overflow checks and validated against the
/// `i32` the C ABI carries.
pub fn connect_timeout(addr: string, timeout_sec: i64, timeout_usec: i64) -> Result<Connection, NetError> {
    let Endpoint { host, port } = parse_endpoint("net.connect_timeout", addr)?;
    let timeout_ms = try_connect_timeout_ms(timeout_sec, timeout_usec)?;
    unsafe {
        let conn = hew_tcp_connect_timeout(host, port as i32, timeout_ms as i32); // INTERNAL-ABI: both values are range-checked above
        if hew_connection_is_valid(conn) {
            Ok(conn)
        } else {
            let errno = hew_stream_last_errno();
            let _ = hew_stream_last_error();
            Err(net_error_from_errno(errno as i64))
        }
    }
}

/// Accumulate `timeout_sec` + `timeout_usec` into milliseconds with the
/// overflow checks the plain `sec * 1000 + usec / 1000` form did not have.
fn try_connect_timeout_ms(timeout_sec: i64, timeout_usec: i64) -> Result<i64, NetError> {
    let millis_per_second: i64 = 1000;
    let micros_per_millisecond: i64 = 1000;
    if timeout_sec < 0 {
        return Err(NetError.InvalidArgument(f"net.connect_timeout: invalid timeout_sec {timeout_sec} (must be >= 0)"));
    }
    if timeout_usec < 0 {
        return Err(NetError.InvalidArgument(f"net.connect_timeout: invalid timeout_usec {timeout_usec} (must be >= 0)"));
    }
    // Bound each term against the ABI ceiling before multiplying or adding, so
    // the accumulation itself can never wrap.
    if timeout_sec > abi_i32_max() / millis_per_second {
        return Err(NetError.InvalidArgument(f"net.connect_timeout: invalid timeout_sec {timeout_sec} (deadline exceeds {abi_i32_max()} ms)"));
    }
    let seconds_ms = timeout_sec * millis_per_second;
    let micros_ms = timeout_usec / micros_per_millisecond;
    if micros_ms > abi_i32_max() - seconds_ms {
        return Err(NetError.InvalidArgument(f"net.connect_timeout: invalid deadline (timeout_sec {timeout_sec} + timeout_usec {timeout_usec} exceeds {abi_i32_max()} ms)"));
    }
    duration_ms("net.connect_timeout", seconds_ms + micros_ms)
}

/// Broadcast a message to all connections except the sender.
///
/// Used in chat-server patterns to fan out messages. Delivery is
/// best-effort: every eligible connection is attempted even after one
/// fails. `Ok(n)` means n connections received the message and none
/// failed (`Ok(0)` means there was nothing to deliver to); `Err`
/// carries the `NetError` for the first failed write — healthy
/// connections were still delivered to.
pub fn broadcast_except(sender: Connection, message: bytes) -> Result<i64, NetError> {
    let n: i32 = unsafe {
        hew_tcp_broadcast_except(sender, message)
    };
    if n < 0 {
        let errno = unsafe {
            hew_stream_last_errno()
        };
        unsafe {
            let _ = hew_stream_last_error();
        };
        Err(net_error_from_errno(errno as i64))
    } else {
        Ok(n as i64)
    }
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    fn hew_tcp_listen(addr: string) -> Listener;
    fn hew_tcp_accept(listener: Listener) -> Connection;
    #[runtime_capability(blocking_offload)]
    fn hew_tcp_connect(addr: string) -> Connection;
    #[runtime_capability(blocking_offload)]
    fn hew_tcp_connect_timeout(host: string, port: i32, timeout_ms: i32) -> Connection;
    fn hew_tcp_read(conn: Connection) -> bytes;
    // Returns the byte count written (>= 0) on success, or -1 on failure with
    // the OS errno recorded in the shared thread-local (read via
    // hew_stream_last_errno). The Hew side maps the errno to a SendError.
    fn hew_tcp_write(conn: Connection, data: bytes) -> i32;
    // shutdown(Write): 0 on success, -1 with the OS errno recorded.
    fn hew_tcp_shutdown_write(conn: Connection) -> i32;
    // `conn.attach(handler)` does not call a Hew-declared extern: the checker
    // rewrites each call site to `hew_tcp_attach_local`, which codegen
    // intercepts to synthesise the handler `msg_id`s and emit the runtime attach
    // ABI directly. No extern declaration here would match that 4-arg ABI, so
    // none is declared (mirrors `hew_remote_pid_send`, whose real symbol
    // `hew_actor_send_by_id` is interned in codegen rather than declared in Hew).
    fn hew_tcp_detach(conn: Connection);
    fn hew_tcp_listener_close(consume listener: Listener) -> i32;
    fn hew_tcp_close(consume conn: Connection) -> i32;
    fn hew_tcp_set_read_timeout(conn: Connection, ms: i32) -> i32;
    fn hew_tcp_set_write_timeout(conn: Connection, ms: i32) -> i32;
    // Returns the delivered count (0 = no eligible recipients), or -1 when any
    // eligible recipient's write failed, with the OS errno recorded in the
    // shared thread-local (read via hew_stream_last_errno).
    fn hew_tcp_broadcast_except(sender: Connection, message: bytes) -> i32;
    fn hew_tcp_listener_local_port(ln: Listener) -> i32;
    fn hew_listener_is_valid(ln: Listener) -> bool;
    fn hew_connection_is_valid(conn: Connection) -> bool;
    fn hew_stream_last_error() -> string;
    fn hew_stream_last_errno() -> i32; // INTERNAL-ABI: OS errno from thread-local; 0 when none recorded
    // TCP-to-Stream/Sink bridge.  Consumes the connection handle on every
    // return path; returns a StreamPair whose halves are extracted with the
    // pair extractor functions below.  On clone failure the consumed
    // connection is fully closed and released and a null StreamPair is returned
    // (check with is_valid); the last-error errno is EBADF for an unknown
    // handle, otherwise the real dup(2) errno.  Not available on wasm32;
    // WASM-TODO(tcp-networking): add the TCP-to-stream bridge to the WASM transport.
    fn hew_tcp_stream_from_conn(consume conn: Connection) -> stream.StreamPair;
}
