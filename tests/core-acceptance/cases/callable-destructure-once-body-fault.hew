type Pair {
    a: fn[once](i64) -> i64,
    b: fn() -> string,
}

fn main() -> i64 {
    let first = "callback owner".to_upper();
    let second = "sibling owner".to_upper();
    let value = Pair { a: move |divisor: i64| -> i64 {
        println("callback entered");
        first.len() / divisor
    }, b: move || second };
    let Pair { a, b } = value;
    let result = a(0);
    println(b());
    result
}
