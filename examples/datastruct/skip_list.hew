// Skip List (simplified 2-level) using Vec<i64> with index-based pointers
// Bottom level: all elements in sorted order
// Top level: every other element (express lane)
// Bottom node: [value, next_bottom] at i*2, i*2+1
// Top node stored in separate vec: [bottom_idx, next_top] at i*2, i*2+1
//
// A parameter is the callee's own copy, so every helper that writes into a
// level returns that level and the caller reassigns. Helpers that also report
// an index or a comparison count return a tuple.
fn bot_val(bot: Vec<i64>, i: i64) -> i64 {
    bot[i * 2]
}

fn bot_next(bot: Vec<i64>, i: i64) -> i64 {
    bot[i * 2 + 1]
}

fn set_bot_next(var bot: Vec<i64>, i: i64, nx: i64) -> Vec<i64> {
    bot.set(i * 2 + 1, nx);
    bot
}

fn top_bidx(top: Vec<i64>, i: i64) -> i64 {
    top[i * 2]
}

fn top_next(top: Vec<i64>, i: i64) -> i64 {
    top[i * 2 + 1]
}

fn set_top_next(var top: Vec<i64>, i: i64, nx: i64) -> Vec<i64> {
    top.set(i * 2 + 1, nx);
    top
}

fn alloc_bot(var bot: Vec<i64>, val: i64) -> (Vec<i64>, i64) {
    let idx = bot.len() / 2;
    bot.push(val);
    bot.push(-1);
    (bot, idx)
}

fn alloc_top(var top: Vec<i64>, bot_idx: i64) -> (Vec<i64>, i64) {
    let idx = top.len() / 2;
    top.push(bot_idx);
    top.push(-1);
    (top, idx)
}

// Insert val into the sorted bottom list; returns the level and the new head.
fn insert_bottom(var bot: Vec<i64>, head: i64, val: i64) -> (Vec<i64>, i64) {
    let (grown, nd) = alloc_bot(bot, val);
    bot = grown;
    if head == -1 {
        return (bot, nd);
    }
    if val <= bot_val(bot, head) {
        bot = set_bot_next(bot, nd, head);
        return (bot, nd);
    }
    var prev = head;
    var curr = bot_next(bot, head);
    var inserted = 0;
    while curr != -1 {
        if val <= bot_val(bot, curr) {
            if inserted == 0 {
                bot = set_bot_next(bot, prev, nd);
                bot = set_bot_next(bot, nd, curr);
                inserted = 1;
            }
        }
        if inserted == 0 {
            prev = curr;
            curr = bot_next(bot, curr);
        } else {
            curr = -1;
        }
    }
    if inserted == 0 {
        bot = set_bot_next(bot, prev, nd);
    }
    (bot, head)
}

// Rebuild the top level: every other element from the bottom. Old top entries
// are orphaned; the returned head is the only way into the new express lane.
fn rebuild_top(bot: Vec<i64>, var top: Vec<i64>, bot_head: i64) -> (Vec<i64>, i64) {
    var top_head = -1;
    var top_tail = -1;
    var curr = bot_head;
    var count = 0;
    while curr != -1 {
        if count % 2 == 0 {
            let (grown, t) = alloc_top(top, curr);
            top = grown;
            if top_head == -1 {
                top_head = t;
                top_tail = t;
            } else {
                top = set_top_next(top, top_tail, t);
                top_tail = t;
            }
        }
        count = count + 1;
        curr = bot_next(bot, curr);
    }
    (top, top_head)
}

// Search using the skip list. Returns (found node index or -1, comparisons).
fn search_skip(bot: Vec<i64>, top: Vec<i64>, top_head: i64, val: i64) -> (i64, i64) {
    var comps = 0;
    var top_curr = top_head;
    var drop_bot = -1;
    if top_head != -1 {
        drop_bot = top_bidx(top, top_head);
    }
    while top_curr != -1 {
        let bi = top_bidx(top, top_curr);
        comps = comps + 1;
        if bot_val(bot, bi) == val {
            return (bi, comps);
        }
        let top_nx = top_next(top, top_curr);
        if top_nx != -1 {
            let next_bi = top_bidx(top, top_nx);
            if bot_val(bot, next_bi) <= val {
                drop_bot = next_bi;
                top_curr = top_nx;
            } else {
                drop_bot = bi;
                top_curr = -1;
            }
        } else {
            drop_bot = bi;
            top_curr = -1;
        }
    }
    var curr = drop_bot;
    while curr != -1 {
        comps = comps + 1;
        if bot_val(bot, curr) == val {
            return (curr, comps);
        }
        if bot_val(bot, curr) > val {
            return (-1, comps);
        }
        curr = bot_next(bot, curr);
    }
    (-1, comps)
}

// Linear search. Returns (found node index or -1, comparisons).
fn search_linear(bot: Vec<i64>, head: i64, val: i64) -> (i64, i64) {
    var comps = 0;
    var curr = head;
    while curr != -1 {
        comps = comps + 1;
        if bot_val(bot, curr) == val {
            return (curr, comps);
        }
        curr = bot_next(bot, curr);
    }
    (-1, comps)
}

fn bot_list_len(bot: Vec<i64>, head: i64) -> i64 {
    var count = 0;
    var curr = head;
    while curr != -1 {
        count = count + 1;
        curr = bot_next(bot, curr);
    }
    count
}

// --- Tests ---
fn test_sorted_insert() -> i64 {
    var bot: Vec<i64> = Vec.new();
    var head = -1;
    let values: Vec<i64> = [30, 10, 50, 20, 40];
    for value in values {
        let (grown, new_head) = insert_bottom(bot, head, value);
        bot = grown;
        head = new_head;
    }
    // Should be 10,20,30,40,50
    var curr = head;
    var prev_val = -1;
    var sorted = 1;
    while curr != -1 {
        let v = bot_val(bot, curr);
        if v < prev_val {
            sorted = 0;
        }
        prev_val = v;
        curr = bot_next(bot, curr);
    }
    if sorted == 1 {
        if bot_list_len(bot, head) == 5 {
            println("PASS: sorted insert");
            return 1;
        }
    }
    println("FAIL: sorted insert");
    0
}

// Build a bottom level holding 10, 20, ... count*10 and return it with its head.
fn build_decades(count: i64) -> (Vec<i64>, i64) {
    var bot: Vec<i64> = Vec.new();
    var head = -1;
    for i in 1 .. count + 1 {
        let (grown, new_head) = insert_bottom(bot, head, i * 10);
        bot = grown;
        head = new_head;
    }
    (bot, head)
}

fn test_skip_search() -> i64 {
    let (bot, head) = build_decades(10);
    let empty_top: Vec<i64> = Vec.new();
    let (top, top_head) = rebuild_top(bot, empty_top, head);
    let (idx, _comps) = search_skip(bot, top, top_head, 70);
    if idx >= 0 {
        if bot_val(bot, idx) == 70 {
            println("PASS: skip search found");
            return 1;
        }
    }
    println("FAIL: skip search found");
    0
}

fn test_skip_not_found() -> i64 {
    let (bot, head) = build_decades(5);
    let empty_top: Vec<i64> = Vec.new();
    let (top, top_head) = rebuild_top(bot, empty_top, head);
    let (idx, _comps) = search_skip(bot, top, top_head, 35);
    if idx == -1 {
        println("PASS: skip search not found");
        return 1;
    }
    println("FAIL: skip search not found");
    0
}

fn test_fewer_comparisons() -> i64 {
    let (bot, head) = build_decades(20);
    let empty_top: Vec<i64> = Vec.new();
    let (top, top_head) = rebuild_top(bot, empty_top, head);
    let (_skip_idx, skip_comps) = search_skip(bot, top, top_head, 190);
    let (_lin_idx, lin_comps) = search_linear(bot, head, 190);
    if skip_comps <= lin_comps {
        println("PASS: fewer comparisons");
        return 1;
    }
    println(f"  skip_comps={skip_comps} lin_comps={lin_comps}");
    println("FAIL: fewer comparisons");
    0
}

fn test_rebuild_top() -> i64 {
    let (bot, head) = build_decades(4);
    let empty_top: Vec<i64> = Vec.new();
    let (top, top_head) = rebuild_top(bot, empty_top, head);
    // Top should have 2 nodes (indices 0 and 2 of bottom -> values 10, 30)
    var count = 0;
    var tc = top_head;
    while tc != -1 {
        count = count + 1;
        tc = top_next(top, tc);
    }
    if count == 2 {
        println("PASS: rebuild top level");
        return 1;
    }
    println("FAIL: rebuild top level");
    0
}

fn test_empty_search() -> i64 {
    let bot: Vec<i64> = Vec.new();
    let top: Vec<i64> = Vec.new();
    let (idx, _comps) = search_skip(bot, top, -1, 42);
    if idx == -1 {
        println("PASS: empty search");
        return 1;
    }
    println("FAIL: empty search");
    0
}

fn main() {
    println("=== Skip List Tests ===");
    var passed = 0;
    let total = 6;
    passed = passed + test_sorted_insert();
    passed = passed + test_skip_search();
    passed = passed + test_skip_not_found();
    passed = passed + test_fewer_comparisons();
    passed = passed + test_rebuild_top();
    passed = passed + test_empty_search();
    println("");
    println(f"Passed: {passed}/{total}");
    if passed == total {
        println("OVERALL: PASS");
    } else {
        println("OVERALL: FAIL");
    }
}
