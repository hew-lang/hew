// Complexity twin of `mir-lowering-shape.hew`, generated by hand from it.
//
// Every declaration, helper, and call in this file is identical to the larger
// fixture; only `emit_document` is short. `scripts/bench-mir.sh` compiles both
// and compares the number of whole-function owner-state derivations. The pass
// sequence is the same for both, so a derivation count that is proportional to
// the pass sequence is nearly equal across the pair, and one that is
// proportional to block count is not. That comparison is machine-independent:
// it fails on a return to per-block CFG replay whatever the host's speed.
//
// Keep the two files in step. If the larger fixture's helpers or types change,
// change them here as well, or the comparison stops measuring one variable.
import std.string;

type Attribute {
    key: string,
    value: string,
    unit: string,
    note: string,
}

type Endpoint {
    kind: string,
    address: string,
    protocol: string,
    credential: string,
    fallback: string,
    labels: Vec<string>,
    attributes: Vec<Attribute>,
}

type Limits {
    present: bool,
    max_parallel: i64,
    max_per_hour: i64,
    max_depth: i64,
    max_pending: i64,
}

type Stage {
    name: string,
    kind: string,
    goal: string,
    owner: string,
    integrity: string,
    region: string,
    channel: string,
    contact: string,
    retention: string,
    checksum: string,
    origin: string,
    revision: string,
    summary: string,
    category: string,
    severity: string,
    visibility: string,
    locale: string,
    inputs: Vec<string>,
    command: Vec<string>,
    endpoints: Vec<Endpoint>,
    attributes: Vec<Attribute>,
    limits: Limits,
}

type Document {
    api_version: string,
    kind: string,
    schema_version: string,
    name: string,
    group: string,
    display_name: string,
    start: string,
    region: string,
    tier: string,
    channel: string,
    owner: string,
    contact: string,
    licence: string,
    retention: string,
    checksum: string,
    origin: string,
    revision: string,
    author: string,
    summary: string,
    category: string,
    severity: string,
    visibility: string,
    locale: string,
    requires: Vec<string>,
    endpoints: Vec<Endpoint>,
    stages: Vec<Stage>,
    limits: Limits,
}

fn quote(value: string) -> string {
    if value == "" {
        return "\"\"";
    }
    if value.starts_with("#") {
        return "\"" + value + "\"";
    }
    "\"" + value.trim() + "\""
}

fn emit_list(indent: string, label: string, items: Vec<string>) -> string {
    if items.is_empty() {
        return "";
    }
    var out = indent + label + ":\n";
    for item in items {
        out = out + indent + "  - " + quote(item) + "\n";
    }
    out
}

fn emit_attributes(indent: string, items: Vec<Attribute>) -> string {
    if items.is_empty() {
        return "";
    }
    var out = indent + "attributes:\n";
    for item in items {
        out = out + indent + "  - key: " + quote(item.key) + "\n";
        out = out + indent + "    value: " + quote(item.value) + "\n";
        if item.unit != "" {
            out = out + indent + "    unit: " + quote(item.unit) + "\n";
        }
        if item.note != "" {
            out = out + indent + "    note: " + quote(item.note) + "\n";
        }
    }
    out
}

fn emit_limits(indent: string, limits: Limits) -> string {
    if !limits.present {
        return "";
    }
    var out = indent + "limits:\n";
    out = out + indent + "  maxParallel: " + string.from_int(limits.max_parallel) + "\n";
    out = out + indent + "  maxPerHour: " + string.from_int(limits.max_per_hour) + "\n";
    if limits.max_depth > 0 {
        out = out + indent + "  maxDepth: " + string.from_int(limits.max_depth) + "\n";
    }
    if limits.max_pending > 0 {
        out = out + indent + "  maxPending: " + string.from_int(limits.max_pending) + "\n";
    }
    out
}

fn emit_endpoint(indent: string, endpoint: Endpoint) -> string {
    var out = indent + "- kind: " + quote(endpoint.kind) + "\n";
    out = out + indent + "  address: " + quote(endpoint.address) + "\n";
    if endpoint.protocol != "" {
        out = out + indent + "  protocol: " + quote(endpoint.protocol) + "\n";
    }
    if endpoint.credential != "" {
        out = out + indent + "  credential: " + quote(endpoint.credential) + "\n";
    }
    if endpoint.fallback != "" {
        out = out + indent + "  fallback: " + quote(endpoint.fallback) + "\n";
    }
    out = out + emit_list(indent + "  ", "labels", endpoint.labels);
    out = out + emit_attributes(indent + "  ", endpoint.attributes);
    out
}

fn emit_document(doc: Document) -> string {
    var s = "";
    s = s + "apiVersion: " + quote(doc.api_version) + "\n";
    s = s + "kind: " + quote(doc.kind) + "\n";
    if doc.region != "" {
        s = s + "  region: " + quote(doc.region) + "\n";
    }
    if doc.tier != "" {
        s = s + "  tier: " + quote(doc.tier) + "\n";
    }
    s = s + emit_list("  ", "requires", doc.requires);
    s = s + emit_limits("  ", doc.limits);
    s = s + "  stages:\n";
    for stage in doc.stages {
        if stage.name != "" {
            s = s + "    - name: " + quote(stage.name) + "\n";
        }
        if stage.kind != "" {
            s = s + "    - type: " + quote(stage.kind) + "\n";
        }
        s = s + emit_list("      ", "inputs", stage.inputs);
        if !stage.endpoints.is_empty() {
            s = s + "      endpoints:\n";
            for endpoint in stage.endpoints {
                s = s + emit_endpoint("        ", endpoint);
            }
        }
    }
    s
}

fn main() {
    let requires: Vec<string> = Vec.new();
    let endpoints: Vec<Endpoint> = Vec.new();
    let stages: Vec<Stage> = Vec.new();
    let doc = Document {
        api_version: "v1",
        kind: "Document",
        schema_version: "2.0",
        name: "sample",
        group: "core",
        display_name: "Sample",
        start: "first",
        region: "",
        tier: "",
        channel: "",
        owner: "",
        contact: "",
        licence: "",
        retention: "",
        checksum: "",
        origin: "",
        revision: "",
        author: "",
        summary: "",
        category: "",
        severity: "",
        visibility: "",
        locale: "",
        requires: requires,
        endpoints: endpoints,
        stages: stages,
        limits: Limits {
            present: false,
            max_parallel: 0,
            max_per_hour: 0,
            max_depth: 0,
            max_pending: 0,
        },
    };
    println(emit_document(doc).len());
}
