// Accept fixture: `match actor.method() { ... }` — an actor ask is an ordinary
// call, so the scrutinee must be typed `Result<i64, AskError>` and not the
// handler's raw return type (`i64`, which would give "constructor pattern `Ok`
// cannot match non-enum type i64").
//
// Stdout contract: `result: 10` (5 * 2).
actor Doubler {
    receive fn process(n: i64) -> i64 {
        n * 2
    }
}

fn main() {
    let doubler = spawn Doubler;
    let r = match doubler.process(5) {
        .Ok(v) => v,
        .Err(_) => -1,
    };
    println(f"result: {r}");
}
