//! `bytes` parameter passing matches `Vec` parameter passing: both are values,
//! so a callee's mutation reaches the caller through the returned value and
//! through nothing else. This fixture runs the identical "push in callee,
//! rebind, read length in caller" shape over a `Vec<i64>` and a `bytes`, then
//! prints both lengths. A value type that quietly dropped the callee's growth
//! would read back 0. A successful run prints `vec_len=1 bytes_len=1`.

fn fill_vec(var v: Vec<i64>) -> Vec<i64> {
    v.push(7);
    v
}

fn fill_bytes(var b: bytes) -> bytes {
    b.push(7);
    b
}

fn main() -> i64 {
    var v: Vec<i64> = Vec.new();
    v = fill_vec(v);
    var b: bytes = bytes.new();
    b = fill_bytes(b);
    println(f"vec_len={v.len()} bytes_len={b.len()}");
    0
}
