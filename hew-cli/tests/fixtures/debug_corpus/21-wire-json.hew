// Wire type round-tripped through JSON.
import std.encoding.json;

#[wire]
type Point {
    x: i64 @1;
    y: i64 @2;
}

fn main() {
    let p = Point { x: 3, y: 4 };
    let j = json.encode(p);
    println(j);
    match json.decode<Point>(j) {
        .Ok(back) => println(back.x + back.y),
        .Err(_) => println("decode failed"),
    }
}
