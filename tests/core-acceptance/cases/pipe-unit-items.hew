import std.stream;

type Tick {}

// `()` items carry no bytes: each send is one item, and close is end of data.
fn main() {
    let (ticks, input): (stream.Sink<()>, stream.Stream<()>) = match stream.pipe(4) {
        .Ok(pair) => pair,
        .Err(error) => panic(error),
    };
    ticks.send(()).expect("first tick");
    ticks.send(()).expect("second tick");
    ticks.close();
    let first = select {
        tick from input.recv() => match tick {
            .Some(_) => "tick",
            .None => "end",
        }
        after 1s => "timeout",
    };
    println(first);
    var rest = 0;
    for tick in input {
        rest += 1;
    }
    println(f"then {rest} more");

    // Empty records and tuples also have zero-sized physical representations.
    let (records, record_input): (stream.Sink<Tick>, stream.Stream<Tick>) =
        stream.pipe(1).expect("record pipe");
    records.send(Tick {}).expect("record tick");
    records.finish();
    assert(record_input.try_recv().is_some());
    assert(record_input.try_recv().is_none());

    let (tuples, tuple_input): (stream.Sink<((), ())>, stream.Stream<((), ())>) =
        stream.pipe(1).expect("tuple pipe");
    tuples.send(((), ())).expect("tuple tick");
    tuples.finish();
    var tuple_count = 0;
    for tick in tuple_input {
        tuple_count += 1;
    }
    assert(tuple_count == 1);
}
