type ActorRequestAdmission {
    n: i64;
}

actor Echo {
    receive fn reply(n: i64) -> i64 {
        n + 1
    }
}

fn main() {
    let own = ActorRequestAdmission { n: 7 };
    println(own.n);
    let echo = spawn Echo;
    match echo.reply(own.n) {
        .Ok(value) => println(value),
        .Err(_) => println(-1),
    }
    close(echo);
}
