import std.string;

type Pair {
    keep: Vec<string>,
    churn: string,
}

fn main() -> i64 {
    var v: Vec<string> = Vec.new();
    v.push(string.repeat("k", 32));
    var p = Pair { keep: v, churn: string.repeat("a", 32) };
    var i: i64 = 0;
    while i < 50 {
        p = Pair { churn: string.repeat("b", 32), ..p };
        i = i + 1;
    }
    p.keep.len()
}
