// A Vec whose element type has no clone drains through `into_iter()`: each
// step moves the element out of the vector the cursor owns, so the body is the
// element's owner and a completed drain leaves the vector empty. An early
// `break` releases the elements the drain never reached, exactly once each.
import std.iter;

#[resource]
type Token {
    label: string;
    id: i64;
}

impl Token {
    fn close(consume self) {
        println(f"close {self.label}{self.id}");
    }

    fn show(self) {
        println(f"show {self.label}{self.id}");
    }
}

fn make(label: string) -> Vec<Token> {
    var tokens: Vec<Token> = Vec.new();
    tokens.push(Token { label: label, id: 1 });
    tokens.push(Token { label: label, id: 2 });
    tokens.push(Token { label: label, id: 3 });
    return tokens;
}

fn main() -> i64 {
    // A full drain hands each element to the body in order, and the body owns
    // it: closing it here is the only release.
    let all = make("a");
    for token in all.into_iter() {
        token.show();
        token.close();
    }
    println("drained");

    // An early exit leaves the untaken elements to the cursor, which releases
    // them when it goes out of scope.
    let some = make("b");
    for token in some.into_iter() {
        token.show();
        if token.id == 2 {
            break;
        }
        token.close();
    }
    println("stopped");

    // `pop()` is the other owning removal and still takes from the back.
    var rest = make("c");
    while !rest.is_empty() {
        let token = rest.pop();
        token.show();
    }
    println("popped");
    {
        var both = make("d").into_iter();
        match both.next_back() {
            .Some(token) => token.close(),
            .None => panic("missing back token"),
        }
        match both.next() {
            .Some(token) => token.close(),
            .None => panic("missing front token"),
        }
    };
    println("mixed");
    for token in iter.rev(make("e").into_iter()) {
        token.close();
        break;
    }
    println("reverse stopped");
    for token in iter.rev(iter.filter(make("f").into_iter(), |token: Token| token.id < 3)) {
        token.close();
        break;
    }
    println("filtered stopped");
    let ids = iter.collect(iter.rev(iter.map(make("g").into_iter(), |token: Token| token.id)));
    assert(ids == [3, 2, 1]);
    {
        var ordered: Vec<Token> = [];
        for id in 1..8 {
            ordered.push(Token { label: "h", id: id });
        }
        var cursor = ordered.into_iter();
        cursor.next().expect("ordered front").close();
        cursor.next_back().expect("ordered back").close();
    };
    println("ordered remainder");
    0
}
