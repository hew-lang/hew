actor Worker {
    receive fn fail() { panic("restart me"); }
    receive fn work() -> string { "done" }
}
supervisor WorkerTree {
    strategy: one_for_one,
    intensity: 3 within 60s,
    child worker: Worker,
}
fn main() {
    let tree = spawn WorkerTree;
    let worker = tree.worker;
    let _ = worker.fail();
    println(worker.work().expect("fresh incarnation"));
    close(tree);
}
