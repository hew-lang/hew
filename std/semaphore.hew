//! Counting semaphore for concurrency control.
//!
//! Limit the number of concurrent actors or tasks that can access a
//! shared resource.
//!
//! # Examples
//!
//! ```
//! import std.semaphore;
//!
//! fn main() {
//!     let sem = semaphore.new(3);
//!     let lease = sem.lease();
//!     // critical section
//!     lease.close();
//!     sem.close();
//! }
//! ```
//!
//! Call `clone()` explicitly to share one permit count. Each returned handle
//! closes independently; assigning a semaphore does not create another owner.
//! `lease()` returns one capacity unit automatically at scope exit. Raw
//! `acquire()` and `release()` support cross-task signalling; closing a raw
//! semaphore handle does not return previously acquired capacity.

/// An opaque counting semaphore handle.
///
/// Created by `semaphore.new(count)`. Semaphores close automatically at scope
/// exit; call `close()` to release one early.
#[opaque]
type SemaphoreHandle {
}

#[resource]
pub type Semaphore {
    handle: SemaphoreHandle;
}

/// Exclusive ownership of one acquired semaphore capacity unit.
///
/// Dropping or closing the lease returns its capacity exactly once. A lease
/// can move to another task; it cannot be cloned. The semaphore may close
/// while a lease remains alive.
#[resource]
pub type Lease {
    semaphore: Semaphore;
}

impl Lease {
    /// Return this lease's capacity early.
    fn close(consume self) {
        let Lease { semaphore } = self;
        semaphore.release();
        semaphore.close();
    }
}

/// Methods available on a `Semaphore`.
trait SemaphoreMethods {
    /// Block until a permit is available, then acquire it.
    fn acquire(self);

    /// Try to acquire a permit without blocking.
    ///
    /// Returns `true` if a permit was acquired, `false` otherwise.
    fn try_acquire(self) -> bool;

    /// Try to acquire a permit, waiting up to `timeout`.
    ///
    /// Returns `true` if a permit was acquired before the timeout.
    fn acquire_timeout(self, timeout: duration) -> bool;

    /// Release a previously acquired permit.
    fn release(self);

    /// Return the current number of available permits.
    fn count(self) -> i64;
}

impl SemaphoreMethods for Semaphore {
    /// Block until a permit is available, then acquire it.
    fn acquire(self) {
        unsafe {
            hew_semaphore_acquire(self.handle)
        };
    }
    /// Try to acquire a permit without blocking.
    fn try_acquire(self) -> bool {
        unsafe {
            hew_semaphore_try_acquire(self.handle)
        }
    }
    /// Try to acquire a permit, waiting up to `timeout`.
    fn acquire_timeout(self, timeout: duration) -> bool {
        let timeout_ms = timeout.millis_ceil();
        let wait_ms = if timeout_ms < 0 {
            0
        } else {
            timeout_ms
        };
        unsafe {
            hew_semaphore_acquire_timeout(self.handle, wait_ms as i64)
        } // INTERNAL-ABI: C ABI takes i64 timeout
    }
    /// Release a previously acquired permit.
    fn release(self) {
        unsafe {
            hew_semaphore_release(self.handle)
        };
    }
    /// Return the current number of available permits.
    fn count(self) -> i64 {
        unsafe {
            hew_semaphore_count(self.handle) as i64
        }
    }
}

impl Semaphore {
    /// Acquire one capacity unit, returning an owned lease.
    ///
    /// Scope exit, fault and cancellation return acquired capacity. While
    /// waiting, cancellation removes the pending acquisition. Raw `acquire`
    /// and `release` remain available for cross-task signalling.
    fn lease(self) -> Lease {
        let owner = self.clone();
        owner.acquire();
        Lease { semaphore: owner }
    }

    /// Create an independently owned handle to this semaphore.
    ///
    /// Both handles share one permit count. Close each handle separately.
    fn clone(self) -> Semaphore {
        unsafe {
            Semaphore { handle: hew_semaphore_clone(self.handle) }
        }
    }

    /// Release this semaphore early.
    fn close(consume self) {
        unsafe {
            hew_semaphore_free(self.handle)
        };
    }
}

// ── Module-level functions ────────────────────────────────────────────
/// Create a new counting semaphore with the given number of permits.
///
/// # Examples
///
/// ```
/// import std.semaphore;
///
/// fn main() {
///     let sem = semaphore.new(5);
/// }
/// ```
pub fn new(count: i64) -> Semaphore {
    if count < 0 || count > 2147483647 {
        panic(f"semaphore.new: permit count {count} is outside the supported range");
    }
    unsafe {
        Semaphore { handle: hew_semaphore_new(count as i32) }
    } // INTERNAL-ABI: C ABI takes i32 initial count
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    #[runtime_capability(value)]
    fn hew_semaphore_new(initial_count: i32) -> SemaphoreHandle;
    #[runtime_capability(resource_operation)]
    fn hew_semaphore_clone(sem: SemaphoreHandle) -> SemaphoreHandle;
    fn hew_semaphore_acquire(sem: SemaphoreHandle);
    #[runtime_capability(resource_operation)]
    fn hew_semaphore_try_acquire(sem: SemaphoreHandle) -> bool;
    fn hew_semaphore_acquire_timeout(sem: SemaphoreHandle, timeout_ms: i64) -> bool;
    #[runtime_capability(resource_operation)]
    fn hew_semaphore_release(sem: SemaphoreHandle);
    #[runtime_capability(resource_operation)]
    fn hew_semaphore_count(sem: SemaphoreHandle) -> i32;
    #[runtime_capability(resource_operation)]
    fn hew_semaphore_free(sem: SemaphoreHandle);
}
