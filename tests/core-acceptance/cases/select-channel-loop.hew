// Two pipes selected in one loop. Source order takes the first ready arm, so
// the loop drains the first pipe then the second, and each close arrives as
// its own `None`.
import std.stream;

fn main() {
    let (txa, rxa): (stream.Sink<string>, stream.Stream<string>) =
        match stream.pipe(4) {
            .Ok(pair) => pair,
            .Err(error) => {
                println(error);
                return;
            },
        };
    let (txb, rxb): (stream.Sink<string>, stream.Stream<string>) =
        match stream.pipe(4) {
            .Ok(pair) => pair,
            .Err(error) => {
                println(error);
                return;
            },
        };
    txa.send("a1").expect("send");
    txb.send("b1").expect("send");
    txa.send("a2").expect("send");
    txb.send("b2").expect("send");

    var items = 0;
    while items < 4 {
        select {
            v from rxa.recv() => match v {
                .Some(item) => {
                    println(f"a {item}");
                    items = items + 1;
                },
                .None => println("a closed early"),
            },
            v from rxb.recv() => match v {
                .Some(item) => {
                    println(f"b {item}");
                    items = items + 1;
                },
                .None => println("b closed early"),
            },
        }
    }

    // A finished pipe is permanently ready, so under source order it would
    // win every later round. Observe each close on its own receive instead.
    txa.close();
    txb.close();
    match rxa.recv() {
        .Some(item) => println(f"a {item}"),
        .None => println("a closed"),
    }
    match rxb.recv() {
        .Some(item) => println(f"b {item}"),
        .None => println("b closed"),
    }
    rxa.close();
    rxb.close();
}
