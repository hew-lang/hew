//! Status: runnable
//! Description: Backpressure test - bounded mailbox demo

// Backpressure test - bounded mailbox demo
// Demonstrates that actors with bounded mailboxes apply backpressure
actor SlowWorker {
    let id: i32,

    mailbox 4,
    receive fn process(value: i32) {
        print("SlowWorker ");
        print(id);
        println(f": processing {value}");
        sleep(50ms);
    }
}

fn main() {
    println("=== Backpressure Test ===");
    let worker = spawn SlowWorker(id: 1);
    // A full mailbox cooperatively suspends this sender; it does not park a
    // runtime worker thread.
    for i in 0 .. 8 {
        worker.process(i);
    }
    sleep(500ms);
    println("=== Done ===");
}
