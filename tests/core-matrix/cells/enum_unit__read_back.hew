enum Colour {
    Red;
    Green;
}

fn main() {
    let x: Colour = .Red;
    let v: Vec<Colour> = Vec.new();
    v.push(x);
    match v.get(0) {
        Option.Some(e) => {
            match e { .Red => println("Red"), .Green => println("Green"), }
        },
        Option.None => println("missing"),
    }
}
