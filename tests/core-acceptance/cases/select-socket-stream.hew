// A socket stream is a select source. An idle connection loses to a timer and
// to an actor call, and the losing watch reads nothing: every byte sent later
// arrives through the next receive. A readable connection wins with exactly
// the bytes sent, and a closed peer wins with the end of the stream.
import std.net;

actor Clock {
    receive fn tick(n: i64) -> i64 { n + 1 }
}

fn show(data: Option<bytes>) -> string {
    match data {
        .Some(chunk) => f"{chunk.len()} bytes",
        .None => "end of stream",
    }
}

fn main() {
    let listener = net.listen("127.0.0.1:0").expect("listen");
    let port = listener.local_port();
    let client = net.connect(f"127.0.0.1:{port}").expect("connect");
    let server = listener.accept();
    let (input, output) = server.split();
    let clock = spawn Clock;

    select {
        data from input.recv() => println(f"idle socket answered: {show(data)}"),
        after 20ms => println("timer beat an idle socket"),
    }
    select {
        data from input.recv() => println(f"idle socket answered: {show(data)}"),
        n from clock.tick(41) => println(f"actor call beat an idle socket: {n.expect("tick")}"),
    }

    client.send(b"hello").expect("send");
    select {
        data from input.recv() => println(f"readable socket won: {show(data)}"),
        after 10s => println("timer beat a readable socket"),
    }

    select {
        data from input.recv() => println(f"idle socket answered: {show(data)}"),
        after 20ms => println("timer beat an idle socket again"),
    }
    client.send(b"world!").expect("send");
    println(f"next receive: {show(input.recv())}");

    client.close();
    select {
        data from input.recv() => println(f"closed peer won: {show(data)}"),
        after 10s => println("timer beat a closed peer"),
    }
    output.close();
    listener.close();
    close(clock);
}
