// Rotate array by k positions to the right
// [1,2,3,4,5] k=2 -> [4,5,1,2,3]
// A parameter is the callee's own copy, so the reversed vector travels back
// through the return value.
fn reverse_range(var arr: Vec<i32>, start: i32, end: i32) -> Vec<i32> {
    var l: i64 = start as i64;
    let end64: i64 = end as i64;
    var r: i64 = end64 - 1;
    while l < r {
        let tmp = arr[l];
        arr.set(l, arr[r]);
        arr.set(r, tmp);
        l = l + 1;
        r = r - 1;
    }
    arr
}

fn main() {
    var arr: Vec<i32> = [1, 2, 3, 4, 5];
    let n = arr.len();
    let k = 2 % n;
    // Reverse entire array, then reverse first k, then reverse rest
    arr = reverse_range(arr, 0, n as i32);
    arr = reverse_range(arr, 0, k as i32);
    arr = reverse_range(arr, k as i32, n as i32);

    // Expected: [4,5,1,2,3]
    let expected: Vec<i32> = [4, 5, 1, 2, 3];
    var pass = true;
    for i in 0..5 {
        if arr[i] != expected[i] {
            pass = false;
            println("FAIL at index:");
            println(i);
        }
    }
    if pass {
        println("PASS");
    } else {
        println("FAIL");
    }
}
