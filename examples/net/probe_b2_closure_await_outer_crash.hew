// Retained future semantic fixture for an ASK handler that crashes before a
// child suspending closure reaches its await. Once function types carry
// suspension metadata, this will exercise restoration of the outer reply route
// while a closure driver is active. The `trigger` parameter keeps the await
// structurally reachable so the closure remains classified as suspending.
// Today invocation sites cannot select a matching driver safely, so MIR
// deliberately rejects this fixture with `suspension inside a closure` before
// code generation; none of the runtime crash/reply behavior below is executed.
import std.net.{Listener};

extern "C" {
    fn hew_tcp_listener_local_port(listener: Listener) -> i32;
}

actor Reader {
    let addr: string,
    receive fn go(trigger: i64) -> i64 {
        sleep(200ms);
        let conn = match net.connect(addr) {
            .Ok(conn) => conn,
            .Err(_) => panic(f"network setup failed"),
        };
        let read_once = || {
            if trigger >= 0 {
                panic("reader crashed mid suspending-closure await");
            }
            await conn.read_string()
        };
        let body = read_once();
        println(f"reader-received: {body}");
        let _ = conn.close();
        7
    }
}

fn main() {
    let listener = match net.listen("127.0.0.1:0") {
        .Ok(listener) => listener,
        .Err(_) => panic(f"network setup failed"),
    };
    let port = unsafe {
        hew_tcp_listener_local_port(listener)
    };
    let reader = spawn Reader(addr: f"127.0.0.1:{port}");
    let r = await reader.go(0);
    match r {
        .Ok(v) => println(f"reader-returned: {v}"),
        .Err(_) => println("reader-crash-fallback"),
    }
    println("main-done");
}
