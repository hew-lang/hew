//! Drain a `Stream<string>` using ordinary `input.recv()` calls.
//! The empty string is a valid item; only `None` marks EOF.
//! `sink.send(item)` waits for capacity when the pipe is full.

import std.stream;

actor StringPipeline {
    receive fn run(unused: i64) {
        let (sink, input) = match stream.pipe(8) {
            .Ok(pair) => pair,
            .Err(error) => panic(error),
        };
        // Send three normal frames, one empty frame between them, then EOF.
        sink.send("frame-0");
        sink.send("");
        sink.send("frame-1");
        sink.send("frame-2");
        sink.close();

        // Consumer: each recv suspends until a frame is ready; None == EOF.
        var received = 0;
        var done = false;
        while !done {
            let item = input.recv();
            match item {
                .Some(frame) => {
                    println(f"recv [{frame}]");
                    received = received + 1;
                },
                .None => {
                    done = true;
                },
            }
        }
        println(f"drained {received} frames");
    }
}

fn main() {
    // Every line is printed by the handler, in program order; runtime shutdown
    // drains the mailbox to quiescence. A trailing print from `main` would be
    // ordered against the handler only by a sleep, which is not an edge.
    let p = spawn StringPipeline;
    let _ = p.run(0);
}
