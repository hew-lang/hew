fn run_cycle(k: i64) -> i64 {
    let t = (k, "skip-tuple-heap-payload".to_upper());
    let x = match t {
        (x, _) => x,
    };
    x
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        total = total + run_cycle(i);
        i = i + 1;
    }
    if total >= 0 { 0 } else { 1 }
}
