//! Tests for std::vec helpers — index_of, first, last, min, max.

import std.vec;


// ── index_of_i32 ──────────────────────────────────────────────────────────
#[test]
fn test_index_of_i32_found_first() {
    var v: Vec<i32> = Vec.new();
    v.push(10);
    v.push(20);
    v.push(30);
    let result = vec.index_of_i32(v, 10);
    assert(result.is_some());
    assert(result.unwrap_or(-1) == 0);
}

#[test]
fn test_index_of_i32_found_middle() {
    var v: Vec<i32> = Vec.new();
    v.push(10);
    v.push(20);
    v.push(30);
    let result = vec.index_of_i32(v, 20);
    assert(result.is_some());
    assert(result.unwrap_or(-1) == 1);
}

#[test]
fn test_index_of_i32_found_last() {
    var v: Vec<i32> = Vec.new();
    v.push(10);
    v.push(20);
    v.push(30);
    let result = vec.index_of_i32(v, 30);
    assert(result.is_some());
    assert(result.unwrap_or(-1) == 2);
}

#[test]
fn test_index_of_i32_not_found() {
    var v: Vec<i32> = Vec.new();
    v.push(10);
    v.push(20);
    assert(vec.index_of_i32(v, 99).is_none());
}

#[test]
fn test_index_of_i32_empty() {
    let v: Vec<i32> = Vec.new();
    assert(vec.index_of_i32(v, 5).is_none());
}

#[test]
fn test_index_of_i32_returns_first_occurrence() {
    var v: Vec<i32> = Vec.new();
    v.push(7);
    v.push(7);
    v.push(7);
    let result = vec.index_of_i32(v, 7);
    assert(result.is_some());
    assert(result.unwrap_or(-1) == 0);
}

// ── index_of_i64 ──────────────────────────────────────────────────────────
#[test]
fn test_index_of_i64_found() {
    var v: Vec<i64> = Vec.new();
    v.push(100);
    v.push(200);
    v.push(300);
    let result = vec.index_of_i64(v, 200);
    assert(result.is_some());
    assert(result.unwrap_or(-1) == 1);
}

#[test]
fn test_index_of_i64_not_found() {
    var v: Vec<i64> = Vec.new();
    v.push(100);
    assert(vec.index_of_i64(v, 999).is_none());
}

#[test]
fn test_index_of_i64_empty() {
    let v: Vec<i64> = Vec.new();
    assert(vec.index_of_i64(v, 0).is_none());
}

#[test]
fn test_index_of_i64_returns_first_occurrence() {
    var v: Vec<i64> = Vec.new();
    v.push(9);
    v.push(9);
    v.push(9);
    let result = vec.index_of_i64(v, 9);
    assert(result.is_some());
    assert(result.unwrap_or(-1) == 0);
}

