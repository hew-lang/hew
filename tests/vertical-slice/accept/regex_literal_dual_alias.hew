// Identical regex literals own independent handles. Closing one leaves the
// other's matching and cleanup valid.
import std.text.regex;

fn main() {
    let pat1 = re"[0-9]+";
    let pat2 = re"[0-9]+";
    println(pat1.find("abc123").expect("first digit run"));
    pat1.close();
    println(pat2.find("xyz456").expect("second digit run"));
    pat2.close();
}
