//! Tests for the std::option helper functions.

import std.option;


// ── Predicates ─────────────────────────────────────────────────────────
#[test]
fn test_is_some_int_with_value() {
    let x = Option.Some(42);
    assert(option.is_some_int(x));
}

#[test]
fn test_is_some_int_with_none() {
    let x: Option<i64> = .None;
    assert(!option.is_some_int(x));
}

#[test]
fn test_is_none_int_with_none() {
    let x: Option<i64> = .None;
    assert(option.is_none_int(x));
}

#[test]
fn test_is_none_int_with_value() {
    let x = Option.Some(10);
    assert(!option.is_none_int(x));
}

// ── Unwrap ─────────────────────────────────────────────────────────────
#[test]
fn test_unwrap_int_some() {
    let x = Option.Some(42);
    assert(option.unwrap_int(x) == 42);
}

#[test]
#[should_panic]
fn test_unwrap_int_none_panics() {
    let x: Option<i64> = .None;
    option.unwrap_int(x);
}

#[test]
fn test_unwrap_or_int_some() {
    let x = Option.Some(42);
    assert(option.unwrap_or_int(x, 0) == 42);
}

#[test]
fn test_unwrap_or_int_none() {
    let x: Option<i64> = .None;
    assert(option.unwrap_or_int(x, -1) == -1);
}

// ── Map ────────────────────────────────────────────────────────────────
#[test]
fn test_map_int_some() {
    let x = Option.Some(21);
    let mapped = option.map_int(x, |v: i64| v * 2);
    assert(option.unwrap_int(mapped) == 42);
}

#[test]
fn test_map_int_none() {
    let x: Option<i64> = .None;
    let mapped = option.map_int(x, |v: i64| v * 2);
    assert(option.is_none_int(mapped));
}

// ── Contains ───────────────────────────────────────────────────────────
#[test]
fn test_contains_int_match() {
    let x = Option.Some(42);
    assert(option.contains_int(x, 42));
}

#[test]
fn test_contains_int_no_match() {
    let x = Option.Some(42);
    assert(!option.contains_int(x, 99));
}

#[test]
fn test_contains_int_none() {
    let x: Option<i64> = .None;
    assert(!option.contains_int(x, 42));
}

// ── string variants ────────────────────────────────────────────────────
#[test]
fn test_is_some_str_with_value() {
    let x = Option.Some("hello");
    assert(option.is_some_str(x));
}

#[test]
fn test_is_none_str_with_none() {
    let x: Option<string> = .None;
    assert(option.is_none_str(x));
}

#[test]
fn test_unwrap_or_str_some() {
    let x = Option.Some("hello");
    assert(option.unwrap_or_str(x, "default") == "hello");
}

#[test]
fn test_unwrap_or_str_none() {
    let x: Option<string> = .None;
    assert(option.unwrap_or_str(x, "fallback") == "fallback");
}

#[test]
fn test_map_str_some() {
    let x = Option.Some("hello");
    let mapped = option.map_str(x, |s: string| s + "!");
    assert(option.unwrap_str(mapped) == "hello!");
}

#[test]
fn test_map_str_none() {
    let x: Option<string> = .None;
    let mapped = option.map_str(x, |s: string| s + "!");
    assert(option.is_none_str(mapped));
}

#[test]
fn test_contains_str_match() {
    let x = Option.Some("hello");
    assert(option.contains_str(x, "hello"));
}

#[test]
fn test_contains_str_no_match() {
    let x = Option.Some("hello");
    assert(!option.contains_str(x, "world"));
}

// ── unwrap_str ─────────────────────────────────────────────────────────
#[test]
fn test_unwrap_str_some() {
    let x = Option.Some("hello");
    assert(option.unwrap_str(x) == "hello");
}

#[test]
#[should_panic]
fn test_unwrap_str_none_panics() {
    let x: Option<string> = .None;
    option.unwrap_str(x);
}

// ── Float variants ─────────────────────────────────────────────────────
#[test]
fn test_is_some_f64_with_value() {
    let x = Option.Some(3.5);
    assert(option.is_some_f64(x));
}

#[test]
fn test_is_none_f64_with_none() {
    let x: Option<f64> = .None;
    assert(option.is_none_f64(x));
}

#[test]
fn test_unwrap_or_f64_some() {
    let x = Option.Some(3.5);
    assert(option.unwrap_or_f64(x, 0.0) == 3.5);
}

#[test]
fn test_unwrap_or_f64_none() {
    let x: Option<f64> = .None;
    assert(option.unwrap_or_f64(x, -1.5) == -1.5);
}

#[test]
fn test_map_f64_some() {
    let x = Option.Some(1.5);
    let mapped = option.map_f64(x, |v: f64| v * 2.0);
    assert(option.unwrap_or_f64(mapped, 0.0) == 3.0);
}

#[test]
fn test_map_f64_none() {
    let x: Option<f64> = .None;
    let mapped = option.map_f64(x, |v: f64| v * 2.0);
    assert(option.is_none_f64(mapped));
}

#[test]
fn test_contains_f64_match() {
    let x = Option.Some(3.5);
    assert(option.contains_f64(x, 3.5));
}

#[test]
fn test_contains_f64_no_match() {
    let x = Option.Some(3.5);
    assert(!option.contains_f64(x, 2.5));
}

#[test]
fn test_contains_f64_none() {
    let x: Option<f64> = .None;
    assert(!option.contains_f64(x, 3.5));
}

// ── Methods ──────────────────────────────────────────────────────────
//
// Option methods are available on every Option without an import.
#[test]
fn test_map_applies_f_on_some() {
    let x: Option<i64> = .Some(5);
    assert(x.map(|v: i64| v * 2).unwrap_or(0) == 10);
}

#[test]
fn test_map_is_none_on_none() {
    let x: Option<i64> = .None;
    // Negative control: mapping `None` must stay `None`, not fall through to
    // `f`'s value.
    assert(x.map(|v: i64| v * 2).is_none());
}

#[test]
fn test_and_then_chains_on_some() {
    let x: Option<i64> = .Some(5);
    let chained = x.and_then(|v: i64| if v > 0 { .Some(v + 1) } else { .None });
    assert(chained.unwrap_or(-1) == 6);
}

#[test]
fn test_and_then_short_circuits_when_f_returns_none() {
    let x: Option<i64> = .Some(-1);
    // Negative control: `f` itself returns `None` for a negative input.
    let chained = x.and_then(|v: i64| if v > 0 { .Some(v + 1) } else { .None });
    assert(chained.is_none());
}

#[test]
fn test_and_then_is_none_on_none() {
    let x: Option<i64> = .None;
    assert(x.and_then(|v: i64| .Some(v + 1)).is_none());
}

#[test]
fn test_unwrap_or_else_returns_value_on_some() {
    let x: Option<i64> = .Some(7);
    assert(x.unwrap_or_else(|| 99) == 7);
}

#[test]
fn test_unwrap_or_else_runs_fallback_on_none() {
    let x: Option<i64> = .None;
    assert(x.unwrap_or_else(|| 99) == 99);
}

#[test]
fn test_or_else_keeps_some() {
    let x: Option<string> = .Some("kept");
    assert(x.or_else(|| .Some("fallback")).expect("some") == "kept");
}

#[test]
fn test_or_else_replaces_none() {
    let x: Option<string> = .None;
    assert(x.or_else(|| .Some("fallback")).expect("some") == "fallback");
}

#[test]
fn test_ok_or_converts_some_to_ok() {
    let x: Option<i64> = .Some(5);
    let converted: Result<i64, string> = x.ok_or("missing");
    match converted {
        .Ok(v) => assert(v == 5),
        .Err(_) => assert(false),
    }
}

#[test]
fn test_ok_or_converts_none_to_err() {
    let x: Option<i64> = .None;
    // Negative control: `None` must become `Err(err)`, not `Ok` of anything.
    let converted: Result<i64, string> = x.ok_or("missing");
    match converted {
        .Ok(_) => assert(false),
        .Err(e) => assert(e == "missing"),
    }
}

#[test]
fn test_take_leaves_none_behind() {
    var slot: Option<string> = .Some("moved");
    let taken = slot.take();
    assert(taken.expect("taken") == "moved");
    assert(slot.is_none());
}

#[test]
fn test_string_chain_moves_payload_through_each_step() {
    let name: Option<string> = .Some("hew");
    let shout = name.map(|s: string| f"{s}!").and_then(|s: string| if s.len() > 1 { .Some(s) } else { .None });
    assert(shout.unwrap_or("none") == "hew!");
}
