// Accept: value-context `.send` on a lambda-actor handle materializes
// `Result<(), ActorError<Never, Never>>` AND still delivers the message.
//
// `actor |x: i64| { println(x); }` produces a lambda-actor handle
// (`actor(i64)`). Calling the handle directly (no mailbox view) is a
// completion call: it waits for the handler exactly as a call on a named
// actor's handle does, so the checker types it `Result<(),
// ActorError<Never, Never>>` (the reply type is `()`, and `Never` marks the
// handler as infallible). MIR sizes the dest from that recorded type and
// routes the call through the lambda-actor ABI.
//
// A successful in-process send completes the round trip, which maps to
// `Result::Ok(())`. Exit 7 proves the Ok arm was reached; stdout `99` proves
// the message was actually delivered to the actor (not silently dropped).
//
// The Err arm is exhaustively typed but unreachable here: this call never
// rejects, faults, or fails to route in this fixture's single-process,
// single-message shape.
fn main() -> i64 {
    let printer = actor |x: i64| {
        println(x);
    };
    let result: Result<(), ActorError<Never, Never>> = printer.send(99);
    match result {
        Result.Ok(_) => 7,
        Result.Err(e) => match e {
            ActorError.Rejected(_) => 1,
            ActorError.Failed(_) => 2,
            ActorError.Trapped => 3,
            ActorError.Dead => 4,
            ActorError.Timeout => 5,
            ActorError.NodeNotRunning => 6,
            ActorError.RoutingFailed => 8,
            ActorError.EncodeFailed => 9,
            ActorError.ConnectionDropped => 10,
            ActorError.Partition => 11,
        },
    }
}
