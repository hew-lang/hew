// Ordered (Sorted) Linked List using Vec<i64> with index-based pointers
// Node layout: [value, next] pairs at i*2, i*2+1
// Maintains sorted order on insert
//
// A parameter is the callee's own copy, so every helper that writes the node
// pool returns it and the caller reassigns. Helpers that also move the head
// return a tuple.
fn node_val(n: Vec<i64>, i: i64) -> i64 {
    n[i * 2]
}

fn node_next(n: Vec<i64>, i: i64) -> i64 {
    n[i * 2 + 1]
}

fn set_next(var n: Vec<i64>, i: i64, nx: i64) -> Vec<i64> {
    n.set(i * 2 + 1, nx);
    n
}

fn alloc_node(var n: Vec<i64>, val: i64) -> (Vec<i64>, i64) {
    let idx = n.len() / 2;
    n.push(val);
    n.push(-1);
    (n, idx)
}

// Insert in sorted order; returns the pool and the new head
fn insert_sorted(var n: Vec<i64>, head: i64, val: i64) -> (Vec<i64>, i64) {
    let (grown, nd) = alloc_node(n, val);
    n = grown;
    if head == -1 {
        return (n, nd);
    }
    if val <= node_val(n, head) {
        n = set_next(n, nd, head);
        return (n, nd);
    }
    var prev = head;
    var curr = node_next(n, head);
    var done = 0;
    while curr != -1 {
        if done == 0 {
            if val <= node_val(n, curr) {
                n = set_next(n, prev, nd);
                n = set_next(n, nd, curr);
                done = 1;
            }
        }
        if done == 0 {
            prev = curr;
            curr = node_next(n, curr);
        } else {
            curr = -1;
        }
    }
    if done == 0 {
        n = set_next(n, prev, nd);
    }
    (n, head)
}

// Insert every value in order; returns the pool and the head.
fn insert_all(var n: Vec<i64>, head: i64, values: Vec<i64>) -> (Vec<i64>, i64) {
    var curr_head = head;
    for value in values {
        let (grown, new_head) = insert_sorted(n, curr_head, value);
        n = grown;
        curr_head = new_head;
    }
    (n, curr_head)
}

// Search for value, returns node index or -1
fn search(n: Vec<i64>, head: i64, val: i64) -> i64 {
    var curr = head;
    while curr != -1 {
        if node_val(n, curr) == val {
            return curr;
        }
        if node_val(n, curr) > val {
            return -1;
        }
        curr = node_next(n, curr);
    }
    -1
}

// Delete first occurrence; returns the pool and the new head
fn delete_val(var n: Vec<i64>, head: i64, val: i64) -> (Vec<i64>, i64) {
    if head == -1 {
        return (n, -1);
    }
    if node_val(n, head) == val {
        return (n, node_next(n, head));
    }
    var prev = head;
    var curr = node_next(n, head);
    while curr != -1 {
        if node_val(n, curr) == val {
            n = set_next(n, prev, node_next(n, curr));
            return (n, head);
        }
        if node_val(n, curr) > val {
            return (n, head);
        }
        prev = curr;
        curr = node_next(n, curr);
    }
    (n, head)
}

fn traverse(n: Vec<i64>, head: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec.new();
    var curr = head;
    while curr != -1 {
        result.push(node_val(n, curr));
        curr = node_next(n, curr);
    }
    result
}

fn list_len(n: Vec<i64>, head: i64) -> i64 {
    var c = 0;
    var curr = head;
    while curr != -1 {
        c = c + 1;
        curr = node_next(n, curr);
    }
    c
}

fn is_sorted(n: Vec<i64>, head: i64) -> i64 {
    if head == -1 {
        return 1;
    }
    var curr = head;
    var nx = node_next(n, head);
    while nx != -1 {
        if node_val(n, curr) > node_val(n, nx) {
            return 0;
        }
        curr = nx;
        nx = node_next(n, curr);
    }
    1
}

fn vecs_equal(a: Vec<i64>, b: Vec<i64>) -> i64 {
    if a.len() != b.len() {
        return 0;
    }
    for i in 0 .. a.len() {
        if a[i] != b[i] {
            return 0;
        }
    }
    1
}

// --- Tests ---
fn test_sorted_insert() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let values: Vec<i64> = [50, 10, 30, 20, 40];
    let (n, head) = insert_all(pool, -1, values);
    let r = traverse(n, head);
    var e: Vec<i64> = Vec.new();
    e.push(10);
    e.push(20);
    e.push(30);
    e.push(40);
    e.push(50);
    if vecs_equal(r, e) == 1 {
        println("PASS: sorted insert");
        return 1;
    }
    println("FAIL: sorted insert");
    0
}

fn test_duplicates() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let values: Vec<i64> = [20, 10, 20, 10];
    let (n, head) = insert_all(pool, -1, values);
    if is_sorted(n, head) == 1 {
        if list_len(n, head) == 4 {
            println("PASS: duplicates");
            return 1;
        }
    }
    println("FAIL: duplicates");
    0
}

fn test_search() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let values: Vec<i64> = [10, 30, 50];
    let (n, head) = insert_all(pool, -1, values);
    let found = search(n, head, 30);
    let not_found = search(n, head, 25);
    if found != -1 {
        if node_val(n, found) == 30 {
            if not_found == -1 {
                println("PASS: search");
                return 1;
            }
        }
    }
    println("FAIL: search");
    0
}

fn test_delete() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let values: Vec<i64> = [10, 20, 30, 40];
    let (inserted, first_head) = insert_all(pool, -1, values);
    let (n, head) = delete_val(inserted, first_head, 20);
    let r = traverse(n, head);
    var e: Vec<i64> = Vec.new();
    e.push(10);
    e.push(30);
    e.push(40);
    if vecs_equal(r, e) == 1 {
        if is_sorted(n, head) == 1 {
            println("PASS: delete");
            return 1;
        }
    }
    println("FAIL: delete");
    0
}

fn test_invariant_after_many() -> i64 {
    let pool: Vec<i64> = Vec.new();
    // Insert in scrambled order
    let values: Vec<i64> = [70, 20, 90, 10, 50, 80, 30, 60, 40, 100];
    let (n, head) = insert_all(pool, -1, values);
    if is_sorted(n, head) == 1 {
        if list_len(n, head) == 10 {
            println("PASS: invariant after many inserts");
            return 1;
        }
    }
    println("FAIL: invariant after many inserts");
    0
}

fn test_delete_nonexistent() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let values: Vec<i64> = [10, 30];
    let (inserted, first_head) = insert_all(pool, -1, values);
    let (n, head) = delete_val(inserted, first_head, 20);
    if list_len(n, head) == 2 {
        if is_sorted(n, head) == 1 {
            println("PASS: delete nonexistent");
            return 1;
        }
    }
    println("FAIL: delete nonexistent");
    0
}

fn main() {
    println("=== Ordered List Tests ===");
    var passed = 0;
    let total = 6;
    passed = passed + test_sorted_insert();
    passed = passed + test_duplicates();
    passed = passed + test_search();
    passed = passed + test_delete();
    passed = passed + test_invariant_after_many();
    passed = passed + test_delete_nonexistent();
    println("");
    print("Passed: ");
    print(passed);
    println(f"/{total}");
    if passed == total {
        println("OVERALL: PASS");
    } else {
        println("OVERALL: FAIL");
    }
}
