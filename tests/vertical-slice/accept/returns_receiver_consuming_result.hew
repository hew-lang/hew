// A consuming identity method transfers its receiver into a Result. Releasing
// a destructured argument bypasses its destructor; the result closes once.
#[resource]
type Value {
    label: string;
}

#[resource]
type Child {
    text: string;
}

trait ValueMethods {
    #[returns_receiver]
    fn push(consume self, consume child: Child) -> Self;
}

impl ValueMethods for Value {
    #[returns_receiver]
    fn push(consume self, consume child: Child) -> Value {
        println(child.release());
        self
    }
}

impl Value {
    fn close(consume self) {
        println(self.label);
    }
}

impl Child {
    fn close(consume self) {
        println("unexpected child close");
    }

    fn release(consume self) -> string {
        let Child { text } = self;
        text
    }
}

fn try_build() -> Result<Value, string> {
    let value = Value { label: "closed" };
    let child = Child { text: "built" };
    .Ok(value.push(child))
}

fn main() {
    match try_build() {
        .Ok(value) => value.close(),
        .Err(error) => println(error),
    }
}
