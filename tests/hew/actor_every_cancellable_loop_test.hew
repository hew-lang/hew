//! Runtime coverage for cancellable actor work expressed as periodic receive
//! handlers.
//!
//! The worker checks a boolean flag on each `#[every]` tick. The `halt` receive
//! handler is a normal actor message, so it can interleave between ticks because
//! each tick returns control to the mailbox.

import std.testing;

actor Worker {
    var running: bool = true,
    var ticks: i64 = 0,
    var calls: i64 = 0,

    #[every(25ms)]
    receive fn tick() {
        calls += 1;
        if !running {
            return;
        }
        ticks += 1;
    }

    receive fn halt() {
        running = false;
    }

    receive fn total() -> i64 {
        ticks
    }

    receive fn call_count() -> i64 {
        calls
    }
}

fn ticks_of(worker: Worker) -> i64 {
    match worker.total() {
        .Ok(n) => n,
        .Err(_) => panic("total ask failed"),
    }
}

fn calls_of(worker: Worker) -> i64 {
    match worker.call_count() {
        .Ok(n) => n,
        .Err(_) => panic("call count ask failed"),
    }
}

#[test]
fn halt_message_prevents_more_periodic_work() {
    let worker = spawn Worker(running: true, ticks: 0, calls: 0);
    while ticks_of(worker) < 2 {
        sleep(10ms);
    }
    let _ = worker.halt();
    // Ticks after `halt` still run, so wait for two of them and check that
    // neither counted.
    let halted_ticks = ticks_of(worker);
    let halted_calls = calls_of(worker);
    while calls_of(worker) < halted_calls + 2 {
        sleep(10ms);
    }
    testing.assert_eq(ticks_of(worker), halted_ticks);
}
