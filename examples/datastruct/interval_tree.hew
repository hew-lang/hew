// Interval Tree for overlapping interval queries
// Each node: [low, high, max_high, left, right] = 5 slots per node
// BST ordered by low endpoint, max_high tracks max high in subtree
// NIL = -1 means no child
//
// A parameter is the callee's own copy, so every helper that writes into the
// node pool returns it and the caller reassigns. Allocation and insertion also
// report an index, so they return a tuple; queries build their own result.
fn node_low(nodes: Vec<i64>, i: i64) -> i64 {
    nodes[i * 5]
}

fn node_high(nodes: Vec<i64>, i: i64) -> i64 {
    nodes[i * 5 + 1]
}

fn node_max(nodes: Vec<i64>, i: i64) -> i64 {
    nodes[i * 5 + 2]
}

fn node_left(nodes: Vec<i64>, i: i64) -> i64 {
    nodes[i * 5 + 3]
}

fn node_right(nodes: Vec<i64>, i: i64) -> i64 {
    nodes[i * 5 + 4]
}

fn set_max(var nodes: Vec<i64>, i: i64, v: i64) -> Vec<i64> {
    nodes.set(i * 5 + 2, v);
    nodes
}

fn set_left(var nodes: Vec<i64>, i: i64, v: i64) -> Vec<i64> {
    nodes.set(i * 5 + 3, v);
    nodes
}

fn set_right(var nodes: Vec<i64>, i: i64, v: i64) -> Vec<i64> {
    nodes.set(i * 5 + 4, v);
    nodes
}

fn add_node(var nodes: Vec<i64>, low: i64, high: i64, NIL: i64) -> (Vec<i64>, i64) {
    let idx = nodes.len() / 5;
    nodes.push(low);
    nodes.push(high);
    nodes.push(high); // max_high starts as own high
    nodes.push(NIL);
    nodes.push(NIL);
    (nodes, idx)
}

fn max_val(a: i64, b: i64) -> i64 {
    if a > b {
        a
    } else {
        b
    }
}

fn update_max(var nodes: Vec<i64>, i: i64, NIL: i64) -> Vec<i64> {
    var mx = node_high(nodes, i);
    let l = node_left(nodes, i);
    if l != NIL {
        mx = max_val(mx, node_max(nodes, l));
    }
    let r = node_right(nodes, i);
    if r != NIL {
        mx = max_val(mx, node_max(nodes, r));
    }
    set_max(nodes, i, mx)
}

// Insert interval [low, high] into interval tree
fn interval_insert(var nodes: Vec<i64>, root: i64, low: i64, high: i64, NIL: i64) -> (Vec<i64>, i64) {
    if root == NIL {
        return add_node(nodes, low, high, NIL);
    }
    var path: Vec<i64> = Vec.new();
    var dirs: Vec<i64> = Vec.new();
    var cur = root;
    var placed = false;
    while !placed {
        let cur_low = node_low(nodes, cur);
        if low < cur_low {
            let left = node_left(nodes, cur);
            if left == NIL {
                let (grown, new_idx) = add_node(nodes, low, high, NIL);
                nodes = set_left(grown, cur, new_idx);
                path.push(cur);
                dirs.push(0);
                placed = true;
            } else {
                path.push(cur);
                dirs.push(0);
                cur = left;
            }
        } else {
            let right = node_right(nodes, cur);
            if right == NIL {
                let (grown, new_idx) = add_node(nodes, low, high, NIL);
                nodes = set_right(grown, cur, new_idx);
                path.push(cur);
                dirs.push(1);
                placed = true;
            } else {
                path.push(cur);
                dirs.push(1);
                cur = right;
            }
        }
    }
    // Update max_high values along path
    while !path.is_empty() {
        let node = path.pop();
        let _ = dirs.pop();
        nodes = update_max(nodes, node, NIL);
    }
    (nodes, root)
}

// Build a tree from intervals laid out as [low, high, low, high, ...];
// returns the pool and the root.
fn build_intervals(pairs: Vec<i64>, NIL: i64) -> (Vec<i64>, i64) {
    var nodes: Vec<i64> = Vec.new();
    var root = NIL;
    var i = 0;
    while i < pairs.len() {
        let (grown, new_root) = interval_insert(nodes, root, pairs[i], pairs[i + 1], NIL);
        nodes = grown;
        root = new_root;
        i = i + 2;
    }
    (nodes, root)
}

// Query: find all intervals overlapping point p
// An interval [low, high] overlaps point p if low <= p AND p <= high
fn query_point(nodes: Vec<i64>, root: i64, p: i64, NIL: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec.new();
    if root == NIL {
        return result;
    }
    // Use iterative DFS with stack
    var stack: Vec<i64> = Vec.new();
    stack.push(root);
    while !stack.is_empty() {
        let cur = stack.pop();
        let low = node_low(nodes, cur);
        let high = node_high(nodes, cur);
        // Check if current interval overlaps point
        if low <= p {
            if p <= high {
                result.push(cur);
            }
        }
        // Check left subtree if its max_high >= p
        let l = node_left(nodes, cur);
        if l != NIL {
            if node_max(nodes, l) >= p {
                stack.push(l);
            }
        }
        // Check right subtree if low <= p (since BST by low)
        let r = node_right(nodes, cur);
        if r != NIL {
            if node_low(nodes, r) <= p {
                stack.push(r);
            } else {
                // Even if r.low > p, r might have left children with lower low
                // But since BST, all nodes in right subtree have low >= node.low
                // Only check if r.low <= p
            }
        }
    }
    result
}

// Query: find all intervals overlapping range [ql, qh]
// Interval [low, high] overlaps [ql, qh] if low <= qh AND ql <= high
fn query_range(nodes: Vec<i64>, root: i64, ql: i64, qh: i64, NIL: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec.new();
    if root == NIL {
        return result;
    }
    var stack: Vec<i64> = Vec.new();
    stack.push(root);
    while !stack.is_empty() {
        let cur = stack.pop();
        let low = node_low(nodes, cur);
        let high = node_high(nodes, cur);
        // Check overlap: low <= qh AND ql <= high
        if low <= qh {
            if ql <= high {
                result.push(cur);
            }
        }
        let l = node_left(nodes, cur);
        if l != NIL {
            if node_max(nodes, l) >= ql {
                stack.push(l);
            }
        }
        let r = node_right(nodes, cur);
        if r != NIL {
            if node_low(nodes, r) <= qh {
                stack.push(r);
            }
        }
    }
    result
}

fn test_basic_overlap() -> i64 {
    let NIL = 0 - 1;
    // Insert intervals: [1,5], [3,8], [10,15], [6,7]
    let (nodes, root) = build_intervals([1, 5, 3, 8, 10, 15, 6, 7], NIL);
    // Query point 4: overlaps [1,5] and [3,8]
    let result = query_point(nodes, root, 4, NIL);
    if result.len() == 2 {
        println("PASS: basic point overlap query");
        1
    } else {
        print("FAIL: expected 2 overlaps got ");
        println(result.len());
        0
    }
}

fn test_no_overlap() -> i64 {
    let NIL = 0 - 1;
    let (nodes, root) = build_intervals([1, 3, 5, 7, 9, 11], NIL);
    // Query point 4: no overlap
    let result = query_point(nodes, root, 4, NIL);
    if result.is_empty() {
        println("PASS: no overlap query");
        1
    } else {
        print("FAIL: expected 0 overlaps got ");
        println(result.len());
        0
    }
}

fn test_all_overlap() -> i64 {
    let NIL = 0 - 1;
    let (nodes, root) = build_intervals([1, 10, 2, 8, 3, 12], NIL);
    // Query point 5: all three overlap
    let result = query_point(nodes, root, 5, NIL);
    if result.len() == 3 {
        println("PASS: all intervals overlap");
        1
    } else {
        print("FAIL: expected 3 overlaps got ");
        println(result.len());
        0
    }
}

fn test_boundary_overlap() -> i64 {
    let NIL = 0 - 1;
    let (nodes, root) = build_intervals([1, 5, 5, 10], NIL);
    // Query point 5: both [1,5] and [5,10] overlap
    let result = query_point(nodes, root, 5, NIL);
    if result.len() == 2 {
        println("PASS: boundary overlap");
        1
    } else {
        print("FAIL: boundary expected 2 got ");
        println(result.len());
        0
    }
}

fn test_range_query() -> i64 {
    let NIL = 0 - 1;
    let (nodes, root) = build_intervals([1, 3, 5, 8, 10, 15, 12, 20], NIL);
    // Range query [6, 11]: overlaps [5,8] and [10,15]
    let result = query_range(nodes, root, 6, 11, NIL);
    if result.len() == 2 {
        println("PASS: range overlap query");
        1
    } else {
        print("FAIL: range expected 2 got ");
        println(result.len());
        0
    }
}

fn main() {
    println("=== Interval Tree ===");
    var passed = 0;
    let total = 5;
    passed = passed + test_basic_overlap();
    passed = passed + test_no_overlap();
    passed = passed + test_all_overlap();
    passed = passed + test_boundary_overlap();
    passed = passed + test_range_query();
    println("");
    print(passed);
    print("/");
    print(total);
    println(" tests passed");
    if passed == total {
        println("PASS");
    } else {
        println("FAIL");
    }
}
