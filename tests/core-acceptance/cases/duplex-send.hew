// A lambda actor's `.send(msg)` and direct call both deliver through one
// completion path. `stop(handle); stopped(handle);` drains and releases it.
fn main() {
    let doubler = actor |x: i64| {
        println(x * 2);
    };
    match doubler.send(21) {
        .Ok(_) => println("sent"),
        .Err(_) => panic("rejected"),
    }
    match doubler(4) {
        .Ok(_) => println("called"),
        .Err(_) => panic("rejected"),
    }
    {
        let __hew_migrated_actor_527 = doubler;
        stop(__hew_migrated_actor_527);
        stopped(__hew_migrated_actor_527);
    };

    // An owned message crosses the boundary: the handler receives the string
    // the caller built and the caller keeps nothing to release.
    let greeter = actor |name: string| {
        println(f"hello {name}");
    };
    match greeter.send(f"world-{1}") {
        .Ok(_) => {}
        .Err(_) => panic("rejected"),
    }
    {
        let __hew_migrated_actor_878 = greeter;
        stop(__hew_migrated_actor_878);
        stopped(__hew_migrated_actor_878);
    };

    // A reply-shaped lambda answers its caller.
    let square = actor |x: i64| -> i64 {
        x * x
    };
    match square.send(6) {
        .Ok(value) => println(f"square {value}"),
        .Err(_) => panic("rejected"),
    }
    {
        let __hew_migrated_actor_1132 = square;
        stop(__hew_migrated_actor_1132);
        stopped(__hew_migrated_actor_1132);
    };
    println("done");
}
