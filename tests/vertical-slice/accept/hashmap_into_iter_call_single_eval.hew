// A side-effectful map receiver is evaluated exactly once.

import std.iter;

fn make_map() -> HashMap<i64, i64> {
    println("MK");
    var m: HashMap<i64, i64> = HashMap.new();
    m.insert(1, 10);
    m.insert(2, 20);
    m.insert(3, 30);
    m
}

pub fn main() -> i64 {
    iter.count(make_map().into_iter())
}
