// Send a string through a pipe from main. A plain call waits for capacity;
// main is a resumable caller too. This example fits within the pipe capacity.

import std.stream;

fn main() {
    let (sink, input) = match stream.pipe(2) {
        .Ok(pair) => pair,
        .Err(error) => panic(error),
    };
    sink.send("hi");
    sink.close();
    input.close();
}
