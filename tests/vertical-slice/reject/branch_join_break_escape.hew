// A break leaves the loop, so consuming an affine value in that arm must
// reach the join below the loop. A continue instead rejoins at the loop head:
// both another iteration and the code after the loop can observe the move.
#[resource]
type Conn {
    fd: i64;
}

impl Conn {
    fn close(consume self) {}
    fn detach(consume self) -> i64 {
        self.fd
    }
}

fn break_escape(n: i64) -> i64 {
    let held = Conn { fd: 1 };
    for i in 0..3 {
        if i == n {
            let _ = held.detach();
            break;
        }
    }
    held.detach()
}

fn continue_escape(n: i64) -> i64 {
    let held = Conn { fd: 2 };
    for i in 0..3 {
        if i == n {
            let _ = held.detach();
            continue;
        }
    }
    held.detach()
}

fn main() {
    let _ = break_escape(1);
    let _ = continue_escape(1);
}
