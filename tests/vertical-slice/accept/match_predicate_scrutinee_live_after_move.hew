//! Accept: the scrutinee of a literal-predicate record match stays live.
//!
//! The chain matches a copy of `value`, so the arm's extraction leaves the
//! original binding intact for a later read.
//!
//! Observable contract: prints the selected arm's result and then `value.b`.

type Pair { tag: i64, a: string, b: string }

fn main() -> i64 {
    let value = Pair { tag: 0, a: "a" + "x", b: "b" + "y" };
    let result = match value {
        Pair { tag: 0, a, b: _ } => a.len(),
        Pair { tag: _, a: _, b: _ } => 2,
    };
    println(result);
    println(value.b);
    0
}
