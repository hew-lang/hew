// A HashSet<string> field produces an owned snapshot through IntoIterator.
// The VecIter cursor owns the snapshot and each yielded string is dropped at
// iteration-scope exit. Elements "aa", "bbb", "cccc" have total length 9.
type SetBox {
    s: HashSet<string>;
}

fn make_set_box() -> SetBox {
    var s: HashSet<string> = HashSet.new();
    s.insert("aa");
    s.insert("bbb");
    s.insert("cccc");
    SetBox { s: s }
}

pub fn main() -> i64 {
    let b = make_set_box();
    var total_len = 0;
    var count = 0;
    for x in b.s {
        total_len = total_len + x.len();
        count = count + 1;
    }
    if count != 3 {
        return 100 + count;
    }
    total_len
}
