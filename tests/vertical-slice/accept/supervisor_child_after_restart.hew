// Regression guard: supervisor child access after restart (issue #382 Bug 2).
//
// Before the fix: hew_supervisor_child_get (supervisor.rs) returned a raw
// null pointer when the child slot was Transient (mid-restart) or Dead.
// Downstream code that dereferenced the null handle caused SIGSEGV.
//
// After the fix: the supervisor child lookup reads the ChildLookupResult.tag
// field; tag != 0 branches to hew_trap_with_code(206) + llvm.trap instead of
// yielding a null handle. Tag == 0 (Live) yields the actor handle safely.
//
// The barrier is `await_restart`, the cooperative restart wait: it suspends
// until the named static child's slot is Live again. This fixture discards the
// handle the barrier re-fetches and reads `sup.w1` a second time, so what it
// proves is the slot-table lookup after a restart, not the barrier's own
// re-fetch (supervisor_await_restart.hew covers that).
//
//   1. Supervisor spawns Worker(value: 7); sup.w1 is Live immediately.
//   2. w.crash_me() panics inside the actor; the supervisor processes the
//      crash notification and restarts the child (first crash:
//      restart_delay_ms starts at 0, so the restart is immediate).
//   3. `await_restart sup.w1` parks until the restart cycle completes.
//   4. A fresh `sup.w1` returns a Live handle — tag == 0 is guaranteed by
//      step 3. If the child were still Transient, hew_trap_with_code(206)
//      would fire and the process would exit 133 (SIGTRAP).
//   5. await w2.get_value() returns 7: the child spec's init state carries
//      the original value = 7 through the deep-clone restart path.
//
// No sleep_ms is used; the ordering comes from the restart barrier.
//
// Exit code 7 proves:
//   - await_restart resumed after one completed restart cycle.
//   - a fresh sup.w1 lookup returned Live (not Transient).
//   - The restarted actor's state was deep-cloned correctly.
actor Worker {
    var value: i64,
    receive fn get_value() -> i64 {
        value
    }
    receive fn crash_me() {
        panic("test crash — supervisor should restart this child");
    }
}

supervisor App {
    strategy: one_for_one,
    intensity: 3 within 60s,

    child w1: Worker(value: 7),
}

fn main() -> i64 {
    let sup = spawn App;
    let w = sup.w1;
    // Confirm initial value before crash (proves init_state was applied).
    match w.get_value() {
        .Err(_) => {
            return 0;
        },
        .Ok(v) => {
            if v != 7 {
                return 0;
            }
        },
    }
    // Crash the worker (fire-and-forget tell).
    let _ = w.crash_me();
    // Suspend until the supervisor completes the restart cycle. The re-fetched
    // handle is discarded on purpose: the next line re-reads the slot.
    let _ = await_restart sup.w1;
    // Access the restarted child via the supervisor — tag must be 0 (Live).
    // A Transient result would emit hew_trap_with_code(206) and SIGTRAP.
    let w2 = sup.w1;
    // Restarted child has the original init value from its child spec.
    match w2.get_value() {
        .Ok(v) => v,
        .Err(_) => 0,
    }
}
