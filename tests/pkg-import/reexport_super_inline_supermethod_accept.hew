// A re-exported supertrait edge resolves to the separately implemented origin.
import hew.reexsub.{Sub};

import hew.reexbase.{Base};

type W {
    id: i64;
}

impl Base for W {
    fn base(self) -> i64 {
        self.id
    }
}

impl Sub for W {
    fn tag(self) -> i64 {
        self.id + 100
    }
}

fn main() {
    let w = W { id: 5 };
    println(f"tag {w.tag()} base {w.base()}");
}
