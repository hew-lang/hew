// Regression guard for select's channel-receive arm: a `select`
// channel-receive arm (`pat from rx.recv()`) is valid and must keep
// checking OK independently of batch fork's actor-ask-only branch
// enforcement.
import std.channel.channel;

actor Worker {
    #[on(start)]
    fn start() {
        let (txa, rxa): (channel.Sender<i64>, channel.Receiver<i64>) = match channel.new(4) {
            .Ok(pair) => pair,
            .Err(_) => return,
        };
        txa.send(7);
        select {
            a from rxa.recv() => {
                match a {
                    .Some(n) => println(f"a:{n}"),
                    .None => println("a:none"),
                }
            },
            after 1s => println("timeout"),
        };
        txa.close();
        rxa.close();
    }
}

fn main() {
    let _w = spawn Worker;
    sleep(50ms);
}
