// Acceptance fixture for batch-fork error propagation:
//   if any branch's actor handler traps, the crash surfaces deterministically
//   and the fork-await site's result tuple is never usefully bound.
//
// Design intent:
//   - Good.compute(x) returns x * 2 (would yield 20).
//   - Bad.compute(x) traps: `assert_eq(x, x + 1)` is always false, so the
//     handler aborts. Unlike the retired `join { }` form (which propagated
//     the trap as a caller-side SIGABRT), batch fork surfaces the trapped
//     actor's crash through the ordinary actor-crash path and the process
//     exits with a fixed non-abort status — `ra + rb` below is unreachable.
//
// Exit-code contract: the trapped actor crash exits the process with status
// 19, proving the trap is NOT swallowed and no bogus tuple is produced.
//
// Flake contract: deterministic — Bad always traps regardless of which
// branch's reply lands first, so the propagation is independent of
// scheduling.
actor Good {
    receive fn compute(x: i64) -> i64 {
        x * 2
    }
}

actor Bad {
    receive fn compute(x: i64) -> i64 {
        assert_eq(x, x + 1);
        x
    }
}

fn main() -> i64 {
    let g = spawn Good;
    let b = spawn Bad;
    let (ra_result, rb_result) = await fork (g.compute(10), b.compute(5));
    let ra = match ra_result {
        .Ok(value) => value,
        .Err(_) => -1,
    };
    let rb = match rb_result {
        .Ok(value) => value,
        .Err(_) => -1,
    };
    ra + rb
}
