import std.encoding.cbor;

#[wire]
type Packet {
    label: string @1;
    seq: i64 @2;
}

fn mk(n: i64) -> bytes {
    let p = Packet { label: "payload-label-value", seq: n };
    cbor.encode(p)
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        let back = cbor.decode<Packet>(mk(i)).expect("decode");
        total = total + back.seq;
        i = i + 1;
    }
    total
}
