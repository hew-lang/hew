// Accept: two-type-parameter generic enum Outcome<T, E> — end-to-end lowering.
// Outcome::Ok(7) must lower through HIR EnumLayoutRegistry → MIR → codegen
// and exit 7.
enum Outcome<T, E> {
    Ok(T),
    Err(E),
}

fn main() -> i64 {
    let x: Outcome<i64, bool> = Outcome.Ok(7);
    match x {
        Outcome.Ok(v) => v,
        Outcome.Err(e) => 0,
    }
}
