// Library module for file_import_trait_default_local_type.hew.
//
// `Badge` and `badge_tag` are declared HERE, beside the trait. The default
// body below constructs a Badge, reads its field through a free function,
// and dispatches back through the required method — so the materialised
// copy of this body must name-resolve trait-file-local declarations even
// though it is lowered at an impl site in the importing file.
type Badge {
    code: i64,
    tag: string,
}

fn badge_tag(b: Badge) -> string {
    b.tag
}

trait Describe {
    fn ident(self) -> string;

    fn describe(self) -> string {
        let b = Badge { code: 7, tag: self.ident() };
        badge_tag(b) + ":7"
    }
}
