// Acceptance fixture for select{} with actor-ask arms.
//
// Design intent:
//   - FastWorker.compute() returns immediately; it is the only arm that can
//     complete during the select.
//   - SlowWorker.compute() waits on a gate main opens after the select; its
//     reply always loses.
//
// Exit-code contract: main returns the winning value (42). POSIX exit is 8-bit,
// so the value must be in 0..=255. 42 is the canonical fixture value.
//
// Cancel-loser proof: the compiler lowers the loser path through
// hew_reply_channel_cancel + hew_reply_channel_free (see Terminator::Select
// codegen in hew-codegen-rs/src/llvm.rs). This fixture exercises that path
// every run: SlowWorker is always the loser and its channel is cancelled.
import std.stream;

actor FastWorker {
    receive fn compute(query: i64) -> i64 {

        // Reply immediately. This arm always wins the select{}.
        query
    }
}

actor SlowWorker {
    var gate: stream.Stream<i64>,

    receive fn compute(query: i64) -> i64 {
        // Wait on a gate main opens only after the select, so FastWorker
        // replies first.
        gate.recv();
        query
    }

    receive fn ping() {}
}

fn main() -> i64 {
    let fast = spawn FastWorker;
    let (release, gate) = stream.pipe(1).expect("gate");
    let slow = spawn SlowWorker(gate: gate);
    // Ask both workers the same query. Select picks the first reply.
    let winner = select {
        reply from fast.compute(42) => reply.expect("ask reply"),
        reply from slow.compute(99) => reply.expect("ask reply"),
    };
    // The losing reply lands on its abandoned channel before exit.
    release.send(1).expect("release");
    slow.ping().expect("ping");
    // Return the winning value as the process exit code.
    // FastWorker wins and returns 42; exit code == 42.
    winner
}
