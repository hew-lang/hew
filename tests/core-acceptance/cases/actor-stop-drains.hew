// stop(worker) returns at once. The first accepted turn waits on a gate that
// main opens only after observing the return and the refusal, so accepted jobs
// always run after main's lines and in order before the stop hook.
import std.stream;

actor Worker {
    receive fn hold(gate: stream.Stream<i64>) {
        let _ = gate.recv();
    }

    receive fn job(n: i64) {
        println(n);
    }

    #[on(stop)]
    fn done() {
        var total = 0;
        for _ in 0..10000 {
            total += 1;
        }
        assert(total == 10000);
        println("hook");
    }
}

#[resource]
type TerminalLease {
}

impl TerminalLease {
    fn close(consume self) {
        var total = 0;
        for _ in 0..10000 {
            total += 1;
        }
        assert(total == 10000);
        sleep(1ms);
        println("terminal state released");
    }
}

actor ComputingStop {
    let ready: stream.Sink<i64>;
    var lease: TerminalLease = TerminalLease {  };

    #[on(stop)]
    fn done() {
        defer {
            println("computing hook drained");
        }
        ready.send(1).expect("terminal hook entered");
        loop {}
    }
}

fn main() {
    let worker = spawn Worker;
    let (open, gate): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("gate");
    let _ = mailbox(worker).hold(gate);
    let _ = mailbox(worker).job(1);
    let _ = mailbox(worker).job(2);
    let _ = mailbox(worker).job(3);
    stop(worker);
    println("after stop");
    match mailbox(worker).job(4) {
        .Err(failure) => match failure.reason {
            .Dead => println("dead"),
            _ => panic("wrong refusal"),
        }
        .Ok(_) => panic("accepted after stop"),
    }
    open.send(1).expect("open the gate");
    open.close();
    stopped(worker);
    println("after stopped");
    let (tx, rx): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("terminal gate");
    let computing = spawn ComputingStop { ready: tx };
    stop(computing);
    rx.recv().expect("computing stop hook entered");
    terminate(computing);
    stopped(computing);
    rx.close();
    println("forced hook stopped");
}
