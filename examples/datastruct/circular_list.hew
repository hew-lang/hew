// Circular Singly Linked List using Vec<i64> with index-based pointers
// Node layout: nodes[i*2] = value, nodes[i*2+1] = next
// Last node's next points back to head
//
// A parameter is the callee's own copy, so every helper that writes into the
// node pool returns it and the caller reassigns. Helpers that also report a
// head or a new node index return a tuple.
fn node_val(n: Vec<i64>, i: i64) -> i64 {
    n[i * 2]
}

fn node_next(n: Vec<i64>, i: i64) -> i64 {
    n[i * 2 + 1]
}

fn set_next(var n: Vec<i64>, i: i64, nx: i64) -> Vec<i64> {
    n.set(i * 2 + 1, nx);
    n
}

fn alloc_node(var n: Vec<i64>, val: i64) -> (Vec<i64>, i64) {
    let idx = n.len() / 2;
    n.push(val);
    n.push(idx);
    (n, idx)
}

// Insert at tail (value appears at end of traversal); returns pool and head.
fn insert_tail(var n: Vec<i64>, head: i64, val: i64) -> (Vec<i64>, i64) {
    let (grown, nd) = alloc_node(n, val);
    n = grown;
    if head == -1 {
        n = set_next(n, nd, nd);
        return (n, nd);
    }
    var tail = head;
    while node_next(n, tail) != head {
        tail = node_next(n, tail);
    }
    n = set_next(n, tail, nd);
    n = set_next(n, nd, head);
    (n, head)
}

// Delete first occurrence; returns pool and the new head.
fn delete_val(var n: Vec<i64>, head: i64, val: i64) -> (Vec<i64>, i64) {
    if head == -1 {
        return (n, -1);
    }
    // Single element
    if node_next(n, head) == head {
        if node_val(n, head) == val {
            return (n, -1);
        }
        return (n, head);
    }
    // Find tail
    var tail = head;
    while node_next(n, tail) != head {
        tail = node_next(n, tail);
    }
    // Delete head?
    if node_val(n, head) == val {
        let new_head = node_next(n, head);
        n = set_next(n, tail, new_head);
        return (n, new_head);
    }
    // Delete non-head
    var prev = head;
    var curr = node_next(n, head);
    while curr != head {
        if node_val(n, curr) == val {
            n = set_next(n, prev, node_next(n, curr));
            return (n, head);
        }
        prev = curr;
        curr = node_next(n, curr);
    }
    (n, head)
}

// Traverse circular list, collect values (one full loop)
fn traverse(n: Vec<i64>, head: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec.new();
    if head == -1 {
        return result;
    }
    result.push(node_val(n, head));
    var curr = node_next(n, head);
    while curr != head {
        result.push(node_val(n, curr));
        curr = node_next(n, curr);
    }
    result
}

// Count elements
fn list_len(n: Vec<i64>, head: i64) -> i64 {
    if head == -1 {
        return 0;
    }
    var count = 1;
    var curr = node_next(n, head);
    while curr != head {
        count = count + 1;
        curr = node_next(n, curr);
    }
    count
}

fn vecs_equal(a: Vec<i64>, b: Vec<i64>) -> i64 {
    if a.len() != b.len() {
        return 0;
    }
    for i in 0 .. a.len() {
        if a[i] != b[i] {
            return 0;
        }
    }
    1
}

// Build a circular list holding vals in order; returns the pool and the head.
fn build_list(vals: Vec<i64>) -> (Vec<i64>, i64) {
    var n: Vec<i64> = Vec.new();
    var head = -1;
    for val in vals {
        let (grown, new_head) = insert_tail(n, head, val);
        n = grown;
        head = new_head;
    }
    (n, head)
}

// --- Tests ---
fn test_insert_and_traverse() -> i64 {
    let (n, head) = build_list([10, 20, 30]);
    let r = traverse(n, head);
    let e: Vec<i64> = [10, 20, 30];
    if vecs_equal(r, e) == 1 {
        println("PASS: insert and traverse");
        return 1;
    }
    println("FAIL: insert and traverse");
    0
}

fn test_circular_property() -> i64 {
    let (n, head) = build_list([1, 2, 3]);
    // Walk 2 full cycles and check we see values repeated
    var curr = head;
    var sum = 0;
    for count in 0 .. 6 {
        sum = sum + node_val(n, curr);
        curr = node_next(n, curr);
    }
    // 2 cycles of 1+2+3=6, so sum=12
    if sum == 12 {
        if curr == head {
            println("PASS: circular property");
            return 1;
        }
    }
    println("FAIL: circular property");
    0
}

fn test_delete_middle() -> i64 {
    let (built, built_head) = build_list([10, 20, 30]);
    let (n, head) = delete_val(built, built_head, 20);
    let r = traverse(n, head);
    let e: Vec<i64> = [10, 30];
    if vecs_equal(r, e) == 1 {
        println("PASS: delete middle");
        return 1;
    }
    println("FAIL: delete middle");
    0
}

fn test_delete_head() -> i64 {
    let (built, built_head) = build_list([10, 20, 30]);
    let (n, head) = delete_val(built, built_head, 10);
    let r = traverse(n, head);
    let e: Vec<i64> = [20, 30];
    if vecs_equal(r, e) == 1 {
        // Verify still circular
        if node_next(n, node_next(n, head)) == head {
            println("PASS: delete head");
            return 1;
        }
    }
    println("FAIL: delete head");
    0
}

fn test_single_element() -> i64 {
    let (n, head) = build_list([42]);
    if list_len(n, head) == 1 {
        if node_next(n, head) == head {
            let (_emptied, new_head) = delete_val(n, head, 42);
            if new_head == -1 {
                println("PASS: single element");
                return 1;
            }
        }
    }
    println("FAIL: single element");
    0
}

fn test_length() -> i64 {
    let empty: Vec<i64> = Vec.new();
    if list_len(empty, -1) != 0 {
        println("FAIL: length");
        return 0;
    }
    let (n, head) = build_list([1, 2, 3, 4]);
    if list_len(n, head) == 4 {
        println("PASS: length");
        return 1;
    }
    println("FAIL: length");
    0
}

fn main() {
    println("=== Circular List Tests ===");
    var passed = 0;
    let total = 6;
    passed = passed + test_insert_and_traverse();
    passed = passed + test_circular_property();
    passed = passed + test_delete_middle();
    passed = passed + test_delete_head();
    passed = passed + test_single_element();
    passed = passed + test_length();
    println("");
    print("Passed: ");
    print(passed);
    println(f"/{total}");
    if passed == total {
        println("OVERALL: PASS");
    } else {
        println("OVERALL: FAIL");
    }
}
