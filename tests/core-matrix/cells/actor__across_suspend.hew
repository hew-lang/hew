actor Echo {
    var seen: i64;

    receive fn take(v: i64) -> i64 {
        seen = seen + v;
        seen
    }
}

actor Holder {
    var ready: bool;

    receive fn hold(v: LocalPid<Echo>) -> i64 {
        sleep(2ms);
        match await v.take(1) { Ok(v_v) => println(f"echo {v_v}"), Err(_) => println("err"), }
        ready = true;
        1
    }
}

fn main() {
    let x = spawn Echo(seen: 0);
    let h = spawn Holder(ready: false);
    match await h.hold(x) {
        Ok(n) => println(f"held {n}"),
        Err(_) => println("err"),
    }
}
