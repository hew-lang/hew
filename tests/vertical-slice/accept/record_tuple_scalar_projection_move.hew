type TupleScalarMoveCarrier {
    pair: (string, i64),
    sibling: string,
}

fn project(i: i64) -> i64 {
    let r = TupleScalarMoveCarrier {
        pair: (string_concat("tuple-", "owner"), i),
        sibling: string_concat("sibling-", "owner"),
    };
    let moved = r.pair.1;
    moved
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 64 {
        total = total + project(i);
        i = i + 1;
    }
    if total == 2016 { 0 } else { 1 }
}
