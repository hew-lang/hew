import std.failure;

import std.link_monitor;

fn info(value: failure.CrashInfo) -> failure.CrashKind {
    println(value.message);
    value.kind
}

fn note(value: link_monitor.DownNotification) -> u64 {
    value.monitor.value
}

fn main() {
    assert(info(failure.CrashInfo { kind: .HandlerFailed, message: "hello".to_upper() }) == failure.CrashKind.HandlerFailed);
    let value = link_monitor.DownNotification { monitor: link_monitor.MonitorId { value: 7 }, target: .Local(4), reason: .Crashed(failure.CrashKind.Fault) };
    assert(note(value) == 7);
}
