// Sparse Array using sorted linked list of (index, value) pairs
// Node layout: [idx, value, next] = 3 slots per node
// Sorted by idx for efficient traversal
//
// A parameter is the callee's own copy, so every helper that writes the node
// pool returns it and the caller reassigns. Helpers that also move the head
// return a tuple.
fn node_idx(n: Vec<i64>, i: i64) -> i64 {
    n[i * 3]
}

fn node_val(n: Vec<i64>, i: i64) -> i64 {
    n[i * 3 + 1]
}

fn node_next(n: Vec<i64>, i: i64) -> i64 {
    n[i * 3 + 2]
}

fn set_val(var n: Vec<i64>, i: i64, v: i64) -> Vec<i64> {
    n.set(i * 3 + 1, v);
    n
}

fn set_next(var n: Vec<i64>, i: i64, nx: i64) -> Vec<i64> {
    n.set(i * 3 + 2, nx);
    n
}

fn alloc_node(var n: Vec<i64>, idx: i64, val: i64) -> (Vec<i64>, i64) {
    let node = n.len() / 3;
    n.push(idx);
    n.push(val);
    n.push(-1);
    (n, node)
}

// Set value at sparse index. Insert or update. Returns the pool and the head.
fn sparse_set(var n: Vec<i64>, head: i64, idx: i64, val: i64) -> (Vec<i64>, i64) {
    if head == -1 {
        return alloc_node(n, idx, val);
    }
    // Update if idx matches head
    if node_idx(n, head) == idx {
        n = set_val(n, head, val);
        return (n, head);
    }
    // Insert before head
    if idx < node_idx(n, head) {
        let (grown, nd) = alloc_node(n, idx, val);
        n = set_next(grown, nd, head);
        return (n, nd);
    }
    // Walk to find position
    var prev = head;
    var curr = node_next(n, head);
    var done = 0;
    while curr != -1 {
        if done == 0 {
            if node_idx(n, curr) == idx {
                n = set_val(n, curr, val);
                done = 1;
            } else {
                if idx < node_idx(n, curr) {
                    let (grown, nd) = alloc_node(n, idx, val);
                    n = set_next(grown, prev, nd);
                    n = set_next(n, nd, curr);
                    done = 1;
                }
            }
        }
        if done == 0 {
            prev = curr;
            curr = node_next(n, curr);
        } else {
            curr = -1;
        }
    }
    if done == 0 {
        let (grown, nd) = alloc_node(n, idx, val);
        n = set_next(grown, prev, nd);
    }
    (n, head)
}

// Apply every (idx, value) pair in order; pairs holds idx, value at i*2, i*2+1.
fn sparse_set_all(var n: Vec<i64>, head: i64, pairs: Vec<i64>) -> (Vec<i64>, i64) {
    var curr_head = head;
    let count = pairs.len() / 2;
    for i in 0 .. count {
        let (grown, new_head) = sparse_set(n, curr_head, pairs[i * 2], pairs[i * 2 + 1]);
        n = grown;
        curr_head = new_head;
    }
    (n, curr_head)
}

// Get value at sparse index. Returns default_val if not present.
fn sparse_get(n: Vec<i64>, head: i64, idx: i64, default_val: i64) -> i64 {
    var curr = head;
    while curr != -1 {
        if node_idx(n, curr) == idx {
            return node_val(n, curr);
        }
        if node_idx(n, curr) > idx {
            return default_val;
        }
        curr = node_next(n, curr);
    }
    default_val
}

// Collect (idx, val) pairs into result vec as [idx0, val0, idx1, val1, ...]
fn iterate(n: Vec<i64>, head: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec.new();
    var curr = head;
    while curr != -1 {
        result.push(node_idx(n, curr));
        result.push(node_val(n, curr));
        curr = node_next(n, curr);
    }
    result
}

// Count stored elements
fn sparse_len(n: Vec<i64>, head: i64) -> i64 {
    var c = 0;
    var curr = head;
    while curr != -1 {
        c = c + 1;
        curr = node_next(n, curr);
    }
    c
}

fn vecs_equal(a: Vec<i64>, b: Vec<i64>) -> i64 {
    if a.len() != b.len() {
        return 0;
    }
    for i in 0 .. a.len() {
        if a[i] != b[i] {
            return 0;
        }
    }
    1
}

// --- Tests ---
fn test_set_and_get() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let pairs: Vec<i64> = [100, 10, 500, 50, 1000, 99];
    let (n, head) = sparse_set_all(pool, -1, pairs);
    let v1 = sparse_get(n, head, 100, 0);
    let v2 = sparse_get(n, head, 500, 0);
    let v3 = sparse_get(n, head, 1000, 0);
    if v1 == 10 {
        if v2 == 50 {
            if v3 == 99 {
                println("PASS: set and get");
                return 1;
            }
        }
    }
    println("FAIL: set and get");
    0
}

fn test_get_missing() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let (n, head) = sparse_set(pool, -1, 10, 100);
    let v = sparse_get(n, head, 5, -999);
    if v == -999 {
        println("PASS: get missing");
        return 1;
    }
    println("FAIL: get missing");
    0
}

fn test_update() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let pairs: Vec<i64> = [42, 100, 42, 200];
    let (n, head) = sparse_set_all(pool, -1, pairs);
    let v = sparse_get(n, head, 42, 0);
    if v == 200 {
        if sparse_len(n, head) == 1 {
            println("PASS: update");
            return 1;
        }
    }
    println("FAIL: update");
    0
}

fn test_sorted_order() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let pairs: Vec<i64> = [1000, 1, 10, 2, 500, 3, 50, 4];
    let (n, head) = sparse_set_all(pool, -1, pairs);
    let r = iterate(n, head);
    var e: Vec<i64> = Vec.new();
    e.push(10);
    e.push(2);
    e.push(50);
    e.push(4);
    e.push(500);
    e.push(3);
    e.push(1000);
    e.push(1);
    if vecs_equal(r, e) == 1 {
        println("PASS: sorted order");
        return 1;
    }
    println("FAIL: sorted order");
    0
}

fn test_sparse_pattern() -> i64 {
    let pool: Vec<i64> = Vec.new();
    // Only store at indices 0, 100, 10000
    let pairs: Vec<i64> = [0, 1, 100, 2, 10000, 3];
    let (n, head) = sparse_set_all(pool, -1, pairs);
    // Accessing gaps should return default
    let g1 = sparse_get(n, head, 1, 0);
    let g2 = sparse_get(n, head, 50, 0);
    let g3 = sparse_get(n, head, 5000, 0);
    if g1 == 0 {
        if g2 == 0 {
            if g3 == 0 {
                if sparse_len(n, head) == 3 {
                    println("PASS: sparse pattern");
                    return 1;
                }
            }
        }
    }
    println("FAIL: sparse pattern");
    0
}

fn test_iterate() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let pairs: Vec<i64> = [5, 50, 2, 20, 8, 80];
    let (n, head) = sparse_set_all(pool, -1, pairs);
    let r = iterate(n, head);
    // Should be sorted by index: (2,20), (5,50), (8,80)
    if r.len() == 6 {
        if r[0] == 2 {
            if r[2] == 5 {
                if r[4] == 8 {
                    println("PASS: iterate");
                    return 1;
                }
            }
        }
    }
    println("FAIL: iterate");
    0
}

fn main() {
    println("=== Sparse List Tests ===");
    var passed = 0;
    let total = 6;
    passed = passed + test_set_and_get();
    passed = passed + test_get_missing();
    passed = passed + test_update();
    passed = passed + test_sorted_order();
    passed = passed + test_sparse_pattern();
    passed = passed + test_iterate();
    println("");
    print("Passed: ");
    print(passed);
    println(f"/{total}");
    if passed == total {
        println("OVERALL: PASS");
    } else {
        println("OVERALL: FAIL");
    }
}
