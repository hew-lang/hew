actor Echo {
    var seen: i64;

    receive fn take(v: i64) -> i64 {
        seen = seen + v;
        seen
    }
}

actor TestSink {
    var hits: i64;

    receive fn take(v: LocalPid<Echo>) -> i64 {
        match await v.take(1) {
            .Ok(v_v) => println(f"echo {v_v}"),
            .Err(_) => println("err"),
        }
        hits = hits + 1;
        hits
    }
}

fn main() {
    let x = spawn Echo(seen: 0);
    let s = spawn TestSink(hits: 0);
    match await s.take(x) {
        .Ok(n) => println(f"hits {n}"),
        .Err(_) => println("err"),
    }
}
