//! Status: runnable (local actor path; distributed Node API is native-only)
//! Description: Distributed chat service — idiomatic Hew networked actors

// Distributed chat service — idiomatic Hew networked actors
//
// This runnable path keeps the actor and client on one native process. The
// receive handlers marked #[wire] can also be offered to an authenticated peer
// with net.PeerSession.export; the recipient obtains an ordinary ChatRoom via
// receive_service<ChatRoom>(). A registry lookup supplies only Location
// metadata and does not grant permission to call the actor.
actor ChatRoom {
    var users: Vec<string>;
    var messages: Vec<string>;
    #[wire]
    receive fn enter(username: string) {
        users.push(username);
        println(f"[room] {username} entered ({users.len()} online)");
    }
    #[wire]
    receive fn say(username: string, text: string) {
        let msg = f"{username}: {text}";
        messages.push(msg);
        println(f"[room] {msg}");
    }
    #[wire]
    receive fn exit_room(username: string) {
        println(f"[room] {username} left");
    }
    #[wire]
    receive fn history() -> i64 {
        let total = messages.len();
        println(f"[room] {total} messages total");
        for msg in messages {
            println(f"  {msg}");
        }
        total
    }
}

fn main() {
    // ── Server side ──────────────────────────────────────────
    // Node.start("0.0.0.0:9000");
    let empty_users: Vec<string> = Vec.new();
    let empty_msgs: Vec<string> = Vec.new();
    let room = spawn ChatRoom { users: empty_users, messages: empty_msgs };
    // ── Client side (same process for now) ───────────────────
    // In a distributed setup, the server exports `room` through its
    // authenticated PeerSession and the client calls the imported ChatRoom
    // using these same receive methods.

    // These are ordinary completion calls on the local actor. Imported
    // ChatRoom handles use the same method names and Result behaviour.
    let _ = room.enter("alice");
    let _ = room.enter("bob");
    let _ = room.say("alice", "hello everyone!");
    let _ = room.say("bob", "hey alice!");
    let _ = room.say("alice", "how is the weather?");
    let _ = room.exit_room("bob");
    match room.history() {
        .Ok(_) => {}
        .Err(_) => panic("chat history request failed"),
    }
    // Node.shutdown();
    println("[main] chat demo complete");
}
