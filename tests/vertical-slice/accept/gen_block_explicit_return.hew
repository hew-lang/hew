// A generator with no yield stays lazy and exhausts without a value.
fn main() {
    let captured = "never started";
    let _unused = gen { println(captured); return 0; };
    let values = gen { println("started"); return 1; };
    match values.next() {
        .Some(_) => panic("non-yielding generator yielded"),
        .None => println("finished"),
    }
}
