//! JSON values with automatic cleanup and independent copies.
//!
//! Inspect values with checked accessors. Mutate a `var` value with `set`
//! or `push`; supplied children remain usable and independent.

/// The represented JSON kind, without exposing runtime tags.
pub enum Kind {
    Null,
    Bool,
    Integer,
    Float,
    String,
    Array,
    Object,
}

/// Malformed JSON input.
pub enum ParseError {
    Invalid(string),
}

impl Display for ParseError {
    fn fmt(self) -> string {
        match self {
            ParseError.Invalid(message) => message,
        }
    }
}

/// A value cannot be represented as JSON text.
pub enum EncodeError {
    Invalid(string),
    NonFiniteFloat,
}

impl Display for EncodeError {
    fn fmt(self) -> string {
        match self {
            EncodeError.Invalid(message) => message,
            EncodeError.NonFiniteFloat => "json: non-finite float",
        }
    }
}

/// A checked access or mutation failed without changing the value.
pub enum AccessError {
    /// Expected kind, followed by the actual kind.
    WrongKind(Kind, Kind),
    /// The integer does not fit the requested signed or unsigned type.
    IntegerRange,
    /// The index is negative or exceeds the supported runtime index range.
    InvalidIndex(i64),
}

impl Display for AccessError {
    fn fmt(self) -> string {
        match self {
            AccessError.WrongKind(_, _) => "json: unexpected value kind",
            AccessError.IntegerRange => "json: integer outside the requested range",
            AccessError.InvalidIndex(index) => f"json: unsupported array index {index}",
        }
    }
}

/// An owning JSON value. Assignment and extraction produce independent values.
/// Cleanup is automatic; the representation remains private.
#[opaque]
pub type Value {
}

impl Eq for Value {
    fn eq(self, other: Value) -> bool {
        unsafe {
            hew_json_eq(self, other) == 1
        }
    }
}

trait ValueMethods {
    fn type_of(self) -> Kind;

    fn stringify(self) -> Result<string, EncodeError>;

    fn get_bool(self) -> Result<bool, AccessError>;

    fn get_int(self) -> Result<i64, AccessError>;

    fn get_u64(self) -> Result<u64, AccessError>;

    /// Read a float without coercing an integer to a float.
    fn get_float(self) -> Result<f64, AccessError>;

    fn get_string(self) -> Result<string, AccessError>;

    /// Missing keys return None; an explicit null returns Some(value).
    fn get_field(self, key: string) -> Result<Option<Value>, AccessError>;

    fn array_len(self) -> Result<i64, AccessError>;

    /// Missing elements return None; unsupported indices return InvalidIndex.
    fn array_get(self, index: i64) -> Result<Option<Value>, AccessError>;

    /// Return an independent array of object keys.
    fn keys(self) -> Result<Value, AccessError>;

    /// Set a string-keyed field, preserving the supplied child.
    fn set(var self, key: string, child: Value) -> Result<(), AccessError>;

    /// Append an independent copy of the child.
    fn push(var self, child: Value) -> Result<(), AccessError>;
}

fn require_kind(value: Value, expected: Kind) -> Result<(), AccessError> {
    let actual = value.type_of();
    if actual == expected {
        Ok(())
    } else {
        Err(AccessError.WrongKind(expected, actual))
    }
}

impl ValueMethods for Value {
    fn type_of(self) -> Kind {
        match unsafe {
            hew_json_type(self)
        } {
            0 => Kind.Null,
            1 => Kind.Bool,
            2 => Kind.Integer,
            3 => Kind.Float,
            4 => Kind.String,
            5 => Kind.Array,
            6 => Kind.Object,
            _ => panic("json: invalid internal value"),
        }
    }
    fn stringify(self) -> Result<string, EncodeError> {
        let text = unsafe {
            hew_json_stringify(self)
        };
        // Read immediately: the runtime clears this slot on successful encoding.
        let reason = unsafe {
            hew_json_last_error()
        };
        if !reason.is_empty() {
            Err(EncodeError.Invalid(reason))
        } else {
            Ok(text)
        }
    }
    fn get_bool(self) -> Result<bool, AccessError> {
        require_kind(self, Kind.Bool)?;
        Ok(unsafe {
            hew_json_get_bool(self) == 1
        })
    }
    fn get_int(self) -> Result<i64, AccessError> {
        require_kind(self, Kind.Integer)?;
        if unsafe {
            hew_json_int_status(self)
        } == 1 {
            Ok(unsafe {
                hew_json_get_int(self)
            })
        } else {
            Err(AccessError.IntegerRange)
        }
    }
    fn get_u64(self) -> Result<u64, AccessError> {
        require_kind(self, Kind.Integer)?;
        if unsafe {
            hew_json_int_status(self)
        } == 1 {
            if unsafe {
                hew_json_get_int(self)
            } < 0 {
                return Err(AccessError.IntegerRange);
            }
        }
        Ok(unsafe {
            hew_json_get_u64(self)
        })
    }
    fn get_float(self) -> Result<f64, AccessError> {
        require_kind(self, Kind.Float)?;
        Ok(unsafe {
            hew_json_get_float(self)
        })
    }
    fn get_string(self) -> Result<string, AccessError> {
        require_kind(self, Kind.String)?;
        Ok(unsafe {
            hew_json_get_string(self)
        })
    }
    fn get_field(self, key: string) -> Result<Option<Value>, AccessError> {
        require_kind(self, Kind.Object)?;
        let child = unsafe {
            hew_json_get_field(self, key)
        };
        if unsafe {
            hew_json_type(child)
        } < 0 {
            Ok(None)
        } else {
            Ok(Some(child))
        }
    }
    fn array_len(self) -> Result<i64, AccessError> {
        require_kind(self, Kind.Array)?;
        Ok(unsafe {
            hew_json_array_len(self) as i64
        })
    }
    fn array_get(self, index: i64) -> Result<Option<Value>, AccessError> {
        require_kind(self, Kind.Array)?;
        if index < 0 || index > 2147483647 {
            return Err(AccessError.InvalidIndex(index));
        }
        let child = unsafe {
            hew_json_array_get(self, index as i32)
        };
        if unsafe {
            hew_json_type(child)
        } < 0 {
            Ok(None)
        } else {
            Ok(Some(child))
        }
    }
    fn keys(self) -> Result<Value, AccessError> {
        require_kind(self, Kind.Object)?;
        Ok(unsafe {
            hew_json_object_keys(self)
        })
    }
    fn set(var self, key: string, child: Value) -> Result<(), AccessError> {
        require_kind(self, Kind.Object)?;
        // Assignment acquires an independent value; insertion transfers that owner.
        let owned_child = child;
        unsafe {
            hew_json_object_set(self, key, owned_child)
        };
        Ok(())
    }
    fn push(var self, child: Value) -> Result<(), AccessError> {
        require_kind(self, Kind.Array)?;
        let owned_child = child;
        unsafe {
            hew_json_array_push(self, owned_child)
        };
        Ok(())
    }
}

/// Parse JSON, retaining the parser's diagnostic on failure.
pub fn parse(text: string) -> Result<Value, ParseError> {
    let value = unsafe {
        hew_json_parse(text)
    };
    let reason = unsafe {
        hew_json_last_error()
    };
    if unsafe {
        hew_json_type(value)
    } < 0 {
        Err(ParseError.Invalid(reason))
    } else {
        Ok(value)
    }
}

/// Create an empty Object.
pub fn object() -> Value {
    unsafe {
        hew_json_object_new()
    }
}

/// Create an empty Array.
pub fn array() -> Value {
    unsafe {
        hew_json_array_new()
    }
}

/// Construct an exact signed integer.
pub fn from_int(val: i64) -> Value {
    unsafe {
        hew_json_from_int(val)
    }
}

/// Construct an exact unsigned integer, including values above i64's range.
pub fn from_u64(val: u64) -> Value {
    unsafe {
        hew_json_from_u64(val)
    }
}

/// Construct a finite float; JSON cannot represent NaN or infinity.
pub fn from_float(val: f64) -> Result<Value, EncodeError> {
    let value = unsafe {
        hew_json_from_float(val)
    };
    if unsafe {
        hew_json_type(value)
    } < 0 {
        Err(EncodeError.NonFiniteFloat)
    } else {
        Ok(value)
    }
}

pub fn from_string(val: string) -> Value {
    unsafe {
        hew_json_from_string(val)
    }
}

pub fn from_bool(val: bool) -> Value {
    unsafe {
        hew_json_from_bool(val as i32)
    }
}

pub fn null() -> Value {
    unsafe {
        hew_json_from_null()
    }
}

// Runtime tags, private copies and consuming child insertion stay behind the API.
extern "C" {
    fn hew_json_parse(text: string) -> Value;
    fn hew_json_last_error() -> string;
    fn hew_json_stringify(val: Value) -> string;
    fn hew_json_type(val: Value) -> i32;
    fn hew_json_eq(lhs: Value, rhs: Value) -> i32;
    fn hew_json_get_bool(val: Value) -> i32;
    fn hew_json_get_int(val: Value) -> i64;
    fn hew_json_get_u64(val: Value) -> u64;
    fn hew_json_int_status(val: Value) -> i32;
    fn hew_json_get_float(val: Value) -> f64;
    fn hew_json_get_string(val: Value) -> string;
    fn hew_json_get_field(val: Value, key: string) -> Value;
    fn hew_json_array_len(val: Value) -> i32;
    fn hew_json_array_get(val: Value, index: i32) -> Value;
    fn hew_json_object_keys(val: Value) -> Value;
    fn hew_json_object_new() -> Value;
    fn hew_json_array_new() -> Value;
    fn hew_json_object_set(obj: Value, key: string, consume child: Value);
    fn hew_json_array_push(arr: Value, consume child: Value);
    fn hew_json_from_int(val: i64) -> Value;
    fn hew_json_from_u64(val: u64) -> Value;
    fn hew_json_from_float(val: f64) -> Value;
    fn hew_json_from_string(val: string) -> Value;
    fn hew_json_from_bool(val: i32) -> Value;
    fn hew_json_from_null() -> Value;
}
