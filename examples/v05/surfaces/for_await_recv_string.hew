//! Status: runnable (v0.5 for-await over Receiver<string>)
//! Description: Drains a channel receiver with `for`.

import std.channel.channel;

actor DrainStrings {
    receive fn run(unused: i64) {
        let (tx, rx): (channel.Sender<string>, channel.Receiver<string>) = match channel.new(4) {
            .Ok(pair) => pair,
            .Err(err) => panic(f"channel.new failed: {err}"),
        };
        tx.send("a");
        tx.send("b");
        tx.send("c");
        tx.close();
        for item in rx {
            println(item);
        }
    }
}

fn main() {
    let worker = spawn DrainStrings;
    let _ = worker.run(0);
    sleep(500ms);
}
