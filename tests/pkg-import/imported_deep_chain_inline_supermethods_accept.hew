// Separate impls satisfy every level of the imported supertrait chain.
import hew.supertraits.{Base, Mid, Deep};

type DW {
    id: i64;
}

impl Base for DW {
    fn base(self) -> i64 {
        self.id
    }
}

impl Mid for DW {
    fn mid(self) -> i64 {
        self.id + 1
    }
}

impl Deep for DW {
    fn deep(self) -> i64 {
        self.id + 2
    }
}

fn main() {
    let w = DW { id: 7 };
    println(f"deep {w.deep()} mid {w.mid()} base {w.base()}");
}
