fn main() -> i64 {
    let ascii = "hello";
    println(ascii.len());
    println(ascii[0]);
    println(ascii[4]);
    println(ascii[1..4]);
    println(ascii[2..]);

    let mixed = "Aé中🙂";
    println(mixed.len());
    println(mixed[0]);
    println(mixed[1]);
    println(mixed[2]);
    println(mixed[3]);
    println(mixed[1..3]);
    println(mixed[2..]);

    // Embedded NUL is one codepoint among others, not a terminator.
    let nul = "a\0b";
    println(nul.len());
    println(nul[1] as i64);
    println(nul[0..2] == "a\0");

    var total = 0;
    var i = 0;
    while i < mixed.len() {
        total = total + (mixed[i] as i64);
        i = i + 1;
    }
    println(total);
    0
}
