fn last<I, A>(consume input: I) -> Option<I.Item> where I: DoubleEndedIterator<Item = A> {
    var cursor = input;
    cursor.next_back()
}

fn first<I, A>(consume input: I) -> Option< <I as DoubleEndedIterator>.Item> where I: DoubleEndedIterator<Item = A> {
    var cursor = input;
    cursor.next()
}

fn after_front<T>(consume input: VecIter<T>) -> VecIter<T> {
    var cursor = input;
    let _ = cursor.next();
    cursor
}

fn main() -> i64 {
    var source = ["first", "second", "third"];
    var cursor = source.iter();
    source.clear();
    var copy = cursor;
    match cursor.next() {
        .Some(value) => println(value),
        .None => println("missing"),
    }
    match copy.next_back() {
        .Some(value) => println(value),
        .None => println("missing"),
    }
    match cursor.next_back() {
        .Some(value) => println(value),
        .None => println("missing"),
    }
    match cursor.next() {
        .Some(value) => println(value),
        .None => println("empty"),
    }
    match cursor.next_back() {
        .Some(value) => println(value),
        .None => println("empty"),
    }
    match cursor.next() {
        .Some(value) => println(value),
        .None => println("empty"),
    }
    match copy.next() {
        .Some(value) => println(value),
        .None => println("missing"),
    }
    match copy.next_back() {
        .Some(value) => println(value),
        .None => println("missing"),
    }
    match copy.next() {
        .Some(value) => println(value),
        .None => println("empty"),
    }
    let vacant: Vec<i64> = [];
    var empty = vacant.into_iter();
    assert(empty.next_back().is_none());
    assert(empty.next().is_none());
    var single = [7].into_iter();
    assert(single.next_back().expect("single item") == 7);
    assert(single.next().is_none());
    assert(single.next_back().is_none());
    assert(last([8, 9].into_iter()).expect("generic last item") == 9);
    assert(first([8, 9].into_iter()).expect("generic first item") == 8);
    var mixed = [1, 2, 3, 4].into_iter();
    assert(mixed.next().expect("concrete front") == 1);
    mixed = after_front(mixed);
    assert(mixed.next_back().expect("concrete back") == 4);
    assert(mixed.next().expect("remaining middle") == 3);
    assert(mixed.next_back().is_none());
    0
}
