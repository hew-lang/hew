fn probe(take: bool) -> i64 {
    var m: HashMap<string, i64> = HashMap.new();
    m.insert("k", 42);
    var out: i64 = 1;
    if take {
        let n = m;
        out = n.len();
    }
    out
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        total = total + probe(false);
        i = i + 1;
    }
    total
}
