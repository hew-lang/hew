actor Holder {
    var ready: bool;

    receive fn hold(v: Generator<i64, ()>) -> i64 {
        sleep(2ms);
        var v_sum = 0;
        for v_y in v {
            v_sum = v_sum + v_y;
        }
        println(f"sum {v_sum}");
        ready = true;
        1
    }
}

fn main() {
    let x = gen {
        yield 1;
        yield 2;
    };
    let h = spawn Holder(ready: false);
    match await h.hold(x) {
        Ok(n) => println(f"held {n}"),
        Err(_) => println("err"),
    }
}
