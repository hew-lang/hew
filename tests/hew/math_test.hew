//! Tests for generic std::math helpers.

import std.math;

#[test]
fn test_abs_dispatches_by_numeric_type() {
    let i: i64 = -5;
    let f: f64 = -5.5;
    assert(math.abs(i) == 5);
    assert(math.abs(f) == 5.5);
}

#[test]
fn test_min_returns_the_smaller_value() {
    assert(math.min(3, 7) == 3);
    assert(math.min(3.5, 1.25) == 1.25);
}

#[test]
fn test_max_returns_the_larger_value() {
    assert(math.max(3, 7) == 7);
    assert(math.max(3.5, 1.25) == 3.5);
}

#[test]
fn test_clamp_honors_valid_interval() {
    assert(math.clamp(8, 0, 5) == 5);
}

#[test]
#[should_panic]
fn test_clamp_rejects_reversed_interval() {
    math.clamp(5, 10, 0);
}
