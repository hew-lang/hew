type Store<T> {
    slots: Vec<T>,
}

impl<T> Store<T> {
    fn add(self, value: T) -> Store<T> {
        var updated = self;
        updated.slots.push(value);
        updated
    }
}

type Collections {
    slots: Vec<string>,
    labels: HashMap<string, string>,
    members: HashSet<string>,
}

type Holder {
    nested: Collections,
    sibling: string,
}

fn main() -> i64 {
    let store = Store { slots: ["first".to_upper()] };
    let added = store.add("second".to_upper());
    println(store.slots.len());
    println(added.slots[1]);
    var holder = Holder {
        nested: Collections {
            slots: ["original".to_upper()],
            labels: HashMap.new(),
            members: HashSet.new(),
        },
        sibling: "sibling".to_upper(),
    };
    let copy = holder;
    holder.nested.slots.push(holder.nested.slots[0]);
    holder.nested.labels.insert("key", holder.sibling);
    println(holder.nested.members.insert(holder.nested.slots[1]));
    println(holder.nested.members.remove("ORIGINAL"));
    match holder.nested.labels.remove("key") {
        .Some(value) => println(value),
        .None => return 1,
    }
    println(holder.nested.slots.pop());
    println(holder.sibling);
    println(copy.nested.slots.len());
    println(copy.nested.labels.len());
    println(copy.nested.members.len());
    holder.nested.slots.clear();
    println(holder.nested.slots.len());
    0
}
