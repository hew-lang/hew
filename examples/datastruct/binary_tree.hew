// Binary Tree using Vec<i64> with index-based pointers
// Each node: [value, left, right] = 3 slots
// NIL = -1 means no child
//
// A parameter is the callee's own copy, so every helper that grows the node
// pool returns it and the caller reassigns; allocation also reports the new
// index, so it returns a tuple. Traversals build and return their own result.
fn add_node(var nodes: Vec<i64>, val: i64, NIL: i64) -> (Vec<i64>, i64) {
    let idx = nodes.len() / 3;
    nodes.push(val);
    nodes.push(NIL);
    nodes.push(NIL);
    (nodes, idx)
}

// Insert level-order using a queue; returns the grown node pool
fn insert_level_order(var nodes: Vec<i64>, val: i64, NIL: i64) -> Vec<i64> {
    let count = nodes.len() / 3;
    if count == 0 {
        let (rooted, _root) = add_node(nodes, val, NIL);
        return rooted;
    }
    var queue: Vec<i64> = Vec.new();
    queue.push(0);
    var head = 0;
    var done = false;
    while head < queue.len() {
        if !done {
            let cur = queue[head];
            head = head + 1;
            let left = nodes[cur * 3 + 1];
            if left == NIL {
                let (grown, new_idx) = add_node(nodes, val, NIL);
                nodes = grown;
                nodes.set(cur * 3 + 1, new_idx);
                done = true;
            } else {
                queue.push(left);
                let right = nodes[cur * 3 + 2];
                if right == NIL {
                    let (grown, new_idx) = add_node(nodes, val, NIL);
                    nodes = grown;
                    nodes.set(cur * 3 + 2, new_idx);
                    done = true;
                } else {
                    queue.push(right);
                }
            }
        } else {
            head = queue.len();
        }
    }
    nodes
}

// Build a level-order tree holding 1..count.
fn build_level_order(count: i64, NIL: i64) -> Vec<i64> {
    var nodes: Vec<i64> = Vec.new();
    for i in 1 .. count + 1 {
        nodes = insert_level_order(nodes, i, NIL);
    }
    nodes
}

// Iterative inorder traversal using stack
fn inorder(nodes: Vec<i64>, NIL: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec.new();
    if nodes.is_empty() {
        return result;
    }
    var stack: Vec<i64> = Vec.new();
    var cur = 0;
    var running = true;
    while running {
        while cur != NIL {
            stack.push(cur);
            cur = nodes[cur * 3 + 1];
        }
        if stack.is_empty() {
            running = false;
        } else {
            cur = stack.pop();
            result.push(nodes[cur * 3]);
            cur = nodes[cur * 3 + 2];
        }
    }
    result
}

// Iterative preorder traversal
fn preorder(nodes: Vec<i64>, NIL: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec.new();
    if nodes.is_empty() {
        return result;
    }
    var stack: Vec<i64> = Vec.new();
    stack.push(0);
    while !stack.is_empty() {
        let cur = stack.pop();
        result.push(nodes[cur * 3]);
        let r = nodes[cur * 3 + 2];
        if r != NIL {
            stack.push(r);
        }
        let l = nodes[cur * 3 + 1];
        if l != NIL {
            stack.push(l);
        }
    }
    result
}

// Iterative postorder using two stacks
fn postorder(nodes: Vec<i64>, NIL: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec.new();
    if nodes.is_empty() {
        return result;
    }
    var s1: Vec<i64> = Vec.new();
    var s2: Vec<i64> = Vec.new();
    s1.push(0);
    while !s1.is_empty() {
        let cur = s1.pop();
        s2.push(cur);
        let l = nodes[cur * 3 + 1];
        if l != NIL {
            s1.push(l);
        }
        let r = nodes[cur * 3 + 2];
        if r != NIL {
            s1.push(r);
        }
    }
    while !s2.is_empty() {
        let cur = s2.pop();
        result.push(nodes[cur * 3]);
    }
    result
}

// Height calculation using iterative approach with node heights
fn height(nodes: Vec<i64>, NIL: i64) -> i64 {
    let count = nodes.len() / 3;
    if count == 0 {
        return 0;
    }
    // Compute height for each node bottom-up
    var heights: Vec<i64> = Vec.new();
    for i in 0 .. count {
        heights.push(0);
    }
    // Process nodes in reverse order (leaves first)
    var i = count - 1;
    while i >= 0 {
        let l = nodes[i * 3 + 1];
        let r = nodes[i * 3 + 2];
        var lh = 0;
        var rh = 0;
        if l != NIL {
            lh = heights[l];
        }
        if r != NIL {
            rh = heights[r];
        }
        var mx = lh;
        if rh > mx {
            mx = rh;
        }
        heights.set(i, mx + 1);
        i = i - 1;
    }
    heights[0]
}

fn vecs_equal(a: Vec<i64>, b: Vec<i64>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    var i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

fn print_vec(v: Vec<i64>) -> i64 {
    for x in v {
        print(x);
        print(" ");
    }
    println("");
    0
}

fn test_inorder() -> i64 {
    let NIL = 0 - 1;
    //        1
    //       / \
    //      2   3
    //     / \ / \
    //    4  5 6  7
    let nodes = build_level_order(7, NIL);
    let result = inorder(nodes, NIL);
    var expected: Vec<i64> = Vec.new();
    expected.push(4);
    expected.push(2);
    expected.push(5);
    expected.push(1);
    expected.push(6);
    expected.push(3);
    expected.push(7);
    if vecs_equal(result, expected) {
        println("PASS: inorder traversal");
        1
    } else {
        print("FAIL: inorder, got: ");
        let _ = print_vec(result);
        0
    }
}

fn test_preorder() -> i64 {
    let NIL = 0 - 1;
    let nodes = build_level_order(7, NIL);
    let result = preorder(nodes, NIL);
    var expected: Vec<i64> = Vec.new();
    expected.push(1);
    expected.push(2);
    expected.push(4);
    expected.push(5);
    expected.push(3);
    expected.push(6);
    expected.push(7);
    if vecs_equal(result, expected) {
        println("PASS: preorder traversal");
        1
    } else {
        print("FAIL: preorder, got: ");
        let _ = print_vec(result);
        0
    }
}

fn test_postorder() -> i64 {
    let NIL = 0 - 1;
    let nodes = build_level_order(7, NIL);
    let result = postorder(nodes, NIL);
    var expected: Vec<i64> = Vec.new();
    expected.push(4);
    expected.push(5);
    expected.push(2);
    expected.push(6);
    expected.push(7);
    expected.push(3);
    expected.push(1);
    if vecs_equal(result, expected) {
        println("PASS: postorder traversal");
        1
    } else {
        print("FAIL: postorder, got: ");
        let _ = print_vec(result);
        0
    }
}

fn test_height() -> i64 {
    let NIL = 0 - 1;
    let nodes = build_level_order(7, NIL);
    let h = height(nodes, NIL);
    if h == 3 {
        println("PASS: height = 3");
        1
    } else {
        print("FAIL: height expected 3 got ");
        println(h);
        0
    }
}

fn test_single_node() -> i64 {
    let NIL = 0 - 1;
    let empty: Vec<i64> = Vec.new();
    let nodes = insert_level_order(empty, 42, NIL);
    let result = inorder(nodes, NIL);
    let h = height(nodes, NIL);
    if result.len() == 1 {
        if result[0] == 42 {
            if h == 1 {
                println("PASS: single node");
                return 1;
            }
        }
    }
    println("FAIL: single node");
    0
}

fn main() {
    println("=== Binary Tree ===");
    var passed = 0;
    let total = 5;
    passed = passed + test_inorder();
    passed = passed + test_preorder();
    passed = passed + test_postorder();
    passed = passed + test_height();
    passed = passed + test_single_node();
    println("");
    print(passed);
    print("/");
    print(total);
    println(" tests passed");
    if passed == total {
        println("PASS");
    } else {
        println("FAIL");
    }
}
