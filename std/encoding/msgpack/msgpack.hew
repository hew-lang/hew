//! MessagePack serialization.
//!
//! Encode and decode values using the MessagePack binary format.
//! Supports conversion between JSON strings and MessagePack bytes,
//! as well as encoding individual typed values.
//!
//! # Examples
//!
//! ```
//! import std.encoding.msgpack;
//! import std.encoding.hex;
//!
//! fn main() {
//!     let packed = msgpack.from_json("{\"x\": 1}");
//!     println(packed.len());
//!     let json = msgpack.to_json(packed);
//!     println(json);
//! }
//! ```

/// Encode a JSON string to MessagePack binary.
///
/// Returns `Err(reason)` on invalid JSON or serialization failure. The codec's
/// own reason slot decides success, not the length of the result, so a
/// legitimately short encoding is never mistaken for a failure.
pub fn from_json(json: string) -> Result<bytes, string> {
    let data = unsafe {
        hew_msgpack_from_json_hew(json)
    };
    let reason = unsafe {
        hew_msgpack_last_error()
    };
    if reason.len() > 0 {
        Err(reason)
    } else {
        Ok(data)
    }
}

/// Decode a MessagePack `bytes` buffer to a JSON string.
///
/// Returns `Err(reason)` on invalid input or deserialization failure.
pub fn to_json(data: bytes) -> Result<string, string> {
    let json = unsafe {
        hew_msgpack_to_json_hew(data)
    };
    let reason = unsafe {
        hew_msgpack_last_error()
    };
    if reason.len() > 0 {
        Err(reason)
    } else {
        Ok(json)
    }
}

/// Encode an integer as a MessagePack varint without panicking.
pub fn encode_int(val: i64) -> Result<bytes, string> {
    let data = unsafe {
        hew_msgpack_encode_int_hew(val)
    };
    let reason = unsafe {
        hew_msgpack_last_error()
    };
    if reason.len() > 0 {
        Err(reason)
    } else {
        Ok(data)
    }
}

/// Encode a string as MessagePack str without panicking.
pub fn encode_string(s: string) -> Result<bytes, string> {
    let data = unsafe {
        hew_msgpack_encode_string_hew(s)
    };
    let reason = unsafe {
        hew_msgpack_last_error()
    };
    if reason.len() > 0 {
        Err(reason)
    } else {
        Ok(data)
    }
}

/// Encode binary data as a MessagePack bin without panicking.
///
/// An empty input is a value, not a missing argument: it encodes to an empty
/// bin8 rather than to an empty result that reads as a failure.
pub fn encode_bytes(data: bytes) -> Result<bytes, string> {
    let encoded = unsafe {
        hew_msgpack_encode_bytes_hew(data)
    };
    let reason = unsafe {
        hew_msgpack_last_error()
    };
    if reason.len() > 0 {
        Err(reason)
    } else {
        Ok(encoded)
    }
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    fn hew_msgpack_from_json_hew(json: string) -> bytes;
    fn hew_msgpack_to_json_hew(data: bytes) -> string;
    fn hew_msgpack_last_error() -> string;
    fn hew_msgpack_encode_int_hew(val: i64) -> bytes;
    fn hew_msgpack_encode_string_hew(s: string) -> bytes;
    fn hew_msgpack_encode_bytes_hew(data: bytes) -> bytes;
}
