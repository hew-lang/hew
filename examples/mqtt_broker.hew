//! Status: runnable (native; MQTT 3.1.1 subset)
//! Description: MQTT 3.1.1 broker — pure Hew split stream/sink actor implementation

// MQTT 3.1.1 broker — pure Hew actor implementation
// Listens on port 1883 by default (pass a port as argv[1]).
// Uses bytes type for all TCP I/O. Each accepted connection is consumed into
// independently-owned Stream<bytes> and Sink<bytes> halves: a reader actor owns
// inbound suspension while ClientHandler owns outbound delivery.
//
// Architecture:
//   main          — constructs the actor graph and keeps the process alive
//   Acceptor      — accept loop; spawns ClientHandler per connection
//   ClientHandler — owns one connection, handles inbound and outbound messages
//   Router        — tracks clients and subscriptions, fans out publishes
//
// Router state uses only clonable types (strings, i32, LocalPid handles) so the
// actor is supervisor-restartable. Runtime stream/sink halves have one owner
// each and close automatically with their actors.
import std.net;

import std.stream.{Sink, Stream};

import std.os;

extern "C" {
    fn hew_actor_self_stop();
    fn hew_sink_shutdown(sink: Sink<bytes>);
}

// Bound buffering for peers that advertise a very large Remaining Length and
// then dribble bytes indefinitely. This example intentionally implements a
// compact MQTT subset; one MiB is ample for its demonstrations.
const MAX_PACKET_BYTES: i64 = 1048576;

// ── Bytes helpers ─────────────────────────────────────────────────────────────
fn bytes_slice(data: bytes, start: i64, end: i64) -> bytes {
    let result = bytes.new();
    for i in start .. end {
        result.push(data[i]);
    }
    result
}

fn has_bytes(limit: i64, offset: i64, count: i64) -> bool {
    offset >= 0 && count >= 0 && offset <= limit && count <= limit - offset
}

// Read big-endian uint16 at an offset already proven in range.
fn read_u16(data: bytes, offset: i64) -> i32 {
    data[offset] as i32 * 256 + data[offset + 1] as i32
}

fn push_u16(buf: bytes, val: i32) {
    buf.push((val / 256) as u8);
    buf.push((val % 256) as u8);
}

fn push_varint(buf: bytes, val: i32) {
    var remaining = val;
    loop {
        let digit = remaining % 128;
        remaining = remaining / 128;
        if remaining > 0 {
            buf.push((digit + 128) as u8);
        } else {
            buf.push(digit as u8);
            break;
        }
    }
}

fn read_varint_value(data: bytes, offset: i64) -> i32 {
    var value: i32 = 0;
    var multiplier: i32 = 1;
    var i: i64 = offset;
    loop {
        let b = data[i] as i32;
        value = value + b % 128 * multiplier;
        multiplier = multiplier * 128;
        i = i + 1;
        if b < 128 {
            break;
        }
    }
    value
}

fn read_varint_len(data: bytes, offset: i64) -> i64 {
    var i: i64 = offset;
    var count: i64 = 0;
    while i < data.len() {
        let b = data[i];
        i = i + 1;
        count = count + 1;
        if b < 128 {
            return count;
        }
        if count == 4 {
            return -1;
        }
    }
    0
}

// Push length-prefixed MQTT string.
fn push_mqtt_str(buf: bytes, s: string) {
    let slen: i64 = s.len();
    push_u16(buf, slen as i32);
    for i in 0 .. slen {
        buf.push(s.char_at(i).unwrap_or('\0') as u8);
    }
}

// Return the complete wire width of a length-prefixed MQTT string, or -1 when
// its prefix or payload would cross the current packet boundary.
fn mqtt_str_wire_len(data: bytes, offset: i64, limit: i64) -> i64 {
    if !has_bytes(limit, offset, 2) {
        return -1;
    }
    let wire_len: i64 = 2 + read_u16(data, offset) as i64;
    if !has_bytes(limit, offset, wire_len) {
        return -1;
    }
    wire_len
}

// Read a length-prefixed MQTT string whose wire width was already validated.
fn read_mqtt_str(data: bytes, offset: i64) -> string {
    let len: i64 = read_u16(data, offset) as i64;
    let s = bytes.new();
    let start: i64 = offset + 2;
    for i in start .. start + len {
        s.push(data[i]);
    }
    s.to_string()
}

// ── Packet builders ───────────────────────────────────────────────────────────
fn build_connack(session_present: i32, return_code: i32) -> bytes {
    let buf = bytes.new();
    buf.push(0x20 as u8);
    buf.push(2 as u8);
    buf.push(session_present as u8);
    buf.push(return_code as u8);
    buf
}

fn build_puback(packet_id: i32) -> bytes {
    let buf = bytes.new();
    buf.push(0x40 as u8);
    buf.push(2 as u8);
    push_u16(buf, packet_id);
    buf
}

fn build_suback(packet_id: i32, return_codes: bytes) -> bytes {
    let body = bytes.new();
    push_u16(body, packet_id);
    body.append(return_codes);
    let buf = bytes.new();
    buf.push(0x90 as u8);
    push_varint(buf, body.len() as i32);
    buf.append(body);
    buf
}

fn build_unsuback(packet_id: i32) -> bytes {
    let buf = bytes.new();
    buf.push(0xB0 as u8);
    buf.push(2 as u8);
    push_u16(buf, packet_id);
    buf
}

fn build_pingresp() -> bytes {
    let buf = bytes.new();
    buf.push(0xD0 as u8);
    buf.push(0 as u8);
    buf
}

// Build a PUBLISH packet. payload is raw bytes (not a string).
fn build_publish(topic: string, payload: bytes, qos: i32, packet_id: i32) -> bytes {
    let body: bytes = bytes.new();
    push_mqtt_str(body, topic);
    if qos > 0 {
        push_u16(body, packet_id);
    }
    body.append(payload);
    let flags = 0x30 + qos * 2;
    let buf = bytes.new();
    buf.push(flags as u8);
    push_varint(buf, body.len() as i32);
    buf.append(body);
    buf
}

// ── Actors ────────────────────────────────────────────────────────────────────

// ClientHandler owns only the write half. ClientReader owns the read half and
// forwards frames as actor messages, so an idle subscriber never blocks
// publication delivery to ClientHandler.
actor ClientHandler {
    let sink: Sink<bytes>,
    let session_id: string,
    var client_id: string,
    let router: LocalPid<Router>,
    var buf: bytes,
    var registered: bool,
    receive fn register(reader: LocalPid<ClientReader>) {
        let accepted = match await router.register_client(session_id.clone(), this) {
            .Ok(value) => value,
            .Err(_) => false,
        };
        if accepted {
            registered = true;
            reader.start();
        } else {
            unsafe {
                hew_sink_shutdown(sink)
            };
            reader.stop();
            unsafe {
                hew_actor_self_stop()
            };
        }
    }
    receive fn deliver(packet: bytes) {
        sink.send(packet);
    }
    receive fn on_data(chunk: bytes) -> bool {
        var connected = true;
        let next_buf = bytes.new();
        next_buf.append(buf);
        next_buf.append(chunk);
        buf = next_buf;
        loop {
            let buf_len = buf.len();
            if buf_len < 2 {
                break;
            }
            let vl: i64 = read_varint_len(buf, 1);
            if vl < 0 {
                connected = false;
                println(f"[mqtt] malformed remaining length for {client_id}");
                break;
            }
            if vl == 0 {
                break;
            }
            let remaining_len: i64 = read_varint_value(buf, 1) as i64;
            if remaining_len > MAX_PACKET_BYTES {
                connected = false;
                println(f"[mqtt] packet exceeds size limit for {client_id}");
                break;
            }
            let total: i64 = 1 + vl + remaining_len;
            if buf_len < total {
                break;
            }
            let ptype = buf[0] as i64 / 16;
            let pflags = buf[0] as i64 % 16;
            let var_off: i64 = 1 + vl;
            let packet_end: i64 = var_off + remaining_len;
            match ptype {
                1 => {
                    // CONNECT
                    var connect_rejected = false;
                    let proto_wire_len = mqtt_str_wire_len(buf, var_off, packet_end);
                    if pflags != 0 || proto_wire_len < 0 {
                        connected = false;
                    } else {
                        let protocol_name = read_mqtt_str(buf, var_off);
                        let header_off: i64 = var_off + proto_wire_len;
                        if protocol_name != "MQTT" || !has_bytes(packet_end, header_off, 4) {
                            connected = false;
                        } else {
                            let protocol_level = buf[header_off] as i32;
                            let payload_off: i64 = header_off + 4;
                            let client_id_wire_len = mqtt_str_wire_len(buf, payload_off, packet_end);
                            if protocol_level != 4 || client_id_wire_len < 0 {
                                connected = false;
                            } else {
                                let new_client_id = read_mqtt_str(buf, payload_off);
                                let claim_status = match await router.claim_client_id(session_id.clone(), new_client_id.clone()) {
                                    .Ok(value) => {
                                        if value {
                                            1
                                        } else {
                                            0
                                        }
                                    },
                                    .Err(_) => -1,
                                };
                                if claim_status == 1 {
                                    if new_client_id != "" {
                                        client_id = new_client_id;
                                    }
                                    println(f"[mqtt] CONNECT client_id={client_id}");
                                    sink.send(build_connack(0, 0));
                                } else {
                                    connect_rejected = true;
                                    connected = false;
                                    if claim_status == 0 {
                                        println(f"[mqtt] duplicate client_id={new_client_id} rejected session={session_id}");
                                        sink.send(build_connack(0, 2));
                                    } else {
                                        println(f"[mqtt] ClientId claim unavailable session={session_id}");
                                        sink.send(build_connack(0, 3));
                                    }
                                }
                            }
                        }
                    }
                    if !connected && !connect_rejected {
                        println(f"[mqtt] malformed CONNECT for {client_id}");
                    }
                },
                3 => {
                    // PUBLISH
                    let qos = pflags / 2 % 4;
                    let topic_wire_len = mqtt_str_wire_len(buf, var_off, packet_end);
                    if qos == 3 || topic_wire_len <= 2 {
                        connected = false;
                    } else {
                        let topic = read_mqtt_str(buf, var_off);
                        var payload_off: i64 = var_off + topic_wire_len;
                        var packet_id: i32 = 0;
                        if qos > 0 {
                            if has_bytes(packet_end, payload_off, 2) {
                                packet_id = read_u16(buf, payload_off);
                                payload_off = payload_off + 2;
                                sink.send(build_puback(packet_id));
                            } else {
                                connected = false;
                            }
                        }
                        if connected {
                            let payload_bytes = bytes_slice(buf, payload_off, packet_end);
                            println(f"[mqtt] PUBLISH topic={topic} qos={qos}");
                            router.publish(topic, payload_bytes, qos as i32, packet_id);
                        }
                    }
                    if !connected {
                        println(f"[mqtt] malformed PUBLISH for {client_id}");
                    }
                },
                8 => {
                    // SUBSCRIBE
                    if pflags != 2 || !has_bytes(packet_end, var_off, 3) {
                        connected = false;
                    } else {
                        let sub_packet_id = read_u16(buf, var_off);
                        var topic_off: i64 = var_off + 2;
                        let return_codes: bytes = bytes.new();
                        while connected && topic_off < packet_end {
                            let tw = mqtt_str_wire_len(buf, topic_off, packet_end);
                            if tw <= 2 || !has_bytes(packet_end, topic_off + tw, 1) {
                                connected = false;
                                break;
                            }
                            let stopic = read_mqtt_str(buf, topic_off);
                            let req_qos: i32 = buf[topic_off + tw] as i32;
                            if req_qos > 1 || stopic.contains("#") || stopic.contains("+") {
                                // This compact broker implements exact-topic
                                // matching only; reject filters it cannot honor.
                                return_codes.push(0x80 as u8);
                            } else {
                                router.subscribe(stopic, session_id.clone(), req_qos);
                                return_codes.push(req_qos as u8);
                            }
                            topic_off = topic_off + tw + 1;
                        }
                        if connected {
                            sink.send(build_suback(sub_packet_id, return_codes));
                            println("[mqtt] SUBSCRIBE processed");
                        }
                    }
                    if !connected {
                        println(f"[mqtt] malformed SUBSCRIBE for {client_id}");
                    }
                },
                10 => {
                    // UNSUBSCRIBE
                    if pflags != 2 || !has_bytes(packet_end, var_off, 3) {
                        connected = false;
                    } else {
                        let unsub_packet_id = read_u16(buf, var_off);
                        var topic_off: i64 = var_off + 2;
                        while connected && topic_off < packet_end {
                            let tw = mqtt_str_wire_len(buf, topic_off, packet_end);
                            if tw <= 2 {
                                connected = false;
                                break;
                            }
                            let utopic = read_mqtt_str(buf, topic_off);
                            router.unsubscribe(utopic, session_id.clone());
                            topic_off = topic_off + tw;
                        }
                        if connected {
                            sink.send(build_unsuback(unsub_packet_id));
                            println(f"[mqtt] UNSUBSCRIBE {client_id}");
                        }
                    }
                    if !connected {
                        println(f"[mqtt] malformed UNSUBSCRIBE for {client_id}");
                    }
                },
                12 => {
                    // PINGREQ
                    if pflags == 0 && remaining_len == 0 {
                        sink.send(build_pingresp());
                    } else {
                        connected = false;
                        println(f"[mqtt] malformed PINGREQ for {client_id}");
                    }
                },
                14 => {
                    // DISCONNECT
                    if pflags == 0 && remaining_len == 0 {
                        connected = false;
                        println(f"[mqtt] DISCONNECT {client_id}");
                    } else {
                        connected = false;
                        println(f"[mqtt] malformed DISCONNECT for {client_id}");
                    }
                },
                _ => {
                    connected = false;
                    println(f"[mqtt] unsupported packet type {ptype} for {client_id}");
                },
            }
            if connected {
                buf = bytes_slice(buf, total, buf_len);
            } else {
                break;
            }
        }
        if !connected {
            if registered {
                router.client_disconnect(session_id.clone());
                registered = false;
            }
            println(f"[mqtt] connection closed for {client_id}");
            unsafe {
                hew_sink_shutdown(sink)
            };
            unsafe {
                hew_actor_self_stop()
            };
        }
        connected
    }
    receive fn on_close() {
        if registered {
            router.client_disconnect(session_id.clone());
            registered = false;
            println(f"[mqtt] connection closed for {client_id}");
        }
        unsafe {
            hew_sink_shutdown(sink)
        };
        unsafe {
            hew_actor_self_stop()
        };
    }
}

// ClientReader is the sole owner of the readable half. It awaits frames without
// occupying a scheduler worker, then asks ClientHandler whether parsing should
// continue. Dropping this actor closes the stream half exactly once.
actor ClientReader {
    let input: Stream<bytes>,
    let client: LocalPid<ClientHandler>,
    receive fn start() {
        var reading = true;
        while reading {
            match await input.recv() {
                .Some(chunk) => {
                    reading = match await client.on_data(chunk) {
                        .Ok(keep_reading) => keep_reading,
                        .Err(_) => false,
                    };
                },
                .None => {
                    client.on_close();
                    reading = false;
                },
            }
        }
        unsafe {
            hew_actor_self_stop()
        };
    }
    receive fn stop() {
        unsafe {
            hew_actor_self_stop()
        };
    }
}

// Router — tracks clients and subscriptions; fans out publishes directly.
//
// State uses only clonable types: strings, i32, and LocalPid actor handles.
// A generated session ID is the immutable registry and delivery authority;
// the peer-selected ClientId is metadata claimed atomically during CONNECT.
// Parallel arrays: session_ids[i] <-> client_ids[i] <-> clients[i]
// Parallel arrays: sub_topics[i] <-> sub_session_ids[i] <-> sub_qos[i]
actor Router {
    var session_ids: Vec<string>,
    var client_ids: Vec<string>,
    var clients: Vec<LocalPid<ClientHandler>>,
    var sub_topics: Vec<string>,
    var sub_session_ids: Vec<string>,
    var sub_qos: Vec<i32>,
    receive fn register_client(session_id: string, client: LocalPid<ClientHandler>) -> bool {
        for existing_session in session_ids {
            if existing_session == session_id {
                println(f"[router] duplicate session_id={session_id} rejected");
                return false;
            }
        }
        session_ids.push(session_id);
        client_ids.push("");
        clients.push(client);
        println(f"[router] state event=register clients={session_ids.len()} subscriptions={sub_topics.len()}");
        true
    }
    receive fn claim_client_id(session_id: string, requested: string) -> bool {
        if requested != "" {
            for i in 0 .. client_ids.len() {
                if client_ids[i] == requested && session_ids[i] != session_id {
                    println(f"[router] duplicate client_id={requested} rejected session={session_id}");
                    return false;
                }
            }
        }
        // Empty ClientIds are permitted for clean sessions in MQTT 3.1.1.
        // Their generated session IDs remain the routing authority.
        for i in 0 .. client_ids.len() {
            if session_ids[i] == session_id {
                client_ids[i] = requested;
                return true;
            }
        }
        println(f"[router] missing session_id={session_id} during CONNECT");
        false
    }
    receive fn subscribe(topic: string, session_id: string, qos: i32) {
        sub_topics.push(topic);
        sub_session_ids.push(session_id);
        sub_qos.push(qos);
        println(f"[router] state event=subscribe clients={session_ids.len()} subscriptions={sub_topics.len()} qos={qos}");
    }
    receive fn publish(topic: string, payload: bytes, qos: i32, packet_id: i32) {
        // Fan out to all matching subscribers via actor handles.
        for i in 0 .. sub_topics.len() {
            if sub_topics[i] == topic {
                let sub_session = sub_session_ids[i];
                let sub_q = sub_qos[i];
                for j in 0 .. session_ids.len() {
                    if session_ids[j] == sub_session {
                        let target = clients[j];
                        target.deliver(build_publish(topic, payload, sub_q, packet_id));
                        break;
                    }
                }
            }
        }
        println(f"[router] publish topic={topic}");
    }
    receive fn unsubscribe(topic: string, session_id: string) {
        let before = sub_topics.len();
        let new_topics: Vec<string> = Vec.new();
        let new_sessions: Vec<string> = Vec.new();
        let new_qos: Vec<i32> = Vec.new();
        for i in 0 .. sub_topics.len() {
            if sub_session_ids[i] == session_id {
                if sub_topics[i] == topic {
                    continue;
                }
            }
            new_topics.push(sub_topics[i]);
            new_sessions.push(sub_session_ids[i]);
            new_qos.push(sub_qos[i]);
        }
        sub_topics = new_topics;
        sub_session_ids = new_sessions;
        sub_qos = new_qos;
        let removed = before - sub_topics.len();
        println(f"[router] state event=unsubscribe clients={session_ids.len()} subscriptions={sub_topics.len()} removed={removed} topic={topic}");
    }
    receive fn client_disconnect(session_id: string) {
        // Remove from client registry
        let clients_before = session_ids.len();
        let subscriptions_before = sub_topics.len();
        let new_sessions: Vec<string> = Vec.new();
        let new_client_ids: Vec<string> = Vec.new();
        let new_clients: Vec<LocalPid<ClientHandler>> = Vec.new();
        for i in 0 .. session_ids.len() {
            if session_ids[i] != session_id {
                new_sessions.push(session_ids[i]);
                new_client_ids.push(client_ids[i]);
                new_clients.push(clients[i]);
            }
        }
        session_ids = new_sessions;
        client_ids = new_client_ids;
        clients = new_clients;
        // Remove subscriptions for this client
        let new_sub_topics: Vec<string> = Vec.new();
        let new_sub_sessions: Vec<string> = Vec.new();
        let new_sub_qos: Vec<i32> = Vec.new();
        for j in 0 .. sub_session_ids.len() {
            if sub_session_ids[j] != session_id {
                new_sub_topics.push(sub_topics[j]);
                new_sub_sessions.push(sub_session_ids[j]);
                new_sub_qos.push(sub_qos[j]);
            }
        }
        sub_topics = new_sub_topics;
        sub_session_ids = new_sub_sessions;
        sub_qos = new_sub_qos;
        let removed_clients = clients_before - session_ids.len();
        let removed_subscriptions = subscriptions_before - sub_topics.len();
        println(f"[router] state event=disconnect session={session_id} removed_clients={removed_clients} removed_subscriptions={removed_subscriptions} clients={session_ids.len()} subscriptions={sub_topics.len()}");
    }
}

// Acceptor — accept loop; spawns a ClientHandler for each new connection.
// Named `Acceptor`, not `Listener`, to avoid colliding with the LLVM
// struct name codegen assigns the stdlib `net.Listener` opaque handle
// type (see https://github.com/hew-lang/hew/issues/2509).
actor Acceptor {
    let router: LocalPid<Router>,
    let addr: string,
    receive fn start() {
        let lst = match net.listen(addr) {
            .Ok(listener) => listener,
            .Err(_) => panic("failed to listen"),
        };
        println(f"[listener] MQTT broker ready on {addr}");
        var next_id: i32 = 1;
        loop {
            let conn = await lst.accept();
            let cid = f"client-{next_id}";
            let (input, sink) = conn.into_stream_sink();
            let handler = spawn ClientHandler(sink: sink, session_id: cid.clone(), client_id: cid.clone(), router: router, buf: bytes.new(), registered: false);
            let reader = spawn ClientReader(input: input, client: handler);
            handler.register(reader);
            next_id = next_id + 1;
        }
    }
}

fn main() {
    var port = "1883";
    if os.args().len() > 1 {
        if let .Some(value) = os.args().get(1) {
            port = value;
        }
    }
    let addr = f"127.0.0.1:{port}";
    let empty_sessions: Vec<string> = Vec.new();
    let empty_ids: Vec<string> = Vec.new();
    let empty_clients: Vec<LocalPid<ClientHandler>> = Vec.new();
    let empty_sub_topics: Vec<string> = Vec.new();
    let empty_sub_sessions: Vec<string> = Vec.new();
    let empty_sub_qos: Vec<i32> = Vec.new();
    let router = spawn Router(session_ids: empty_sessions, client_ids: empty_ids, clients: empty_clients, sub_topics: empty_sub_topics, sub_session_ids: empty_sub_sessions, sub_qos: empty_sub_qos);
    let listener = spawn Acceptor(router: router, addr: addr);
    listener.start();
    loop {
        sleep(1s);
    }
}
