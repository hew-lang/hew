// F-04 fail-closed guard: a send/ask through a fungible reference to a
// PERMANENTLY-DEAD child fail-closes recoverably (a dropped tell, an Err ask) —
// it never traps the program.
//
// The budget is intensity 1: a sustained crash loop exhausts it, so the child
// ends permanently Dead (BudgetExhausted) and will never restart again. Each
// crash is driven through the SAME held fungible handle (re-resolving to the
// current child to crash it), and the supervisor's terminal decision is reached
// after the in-window restart budget is spent.
//
// Once the child is down, a tell through the handle is dropped (no-op) and an
// ask returns Err(AskError) — both recoverable, NEITHER a SIGTRAP. The `9`
// sentinel proves the tell dropped without trapping AND the ask reached the
// recoverable Err arm. Pre-F-04 the send/ask through the stale handle trapped
// (HEW_TRAP_ACTOR_SEND_FAILED → exit 133).
//
// The sentinel is printed, not returned: this program exhausts a ROOT
// supervisor's restart budget, so the fault reached the top of the supervision
// tree unrecovered and owns the process exit status (HEW-SPEC-2026 §5.8, exit
// 1). The claim under test is "recoverable, not a trap" — distinguishing 1 from
// a SIGTRAP's 133 still carries that, and the printed sentinel carries which
// recoverable arm ran.
actor Worker {
    var value: i64 = 5,
    receive fn tick() {
        value = value + 1;
    }
    receive fn get_value() -> i64 {
        value
    }
    receive fn crash_me() {
        panic("worker crash");
    }
}

supervisor App {
    strategy: one_for_one,
    intensity: 1 within 60s,

    child w1: Worker(value: 5),
}

fn main() -> i64 {
    let sup = spawn App;
    let w = sup.w1;
    // Crash until the child is PERMANENTLY dead, observing the effect rather
    // than assuming a fixed number of sleeps reaches it. A wall-clock loop is
    // load-sensitive: under a busy machine the restarts had not yet exhausted
    // the budget when the asks below ran, and the fixture asserted its sentinel
    // against a LIVE child.
    var attempts: i64 = 0;
    var dead = false;
    while attempts < 30 && !dead {
        let alive = match await w.get_value() {
            .Ok(_) => true,
            .Err(_) => false,
        };
        if alive {
            w.crash_me();
            sleep(120ms);
        } else {
            dead = true;
        }
        attempts = attempts + 1;
    }
    // Make a failed precondition legible: the stdout diff then names the reason
    // instead of only showing a wrong sentinel.
    if !dead {
        println("PRECONDITION_CHILD_STILL_ALIVE");
    }
    sleep(200ms);
    // Tell to a permanently-dead child: dropped recoverably, NOT a trap.
    w.tick();
    // Ask a permanently-dead child: recoverable Err, NOT a trap.
    let sentinel = match await w.get_value() {
        .Ok(_) => 3,
        .Err(_) => 9,
    };
    println(f"DEAD_CHILD:{sentinel}");
    0
}
