import nominal.native;

import nominal.ordinary;

fn use_native() {
    let _handle: native.Handle = native.forward(native.open());
    println("using opaque");
}

fn main() {
    let original: ordinary.Handle = ordinary.make();
    let changed: ordinary.Handle = ordinary.increment(original);
    ordinary.show(original);
    ordinary.show(changed);
    use_native();
    ordinary.show(original);
    println("finished");
}
