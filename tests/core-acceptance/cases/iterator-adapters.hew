// The `std.iter` adapter surface end to end: every combinator drives
// `Iterator.next` through a where-clause bound, so each terminal resolves the
// concrete `next` of the adapter it was handed. Both the free-function and the
// fluent `VecIter` spellings are exercised, over scalars and over records.
import std.iter;

type Line {
    label: string;
    qty: i64;
}

fn first_value() -> i64 {
    11
}

fn second_value() -> i64 {
    22
}

type ReplacingIterator {
    remaining: i64;
    action: fn[clone]() -> i64;
}

impl Iterator for ReplacingIterator {
    type Item = i64;

    fn next(var self) -> Option<i64> {
        if self.remaining <= 0 {
            return .None;
        }
        self.remaining -= 1;
        let value = (self.action)();
        self.action = second_value;
        .Some(value)
    }
}

fn counts() -> Vec<i64> {
    var v: Vec<i64> = Vec.new();
    for i in 1..7 {
        v.push(i);
    }
    v
}

fn lines() -> Vec<Line> {
    var v: Vec<Line> = Vec.new();
    v.push(Line { label: "bolt", qty: 4 });
    v.push(Line { label: "nut", qty: 9 });
    v.push(Line { label: "washer", qty: 2 });
    v
}

fn main() {
    let replaced = iter.collect(ReplacingIterator { remaining: 2, action: first_value });
    assert(replaced == [11, 22]);

    // map + collect: the mapped vector is owned here and released at scope end.
    let doubled = iter.collect(iter.map(counts().into_iter(), |x: i64| x * 2));
    println(doubled.len());
    println(doubled[0]);
    println(doubled[5]);

    // filter + count
    println(iter.count(iter.filter(counts().into_iter(), |x: i64| x % 2 == 0)));

    // take + fold
    println(iter.fold(iter.take(counts().into_iter(), 3), 0, |acc: i64, x: i64| acc + x));

    // enumerate + fold over the (index, item) pairs
    println(iter.fold(iter.enumerate(counts().into_iter()), 0, |acc: i64, pair: (i64, i64)| acc + pair.0 * pair.1));

    // any / find
    println(iter.any(counts().into_iter(), |x: i64| x == 5));
    println(iter.any(counts().into_iter(), |x: i64| x > 99));
    match iter.find(counts().into_iter(), |x: i64| x > 4) {
        .Some(found) => println(found),
        .None => println(-1),
    }
    // The fluent VecIter spelling selects the same implementations.
    println(counts().into_iter().fold(0, |acc: i64, x: i64| acc + x));
    println(iter.count(counts().into_iter().skip(4)));
    println(counts().into_iter().all(|x: i64| x > 0));

    // Records through into_iter: the projection owns its strings.
    let quantities = iter.collect(iter.map(lines().into_iter(), |l: Line| l.qty));
    println(iter.fold(quantities.into_iter(), 0, |acc: i64, x: i64| acc + x));
    let busy = iter.collect(iter.filter(lines().into_iter(), |l: Line| l.qty > 3));
    println(busy.len());
    println(busy[0].label);
    println(busy[1].label);
    let reversed = counts().into_iter().rev().map(|x: i64| x * 2).filter(|x: i64| x > 6).collect();
    assert(reversed == [12, 10, 8]);
    let filtered = counts().into_iter().filter(|x: i64| x % 2 == 0).map(|x: i64| x * 10).rev().collect();
    assert(filtered == [60, 40, 20]);
    let restored = iter.collect(iter.rev(iter.rev(counts().into_iter())));
    assert(restored == counts());
    let labels = lines().into_iter().rev().map(|line: Line| line.label).collect();
    assert(labels == ["washer", "nut", "bolt"]);
    var both = counts().into_iter().filter(|x: i64| x % 2 == 0).map(|x: i64| x * 10);
    assert(both.next_back().expect("filtered back") == 60);
    assert(both.next().expect("filtered front") == 20);
    assert(both.next_back().expect("filtered middle") == 40);
    assert(both.next().is_none());
    var backwards = [1, 2, 3].into_iter().rev();
    assert(backwards.next_back().expect("reverse back") == 1);
    assert(backwards.next().expect("reverse front") == 3);
    assert(backwards.next_back().expect("reverse middle") == 2);
    assert(backwards.next().is_none());
    let observed = iter.collect(iter.rev(iter.map([1, 2, 3].into_iter(), |x: i64| {
        println(f"mapped {x}");
        x
    })));
    assert(observed == [3, 2, 1]);
}
