fn build_or_bail(bail: bool, seed: string) -> string {
    let payload = seed + "-owned-heap-payload";
    if bail {
        return "bailed";
    }
    payload
}

fn decode_or_reject(reject: bool) -> bytes {
    var out: bytes = bytes.new();
    out.push(1);
    out.push(2);
    out.push(3);
    if reject {
        return bytes.new();
    }
    out
}

type Parsed { pre: string, build: string, n: i64, }

fn parse_or_bail(bail: bool, seed: string) -> Parsed {
    let pre = seed + "-pre";
    let build = seed + "-build";
    if bail {
        return Parsed { pre: "", build: "", n: 0 };
    }
    Parsed { pre: pre, build: build, n: 1 }
}

fn main() {
    print(build_or_bail(true, "seed").len());
    print(build_or_bail(false, "seed").len());
    print(decode_or_reject(true).len());
    print(decode_or_reject(false).len());
    print(parse_or_bail(true, "seed").n);
    print(parse_or_bail(false, "seed").n);
    print("OK");
}
