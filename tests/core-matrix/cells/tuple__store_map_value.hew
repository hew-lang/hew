fn main() {
    let x: (i64, string) = (1, "x0");
    let m: HashMap<string, (i64, string)> = HashMap.new();
    m.insert("k", x);
    match m.get("k") {
        Option.Some(e) => {
            let (e_a, e_b) = e;
            println(f"{e_a} {e_b}");
        },
        Option.None => println("missing"),
    }
}
