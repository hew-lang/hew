import std.encoding.utf8;
import std.net.{Listener, Connection};

extern "C" {
    fn hew_tcp_listener_local_port(listener: Listener) -> i32;
}

actor Session {
    let conn: Connection,

    receive fn pump(unused: i64) {
        let data = match conn.recv() {
            .Some(data) => data,
            .None => {
                println("session-received: peer closed");
                return;
            },
        };
        let body = utf8.decode(data) handle error {
            println(f"invalid UTF-8: {error}");
            return;
        };
        println(f"session-received: {body}");
    }
}

fn main() {
    let listener = match net.listen("127.0.0.1:0") {
        .Ok(listener) => listener,
        .Err(_) => panic(f"network setup failed"),
    };
    let port = unsafe {
        hew_tcp_listener_local_port(listener)
    };
    let conn = match net.connect(f"127.0.0.1:{port}") {
        .Ok(conn) => conn,
        .Err(_) => panic(f"network setup failed"),
    };
    let session = spawn Session(conn: conn);
    // `fork` starts the session concurrently: an ordinary call would wait for
    // the handler's read to finish before main accepts and writes.
    fork session.pump(0);
    let client = listener.accept();
    let _ = client.send("hello".to_bytes());
    sleep(300ms);
    let _ = client.close();
    println("server-done");
}
