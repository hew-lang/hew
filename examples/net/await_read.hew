//! TCP read from an actor using the ordinary `conn.read()` call.
//! Migration needed: main waits for the reader before accepting its connection.
//! Start the reader concurrently before accepting and serving the connection.

import std.encoding.utf8;

import std.net;

actor Reader {
    let port: string,
    receive fn go(unused: i64) {

        // Give main a moment to start listening, then connect and read.
        sleep(200ms);
        let conn = match net.connect(f"127.0.0.1:{port}") {
            .Ok(conn) => conn,
            .Err(_) => panic(f"network setup failed"),
        };
        let body = utf8.decode(conn.read()) handle error {
            println(f"invalid UTF-8: {error}");
            return;
        };
        println(f"reader-received: {body}");
        let _ = conn.close();
    }
}

fn main() {
    let listener = match net.listen("127.0.0.1:18077") {
        .Ok(listener) => listener,
        .Err(_) => panic(f"network setup failed"),
    };
    let reader = spawn Reader(port: "18077");
    let _ = reader.go(0);
    let client = listener.accept();
    let _ = client.write_string("hello-from-server");
    sleep(500ms);
    let _ = client.close();
    println("server-done");
}
