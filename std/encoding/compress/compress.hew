//! Compression and decompression (gzip, deflate, zlib).
//!
//! Compress and decompress binary data using gzip, raw deflate, or
//! zlib formats. Each helper takes `bytes` and fails with a
//! `CompressError` carrying the codec's reason.
//! Decompression callers must pass an explicit `max_output_len` to fail
//! closed on oversized payloads; a conservative starting point is
//! `64 * 1024 * 1024`.
//!
//! # Examples
//!
//! ```
//! import std.encoding.compress;
//!
//! fn main() {
//!     var data: bytes = bytes.new();
//!     data.push(72);
//!     data.push(101);
//!     data.push(108);
//!     data.push(108);
//!     data.push(111);
//!     let compressed = compress.gzip_compress(data) handle error {
//!         println(f"operation failed: {error}");
//!         return;
//!     };
//!     let decompressed = compress.gzip_decompress(compressed, 64 * 1024 * 1024) handle error {
//!         println(f"operation failed: {error}");
//!         return;
//!     };
//!     println(decompressed.len());  // 5
//! }
//! ```

/// A codec failure, with the codec's reason.
pub enum CompressError {
    /// Compressing failed.
    Compress(string);
    /// Decompressing failed: corrupt input, or output past `max_output_len`.
    Decompress(string);
}

impl Error for CompressError {}

/// Gzip-compress `data` without panicking.
///
/// Fails with `CompressError.Compress` on codec failure. Empty output alone
/// does not indicate failure.
pub fn gzip_compress(data: bytes) -> bytes fails CompressError {
    let out = unsafe {
        hew_gzip_compress_hew(data)
    };
    let reason = unsafe {
        hew_compress_last_error_hew()
    };
    if reason.len() > 0 {
        return error CompressError.Compress(reason);
    }
    out
}

/// Gzip-decompress `data` without panicking.
pub fn gzip_decompress(data: bytes, max_output_len: i64) -> bytes fails CompressError {
    let out = unsafe {
        hew_gzip_decompress_hew(data, max_output_len)
    };
    let reason = unsafe {
        hew_compress_last_error_hew()
    };
    if reason.len() > 0 {
        return error CompressError.Decompress(reason);
    }
    out
}

/// Deflate-compress `data` (raw DEFLATE) without panicking.
pub fn deflate_compress(data: bytes) -> bytes fails CompressError {
    let out = unsafe {
        hew_deflate_compress_hew(data)
    };
    let reason = unsafe {
        hew_compress_last_error_hew()
    };
    if reason.len() > 0 {
        return error CompressError.Compress(reason);
    }
    out
}

/// Deflate-decompress `data` (raw DEFLATE) without panicking.
pub fn deflate_decompress(data: bytes, max_output_len: i64) -> bytes fails CompressError {
    let out = unsafe {
        hew_deflate_decompress_hew(data, max_output_len)
    };
    let reason = unsafe {
        hew_compress_last_error_hew()
    };
    if reason.len() > 0 {
        return error CompressError.Decompress(reason);
    }
    out
}

/// Zlib-compress `data` without panicking.
pub fn zlib_compress(data: bytes) -> bytes fails CompressError {
    let out = unsafe {
        hew_zlib_compress_hew(data)
    };
    let reason = unsafe {
        hew_compress_last_error_hew()
    };
    if reason.len() > 0 {
        return error CompressError.Compress(reason);
    }
    out
}

/// Zlib-decompress `data` without panicking.
pub fn zlib_decompress(data: bytes, max_output_len: i64) -> bytes fails CompressError {
    let out = unsafe {
        hew_zlib_decompress_hew(data, max_output_len)
    };
    let reason = unsafe {
        hew_compress_last_error_hew()
    };
    if reason.len() > 0 {
        return error CompressError.Decompress(reason);
    }
    out
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    fn hew_gzip_compress_hew(data: bytes) -> bytes;
    fn hew_gzip_decompress_hew(data: bytes, max_output_len: i64) -> bytes;
    fn hew_deflate_compress_hew(data: bytes) -> bytes;
    fn hew_deflate_decompress_hew(data: bytes, max_output_len: i64) -> bytes;
    fn hew_zlib_compress_hew(data: bytes) -> bytes;
    fn hew_zlib_decompress_hew(data: bytes, max_output_len: i64) -> bytes;
    fn hew_compress_last_error_hew() -> string;
}
