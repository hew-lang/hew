// Accept + run: `for item in rx` drains the pipe and closes the read half
// when the loop ends, so the program neither closes the receiver again nor
// leaks it.
import std.stream;

fn main() {
    let (tx, rx) = match stream.pipe(2) {
        .Ok(pair) => pair,
        .Err(_) => return,
    };
    tx.send("first").expect("send");
    tx.send("second").expect("send");
    tx.close();
    var seen = 0;
    for item in rx {
        println(item);
        seen = seen + 1;
    }
    println(f"drained {seen}");
}
