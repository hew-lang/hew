//! TLS client connections.
//!
//! `connect` opens a TCP connection, completes a verified TLS handshake and
//! returns the stream, all within the handshake deadline. Verification is
//! always on: `Trust.Bundled` trusts the Mozilla root programme compiled
//! into Hew (not the operating system's store), `Trust.Pem` trusts only the
//! certificates given.
//!
//! # Examples
//!
//! ```hew,no_run
//! import std.net.tls;
//!
//! fn main() {
//!     let stream = tls.connect("example.com", 443, tls.options()).expect("connect");
//!     let request = "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n";
//!     stream.write(request.to_bytes()).expect("write");
//!     let response = stream.read(4096).expect("read");
//!     println(response.len());
//! }
//! ```

import std.net;

/// Which certificate authorities a connection trusts.
pub enum Trust {
    /// The Mozilla root programme compiled into Hew.
    Bundled;
    /// Only the CA certificates in this PEM document.
    Pem(bytes);
}

/// How `connect` verifies and bounds a connection.
pub type TlsOptions {
    /// The certificate authorities to trust.
    trust: Trust;
    /// Bounds the TCP connect and the handshake together; `0s` is none.
    /// Resolving the host name comes first and is not bounded by it.
    handshake_timeout: duration;
    /// Bounds each read and write after the handshake; `0s` is none.
    io_timeout: duration;
}

/// Bundled roots, a 10 second handshake deadline and no I/O timeout.
pub fn options() -> TlsOptions {
    TlsOptions { trust: Trust.Bundled, handshake_timeout: 10s, io_timeout: 0s }
}

/// An established TLS connection to a remote host.
///
/// Created by `tls.connect(host, port, options)`. Released at scope exit or
/// by `close()`.
#[resource]
#[opaque]
pub type TlsStream {
}

type TlsWriteFfiResult {
    written: i32;
    status: i32;
}

type TlsReadFfiResult {
    data: bytes;
    status: i32;
}

const TLS_STATUS_SUCCESS: i32 = 0;

const TLS_STATUS_RETRYABLE: i32 = 1;

const TLS_STATUS_TLS_ERROR: i32 = 2;

const TLS_STATUS_IO_ERROR: i32 = 3;

fn tls_error_from_status(status: i32) -> net.NetError { // INTERNAL-ABI: TLS FFI bridge reports a small status enum; detail stays in last_error()
    if status == TLS_STATUS_RETRYABLE {
        NetError.TimedOut(0)
    } else {
        NetError.Other(0)
    }
}

fn tls_write_result(raw: TlsWriteFfiResult) -> Result<i64, net.NetError> { // INTERNAL-ABI: bridge helper lifts raw FFI status into Result while leaving detail in last_error()
    if raw.status == TLS_STATUS_SUCCESS {
        .Ok(raw.written as i64)
    } else {
        .Err(tls_error_from_status(raw.status))
    }
}

fn tls_read_result(raw: TlsReadFfiResult) -> Result<bytes, net.NetError> { // INTERNAL-ABI: bridge helper lifts raw FFI status into Result while leaving detail in last_error()
    if raw.status == TLS_STATUS_SUCCESS {
        .Ok(raw.data)
    } else {
        .Err(tls_error_from_status(raw.status))
    }
}

// ── TlsHandler trait (active-mode actor contract) ────────────────────
/// Trait for actors that handle TLS connections in active mode.
///
/// Implement this on an actor and call `stream.attach(actor)` to have the
/// runtime read TLS bytes in a background thread and deliver each chunk as
/// an `on_data` message. The actor never calls `stream.read()` — the runtime
/// owns the read side after attach.
///
/// # Example
///
/// ```
/// import std.net.tls;
///
/// actor TlsEcho {
///     let stream: tls.TlsStream;
///     receive fn on_data(data: bytes) {
///         match stream.write(data) {
///             .Ok(_) => {}
///             .Err(err) => panic(to_string(err)),
///         }
///     }
///     receive fn on_close() {
///         println("tls connection closed");
///     }
/// }
/// ```
pub trait TlsHandler {
    /// Called when a chunk of decrypted bytes arrives from the peer.
    fn on_data(data: bytes);

    /// Called when the connection closes or errors.
    fn on_close();
}

// ── TlsStream methods ────────────────────────────────────────────────
/// Methods available on a `TlsStream`.
trait TlsStreamMethods {
    /// Write raw bytes to the TLS stream.
    ///
    /// Returns the number of bytes written, or `Err(net.NetError)` on failure.
    fn write(self, data: bytes) -> Result<i64, net.NetError>;

    /// Read up to `size` bytes from the TLS stream.
    ///
    /// Returns `Ok(bytes)` on success or orderly EOF, or `Err(net.NetError)` on
    /// retryable/TLS/I-O failures. Use `last_error()` for the precise class.
    ///
    /// Do not call after `attach()` — the runtime owns the read side.
    fn read(self, size: i64) -> Result<bytes, net.NetError>;

    /// Attach this TLS stream to an actor (Erlang-style active mode).
    ///
    /// The runtime reads TLS bytes in a background thread and delivers each
    /// chunk as an `on_data` actor message. When the connection closes or
    /// errors, a single `on_close` message is sent. After attach, calling
    /// `read()` produces undefined behaviour — the runtime owns the read side.
    /// Outbound `write()` remains valid.
    ///
    /// `handler` is the actor that will receive `on_data` and `on_close`.
    /// The compiler synthesises both protocol message IDs from the concrete
    /// actor type behind the handle.
    fn attach(self, handler: TlsHandler);
}

impl TlsStreamMethods for TlsStream {
    fn write(self, data: bytes) -> Result<i64, net.NetError> {
        tls_write_result(unsafe {
            hew_tls_write_result(self, data)
        })
    }
    fn read(self, size: i64) -> bytes fails net.NetError {
        let checked = net.size_arg("tls.TlsStream.read", size)?;
        tls_read_result(unsafe {
            hew_tls_read_result(self, checked as i32) // INTERNAL-ABI: range-checked above
        })?
    }
    /// Compiler-lowered active-mode attach.
    ///
    /// The runtime delivers owned messages using the selected actor handlers.
    #[runtime(family = TlsAttachLocal, symbol = hew_tls_attach_native, lowering = actor_ingress, target = native, classification = "non-declarable-stdlib", receiver = opaque, data = on_data, close = on_close)]
    fn attach(self, handler: TlsHandler) {}
}

impl TlsStream {
    /// Release this TLS stream early. Scope exit performs the same release.
    fn close(consume self) {
        unsafe {
            hew_tls_close(self)
        };
    }
}

const TLS_CONNECT_INVALID_ARGUMENT: i32 = 1;

const TLS_CONNECT_TIMED_OUT: i32 = 2;

const TLS_CONNECT_OS: i32 = 3;

/// Open a verified TLS connection to `host:port`.
///
/// The TCP connect and the handshake complete within
/// `options.handshake_timeout` or the result is `TimedOut`; resolving `host`
/// precedes them and is not bounded by the deadline. A bad trust PEM,
/// host or port is `InvalidArgument`; a certificate the trust does not
/// accept, or a hostname mismatch, is `Other` with the alert in
/// `last_error()`. Each call blocks its worker until it finishes.
pub fn connect(host: string, port: i64, options: TlsOptions) -> TlsStream fails net.NetError {
    let checked = net.port_arg("tls.connect", port)?;
    let handshake_ms = net.duration_ms("tls.connect handshake_timeout", options.handshake_timeout.millis())?;
    let io_ms = net.duration_ms("tls.connect io_timeout", options.io_timeout.millis())?;
    let (trust, pem): (i32, bytes) = match options.trust {
        Trust.Bundled => (0, bytes.new()),
        Trust.Pem(document) => (1, document),
    };
    unsafe {
        let stream = hew_tls_connect(host, checked as i32, trust, pem, handshake_ms, io_ms); // INTERNAL-ABI: port range-checked above
        if hew_tls_is_valid(stream) {
            return stream;
        }
        let failure = hew_tls_connect_failure();
        let errno = hew_tls_connect_errno();
        if failure == TLS_CONNECT_INVALID_ARGUMENT {
            return error NetError.InvalidArgument(hew_tls_last_error());
        } else if failure == TLS_CONNECT_TIMED_OUT {
            return error NetError.TimedOut(errno);
        } else if failure == TLS_CONNECT_OS {
            return error net.net_error_from_errno(errno);
        } else {
            return error NetError.Other(errno);
        }
    }
}

/// Return the last TLS client error observed on this thread.
///
/// A failed `connect()` records its detail here, including the alert of a
/// verification failure. Successful connects clear it.
pub fn last_error() -> string {
    unsafe {
        hew_tls_last_error()
    }
}

/// Write raw bytes to a TLS stream.
///
/// Returns the number of bytes written, or `Err(net.NetError)` on failure.
pub fn write(stream: TlsStream, data: bytes) -> Result<i64, net.NetError> {
    stream.write(data)
}

/// Read up to `size` bytes from a TLS stream.
///
/// Returns `Ok(bytes)` on success or orderly EOF, or `Err(net.NetError)` on
/// retryable/TLS/I-O failures. Call `last_error()` for the precise detail.
pub fn read(stream: TlsStream, size: i64) -> Result<bytes, net.NetError> {
    stream.read(size)
}

/// Close a TLS connection and release resources.
pub fn close(consume stream: TlsStream) {
    unsafe {
        hew_tls_close(stream)
    };
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    fn hew_tls_connect(host: string, port: i32, trust: i32, pem: bytes, handshake_ms: i64, io_ms: i64) -> TlsStream;
    fn hew_tls_is_valid(stream: TlsStream) -> bool;
    fn hew_tls_connect_failure() -> i32;
    fn hew_tls_connect_errno() -> i64;
    fn hew_tls_last_error() -> string;
    fn hew_tls_write_result(stream: TlsStream, data: bytes) -> TlsWriteFfiResult;
    fn hew_tls_read_result(stream: TlsStream, size: i32) -> TlsReadFfiResult;
    fn hew_tls_close(consume stream: TlsStream);
}

// ── Status-code parity tests ──────────────────────────────────────────
// `TLS_STATUS_*` mirrors `hew-std/src/tls.rs`'s `TLS_STATUS_*` constants
// (pinned cross-side in `hew-std/src/tls.rs`'s
// `hew_binding_pins_tls_status_constants` test). These tests exercise the
// Hew-side consumer of those codes, `tls_error_from_status`, which is
// module-private and therefore only reachable from an inline test here.
#[test]
fn tls_error_from_status_retryable_maps_to_timed_out() {
    assert(tls_error_from_status(TLS_STATUS_RETRYABLE) == NetError.TimedOut(0));
}

#[test]
fn tls_error_from_status_success_never_reached_maps_like_other() {
    // TLS_STATUS_SUCCESS is never actually passed to this function in
    // production (callers branch on success before calling it), but the
    // function itself has no dedicated arm for it, so it falls into the
    // same `else` branch as TLS_ERROR/IO_ERROR. Pinned here so a stray
    // caller passing SUCCESS gets the current (non-crashing) behavior.
    assert(tls_error_from_status(TLS_STATUS_SUCCESS) == NetError.Other(0));
}

#[test]
fn tls_error_from_status_tls_error_and_io_error_currently_collapse() {
    // KNOWN SIMPLIFICATION (not a bug): `TLS_STATUS_TLS_ERROR` (2) and
    // `TLS_STATUS_IO_ERROR` (3) both fall through to `NetError::Other(0)`
    // today — there is no dedicated `NetError` variant distinguishing a
    // TLS-protocol failure from a plain I/O failure. This test pins that
    // collapse as current, deliberate behavior; changing the mapping is a
    // separate product decision, not something to do incidentally here.
    let tls_error = tls_error_from_status(TLS_STATUS_TLS_ERROR);
    let io_error = tls_error_from_status(TLS_STATUS_IO_ERROR);
    assert(tls_error == NetError.Other(0));
    assert(io_error == NetError.Other(0));
    assert(tls_error == io_error);
}
