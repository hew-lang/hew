import std.string;

enum Choice<T> {
    Present(T);
    Empty;
}

type EnumHolder<T> {
    item: Choice<T>;
    count: i64;
}

fn replace_many(frames: i64) -> i64 {
    var enums = EnumHolder { item: Choice.Present(("initial").repeat(8)), count: 0 };
    var i = 0;
    while i < frames {
        enums.item = Choice.Present(("replacement").repeat(8));
        i = i + 1;
    }
    enums.count
}

fn untouched() -> i64 {
    let enums = EnumHolder { item: Choice.Present(("untouched").repeat(8)), count: 0 };
    enums.count
}

fn main() {
    println(replace_many(256) + untouched());
}
