// A HashSet tuple projection retains its real receiver type when its
// declared IntoIterator impl constructs the snapshot cursor.
fn make_pair() -> (HashSet<i64>, i64) {
    var s: HashSet<i64> = HashSet.new();
    s.insert(10);
    s.insert(20);
    s.insert(30);
    (s, 7)
}

pub fn main() -> i64 {
    let pair = make_pair();
    var total = 0;
    var count = 0;
    for x in pair.0 {
        total = total + x;
        count = count + 1;
    }
    if count != 3 {
        return 100 + count;
    }
    if pair.0.len() != 3 {
        return 99;
    }
    total
}
