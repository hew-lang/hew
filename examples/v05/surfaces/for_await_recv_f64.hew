//! Status: runnable (ordinary for over Stream<f64>)
//! Description: Drains a float pipe with `for`.
//!
//! `Stream<f64>` rides the element-layout witness: the checker admits any
//! describable element type and the recv path decodes the 8-byte Plain
//! envelope through the shared layout entry point — no per-type runtime symbol.

import std.stream;

actor DrainFloats {
    receive fn run(unused: i64) {
        let (tx, rx): (stream.Sink<f64>, stream.Stream<f64>) = match stream.pipe(4) {
            .Ok(pair) => pair,
            .Err(err) => panic(f"stream.pipe failed: {err}"),
        };
        tx.send(0.5).expect("send");
        tx.send(1.25).expect("send");
        tx.send(-3.75).expect("send");
        tx.close();
        for sample in rx {
            println(sample);
        }
    }
}

fn main() {
    let worker = spawn DrainFloats;
    let _ = worker.run(0);
}
