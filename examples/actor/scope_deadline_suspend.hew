// A scope deadline cancels and drains its child before entering recovery.
// Successful work skips recovery. Both waits suspend the actor so another
// task can run even with HEW_WORKERS=1.
actor Worker {
    var fired: i64 = 0,

    // The scoped child sleeps 500ms; the deadline is 20ms, so the deadline wins
    // and the recovery body runs (fired = 7).
    receive fn timeout_wins() -> i64 {
        scope within 20ms {
            let child = fork nap_long();
            await child;
        } handle failure {
            match failure {
                .Deadline { message } => {
                    fired = 7;
                },
                .Fault { message } => panic(message),
            }
        };
        return fired;
    }

    // The scoped child sleeps 10ms; the deadline is 200ms, so the scope completes
    // first and the body is skipped (fired stays 0).
    receive fn work_wins() -> i64 {
        scope within 200ms {
            let child = fork nap_short();
            await child;
        } handle failure {
            match failure {
                .Deadline { message } => {
                    fired = 7;
                },
                .Fault { message } => panic(message),
            }
        };
        return fired;
    }
}

fn nap_long() {
    sleep(500ms);
}

fn nap_short() {
    sleep(10ms);
}

fn main() {
    let w = spawn Worker(fired: 0);
    // Deadline (20ms) beats the 500ms child: the recovery body runs.
    let t = w.timeout_wins();
    match t {
        .Ok(v) => println(f"timeout={v}"),
        .Err(_) => println("timeout failed"),
    }
    // The 10ms child beats the 200ms deadline: the body is skipped.
    let g = spawn Worker(fired: 0);
    let s = g.work_wins();
    match s {
        .Ok(v) => println(f"work={v}"),
        .Err(_) => println("work failed"),
    }
}
