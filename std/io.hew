//! Standard I/O operations.
//!
//! Read from stdin and write to stdout or stderr.
//!
//! # Examples
//!
//! ```hew,no_run
//! import std.io;
//!
//! fn main() {
//!     io.write("enter your name: ");
//!     let name = io.read_line().unwrap_or("stranger");
//!     io.write("hello, ");
//!     io.write(name);
//!     io.write("\n");
//! }
//! ```

import std.encoding.utf8;

/// Read one line from standard input.
///
/// The call waits without holding a scheduler thread, so other tasks keep
/// running while input is silent. The trailing `\n` or `\r\n` is removed and
/// invalid UTF-8 becomes U+FFFD. Returns `None` at end of input or on a read
/// error; a final line without a newline is still returned first.
///
/// A read that a deadline or an enclosing scope cancels consumes nothing:
/// the next read returns the line that was pending.
pub fn read_line() -> Option<string> {
    var line = unsafe {
        hew_stdin_read_line()
    };
    if line.is_empty() {
        return .None;
    }
    match line.get(line.len() - 1) {
        .Some(10) => {
            let _ = line.pop();
            match line.get(line.len() - 1) {
                .Some(13) => {
                    let _ = line.pop();
                }
                _ => {}
            }
        }
        _ => {}
    }
    .Some(utf8.decode_lossy(line))
}

/// Write a string to standard output without a trailing newline.
pub fn write(s: string) {
    unsafe {
        hew_io_write(s)
    };
}

/// Write a string to standard error without a trailing newline.
pub fn write_err(s: string) {
    unsafe {
        hew_io_write_err(s)
    };
}

/// Read standard input to its end.
///
/// Waits like `read_line`. Invalid UTF-8 becomes U+FFFD.
pub fn read_all() -> string {
    var all = unsafe {
        hew_stdin_read_line()
    };
    var reading = !all.is_empty();
    while reading {
        let more = unsafe {
            hew_stdin_read_line()
        };
        reading = !more.is_empty();
        all.append(more);
    }
    utf8.decode_lossy(all)
}

// ── Declarative bytes receiver FFI ───────────────────────────────────
//
// Decode bytes explicitly with std.encoding.utf8.decode or decode_lossy.
// Every method routes to a dedicated hew_bytes_* runtime entry operating on
// the bytes ABI directly.
impl bytes {
    #[extern_symbol(hew_bytes_push)]
    fn push(self, byte: u8) {}
    /// Remove and return the last byte, or `None` when the buffer is empty.
    #[extern_symbol(hew_bytes_pop)]
    fn pop(self) -> Option<u8> {
        .None
    }
    #[runtime(family = BytesLen, lowering = direct, target = native, classification = stable, c_return = storage, receiver = borrow)]
    #[extern_symbol(hew_bytes_len)]
    fn len(self) -> i64 {
        0
    }
    #[extern_symbol(hew_bytes_get)]
    fn get(self, index: i64) -> Option<u8> {
        .None
    }
    #[extern_symbol(hew_bytes_set)]
    fn set(self, index: i64, byte: u8) {}
    #[runtime(family = BytesIsEmpty, lowering = direct, target = native, classification = stable, c_return = truth_bool, receiver = borrow)]
    #[extern_symbol(hew_bytes_is_empty)]
    fn is_empty(self) -> bool {
        false
    }
    #[extern_symbol(hew_bytes_clear)]
    fn clear(self) {}
    #[runtime(family = BytesContains, lowering = direct, target = native, classification = stable, c_return = truth_bool, receiver = borrow)]
    #[extern_symbol(hew_bytes_contains)]
    fn contains(self, byte: u8) -> bool {
        false
    }
    #[extern_symbol(hew_bytes_append)]
    fn append(self, other: bytes) {}
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    // One line with its newline, or the unterminated last line; empty at
    // end of input. A waiting call: it suspends the task.
    fn hew_stdin_read_line() -> bytes;
    fn hew_io_write(s: string);
    fn hew_io_write_err(s: string);
}
