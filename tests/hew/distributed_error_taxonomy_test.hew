//! Construction and match coverage for distributed error taxonomy enums.

import std.link_monitor.{PartitionPolicy};

fn send_error_id(err: SendError) -> i64 {
    match err {
        SendError.Full => 1,
        SendError.Closed => 2,
        SendError.Partition => 4,
        SendError.StaleRef => 5,
        SendError.LocalShutdown => 6,
        SendError.Cancelled => 7,
        SendError.VersionMismatch => 8,
        SendError.Backpressure => 10,
        SendError.Dead => 11,
        SendError.WriteTimedOut(_) => 12,
    }
}

fn lookup_error_id(err: LookupError) -> i64 {
    match err {
        LookupError.NotFound => 1,
        LookupError.Partition => 2,
        LookupError.StaleRef => 4,
        LookupError.Cancelled => 5,
        LookupError.LocalShutdown => 6,
        LookupError.VersionMismatch => 7,
    }
}

// `AskError` (a flat ~20-variant taxonomy) has been retired in favour of
// Completion outcomes include `Rejected(SendFailure<Req>)`,
// `Failed(E)`, or one of a small set of terminal transport/lifecycle
// variants. `ActorError` bare means `ActorError<Never>`.
fn ask_error_id(err: ActorError) -> i64 {
    match err {
        ActorError.Rejected(_) => 1,
        ActorError.Failed(_) => 2,
        ActorError.Trapped => 3,
        ActorError.Dead => 4,
        ActorError.TimedOut => 5,
        ActorError.NodeNotRunning => 6,
        ActorError.RoutingFailed => 7,
        ActorError.EncodeFailed => 8,
        ActorError.ConnectionDropped => 9,
        ActorError.Partition => 10,
    }
}

fn partition_policy_id(policy: PartitionPolicy) -> i64 {
    match policy {
        PartitionPolicy.FailFast => 1,
        PartitionPolicy.Deadline => 2,
        PartitionPolicy.MonitorLost => 3,
        PartitionPolicy.CrashLinked => 4,
        PartitionPolicy.Quarantine => 5,
    }
}

#[test]
fn test_send_error_taxonomy_variants() {
    assert(send_error_id(SendError.Full) == 1);
    assert(send_error_id(SendError.Closed) == 2);
    assert(send_error_id(SendError.Partition) == 4);
    assert(send_error_id(SendError.StaleRef) == 5);
    assert(send_error_id(SendError.LocalShutdown) == 6);
    assert(send_error_id(SendError.Cancelled) == 7);
    assert(send_error_id(SendError.VersionMismatch) == 8);
    assert(send_error_id(SendError.Backpressure) == 10);
    assert(send_error_id(SendError.Dead) == 11);
    assert(send_error_id(SendError.WriteTimedOut(5)) == 12);
}

#[test]
fn test_lookup_error_taxonomy_variants() {
    assert(lookup_error_id(LookupError.NotFound) == 1);
    assert(lookup_error_id(LookupError.Partition) == 2);
    assert(lookup_error_id(LookupError.StaleRef) == 4);
    assert(lookup_error_id(LookupError.Cancelled) == 5);
    assert(lookup_error_id(LookupError.LocalShutdown) == 6);
    assert(lookup_error_id(LookupError.VersionMismatch) == 7);
}

#[test]
fn test_ask_error_taxonomy_variants() {
    // Rejected owns a sealed request supplied by runtime admission; it cannot
    // be fabricated for this transport-only envelope.
    assert(ask_error_id(ActorError.Trapped) == 3);
    assert(ask_error_id(ActorError.Dead) == 4);
    assert(ask_error_id(ActorError.TimedOut) == 5);
    assert(ask_error_id(ActorError.NodeNotRunning) == 6);
    assert(ask_error_id(ActorError.RoutingFailed) == 7);
    assert(ask_error_id(ActorError.EncodeFailed) == 8);
    assert(ask_error_id(ActorError.ConnectionDropped) == 9);
    assert(ask_error_id(ActorError.Partition) == 10);
}

#[test]
fn test_partition_policy_variants() {
    assert(partition_policy_id(PartitionPolicy.FailFast) == 1);
    assert(partition_policy_id(PartitionPolicy.Deadline) == 2);
    assert(partition_policy_id(PartitionPolicy.MonitorLost) == 3);
    assert(partition_policy_id(PartitionPolicy.CrashLinked) == 4);
    assert(partition_policy_id(PartitionPolicy.Quarantine) == 5);
}
