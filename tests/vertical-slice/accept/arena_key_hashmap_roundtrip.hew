// HashMap::get and HashMap::remove lower through Option<V> payload slots. The
// imported Key type is bare in the map argument and module-qualified in the
// destination; both operations must resolve that pair to one nominal layout.
import std::arena::{ Arena, Key };

fn main() {
    let store: Arena<string> = arena.new();
    let key = store.insert("through-map");
    let keys: HashMap<string, Key<string>> = HashMap::new();
    keys.insert("key", key);

    let cloned = keys.get("key").unwrap();
    println(store.get(cloned).unwrap());

    let removed = keys.remove("key").unwrap();
    println(store.get(removed).unwrap());
}
