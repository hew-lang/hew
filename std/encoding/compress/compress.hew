//! Compression and decompression (gzip, deflate, zlib).
//!
//! Compress and decompress binary data using gzip, raw deflate, or
//! zlib formats. Compression helpers take `bytes` and return
//! `Result<bytes, string>` so codec failures can be handled explicitly.
//! Decompression callers must pass an explicit `max_output_len` to fail
//! closed on oversized payloads; a conservative starting point is
//! `64 * 1024 * 1024`.
//!
//! # Examples
//!
//! ```
//! import std.encoding.compress;
//!
//! fn main() {
//!     var data: bytes = bytes.new();
//!     data.push(72);
//!     data.push(101);
//!     data.push(108);
//!     data.push(108);
//!     data.push(111);
//!     let compressed = compress.gzip_compress(data) handle error {
//!         println(f"operation failed: {error}");
//!         return;
//!     };
//!     let decompressed = compress.gzip_decompress(compressed, 64 * 1024 * 1024) handle error {
//!         println(f"operation failed: {error}");
//!         return;
//!     };
//!     println(decompressed.len());  // 5
//! }
//! ```

/// Gzip-compress `data` without panicking.
///
/// Returns `Err(reason)` on codec failure and `Ok(data)` on success.
/// Empty output alone does not indicate failure.
pub fn gzip_compress(data: bytes) -> Result<bytes, string> {
    let out = unsafe {
        hew_gzip_compress_hew(data)
    };
    let reason = unsafe {
        hew_compress_last_error_hew()
    };
    if reason.len() > 0 {
        Err(reason)
    } else {
        Ok(out)
    }
}

/// Gzip-decompress `data` without panicking.
pub fn gzip_decompress(data: bytes, max_output_len: i64) -> Result<bytes, string> {
    let out = unsafe {
        hew_gzip_decompress_hew(data, max_output_len)
    };
    let reason = unsafe {
        hew_compress_last_error_hew()
    };
    if reason.len() > 0 {
        Err(reason)
    } else {
        Ok(out)
    }
}

