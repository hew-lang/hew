import ambiguity.actor_left.{ ClashActor as LeftActor };
import ambiguity.actor_right.{ ClashActor as RightActor };

fn main() {
    let left = spawn LeftActor();
    let right = spawn RightActor();
    let worker = if true { left } else { right };
    match await worker.ping() {
        Ok(value) => println(value),
        Err(_) => println("ask failed"),
    }
}
