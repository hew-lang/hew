fn test_index_of_f64_found() {
    var v: Vec<f64> = Vec.new();
    v.push(1.5);
    v.push(2.5);
    v.push(3.5);
    let result = vec.index_of_f64(v, 2.5);
    assert(result.is_some());
    assert(result.unwrap_or(-1) == 1);
}

#[test]
fn test_index_of_f64_not_found() {
    var v: Vec<f64> = Vec.new();
    v.push(1.0);
    v.push(2.0);
    assert(vec.index_of_f64(v, 9.9).is_none());
}

#[test]
fn test_index_of_f64_empty() {
    let v: Vec<f64> = Vec.new();
    assert(vec.index_of_f64(v, 0.0).is_none());
}

#[test]
fn test_index_of_f64_returns_first_occurrence() {
    var v: Vec<f64> = Vec.new();
    v.push(7.7);
    v.push(7.7);
    v.push(7.7);
    let result = vec.index_of_f64(v, 7.7);
    assert(result.is_some());
    assert(result.unwrap_or(-1) == 0);
}

// ── index_of_str ──────────────────────────────────────────────────────────
#[test]
fn test_index_of_str_found() {
    var v: Vec<string> = Vec.new();
    v.push("alpha");
    v.push("beta");
    v.push("gamma");
    let result = vec.index_of_str(v, "beta");
    assert(result.is_some());
    assert(result.unwrap_or(-1) == 1);
}

#[test]
fn test_index_of_str_not_found() {
    var v: Vec<string> = Vec.new();
    v.push("foo");
    v.push("bar");
    assert(vec.index_of_str(v, "baz").is_none());
}

#[test]
fn test_index_of_str_empty() {
    let v: Vec<string> = Vec.new();
    assert(vec.index_of_str(v, "x").is_none());
}

#[test]
fn test_index_of_str_returns_first_occurrence() {
    var v: Vec<string> = Vec.new();
    v.push("dup");
    v.push("dup");
    v.push("dup");
    let result = vec.index_of_str(v, "dup");
    assert(result.is_some());
    assert(result.unwrap_or(-1) == 0);
}

// ── first_i64 ─────────────────────────────────────────────────────────────
#[test]
fn test_first_i64_non_empty() {
    var v: Vec<i64> = Vec.new();
    v.push(1000);
    v.push(2000);
    let result = vec.first_i64(v);
    assert(result.is_some());
    assert(result.unwrap_or(-1) == 1000);
}

#[test]
fn test_first_i64_single_element_returns_some() {
    var v: Vec<i64> = Vec.new();
    v.push(55);
    let result = vec.first_i64(v);
    assert(result.is_some());
    assert(result.unwrap_or(-1) == 55);
}

#[test]
fn test_first_i64_empty_returns_none() {
    let v: Vec<i64> = Vec.new();
    assert(vec.first_i64(v).is_none());
}

