//! Generic vector utilities. Empty vectors return `None` for lookups and extrema.

/// Return the index of the first element equal to `value`, or `None`.
pub fn index_of<T: Eq>(values: Vec<T>, value: T) -> Option<i64> {
    for i in 0..values.len() {
        if values[i] == value {
            return .Some(i);
        }
    }
    .None
}

/// Return the first element, or `None` for an empty vector.
pub fn first<T: Clone>(values: Vec<T>) -> Option<T> {
    values.get(0)
}

/// Return the last element, or `None` for an empty vector.
pub fn last<T: Clone>(values: Vec<T>) -> Option<T> {
    values.get(values.len() - 1)
}

/// Return the smallest element, preserving the element type and its ordering.
/// Floating-point comparisons retain their ordinary partial ordering.
pub fn min<T: PartialOrd + Clone>(values: Vec<T>) -> Option<T> {
    if values.is_empty() {
        return .None;
    }
    var best = values[0];
    for i in 1..values.len() {
        if values[i] < best {
            best = values[i];
        }
    }
    .Some(best)
}

/// Return the largest element, preserving the element type and its ordering.
/// Floating-point comparisons retain their ordinary partial ordering.
pub fn max<T: PartialOrd + Clone>(values: Vec<T>) -> Option<T> {
    if values.is_empty() {
        return .None;
    }
    var best = values[0];
    for i in 1..values.len() {
        if values[i] > best {
            best = values[i];
        }
    }
    .Some(best)
}
