// Static trait dispatch through a where-clause bound: `area` and `label` are
// selected per monomorphised instance from the concrete impl, not from the
// trait declaration. The same two impls are reached dynamically through a
// `dyn` value so the static and erased paths can be compared side by side.
trait Shape {
    fn area(self) -> i64;
    fn label(self) -> string;
}

type Square {
    side: i64;
}

impl Shape for Square {
    fn area(self) -> i64 {
        self.side * self.side
    }
    fn label(self) -> string {
        f"square({self.side})"
    }
}

type Rect {
    width: i64;
    height: i64;
}

impl Shape for Rect {
    fn area(self) -> i64 {
        self.width * self.height
    }
    fn label(self) -> string {
        f"rect({self.width}x{self.height})"
    }
}

// One generic body, two instances: the bound selects `Square::area` in one and
// `Rect::area` in the other.
fn report<S>(shape: S) -> string where S: Shape {
    f"{shape.label()} = {shape.area()}"
}

// A third implementation whose receiver owns a heap value, so the bound-driven
// call transfers an owned receiver rather than a bit-copied one.
type Tag {
    text: string;
    weight: i64;
}

impl Shape for Tag {
    fn area(self) -> i64 {
        self.weight
    }
    fn label(self) -> string {
        f"tag({self.text})"
    }
}

// A generic implementation whose parameter list is spelled in the opposite
// order to its self type. Selecting the instance positionally would bind `A`
// and `B` the wrong way round and give the receiver the wrong type.
type Pair<L, R> {
    left: L;
    right: R;
}

impl<A, B> Shape for Pair<B, A> {
    fn area(self) -> i64 {
        7
    }
    fn label(self) -> string {
        "pair"
    }
}

// A second bound-driven body, so the resolution is proven for more than one
// generic caller shape.
fn combined_area<A, B>(first: A, second: B) -> i64 where A: Shape, B: Shape {
    first.area() + second.area()
}

fn main() {
    println(report(Square { side: 4 }));
    println(report(Rect { width: 3, height: 5 }));
    println(combined_area(Square { side: 2 }, Rect { width: 6, height: 7 }));
    println(report(Tag { text: "hinge", weight: 11 }));
    println(report(Pair { left: 3, right: "side" }));

    // Contrast: the same impls reached through vtable dispatch.
    let erased: dyn Shape = Square { side: 9 };
    println(erased.label());
    let other: dyn Shape = Rect { width: 2, height: 8 };
    println(other.area());
}
