// A linked peer really crashes, so Watcher's #[on(exit)] hook must be invoked
// through the sys-dispatch ABI.  The bare CrashNotification spelling exercises
// the canonical std::failure provenance path; stdout is emitted only by the
// hook, so a successful run proves delivery as well as LLVM verification.

import std.failure.{CrashNotification};

actor Crasher {
    receive fn crash() {
        panic("fire linked exit hook");
    }
}

actor Watcher {
    receive fn link_to(peer: LocalPid<Crasher>) -> i64 {
        link(peer);
        1
    }

    #[on(exit)]
    fn on_peer_exit(note: CrashNotification) {
        let _id = note.actor_id;
        println("exit-hook-fired");
    }
}

fn main() -> i64 {
    let crasher = spawn Crasher;
    let watcher = spawn Watcher;
    let linked = await watcher.link_to(crasher);
    match linked {
        Ok(_) => {
            crasher.crash();
            sleep(100ms);
            0
        },
        Err(_) => 2,
    }
}
