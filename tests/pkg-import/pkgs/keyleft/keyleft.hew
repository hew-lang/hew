//! Two-module same-name generic layout oracle, left module.
//!
//! Declares a generic value record `Key<T>` whose sole field `v` is `i64`.
//! The right module (`hew::keyright`) declares a same-named `Key<T>` whose
//! `v` is `string`. Each instantiation must reach codegen under its own
//! module-qualified layout symbol (`hew$keyleft$Key$$i32`), never a shared
//! bare `Key$$i32`; the fixture
//! `two_module_same_generic_valueclass_accept` pins both symbols.

/// Generic value record with an i64 payload field.
pub type Key<T> {
    v: i64;
}

/// Build a `Key<T>` from an i64.
pub fn mk<T>(x: i64) -> Key<T> {
    Key { v: x }
}
