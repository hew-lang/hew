import std.string;

type Pair {
    keep: (string, i64);
    churn: string;
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        let b = Pair { keep: (("k").repeat(32), 1), churn: ("a").repeat(32) };
        let s = Pair { ..b, churn: ("b").repeat(32) };
        total = total + s.churn.len();
        i = i + 1;
    }
    total
}
