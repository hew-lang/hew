//! Status: runnable (ordinary for over Stream<i64>)
//! Description: Drains an integer pipe with `for`.

import std.stream;

actor DrainInts {
    receive fn run(unused: i64) {
        let (tx, rx): (stream.Sink<i64>, stream.Stream<i64>) = match stream.pipe(4) {
            .Ok(pair) => pair,
            .Err(err) => panic(f"stream.pipe failed: {err}"),
        };
        tx.send(1).expect("send");
        tx.send(2).expect("send");
        tx.send(3).expect("send");
        tx.close();
        for item in rx {
            println(item);
        }
    }
}

fn main() {
    let worker = spawn DrainInts;
    let _ = worker.run(0);
}
