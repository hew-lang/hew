import std.testing;

import std.time.datetime;

actor Worker {
    receive fn crash_me() {
        panic("restart the child");
    }
}

supervisor App {
    strategy: one_for_one;
    intensity: 20 within 60s;
    child worker: Worker;
}

fn main() {
    let app = spawn App;
    let started = datetime.now_ms();
    let _ = app.worker.crash_me();
    let _ = {
        let __hew_migrated_role_362 = app.worker;
        restarted(__hew_migrated_role_362);
        __hew_migrated_role_362
    };
    let _ = app.worker.crash_me();
    testing.settle();
    stop(app);
    stopped(app);
    println(datetime.now_ms() - started < 200);
}
