# syntax=docker/dockerfile:1
# Hew compiler image, assembled from an extracted Linux release archive.
#
# The image carries the same binaries, libhew.a and std/ as the published
# hew-v<version>-linux-<arch>.tar.gz; nothing is compiled here. Files go to the
# FHS layout the .deb/.rpm packages use (share/hew/std beside bin/).
#
# Targets (always pass --target; the last stage is the test image):
#   runtime          the published ghcr.io/hew-lang/hew image
#   clean-room-test  runtime plus the installation test, run in CI before the
#                    runtime image may be published
#
# Usage:
#   docker run --rm -v "$PWD:/work" ghcr.io/hew-lang/hew run main.hew
#
# Build (from the repository root, after extracting a release archive into
# dist/test-tarball, for example with installers/docker/assemble-test-tarball.sh):
#   docker buildx build -f installers/docker/Dockerfile.release --target runtime \
#     --build-context tarball=dist/test-tarball \
#     --build-arg VERSION=0.6.0 -t hew:local .

FROM ubuntu:24.04 AS runtime

ARG VERSION=0.0.0
ARG REVISION=unknown

# gcc + libc-dev: hew invokes the system C compiler to link compiled objects.
# The runtime and standard library are in libhew.a; no Rust is needed.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=tarball bin/hew bin/hew-lsp bin/hew-observe /usr/local/bin/
COPY --from=tarball lib/libhew.a /usr/local/lib/libhew.a
COPY --from=tarball std/ /usr/local/share/hew/std/

# ubuntu:24.04 ships uid 1000 as `ubuntu`; replace it with an unprivileged hew.
RUN userdel -r ubuntu && useradd -m -u 1000 -U hew

USER hew
WORKDIR /work

LABEL org.opencontainers.image.title="Hew" \
      org.opencontainers.image.description="Statically-typed, actor-oriented programming language" \
      org.opencontainers.image.url="https://hew.sh" \
      org.opencontainers.image.source="https://github.com/hew-lang/hew" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

ENTRYPOINT ["/usr/local/bin/hew"]
CMD ["--help"]

FROM runtime AS clean-room-test

USER root
WORKDIR /work
COPY installers/docker/test-stdlib.hew /work/test.hew
COPY scripts/lib/timeout.sh /work/scripts/lib/timeout.sh
COPY installers/docker/test-install.sh /work/installers/docker/test-install.sh
RUN chmod +x /work/installers/docker/test-install.sh

ENTRYPOINT []
CMD ["/bin/bash", "/work/installers/docker/test-install.sh"]
