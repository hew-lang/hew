enum Payload {
    Text(string),
    Number(i64),
    Empty,
}
type Outer { payload: Payload, sibling: string }
type Holder { held: Payload }

fn make_outer(k: i64) -> Outer {
    Outer {
        payload: Payload.Text("enum-heap-payload".to_upper()),
        sibling: "enum-sibling-payload".to_upper(),
    }
}

fn deep(k: i64) -> Holder {
    let o = make_outer(k);
    let payload = o.payload;
    Holder { held: payload }
}

fn run_cycle(k: i64) -> i64 {
    let h = deep(k);
    k + 1
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        total = total + run_cycle(i);
        i = i + 1;
    }
    if total > 0 { 0 } else { 1 }
}
