actor Worker {
    var value: i64;
    receive fn get_value() -> i64 {
        value
    }
    receive fn crash_me() {
        panic("worker failed");
    }
}

supervisor App {
    strategy: one_for_one;
    intensity: 3 within 60s;
    child w1: Worker(value: 7);
}

fn main() {
    let app = spawn App;
    let w = app.w1;
    match w.get_value() {
        .Ok(value) => println(value),
        .Err(_) => println("read failed"),
    }
    let _ = w.crash_me();
    // Discard the handle the barrier re-fetches: the read below goes through a
    // fresh supervisor slot lookup, which must find the replacement Live.
    let _ = {
        let __hew_migrated_role_631 = app.w1;
        restarted(__hew_migrated_role_631);
        __hew_migrated_role_631
    };
    let fresh = app.w1;
    match fresh.get_value() {
        .Ok(value) => println(value),
        .Err(_) => println("read failed"),
    }
    {
        let __hew_migrated_actor_798 = app;
        stop(__hew_migrated_actor_798);
        stopped(__hew_migrated_actor_798);
    };
    println("stopped");
}
