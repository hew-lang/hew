//! Standard I/O operations.
//!
//! Read from stdin and write to stdout or stderr.
//!
//! # Examples
//!
//! ```hew,no_run
//! import std.io;
//!
//! fn main() fails io.IoError {
//!     io.write("enter your name: ")?;
//!     let name = io.read_line()? ?? "stranger";
//!     io.write("hello, ")?;
//!     io.write(name)?;
//!     io.write("\n")?;
//! }
//! ```

import std.encoding.utf8;

import std.stream;

/// A standard input or output operation failed.
pub enum IoError {
    Read(string);
    Write(string);
}

impl Display for IoError {
    fn fmt(self) -> string {
        match self {
            .Read(message) => f"Read: {message}",
            .Write(message) => f"Write: {message}",
        }
    }
}

impl Error for IoError {}

/// Read one line from standard input.
///
/// The call waits without holding a scheduler thread, so other tasks keep
/// running while input is silent. The trailing `\n` or `\r\n` is removed and
/// invalid UTF-8 becomes U+FFFD. Returns `None` at end of input; a final line
/// without a newline is still returned first. Read failures return `IoError.Read`.
///
/// Concurrent reads take lines in the order they started, each line going to
/// exactly one of them. A read that a deadline or an enclosing scope cancels
/// consumes nothing: the next read returns the line that was pending.
pub fn read_line() -> Option<string> fails IoError {
    var line = next_line()?;
    if line.is_empty() {
        return .None;
    }
    match line.get(line.len() - 1) {
        .Some(10) => {
            let _ = line.pop();
            match line.get(line.len() - 1) {
                .Some(13) => {
                    let _ = line.pop();
                }
                _ => {}
            }
        }
        _ => {}
    }
    .Some(utf8.decode_lossy(line))
}

/// Write a string to standard output without a trailing newline.
pub fn write(s: string) fails IoError {
    let status = unsafe {
        hew_io_write(s)
    };
    if status != 0 {
        return error IoError.Write(unsafe {
            hew_stream_last_error()
        });
    }
}

/// Write a string to standard error without a trailing newline.
pub fn write_err(s: string) fails IoError {
    let status = unsafe {
        hew_io_write_err(s)
    };
    if status != 0 {
        return error IoError.Write(unsafe {
            hew_stream_last_error()
        });
    }
}

/// Read standard input to its end.
///
/// Waits like `read_line`, and returns `IoError.Read` on failure. Invalid UTF-8 becomes
/// U+FFFD.
pub fn read_all() -> string fails IoError {
    var all = next_line()?;
    var reading = !all.is_empty();
    while reading {
        let more = next_line()?;
        reading = !more.is_empty();
        all.append(more);
    }
    utf8.decode_lossy(all)
}

/// One raw line with its newline; empty only at end of input. A failed read
/// leaves its message in the stream error slot, which a success clears.
fn next_line() -> bytes fails IoError {
    let line = unsafe {
        hew_stdin_read_line()
    };
    if line.is_empty() {
        let failure = unsafe {
            hew_stream_last_error()
        };
        if failure != "" {
            return error IoError.Read(failure);
        }
    }
    line
}

/// Why a descriptor readiness watch could not be opened.
pub enum WatchError {
    /// The number is not an open descriptor.
    NotOpen;
    /// The descriptor type, access mode or platform does not support this watch.
    Unsupported;
    /// The operating system could not create the watch.
    System(string);
}

impl Display for WatchError {
    fn fmt(self) -> string {
        match self {
            WatchError.NotOpen => "NotOpen: the number is not an open descriptor",
            WatchError.Unsupported => "Unsupported: this descriptor or direction cannot be watched",
            WatchError.System(detail) => detail,
        }
    }
}

impl Error for WatchError {}

/// Watch a descriptor the program opened through FFI, such as a serial
/// device, a socket or a pipe, for readability.
///
/// Each receive waits, without holding a scheduler thread, until a read on
/// `fd` would not wait (data, end of input or an error is pending) and yields
/// `()`; it reads nothing, so the program then reads the descriptor itself.
/// Readiness is level-triggered: a receive returns at once while unread data
/// remains, and `try_recv` yields `()` exactly when a receive would not wait.
/// The stream is a `select` source and never ends on its own. Keep `fd` open
/// until this call returns. The watch then owns a close-on-exec duplicate,
/// so you can close the stream and `fd` independently. Several watches on
/// one descriptor, including standard input alongside `read_line`, can
/// coexist. Unix only.
pub fn watch_readable(fd: i32) -> Result<stream.Stream<()>, WatchError> {
    watch_stream(unsafe {
        hew_io_watch_readable(fd)
    })
}

/// Wait for a foreign descriptor to accept a write without blocking. Each
/// receive yields `()` without writing anything. A closed peer or another
/// terminal condition also wakes the watch; the next write reports its outcome.
/// Keep the original open until construction returns. The watch then owns
/// a separate close-on-exec duplicate. Use a nonblocking descriptor and retry
/// the write after readiness if another writer can use the available space.
pub fn watch_writable(fd: i32) -> Result<stream.Stream<()>, WatchError> {
    watch_stream(unsafe {
        hew_io_watch_writable(fd)
    })
}

fn watch_stream(consume pair: stream.StreamPair) -> Result<stream.Stream<()>, WatchError> {
    unsafe {
        if !hew_stream_pair_is_valid(pair) {
            let kind = hew_stream_last_error_kind();
            let detail = hew_stream_last_error();
            return match kind {
                1 => .Err(WatchError.NotOpen),
                6 => .Err(WatchError.Unsupported),
                _ => .Err(WatchError.System(detail)),
            };
        }
        let ready: stream.Stream<()> = stream.pair_stream(pair);
        pair.close();
        .Ok(ready)
    }
}

// ── Declarative bytes receiver FFI ───────────────────────────────────
//
// Decode bytes explicitly with std.encoding.utf8.decode or decode_lossy.
// Every method routes to a dedicated hew_bytes_* runtime entry operating on
// the bytes ABI directly.
impl bytes {
    #[extern_symbol(hew_bytes_push)]
    pub fn push(self, byte: u8) {}
    /// Remove and return the last byte, or `None` when the buffer is empty.
    #[extern_symbol(hew_bytes_pop)]
    pub fn pop(self) -> Option<u8> {
        .None
    }
    #[runtime(authority = Value, family = BytesLen, lowering = direct, target = native, classification = stable, c_return = storage, receiver = borrow)]
    #[extern_symbol(hew_bytes_len)]
    pub fn len(self) -> i64 {
        0
    }
    #[extern_symbol(hew_bytes_get)]
    pub fn get(self, index: i64) -> Option<u8> {
        .None
    }
    #[extern_symbol(hew_bytes_set)]
    pub fn set(self, index: i64, byte: u8) {}
    #[runtime(authority = Value, family = BytesIsEmpty, lowering = direct, target = native, classification = stable, c_return = truth_bool, receiver = borrow)]
    #[extern_symbol(hew_bytes_is_empty)]
    pub fn is_empty(self) -> bool {
        false
    }
    #[extern_symbol(hew_bytes_clear)]
    pub fn clear(self) {}
    #[runtime(authority = Value, family = BytesContains, lowering = direct, target = native, classification = stable, c_return = truth_bool, receiver = borrow)]
    #[extern_symbol(hew_bytes_contains)]
    pub fn contains(self, byte: u8) -> bool {
        false
    }
    #[extern_symbol(hew_bytes_append)]
    pub fn append(self, other: bytes) {}
    /// Whether the buffer begins with the run `prefix`.
    #[runtime(authority = Value, family = BytesStartsWith, lowering = direct, target = native, classification = stable, c_return = truth_bool, receiver = borrow)]
    #[extern_symbol(hew_bytes_starts_with)]
    pub fn starts_with(self, prefix: bytes) -> bool {
        false
    }
    /// Whether the buffer ends with the run `suffix`.
    #[runtime(authority = Value, family = BytesEndsWith, lowering = direct, target = native, classification = stable, c_return = truth_bool, receiver = borrow)]
    #[extern_symbol(hew_bytes_ends_with)]
    pub fn ends_with(self, suffix: bytes) -> bool {
        false
    }
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    // One line with its newline, or the unterminated last line; empty at
    // end of input. A waiting call: it suspends the task.
    fn hew_stdin_read_line() -> bytes;
    fn hew_stream_last_error() -> string;
    #[offload]
    fn hew_io_write(s: string) -> i32;
    #[offload]
    fn hew_io_write_err(s: string) -> i32;
    fn hew_stream_last_error_kind() -> i32;
    fn hew_io_watch_writable(fd: i32) -> stream.StreamPair;
    fn hew_io_watch_readable(fd: i32) -> stream.StreamPair;
    fn hew_stream_pair_is_valid(pair: stream.StreamPair) -> bool;
}
