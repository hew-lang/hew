// Priority Queue - using sorted insertion into Vec<i64>
// Smallest element is at the end (easy to pop)
// Insert maintains descending order so extract_min is O(1) pop
//
// A parameter is the callee's own copy, so insert and extract hand the queue
// back and the caller reassigns; extract also reports the value it removed.
fn pq_insert(var pq: Vec<i64>, val: i64) -> Vec<i64> {
    // Insert val maintaining descending order (largest first, smallest last)
    pq.push(val);
    var i = pq.len() - 1;
    var done = 0;
    while i > 0 {
        if done == 0 {
            let prev = pq[i - 1];
            if prev < val {
                pq.set(i, prev);
                i = i - 1;
            } else {
                pq.set(i, val);
                done = 1;
            }
        } else {
            i = 0;
        }
    }
    if done == 0 {
        pq.set(0, val);
    }
    pq
}

// Insert every value in order.
fn pq_insert_all(var pq: Vec<i64>, values: Vec<i64>) -> Vec<i64> {
    for value in values {
        pq = pq_insert(pq, value);
    }
    pq
}

fn pq_extract_min(var pq: Vec<i64>) -> (Vec<i64>, i64) {
    let val = pq.pop();
    (pq, val)
}

fn pq_peek_min(pq: Vec<i64>) -> i64 {
    pq[pq.len() - 1]
}

fn pq_size(pq: Vec<i64>) -> i64 {
    pq.len()
}

fn pq_is_empty(pq: Vec<i64>) -> i64 {
    if pq_size(pq) == 0 {
        1
    } else {
        0
    }
}

fn run_test(name: string, passed: i64) -> i64 {
    if passed == 1 {
        println(f"PASS: {name}");
    } else {
        println(f"FAIL: {name}");
    }
    passed
}

fn main() {
    var total = 0;
    var passed = 0;
    var pq: Vec<i64> = Vec.new();
    // Test 1: empty
    total = total + 1;
    let r1 = if pq_is_empty(pq) == 1 {
        1
    } else {
        0
    };
    passed = passed + run_test("new pq is empty", r1);

    // Test 2: insert and peek min
    total = total + 1;
    let first: Vec<i64> = [30, 10, 20];
    pq = pq_insert_all(pq, first);
    let r2 = if pq_peek_min(pq) == 10 {
        1
    } else {
        0
    };
    passed = passed + run_test("peek min after insert", r2);

    // Test 3: extract min returns smallest
    total = total + 1;
    let (after_m1, m1) = pq_extract_min(pq);
    pq = after_m1;
    let r3 = if m1 == 10 {
        1
    } else {
        0
    };
    passed = passed + run_test("extract_min returns 10", r3);

    // Test 4: next min is 20
    total = total + 1;
    let (after_m2, m2) = pq_extract_min(pq);
    pq = after_m2;
    let r4 = if m2 == 20 {
        1
    } else {
        0
    };
    passed = passed + run_test("next extract_min is 20", r4);

    // Test 5: last is 30
    total = total + 1;
    let (after_m3, m3) = pq_extract_min(pq);
    pq = after_m3;
    let r5 = if m3 == 30 {
        1
    } else {
        0
    };
    passed = passed + run_test("last extract_min is 30", r5);

    // Test 6: insert duplicates
    total = total + 1;
    let dups: Vec<i64> = [5, 5, 3];
    pq = pq_insert_all(pq, dups);
    let (after_d1, d1) = pq_extract_min(pq);
    let (after_d2, d2) = pq_extract_min(after_d1);
    let (after_d3, d3) = pq_extract_min(after_d2);
    pq = after_d3;
    var r6 = 0;
    if d1 == 3 {
        if d2 == 5 {
            if d3 == 5 {
                r6 = 1;
            }
        }
    }
    passed = passed + run_test("duplicates handled", r6);

    // Test 7: ascending insert order
    total = total + 1;
    var pq2: Vec<i64> = Vec.new();
    let ascending: Vec<i64> = [1, 2, 3, 4, 5];
    pq2 = pq_insert_all(pq2, ascending);
    var r7 = 1;
    var prev_val = 0;
    for i in 0 .. 5 {
        let (drained, v) = pq_extract_min(pq2);
        pq2 = drained;
        if v < prev_val {
            r7 = 0;
        }
        prev_val = v;
    }
    passed = passed + run_test("ascending insert order", r7);

    // Test 8: descending insert order
    total = total + 1;
    var pq3: Vec<i64> = Vec.new();
    let descending: Vec<i64> = [50, 40, 30, 20, 10];
    pq3 = pq_insert_all(pq3, descending);
    let (after_e1, e1) = pq_extract_min(pq3);
    let (after_e2, e2) = pq_extract_min(after_e1);
    pq3 = after_e2;
    var r8 = 0;
    if e1 == 10 {
        if e2 == 20 {
            r8 = 1;
        }
    }
    passed = passed + run_test("descending insert order", r8);

    // Summary
    println(f"{passed}/{total} tests passed");
    if passed == total {
        println("ALL PASS");
    } else {
        println("SOME FAILED");
    }
}
