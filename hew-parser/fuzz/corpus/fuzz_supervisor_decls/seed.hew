actor SeedChild {
    receive fn ping(n: i64) -> i64 {
        n
    }
}

supervisor SeedSupervisor {
    strategy: one_for_one;
    intensity: 3 within 60s;
    child worker: SeedChild() restart: temporary;
}

fn background_task() {}

fn seed_scope_fork() {
    scope {
        let child_task = fork background_task();
    };
}
