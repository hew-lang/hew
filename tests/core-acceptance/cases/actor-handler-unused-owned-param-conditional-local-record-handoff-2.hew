type Wrap { name: string }
actor Fan {
    var seen: i64,
    var held: Wrap,
    receive fn route(label: string, store: bool) {
        let next = Wrap { name: label };
        if store { held = next; }
        else { seen = seen + next.name.len(); }
    }
    receive fn total() -> i64 { seen + held.name.len() }
}
fn main() -> i64 {
    let fan = spawn Fan(seen: 0, held: Wrap { name: "seed" });
    var i: i64 = 0;
    while i < 50 {
        let _ = fan.route("discard".to_upper(), false);
        i = i + 1;
    }
    match fan.total() { .Ok(n) => if n == 354 { 0 } else { 99 }, .Err(_) => 100 }
}
