// Accept fixture: a sub-trait impl composes with its super-trait's own impl.
// `trait Sub: Super` obliges `W` to implement `Super` where `Super` is declared,
// so `base` lives in `impl Super for W` and `tag` in `impl Sub for W`. Both must
// dispatch through the sub-trait's method call, so a method-set check that
// scoped the known set to the sub-trait alone, or lost the super edge, shows up
// here. Run e2e so both methods are exercised through dispatch.
trait Super {
    fn base(val: Self) -> i64;
}

trait Sub: Super {
    fn tag(val: Self) -> i64;
}

type W {
    id: i64,
}

impl Super for W {
    fn base(w: W) -> i64 {
        w.id
    }
}

impl Sub for W {
    fn tag(w: W) -> i64 {
        w.base() + 100
    }
}

fn main() {
    let w = W { id: 5 };
    println(f"tag {w.tag()}");
}
