//! Generic MPSC (multi-producer, single-consumer) channels.
//!
//! Bounded channels for passing typed messages between producers and a
//! single consumer. `Sender<T>` is cloneable for multi-producer use;
//! `Receiver<T>` drains the channel. Calls wait directly; use `fork` to run
//! work concurrently and `await` only on the resulting task.
//!
//! Both `recv()` and `try_recv()` return `Option<T>`, where `None`
//! indicates the channel is closed (all senders dropped) or empty
//! (for `try_recv` only).
//!
//! ## Receiving
//!
//! - `rx.recv()` SUSPENDS the calling coroutine worker-free when the channel
//!   is empty with live senders, and resumes when a sender deposits a value or
//!   the last sender closes (`None`). Every calling context is a resumable
//!   frame, `main` included.
//! - `rx.try_recv()` never suspends: it returns `Some(value)` if an item is
//!   immediately available, and `None` when the channel is empty or closed.
//! - A `select` arm spelled `v from rx.recv()` observes readiness without
//!   taking an element; only the winning arm receives, and a losing arm leaves
//!   the receiver untouched.
//! - Draining with `for item in rx` consumes the receiver: it closes the read
//!   half when the loop ends, so do not close it again.
//!
//! Supported element types: primitives (`i64`, `f64`, `bool`, `char`, ...),
//! `string`, `bytes`, value records/enums/tuples, and monomorphic machine
//! values (state snapshots — generic machine instantiations are refused).
//! Container elements (`Vec<T>`, `HashMap<K, V>`) and handle types are not
//! supported yet.
//!
//! # Examples
//!
//! ```
//! import std.channel.channel;
//!
//! fn main() {
//!     let (tx, rx) = match channel.new(8) { .Ok(pair) => pair, .Err(error) => panic(error), };
//!     tx.send("hello");
//!     tx.close();
//!
//!     match rx.recv() {
//!         .Some(msg) => println(msg),  // hello
//!         .None => println("closed"),
//!     }
//!     rx.close();
//! }
//! ```

/// An opaque sender handle.
///
/// Created by `channel.new(capacity)`. Can be cloned for multi-producer
/// use. Scope exit releases the handle; `close()` releases it early.
///
/// The element type is shared with the paired receiver; the runtime handle
/// itself uses a type-erased pointer.
#[opaque]
pub type Sender<T> {
}

/// An opaque receiver handle.
///
/// Created by `channel.new(capacity)`. Scope exit releases the handle;
/// `close()` releases it early.
///
/// The element type is shared with the paired sender; the runtime handle
/// itself uses a type-erased pointer.
#[opaque]
pub type Receiver<T> {
}

// ── Module-level functions ───────────────────────────────────────────
/// Create a bounded MPSC channel with the given capacity.
///
/// Returns `Err` when the capacity is invalid instead of returning null-backed
/// sender and receiver handles.
pub fn new<T>(capacity: i64) -> Result<(Sender<T>, Receiver<T>), string> {
    if capacity < 0 {
        return Err(f"channel.new: invalid capacity {capacity} (must be >= 0)");
    }
    unsafe {
        let pair = hew_channel_new(capacity as i64); // INTERNAL-ABI: runtime ABI takes i64 capacity
        if !hew_channel_pair_is_valid(pair) {
            let detail = hew_stream_last_error();
            if detail == "" {
                return Err("channel.new: channel allocation failed");
            }
            return Err(detail);
        }
        let tx = pair_sender(pair);
        let rx = pair_receiver(pair);
        hew_channel_pair_free(pair);
        Ok((tx, rx))
    }
}

// ── FFI bindings ─────────────────────────────────────────────────────
/// Internal paired channel handle.
#[resource]
#[opaque]
pub type ChannelPair {
}

impl ChannelPair {
    fn close(consume self) {
        unsafe {
            hew_channel_pair_free(self)
        };
    }
}

extern "C" {
    fn hew_channel_new(capacity: i64) -> ChannelPair;
    fn hew_channel_pair_is_valid(pair: ChannelPair) -> bool;
    fn hew_channel_pair_free(consume pair: ChannelPair);
    fn hew_stream_last_error() -> string;
    // hew_channel_send_layout, hew_channel_recv_layout, and
    // hew_channel_try_recv_layout use an out-parameter + element-layout
    // witness ABI and are declared by codegen with the correct calling
    // convention.
}

#[intrinsic("channel.pair_sender")]
fn pair_sender<T>(pair: ChannelPair) -> Sender<T> {}

#[intrinsic("channel.pair_receiver")]
fn pair_receiver<T>(pair: ChannelPair) -> Receiver<T> {}
