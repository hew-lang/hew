machine Chain {
    events {
        Start;
        Ignored;
    }
    emits {
        Trace { value: string; }
    }
    state Off;
    state Active {
        exit {
            emit Trace { value: "parent exit" };
        }
        initial state A;
        state B;
        final state Ready {
            entry {
                emit Trace { value: "final entry" };
            }
            exit {
                emit Trace { value: "final exit" };
            }
        }
    }
    state Finished;
    on Start: Off => Active {
        emit Trace { value: "start" };
        Active
    }
    always: A => B {
        emit Trace { value: "a" };
        B
    }
    always: B => Ready {
        emit Trace { value: "b" };
        Ready
    }
    on completion: Active => Finished {
        emit Trace { value: "complete" };
        Finished
    }
    default { state }
}

machine Parallel {
    events {
        Finish;
    }
    parallel state Work {
        region left {
            state Inner {
                initial state L0;
                final state InnerDone;
            }
            final state LeftDone;
            initial Inner;
        }
        region right {
            initial state R0;
            final state RightDone;
        }
    }
    state Done;
    state Wrong;
    on Finish: L0 => InnerDone;
    on Finish: R0 => RightDone;
    on completion: Inner => LeftDone;
    on completion: Work => Done;
    always: Work => Wrong when 1 / 0 == 0;
    default { state }
}

machine HistoryComplete {
    events {
        Start;
        Resume;
    }
    emits {
        Entered { text: string; }
    }
    state Outside;
    state Work {
        state Working { text: string; }
        final state Ready {
            text: string;
            entry {
                emit Entered { text: state.text };
            }
            exit {
                state.text = state.text + ":exit";
            }
        }
        initial Working { text: "fresh".to_upper() };
    }
    on Start: Outside => Work;
    on Resume: Outside => Work history;
    always: Working => Ready { text: state.text }
    on completion: Work => Outside;
    default { state }
}

machine Cycle {
    events {
        Tick;
    }
    state A { text: string; }
    state B { text: string; }
    always: A => B { text: state.text + "b" }
    always: B => A { text: state.text + "a" }
    default { state }
}

fn main() {
    var chain: Chain = .Off;
    let before = chain;
    assert(chain.step(.Start, limit: 3) == .Err(.LimitExceeded));
    assert(chain == before);
    let report = chain.step(.Start, limit: 4).expect("stabilization fits the limit");
    assert(chain == .Finished);
    assert(report.rules == [0, 1, 2, 3]);
    assert(report.input == "Start");
    assert(report.outputs == [.Trace { value: "start" }, .Trace { value: "a" }, .Trace { value: "b" }, .Trace { value: "final entry" }, .Trace { value: "final exit" }, .Trace { value: "parent exit" }, .Trace { value: "complete" }]);
    var ignored: Chain = .A;
    let stable = ignored.step(.Ignored, limit: 3).expect("stabilization fits the limit");
    assert(ignored == .Finished && stable.rules == [1, 2, 3]);
    assert(stable.disposition == .Taken && stable.input == "Ignored");
    let no_change = ignored.step(.Ignored, limit: 1).expect("stabilization fits the limit");
    assert(no_change.disposition == .Ignored && no_change.rules.is_empty());
    var ordinary: Chain = .Off;
    let default_report = ordinary.step(.Start).expect("machine step failed");
    assert(ordinary == chain && default_report == report);
    var parallel: Parallel = .Work { left: .L0, right: .R0 };
    let pair_before = parallel;
    assert(parallel.step(.Finish, limit: 2) == .Err(.LimitExceeded));
    assert(parallel == pair_before);
    let pair = parallel.step(.Finish, limit: 3).expect("stabilization fits the limit");
    assert(pair.rules == [0, 1, 2, 3] && parallel == .Done);
    var history: HistoryComplete = .Outside;
    let initial = history.step(.Start).expect("machine step failed");
    assert(initial.rules == [0, 2, 3]);
    assert(initial.outputs == [.Entered { text: "FRESH" }]);
    let saved = history;
    assert(history.step(.Resume, limit: 1) == .Err(.LimitExceeded));
    assert(history == saved);
    let restored = history.step(.Resume, limit: 2).expect("stabilization fits the limit");
    assert(restored.rules == [1, 3]);
    assert(restored.outputs == [.Entered { text: "FRESH:exit" }]);
    var cycle: Cycle = .A { text: "original".to_upper() };
    let original = cycle;
    assert(cycle.step(.Tick, limit: 0) == .Err(.InvalidLimit));
    assert(cycle.step(.Tick, limit: -1) == .Err(.InvalidLimit));
    assert(cycle.step(.Tick, limit: 7) == .Err(.LimitExceeded));
    assert(cycle == original);
    println("internal reactions and bounded rollback passed");
}
