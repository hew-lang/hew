import std.stream;

fn open() -> Stream<string> {
    match stream.open("resource-read.bin") {
        .Ok(input) => input.lines(),
        .Err(_) => panic("fixture open failed"),
    }
}

gen fn held() -> string {
    let input = open();
    defer { input.close(); println("closed"); }
    let value = "resource".to_upper();
    yield value;
    yield "later";
}

fn main() {
    for index in 0..3 {
        for value in held() {
            println(value);
            break;
        }
        println(index);
    }
    println("released");
}
