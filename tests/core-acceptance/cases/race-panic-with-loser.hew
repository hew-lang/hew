// A trapping operand is not a completion: the trap propagates to the
// enclosing context and the other operand is cancelled and drained first.
import std.stream;

fn boom(parked: stream.Stream<i64>) -> i64 {
    parked.recv();
    panic("boom");
}
fn slow(parked: stream.Sink<i64>, gate: stream.Stream<i64>) -> i64 {
    defer println("slow cleanup");
    parked.send(1).expect("parked");
    gate.recv();
    println("unreachable");
    1
}
fn main() {
    let (_hold, gate): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("gate");
    let (parked_tx, parked): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("parked");
    race { boom(parked), slow(parked_tx, gate) };
    println("unreachable");
}
