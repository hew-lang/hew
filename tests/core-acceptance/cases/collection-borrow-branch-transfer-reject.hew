#[resource]
type Token {
    id: i64,
}

impl Token {
    fn close(consume self) {}
}

fn selected(left: bool) -> Token {
    var tokens: Vec<Token> = Vec.new();
    tokens.push(Token { id: 1 });
    var value = tokens[0];
    if left {
        value = Token { id: 2 };
    }
    return value;
}

fn main() {}
