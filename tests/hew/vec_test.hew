#[test]
fn test_max_i32_max_is_first() {
    var v: Vec<i32> = Vec.new();
    v.push(9);
    v.push(1);
    v.push(5);
    assert(vec.max_i32(v).unwrap_or(-999) == 9);
}

#[test]
fn test_max_i32_max_is_last() {
    var v: Vec<i32> = Vec.new();
    v.push(1);
    v.push(5);
    v.push(9);
    assert(vec.max_i32(v).unwrap_or(-999) == 9);
}

