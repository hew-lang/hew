//! Behavioural tests for std::crypto::jwt.

import std.crypto.jwt;

#[test]
fn test_try_encode_and_try_decode_round_trip_payload() {
    let payload = "{\"exp\":4102444800,\"sub\":\"user42\"}";
    let secret = "this secret is only for Hew tests and must never be used in production";
    match jwt.encode(payload, secret, "HS256") {
        .Ok(token) => {
            assert(!token.is_empty());
            match jwt.decode(token, secret, "HS256") {
                .Ok(decoded) => assert(decoded == payload),
                .Err(err) => panic(f"{err}"),
            }
        }
        .Err(err) => panic(f"{err}"),
    }
}

#[test]
fn test_validate_accepts_matching_secret() {
    let token = match jwt.encode("{\"exp\":4102444800,\"sub\":\"user42\"}", "this secret is only for Hew tests and must never be used in production", "HS256") {
        .Ok(t) => t,
        .Err(err) => panic(f"{err}"),
    };
    assert(jwt.validate(token, "this secret is only for Hew tests and must never be used in production", "HS256"));
}

#[test]
fn test_validate_rejects_wrong_secret() {
    let token = match jwt.encode("{\"exp\":4102444800,\"sub\":\"user42\"}", "this secret is only for Hew tests and must never be used in production", "HS256") {
        .Ok(t) => t,
        .Err(err) => panic(f"{err}"),
    };
    assert(!jwt.validate(token, "this different secret is only for tests and must never be used live", "HS256"));
}

#[test]
fn test_decode_insecure_returns_payload_without_verification() {
    let payload = "{\"exp\":4102444800,\"sub\":\"user42\"}";
    let token = match jwt.encode(payload, "this secret is only for Hew tests and must never be used in production", "HS256") {
        .Ok(t) => t,
        .Err(err) => panic(f"{err}"),
    };
    assert(jwt.decode_insecure(token).expect("valid token") == payload);
}

// ── HS384/HS512 coverage (crypto parity gate) ─────────────────────────
// Every prior round-trip test above used "HS256" literally; these mirror
// the same round-trip shape for the other two supported HMAC algorithms.
#[test]
fn test_hs384_try_encode_and_try_decode_round_trip_payload() {
    let payload = "{\"exp\":4102444800,\"sub\":\"user42\"}";
    let secret = "this secret is only for Hew tests and must never be used in production";
    match jwt.encode(payload, secret, "HS384") {
        .Ok(token) => {
            assert(!token.is_empty());
            match jwt.decode(token, secret, "HS384") {
                .Ok(decoded) => assert(decoded == payload),
                .Err(err) => panic(f"{err}"),
            }
        }
        .Err(err) => panic(f"{err}"),
    }
}

#[test]
fn test_hs384_validate_accepts_matching_secret() {
    let token = match jwt.encode("{\"exp\":4102444800,\"sub\":\"user42\"}", "this secret is only for Hew tests and must never be used in production", "HS384") {
        .Ok(t) => t,
        .Err(err) => panic(f"{err}"),
    };
    assert(jwt.validate(token, "this secret is only for Hew tests and must never be used in production", "HS384"));
}

