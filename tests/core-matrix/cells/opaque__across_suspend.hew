#[opaque]
type DqH {
}

#[resource]
type Dq {
    handle: DqH;
    tag: i64;
}

impl Dq {
    fn close(self) {
        unsafe { hew_deque_free(self.handle) };
        println(f"close {self.tag}");
    }
}

extern "C" {
    fn hew_deque_new() -> DqH;
    fn hew_deque_free(dq: DqH);
    fn hew_deque_len(dq: DqH) -> i64;
}

actor Holder {
    var ready: bool;

    receive fn hold(v: Dq) -> i64 {
        sleep(2ms);
        let v_l = unsafe { hew_deque_len(v.handle) };
        let v_t = v.tag;
        println(f"dq {v_t} len={v_l}");
        ready = true;
        1
    }
}

fn main() {
    let x = Dq { handle: unsafe { hew_deque_new() }, tag: 1 };
    let h = spawn Holder(ready: false);
    match await h.hold(x) {
        Ok(n) => println(f"held {n}"),
        Err(_) => println("err"),
    }
}
