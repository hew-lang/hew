//! @name Read a crossing signal
//! @description Match each signal with the action for a pedestrian.

enum Crossing {
    Walk;
    Flashing;
    Stop;
}

fn announce(signal: Crossing) {
    match signal {
        .Walk => println("Start crossing."),
        .Flashing => println("Finish crossing."),
        .Stop => println("Wait for the next signal."),
    }
}

fn main() {
    announce(.Walk);
    announce(.Flashing);
    announce(.Stop);
}
