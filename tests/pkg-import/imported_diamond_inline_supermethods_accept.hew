// The imported diamond shares one Base impl across both branches.
import hew.supertraits.{Base, Left, Right, Diamond};

type DM {
    id: i64;
}

impl Base for DM {
    fn base(self) -> i64 {
        self.id
    }
}

impl Left for DM {
    fn left(self) -> i64 {
        self.id + 10
    }
}

impl Right for DM {
    fn right(self) -> i64 {
        self.id + 20
    }
}

impl Diamond for DM {
    fn diamond(self) -> i64 {
        self.id + 30
    }
}

fn main() {
    let w = DM { id: 1 };
    println(f"diamond {w.diamond()} left {w.left()} right {w.right()} base {w.base()}");
}
