// A consume parameter moves the child out of the caller even when a fluent
// method returns its receiver unchanged.
#[resource]
type Value {
    label: string;
}

trait ValueMethods {
    #[returns_receiver]
    fn absorb(consume self, consume child: Value) -> Self;
}

impl ValueMethods for Value {
    #[returns_receiver]
    fn absorb(consume self, consume child: Value) -> Value {
        child.close();
        self
    }
}

impl Value {
    fn close(consume self) {
        println(self.label);
    }
}

fn main() {
    let owner = Value { label: "owner" };
    let child = Value { label: "child" };
    let combined = owner.absorb(child);
    child.close();
    combined.close();
}
