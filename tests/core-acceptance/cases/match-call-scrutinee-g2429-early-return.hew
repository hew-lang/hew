fn f() -> Result<bytes, string> {
    .Ok("g2429-return-payload".to_bytes())
}

fn run(cap: i64) -> i64 {
    var i = 0;
    while i < cap {
        match f() {
            .Ok(b) => { if b.len() == 20 && i == cap - 1 { return i; } }
            .Err(e) => {}
        }
        i = i + 1;
    }
    -1
}

fn main() -> i64 {
    let r = run(50);
    if r >= 0 { 0 } else { 1 }
}
