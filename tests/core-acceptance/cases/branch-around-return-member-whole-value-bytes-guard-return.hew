fn decode_or_reject(reject: bool) -> bytes {
    var out: bytes = bytes.new();
    out.push(1);
    out.push(2);
    out.push(3);
    if reject {
        return bytes.new();
    }
    out
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        let r = decode_or_reject(true);
        total = total + r.len();
        i = i + 1;
    }
    total
}
