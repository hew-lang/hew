//! A machine whose own transition bodies use the contextual `.Variant`
//! spelling must resolve them the same way whether its file is the
//! compilation entry point or an imported dependency (#3149).
//!
//! `light_defs.hew` checks clean on its own. Reached through this import it
//! used to fail inside its own transitions with
//! `E_CONTEXT_VARIANT_NO_TYPE: expected type `Light` is not an enum or
//! machine`, because the transition's expected type was minted from the bare
//! declaration name while the import path retires that bare `type_defs` row
//! once the module-qualified owner is published.

import tests.hew.machine_context_variant_support.light_defs;

import std.testing;

#[test]
fn contextual_transition_bodies_run_after_the_module_is_imported() {
    var light = light_defs.initial();
    testing.assert_eq_str(light.state_name(), "On");
    light.step(light_defs.LightEvent.Toggle);
    testing.assert_eq_str(light.state_name(), "Off");
    light.step(light_defs.LightEvent.Toggle);
    testing.assert_eq_str(light.state_name(), "On");
}

/// The `.Named { … }` body constructs a struct-payload state, so the expected
/// type has to seed the variant's fields and not merely name the machine.
#[test]
fn contextual_struct_payload_transition_carries_its_field_out() {
    var light = light_defs.Light.On;
    light.step(light_defs.LightEvent.Label);
    let label = match light {
        light_defs.Light.Named { label } => label,
        _ => "none",
    };
    testing.assert_eq_str(label, "LIT");
}
