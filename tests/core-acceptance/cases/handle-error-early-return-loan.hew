// A `handle error` block that returns out of a `receive fn` loop releases
// every loan open on that edge. The sender loan for `done.send(...)` is taken
// before the interpolated element is built, and building it opens a fault
// edge, so the fault path has to end the sender loan too.

import std.encoding.hex;
import std.encoding.utf8;
import std.stream;

actor Reader {
    let input: stream.Stream<bytes>,
    let done: stream.Sink<string>,
    receive fn pump() {
        var reading = true;
        while reading {
            match input.recv() {
                .Some(chunk) => {
                    let msg = utf8.decode(chunk) handle error {
                        done.send(f"invalid: {error}").expect("send");
                        return;
                    };
                    done.send(f"read: {msg}").expect("send");
                },
                .None => {
                    done.send("ended").expect("send");
                    reading = false;
                },
            }
        }
    }
}

fn main() {
    let (sink, input) = match stream.pipe(8) {
        .Ok(pair) => pair,
        .Err(error) => panic(error),
    };
    let (tx, rx): (stream.Sink<string>, stream.Stream<string>) = match stream.pipe(4) {
        .Ok(pair) => pair,
        .Err(_) => panic("stream.pipe failed"),
    };
    let reader = spawn Reader(input: input, done: tx);
    fork reader.pump();
    // Control: a chunk that decodes takes the handler's success path.
    sink.send("first".to_bytes()).expect("send");
    sink.send(hex.decode("ff")).expect("send");
    // The early return leaves this chunk unread.
    sink.send("never read".to_bytes()).expect("send");
    sink.close();
    for _i in 0..2 {
        if let .Some(msg) = rx.recv() {
            println(msg);
        }
    }
}
