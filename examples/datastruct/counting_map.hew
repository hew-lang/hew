// Counting Map - Frequency counter using hash map
// Counts occurrences of integer keys
//
// A parameter is the callee's own copy, so an increment returns both levels
// in parameter order and the caller reassigns each one.
fn hash(key: i64, capacity: i64) -> i64 {
    let h = key % capacity;
    if h < 0 {
        h + capacity
    } else {
        h
    }
}

fn make_keys(capacity: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec.new();
    let EMPTY = 0 - 1;
    for i in 0 .. capacity {
        v.push(EMPTY);
    }
    v
}

fn make_vals(capacity: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec.new();
    for i in 0 .. capacity {
        v.push(0);
    }
    v
}

fn cm_find_slot(keys: Vec<i64>, key: i64) -> i64 {
    let capacity = keys.len();
    let EMPTY = 0 - 1;
    var idx = hash(key, capacity);
    var i = 0;
    while i < capacity {
        let k = keys[idx];
        if k == key {
            return idx;
        }
        if k == EMPTY {
            return idx;
        }
        idx = (idx + 1) % capacity;
        i = i + 1;
    }
    0 - 1
}

fn cm_increment(var keys: Vec<i64>, var vals: Vec<i64>, key: i64) -> (Vec<i64>, Vec<i64>) {
    let EMPTY = 0 - 1;
    let slot = cm_find_slot(keys, key);
    if slot >= 0 {
        let k = keys[slot];
        if k == EMPTY {
            keys.set(slot, key);
            vals.set(slot, 1);
        } else {
            let cur = vals[slot];
            vals.set(slot, cur + 1);
        }
    }
    (keys, vals)
}

// Count a run of tokens so a loop replaces the repeated reassignment of both
// levels at every call site.
fn cm_count_all(var keys: Vec<i64>, var vals: Vec<i64>, tokens: Vec<i64>) -> (Vec<i64>, Vec<i64>) {
    for token in tokens {
        let (counted_keys, counted_vals) = cm_increment(keys, vals, token);
        keys = counted_keys;
        vals = counted_vals;
    }
    (keys, vals)
}

fn cm_get_count(keys: Vec<i64>, vals: Vec<i64>, key: i64) -> i64 {
    let slot = cm_find_slot(keys, key);
    if slot >= 0 {
        let k = keys[slot];
        if k == key {
            return vals[slot];
        }
    }
    0
}

fn cm_most_frequent(keys: Vec<i64>, vals: Vec<i64>) -> i64 {
    let capacity = keys.len();
    let EMPTY = 0 - 1;
    var best_key = 0;
    var best_count = 0;
    for i in 0 .. capacity {
        let k = keys[i];
        if k != EMPTY {
            let c = vals[i];
            if c > best_count {
                best_count = c;
                best_key = k;
            }
        }
    }
    best_key
}

fn main() {
    var passed = 0;
    var failed = 0;
    let cap = 32;
    var keys = make_keys(cap);
    var vals = make_vals(cap);
    // Test 1: Count single key
    let (keys_a, vals_a) = cm_count_all(keys, vals, [5, 5, 5]);
    keys = keys_a;
    vals = vals_a;
    let c5 = cm_get_count(keys, vals, 5);
    if c5 == 3 {
        println("PASS: count single key");
        passed = passed + 1;
    } else {
        println("FAIL: count single key");
        failed = failed + 1;
    }
    // Test 2: Count multiple keys
    let (keys_b, vals_b) = cm_count_all(keys, vals, [10, 10, 15]);
    keys = keys_b;
    vals = vals_b;
    let c10 = cm_get_count(keys, vals, 10);
    let c15 = cm_get_count(keys, vals, 15);
    if c10 == 2 {
        if c15 == 1 {
            println("PASS: count multiple keys");
            passed = passed + 1;
        } else {
            println("FAIL: count multiple keys");
            failed = failed + 1;
        }
    } else {
        println("FAIL: count multiple keys");
        failed = failed + 1;
    }
    // Test 3: Get count of non-existent key
    let cn = cm_get_count(keys, vals, 999);
    if cn == 0 {
        println("PASS: non-existent key count");
        passed = passed + 1;
    } else {
        println("FAIL: non-existent key count");
        failed = failed + 1;
    }
    // Test 4: Most frequent
    let mf = cm_most_frequent(keys, vals);
    if mf == 5 {
        println("PASS: most frequent");
        passed = passed + 1;
    } else {
        println("FAIL: most frequent");
        failed = failed + 1;
    }
    // Test 5: Frequency counting simulation (like word counting)
    // Simulate: tokens = [1, 2, 1, 3, 2, 1, 4, 2, 1]
    var keys2 = make_keys(cap);
    var vals2 = make_vals(cap);
    // token 1 appears 4 times
    let (keys2_a, vals2_a) = cm_count_all(keys2, vals2, [1, 2, 1, 3, 2, 1, 4, 2, 1]);
    keys2 = keys2_a;
    vals2 = vals2_a;
    let f1 = cm_get_count(keys2, vals2, 1);
    let f2 = cm_get_count(keys2, vals2, 2);
    let f3 = cm_get_count(keys2, vals2, 3);
    let f4 = cm_get_count(keys2, vals2, 4);
    if f1 == 4 {
        if f2 == 3 {
            if f3 == 1 {
                if f4 == 1 {
                    println("PASS: frequency simulation");
                    passed = passed + 1;
                } else {
                    println("FAIL: frequency simulation");
                    failed = failed + 1;
                }
            } else {
                println("FAIL: frequency simulation");
                failed = failed + 1;
            }
        } else {
            println("FAIL: frequency simulation");
            failed = failed + 1;
        }
    } else {
        println("FAIL: frequency simulation");
        failed = failed + 1;
    }
    // Test 6: Most frequent after simulation
    let mf2 = cm_most_frequent(keys2, vals2);
    if mf2 == 1 {
        println("PASS: most frequent after simulation");
        passed = passed + 1;
    } else {
        println("FAIL: most frequent after simulation");
        failed = failed + 1;
    }
    // Test 7: Increment existing further
    let (keys2_b, vals2_b) = cm_count_all(keys2, vals2, [2, 2]);
    keys2 = keys2_b;
    vals2 = vals2_b;
    let f2b = cm_get_count(keys2, vals2, 2);
    if f2b == 5 {
        println("PASS: increment further");
        passed = passed + 1;
    } else {
        println("FAIL: increment further");
        failed = failed + 1;
    }
    // Test 8: Most frequent changes after updates
    let mf3 = cm_most_frequent(keys2, vals2);
    if mf3 == 2 {
        println("PASS: most frequent updated");
        passed = passed + 1;
    } else {
        println("FAIL: most frequent updated");
        failed = failed + 1;
    }
    // Summary
    println("---");
    print("Passed: ");
    println(passed);
    print("Failed: ");
    println(failed);
    if failed == 0 {
        println("ALL PASS");
    } else {
        println("SOME FAILED");
    }
}
