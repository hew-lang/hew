//! Status: runnable
//! Description: Fibonacci across actors - demonstrates deterministic fan-out with joins

// Fibonacci across actors - demonstrates deterministic fan-out with joins
fn fib(n: i64) -> i64 {
    if n <= 1 {
        n
    } else {
        fib(n - 1) + fib(n - 2)
    }
}

fn print_result(worker_id: i64, n: i64, result: i64) {
    println(f"Worker {worker_id}: fib({n}) = {result}");
}

actor FibWorker {
    receive fn compute(n: i64) -> i64 {
        fib(n)
    }
}

fn main() {
    println("=== Fibonacci via Actors ===");
    let w1 = spawn FibWorker;
    let w2 = spawn FibWorker;
    let w3 = spawn FibWorker;
    let (r1_result, r2_result, r3_result) = await fork (w1.compute(5), w2.compute(10), w3.compute(15));
    let r1 = match r1_result { .Ok(value) => value, .Err(_) => -1 };
    let r2 = match r2_result { .Ok(value) => value, .Err(_) => -1 };
    let r3 = match r3_result { .Ok(value) => value, .Err(_) => -1 };
    print_result(1, 5, r1);
    print_result(2, 10, r2);
    print_result(3, 15, r3);
    println("=== Done ===");
}
