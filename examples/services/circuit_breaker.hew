//! Circuit breaker: typed failures, machine transitions and a supervised backend.
import breaker;

fn report(id: i64, result: Result<i64, breaker.RequestError>) {
    match result {
        .Ok(value) => println(f"request {id}: {value}"),
        .Err(.CircuitOpen) => println(f"request {id}: circuit open"),
        .Err(.BackendUnavailable) => println(f"request {id}: backend unavailable"),
    }
}

fn main() {
    let service = spawn breaker.BackendService;
    let circuit = spawn breaker.CircuitBreaker { backend: service.backend };
    for id in 1..3 {
        report(id, circuit.request(id).expect("breaker available"));
    }
    // Completion calls establish the ordering; no timing sleeps are needed.
    service.backend.set_healthy(false).expect("backend available");
    for id in 3..6 {
        report(id, circuit.request(id).expect("breaker available"));
    }
    assert(circuit.state_name().expect("state") == "Open");
    report(6, circuit.request(6).expect("breaker available"));
    service.backend.set_healthy(true).expect("backend available");
    report(7, circuit.request(7).expect("breaker available"));
    circuit.probe().expect("probe");
    assert(circuit.state_name().expect("state") == "HalfOpen");
    report(8, circuit.request(8).expect("breaker available"));
    report(9, circuit.request(9).expect("breaker available"));
    assert(circuit.accepted_count().expect("accepted count") == 4);
    println(f"final state: {circuit.state_name().expect("state")}");
    stop(circuit);
    stopped(circuit);
    stop(service);
    stopped(service);
}
