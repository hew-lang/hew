//! @name Supervisor
//! @description Supervision tree for fault-tolerant actors

import std.restart;

actor Worker {
    let id: i64;
    receive fn work(x: i64) -> i64 {
        println(f"Worker {id} processing {x}");
        x
    }
}

supervisor WorkerPool {
    strategy: one_for_one;
    intensity: 5 within 10s;
    // A crashed child waits before its restart, doubling up to five seconds.
    backoff: restart.exponential(initial: 100ms, maximum: 5s);

    child w1: Worker { id: 1 };
    // This child replaces the supervisor's delay and restarts at once.
    child w2: Worker { id: 2 } backoff: restart.immediate();
}

fn main() {
    let workers = spawn WorkerPool;
    // Access supervised children by their declared names.
    let w1 = workers.w1;
    let w2 = workers.w2;
    let a = match w1.work(10) {
        .Ok(v) => v,
        .Err(_) => -1,
    };
    let b = match w2.work(20) {
        .Ok(v) => v,
        .Err(_) => -1,
    };
    println(f"w1 -> {a}");
    println(f"w2 -> {b}");
}
// The pool winds down with the program here. Explicit supervisor close/closed
// forms are decided but their implementation is pending.
