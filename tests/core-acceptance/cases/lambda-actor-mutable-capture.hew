fn main() {
    var total: i64 = 0;
    let acc = actor |n: i64| -> i64 { total += n; total };
    assert(acc(5).expect("first reply") == 5);
    assert(acc(7).expect("second reply") == 12);
    assert(total == 0);
    stop(acc);
    stopped(acc);

    var moved_total: i64 = 10;
    let moved = actor move |n: i64| -> i64 { moved_total += n; moved_total };
    assert(moved(3).expect("first moved reply") == 13);
    assert(moved(4).expect("second moved reply") == 17);
    assert(moved_total == 10);
    stop(moved);
    stopped(moved);
}
