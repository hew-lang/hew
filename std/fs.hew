    #[offload]
    fn hew_file_read(path: string) -> string;
    #[offload]
    fn hew_file_write(path: string, content: string) -> i32;
    #[offload]
    fn hew_file_append(path: string, content: string) -> i32;
    #[offload]
    fn hew_file_exists(path: string) -> bool;
    #[offload]
    fn hew_file_delete(path: string) -> i32;
    #[offload]
    fn hew_file_size(path: string) -> i64;
    #[offload]
    fn hew_file_read_bytes(path: string) -> bytes;
    #[offload]
    fn hew_file_write_bytes(path: string, data: bytes) -> i32;
    #[offload]
    fn hew_file_write_atomic(path: string, data: bytes) -> i32;
    #[offload]
    fn hew_fs_mkdir(path: string) -> i32;
    #[offload]
    fn hew_fs_mkdir_all(path: string) -> i32;
    #[offload]
    fn hew_fs_list_dir(path: string) -> Vec<string>;
    #[offload]
    fn hew_fs_rename(from: string, to: string) -> i32;
    #[offload]
    fn hew_fs_copy(from: string, to: string) -> i32;
    #[offload]
    fn hew_fs_is_dir(path: string) -> bool;
    #[offload]
    fn hew_fs_metadata(path: string) -> RawMetadata;
    #[offload]
    fn hew_fs_symlink_metadata(path: string) -> RawMetadata;
    fn hew_fs_current_owner() -> i64;
    #[offload]
    fn hew_fs_create_new(path: string, data: bytes, mode: i64) -> i32;
    #[offload]
    fn hew_fs_mkdir_mode(path: string, mode: i64) -> i32;
    #[offload]
    fn hew_fs_read_nofollow(path: string, limit: i64) -> bytes;
    #[offload]
    fn hew_fs_read_private(path: string, limit: i64) -> bytes;
    // Not offloaded: a cancelled pool job would drop the returned lock
    // handle without releasing it.
    fn hew_fs_try_lock(path: string) -> FileLock;
    fn hew_fs_lock_is_valid(lock: FileLock) -> bool;
    fn hew_fs_unlock(consume lock: FileLock);
    #[offload]
    fn hew_fs_space(path: string) -> RawSpace;
    fn hew_file_read_stream_open(path: string) -> FileReadStream;
    fn hew_file_read_stream_is_valid(stream: FileReadStream) -> bool;
    fn hew_stream_has_error() -> bool;
    fn hew_stream_last_error() -> string;
    fn hew_stream_last_errno() -> i32; // INTERNAL-ABI: OS errno from thread-local; 0 when none recorded
    fn hew_stream_last_error_kind() -> i32; // INTERNAL-ABI: canonical cross-platform error-kind tag; 0 when none
    fn hew_file_read_stream_collect_string(consume stream: FileReadStream) -> string;
    fn hew_file_read_stream_close(consume stream: FileReadStream);
}
