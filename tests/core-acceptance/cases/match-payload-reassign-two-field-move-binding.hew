enum Pair {  Both(Vec<i64>, Vec<i64>), Neither }
fn main() -> i64 {
    let b = Pair.Both(seed(), seed());
    var out = 0;
    match b {
        Pair.Both(x, y) => {
            var wx = x; var wy = y;
            wx = seed(); wy = seed();
            out = wx.len() + wy.len();
        }
        Pair.Neither => {}
    }
    out
}

fn seed() -> Vec<i64> {
    var v: Vec<i64> = Vec.new();
    v.push(1);
    v.push(2);
    v.push(3);
    v
}
