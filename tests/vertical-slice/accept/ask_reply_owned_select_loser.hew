// Acceptance fixture (#1739 / #1735): select{} with OWNED-string ask arms.
//
// Design intent (the owned-reply analog of actor_ask_race):
//   - FastWorker.label() returns an owned `string` immediately; always wins.
//   - SlowWorker.label() waits on a gate main opens after the select, then
//     returns an owned `string`; always loses. Its reply is released on the loser teardown leg (delivered-but
//     -never-consumed, or cancelled-before-delivery) by the channel's
//     registered destructor — without leaking and without double-freeing what
//     the winner owns.
//
// Exit-code contract: main returns the winning reply's length. FastWorker's
// "winner-owned-reply".to_upper() is "WINNER-OWNED-REPLY" = 18 chars, so
// the process exits 18. A crash on the loser teardown leg (double-free / UAF)
// or a hang would fail this fixture instead.
import std.stream;

actor FastWorker {
    receive fn label() -> string {

        // Reply immediately with an owned (heap) string.
        "winner-owned-reply".to_upper()
    }
}

actor SlowWorker {
    var gate: stream.Stream<i64>,

    receive fn label() -> string {
        // Wait on a gate main opens only after the select, so FastWorker's
        // reply wins; this owned reply is abandoned.
        gate.recv();
        "loser-owned-reply".to_upper()
    }

    receive fn ping() {}
}

fn main() -> i64 {
    let fast = spawn FastWorker;
    let (release, gate) = stream.pipe(1).expect("gate");
    let slow = spawn SlowWorker(gate: gate);
    let winner = select {
        reply from fast.label() => reply.expect("ask reply"),
        reply from slow.label() => reply.expect("ask reply"),
    };
    // The losing owned reply lands on its abandoned channel before exit.
    release.send(1).expect("release");
    slow.ping().expect("ping");
    // "WINNER-OWNED-REPLY" is 18 characters; exit code == 18.
    winner.len()
}
