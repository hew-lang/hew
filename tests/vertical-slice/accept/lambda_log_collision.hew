// A lambda actor binding named `log` must shadow the logarithm builtin.
// Unit completion prints the string payload, then a second lambda reply
// travels through that same logger. Both output lines observe actor bodies.
fn main() {
    let log = actor |s: string| {
        println(f"LOG: {s}");
    };
    let _ = log("hello");
    let log2 = actor |n: i64| -> i64 {
        n + 1
    };
    let r = log2(41);
    match r {
        .Ok(v) => {
            let _ = log(f"ask {v}");
        }
        .Err(_) => {
            let _ = log("ask err");
        }
    }
}
