// Circular Buffer - Fixed-size ring buffer using Vec<i64>
// Layout: [capacity, head, tail, count, data...]
// Data starts at index 4
//
// A parameter is the callee's own copy, so push and pop return the buffer
// alongside their result and the caller reassigns.
fn cb_new(capacity: i64) -> Vec<i64> {
    var buf: Vec<i64> = Vec.new();
    buf.push(capacity); // index 0: capacity
    buf.push(0); // index 1: head
    buf.push(0); // index 2: tail
    buf.push(0); // index 3: count
    // Pre-allocate data slots
    for i in 0 .. capacity {
        buf.push(0);
    }
    buf
}

fn cb_capacity(buf: Vec<i64>) -> i64 {
    buf[0]
}

fn cb_count(buf: Vec<i64>) -> i64 {
    buf[3]
}

fn cb_is_empty(buf: Vec<i64>) -> i64 {
    if buf[3] == 0 {
        1
    } else {
        0
    }
}

fn cb_is_full(buf: Vec<i64>) -> i64 {
    if buf[3] == buf[0] {
        1
    } else {
        0
    }
}

// Returns the buffer and 1 on success, 0 when the buffer is already full.
fn cb_push(var buf: Vec<i64>, val: i64) -> (Vec<i64>, i64) {
    let cap = buf[0];
    let count = buf[3];
    if count == cap {
        return (buf, 0);
    }
    let tail = buf[2];
    buf.set(4 + tail, val);
    let new_tail = (tail + 1) % cap;
    buf.set(2, new_tail);
    buf.set(3, count + 1);
    (buf, 1)
}

// Push each value in turn; the per-push result is checked on its own in the
// full-buffer test below.
fn cb_push_all(var buf: Vec<i64>, vals: Vec<i64>) -> Vec<i64> {
    for val in vals {
        let (grown, _ok) = cb_push(buf, val);
        buf = grown;
    }
    buf
}

fn cb_pop(var buf: Vec<i64>) -> (Vec<i64>, i64) {
    let head = buf[1];
    let cap = buf[0];
    let count = buf[3];
    let val = buf[4 + head];
    let new_head = (head + 1) % cap;
    buf.set(1, new_head);
    buf.set(3, count - 1);
    (buf, val)
}

fn cb_peek(buf: Vec<i64>) -> i64 {
    let head = buf[1];
    buf[4 + head]
}

fn run_test(name: string, passed: i64) -> i64 {
    if passed == 1 {
        println(f"PASS: {name}");
    } else {
        println(f"FAIL: {name}");
    }
    passed
}

fn main() {
    var total = 0;
    var passed = 0;
    // Test 1: new buffer is empty
    total = total + 1;
    var buf = cb_new(5);
    var r1 = 0;
    if cb_is_empty(buf) == 1 {
        if cb_capacity(buf) == 5 {
            r1 = 1;
        }
    }
    passed = passed + run_test("new buffer empty, cap=5", r1);

    // Test 2: push and count
    total = total + 1;
    buf = cb_push_all(buf, [10, 20, 30]);
    let r2 = if cb_count(buf) == 3 {
        1
    } else {
        0
    };
    passed = passed + run_test("push 3 items, count=3", r2);

    // Test 3: peek
    total = total + 1;
    let r3 = if cb_peek(buf) == 10 {
        1
    } else {
        0
    };
    passed = passed + run_test("peek returns first", r3);

    // Test 4: pop FIFO
    total = total + 1;
    let (after_v1, v1) = cb_pop(buf);
    let (after_v2, v2) = cb_pop(after_v1);
    buf = after_v2;
    var r4 = 0;
    if v1 == 10 {
        if v2 == 20 {
            r4 = 1;
        }
    }
    passed = passed + run_test("pop FIFO order", r4);

    // Test 5: fill to capacity
    total = total + 1;
    // count is now 1 (30 remains), fill 4 more
    buf = cb_push_all(buf, [40, 50, 60, 70]);
    let r5 = if cb_is_full(buf) == 1 {
        1
    } else {
        0
    };
    passed = passed + run_test("fill to capacity", r5);

    // Test 6: push when full returns 0
    total = total + 1;
    let (after_full, ok) = cb_push(buf, 99);
    buf = after_full;
    let r6 = if ok == 0 {
        1
    } else {
        0
    };
    passed = passed + run_test("push when full fails", r6);

    // Test 7: wraparound - pop all then refill
    total = total + 1;
    // Pop all 5
    let (after_w1, w1) = cb_pop(buf);
    let (after_w2, w2) = cb_pop(after_w1);
    let (after_w3, w3) = cb_pop(after_w2);
    let (after_w4, w4) = cb_pop(after_w3);
    let (after_w5, w5) = cb_pop(after_w4);
    buf = after_w5;
    // Now head and tail have wrapped
    // Fill again
    buf = cb_push_all(buf, [100, 200, 300]);
    let (after_wr1, wr1) = cb_pop(buf);
    let (after_wr2, wr2) = cb_pop(after_wr1);
    let (_after_wr3, wr3) = cb_pop(after_wr2);
    var r7 = 0;
    if wr1 == 100 {
        if wr2 == 200 {
            if wr3 == 300 {
                r7 = 1;
            }
        }
    }
    passed = passed + run_test("wraparound works", r7);

    // Test 8: original pop values correct
    total = total + 1;
    var r8 = 0;
    if w1 == 30 {
        if w2 == 40 {
            if w3 == 50 {
                if w4 == 60 {
                    if w5 == 70 {
                        r8 = 1;
                    }
                }
            }
        }
    }
    passed = passed + run_test("pop values after fill", r8);

    // Summary
    println(f"{passed}/{total} tests passed");
    if passed == total {
        println("ALL PASS");
    } else {
        println("SOME FAILED");
    }
}
