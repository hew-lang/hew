//! Status: runnable (v0.5 std.text.template parse/render surface)
//! Description: Go-style text/template — parse a template then render it against a flat Ctx.
//!
//! Builds a flat context with scalar (`Ctx.set_str` / `Ctx.set_int` /
//! `Ctx.set_bool`) and list (`Ctx.set_list`) bindings, parses a template using
//! `{{.key}}` substitution, an `{{if .key}}…{{end}}` conditional, and a
//! `{{range .key}}…{{end}}` loop, then renders with `render_try` and matches the
//! `Result`. Method-style `t.render(ctx)` is deferred in v0.5, so the
//! free-function `template.render_try(t, ctx)` form is used.

import std.text.template;

fn main() {
    var ctx = template.new_ctx();
    ctx.set_str("name", "Ada");
    ctx.set_int("commits", 7);
    ctx.set_bool("member", true);
    var tags: Vec<string> = Vec.new();
    tags.push("compiler");
    tags.push("runtime");
    tags.push("docs");
    ctx.set_list("tags", tags);
    let src = "Hi {{.name}} — {{.commits}} commits{{if .member}} (core member){{end}}.\nTags:{{range .tags}} #{{.}}{{end}}";
    let tmpl = match template.parse(src) {
        .Ok(template) => template,
        .Err(_) => panic("template parse failed"),
    };
    match template.render_try(tmpl, ctx) {
        .Ok(rendered) => println(rendered),
        .Err(_) => println("template render failed"),
    }
}
