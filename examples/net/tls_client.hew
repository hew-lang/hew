//! Status: complete — connects, sends a GET request, and reads the response
//!         status line over a real TLS round-trip.
//! Description: TLS client — connect with the bundled roots and a handshake
//! deadline, then GET a page.
//!
//! `tls.connect` returns once the handshake has completed, or a typed
//! `NetError` (`TimedOut` past the deadline, `Other` with the alert in
//! `tls.last_error()` when verification fails). Request and response bodies
//! are `bytes`: build a request with `string.to_bytes()` and decode a
//! response with `utf8.decode()`.

import std.encoding.utf8;

import std.net.tls;

fn main() {
    let host = "example.com";
    var options = tls.options();
    options.handshake_timeout = 5s;
    options.io_timeout = 5s;
    let stream = match tls.connect(host, 443, options) {
        .Ok(stream) => stream,
        .Err(error) => {
            println(f"connect failed: {error} {tls.last_error()}");
            return;
        }
    };
    let nl = "\r\n";
    let request = f"GET / HTTP/1.1{nl}Host: {host}{nl}Connection: close{nl}{nl}";
    let sent = stream.write(request.to_bytes()).expect("write succeeds");
    println(f"sent {sent} request bytes to {host}");
    match stream.read(256) {
        .Ok(data) => {
            let text = utf8.decode(data) handle error {
                println(f"invalid UTF-8: {error}");
                return;
            };
            let crlf = "\r\n";
            let status_line = match text.find(crlf) {
                .Some(cut) => text.slice(0, cut),
                .None => text,
            };
            println(f"response: {status_line}");
        }
        .Err(_) => println(f"read error: {tls.last_error()}"),
    }
}
