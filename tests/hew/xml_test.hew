//! Behavioural tests for std::encoding::xml.

import std.encoding.xml;

import std.testing;

// ── Happy-path parse ──────────────────────────────────────────────────
#[test]
fn test_parse_root_tag() {
    let root = xml.parse("<a>text</a>");
    testing.assert_eq_str(root.get_tag(), "a");
    root.close();
}

#[test]
fn test_parse_text_content() {
    let root = xml.parse("<a>hello</a>");
    testing.assert_eq_str(root.get_text(), "hello");
    root.close();
}

#[test]
fn test_parse_children_count() {
    let root = xml.parse("<root><child1/><child2/></root>");
    testing.assert_eq(root.children_count(), 2);
    root.close();
}

#[test]
fn test_parse_child_tag() {
    let root = xml.parse("<root><item>val</item></root>");
    let child = root.get_child(0);
    testing.assert_eq_str(child.get_tag(), "item");
    child.close();
    root.close();
}

#[test]
fn test_parse_attribute() {
    let root = xml.parse("<a id=\"42\"/>");
    testing.assert_eq_str(root.get_attribute("id"), "42");
    root.close();
}

#[test]
fn test_is_element_returns_positive_for_element() {
    let root = xml.parse("<a/>");
    // is_element == 1 for element nodes
    testing.assert_eq(root.is_element() as i64, 1);
    root.close();
}

// ── Boundary / error ─────────────────────────────────────────────────
#[test]
fn test_close_no_panic() {
    let root = xml.parse("<x/>");
    root.close();
}

#[test]
fn test_missing_attribute_returns_empty() {
    let root = xml.parse("<a/>");
    testing.assert_eq_str(root.get_attribute("missing"), "");
    root.close();
}

#[test]
#[should_panic]
fn test_get_child_rejects_index_that_would_wrap_to_zero() {
    let root = xml.parse("<root><child/></root>");
    root.get_child(4294967296);
}

// ── Malformed input ───────────────────────────────────────────────────
#[test]
#[should_panic]
fn test_parse_panics_on_malformed() {
    xml.parse("<unclosed>no closing tag here");
}

#[test]
fn test_is_wellformed_true_for_valid_xml() {
    testing.assert_true(xml.is_wellformed("<a>text</a>"));
}

#[test]
fn test_is_wellformed_false_for_malformed_xml() {
    testing.assert_false(xml.is_wellformed("<unclosed"));
}

// ── XML documents must be structurally well-formed to parse ───────────
#[test]
fn test_try_parse_rejects_multiple_root_elements() {
    match xml.try_parse("<a/><b/>") {
        .Ok(node) => {
            node.close();
            panic("expected a document with two roots to be rejected");
        },
        .Err(reason) => testing.assert_eq_str(reason, "xml: document has more than one root element"),
    }
}

#[test]
fn test_try_parse_rejects_a_close_tag_that_does_not_match() {
    match xml.try_parse("<a><b></c></a>") {
        .Ok(node) => {
            node.close();
            panic("expected a mismatched close tag to be rejected");
        },
        .Err(reason) => testing.assert_true(reason.contains("</c>")),
    }
}

#[test]
fn test_try_parse_rejects_a_malformed_attribute() {
    match xml.try_parse("<a b>text</a>") {
        .Ok(node) => {
            node.close();
            panic("expected a malformed attribute to be rejected");
        },
        .Err(reason) => testing.assert_eq_str(reason, "xml: element `a` has a malformed attribute"),
    }
}

#[test]
fn test_try_parse_rejects_an_unknown_entity_reference() {
    match xml.try_parse("<root>&nope;</root>") {
        .Ok(node) => {
            node.close();
            panic("expected an unknown entity reference to be rejected");
        },
        .Err(reason) => testing.assert_eq_str(reason, "xml: `&nope;` is not a known entity reference"),
    }
}

#[test]
fn test_try_parse_rejects_a_document_with_no_root_element() {
    match xml.try_parse("just text") {
        .Ok(node) => {
            node.close();
            panic("expected a document with no root element to be rejected");
        },
        .Err(reason) => testing.assert_eq_str(reason, "xml: document has no root element"),
    }
}

#[test]
fn test_try_parse_preserves_a_well_formed_document() {
    match xml.try_parse("<root a=\"1\"><kid>hi</kid></root>") {
        .Ok(node) => {
            testing.assert_eq_str(node.get_tag(), "root");
            testing.assert_eq_str(node.get_attribute("a"), "1");
            testing.assert_eq(node.children_count(), 1);
            testing.assert_eq_str(node.get_text(), "hi");
            node.close();
        },
        .Err(reason) => panic(f"a well-formed document must parse: {reason}"),
    }
}

#[test]
fn test_try_parse_preserves_predefined_entities() {
    match xml.try_parse("<root>a &lt; b &amp; c</root>") {
        .Ok(node) => {
            testing.assert_eq_str(node.get_text(), "a < b & c");
            node.close();
        },
        .Err(reason) => panic(f"predefined entities must still expand: {reason}"),
    }
}

#[test]
fn test_try_parse_decodes_entities_in_attributes() {
    match xml.try_parse("<root label=\"a &lt; b &amp; &quot;q&quot;\"/>") {
        .Ok(node) => {
            testing.assert_eq_str(node.get_attribute("label"), "a < b & \"q\"");
            node.close();
        },
        .Err(reason) => panic(f"attribute entities must expand: {reason}"),
    }
}

#[test]
fn test_try_parse_rejects_non_whitespace_outside_the_root() {
    match xml.try_parse("before<root/>") {
        .Ok(node) => {
            node.close();
            panic("text before the root must be rejected");
        },
        .Err(reason) => testing.assert_true(reason.contains("outside the root")),
    }
    match xml.try_parse("<root/>after") {
        .Ok(node) => {
            node.close();
            panic("text after the root must be rejected");
        },
        .Err(reason) => testing.assert_true(reason.contains("outside the root")),
    }
}

#[test]
fn test_try_parse_allows_xml_whitespace_around_the_root() {
    match xml.try_parse(" \t\n<root/>\r\n") {
        .Ok(node) => node.close(),
        .Err(reason) => panic(f"XML whitespace around the root is valid: {reason}"),
    }
}

#[test]
fn test_is_wellformed_rejects_multiple_roots() {
    testing.assert_false(xml.is_wellformed("<a/><b/>"));
    testing.assert_true(xml.is_wellformed("<a><b/></a>"));
}

#[test]
#[should_panic]
fn test_parse_panics_on_multiple_root_elements() {
    let _ = xml.parse("<a/><b/>");
}
