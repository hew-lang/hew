// Depth-1 composite state machine executed end-to-end.
//
// `Connected` is a composite state grouping three substates and owning the
// shared `Disconnect` rule. Machine evaluation is pure, so the hooks emit a
// typed `Trace` output instead of printing; `main` prints the outputs the
// step report carries back, which makes the Harel ordering observable:
//   * enter the composite: Connected.entry THEN the initial child's entry
//   * move inside it: old child's exit THEN new child's entry, no composite
//     hook
//   * leave it: child's exit THEN Connected.exit
//   * the parent-level Disconnect rule applies to every substate, so a fourth
//     substate would inherit it
//
// The whole composite desugars to a flat machine at the parser/AST level;
// HIR, MIR, and codegen never see a composite.
machine ConnectionLifecycle {
    events {
        Connect,
        AuthOk,
        DrainStart,
        DrainDone,
        Disconnect,
    }

    emits {
        Trace { text: string, },
    }

    state Disconnected,

    state Connected {
        entry {
            emit Trace { text: "Connected.entry" };
        }
        exit {
            emit Trace { text: "Connected.exit" };
        }
        initial state Authenticating {
            entry {
                emit Trace { text: "Authenticating.entry" };
            }
            exit {
                emit Trace { text: "Authenticating.exit" };
            }
        },
        state Active {
            entry {
                emit Trace { text: "Active.entry" };
            }
            exit {
                emit Trace { text: "Active.exit" };
            }
        },
        state Draining {
            entry {
                emit Trace { text: "Draining.entry" };
            }
            exit {
                emit Trace { text: "Draining.exit" };
            }
        },
        on Disconnect: _ => Disconnected,
    },

    on Connect: Disconnected => Connected,
    on AuthOk: Authenticating => Active,
    on DrainStart: Active => Draining,
    on DrainDone: Draining => Disconnected,

    default { state }
}

fn show(report: ConnectionLifecycleStep) {
    for output in report.outputs {
        match output {
            .Trace { text } => println(text),
        }
    }
}

fn main() {
    var connection: ConnectionLifecycle = .Disconnected;
    println(connection.state_name());
    show(connection.step(.Connect));
    println(connection.state_name());
    show(connection.step(.AuthOk));
    println(connection.state_name());
    show(connection.step(.Disconnect));
    println(connection.state_name());
}
