//! Status: runnable (ordinary for over Stream<string>)
//! Description: Drains a string pipe with `for`.

import std.stream;

actor DrainStrings {
    receive fn run(unused: i64) {
        let (tx, rx): (stream.Sink<string>, stream.Stream<string>) = match stream.pipe(4) {
            .Ok(pair) => pair,
            .Err(err) => panic(f"stream.pipe failed: {err}"),
        };
        tx.send("a").expect("send");
        tx.send("b").expect("send");
        tx.send("c").expect("send");
        tx.close();
        for item in rx {
            println(item);
        }
    }
}

fn main() {
    let worker = spawn DrainStrings;
    let _ = worker.run(0);
}
