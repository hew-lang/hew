actor Producer {
    var label: string = "tick";
    var turns: i64 = 0;
    receive gen fn ticks(count: i64) -> string {
        turns = turns + 1;
        for index in 0..count {
            yield label;
        }
    }
    receive fn turns() -> i64 {
        turns
    }
}

fn main() {
    let producer = spawn Producer;
    // A plain `for` waits per item and runs the producer to completion.
    var seen = 0;
    for item in producer.ticks(3) {
        println(item);
        seen = seen + 1;
    }
    println(seen);

    // Leaving early ends the producer turn without stranding the pipe.
    var partial = 0;
    for item in producer.ticks(100) {
        println(item);
        partial = partial + 1;
        if partial >= 2 {
            break;
        }
    }
    println(partial);
    match producer.turns() {
        .Ok(turns) => println(turns),
        .Err(_) => panic("turns failed"),
    }
    stop(producer);
    stopped(producer);
    println("closed");
}
