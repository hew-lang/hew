// quic_mesh/server.hew — QUIC mesh service issuer
//
// This node exports a Counter service to one authenticated peer. The registry
// is not used as call authority: the client receives an ordinary Counter
// handle through the peer's offer.
//
// First run both programs without arguments to create their node keys and
// print their public credentials. Then exchange those credentials and run:
//   hew run examples/quic_mesh/server.hew <client-credential>
//   hew run examples/quic_mesh/client.hew <server-credential>
// Start the client while the server is listening. Keep each key file between
// runs so the printed credentials continue to identify the same nodes.
import std.net;
import std.os;

actor Counter {
    var count: i64;
    #[wire]
    receive fn increment(by: i64) -> i64 {
        count = count + by;
        println(f"[server] counter incremented by {by} → {count}");
        count
    }
    #[wire]
    receive fn get_count() -> i64 {
        count
    }
}

fn authenticated_peer(credential: string) -> net.PeerSession {
    for attempt in 0..2400 {
        match Node.peer(credential) {
            .Ok(peer) => return peer,
            .Err(_) => {
                if attempt == 2399 {
                    panic("authenticated client session did not arrive");
                }
                sleep(50ms);
            }
        }
    }
    panic("authenticated client session did not arrive");
}

fn main() {
    let args = os.args();
    let peer_credential = match args.get(1) {
        .Some(value) => value,
        .None => "--identity",
    };
    var config = NodeConfig { bind: "127.0.0.1:9000", transport: NodeTransport.QuicMesh, key: "quic-mesh-server.key", peers: [], seeds: [] };
    if peer_credential != "--identity" {
        config.peers = [peer_credential];
    }
    Node.start(config).expect("QUIC mesh node starts");
    println(f"[server] public credential: {Node.identity_key()}");
    if peer_credential == "--identity" {
        Node.shutdown();
        return;
    }

    let counter = spawn Counter { count: 0 };
    // Wait for the client to connect and authenticate with its pinned key.
    let peer = authenticated_peer(peer_credential);
    let export = peer.export(counter).expect("client accepts Counter service");
    println("[server] Counter service offered to authenticated client");

    // Keep the grant alive while the client makes its completion calls.
    sleep(30s);
    let total = counter.get_count().expect("read final count");
    println(f"[server] final count: {total}");
    export.close();
    Node.shutdown();
    println("[server] shut down");
}
