type Box {
    v: Vec<i64>,
}

actor TwoBoxes {
    var x: Box,
    var y: Box,

    receive fn flip() {
        let t = x;
        x = y;
        y = t;
    }

    receive fn sum_x() -> i64 {
        var s: i64 = 0;
        for v in x.v { s = s + v; }
        s
    }
}

fn main() -> i64 {
    var xv: Vec<i64> = Vec.new();
    xv.push(1); xv.push(2); xv.push(3);
    var yv: Vec<i64> = Vec.new();
    yv.push(10); yv.push(20); yv.push(30); yv.push(40);
    let a = spawn TwoBoxes(x: Box { v: xv }, y: Box { v: yv });
    var i: i64 = 0;
    while i < 25 {
        let _ = a.flip();
        i = i + 1;
    }
    match a.sum_x() {
        .Ok(v) => v,
        .Err(_) => -1,
    }
}
