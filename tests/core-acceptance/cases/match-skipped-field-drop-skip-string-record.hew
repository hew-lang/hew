type Tagged {
    n: i64,
    s: string,
}

fn run_cycle(k: i64) -> i64 {
    let t = Tagged { n: k, s: "skip-string-heap-payload".to_upper() };
    let x = match t {
        Tagged { n: x, s: _ } => x,
    };
    x
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        total = total + run_cycle(i);
        i = i + 1;
    }
    if total >= 0 { 0 } else { 1 }
}
