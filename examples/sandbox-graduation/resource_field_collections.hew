// A `#[resource]` record's collection field changes in place: a push and an
// indexed write, then the record closes once with its final contents.
#[resource]
type Log {
    lines: Vec<string>,
}

impl Log {
    fn close(consume self) {
        println(f"close {self.lines.len()} {self.lines[0]}");
    }
}

fn main() {
    var log = Log { lines: Vec.new() };
    log.lines.push("first");
    log.lines.push("second");
    log.lines[0] = "edited";
    println(f"{log.lines[0]} {log.lines[1]}");
}
