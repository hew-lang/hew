import std.fs;

import std.os;

// Each acceptance process owns its key and durable session state. Restarting
// within the process reuses that key and advances the session.
fn key_path() -> string {
    f"{os.temp_dir()}/hew-node-config-atomic-lifecycle-{os.pid()}.key"
}

fn starts(consume config: NodeConfig) -> bool {
    match Node.start(config) {
        .Ok(_) => true,
        .Err(_) => false,
    }
}

fn configured_at(bind: string) -> NodeConfig {
    var config = NodeConfig.at(bind);
    config.key = key_path();
    config
}

fn main() -> i64 {
    match Node.connect("127.0.0.1:1") {
        .Err(.Refused) => {}
        _ => return 8,
    }
    let initial = configured_at("127.0.0.1:0");
    if !starts(initial) {
        return 1;
    }
    Node.shutdown();
    let invalid = NodeConfig.at("127.0.0.1:0");
    match Node.start(invalid) {
        .Err(.Key) => {}
        _ => return 2,
    }
    // Empty bind reaches the first managed-field rejection while later owned
    // strings and vectors are populated; consuming Node.start must release all.
    let empty_bind = NodeConfig { bind: "", transport: NodeTransport.Tcp, key: key_path(), cluster: f"{os.temp_dir()}/unread-enrolment-{os.pid()}", seeds: ["127.0.0.1:1"] };
    match Node.start(empty_bind) {
        .Err(.Config) => {}
        _ => return 7,
    }
    var malformed_seed = configured_at("127.0.0.1:0");
    malformed_seed.seeds = ["1@missing-port"];
    match Node.start(malformed_seed) {
        .Err(.Config) => {}
        _ => return 9,
    }
    let absent_seed = NodeConfig { bind: "127.0.0.1:0", transport: NodeTransport.Tcp, key: key_path(), cluster: "", seeds: ["127.0.0.1:1"] };
    match Node.start(absent_seed) {
        .Ok(_) => {}
        _ => return 3,
    }
    Node.shutdown();
    let retry = configured_at("127.0.0.1:0");
    if !starts(retry) {
        return 4;
    }
    let repeated = configured_at("127.0.0.1:0");
    match Node.start(repeated) {
        .Err(.Refused) => {}
        _ => return 5,
    }
    Node.shutdown();
    let restart = configured_at("127.0.0.1:0");
    if !starts(restart) {
        return 6;
    }
    Node.shutdown();
    let _ = fs.delete(key_path() + ".hew-state");
    let _ = fs.delete(key_path());
    0
}
