// Accept fixture (NEW-6c): `await conn.read() | after d` — peer writes
// before the long deadline, so the suspending read resolves to
// `Ok(bytes)` and the deadline timer is cancelled without a spurious timeout.
//
// Exit-code contract: read-before-deadline valid UTF-8 -> 42; timeout Err -> 7;
// invalid UTF-8 -> 8; no actor exit -> main fallback 99.
import std.encoding.utf8;

import std.net.{Listener};

actor Reader {
    let port: i32,
    receive fn go() {
        sleep(100ms);
        let conn = match net.connect(f"127.0.0.1:{port}") {
            .Ok(conn) => conn,
            .Err(_) => return,
        };
        let code = match await conn.read() | after 5s {
            .Ok(data) => match utf8.decode(data) {
                .Ok(_text) => 42,
                .Err(_error) => 8,
            },
            .Err(_e) => 7,
        };
        exit(code);
    }
}

fn main() {
    let listener = match net.listen("127.0.0.1:0") {
        .Ok(listener) => listener,
        .Err(_) => return,
    };
    let port = listener.local_port() as i32;
    let reader = spawn Reader(port: port);
    reader.go();
    let client = listener.accept();
    let _ = client.write_string("hello-from-server");
    sleep(500ms);
    let _ = client.close();
    exit(99);
}
