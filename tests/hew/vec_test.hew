// ── min_i32 ───────────────────────────────────────────────────────────────
#[test]
fn test_min_i32_several_elements() {
    var v: Vec<i32> = Vec.new();
    v.push(3);
    v.push(1);
    v.push(2);
    assert(vec.min_i32(v).unwrap_or(-999) == 1);
}

#[test]
fn test_min_i32_single_element() {
    var v: Vec<i32> = Vec.new();
    v.push(42);
    assert(vec.min_i32(v).unwrap_or(-999) == 42);
}

#[test]
fn test_min_i32_all_same() {
    var v: Vec<i32> = Vec.new();
    v.push(5);
    v.push(5);
    v.push(5);
    assert(vec.min_i32(v).unwrap_or(-999) == 5);
}

#[test]
fn test_min_i32_min_is_first() {
    var v: Vec<i32> = Vec.new();
    v.push(1);
    v.push(9);
    v.push(7);
    assert(vec.min_i32(v).unwrap_or(-999) == 1);
}

#[test]
fn test_min_i32_min_is_last() {
    var v: Vec<i32> = Vec.new();
    v.push(9);
    v.push(7);
    v.push(1);
    assert(vec.min_i32(v).unwrap_or(-999) == 1);
}

