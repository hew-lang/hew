// A `let`-bound borrowed `get` ends its loan where the collection is next
// taken, and only where control has not diverged since. A drain inside a
// conditional would leave the loan live on the other path, so it meets the
// loan instead.
#[resource]
type Tok {
    id: i64,
}

impl Tok {
    fn close(consume self) {
        println(f"close {self.id}");
    }
}

fn main() {
    var v: Vec<Tok> = Vec.new();
    v.push(Tok { id: 1 });
    let first = v.get(0);
    if v.len() > 0 {
        for e in v.into_iter() {
            e.close();
        }
    }
    println("done");
}
