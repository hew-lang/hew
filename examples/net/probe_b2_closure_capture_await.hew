import std.net.{Listener};

extern "C" {
    fn hew_tcp_listener_local_port(listener: Listener) -> i32;
}

actor Reader {
    let addr: string,

    receive fn go(unused: i64) {
        sleep(200ms);
        let conn = match net.connect(addr) {
            .Ok(conn) => conn,
            .Err(_) => panic(f"network setup failed"),
        };
        let read_once = || {
            await conn.read_string()
        };
        let body = read_once();
        println(f"reader-received: {body}");
        let _ = conn.close();
    }
}

fn main() {
    let listener = match net.listen("127.0.0.1:0") {
        .Ok(listener) => listener,
        .Err(_) => panic(f"network setup failed"),
    };
    let port = unsafe {
        hew_tcp_listener_local_port(listener)
    };
    let reader = spawn Reader(addr: f"127.0.0.1:{port}");
    reader.go(0);
    let client = listener.accept();
    let _ = client.write_string("hello-from-server");
    sleep(500ms);
    let _ = client.close();
    println("server-done");
}
