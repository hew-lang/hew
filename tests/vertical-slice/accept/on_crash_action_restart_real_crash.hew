// A REAL crash fires the `#[on(crash)]` hook, which reads the owned
// `CrashInfo.message` the runtime handed it and asks for a restart.
//
// Teeth: the crash message reaches the hook as an owned `string` cloned from a
// borrowed C string. A wrong clone/drop ABI aborts the runtime the instant the
// hook runs on a real crash (exit 134, libc::abort from
// validate_cstring_header); a message that arrives empty takes the `Kill` arm,
// leaving the role spent so the read below is `.Err` and the program exits 1.
// Only a correct clone reaches `Restart`, and only a completed restart makes
// `await_restart` resolve a Live role.
//
// Exit 42 is the replacement's init value: the supervisor reconstructs every
// incarnation from the declaration and its config, so a restarted child carries
// the declared state and never the dead instance's.
//
// Verified ASan/guard-malloc clean on the crash+restart path (no double-free,
// no leak, no OOB) - see the on_crash_action_restart_real_crash gate in
// scripts/asan-fixture-check.sh (Linux) and the macOS leaks oracle.
import std.failure;

actor Worker {
    var value: i64,
    receive fn get() -> i64 {
        value
    }
    receive fn boom() {
        panic("forced crash to fire on(crash)");
    }
    #[on(crash)]
    fn on_crash(info: CrashInfo) -> CrashAction {
        // Read the cloned owned message. A correctly-cloned crash message is
        // non-empty. A garbage read (a move-of-borrow or a headerless drop)
        // either aborts before reaching here or yields a nonsense length, takes
        // the Kill arm and leaves the role spent.
        if !info.message.is_empty() {
            CrashAction.Restart
        } else {
            CrashAction.Kill
        }
    }
}

supervisor App {
    strategy: one_for_one,
    intensity: 5 within 60s,

    child w: Worker(value: 42),
}

fn main() -> i64 {
    let sup = spawn App;
    let w = sup.w;
    // Crash the child (fire-and-forget tell, processed in mailbox order). The
    // supervisor fires Worker__on_crash on the real trap; the hook clones +
    // reads info.message and returns Restart.
    let _ = w.boom();
    // Suspend until the restarted child's slot is Live again, then re-fetch it.
    // This only completes if on_crash returned Restart AND the runtime survived
    // the crash-message clone/drop without aborting.
    let w2 = await_restart sup.w;
    match w2.get() {
        .Ok(n) => n, // 42 - the replacement re-ran the declared init.
        .Err(_) => 1, // Kill left the role spent: the message did not arrive.
    }
}
