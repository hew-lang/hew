machine Session {
    events { Pause { divisor: i64; } Resume; }
    emits { Pending { label: string; } }
    state Closed { value: i64; }
    state Active {
        state Reviewing {
            label: string;
            exit { state.label += ":staged"; }
        }
        initial Reviewing { label: "fresh" };
    }
    on Pause: Active => Closed {
        emit Pending { label: state.label + ":output" };
        Closed { value: 10 / event.divisor }
    }
    on Resume: Closed => Active history;
    default { state }
}

fn main() {
    var session: Session = .Reviewing { label: "original".to_upper() };
    let before = session;
    defer {
        // The acceptance harness requires this complete value comparison to print true.
        println(session == before);
        match session {
            .Reviewing { label } => println("capture rollback:" + label),
            _ => panic("history capture committed on failure"),
        }
    }
    let _report = session.step(.Pause { divisor: 0 });
}
