// Runnable fixture: generic stdlib Lifecycle<T> state machine.
import std.concurrency.lifecycle.{Lifecycle};

fn main() {
    var service: Lifecycle<i64> = .Created;
    println(service.state_name());
    service.step(Lifecycle.Event.Initialise);
    println(service.state_name());
    service.step(Lifecycle.Event.Started { handle: 42 });
    println(service.state_name());
    service.step(Lifecycle.Event.Stop);
    println(service.state_name());
    service.step(Lifecycle.Event.Stop);
    println(service.state_name());
    var crashing: Lifecycle<i64> = .Created;
    println(crashing.state_name());
    crashing.step(Lifecycle.Event.Initialise);
    println(crashing.state_name());
    let err = Error.Code(7);
    crashing.step(Lifecycle.Event.Crashed { error: err });
    println(crashing.state_name());
}
