//! Tests for std::os environment-variable validation.

import std.os;

import std.observe;

#[test]
fn test_set_env_rejects_empty_name() {
    match os.set_env("", "value") {
        .Ok(_) => panic("expected empty environment name rejection"),
        .Err(err) => match err {
            EnvError.InvalidName(name) => assert(name == ""),
        },
    }
}

#[test]
fn test_remove_env_rejects_equals_in_name() {
    match os.remove_env("HEW=INVALID") {
        .Ok(_) => panic("expected invalid environment name rejection"),
        .Err(err) => match err {
            EnvError.InvalidName(name) => assert(name == "HEW=INVALID"),
        },
    }
}

#[test]
fn test_env_error_display_names_the_rejected_name() {
    let err = EnvError.InvalidName("HEW=INVALID");
    assert(to_string(err) == "invalid environment variable name: `HEW=INVALID`");
}

#[test]
#[serial]
fn test_env_distinguishes_unset_from_empty_values() {
    let name = "HEW_RESULT_ONLY_ST2A";
    let _ = os.remove_env(name);
    assert(os.env(name).is_none());
    match os.set_env(name, "") {
        .Ok(()) => {},
        .Err(_) => panic("expected environment variable to be set"),
    }
    match os.env(name) {
        .Some(value) => assert(value == ""),
        .None => panic("expected an explicitly empty environment value"),
    }
    let _ = os.remove_env(name);
}

#[test]
fn test_observe_read_reports_unknown_metrics_as_none() {
    assert(observe.read("hew.result_only_st2a.unknown").is_none());
}
