// A lambda is an ordinary callable value: it is built, passed to a function
// that takes a callable, and called there through the same indirect path both
// engines use.
fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn apply_twice(f: fn(i64) -> i64, x: i64) -> i64 {
    f(f(x))
}

fn main() {
    let square = |x: i64| x * x;
    let negate = |x: i64| 0 - x;
    println(apply(square, 5));
    println(apply(negate, 42));
    println(apply_twice(square, 3));
}
