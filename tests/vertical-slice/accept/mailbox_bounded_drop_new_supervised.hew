// Nonblocking submissions exercise the bounded mailbox; a completion call observes its drain.
actor MailboxWorker {
    var processed: i64,

    mailbox 4 overflow drop_new,
    receive fn process(value: i32) {
        sleep(20ms);
        processed = processed + 1;
    }
    receive fn report() -> i64 {
        processed
    }
}

supervisor MailboxSupervisor {
    strategy: one_for_one,
    intensity: 3 within 60s,

    child w1: MailboxWorker(processed: 0),
}

fn main() -> i64 {
    let sup = spawn MailboxSupervisor;
    let w = sup.w1;
    let inbox = mailbox(w, on_full: .DropNewest);
    for i in 0 .. 20 {
        let _ = inbox.process(i);
    }
    let result = w.report();
    let final_count = match result {
        .Ok(value) => value,
        .Err(_) => panic("report failed"),
    };
    if final_count > 0 && final_count < 20 {
        0
    } else {
        1
    }
}
