// Stream operations that consume their source retain exactly one owner through
// checked receive, collection and cleanup; borrowed operations keep the caller's
// handle usable.
//
// `sink.send` borrows the sink and the item; `sink.close`, `input.collect` and
// `input.close` each consume their handle. Collection drains through ordinary
// source iteration and closes the stream. `stream.forward` consumes both halves at
// once. Each frame runs inside a loop body so a boundary that released twice,
// or not at all, shows up as a fault or a leak rather than as a wrong string.
import std.stream;

fn collected(round: i64) -> string {
    let (sink, input) = match stream.pipe(8) {
        .Ok(pair) => pair,
        .Err(error) => panic(error),
    };
    sink.send(f"round-{round}").expect("send");
    sink.send("|").expect("send");
    // Closing consumes the sink endpoint.
    sink.close();
    // A consuming collect drains and closes the stream; the caller owns its result.
    input.collect()
}

fn forwarded(round: i64) -> i64 {
    let (source_sink, source) = match stream.pipe(8) {
        .Ok(pair) => pair,
        .Err(error) => panic(error),
    };
    let (dest_sink, dest) = match stream.pipe(8) {
        .Ok(pair) => pair,
        .Err(error) => panic(error),
    };
    source_sink.send(f"payload-{round}").expect("send");
    source_sink.close();
    // Both halves are consumed by the one call.
    stream.forward(source, dest_sink);
    let text = dest.collect();
    text.len()
}

fn abandoned(round: i64) -> i64 {
    let (sink, input) = match stream.pipe(8) {
        .Ok(pair) => pair,
        .Err(error) => panic(error),
    };
    sink.send(f"unread-{round}").expect("send");
    sink.close();
    // Closing the undrained stream releases the queued item exactly once.
    input.close();
    round
}

fn main() {
    var round = 0;
    while round < 4 {
        println(collected(round));
        println(f"forwarded {forwarded(round)}");
        println(f"abandoned {abandoned(round)}");
        round = round + 1;
    }
}
