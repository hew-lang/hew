fn main() -> i64 {
    var source: HashMap<string, Vec<string>> = HashMap.new();
    source.insert("label".to_upper(), ["payload".to_upper()]);
    let keys = source.keys();
    let values = source.values();
    let entries = source.entries();
    source.clear();
    let (key, value) = entries[0];
    println(keys[0]);
    println(values[0][0]);
    println(key);
    println(value[0]);
    0
}
