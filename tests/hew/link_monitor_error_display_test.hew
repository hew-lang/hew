//! Display coverage for std.link_monitor.MonitorError.

import std.link_monitor.{MonitorError};

#[test]
fn test_monitor_error_display_formats_each_variant() {
    assert(to_string(MonitorError.NodeNotRunning) == "no distributed node runtime is active");
    assert(to_string(MonitorError.Partition) == "the route to the monitored peer is unavailable or the peer is suspect");
    assert(to_string(MonitorError.ResourceExhausted) == "the runtime exhausted its non-reusing monitor-id space");
}
