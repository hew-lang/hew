actor Example {
    var data: Vec<i64> = Vec.new(),
    receive fn demo() {
        let ref1 = data;
        let ref2 = data;
        ref1.push(1);
        ref2.push(2);
        println(data.len());
        println(ref1.len());
        println(ref2.len());
    }
}
fn main() {
    let e = spawn Example();
    e.demo();
}
