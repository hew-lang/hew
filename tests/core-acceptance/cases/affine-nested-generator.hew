enum Choice { Values(Generator<string, ()>, i64), Empty }

gen fn words(label: string) -> string {
    defer println(label + " cleaned");
    yield label;
    yield "later";
}

fn started(label: string) -> Generator<string, ()> {
    let values = words(label);
    match await values.next() { .Some(value) => println(value), .None => panic("empty"), }
    values
}

fn drive(consume choice: Option<Choice>) -> string {
    match choice {
        .Some(.Values(_, 0)) => "zero",
        .Some(.Values(values, weight)) if weight > 10 => "heavy",
        .Some(.Values(values, weight)) => {
            var out = "";
            for value in values { out = out + value + ","; }
            f"{out}{weight}"
        }
        .Some(.Empty) => "empty",
        .None => "none",
    }
}

fn main() {
    println(await drive(Some(Choice.Values(await started("first"), 7))));
    println(await drive(Some(Choice.Values(await started("zero"), 0))));
    println(await drive(Some(Choice.Values(await started("heavy"), 11))));
    println(await drive(Some(Choice.Empty)));
    println(await drive(None));
    println("done");
}
