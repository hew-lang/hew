import std.net.quic;

fn main() {
    match quic.new_server("not-an-address") {
        .Err(.Protocol(detail)) => assert(!detail.is_empty()),
        _ => panic("invalid listener address must fail construction"),
    }
    match quic.new_client_with_ca("not a certificate") {
        .Err(.Protocol(detail)) => assert(!detail.is_empty()),
        _ => panic("invalid trust must fail construction"),
    }
    let endpoint = quic.new_client().expect("client endpoint");
    match endpoint.connect("not-an-address", "localhost") {
        .Err(.Protocol(detail)) => assert(detail.contains("parse failure")),
        _ => panic("invalid connection address must not produce a handle"),
    }
    assert(endpoint.observe().local_addr.contains(":"));
    endpoint.close();
    println("absent QUIC handles rejected");
}
