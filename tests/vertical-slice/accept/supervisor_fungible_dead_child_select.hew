// F-04 fail-closed guard for the SELECT-ask path: a `select` arm asking a
// fungible reference to a PERMANENTLY-DEAD child fail-closes recoverably — the
// dead-child arm is skipped (it never becomes ready), so the select falls
// through to its `after` arm. It NEVER traps the program.
//
// The budget is intensity 1: a sustained crash loop exhausts it, so the child
// ends permanently Dead (BudgetExhausted) and will never restart again. Each
// crash drives through the SAME held fungible handle, re-resolving to the
// current child.
//
// Once the child is down, a single-shot ask returns Err (the recoverable arm,
// 20) and the select's dead-child ask arm is skipped so the `after 100ms` arm
// wins (25). The printed `46` = 20 + 25 + 1 is the sentinel proving BOTH the
// single-shot ask Err'd AND the select reached its after arm — neither trapped.
// Pre-F-04 the select-ask through the dead handle issued a failed setup status
// that codegen treated as process-fatal (HEW_TRAP_ACTOR_SEND_FAILED → SIGTRAP,
// exit 133), even though the tell + single-shot ask siblings already
// fail-closed.
//
// The sentinel is printed, not returned: exhausting a ROOT supervisor's restart
// budget leaves the fault unrecovered at the top of the supervision tree, so it
// owns the process exit status (HEW-SPEC-2026 §5.8, exit 1). Exit 1 versus a
// SIGTRAP's 133 still carries the no-trap claim.
actor Worker {
    var value: i64 = 5,
    receive fn get_value() -> i64 {
        value
    }
    receive fn crash_me() {
        panic("worker crash");
    }
}

supervisor App {
    strategy: one_for_one,
    intensity: 1 within 60s,

    child w1: Worker(value: 5),
}

fn main() -> i64 {
    let sup = spawn App;
    let w = sup.w1;
    // Crash until the child is PERMANENTLY dead, observing the effect rather
    // than assuming a fixed number of sleeps reaches it. A wall-clock loop is
    // load-sensitive: under a busy machine the restarts had not yet exhausted
    // the budget when the asks below ran, and the fixture asserted its sentinel
    // against a LIVE child.
    var attempts: i64 = 0;
    var dead = false;
    while attempts < 30 && !dead {
        let alive = match await w.get_value() {
            .Ok(_) => true,
            .Err(_) => false,
        };
        if alive {
            w.crash_me();
            sleep(120ms);
        } else {
            dead = true;
        }
        attempts = attempts + 1;
    }
    // Make a failed precondition legible: the stdout diff then names the reason
    // instead of only showing a wrong sentinel.
    if !dead {
        println("PRECONDITION_CHILD_STILL_ALIVE");
    }
    sleep(200ms);

    // Single-shot ask to a permanently-dead child: recoverable Err, NOT a trap.
    let ask_code = match await w.get_value() {
        .Ok(_) => 1,
        .Err(_) => 20,
    };
    // Select-ask through the same dead fungible handle: the dead-child arm is
    // skipped (never ready), so the `after` arm wins — NOT a trap.
    let select_code = select {
        reply from w.get_value() => reply,
        after 100ms => 25,
    };
    let sentinel = if ask_code == 20 && select_code == 25 {
        46
    } else {
        ask_code + select_code
    };
    println(f"DEAD_CHILD_SELECT:{sentinel}");
    0
}
