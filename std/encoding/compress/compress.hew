// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    fn hew_gzip_compress_hew(data: bytes) -> bytes;
    fn hew_gzip_decompress_hew(data: bytes, max_output_len: i64) -> bytes;
    fn hew_deflate_compress_hew(data: bytes) -> bytes;
    fn hew_deflate_decompress_hew(data: bytes, max_output_len: i64) -> bytes;
    fn hew_zlib_compress_hew(data: bytes) -> bytes;
    fn hew_zlib_decompress_hew(data: bytes, max_output_len: i64) -> bytes;
    fn hew_compress_last_error() -> string;
}
