import std.stream;

actor Worker {
    receive fn deliver(pair: (stream.Stream<i64>, i64)) {
        let (rx, n) = pair;
        rx.close();
        println(f"worker got {n}");
    }
}

fn main() {
    let (tx, rx): (stream.Sink<i64>, stream.Stream<i64>) = match stream.pipe(4) { .Ok(pair) => pair, .Err(error) => panic(error), };
    tx.close();
    let w = spawn Worker;
    let _ = w.deliver((rx, 99));
    println("done");
}
