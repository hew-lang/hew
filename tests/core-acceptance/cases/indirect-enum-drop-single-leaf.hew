indirect enum Tree { Leaf(i64), Node(Tree, Tree), }
fn val(t: Tree) -> i64 { match t { .Leaf(n) => n, .Node(l, r) => val(l) + val(r), } }
fn run_loop() -> i64 {
    var total = 0;
    for i in 0..50 {
        let t = Tree.Leaf(5);
        total = total + val(t);
    }
    total
}
fn main() {
    let r = run_loop();
    if r == 250 { print("ok"); } else { print("BAD"); }
}
