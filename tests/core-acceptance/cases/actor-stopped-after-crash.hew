#[resource]
type ReaderState {
    label: string;
}

impl ReaderState {
    fn close(consume self) {
        panic("reader state close failed");
    }
}

actor Reader {
    receive fn feed(text: string) -> string {
        if text == "boom" {
            panic("bad frame");
        }
        text
    }
}

actor ClosingReader {
    let state: ReaderState = ReaderState { label: "active" };

    receive fn feed(text: string) -> string {
        if text == "boom" {
            panic("bad frame");
        }
        text
    }
}

fn main() {
    let reader = spawn Reader;
    match reader.feed("boom") {
        .Err(.Trapped) => println("trapped"),
        _ => panic("expected trapped handler"),
    }
    stopped(reader);
    println("after crash-only stopped");

    let closing_reader = spawn ClosingReader;
    match closing_reader.feed("boom") {
        .Err(.Trapped) => println("trapped"),
        _ => panic("expected trapped handler"),
    }
    assert(scope {
        stopped(closing_reader);
        false
    } handle failure {
        match failure {
            .Fault { message } => {
                assert(message.contains("reader state close failed"));
                println("caught close fault");
                true
            }
            .Deadline { message } => panic(message),
        }
    });
    println("after cleanup stopped");
    match closing_reader.feed("x") {
        .Err(.Dead) => println("dead"),
        _ => panic("crashed actor must remain dead"),
    }
}
