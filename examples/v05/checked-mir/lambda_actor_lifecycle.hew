// MIR-corpus fixture: lambda-actor creation, tell, ask, and scope-exit
// release.
//
// Pins `hew_lambda_actor_new`, `hew_lambda_actor_send`, the
// callable-ask reply path, and the handle release emitted by drop
// elaboration at scope exit (`hew_lambda_actor_release` family).
// `await handle.close()` is omitted: the explicit-close MIR producer
// arm (`hew_duplex_close`) is not wired yet and refuses fail-closed.
//
// One mailbox owns stdout. Both lines are tells to `out`, so mailbox FIFO
// order IS the printed order. Printing the ask reply from `main` instead
// pinned one of two legal interleavings: a tell to a second actor carries
// no happens-before edge to anything `main` does afterwards, so that
// actor's `println` raced main's and CI observed the reverse order.
fn main() {
    let out = actor |line: i64| {
        println(line);
    };
    let _ = out.send(42);
    let factor = 7;
    let scale = actor |n: i64| -> i64 {
        n * factor
    };
    let a = scale(3);
    match a {
        .Ok(v) => {
            let _ = out.send(v);
        },
        .Err(_) => {
            let _ = out.send(-1);
        },
    }
}
