// Selected values and captured copies survive their parent's lexical scope.
import std.encoding.yaml;

fn early_exit(flag: bool) {
    var value = yaml.object();
    value.set("n", yaml.from_int(11)).expect("set succeeds");
    let child = value.get_field("n").expect("get_field succeeds").expect("get_field returns a value");
    if flag {
        return;
    }
    println(child.get_int().expect("get_int succeeds"));
}

fn _panic_exit() {
    var value = yaml.object();
    value.set("n", yaml.from_int(12)).expect("set succeeds");
    let _child = value.get_field("n").expect("get_field succeeds").expect("get_field returns a value");
    panic("yaml value panic probe");
}

fn cancel_exit() {
    var value = yaml.object();
    value.set("n", yaml.from_int(13)).expect("set succeeds");
    let _child = value.get_field("n").expect("get_field succeeds").expect("get_field returns a value");
    var i: i64 = 0;
    while i < 2 {
        i = i + 1;
    }
}

actor YamlCancelDriver {
    receive fn drive() {
        scope {
            cancel_exit();
        };
    }
}

fn main() {
    let read = {
        var value = yaml.object();
        value.set("n", yaml.from_int(9)).expect("set succeeds");
        value.set("none", yaml.null()).expect("set succeeds");
        let child = value.get_field("n").expect("get_field succeeds").expect("get_field returns a value");
        || child.get_int().expect("get_int succeeds")
    };
    println(read());

    // A parse failure returns an error without an owning value payload.
    match yaml.parse("[") {
        .Ok(_) => panic("malformed YAML unexpectedly parsed"),
        .Err(_) => {},
    }
    early_exit(true);
}
