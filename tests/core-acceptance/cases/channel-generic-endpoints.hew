import std.stream;

fn numbers() -> Result<(stream.Sink<i64>, stream.Stream<i64>), string> {
    stream.pipe(2)
}

// This function has no suspension point. Physical verification must not
// require a coroutine merely because it contains a pipe receive.
fn receive_now(rx: stream.Stream<i64>) -> Option<i64> {
    rx.try_recv()
}

fn main() {
    let (tx, rx) = numbers().expect("integer pipe");
    let other_tx = tx.clone();
    assert(receive_now(rx).is_none());
    tx.send(73).expect("send");
    assert(receive_now(rx).expect("queued number") == 73);
    tx.close();
    other_tx.send(91).expect("send");
    assert(receive_now(rx).expect("other producer") == 91);
    other_tx.close();
    assert(receive_now(rx).is_none());
    rx.close();

    // Independent instantiations must retain different element types even
    // though both endpoints use the same pointer representation.
    let (text_tx, text_rx) = stream.pipe(2).expect("text pipe");
    text_tx.send("typed\0text").expect("send");
    text_tx.close();
    let text = text_rx.recv().expect("queued text");
    assert(text == "typed\0text");
    assert(text_rx.recv().is_none());
    text_rx.close();
    println("typed pipes and immediate receive");
}
