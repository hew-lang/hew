actor Sink {
    var hits: i64;

    receive fn take(v: bool) -> i64 {
        println(f"{v}");
        hits = hits + 1;
        hits
    }
}

fn main() {
    let x: bool = true;
    let s = spawn Sink(hits: 0);
    match await s.take(x) {
        Result.Ok(n) => println(f"hits {n}"),
        Result.Err(_) => println("err"),
    }
}
