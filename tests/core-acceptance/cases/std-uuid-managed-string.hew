import std.misc.uuid;
import std.net.ipnet;

fn main() {
    // A string returned by an extern is one owned managed value: readable on
    // its own, and readable as a concatenation operand.
    let id = uuid.v4();
    println(id.len());
    println(uuid.is_valid(id));

    let tagged = "id=" + uuid.v4();
    println(tagged.len());
    println(tagged.starts_with("id="));

    let seven = uuid.v7();
    println(seven.len());
    println(uuid.is_valid(seven));
    println(uuid.is_valid("not-a-uuid"));

    // Managed strings in both directions: borrowed argument, owned result.
    println(ipnet.cidr_network("10.0.0.5/24"));
    println(ipnet.cidr_broadcast("192.168.1.0/24") + "/32");
    println(ipnet.is_v4("127.0.0.1"));
    println(ipnet.is_v6("::1"));
    println(ipnet.is_private("10.1.2.3"));
    println(ipnet.cidr_contains("10.0.0.0/8", "10.1.2.3"));

    // Repeated production and release inside a loop leaves the producer usable.
    var total = 0;
    for i in 0..4 {
        total = total + uuid.v4().len();
    }
    println(total);
}
