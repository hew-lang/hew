// examples/distributed/kv_server.hew — authenticated KV service issuer
//
// Run both peers once without arguments to create their node keys and print
// their public credentials. Then exchange the credentials and run:
//   hew run examples/distributed/kv_server.hew <client-credential> [port]
//   hew run examples/distributed/kv_client.hew <server-credential> [host] [port]
// Keep the key files between runs. Start the client while this server listens.
// Enrol both printed credentials under one operator authority with
// `hew node admit --authority authority.key --credential HEX --output FILE`.
// Set HEW_NODE_CLUSTER to this node's enrolment file for communicating runs.
import std.net;

import std.os;

actor KeyValue {
    var store: HashMap<string, string>;

    #[wire]
    receive fn put(key: string, value: string) -> string {
        store.insert(key, value);
        "stored"
    }

    #[wire]
    receive fn get(key: string) -> string {
        match store.get(key) {
            .Some(value) => value,
            .None => "",
        }
    }
}

fn authenticated_peer(credential: string) -> net.PeerSession {
    for attempt in 0..2400 {
        match Node.peer(credential) {
            .Ok(peer) => return peer,
            .Err(_) => {
                if attempt == 2399 {
                    panic("authenticated KV client session did not arrive");
                }
                sleep(50ms);
            }
        }
    }
    panic("authenticated KV client session did not arrive");
}

fn main() {
    let args = os.args();
    let client_credential = match args.get(1) {
        .Some(value) => value,
        .None => "--identity",
    };
    let port = match args.get(2) {
        .Some(value) => value,
        .None => "9100",
    };
    var bind = "127.0.0.1:0";
    if client_credential != "--identity" {
        bind = f"127.0.0.1:{port}";
    }
    let config = NodeConfig { bind: bind, transport: NodeTransport.Tcp, key: "kv-server.key", cluster: os.env("HEW_NODE_CLUSTER") ?? "", seeds: [] };
    Node.start(config).expect("KV server node starts");
    println(f"[kv-server] public credential: {Node.identity_key()}");
    if client_credential == "--identity" {
        Node.shutdown();
        return;
    }
    let empty: HashMap<string, string> = HashMap.new();
    let store = spawn KeyValue { store: empty };
    // A registry name would provide discovery metadata only. This example
    // supplies call authority directly through the authenticated service grant.
    let peer = authenticated_peer(client_credential);
    let export = peer.export(store).expect("client accepts KeyValue service");
    println("[kv-server] KeyValue service offered to authenticated client");

    // Keep the export alive while the client performs its round trips.
    sleep(30s);
    export.close();
    Node.shutdown();
    println("[kv-server] shutdown complete");
}
