// stopped waits for stop hooks that finish before their child's deadline.
// A hook that runs past its deadline is terminated before stopped returns.
actor Worker {
    var name: string;
    #[on(start)]
    fn started() {
        println("start " + name);
    }
    #[on(stop)]
    fn stopping() {
        if name == "mid" {
            sleep(30ms);
        }
        if name == "slow" {
            sleep(200ms);
        }
        println("stop " + name);
    }
}

supervisor Waits {
    strategy: one_for_one;
    intensity: 10 within 60s;
    child quick: Worker { name: "quick" };
    child mid: Worker { name: "mid" } stop: 100ms;
}

supervisor Outlasted {
    strategy: one_for_one;
    intensity: 10 within 60s;
    child slow: Worker { name: "slow" } stop: 50ms;
}

fn main() {
    let waits = spawn Waits;
    let outlasted = spawn Outlasted;
    stop(waits);
    stopped(waits);
    println("stopped waits");
    stop(outlasted);
    stopped(outlasted);
    println("stopped outlasted");
    sleep(300ms);
}
