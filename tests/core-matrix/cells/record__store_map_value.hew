type Rec {
    a: i64;
    b: string;
}

fn main() {
    let x = Rec { a: 1, b: "x0" };
    let m: HashMap<string, Rec> = HashMap.new();
    m.insert("k", x);
    match m.get("k") {
        Option.Some(e) => {
            let e_a = e.a;
            let e_b = e.b;
            println(f"{e_a} {e_b}");
        },
        None => println("missing"),
    }
}
