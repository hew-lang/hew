fn identity -> i64
  statements:
    use BindingId(0) x site=SiteId(0) ty=i64 intent=Read
    return site=Some(SiteId(0)) ty=i64
  decisions:
    site=s0 ty=i64 value_class=BitCopy intent=Read strategy=BorrowRead why="first vertical-slice classifier"
    site=s0 ty=i64 value_class=BitCopy intent=Unknown strategy=ParamBoundary(ParamBoundaryFact { param_index: 0, param_count: 1, caller_visible_projection: false, mode: BorrowReadOnly }) why="checker-authoritative parameter boundary classification"
  blocks:
    id=0 kind=normal
      successor: none
  drop_plans:
    return[bb0] ->
      (none)

