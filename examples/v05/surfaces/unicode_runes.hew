//! Classify the Unicode scalars in a UTF-8 string.
fn classify(cp: char) -> string {
    match cp {
        c if c.is_whitespace() => "space",
        c if c.is_digit() => "digit",
        c if c.is_upper() => "upper",
        c if c.is_lower() => "lower",
        c if c.is_letter() => "letter",
        c if c.is_punctuation() => "punct",
        _ => "other",
    }
}

fn main() {
    let text = "Hé 9世!";
    println(f"runes={text.len()} bytes={text.byte_len()}");
    for cp in text.iter() {
        let kind = classify(cp);
        let upper = cp.to_upper().as_i64();
        println(f"cp={cp.as_i64()} width={cp.len_utf8()} kind={kind} upper_cp={upper}");
    }
}
