// Capturing a lambda actor handle in a closure must be refused until
// its environment transfer and cleanup are supported end to end.
// This checks the capture boundary rather than accepting a misrouted call.
// A future implementation must preserve the captured handle, deliver the
// argument to the actor body and release the environment correctly.
// Keep the refusal until those behaviours have execution coverage.
//
fn main() {
    let base = 100;
    let log = actor |n: i64| {
        println(f"sum={base + n}");
    };
    let relay = |n: i64| {
        log(n);
    };
    relay(1);
    sleep(100ms);
    println("done");
}
