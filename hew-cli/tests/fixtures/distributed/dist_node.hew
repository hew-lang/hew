fn scenario_server_monitor_close_reclaim() {
    // Registration is derived from the monotonic event counter, not a sampled
    // live count: a sleep-poll can miss a short-lived count==1 window under a
    // coarse host timer tick, while the cumulative total cannot be missed. The
    // total counts from process start: the client may register before this
    // scenario begins, so no baseline is sampled here.
    var registered: i64 = 0;
    var wait_attempts: i64 = 0;
    loop {
        let c = unsafe {
            hew_dist_monitor_remote_watcher_count()
        };
        if c > 1 {
            println(f"FAIL cross_node_monitor_close_reclaim unexpected-watcher-count={c}");
            return;
        }
        let total = unsafe {
            hew_dist_monitor_remote_watcher_registered_total()
        };
        registered = total;
        if registered > 1 {
            println(f"FAIL cross_node_monitor_close_reclaim unexpected-registered-total={registered}");
            return;
        }
        if registered == 1 {
            println(f"READY_SERVER_WATCHER_REGISTERED cross_node_monitor_close_reclaim count={registered}");
            break;
        }
        wait_attempts = wait_attempts + 1;
        if wait_attempts >= 200 {
            println(f"FAIL cross_node_monitor_close_reclaim server-no-watcher registered-total={registered}");
            return;
        }
        sleep(100ms);
    }
    var reclaim_attempts: i64 = 0;
    loop {
        let c = unsafe {
            hew_dist_monitor_remote_watcher_count()
        };
        if c == 0 {
            println(f"PASS cross_node_monitor_close_reclaim reclaimed={registered}");
            return;
        }
        reclaim_attempts = reclaim_attempts + 1;
        if reclaim_attempts >= 200 {
            println(f"FAIL cross_node_monitor_close_reclaim reclaim-timeout count={c}");
            return;
        }
        sleep(100ms);
    }
}

fn scenario_client_monitor_close_reclaim(kv: KeyValue) -> i64 {
    let probe = spawn MonitorCloseProbe;
    match probe.register_and_close(kv) {
        Result.Err(_) => {
            println("FAIL cross_node_monitor_close_reclaim probe-error");
            2
        }
        Result.Ok(status) => {
            if status != 0 {
                println("FAIL cross_node_monitor_close_reclaim setup-error");
                return 1;
            }
            0
        }
    }
}

fn scenario_server_monitor_leak(kx: string, scenario: string, expected: i64) {
    // Registration is derived from the monotonic event counter, not a sampled
    // live count: each client cycle holds its registration open only briefly,
    // and a sleep-poll under a coarse host timer tick (default Windows ~15.6ms)
    // can phase-lock with the cycles and miss every count==1 window. The
    // cumulative total cannot be missed. The sampled count keeps only its
    // over-registration tooth (count > 1), which can never false-fail.
    var attempts: i64 = 0;
    loop {
        let count = unsafe {
            hew_dist_monitor_remote_watcher_count()
        };
        if count > 1 {
            println(f"FAIL {scenario} target-count={count}");
            return;
        }
        if fs.exists(f"{kx}/leak.done") {
            break;
        }
        attempts = attempts + 1;
        if attempts >= 20000 {
            println(f"FAIL {scenario} client-timeout");
            return;
        }
        sleep(2ms);
    }
    // leak.done is published only after every register/close cycle has been
    // acked, so the counter is final here: exactly one registration per cycle.
    let total = unsafe {
        hew_dist_monitor_remote_watcher_registered_total()
    };
    let registered = total;
    if registered != expected {
        println(f"FAIL {scenario} registered-total={registered} expected={expected}");
        return;
    }
    var cleanup_attempts: i64 = 0;
    loop {
        let count = unsafe {
            hew_dist_monitor_remote_watcher_count()
        };
        if count == 0 {
            publish_atomic(kx, "leak.verdict", "target=0");
            println(f"PASS {scenario} iterations={expected} target=0 max=1");
            return;
        }
        cleanup_attempts = cleanup_attempts + 1;
        if cleanup_attempts >= 5000 {
            println(f"FAIL {scenario} target-cleanup={count}");
            return;
        }
        sleep(2ms);
    }
}

fn scenario_client_monitor_leak(kv: KeyValue, kx: string, scenario: string, iterations: i64) -> i64 {
    let probe = spawn MonitorLeakProbe { down_count: 0 };
    match probe.run(kv, iterations) {
        Result.Err(_) => {
            println(f"FAIL {scenario} probe-ask-error");
            2
        }
        Result.Ok(completed) => {
            if completed != iterations {
                println(f"FAIL {scenario} completed={completed}");
                return 3;
            }
            publish_atomic(kx, "leak.done", to_string(iterations));
            let verdict = wait_for_file(f"{kx}/leak.verdict");
            if verdict != "target=0" {
                println(f"FAIL {scenario} target-verdict={verdict}");
                return 4;
            }
            println(f"PASS {scenario} iterations={iterations} closed={completed} down=0 local=0 target=0 ids=distinct");
            0
        }
    }
}

fn scenario_quarantine_rejoin() -> i64 {
    let peer: u16 = 4242;
    let alive: i32 = 0;
    let dead: i32 = 2;
    unsafe {
        hew_dist_inject_swim_gossip(peer, alive, 5)
    };
    unsafe {
        hew_dist_inject_swim_gossip(peer, dead, 5)
    };
    let state_after_verdict = unsafe {
        hew_dist_member_state(peer)
    };
    if state_after_verdict != 2 {
        println("FAIL quarantine_rejoin not-dead-after-verdict");
        return 2;
    }
    let quarantined_after_verdict = unsafe {
        hew_dist_quarantine_contains(peer)
    };
    if quarantined_after_verdict != 1 {
        println("FAIL quarantine_rejoin not-quarantined-after-verdict");
        return 3;
    }
    unsafe {
        hew_dist_inject_swim_gossip(peer, alive, 5)
    };
    unsafe {
        hew_dist_inject_swim_gossip(peer, alive, 4)
    };
    let state_after_stale = unsafe {
        hew_dist_member_state(peer)
    };
    if state_after_stale != 2 {
        println("FAIL quarantine_rejoin resurrected-by-stale");
        return 4;
    }
    let quarantined_after_stale = unsafe {
        hew_dist_quarantine_contains(peer)
    };
    if quarantined_after_stale != 1 {
        println("FAIL quarantine_rejoin quarantine-cleared-by-stale");
        return 5;
    }
    println("PASS quarantine_rejoin stale-rejected");
    unsafe {
        hew_dist_inject_swim_gossip(peer, alive, 6)
    };
    let state_after_rejoin = unsafe {
        hew_dist_member_state(peer)
    };
    if state_after_rejoin != 0 {
        println("FAIL quarantine_rejoin not-readmitted-at-higher");
        return 6;
    }
    let quarantined_after_rejoin = unsafe {
        hew_dist_quarantine_contains(peer)
    };
    if quarantined_after_rejoin != 0 {
        println("FAIL quarantine_rejoin not-evicted-after-readmission");
        return 7;
    }
    println("PASS quarantine_rejoin readmitted-at=6");
    0
}

