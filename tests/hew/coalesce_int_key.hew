//! Coalesce regression: integer keys replace in place and keep the newest
//! payload without growing the logical queue beyond capacity.

import std.stream;
import std.testing;

actor IntCoalescer {
    var processed: i64 = 0,
    var latest: i64 = -1,

    mailbox 1 overflow coalesce(id) fallback drop_new,

    // Holds the actor: reports that it is running, then waits for its gate.
    receive fn hold(started: stream.Sink<i64>, gate: stream.Stream<i64>) {
        started.send(1).expect("started");
        gate.recv();
    }

    receive fn update(id: i64, value: i64) {
        processed = processed + 1;
        latest = value;
    }

    receive fn count() -> i64 {
        processed
    }

    receive fn value() -> i64 {
        latest
    }
}

#[test]
fn coalesce_int_key_latest_wins() {
    let worker = spawn IntCoalescer(processed: 0, latest: -1);
    let intake = mailbox(worker);
    let (started_tx, started) = stream.pipe(1).expect("started");
    let (release, gate) = stream.pipe(1).expect("gate");
    let _ = intake.hold(started_tx, gate);
    started.recv();
    let _ = intake.update(7, 1);
    let _ = intake.update(7, 2);
    let _ = intake.update(7, 3);
    let _ = intake.update(7, 4);
    release.send(1).expect("release");
    match worker.count() {
        .Ok(value) => testing.assert_eq(value, 1),
        .Err(_) => testing.assert_true(false),
    }
    match worker.value() {
        .Ok(value) => testing.assert_eq(value, 4),
        .Err(_) => testing.assert_true(false),
    }
}
