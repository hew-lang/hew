// Accept: user functions returning Outcome<i64, i64> Ok and Err variants.
// Exercises two-type-parameter generic enum composite return.
// Exit 106 = Ok(7) + Err(99) proves both arms dispatch correctly.
enum Outcome<T, E> {
    Ok(T),
    Err(E),
}

fn success() -> Outcome<i64, i64> {
    Outcome.Ok(7)
}

fn failure() -> Outcome<i64, i64> {
    Outcome.Err(99)
}

fn main() -> i64 {
    let a = success();
    let b = failure();
    let x = match a {
        Outcome.Ok(v) => v,
        Outcome.Err(e) => e,
    };
    let y = match b {
        Outcome.Ok(v) => v,
        Outcome.Err(e) => e,
    };
    x + y
}
