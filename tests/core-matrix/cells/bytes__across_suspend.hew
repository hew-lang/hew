actor Holder {
    var ready: bool;

    receive fn hold(v: bytes) -> i64 {
        sleep(2ms);
        let v_l = v.len();
        let v_0 = v[0];
        println(f"len={v_l} b0={v_0}");
        ready = true;
        1
    }
}

fn main() {
    let x: bytes = bytes.new();
    x.push(65);
    x.push(66);
    let h = spawn Holder(ready: false);
    match await h.hold(x) {
        Result.Ok(n) => println(f"held {n}"),
        Result.Err(_) => println("err"),
    }
}
