//! Vec<isize> must share the canonical platform-sized integer Vec ABI.

fn first_isize<T>(xs: Vec<T>) -> T {
    xs[0]
}

#[test]
fn test_generic_vec_isize_push_get_pop() {
    var values: Vec<isize> = Vec.new();
    let first: isize = 41;
    let second: isize = 42;
    values.push(first);
    values.push(second);
    assert((first_isize(values) as i64) == 41);
    assert((values[1] as i64) == 42);
    assert((values.pop() as i64) == 42);
}
