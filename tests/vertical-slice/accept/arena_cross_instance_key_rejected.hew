import std::arena;

fn main() {
    let left: arena.Arena<string> = arena.new();
    let right: arena.Arena<string> = arena.new();

    let left_key = left.insert("left");
    let right_key = right.insert("right");

    println(left.get(right_key).is_none());
    println(right.get(left_key).is_none());
    println(!left.contains(right_key));
    println(left.remove(right_key).is_none());
    println(left.get(left_key).unwrap());
    println(right.get(right_key).unwrap());
}
