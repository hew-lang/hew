// Compiler corpus fixture: suspend/coro — actor spawn + ask + await.
//
// Collects actor spawn, ask, await, and suspension source shapes for compiler
// checking and raw-MIR parity. Focused coroutine/codegen tests own frame and
// resume-dispatch invariants.
actor Adder {
    var base: i64 = 0,
    receive fn set_base(n: i64) {
        base = n;
    }
    receive fn add(n: i64) -> i64 {
        base + n
    }
}

fn main() {
    let a = spawn Adder(base: 10);
    a.set_base(100);
    let r = await a.add(42);
    match r {
        .Ok(v) => println(v),
        .Err(_) => println(-1),
    }
}
