//! A user type may be named `Sink`; the substrate endpoint is the one
//! `std.stream` declares. The real endpoint still satisfies the parameter
//! (the control below raises no diagnostic), while the user record is refused
//! with both spellings named.

import std.stream as pipes;

pub type Sink<T> {
    tag: T,
}

fn wants_endpoint(tx: pipes.Sink<i64>) {
    tx.close();
}

fn main() {
    let opened = pipes.pipe<i64>(4);
    match opened {
        .Ok(parts) => {
            let (tx, rx) = parts;
            wants_endpoint(tx);
            rx.close();
        }
        .Err(reason) => println(reason),
    }
    wants_endpoint(Sink { tag: 3 });
}
