actor Sink {
    var hits: i64;

    receive fn take(v: string) -> i64 {
        println(f"{v}");
        hits = hits + 1;
        hits
    }
}

fn main() {
    let x: string = "ab";
    let s = spawn Sink(hits: 0);
    match await s.take(x) {
        Result.Ok(n) => println(f"hits {n}"),
        Err(_) => println("err"),
    }
}
