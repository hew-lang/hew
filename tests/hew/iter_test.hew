//! Tests for std::iter's lazy adapters and terminals, driven over the
//! `Vec<T>::into_iter()` surface — string and f64 element types (the i64
//! case is covered by `vec_iter_test.hew`).
//!
//! These behaviours previously lived on the eager per-type table
//! (`map_str`, `filter_f64`, `count_str`, ...), retired once the lazy
//! `Iterator` surface could drive a `Vec` end-to-end. Each case below
//! preserves the original edge-case coverage (empty-vec, negative-`n`
//! clamping, short-circuit, prefix-match predicates) through the generic
//! adapters instead of a type-specific function name.

import std.iter;

import std.testing;

type Claim {
    run_id: string,
    amount: i64
}

type ClaimsLedger {
    claims: Vec<Claim>,
    terminal_runs: Vec<string>
}

// ── map ────────────────────────────────────────────────────────────────────
#[test]
fn test_map_str_transforms_each_element() {
    let v: Vec<string> = Vec.new();
    v.push("hello");
    v.push("world");
    let result = iter.collect(iter.map(v.into_iter(), |s: string| s + "!"));
    testing.assert_eq(result.len(), 2);
    testing.assert_eq_str(result[0], "hello!");
    testing.assert_eq_str(result[1], "world!");
}

#[test]
fn test_map_empty_vec_yields_empty() {
    let v: Vec<string> = Vec.new();
    let result = iter.collect(iter.map(v.into_iter(), |s: string| s + "!"));
    testing.assert_eq(result.len(), 0);
}

#[test]
fn test_map_f64_doubles_elements() {
    let v: Vec<f64> = Vec.new();
    v.push(1.0);
    v.push(2.5);
    let result = iter.collect(iter.map(v.into_iter(), |x: f64| x * 2.0));
    testing.assert_eq(result.len(), 2);
    testing.assert_true(result[0] == 2.0);
    testing.assert_true(result[1] == 5.0);
}

// ── filter ─────────────────────────────────────────────────────────────────
#[test]
fn test_filter_str_keeps_matching_elements() {
    let v: Vec<string> = Vec.new();
    v.push("foo");
    v.push("bar");
    v.push("baz");
    let result = iter.collect(iter.filter(v.into_iter(), |s: string| s.starts_with("b")));
    testing.assert_eq(result.len(), 2);
    testing.assert_eq_str(result[0], "bar");
    testing.assert_eq_str(result[1], "baz");
}

#[test]
fn test_filter_none_match_yields_empty() {
    let v: Vec<string> = Vec.new();
    v.push("foo");
    v.push("qux");
    let result = iter.collect(iter.filter(v.into_iter(), |s: string| s.starts_with("z")));
    testing.assert_eq(result.len(), 0);
}

#[test]
fn test_filter_f64_keeps_positives() {
    let v: Vec<f64> = Vec.new();
    v.push(-1.0);
    v.push(2.5);
    v.push(3.0);
    let result = iter.collect(iter.filter(v.into_iter(), |x: f64| x > 0.0));
    testing.assert_eq(result.len(), 2);
    testing.assert_true(result[0] == 2.5);
    testing.assert_true(result[1] == 3.0);
}

// ── fold ───────────────────────────────────────────────────────────────────
#[test]
fn test_fold_str_concatenates() {
    let v: Vec<string> = Vec.new();
    v.push("a");
    v.push("b");
    v.push("c");
    let result = iter.fold(v.into_iter(), "", |acc: string, s: string| acc + s);
    testing.assert_eq_str(result, "abc");
}

#[test]
fn test_fold_empty_vec_returns_init() {
    let v: Vec<string> = Vec.new();
    let result = iter.fold(v.into_iter(), "init", |acc: string, s: string| acc + s);
    testing.assert_eq_str(result, "init");
}

#[test]
fn test_fold_f64_sums_elements() {
    let v: Vec<f64> = Vec.new();
    v.push(1.0);
    v.push(2.0);
    v.push(3.0);
    let result = iter.fold(v.into_iter(), 0.0, |acc: f64, x: f64| acc + x);
    testing.assert_true(result == 6.0);
}

// ── any / all ──────────────────────────────────────────────────────────────
#[test]
fn test_any_str_true_when_one_matches() {
    let v: Vec<string> = Vec.new();
    v.push("foo");
    v.push("bar");
    testing.assert_true(iter.any(v.into_iter(), |s: string| s == "bar"));
}

#[test]
fn test_any_false_when_none_match() {
    let v: Vec<string> = Vec.new();
    v.push("foo");
    v.push("bar");
    testing.assert_false(iter.any(v.into_iter(), |s: string| s == "baz"));
}

#[test]
fn test_any_false_on_empty() {
    let v: Vec<string> = Vec.new();
    testing.assert_false(iter.any(v.into_iter(), |s: string| s == "x"));
}

#[test]
fn test_any_f64_true_when_one_matches() {
    let v: Vec<f64> = Vec.new();
    v.push(1.0);
    v.push(2.0);
    v.push(3.0);
    testing.assert_true(iter.any(v.into_iter(), |x: f64| x > 2.5));
}

#[test]
fn test_all_str_true_when_all_match() {
    let v: Vec<string> = Vec.new();
    v.push("foo");
    v.push("fob");
    testing.assert_true(iter.all(v.into_iter(), |s: string| s.starts_with("fo")));
}

#[test]
fn test_all_false_when_one_fails() {
    let v: Vec<string> = Vec.new();
    v.push("foo");
    v.push("bar");
    testing.assert_false(iter.all(v.into_iter(), |s: string| s.starts_with("fo")));
}

#[test]
fn test_all_true_on_empty() {
    let v: Vec<string> = Vec.new();
    testing.assert_true(iter.all(v.into_iter(), |s: string| s == "x"));
}

#[test]
fn test_all_f64_false_when_one_fails() {
    let v: Vec<f64> = Vec.new();
    v.push(1.0);
    v.push(-1.0);
    testing.assert_false(iter.all(v.into_iter(), |x: f64| x > 0.0));
}

// ── sum / sum_f64 ──────────────────────────────────────────────────────────
#[test]
fn test_sum_f64_three_elements() {
    let v: Vec<f64> = Vec.new();
    v.push(1.0);
    v.push(2.5);
    v.push(3.0);
    testing.assert_true(iter.sum_f64(v.into_iter()) == 6.5);
}

#[test]
fn test_sum_f64_empty_vec_returns_zero() {
    let v: Vec<f64> = Vec.new();
    testing.assert_true(iter.sum_f64(v.into_iter()) == 0.0);
}

// ── take ───────────────────────────────────────────────────────────────────
#[test]
fn test_take_fewer_than_length() {
    let v: Vec<string> = Vec.new();
    v.push("a");
    v.push("b");
    v.push("c");
    let result = iter.collect(iter.take(v.into_iter(), 2));
    testing.assert_eq(result.len(), 2);
    testing.assert_eq_str(result[0], "a");
    testing.assert_eq_str(result[1], "b");
}

#[test]
fn test_take_more_than_length_clamps() {
    let v: Vec<string> = Vec.new();
    v.push("x");
    v.push("y");
    let result = iter.collect(iter.take(v.into_iter(), 99));
    testing.assert_eq(result.len(), 2);
}

#[test]
fn test_take_zero_returns_empty() {
    let v: Vec<string> = Vec.new();
    v.push("x");
    let result = iter.collect(iter.take(v.into_iter(), 0));
    testing.assert_eq(result.len(), 0);
}

#[test]
fn test_take_negative_n_returns_empty() {
    let v: Vec<string> = Vec.new();
    v.push("a");
    v.push("b");
    let result = iter.collect(iter.take(v.into_iter(), -5));
    testing.assert_eq(result.len(), 0);
}

#[test]
fn test_take_f64_fewer_than_length() {
    let v: Vec<f64> = Vec.new();
    v.push(1.0);
    v.push(2.0);
    v.push(3.0);
    let result = iter.collect(iter.take(v.into_iter(), 2));
    testing.assert_eq(result.len(), 2);
    testing.assert_true(result[0] == 1.0);
    testing.assert_true(result[1] == 2.0);
}

// ── skip ───────────────────────────────────────────────────────────────────
#[test]
fn test_skip_drops_first_n() {
    let v: Vec<string> = Vec.new();
    v.push("a");
    v.push("b");
    v.push("c");
    let result = iter.collect(iter.skip(v.into_iter(), 1));
    testing.assert_eq(result.len(), 2);
    testing.assert_eq_str(result[0], "b");
    testing.assert_eq_str(result[1], "c");
}

#[test]
fn test_skip_more_than_length_returns_empty() {
    let v: Vec<string> = Vec.new();
    v.push("a");
    v.push("b");
    let result = iter.collect(iter.skip(v.into_iter(), 10));
    testing.assert_eq(result.len(), 0);
}

#[test]
fn test_skip_zero_returns_all() {
    let v: Vec<string> = Vec.new();
    v.push("p");
    v.push("q");
    let result = iter.collect(iter.skip(v.into_iter(), 0));
    testing.assert_eq(result.len(), 2);
}

// Regression: skip with n < 0 previously aborted with a Vec
// index-out-of-bounds panic on the eager `skip_int`/`skip_str`/`skip_f64`
// helpers. The lazy `Skip` adapter never indexes by `n` directly (it burns
// items one at a time while `remaining > 0`), so a negative `remaining`
// leaves the burn loop a no-op and the full sequence is yielded unchanged —
// same observable clamp-to-zero behaviour, different mechanism.
#[test]
fn test_skip_negative_n_returns_all() {
    let v: Vec<string> = Vec.new();
    v.push("a");
    v.push("b");
    let result = iter.collect(iter.skip(v.into_iter(), -5));
    testing.assert_eq(result.len(), 2);
    testing.assert_eq_str(result[0], "a");
}

#[test]
fn test_skip_f64_drops_first_n() {
    let v: Vec<f64> = Vec.new();
    v.push(1.0);
    v.push(2.0);
    v.push(3.0);
    let result = iter.collect(iter.skip(v.into_iter(), 1));
    testing.assert_eq(result.len(), 2);
    testing.assert_true(result[0] == 2.0);
    testing.assert_true(result[1] == 3.0);
}

// ── count with predicate (via filter + count) ─────────────────────────────
// The eager `count_str(v, pred)`/`count_f64(v, pred)`/`count_int(v, pred)`
// counted matches, not every element — that composes as
// `count(filter(it, pred))`, distinct from the unconditional `count(it)`
// already covered by `vec_iter_test.hew`.
#[test]
fn test_count_of_filter_prefix_match() {
    let v: Vec<string> = Vec.new();
    v.push("foo");
    v.push("bar");
    v.push("baz");
    let matched = iter.count(iter.filter(v.into_iter(), |s: string| s.starts_with("b")));
    testing.assert_eq(matched, 2);
}

#[test]
fn test_count_of_filter_none_match_is_zero() {
    let v: Vec<string> = Vec.new();
    v.push("foo");
    v.push("qux");
    let matched = iter.count(iter.filter(v.into_iter(), |s: string| s.starts_with("z")));
    testing.assert_eq(matched, 0);
}

#[test]
fn test_count_of_filter_f64_positives() {
    let v: Vec<f64> = Vec.new();
    v.push(1.0);
    v.push(-1.0);
    v.push(2.5);
    let matched = iter.count(iter.filter(v.into_iter(), |x: f64| x > 0.0));
    testing.assert_eq(matched, 2);
}

// ── product / product_f64 ─────────────────────────────────────────────────
#[test]
fn test_product_three_elements() {
    let v: Vec<i64> = Vec.new();
    v.push(2);
    v.push(3);
    v.push(4);
    testing.assert_eq(iter.product(v.into_iter()), 24);
}

#[test]
fn test_product_empty_vec_returns_one() {
    let v: Vec<i64> = Vec.new();
    testing.assert_eq(iter.product(v.into_iter()), 1);
}

#[test]
fn test_product_f64_three_elements() {
    let v: Vec<f64> = Vec.new();
    v.push(2.0);
    v.push(0.5);
    v.push(4.0);
    testing.assert_true(iter.product_f64(v.into_iter()) == 4.0);
}

#[test]
fn test_product_f64_empty_vec_returns_one() {
    let v: Vec<f64> = Vec.new();
    testing.assert_true(iter.product_f64(v.into_iter()) == 1.0);
}

// ── VecIter fluent surface ────────────────────────────────────────────────
#[test]
fn test_vec_iter_map_method_delegates_to_iter() {
    let values: Vec<i64> = Vec.new();
    values.push(1);
    values.push(2);
    values.push(3);
    let result = iter.collect(values.into_iter().map(|x: i64| x * 2));
    testing.assert_eq(result.len(), 3);
    testing.assert_eq(result[0], 2);
    testing.assert_eq(result[2], 6);
}

#[test]
fn test_vec_from_array_uses_the_canonical_vec_construction() {
    let values: Vec<i64> = Vec.from([4, 5, 6]);
    testing.assert_eq(values.len(), 3);
    testing.assert_eq(values[1], 5);
}

#[test]
fn test_vec_iter_filter_method_keeps_exact_matching_values() {
    let values: Vec<i64> = Vec.new();
    values.push(2);
    values.push(3);
    values.push(4);
    values.push(5);
    let filtered = values.into_iter().filter(|value: i64| value % 2 == 0);
    let result = iter.collect(filtered);
    testing.assert_eq(result.len(), 2);
    testing.assert_eq(result[0], 2);
    testing.assert_eq(result[1], 4);
}

#[test]
fn test_vec_iter_fold_method_accumulates_exact_value() {
    let values: Vec<i64> = Vec.new();
    values.push(2);
    values.push(3);
    values.push(4);
    let product = values.into_iter().fold(1, |acc: i64, value: i64| acc * value);
    testing.assert_eq(product, 24);
}

#[test]
fn test_vec_iter_any_method_short_circuits_to_true() {
    let values: Vec<string> = Vec.new();
    values.push("alpha");
    values.push("beta");
    values.push("gamma");
    testing.assert_true(values.into_iter().any(|value: string| value == "beta"));
}

#[test]
fn test_vec_iter_all_method_detects_a_non_matching_value() {
    let values: Vec<i64> = Vec.new();
    values.push(4);
    values.push(6);
    values.push(7);
    testing.assert_false(values.into_iter().all(|value: i64| value % 2 == 0));
}

#[test]
fn test_vec_iter_find_method_returns_the_exact_item() {
    let values: Vec<string> = Vec.new();
    values.push("one");
    values.push("two");
    values.push("three");
    match values.into_iter().find(|value: string| value.starts_with("tw")) {
        .Some(value) => testing.assert_eq_str(value, "two"),
        .None => testing.assert_true(false),
    }
}

#[test]
fn test_vec_iter_count_method_counts_every_item() {
    let values: Vec<i64> = Vec.new();
    values.push(11);
    values.push(22);
    values.push(33);
    values.push(44);
    testing.assert_eq(values.into_iter().count(), 4);
}

#[test]
fn test_vec_iter_enumerate_method_keeps_indices_and_values() {
    let values: Vec<i64> = Vec.new();
    values.push(7);
    values.push(9);
    let indexed = iter.collect(values.into_iter().enumerate());
    testing.assert_eq(indexed.len(), 2);
    testing.assert_eq(indexed[0].0, 0);
    testing.assert_eq(indexed[0].1, 7);
    testing.assert_eq(indexed[1].0, 1);
    testing.assert_eq(indexed[1].1, 9);
}

#[test]
fn test_vec_iter_take_method_clamps_to_exact_prefix() {
    let values: Vec<i64> = Vec.new();
    values.push(5);
    values.push(6);
    values.push(7);
    let prefix = iter.collect(values.into_iter().take(2));
    testing.assert_eq(prefix.len(), 2);
    testing.assert_eq(prefix[0], 5);
    testing.assert_eq(prefix[1], 6);
}

#[test]
fn test_vec_iter_skip_method_keeps_exact_suffix() {
    let values: Vec<i64> = Vec.new();
    values.push(5);
    values.push(6);
    values.push(7);
    let suffix = iter.collect(values.into_iter().skip(2));
    testing.assert_eq(suffix.len(), 1);
    testing.assert_eq(suffix[0], 7);
}

#[test]
fn test_vec_iter_collect_method_preserves_every_value() {
    let values: Vec<i64> = Vec.new();
    values.push(8);
    values.push(13);
    values.push(21);
    let collected = values.into_iter().collect();
    testing.assert_eq(collected.len(), 3);
    testing.assert_eq(collected[0], 8);
    testing.assert_eq(collected[1], 13);
    testing.assert_eq(collected[2], 21);
}

#[test]
fn test_filter_map_collect_two_deep_chain_preserves_values() {
    let values: Vec<i64> = Vec.new();
    values.push(1);
    values.push(2);
    values.push(3);
    values.push(4);
    let filtered = values.into_iter().filter(|value: i64| value % 2 == 0);
    let mapped = iter.map(filtered, |value: i64| value * 10);
    let result = iter.collect(mapped);
    testing.assert_eq(result.len(), 2);
    testing.assert_eq(result[0], 20);
    testing.assert_eq(result[1], 40);
}

#[test]
fn test_terminal_into_iter_method_chain_executes() {
    let values: Vec<i64> = Vec.new();
    values.push(3);
    values.push(4);
    values.push(5);
    let total = values.into_iter().fold(0, |acc: i64, value: i64| acc + value);
    testing.assert_eq(total, 12);
}

#[test]
fn test_let_bound_into_iter_method_chain_executes() {
    let values: Vec<i64> = Vec.new();
    values.push(9);
    values.push(10);
    let iterator = values.into_iter();
    testing.assert_eq(iterator.count(), 2);
}

fn without_terminal_claims(ledger: ClaimsLedger) -> Vec<Claim> {
    let terminal_runs = ledger.terminal_runs;
    let claims = ledger.claims.into_iter();
    let active = claims.filter(|claim: Claim| !terminal_runs.contains(claim.run_id));
    iter.collect(active)
}

#[test]
fn test_claims_ledger_filter_collect_keeps_non_terminal_claims() {
    let claims: Vec<Claim> = Vec.new();
    claims.push(Claim { run_id: "first", amount: 10 });
    claims.push(Claim { run_id: "terminal", amount: 20 });
    claims.push(Claim { run_id: "last", amount: 30 });
    let terminal_runs: Vec<string> = Vec.new();
    terminal_runs.push("terminal");
    let ledger = ClaimsLedger { claims: claims, terminal_runs: terminal_runs };
    let active = without_terminal_claims(ledger);
    testing.assert_eq(active.len(), 2);
    testing.assert_eq_str(active[0].run_id, "first");
    testing.assert_eq(active[0].amount, 10);
    testing.assert_eq_str(active[1].run_id, "last");
    testing.assert_eq(active[1].amount, 30);
}
