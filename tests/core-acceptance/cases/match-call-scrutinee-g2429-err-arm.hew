fn f(n: i64) -> Result<i64, string> {
    if n >= 0 { .Err("g2429-err-payload".to_upper()) } else { .Ok(n) }
}

fn main() -> i64 {
    var hits = 0;
    var i = 0;
    while i < 50 {
        match f(i) {
            .Ok(v) => {}
            .Err(e) => { if !e.is_empty() { hits = hits + 1; } }
        }
        i = i + 1;
    }
    if hits > 0 { 0 } else { 1 }
}
