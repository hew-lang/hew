actor Worker {
    receive fn fail() {
        panic("restart me");
    }
}

supervisor App {
    strategy: one_for_one;
    intensity: 3 within 60s;
    child worker: Worker;
}

actor Observer {
    receive fn watch(role: ChildRef<Worker>) {
        let _ = role.fail();
        println("waiting");
        restarted(role);
        println("resumed");
    }
}

fn main() {
    let app = spawn App;
    let _ = app.worker.fail();
    restarted(app.worker);
    let observer = spawn Observer;
    mailbox(observer).watch(app.worker).expect("observe");
    sleep(20ms);
    terminate(observer);
    stopped(observer);
    restarted(app.worker);
    stop(app);
    stopped(app);
    println("released");
}
