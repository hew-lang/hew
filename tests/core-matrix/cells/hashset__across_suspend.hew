actor Holder {
    var ready: bool;

    receive fn hold(v: HashSet<i64>) -> i64 {
        sleep(2ms);
        let v_l = v.len();
        let v_h = v.contains(1);
        println(f"len={v_l} has1={v_h}");
        ready = true;
        1
    }
}

fn main() {
    let x: HashSet<i64> = HashSet.new();
    x.insert(1);
    x.insert(2);
    let h = spawn Holder(ready: false);
    match await h.hold(x) {
        Result.Ok(n) => println(f"held {n}"),
        Result.Err(_) => println("err"),
    }
}
