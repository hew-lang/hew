//! HTTP/1.1 service with two routes and a client using ordinary calls.
//! The server's accept loop runs as a forked task, concurrently with the
//! client's requests below it.

import std.encoding.utf8;

import std.net;

import std.net.http.codec;

fn serve(consume listener: net.Listener, requests: i64) {
    for r in 0..requests {
        let conn = listener.accept().expect("accept");
        var raw = "";
        var reads = 0;
        var done = false;
        while !done {
            // `None` is the peer's end of stream; an empty chunk ends the loop.
            let chunk = match conn.recv() {
                .Some(data) => utf8.decode(data) handle error {
                    println(f"invalid UTF-8: {error}");
                    return;
                },
                .None => "",
            };
            reads = reads + 1;
            if (chunk).is_empty() {
                done = true;
            } else {
                raw = raw + chunk;
                if codec.over_limit(raw) {
                    done = true;
                } else if codec.request_complete(raw) {
                    done = true;
                }
            }
            if reads > codec.MAX_READS {
                done = true;
            }
        }
        let reply = match codec.parse_request(raw) {
            .Ok(.Some(req)) => match req.path() {
                "/hello" => codec.response_text(200, "hi from hew"),
                "/health" => codec.response_json(200, "{\"status\":\"ok\"}"),
                _ => codec.response_text(404, "not found"),
            }
            .Ok(.None) => codec.response_text(400, "incomplete request"),
            .Err(error) => codec.response_text(error.status(), "rejected"),
        }.expect("valid response fields");
        let _ = conn.send(reply.to_bytes());
        let _ = conn.close();
    }
    let _ = listener.close();
}

fn fetch(addr: string, host: string, path: string) {
    let conn = match net.connect(addr) {
        .Ok(conn) => conn,
        .Err(_) => panic(f"network setup failed"),
    };
    let _ = conn.send(codec.build_get(host, path).expect("valid request fields").to_bytes());
    var raw = "";
    var reads = 0;
    var done = false;
    while !done {
        // `None` is the peer's end of stream; an empty chunk ends the loop.
        let chunk = match conn.recv() {
            .Some(data) => utf8.decode(data) handle error {
                println(f"invalid UTF-8: {error}");
                return;
            },
            .None => "",
        };
        reads = reads + 1;
        if (chunk).is_empty() {
            done = true;
        } else {
            raw = raw + chunk;
            if codec.response_over_limit(raw) {
                done = true;
            }
        }
        if reads > codec.CLIENT_MAX_READS {
            done = true;
        }
    }
    let _ = conn.close();
    let resp = codec.parse_response(raw).expect("valid response").expect("complete response");
    let content_type = match resp.content_type() {
        .Some(value) => value,
        .None => "",
    };
    let line = match resp.status() {
        200 => f"GET {path} -> 200 {content_type}: {resp.body()}",
        code => f"GET {path} -> {code}",
    };
    println(line);
}

fn main() {
    // Bind before starting the server, so the client below can dial at once:
    // the kernel queues its connection until the accept loop takes it.
    let listener = match net.listen("127.0.0.1:18234") {
        .Ok(listener) => listener,
        .Err(_) => panic(f"network setup failed"),
    };
    // `fork` starts the accept loop concurrently: an ordinary call would wait
    // for `serve` to finish (it doesn't, until it has served both requests)
    // before the client below ever dials it.
    fork serve(listener, 2);
    fetch("127.0.0.1:18234", "127.0.0.1", "/hello");
    fetch("127.0.0.1:18234", "127.0.0.1", "/health");
    println("done");
}
