import std.fs;

fn parse(text: string) -> i64 fails string {
    if text == "" {
        return error "empty";
    }
    1
}

fn main() {
    // An inferred edge takes its error type from the first exit; a second
    // exit with another error type has no conversion.
    let mixed = |path: string| {
        let n = parse(path)?;
        let text = fs.read(path)?;
        n + text.len()
    };
    // A closure that declares a value return has no failure edge.
    let declared = |text: string| -> i64 {
        if text == "" {
            return error "empty";
        }
        1
    };
    // Once a closure fails through an edge, a `?` on an `Option` has no
    // `Option` return to leave through.
    let absent = |text: string, extra: Option<i64>| {
        let n = parse(text)?;
        n + extra?
    };
    // A failing closure's `Result` tail with the edge's own error type would
    // nest as data; it is refused with the `?` repair.
    let nested = |text: string| {
        let _ = parse(text)?;
        parse(text)
    };
    println(f"{mixed("a"):?} {declared("b")} {absent("c", .None):?} {nested("d"):?}");
}
