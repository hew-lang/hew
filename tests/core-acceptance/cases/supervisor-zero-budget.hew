actor Worker {
    var label: string = "";
    init(seed: string) {
        label = seed;
    }
    #[on(start)]
    fn started() {
        println(label);
    }
    receive fn fail() {
        panic("zero budget child failed");
    }
    receive fn ping() {}
}

supervisor Branch(seed: string) {
    intensity: 0 within 60s;
    child worker: Worker(seed: seed);
}

supervisor Root(seed: string) {
    intensity: 0 within 60s;
    child branch: Branch(seed: seed);
}

fn main() {
    let root = spawn Root(seed: "one initial incarnation".to_upper());
    let worker = root.branch.worker;
    let _ = worker.fail();
    let _ = {
        let __hew_migrated_role_628 = root.branch;
        restarted(__hew_migrated_role_628);
        __hew_migrated_role_628
    };
    assert(worker.ping().is_err());
    {
        let __hew_migrated_actor_695 = root;
        stop(__hew_migrated_actor_695);
        stopped(__hew_migrated_actor_695);
    };
    println("zero budget performs no restart");
}
