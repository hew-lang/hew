//! Generic lifecycle state machine for resource-owning services.

/// Why a lifecycle-managed service faulted.
pub enum LifecycleError {
    /// Initialisation failed before the service started.
    StartFailed(string);
    /// The running service crashed.
    Crashed(string);
}

impl Display for LifecycleError {
    fn fmt(err: LifecycleError) -> string {
        match err {
            LifecycleError.StartFailed(reason) => f"StartFailed: {reason}",
            LifecycleError.Crashed(reason) => f"Crashed: {reason}",
        }
    }
}

impl Error for LifecycleError {
}

pub machine Lifecycle<T> {
    events {
        Initialise;
        Started { handle: T; }
        Stop;
        Crashed { error: LifecycleError; }
    }

    state Created;
    state Initialising;
    state Running { handle: T; }
    state Stopping;
    state Stopped;
    state Faulted { error: LifecycleError; }

    on Initialise: Created => Initialising;
    on Initialise: _ => _ {
        state
    }
    on Started: Initialising => Running { handle: event.handle }
    on Started: _ => _ {
        state
    }
    on Stop: Running => Stopping;
    on Stop: Stopping => Stopped;
    on Stop: _ => _ {
        state
    }
    on Crashed: Initialising => Faulted { error: event.error }
    on Crashed: Running => Faulted { error: event.error }
    on Crashed: _ => _ {
        state
    }
}

#[test]
fn lifecycle_i64_happy_path_state_names() {
    var lifecycle: Lifecycle<i64> = Lifecycle.Created;
    assert(lifecycle.state_name() == "Created");
    lifecycle.step(.Initialise);
    assert(lifecycle.state_name() == "Initialising");
    lifecycle.step(Lifecycle.Event.Started { handle: 42 });
    assert(lifecycle.state_name() == "Running");
    lifecycle.step(.Stop);
    assert(lifecycle.state_name() == "Stopping");
    lifecycle.step(.Stop);
    assert(lifecycle.state_name() == "Stopped");
}

#[test]
fn lifecycle_string_faulted_path_state_names() {
    var lifecycle: Lifecycle<string> = Lifecycle.Created;
    assert(lifecycle.state_name() == "Created");
    lifecycle.step(.Initialise);
    assert(lifecycle.state_name() == "Initialising");
    lifecycle.step(Lifecycle.Event.Crashed { error: LifecycleError.StartFailed("bind refused") });
    assert(lifecycle.state_name() == "Faulted");
}
