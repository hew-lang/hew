//! Tests for std::process argument handling.

import std.fs;

import std.process;

import std.string;

import std.time.datetime;

fn cleanup_file(file_path: string) {
    if fs.exists(file_path) {
        let _ = fs.delete(file_path);
    }
}

fn kill_zero_exit_code(pid: string) -> i64 {
    var args: Vec<string> = Vec.new();
    args.push("-0");
    args.push(pid);
    match process.run_argv("kill", args) {
        .Ok(output) => match output.status {
            process.ExitStatus.Exited(code) => code,
            process.ExitStatus.Signalled(_) => panic("kill -0 was signalled"),
        }
        .Err(error) => panic(to_string(error)),
    }
}

fn read_pid_with_retry(pid_path: string) -> string {
    var attempts = 0;
    while attempts < 50 {
        if fs.exists(pid_path) {
            match fs.read(pid_path) {
                .Ok(contents) => return string.trim(contents),
                .Err(_) => {}
            }
        }
        sleep(100ms);
        attempts = attempts + 1;
    }
    panic("expected child to write its pid file");
    ""
}

fn spawn_child_for_implicit_drop(pid_path: string) -> string {
    // Replace the shell with the sleeper so the tested PID owns its output
    // descriptors; dropping a Child reaps that process, not shell descendants.
    let child = match process.start(process.command("sh", ["-c", f"echo $$ > {pid_path}; exec sleep 60"])) {
        .Ok(child) => child,
        .Err(error) => panic(to_string(error)),
    };
    let pid = read_pid_with_retry(pid_path);
    assert(kill_zero_exit_code(pid) == 0);
    pid
}

#[test]
#[real_time]
fn test_run_argv_preserves_spaced_and_empty_arguments() {
    var args: Vec<string> = Vec.new();
    args.push("<%s>|<%s>|<%s>");
    args.push("hello world");
    args.push("");
    args.push("tail");
    match process.run_argv("printf", args) {
        .Ok(output) => {
            assert(output.status == process.ExitStatus.Exited(0));
            assert(output.stdout == "<hello world>|<>|<tail>");
            assert(output.stderr == "");
        }
        .Err(_) => panic("expected try_run_argv to succeed"),
    }
}

#[test]
#[real_time]
fn test_run_argv_missing_command_returns_launch_failed() {
    let args: Vec<string> = Vec.new();
    match process.run_argv("hew-process-command-that-does-not-exist", args) {
        .Ok(_) => panic("expected missing command error"),
        .Err(err) => match err {
            ProcessError.LaunchFailed(_) => {}
            _ => panic("expected ProcessError::LaunchFailed"),
        }
    }
}

#[test]
#[real_time]
fn test_launch_classification_does_not_trust_attacker_controlled_command_text() {
    let args: Vec<string> = Vec.new();
    match process.run_argv("hew-missing-arg_count-args[0]-command", args) {
        .Ok(_) => panic("expected missing command error"),
        .Err(err) => match err {
            ProcessError.LaunchFailed(_) => {}
            _ => panic("command substrings must not change a launch failure into InvalidArguments"),
        }
    }
}

#[test]
#[real_time]
fn test_run_argv_missing_command_preserves_real_error() {
    // Regression for #2506: the cooperative-yield checkpoint at
    // last_process_error's function entry must not clobber the real
    // launch-failure text with the "execution context not installed"
    // sentinel when main() has no installed execution context.
    // Cross-platform: a nonexistent command fails to launch
    // (ENOENT-equivalent) on every OS, so no Unix-only tool is used.
    let args: Vec<string> = Vec.new();
    match process.run_argv("hew-process-command-that-does-not-exist-2506", args) {
        .Ok(_) => panic("expected missing command to fail to launch"),
        .Err(err) => match err {
            ProcessError.LaunchFailed(message) => {
                assert(!message.contains("execution context not installed"));
                assert(message.contains("failed to execute"));
            }
            _ => panic("expected ProcessError::LaunchFailed"),
        }
    }
}

// A subprocess exits on the host clock, not the deterministic driver's.
#[test]
#[real_time]
fn test_child_drop_reaps_running_process() {
    let pid_path = f"tests/hew/_process_drop_{datetime.now_nanos()}.pid";
    cleanup_file(pid_path);
    let pid = spawn_child_for_implicit_drop(clone pid_path);
    var attempts = 0;
    var reaped = false;
    while attempts < 50 {
        if kill_zero_exit_code(pid) != 0 {
            reaped = true;
            break;
        }
        sleep(100ms);
        attempts = attempts + 1;
    }
    cleanup_file(pid_path);
    assert(reaped);
}

// ── launch failure truth ────────────────────────────────────────────────
//
// #16: a failed launch must never become a `Child` that no process backs.
#[test]
#[real_time]
fn test_start_reports_a_missing_executable_as_launch_failed() {
    match process.start(process.command("hew-process-executable-that-does-not-exist", ["--version"])) {
        .Ok(child) => {
            let _ = child.kill();
            panic("expected a missing executable to fail to launch");
        }
        .Err(err) => match err {
            ProcessError.LaunchFailed(message) => {
                assert(message.contains("failed to execute"));
                assert(message.contains("hew-process-executable-that-does-not-exist"));
            }
            _ => panic("expected ProcessError::LaunchFailed"),
        }
    }
}

#[test]
#[real_time]
fn test_start_passes_arguments_without_a_shell() {
    var command = process.command("printf", ["<%s>|<%s>|<%s>", "", "a b", "$HOME;雪"]);
    command.stdout = process.Stdio.Piped;
    let child = process.start(command).expect("printf starts");
    let output = child.stdout().expect("stdout is piped");
    var text = bytes.new();
    for chunk in output {
        text.append(chunk);
    }
    assert(text == "<>|<a b>|<$HOME;雪>".to_bytes());
    assert(child.wait().expect("wait") == process.ExitStatus.Exited(0));
}

#[test]
#[real_time]
fn test_wait_reports_the_exit_code_and_keeps_it() {
    let child = process.start(process.command("sh", ["-c", "exit 7"])).expect("sh starts");
    assert(child.wait().expect("wait") == process.ExitStatus.Exited(7));
    assert(child.wait().expect("wait") == process.ExitStatus.Exited(7));
    assert(child.try_wait().expect("poll").expect("reaped") == process.ExitStatus.Exited(7));
    // A reaped child is never signalled.
    child.kill().expect("a reaped child is not signalled");
}

#[test]
#[real_time]
fn test_terminate_and_kill_report_their_signals() {
    let polite = process.start(process.command("sleep", ["60"])).expect("sleep starts");
    assert(polite.try_wait().expect("poll").is_none());
    polite.terminate().expect("TERM is delivered");
    assert(polite.wait().expect("wait") == process.ExitStatus.Signalled(15));
    let stubborn = process.start(process.command("sh", ["-c", "trap '' TERM; exec sleep 60"])).expect("sh starts");
    stubborn.kill().expect("KILL is delivered");
    assert(stubborn.wait().expect("wait") == process.ExitStatus.Signalled(9));
}

#[test]
#[real_time]
fn test_stdio_is_taken_once_and_only_when_piped() {
    var command = process.command("cat", []);
    command.stdin = process.Stdio.Piped;
    let child = process.start(command).expect("cat starts");
    let input = child.stdin().expect("stdin is piped");
    assert(child.stdin().is_err());
    assert(child.stdout().is_err());
    assert(child.stderr().is_err());
    input.finish();
    assert(child.wait().expect("wait") == process.ExitStatus.Exited(0));
}

#[test]
#[real_time]
fn test_run_reports_a_signal_apart_from_an_exit_code() {
    let exited = process.run("exit 3").expect("sh runs");
    assert(exited.status == process.ExitStatus.Exited(3));
    let signalled = process.run("kill -9 $$").expect("sh runs");
    assert(signalled.status == process.ExitStatus.Signalled(9));
}

// ── Display ────────────────────────────────────────────────────────────────
#[test]
fn test_process_error_display_prints_the_carried_detail() {
    let invalid_arguments = ProcessError.InvalidArguments("boom");
    assert(to_string(invalid_arguments) == "boom");
    let launch_failed = ProcessError.LaunchFailed("could not exec");
    assert(to_string(launch_failed) == "could not exec");
    assert(to_string(ProcessError.NotPiped) == "NotPiped: the stream was not piped or was already taken");
    assert(to_string(process.ExitStatus.Signalled(15)) == "Signalled(15)");
}
