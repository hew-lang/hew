actor Worker {
    let label: string;
    receive fn read() -> i64 { label.len() }
    receive fn fail() { panic("nested prerequisite crash"); }
}
supervisor Backend(seed: string) {
    intensity: 0 within 60s;
    child worker: Worker { label: seed };
}
actor Checkout {
    let backend: Backend;
    init(store: Backend) {
        self.backend = store;
        assert(store.worker.read().expect("nested sibling during init") == 6);
        match store.worker.fail() {
            .Err(_) => { println("caught nested"); }
            .Ok(_) => { panic("nested worker did not fail"); }
        }
    }
    receive fn read() -> i64 { backend.worker.read().expect("restarted nested sibling") }
}
supervisor Shop(seed: string) {
    intensity: 3 within 60s;
    child checkout: Checkout wired_to: { store: backend };
    child backend: Backend { seed: seed };
}
fn main() {
    let shop = spawn Shop { seed: "ledger" };
    let backend = shop.backend;
    restarted(backend);
    assert(shop.checkout.read().expect("checkout retains nested role") == 6);
    stop(shop); stopped(shop);
    println("nested recovered");
}
