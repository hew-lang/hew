import std.os;

type Ping {
    value: i64;
}

actor Worker {
    receive fn ping(msg: Ping) {}
}

fn main() -> i64 {
    match Node.start(NodeConfig { bind: "127.0.0.1:0", transport: NodeTransport.Tcp, key: f"{os.temp_dir()}/hew-cap13-identity-aggregates-{os.pid()}.key", peers: Vec.new(), seeds: Vec.new() }) {
        .Ok(_) => {}
        .Err(_) => return 13,
    }
    let node_id = match Node.id() {
        .Some(id) => id,
        .None => return 1,
    };
    let worker = spawn Worker;
    Node.register("identity-worker", worker);
    let location = match Node.lookup("identity-worker") {
        .Ok(found) => found,
        .Err(_) => return 2,
    };
    if location.node_id() != node_id { return 3; }
    if location.slot() == 0 || location.incarnation() == 0 { return 4; }
    let same = Node.lookup("identity-worker").expect("same registration");
    if same != location { return 5; }
    if Node.id().expect("same node") != node_id {
        return 7;
    }
    var nodes: HashMap<NodeId, i64> = HashMap.new();
    nodes.insert(node_id, 11);
    if (nodes.get(node_id) ?? 0) != 11 {
        return 8;
    }
    var locations: HashMap<Location, i64> = HashMap.new();
    locations.insert(location, 12);
    if (locations.get(same) ?? 0) != 12 {
        return 9;
    }
    let alias = worker;
    if !(alias is worker) { return 10; }
    let node_text = to_string(node_id);
    let location_text = to_string(location);
    let same_text = f"{same}";
    if node_text.len() != 32 {
        return 11;
    }
    if location_text != same_text {
        return 12;
    }
    Node.shutdown();
    0
}
