fn main() {
    let m: HashMap<string, i64> = HashMap.new();
    m.insert("a", 1);
    match m.get("a") {
        Option.Some(v) => m.insert("a", v + 5),
        Option.None => {},
    }
    match m.get("a") {
        Option.Some(v) => println(f"a={v}"),
        Option.None => println("missing"),
    }
}
