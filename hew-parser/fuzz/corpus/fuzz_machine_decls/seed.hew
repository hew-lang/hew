machine SeedMachine {
    events {
        Activate;
        Deactivate;
    }

    state Idle;
    state Active { tag_byte: i8; value: i64; }
    on Activate: Idle => Active { tag_byte: 0, value: 42 }
    on Deactivate: Active => Idle;
    default { state }
}

fn seed_machine_calls() {
    var m: SeedMachine = .Idle;
    let _ = m.step(.Activate).expect("activate machine");
    let _name = m.state_name();
}
