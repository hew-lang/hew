fn main() {
    let x: Vec<i64> = Vec.new();
    x.push(10);
    x.push(20);
    let m: HashMap<string, Vec<i64>> = HashMap.new();
    m.insert("k", x);
    match m.get("k") {
        Option.Some(e) => {
            let e_l = e.len();
            let e_0 = e[0];
            println(f"len={e_l} v0={e_0}");
        },
        Option.None => println("missing"),
    }
}
