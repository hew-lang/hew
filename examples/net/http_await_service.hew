//! HTTP/1.1 service with two routes and a client using ordinary calls.
//! The server's accept loop runs as a forked task, concurrently with the
//! client's requests below it.

import std.encoding.utf8;

import std.net;

import std.net.http.http_async_server;

import std.net.http.http_async_client;

import std.string;

fn serve(consume listener: net.Listener, requests: i64) {
    for r in 0 .. requests {
        let conn = listener.accept();
        var raw = "";
        var reads = 0;
        var done = false;
        while !done {
            // `None` is the peer's end of stream; an empty chunk ends the loop.
            let chunk = match conn.recv() {
                .Some(data) => utf8.decode(data) handle error {
                    println(f"invalid UTF-8: {error}");
                    return;
                },
                .None => "",
            };
            reads = reads + 1;
            if string.is_empty(chunk) {
                done = true;
            } else {
                raw = raw + chunk;
                if http_async_server.over_limit(raw) {
                    done = true;
                } else if http_async_server.request_complete(raw) {
                    done = true;
                }
            }
            if reads > http_async_server.MAX_READS {
                done = true;
            }
        }
        let req = http_async_server.parse_request(raw);
        var reply = http_async_server.response_text(req.reject_status(), "rejected");
        if req.is_valid() {
            reply = match req.path() {
                "/hello" => http_async_server.response_text(200, "hi from hew"),
                "/health" => http_async_server.response_json(200, "{\"status\":\"ok\"}"),
                _ => http_async_server.response_text(404, "not found"),
            };
        }
        let _ = conn.send(reply.to_bytes());
        let _ = conn.close();
    }
    let _ = listener.close();
}

fn fetch(addr: string, host: string, path: string) {
    let conn = match net.connect(addr) {
        .Ok(conn) => conn,
        .Err(_) => panic(f"network setup failed"),
    };
    let _ = conn.send(http_async_client.build_get(host, path).to_bytes());
    var raw = "";
    var reads = 0;
    var done = false;
    while !done {
        // `None` is the peer's end of stream; an empty chunk ends the loop.
        let chunk = match conn.recv() {
            .Some(data) => utf8.decode(data) handle error {
                println(f"invalid UTF-8: {error}");
                return;
            },
            .None => "",
        };
        reads = reads + 1;
        if string.is_empty(chunk) {
            done = true;
        } else {
            raw = raw + chunk;
            if http_async_client.response_over_limit(raw) {
                done = true;
            }
        }
        if reads > http_async_client.CLIENT_MAX_READS {
            done = true;
        }
    }
    let _ = conn.close();
    let resp = http_async_client.parse_response(raw);
    let line = match resp.status() {
        200 => f"GET {path} -> 200 {resp.content_type()}: {resp.body()}",
        code => f"GET {path} -> {code}",
    };
    println(line);
}

fn main() {
    // Bind before starting the server, so the client below can dial at once:
    // the kernel queues its connection until the accept loop takes it.
    let listener = match net.listen("127.0.0.1:18234") {
        .Ok(listener) => listener,
        .Err(_) => panic(f"network setup failed"),
    };
    // `fork` starts the accept loop concurrently: an ordinary call would wait
    // for `serve` to finish (it doesn't, until it has served both requests)
    // before the client below ever dials it.
    fork serve(listener, 2);
    fetch("127.0.0.1:18234", "127.0.0.1", "/hello");
    fetch("127.0.0.1:18234", "127.0.0.1", "/health");
    println("done");
}
