//! Actor state follows ordinary value transfer. Draining an affine field
//! explicitly replaces it before iteration; an ordinary field can instead
//! supply a snapshot and remain usable across later actor turns.

trait Formatter {
    fn format(self, msg: string) -> string;
}

type TagFormatter {
    tag: string;
}

impl Formatter for TagFormatter {
    fn format(self, msg: string) -> string {
        f"{self.tag}:{msg}"
    }
}

fn make_formatter(tag: string) -> dyn Formatter {
    let f: dyn Formatter = TagFormatter { tag: tag };
    f
}

actor DynHolder {
    var plugins: Vec<dyn Formatter> = Vec.new();
    receive fn drain_format(msg: string) -> i64 {
        var count: i64 = 0;
        let queued = plugins;
        plugins = [];
        for p in queued.into_iter() {
            let _line = p.format(msg);
            count = count + 1;
        }
        count
    }
    receive fn refill() {
        plugins.push(make_formatter("W"));
    }
    receive fn plugin_count() -> i64 {
        plugins.len()
    }
    #[on(start)]
    fn boot() {
        plugins.push(make_formatter("U"));
        plugins.push(make_formatter("V"));
    }
}

actor StrHolder {
    var items: Vec<string> = Vec.new();
    receive fn drain_count() -> i64 {
        var count: i64 = 0;
        let queued = items;
        items = [];
        for _s in queued.into_iter() {
            count = count + 1;
        }
        count
    }

    receive fn snapshot_count() -> i64 {
        var count: i64 = 0;
        for _s in items.into_iter() {
            count = count + 1;
        }
        count
    }

    #[on(start)]
    fn boot() {
        items.push("a");
        items.push("b");
    }
}

#[test]
fn test_second_dispatch_after_dyn_state_drain_sees_valid_empty_vec() {
    let h = spawn DynHolder;
    let first = h.drain_format("m1");
    match first {
        .Ok(n) => assert(n == 2),
        .Err(_) => assert(0 == 1),
    }
    let second = h.drain_format("m2");
    match second {
        .Ok(n) => assert(n == 0),
        .Err(_) => assert(0 == 2),
    }
}

#[test]
fn test_push_into_drained_dyn_state_field_lands_in_valid_vec() {
    let h = spawn DynHolder;
    let first = h.drain_format("m1");
    match first {
        .Ok(n) => assert(n == 2),
        .Err(_) => assert(0 == 1),
    }
    let _ = h.refill();
    let count = h.plugin_count();
    match count {
        .Ok(n) => assert(n == 1),
        .Err(_) => assert(0 == 2),
    }
    let third = h.drain_format("m3");
    match third {
        .Ok(n) => assert(n == 1),
        .Err(_) => assert(0 == 3),
    }
}

#[test]
fn test_second_dispatch_after_string_state_drain_terminates() {
    let h = spawn StrHolder;
    let first = h.drain_count();
    match first {
        .Ok(n) => assert(n == 2),
        .Err(_) => assert(0 == 1),
    }
    let second = h.drain_count();
    match second {
        .Ok(n) => assert(n == 0),
        .Err(_) => assert(0 == 2),
    }
}

#[test]
fn test_ordinary_state_iterator_preserves_the_field_across_turns() {
    let h = spawn StrHolder;
    assert(h.snapshot_count().expect("first snapshot") == 2);
    assert(h.snapshot_count().expect("second snapshot") == 2);
    assert(h.drain_count().expect("explicit drain") == 2);
    assert(h.snapshot_count().expect("snapshot after drain") == 0);
}
