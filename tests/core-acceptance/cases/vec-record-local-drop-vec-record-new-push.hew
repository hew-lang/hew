type Point { x: i64, y: i64 }

fn build(n: i64) -> i64 {
    var pts: Vec<Point> = Vec.new();
    pts.push(Point { x: n, y: n });
    pts.push(Point { x: n, y: n });
    pts.len()
}

fn main() -> i64 {
    var total: i64 = 0;
    for i in 0..64 {
        total = total + build(i);
    }
    if total != 128 { return 71; }
    0
}
