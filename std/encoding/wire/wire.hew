//! Wire format substrate for `std.encoding.wire`.
//!
//! The `#[wire]` attribute, not this module, is what most code reaches for.
//! Attach it to a `type` declaration to make it network-serializable:
//!
//! ```
//! #[wire]
//! type UserCreated {
//!     id: u64 @1,
//!     name: string @2,
//! }
//!
//! fn main() {
//!     let e = UserCreated { id: 42, name: "ada" };
//!     let j = e.to_json();          // {"id":42,"name":"ada"}
//!     match UserCreated.from_json(j) {
//!         .Ok(back) => println(back.name),   // ada
//!         .Err(_) => println("parse failed"),
//!     }
//! }
//! ```
//!
//! Every field carries a `@N` tag — a stable wire identifier assigned once
//! and never reused, even after the field is removed; reusing a tag number
//! for a different field is a schema-compatibility break, not just a style
//! issue. A required `Option<T>` always emits its key and encodes `None` as
//! null; only `Option<T> @N optional` may omit the key for `None`. Missing
//! required keys fail decoding, while missing or explicitly-null optional keys
//! reconstruct `None`. Presence is explicit schema metadata, not inferred from
//! the value type, and changing it is a rejected compatibility change.
//! `e.to_json()` and `TypeName.from_json(text)` (a call on the type
//! name itself, not `::`) round-trip a `#[wire]` type through JSON today.
//! `HashMap` and `HashSet` may be fields of that wire type: string-keyed maps
//! become JSON objects, other supported primitive-key maps become arrays of
//! `[key, value]` pairs (so key types are not stringified), and sets become
//! deterministically ordered arrays. The same layouts round-trip through CBOR
//! and YAML. Any bare `Serializable` value uses the same typed codec through
//! this module's generic functions, for example `wire.to_json(features)` or
//! `wire.from_json<HashMap<string, Feature>>(text)`; collections do not need
//! collection-specific methods or a wrapper type.
//! Check schema compatibility between two versions of a wire type with:
//!
//! ```text
//! hew wire check <file.hew> --against <baseline.hew>
//! ```
//!
//! Full walkthrough, including the `optional` field modifier and the
//! `#[resource]`/`#[linear]` split for non-serializable ownership types:
//! see the "Shipped surfaces" chapter of the language guide
//! (`docs/hew-language-guide.md`, `#[wire]` section) and
//! `examples/playground/types/wire_types.hew`.
//!
//! **Current scope:** `#[wire]` round-trips reliably for a type declared and
//! used within a single module. A `#[wire]` type imported into another
//! module (`import src.env.{Env}; Env.from_json(...)`) does not yet
//! round-trip — cross-module wire codec emission is a tracked gap, not
//! intended behaviour. Keep `#[wire]` types same-module until that lands.
//!
//! This file also carries the substrate this doc comment used to describe:
//! the legacy HBF byte-layout helpers (`encode_header`, `decode_header`,
//! `validate_header`) were removed when the CBOR envelope substrate
//! (`hew-runtime/src/envelope.rs`) became the sole internode encoding. The
//! opaque `Value` contract for user-facing stdlib encoding modules lives in
//! `value_trait.hew` and remains active.

/// Encode any admitted `Serializable` value as binary CBOR.
pub fn encode<T: Serializable>(value: T) -> bytes {
    panic("compiler wire intrinsic")
}

/// Decode trusted binary CBOR as `T`. Malformed binary input follows the same
/// trap-on-failure contract as `Type.decode(bytes)`.
pub fn decode<T: Serializable>(data: bytes) -> T {
    panic("compiler wire intrinsic")
}

/// Serialize any admitted `Serializable` value as JSON text.
pub fn to_json<T: Serializable>(value: T) -> string {
    panic("compiler wire intrinsic")
}

/// Parse JSON text as `T`, preserving typed parse failures in `Result`.
pub fn from_json<T: Serializable>(text: string) -> Result<T, string> {
    panic("compiler wire intrinsic")
}

/// Serialize any admitted `Serializable` value as YAML text.
pub fn to_yaml<T: Serializable>(value: T) -> string {
    panic("compiler wire intrinsic")
}

/// Parse YAML text as `T`, preserving typed parse failures in `Result`.
pub fn from_yaml<T: Serializable>(text: string) -> Result<T, string> {
    panic("compiler wire intrinsic")
}
