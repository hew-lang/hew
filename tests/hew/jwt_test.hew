#[test]
fn test_hs512_validate_accepts_matching_secret() {
    let token = match jwt.encode("{\"exp\":4102444800,\"sub\":\"user42\"}", "this secret is only for Hew tests and must never be used in production", "HS512") {
        .Ok(t) => t,
        .Err(err) => panic(f"{err}"),
