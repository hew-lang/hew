#[resource]
type Tok {
    id: i64;
}

impl Tok {
    fn close(self) {
        println(f"close {self.id}");
    }
}

fn run() -> i64 {
    let h: Vec<Tok> = Vec.new();
    h.push(Tok { id: 1 });
    let v: Vec<i64> = Vec.new();
    println("before trap");
    v[3]
}

fn main() {
    let n = run();
    println(f"n={n}");
}
