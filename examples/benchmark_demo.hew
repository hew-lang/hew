//! Status: runnable
//! Description: Benchmark harness demo

// Benchmark harness demo
// Shows how to use std.bench to measure function performance.
import std.bench;

fn fibonacci(n: i32) -> i64 {
    if n <= 1 { n as i64 } else { fibonacci(n - 1) + fibonacci(n - 2) }
}

fn sum_to(n: i64) -> i64 {
    var total: i64 = 0;
    for i in 0..n {
        total = total + i;
    }
    total
}

#[bench]
fn fibonacci_20(b: bench.Bencher) {
    b.iter(|| fibonacci(20));
}

#[bench]
fn sum_1000(b: bench.Bencher) {
    b.iter(|| sum_to(1000));
}

fn main() {
    println("Run with: hew bench examples/benchmark_demo.hew");
}
