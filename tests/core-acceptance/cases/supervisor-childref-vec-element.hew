// A supervised role is a fixed-width value, so a `Vec<ChildRef<A>>` stores
// and returns it like any other bit-copyable element.
actor Worker {
    let value: i64 = 7,

    receive fn work() -> i64 {
        value
    }
}

supervisor Pool {
    strategy: one_for_one,
    intensity: 5 within 60s,

    child first: Worker(value: 7),
    child second: Worker(value: 11),
}

fn total(children: Vec<ChildRef<Worker>>) -> i64 {
    var sum = 0;
    for child in children {
        let answer = match child.work() {
            .Ok(value) => value,
            .Err(_) => -100,
        };
        sum = sum + answer;
    }
    sum
}

fn main() {
    let pool = spawn Pool;
    var children: Vec<ChildRef<Worker>> = Vec.new();
    children.push(pool.first);
    children.push(pool.second);
    children.push(pool.first);
    println(f"total {total(children)}");
    println(f"len {children.len()}");
}
