// A key collision after the case is applied, a skipped non-Option field, a
// resource field and a nested Option are refused at check time.
import std.encoding.wire;

#[resource]
type Handle {
    fd: i64;
}

type Holder {
    handle: Handle;
}

type Twice {
    value: Option<Option<i64>>;
}

#[serial(case = "camelCase")]
type Clash {
    foo_bar: i64;
    fooBar: i64;
}

type Skipped {
    #[serial(skip)]
    count: i64;
}

fn main() {
    let _ = wire.to_json(Holder { handle: Handle { fd: 1 } });
    let _ = wire.to_json(Twice { value: .None });
}
