enum ParseError { Invalid(string), }
enum Tri { A(string), B(string), C(string), }
fn make(n: i64) -> Result<i64, ParseError> {
    if n == 0 { .Ok(1) } else { .Err(ParseError.Invalid("bad-input".to_upper())) }
}
fn pick(n: i64) -> Result<i64, Tri> {
    match n % 3 {
        0 => .Err(Tri.A("alpha".to_upper())),
        1 => .Err(Tri.B("beta".to_upper())),
        _ => .Err(Tri.C("gamma".to_upper())),
    }
}
fn wild(n: i64) -> i64 {
    let r = make(n);
    match r { .Ok(v) => v, .Err(ParseError.Invalid(_)) => -1 }
}
fn bound(n: i64) -> i64 {
    let r = make(n);
    match r { .Ok(v) => v, .Err(ParseError.Invalid(m)) => m.len() }
}
fn probe(n: i64) -> i64 {
    let r = pick(n);
    match r {
        .Ok(v) => v,
        .Err(Tri.A(_)) => 1,
        .Err(Tri.B(m)) => m.len(),
        .Err(Tri.C(_)) => 3,
    }
}
fn main() {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 2000 {
        total = total + wild(1);
        total = total + bound(1);
        total = total + probe(i);
        i = i + 1;
    }
    println(f"{total}");
}
