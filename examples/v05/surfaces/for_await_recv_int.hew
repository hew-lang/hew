//! Status: runnable (v0.5 ordinary for over Receiver<i64>)
//! Description: Drains an integer channel receiver with `for`.

import std.channel.channel;

actor DrainInts {
    receive fn run(unused: i64) {
        let (tx, rx): (channel.Sender<i64>, channel.Receiver<i64>) = match channel.new(4) {
            .Ok(pair) => pair,
            .Err(err) => panic(f"channel.new failed: {err}"),
        };
        tx.send(1);
        tx.send(2);
        tx.send(3);
        tx.close();
        for item in rx {
            println(item);
        }
    }
}

fn main() {
    let worker = spawn DrainInts;
    let _ = worker.run(0);
    sleep(500ms);
}
