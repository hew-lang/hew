// ASan fixture gate: an actor-state `Stream<T>` field drained by its handler
// is closed exactly once (#3218).
//
// The core-acceptance `safety` suite (`make core-safety`) runs it under
// ASan/LSan.
//
// The stream stays in its state seat for the whole actor lifetime: `recv`
// borrows the seat, so the field keeps its own `StreamClose` drop authority
// and the state drop thunk is the one owner that closes the runtime pointer.
// Draining to EOF and then releasing the actor must produce no finding.
//
// The consuming spelling - `for item in self.input` - moves the seat's owner
// out and is refused in source; its negative control is
// `tests/vertical-slice/reject/stream_state_field_for_consumes_the_seat.hew`.
import std.stream;

actor Consumer {
    var input: Stream<string>,

    receive fn drain() {
        var draining = true;
        while draining {
            match self.input.recv() {
                .Some(item) => { let _ = item; },
                .None => { draining = false; },
            }
        }
        println("drained");
    }
}

fn main() -> i64 {
    let (sink, input) = match stream.pipe(4) {
        .Ok(pair) => pair,
        .Err(_) => return 1,
    };
    sink.send("one").expect("send");
    sink.send("two").expect("send");
    sink.close();
    let c = spawn Consumer(input: input);
    let _ = c.drain();
    println("done");
    0
}
