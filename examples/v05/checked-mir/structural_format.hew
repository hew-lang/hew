// MIR-corpus fixture: structural aggregate formatting.
//
// Pins `hew_structural_format`, which renders a record through a borrowed
// structural view rather than a concrete Display implementation.
type Point {
    x: i64,
    label: string,
}

fn main() {
    let point = Point { x: 7, label: "west" };
    println(f"{point:?}");
}
