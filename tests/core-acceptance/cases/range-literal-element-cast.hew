// A range-literal element is an integer before anything narrows it: casts
// see an integer at once, a use site still narrows it, and an unconstrained
// element defaults to i64.
fn widen(x: i32) -> i32 {
    x * 2
}

fn main() {
    var out = bytes.new();
    for v in 0..256 {
        out.push(v as u8);
    }
    var small: Vec<i32> = Vec.new();
    for i in 0..4 {
        small.push(i);
    }
    var doubled = 0;
    for i in 0..3 {
        doubled = doubled + widen(i);
    }
    var total = 0;
    for w in 0..=10 {
        total = total + w;
    }
    for f in 0..3 {
        println(f as f64 / 2.0);
    }
    let big = 5000000000;
    var last = 0;
    for x in 0..3 {
        last = x + big;
    }
    println(f"{out.len()} {out[255]} {small.len()} {small[3]} {doubled} {total} {last}");
}
