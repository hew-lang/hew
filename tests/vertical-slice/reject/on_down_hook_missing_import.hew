// Reject: source-owned lifecycle types require a published import binding.
// Omitting one must fail in checker resolution, never in HIR/MIR layout.
actor Watcher {
    #[on(down)]
    fn on_down(note: DownNotification) {
        let _id = note.monitor.value;
        match note.target {
            DownTarget::Local(slot) => {
                let _slot = slot;
            }
            DownTarget::Remote(location) => {
                let _location = location;
            }
        }
    }
}

supervisor AppSupervisor {
    strategy: one_for_one;
    intensity: 3 within 60s;

    child watcher: Watcher;
}

fn main() -> i64 {
    spawn AppSupervisor;
    42
}
