actor Holder {
    var ready: bool;

    receive fn hold(v: Option<i64>) -> i64 {
        sleep(2ms);
        match v { Option.Some(v_v) => println(f"some {v_v}"), Option.None => println("none"), }
        ready = true;
        1
    }
}

fn main() {
    let x: Option<i64> = Option.Some(5);
    let h = spawn Holder(ready: false);
    match await h.hold(x) {
        Result.Ok(n) => println(f"held {n}"),
        Result.Err(_) => println("err"),
    }
}
