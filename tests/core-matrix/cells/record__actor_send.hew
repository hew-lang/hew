type Rec {
    a: i64;
    b: string;
}

actor Sink {
    var hits: i64;

    receive fn take(v: Rec) -> i64 {
        let v_a = v.a;
        let v_b = v.b;
        println(f"{v_a} {v_b}");
        hits = hits + 1;
        hits
    }
}

fn main() {
    let x = Rec { a: 1, b: "x0" };
    let s = spawn Sink(hits: 0);
    match await s.take(x) {
        Ok(n) => println(f"hits {n}"),
        Err(_) => println("err"),
    }
}
