// The winning race operand returns a resource handle that stays usable in
// the enclosing scope and is closed exactly once, by the caller. The losing
// operand parks on a pipe nothing feeds.
import std.stream;

#[resource] type Handle { label: string }
impl Handle {
    fn close(consume self) {
        println("closed " + self.label);
    }
    fn describe(self) -> string {
        "used " + self.label
    }
}
fn make(label: string) -> Handle {
    Handle { label: label }
}
fn make_after(label: string, gate: stream.Stream<i64>) -> Handle {
    gate.recv();
    Handle { label: label }
}
fn main() {
    let (_hold, gate): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("pipe");
    let winner = race { make_after("slow", gate), make("fast") };
    println(winner.describe());
    winner.close();
}
