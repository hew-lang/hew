import std.stream;

actor Keeper {
    var journal: Stream<string>;
    var count: i64 = 0;
    #[on(start)]
    fn started() {
        println("start");
        count = 1;
    }
    #[on(stop)]
    fn stopping() {
        println("stop");
        println(count);
    }
    #[on(stop)]
    fn stopping_again() {
        println("stop again");
    }
    receive fn bump() -> i64 {
        count = count + 1;
        count
    }
}

fn open(path: string) -> Stream<string> {
    match stream.open(path) {
        .Ok(input) => input.lines(),
        .Err(_) => panic("fixture open failed"),
    }
}

fn main() {
    let keeper = spawn Keeper(journal: open("resource-read.bin"));
    match keeper.bump() {
        .Ok(count) => println(count),
        .Err(_) => panic("bump failed"),
    }
    {
        let __hew_migrated_actor_791 = keeper;
        stop(__hew_migrated_actor_791);
        stopped(__hew_migrated_actor_791);
    };
    println("closed");
}
