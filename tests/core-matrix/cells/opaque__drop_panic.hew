#[opaque]
type DqH {
}

#[resource]
type Dq {
    handle: DqH,
    tag: i64,
}

impl Dq {
    fn close(self) {
        unsafe { hew_deque_free(self.handle) };
        println(f"close {self.tag}");
    }
}

extern "C" {
    fn hew_deque_new() -> DqH;
    fn hew_deque_free(dq: DqH);
    fn hew_deque_len(dq: DqH) -> i64;
}

fn run() -> i64 {
    let h = Dq { handle: unsafe { hew_deque_new() }, tag: 1 };
    let v: Vec<i64> = Vec.new();
    println("before trap");
    v[3]
}

fn main() {
    let n = run();
    println(f"n={n}");
}
