import std.process;

import std.time.cron;

fn main() {
    match process.run("printf ok") {
        .Ok(output) => println(output.stdout),
        .Err(_) => (),
    }
    let run_args: Vec<string> = Vec.new();
    match process.run_argv("printf", run_args) {
        .Ok(output) => println(output.stdout),
        .Err(_) => (),
    }
    let start_args: Vec<string> = Vec.new();
    match process.start(process.command("true", start_args)) {
        .Ok(child) => println(child.wait().expect("wait")),
        .Err(_) => (),
    }
    let parsed = cron.parse("* * * * *");
    parsed.close();
}
