actor Holder {
    var ready: bool;

    receive fn hold(v: (i64, string)) -> i64 {
        sleep(2ms);
        let (v_a, v_b) = v;
        println(f"{v_a} {v_b}");
        ready = true;
        1
    }
}

fn main() {
    let x: (i64, string) = (1, "x0");
    let h = spawn Holder(ready: false);
    match await h.hold(x) {
        .Ok(n) => println(f"held {n}"),
        .Err(_) => println("err"),
    }
}
