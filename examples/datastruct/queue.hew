// A queue serves the first value it received. Move the head forward instead
// of shifting every remaining value on each dequeue.
type Queue {
    values: Vec<i64>;
    head: i64;
}

impl Queue {
    fn enqueue(var self, value: i64) {
        self.values.push(value);
    }

    fn len(self) -> i64 {
        self.values.len() - self.head
    }

    fn peek(self) -> Option<i64> {
        self.values.get(self.head)
    }

    fn dequeue(var self) -> Option<i64> {
        let value = self.peek()?;
        self.head += 1;
        // Reclaim the consumed prefix once it is at least half the storage.
        if self.head >= self.len() {
            self.values = self.values[self.head..];
            self.head = 0;
        }
        .Some(value)
    }
}

fn main() {
    var queue = Queue { values: [], head: 0 };
    assert(queue.peek().is_none());
    for value in [10, 20, 30] {
        queue.enqueue(value);
    }
    assert(queue.len() == 3);
    assert(queue.peek() == .Some(10));
    while let .Some(value) = queue.dequeue() {
        println(f"Served {value}");
    }
    assert(queue.len() == 0);
    queue.enqueue(1);
    queue.enqueue(2);
    assert(queue.dequeue() == .Some(1));
    queue.enqueue(3);
    assert(queue.dequeue() == .Some(2));
    assert(queue.dequeue() == .Some(3));
    queue.enqueue(99);
    assert(queue.dequeue() == .Some(99));
    for value in 0..50 {
        queue.enqueue(value);
    }
    for value in 0..50 {
        assert(queue.dequeue() == .Some(value));
    }
    assert(queue.dequeue().is_none());
}
