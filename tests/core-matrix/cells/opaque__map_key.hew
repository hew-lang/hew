#[opaque]
type DqH {
}

#[resource]
type Dq {
    handle: DqH,
    tag: i64,
}

impl Dq {
    fn close(consume self) {
        unsafe { hew_deque_free(self.handle) };
        println(f"close {self.tag}");
    }
}

extern "C" {
    fn hew_deque_new() -> DqH;
    fn hew_deque_free(dq: DqH);
    fn hew_deque_len(dq: DqH) -> i64;
}

fn main() {
    let k = Dq { handle: unsafe { hew_deque_new() }, tag: 1 };
    var m: HashMap<Dq, i64> = HashMap.new();
    m.insert(k, 9);
    match m.get(k) {
        Option.Some(v) => println(f"got {v}"),
        Option.None => println("missing"),
    }
}
