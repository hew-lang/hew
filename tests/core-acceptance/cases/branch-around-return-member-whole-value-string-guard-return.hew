fn build_or_bail(bail: bool, seed: string) -> string {
    let payload = seed + "-owned-heap-payload";
    if bail {
        return "bailed";
    }
    payload
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        let r = build_or_bail(true, "per-call-seed");
        total = total + r.len();
        i = i + 1;
    }
    total
}
