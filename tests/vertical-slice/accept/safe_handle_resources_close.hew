import std.path;

import std.semaphore;

import std.deque;

import std.time.cron;

import std.net.url;

import std.encoding.xml;

fn main() -> i64 {
    let glob = match path.glob("tests/vertical-slice/accept/*.hew") {
        .Ok(glob) => glob,
        .Err(error) => panic(to_string(error)),
    };
    glob.close();
    let sem = semaphore.new(1);
    sem.close();
    let queue = deque.new();
    queue.close();
    let schedule = cron.parse("* * * * *");
    schedule.close();
    let parsed_url = url.parse("https://example.com");
    parsed_url.close();
    let node = match xml.parse("<root/>") {
        .Ok(node) => node,
        .Err(reason) => panic(reason),
    };
    node.close();
    0
}
