//! TOML parsing and generation.
//!
//! Parse TOML documents into values, build new tables programmatically,
//! and serialize back to TOML text.
//!
//! # Examples
//!
//! ```
//! import std.encoding.toml;
//!
//! fn main() {
//!     let doc = match toml.parse("[package]\nname = \"hew\"") {
//!         .Ok(value) => value,
//!         .Err(_) => panic("invalid TOML"),
//!     };
//!     let pkg = doc.get_field("package");
//!     let name = pkg.get_field("name");
//!     println(name.get_string());  // "hew"
//!     name.free();
//!     pkg.free();
//!     doc.free();
//! }
//! ```

import std.encoding.wire.value_trait;

/// Structured error type for TOML parsing failures.
///
/// Use `Result<Value, ParseError>` with `parse` for structured error
/// handling. Import `std.encoding.toml` when matching on the returned error
/// value so you can use the existing unqualified
/// `ParseError.Invalid(message)` constructor/pattern style.
pub enum ParseError {
    /// The input was not valid TOML. Carries the native parser message.
    Invalid(string);
}

impl Display for ParseError {
    fn fmt(err: ParseError) -> string {
        match err {
            ParseError.Invalid(message) => message,
        }
    }
}

/// An opaque TOML value.
///
/// Represents any TOML type: string, integer, float, boolean, array,
/// table, or datetime. The canonical shared wire tag prefix reserves
/// `0` for null, even though TOML itself has no null value. Must be freed
/// Values close automatically at the end of their ownership scope;
/// `close()` performs the same release explicitly.
#[resource]
#[opaque]
pub type Value {
}

/// Methods available on a TOML `Value`.
///
/// Extends the shared opaque-handle contract from
/// `std.encoding.wire.value_trait`. Canonical methods are redeclared here
/// with TOML-specific docstrings for documentation purposes.
trait ValueMethods: CanonicalValueMethods {
    /// Return the type tag (0=null reserved, 1=bool, 2=i64, 3=float,
    /// 4=string, 5=array, 6=table, 7=datetime).
    fn type_of(self) -> i32; // INTERNAL-ABI: opaque C-level kind enum; planned enum migration
    /// Extract the string value.
    fn get_string(self) -> string;

    /// Extract the integer value.
    fn get_int(self) -> i64;

    /// Extract the floating-point value.
    fn get_float(self) -> f64;

    /// Extract the boolean value (0 or 1).
    fn get_bool(self) -> i32; // INTERNAL-ABI: C ABI returns bool as i32
    /// Look up a field by key in a TOML table.
    fn get_field(self, key: string) -> Value;

    /// Return the number of elements in a TOML array.
    fn array_len(self) -> i64;

    /// Return the element at the given index in a TOML array.
    fn array_get(self, index: i64) -> Value;

    /// Serialize the value back to a TOML string.
    ///
    /// Panics if the value cannot be a TOML document root. Only a table can:
    /// an integer, string, or array root serializes to no text at all, which
    /// is exactly what an empty table serializes to. Use `stringify()`
    /// when that failure should be returned as an error.
    fn stringify(self) -> string;

    /// Consuming compatibility alias for the inherent `close()`.
    fn free(consuming self);

    // ── Fluent builders ─────────────────────────────────────────
    /// Set a string field on a table. Returns the table for chaining.
    #[returns_receiver]
    fn with_string(consuming self, key: string, val: string) -> Self;

    /// Set an integer field. Returns the table for chaining.
    #[returns_receiver]
    fn with_int(consuming self, key: string, val: i64) -> Self;

    /// Set a float field. Returns the table for chaining.
    #[returns_receiver]
    fn with_float(consuming self, key: string, val: f64) -> Self;

    /// Set a boolean field. Returns the table for chaining.
    #[returns_receiver]
    fn with_bool(consuming self, key: string, val: bool) -> Self;

    /// Set a Value child on a table. The child is consumed. Returns the table.
    #[returns_receiver]
    fn with(consuming self, key: string, consume child: Value) -> Self;

    /// Push a Value onto an array. The child is consumed. Returns the array.
    #[returns_receiver]
    fn push(consuming self, consume child: Value) -> Self;

    /// Push an integer onto an array. Returns the array.
    #[returns_receiver]
    fn push_int(consuming self, val: i64) -> Self;

    /// Push a string onto an array. Returns the array.
    #[returns_receiver]
    fn push_string(consuming self, val: string) -> Self;

    /// Push a float onto an array. Returns the array.
    #[returns_receiver]
    fn push_float(consuming self, val: f64) -> Self;

    /// Push a boolean onto an array. Returns the array.
    #[returns_receiver]
    fn push_bool(consuming self, val: bool) -> Self;
}

impl CanonicalValueMethods for Value {
    fn type_of(val: Value) -> i32 { // INTERNAL-ABI: opaque C-level kind enum; planned enum migration
        unsafe {
            hew_toml_type(val)
        }
    }
    fn get_string(val: Value) -> string {
        unsafe {
            hew_toml_get_string(val)
        }
    }
    fn get_int(val: Value) -> i64 {
        unsafe {
            hew_toml_get_int(val)
        }
    }
    fn get_float(val: Value) -> f64 {
        unsafe {
            hew_toml_get_float(val)
        }
    }
    fn get_bool(val: Value) -> i32 { // INTERNAL-ABI: C ABI returns bool as i32
        unsafe {
            hew_toml_get_bool(val)
        }
    }
    fn get_field(val: Value, key: string) -> Value {
        unsafe {
            hew_toml_get_field(val, key)
        }
    }
    fn array_len(val: Value) -> i64 {
        unsafe {
            hew_toml_array_len(val)
        }
    }
    fn array_get(val: Value, index: i64) -> Value {
        if index < 0 || index > 2147483647 {
            panic(f"toml.Value.array_get: index {index} is outside the supported range");
        }
        unsafe {
            hew_toml_array_get(val, index as i32)
        }
    } // INTERNAL-ABI: C ABI index is i32
    fn stringify(val: Value) -> string {
        let text = unsafe {
            hew_toml_stringify(val)
        };
        let reason = unsafe {
            hew_toml_last_serialize_error()
        };
        if reason.len() > 0 {
            panic(f"toml.Value.stringify: {reason}");
            ""
        } else {
            text
        }
    }
    fn free(consuming self) {
        self.close();
    }
    #[returns_receiver]
    fn with_string(consuming self, key: string, val: string) -> Value {
        unsafe {
            hew_toml_table_set_string(self, key, val)
        };
        self
    }
    #[returns_receiver]
    fn with_int(consuming self, key: string, val: i64) -> Value {
        unsafe {
            hew_toml_table_set_int(self, key, val as i64)
        };
        self // INTERNAL-ABI: C ABI takes i64
    }
    #[returns_receiver]
    fn with_float(consuming self, key: string, val: f64) -> Value {
        unsafe {
            hew_toml_table_set_float(self, key, val)
        };
        self
    }
    #[returns_receiver]
    fn with_bool(consuming self, key: string, val: bool) -> Value {
        unsafe {
            hew_toml_table_set_bool(self, key, val as i32)
        };
        self
    }
    #[returns_receiver]
    fn with(consuming self, key: string, consume child: Value) -> Value {
        unsafe {
            hew_toml_table_set(self, key, child)
        };
        self
    }
    #[returns_receiver]
    fn push(consuming self, consume child: Value) -> Value {
        unsafe {
            hew_toml_array_push(self, child)
        };
        self
    }
    #[returns_receiver]
    fn push_int(consuming self, val: i64) -> Value {
        unsafe {
            hew_toml_array_push_int(self, val as i64)
        };
        self // INTERNAL-ABI: C ABI takes i64
    }
    #[returns_receiver]
    fn push_string(consuming self, val: string) -> Value {
        unsafe {
            hew_toml_array_push_string(self, val)
        };
        self
    }
    #[returns_receiver]
    fn push_float(consuming self, val: f64) -> Value {
        unsafe {
            hew_toml_array_push_float(self, val)
        };
        self
    }
    #[returns_receiver]
    fn push_bool(consuming self, val: bool) -> Value {
        unsafe {
            hew_toml_array_push_bool(self, val as i32)
        };
        self
    }
}

impl ValueMethods for Value {
}

// `close` is the sole compiler-visible disposer. `free` above remains a
// terminal consuming compatibility alias and delegates here.
impl Value {
    fn close(consuming self) {
        unsafe {
            hew_toml_free(self)
        };
    }
}

// ── Module-level functions ────────────────────────────────────────────
fn parse_error_message() -> string {
    unsafe {
        hew_toml_last_error()
    }
}

/// Parse a TOML string into a `Value`.
///
/// Returns `Err(ParseError.Invalid(message))` with the native parser message
/// when parsing fails. Match on `ParseError.Invalid(message)` to recover the
/// original parser message.
pub fn parse(s: string) -> Result<Value, ParseError> {
    let val = unsafe {
        hew_toml_parse(s)
    };
    if val.type_of() >= 0 {
        Ok(val)
    } else {
        Err(ParseError.Invalid(parse_error_message()))
    }
}

/// Serialize `val` back to a TOML string without panicking.
///
/// A TOML document root must be a table. An integer, string, or array root
/// serializes to no text at all, which is exactly what an empty table
/// serializes to, so the two are only distinguishable through this result.
pub fn stringify(val: Value) -> Result<string, string> {
    let text = unsafe {
        hew_toml_stringify(val)
    };
    let reason = unsafe {
        hew_toml_last_serialize_error()
    };
    if reason.len() > 0 {
        Err(reason)
    } else {
        Ok(text)
    }
}

/// Create a new empty TOML table.
pub fn table() -> Value {
    unsafe {
        hew_toml_table_new()
    }
}

/// Create a new empty TOML array.
pub fn array() -> Value {
    unsafe {
        hew_toml_array_new()
    }
}

/// Create a TOML Value from an integer.
pub fn from_int(val: i64) -> Value {
    unsafe {
        hew_toml_from_int(val as i64)
    }
} // INTERNAL-ABI: C ABI takes i64
/// Create a TOML Value from a float.
pub fn from_float(val: f64) -> Value {
    unsafe {
        hew_toml_from_float(val)
    }
}

/// Create a TOML Value from a string.
pub fn from_string(val: string) -> Value {
    unsafe {
        hew_toml_from_string(val)
    }
}

/// Create a TOML Value from a boolean.
pub fn from_bool(val: bool) -> Value {
    unsafe {
        hew_toml_from_bool(val as i32)
    }
}

// ── FFI bindings (implementation detail) ──────────────────────────────
extern "C" {
    fn hew_toml_parse(s: string) -> Value;
    fn hew_toml_last_error() -> string;
    fn hew_toml_type(val: Value) -> i32;
    fn hew_toml_get_string(val: Value) -> string;
    fn hew_toml_get_int(val: Value) -> i64;
    fn hew_toml_get_float(val: Value) -> f64;
    fn hew_toml_get_bool(val: Value) -> i32;
    fn hew_toml_get_field(val: Value, key: string) -> Value;
    fn hew_toml_array_len(val: Value) -> i64;
    fn hew_toml_array_get(val: Value, index: i32) -> Value;
    fn hew_toml_stringify(val: Value) -> string;
    fn hew_toml_last_serialize_error() -> string;
    fn hew_toml_free(consume val: Value);
    // Builders
    fn hew_toml_table_new() -> Value;
    fn hew_toml_array_new() -> Value;
    fn hew_toml_table_set_string(tbl: Value, key: string, val: string);
    fn hew_toml_table_set_int(tbl: Value, key: string, val: i64);
    fn hew_toml_table_set_float(tbl: Value, key: string, val: f64);
    fn hew_toml_table_set_bool(tbl: Value, key: string, val: i32);
    fn hew_toml_table_set(tbl: Value, key: string, consume child: Value);
    fn hew_toml_array_push(arr: Value, consume child: Value);
    fn hew_toml_array_push_int(arr: Value, val: i64);
    fn hew_toml_array_push_string(arr: Value, val: string);
    fn hew_toml_array_push_float(arr: Value, val: f64);
    fn hew_toml_array_push_bool(arr: Value, val: i32);
    fn hew_toml_from_int(val: i64) -> Value;
    fn hew_toml_from_float(val: f64) -> Value;
    fn hew_toml_from_string(val: string) -> Value;
    fn hew_toml_from_bool(val: i32) -> Value;
}
