// Create one authority with `hew node authority --key authority.key`.
// Enrol both node credentials under it with
// `hew node identity --key PATH --transport TRANSPORT` and
// `hew node admit --authority authority.key --credential HEX --transport TRANSPORT --output FILE`.
// Set HEW_NODE_CLUSTER to this node's enrolment file, then start the server
// and client. Without that setting, each program prints its credential and exits.
// TCP: server [port], client [host] [port]. Mesh uses loopback ports 9000/9001.
import std.net;
import std.net.cluster;

import std.os;

actor KeyValue {
    var store: HashMap<string, string>;

    #[wire]
    receive fn put(key: string, value: string) -> string {
        store.insert(key, value);
        "stored"
    }

    #[wire]
    receive fn get(key: string) -> string {
        match store.get(key) {
            .Some(value) => value,
            .None => "",
        }
    }
}

// This two-node example offers its service to the other enrolled member.
fn authenticated_peer() -> net.PeerSession {
    let local = Node.id().expect("local identity");
    let observation = cluster.watch().expect("watch peers");
    loop {
        for member in observation.snapshot().expect("peer snapshot").members {
            if member.id != local && member.state == cluster.State.Alive {
                match Node.peer(member.id) {
                    .Ok(peer) => return peer,
                    .Err(_) => {}
                }
            }
        }
        assert(observation.changes.recv().is_some());
    }
}

fn main() {
    let args = os.args();
    let port = match args.get(1) {
        .Some(value) => value,
        .None => "9100",
    };
    let bind = f"127.0.0.1:{port}";
    let config = NodeConfig { bind: bind, transport: NodeTransport.Tcp, key: "kv-server.key", cluster: os.env("HEW_NODE_CLUSTER") ?? "", seeds: [] };
    Node.start(config).expect("KV server node starts");
    println(f"[kv-server] public credential: {Node.identity_key()}");
    if (os.env("HEW_NODE_CLUSTER") ?? "").is_empty() {
        Node.shutdown();
        return;
    }
    let empty: HashMap<string, string> = HashMap.new();
    let store = spawn KeyValue { store: empty };
    Node.register("kv", store);
    let peer = authenticated_peer();
    let export = peer.export(store).expect("client accepts KeyValue service");
    println("[kv-server] KeyValue service offered to authenticated client");

    // Keep the export alive while the client performs its round trips.
    sleep(30s);
    export.close();
    Node.shutdown();
    println("[kv-server] shutdown complete");
}
