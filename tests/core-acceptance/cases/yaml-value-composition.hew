import std.encoding.yaml;

type Envelope {
    value: yaml.Value;
}

fn retained() -> yaml.Value {
    var child = yaml.array();
    child.push(yaml.from_string("déjà\0vu")).expect("push succeeds");
    var original = yaml.object();
    original.set("items", child).expect("set succeeds");
    var edited = original;
    edited.set("items", yaml.null()).expect("set succeeds");
    child.push(yaml.from_int(8)).expect("push succeeds");
    println(child.array_len().expect("array_len succeeds"));
    println(edited.get_field("items").expect("get_field succeeds").expect("get_field returns a value").type_of() == Kind.Null);
    original.get_field("items").expect("get_field succeeds").expect("get_field returns a value")
}

fn capture_value(value: yaml.Value) -> fn[clone]() -> string {
    || value.array_get(0).expect("array_get succeeds").expect("array_get returns a value").get_string().expect("get_string succeeds")
}

fn parse_selected() -> yaml.Value {
    let document = yaml.parse("workflow:\n  steps:\n    - build\n").expect("parse succeeds");
    let workflow = document.get_field("workflow").expect("get_field succeeds").expect("workflow exists");
    let steps = workflow.get_field("steps").expect("get_field succeeds").expect("steps exist");
    steps.array_get(0).expect("array_get succeeds").expect("step exists")
}

fn main() -> i64 {
    var values = retained();
    let snapshot = values;
    let captured = capture_value(values);
    values.push(yaml.from_bool(false)).expect("push succeeds");
    println(values.array_len().expect("array_len succeeds"));
    println(snapshot.array_len().expect("array_len succeeds"));
    println(captured().len());
    println(captured() == "déjà\0vu");
    let encoded = snapshot.stringify().expect("stringify succeeds");
    println(yaml.parse(encoded).expect("parse succeeds") == snapshot);
    var wrong = yaml.from_string("unchanged");
    println(wrong.push(values).is_err());
    println(wrong.get_string().expect("get_string succeeds"));
    println(values.array_len().expect("array_len succeeds"));
    println(values.array_get(2).expect("array_get succeeds").is_none());
    println(values.array_get(-1).is_err());
    println(yaml.parse("[").is_err());
    println(yaml.from_int(7).get_int().expect("get_int succeeds"));
    var envelope = Envelope { value: yaml.array() };
    let original = envelope;
    envelope.value.push(yaml.from_int(11)).expect("push succeeds");
    println(envelope.value.array_len().expect("array_len succeeds"));
    println(original.value.array_len().expect("array_len succeeds"));
    values.push({
        values.push(yaml.from_int(99)).expect("push succeeds");
        yaml.from_int(100)
    }).expect("the call succeeds");
    println(values.array_len().expect("array_len succeeds"));
    println(snapshot.array_len().expect("array_len succeeds"));
    var parsed = yaml.parse("workflow:\n  signed: true\n").expect("parse succeeds");
    var alias = parsed;
    parsed.set("workflow", yaml.null()).expect("set succeeds");
    alias.set("representable", yaml.from_bool(true)).expect("set succeeds");
    println(parsed.get_field("workflow").expect("get_field succeeds").expect("workflow exists").type_of() == Kind.Null);
    println(alias.get_field("workflow").expect("get_field succeeds").expect("workflow exists").type_of() == Kind.Mapping);
    println(alias.get_field("representable").expect("get_field succeeds").expect("representable exists").get_bool().expect("get_bool succeeds"));
    println(parse_selected().get_string().expect("get_string succeeds"));
    0
}
