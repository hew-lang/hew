type Node { id: i64, }
type Inner { r: Rc<Node>, }
type Outer { i: Inner, tag: string, }

fn frame(seed: i64) -> i64 {
    let shared: Rc<Node> = Rc.new(Node { id: seed });
    let inner = Inner { r: shared };
    let outer = Outer { i: inner, tag: "tag" };
    outer.tag.len()
}

fn main() -> i64 {
    var total: i64 = 0;
    for seed in 0..50 {
        total = total + frame(seed);
        println("frame");
    }
    total - 50 * 3
}
