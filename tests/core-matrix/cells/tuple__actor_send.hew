actor Sink {
    var hits: i64;

    receive fn take(v: (i64, string)) -> i64 {
        let (v_a, v_b) = v;
        println(f"{v_a} {v_b}");
        hits = hits + 1;
        hits
    }
}

fn main() {
    let x: (i64, string) = (1, "x0");
    let s = spawn Sink(hits: 0);
    match await s.take(x) {
        Ok(n) => println(f"hits {n}"),
        Err(_) => println("err"),
    }
}
