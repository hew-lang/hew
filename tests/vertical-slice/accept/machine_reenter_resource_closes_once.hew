// A `#[resource]` carried through a machine `reenter` is MOVED from the source
// state into the state the body builds. A move is not a copy, so the source
// state has nothing left to release: N re-entries perform ZERO closes, and the
// handle is closed exactly once when the machine value's scope ends.
//
// Before the transition-out drop learned which payload fields the body moved,
// the first `UseIt` closed fd=42 and left the closed handle in the new state;
// a second `UseIt` re-closed the zeroed slot. Neither a compile error nor a
// runtime trap surfaced it.
//
// Expected stdout:
//   opened
//   reentered
//   reentered
//   reentered
//   CLOSE fd=42
// The three `reentered` lines with no CLOSE between them are the assertion:
// one CLOSE, and it lands after the last observable statement in `main`.
#[resource]
type Handle {
    fd: i64;
}

impl Handle {
    fn close(self) {
        println(f"CLOSE fd={self.fd}");
    }
}

machine Session {
    events {
        Open;
        UseIt;
    }

    state Idle;
    state Active { h: Handle; }

    on Open: Idle => Active {
        Active { h: Handle { fd: 42 } }
    }
    on UseIt: Active => Active reenter {
        // Self-transition carrying the handle through unchanged.
        Active { h: self.h }
    }

    default { state }
}

fn main() {
    var s = Session::Idle;
    s.step(SessionEvent::Open);
    println("opened");
    for i in 0 .. 3 {
        s.step(SessionEvent::UseIt);
        println("reentered");
    }
}
