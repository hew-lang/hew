// Declaration members end with semicolons; commas separate values and lists.
machine Toggle {
    events { Flip; }
    state Off,
    state On;
    on Flip: Off => On;
    on Flip: On => Off;
    default { state }
}

fn main() {
    var toggle: Toggle = .Off;
    let _ = toggle.step(.Flip);
    println(toggle.state_name());
}
