// A step stages a copy of its machine until it commits, and a direct
// #[resource] payload has no copy, so the transition that takes it is refused.
#[resource]
type Handle {
    fd: i64,
}

impl Handle {
    fn close(consume self) {}
}

machine ConnSession {
    events {
        Connect { fd: i64, }
        ,Disconnect,
    }

    state Idle,
    state Active { h: Handle, },

    on Connect(fd): Idle => Active { h: Handle { fd: fd } }
    on Disconnect: Active => Idle,

    default { state }
}

fn main() {
    var s = ConnSession.Idle;
    let _ = s.step(ConnSessionEvent.Connect { fd: 1 });
    let _ = s.step(ConnSessionEvent.Disconnect);
}
