    site=s234 ty=duration value_class=BitCopy intent=Read strategy=BorrowRead why="first vertical-slice classifier"
    site=s237 ty=string value_class=CowValue intent=Read strategy=CowShare why="first vertical-slice classifier"
  blocks:
    id=0 kind=normal
      successor: none
    id=1 kind=normal
      successor: none
    id=2 kind=normal
      successor: none
    id=3 kind=normal
      successor: none
  drop_plans:
    call[bb0 hew_duration_nanos -> bb1] ->
      (none)
    unwind[bb0 hew_duration_nanos] ->
      (none)
    cancel[bb0] ->
      (none)
    call[bb1 hew_i64_to_string -> bb2] ->
      (none)
    unwind[bb1 hew_i64_to_string] ->
      (none)
    call[bb2 hew_string_concat -> bb3] ->
      (none)
    unwind[bb2 hew_string_concat] ->
      drop _2 ty=string kind=cow_heap(hew_string_drop)
    return[bb3] ->
      (none)

