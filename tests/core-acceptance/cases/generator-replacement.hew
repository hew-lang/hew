type Holder { values: Generator<string, ()> }
type Pair { first: Holder, second: Holder }
enum Choice { Values(Generator<string, ()>), Empty }

gen fn words(label: string) -> string {
    defer {
        println(label + " cleaned");
    }
    yield label;
    yield "later";
}

fn started(label: string) -> Generator<string, ()> {
    let values = words(label);
    match values.next() { .Some(value) => println(value), .None => panic("empty"), }
    values
}

fn main() {
    {
        var _holder = Holder { values: started("record old") };
        _holder = Holder { values: started("record new") };
        println("record replaced");
    }
    {
        var _choice = Choice.Values(started("enum old"));
        _choice = Choice.Empty;
        println("enum empty");
        _choice = Choice.Values(started("enum new"));
    }
    {
        var pair = Pair {
            first: Holder { values: started("field old") },
            second: Holder { values: started("sibling") },
        };
        pair.first = Holder { values: started("field new") };
        println("field replaced");
        match pair.second.values.next() { .Some(value) => println(value), .None => panic("sibling closed"), }
    }
    {
        var pair = Pair {
            first: Holder { values: started("moved") },
            second: Holder { values: started("remaining") },
        };
        let extracted = pair.first;
        pair = Pair {
            first: Holder { values: started("refilled first") },
            second: Holder { values: started("refilled second") },
        };
        println("partial replaced");
        match extracted.values.next() { .Some(value) => println(value), .None => panic("moved value closed"), }
    }
    {
        var _holder = Holder { values: started("field moved") };
        let extracted = _holder.values;
        _holder.values = started("field refilled");
        println("field refilled safely");
        match extracted.next() { .Some(value) => println(value), .None => panic("moved field closed"), }
    }
    println("done");
}
