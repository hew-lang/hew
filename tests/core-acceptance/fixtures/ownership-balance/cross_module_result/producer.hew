import std.string;

pub type UserRecord {
    name: string;
    id: i64;
}

pub enum UserEnum {
    Missing(string);
}

pub fn fetch(n: i64) -> Result<UserRecord, UserEnum> {
    if n >= 0 {
        return .Ok(UserRecord { name: "user" + f"{n}", id: n });
    }
    .Err(UserEnum.Missing("missing" + f"{n}"))
}

pub fn relay(n: i64) -> Result<UserRecord, UserEnum> {
    fetch(n)
}
