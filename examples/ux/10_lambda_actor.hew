// Lambda actor - inline actor definition
fn main() {
    let worker = actor |msg: i64| {
        println(msg * 2);
    };
    match worker(5) {
        .Ok(_) => {},
        .Err(_) => panic("lambda call failed for 5"),
    }
    match worker(10) {
        .Ok(_) => {},
        .Err(_) => panic("lambda call failed for 10"),
    }
    match worker(15) {
        .Ok(_) => {},
        .Err(_) => panic("lambda call failed for 15"),
    }
    close(worker);
}
