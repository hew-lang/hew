#[resource]
type Tok {
    id: i64
}

impl Tok {
    fn close(consume self) {
        println(f"close {self.id}");
    }
}

fn main() {
    let k = Tok { id: 1 };
    var m: HashMap<Tok, i64> = HashMap.new();
    m.insert(k, 9);
    match m.get(k) {
        Option.Some(v) => println(f"got {v}"),
        Option.None => println("missing"),
    }
}
