// Observe an independent machine copy through a typed, bounded feed.
import std.concurrency.lifecycle.{Lifecycle};

import std.machine.watch;

fn main() {
    let initial: Lifecycle<i64> = .Created;
    let (owner, feed) = watch.observe(initial, capacity: 8, subscribers: 1).expect("observe lifecycle");
    var lifecycle = owner;
    let updates = feed.subscribe().expect("subscribe");
    let before = updates.initial().state.state_name();
    let _ = lifecycle.step(.Initialise).expect("machine step failed");
    let notice = updates.recv().expect("complete history").expect("initialise notice");
    println(f"{before} -> {notice.state.state_name()}");
    lifecycle.close();
    assert(updates.recv().expect("closed history").is_none());
}
