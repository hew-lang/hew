//! @name Option and Result Methods
//! @description is_some, is_none, is_ok, is_err, `??` and `handle` recovery on Option and Result

fn main() {
    let some_val = Option.Some(42);
    let none_val: Option<i64> = .None;
    println(some_val.is_some());
    println(some_val.is_none());
    println(none_val.is_some());
    println(none_val.is_none());
    let some_for_unwrap = Option.Some(77);
    let unwrap_result = some_for_unwrap.expect("some_for_unwrap is present");
    println(unwrap_result);
    let some_with_default = Option.Some(55);
    println(some_with_default ?? 99);
    let none_with_default: Option<i64> = .None;
    println(none_with_default ?? 99);
    let ok_val: Result<i64, string> = .Ok(7);
    let err_val: Result<i64, string> = .Err("oops");
    println(ok_val.is_ok());
    println(ok_val.is_err());
    println(err_val.is_ok());
    println(err_val.is_err());
    let ok_for_unwrap: Result<i64, string> = .Ok(13);
    let unwrap_ok = ok_for_unwrap.expect("ok_for_unwrap is present");
    println(unwrap_ok);
    let ok_with_handle: Result<i64, string> = .Ok(5);
    println(ok_with_handle handle _e {
        0
    });
    let err_with_handle: Result<i64, string> = .Err("fallback");
    println(err_with_handle handle _e {
        0
    });
}
