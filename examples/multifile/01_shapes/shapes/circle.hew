// circle.hew — peer file inside the `shapes` directory module.
//
// Circle and its factory belong to shapes. Use shapes.Circle after
// `import shapes;`, or import shapes.{Circle} to use the short name.
pub type Circle {
    radius: i64;
}

pub fn make_circle(radius: i64) -> Circle {
    Circle { radius: radius }
}

impl Drawable for Circle {
    fn draw(self) -> string {
        f"Circle(r={self.radius})"
    }
}
