// MIR-corpus fixture: bounded pipe send/recv/try_recv/close + select.
//
// Pins the element-layout-witness recv entries
// (`hew_stream_next_layout` / `hew_stream_try_next_layout`), the
// send path (`hew_stream_send_layout`), the sink/stream close
// releases, and the select winner-picker (`hew_select_first`).
import std.stream;

actor Inbox {
    receive fn run(unused: i64) {
        let (tx, rx): (stream.Sink<string>, stream.Stream<string>) = match stream.pipe(4) {
            .Ok(pair) => pair,
            .Err(err) => panic(f"stream.pipe failed: {err}"),
        };
        tx.send("ready").expect("send");
        tx.close();
        match rx.recv() {
            .Some(msg) => println(msg),
            .None => println("closed"),
        }
        match rx.try_recv() {
            .Some(msg) => println(msg),
            .None => println("empty"),
        }
        select {
            again from rx.recv() => {
                match again {
                    .Some(msg) => println(msg),
                    .None => println("closed"),
                }
            },
            after 1s => println("timeout"),
        };
        rx.close();
    }
}

fn main() {
    let i = spawn Inbox;
    let _ = i.run(0);
}
