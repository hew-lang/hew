// A runtime operation that adopts its operand takes ownership of it: a fresh
// temporary and a local nothing reads again transfer, while a local the caller
// still reads keeps its own independent value.

type Node { child: Vec<Node> }
type Item { name: string, parts: Vec<i64> }
type Key { name: string }

fn build_deep(depth: i64) -> Node {
  var n = Node { child: Vec.new() };
  for i in 0..depth {
    var wrapper: Vec<Node> = Vec.new();
    wrapper.push(n);
    n = Node { child: wrapper };
  }
  return n;
}

fn main() {
  // Each level pushes the whole structure built so far. Cloning it made this
  // quadratic; transferring makes it one allocation per level.
  let deep = build_deep(8000);
  println(f"depth=8000 root={deep.child.len()}");

  // A local the caller reads again is copied in, not moved out: the stored
  // element and the caller's own value are independent afterwards.
  var kept = Item { name: "kept", parts: Vec.new() };
  kept.parts.push(1);
  var bag: Vec<Item> = Vec.new();
  bag.push(kept);
  kept.parts.push(2);
  println(f"kept={kept.parts.len()} stored={bag[0].parts.len()}");

  // A map adopts an owned value beside a cloned key; both read back intact.
  var index: HashMap<Key, Item> = HashMap.new();
  let key = Key { name: "first" };
  var value = Item { name: "entry", parts: Vec.new() };
  value.parts.push(7);
  value.parts.push(8);
  index.insert(key, value);
  println(f"map={index.len()} parts={index[key].parts.len()} name={index[key].name}");
}
