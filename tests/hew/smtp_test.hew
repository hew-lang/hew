//! Tests for std::net::smtp error surfacing.
//!
//! Every case here is offline and deterministic: an out-of-range port is
//! rejected before any socket work, and the connect probes target a loopback
//! port that was bound to claim an ephemeral number and then released, so the
//! connection is refused immediately rather than waiting on a timeout.
//! Message-build validation is covered by hew-std/src/smtp.rs's
//! `#[cfg(test)]` unit tests, which reach it without a transport.

import std.net.smtp;

import std.net.websocket;

import std.testing;

/// Claim an ephemeral loopback port and release it.
///
/// The returned port is one nothing is listening on, so a connect to it is
/// refused immediately. This avoids both a fixed port and a timeout wait.
fn closed_loopback_port() -> i64 {
    match websocket.listen("127.0.0.1:0") {
        .Ok(server) => {
            let port = server.port();
            server.close();
            port
        },
        .Err(_err) => {
            panic("could not claim an ephemeral loopback port");
            0
        },
    }
}

#[test]
fn test_module_try_send_bad_port_surfaces_reason() {
    let result = smtp.try_send("localhost", 999999, "u", "p", "a@example.com", "b@example.com", "s", "b");
    match result {
        .Ok(_) => panic("expected an out-of-range port to fail"),
        .Err(msg) => testing.assert_true(msg.contains("out of range")),
    }
}

/// `connect` builds a lazy `SmtpTransport`; building one performs no I/O, so
/// before the probe a connection to a port nothing listens on was returned as
/// a live `Conn` and the failure only surfaced at the first send. The probe
/// makes it observable at connect time.
#[test]
fn test_connect_to_a_closed_port_is_a_failure_not_a_live_conn() {
    let port = closed_loopback_port();
    match smtp.connect("127.0.0.1", port, "u", "p") {
        .Ok(conn) => {
            conn.close();
            panic("expected a connect to a closed port to fail");
        },
        .Err(msg) => testing.assert_true(msg.contains("cannot reach")),
    }
}

#[test]
fn test_connect_tls_to_a_closed_port_is_a_failure_not_a_live_conn() {
    let port = closed_loopback_port();
    match smtp.connect_tls("127.0.0.1", port, "u", "p") {
        .Ok(conn) => {
            conn.close();
            panic("expected a TLS connect to a closed port to fail");
        },
        .Err(msg) => testing.assert_true(msg.contains("cannot reach")),
    }
}

// The following cases prove that an oversized i64 port does not silently
// wrap into an unintended valid port before Rust validates it. Before the
// FFI port parameter was widened from i32 to i64, `4294967883_i64 as i32`
// truncated (two's-complement) down to 587 -- a "valid-looking" port -- and
// the connection would proceed to attempt an SMTP handshake on the wrapped
// port instead of rejecting the out-of-range value. Every case here must
// fail fast with an explicit out-of-range message, never a real send/connect
// attempt on port 587 (or any other wrapped value).
#[test]
fn test_module_try_send_oversized_i64_port_does_not_wrap() {
    let result = smtp.try_send("localhost", 4294967883, "u", "p", "a@example.com", "b@example.com", "s", "b");
    match result {
        .Ok(_) => panic("expected an oversized i64 port to fail, not wrap into a valid port"),
        .Err(msg) => testing.assert_true(msg.contains("out of range")),
    }
}

#[test]
fn test_module_try_send_html_oversized_i64_port_does_not_wrap() {
    let result = smtp.try_send_html("localhost", 4294967883, "u", "p", "a@example.com", "b@example.com", "s", "<b>b</b>");
    match result {
        .Ok(_) => panic("expected an oversized i64 port to fail, not wrap into a valid port"),
        .Err(msg) => testing.assert_true(msg.contains("out of range")),
    }
}

#[test]
fn test_module_send_oversized_i64_port_returns_nonzero() {
    let rc = smtp.send("localhost", 4294967883, "u", "p", "a@example.com", "b@example.com", "s", "b");
    testing.assert_true(rc != 0);
    testing.assert_true(smtp.last_error().contains("out of range"));
}

#[test]
fn test_conn_connect_oversized_i64_port_rejects_before_relay_init() {
    match smtp.connect("localhost", 4294967883, "u", "p") {
        .Ok(conn) => {
            conn.close();
            panic("expected an oversized port to be rejected, not wrapped");
        },
        .Err(msg) => testing.assert_true(msg.contains("out of range")),
    }
}

#[test]
fn test_conn_connect_tls_oversized_i64_port_rejects_before_relay_init() {
    match smtp.connect_tls("localhost", 4294967883, "u", "p") {
        .Ok(conn) => {
            conn.close();
            panic("expected an oversized port to be rejected, not wrapped");
        },
        .Err(msg) => testing.assert_true(msg.contains("out of range")),
    }
}
