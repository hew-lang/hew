//! Status: runnable
//! Description: Actor completion-call example with no used return value.

actor Messenger {
    receive fn print_message(msg: i64) -> i64 {
        println(msg);
        println(42);
        0
    }
}

fn main() {
    let messenger = spawn Messenger;
    let _ = messenger.print_message(100);
    println(999);
}
