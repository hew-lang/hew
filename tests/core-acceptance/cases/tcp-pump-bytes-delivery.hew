import std.net;

import std.stream;

// Each sink reports its connection's close, so `main` knows every payload
// reached `on_data` before it exits.
actor Ready {
    var tx: stream.Sink<i64>;
    receive fn mark() {
        tx.send(1).expect("ready");
    }
}

actor ProbeSink {
    let ready: Ready;
    receive fn on_data(data: bytes) {
        println("DATA");
    }
    receive fn on_close() {
        ready.mark().expect("mark closed");
    }
}

// The pump owns the connection and hands each received chunk to the sink.
actor Pump {
    let conn: net.Connection;
    let sink: ProbeSink;
    receive fn run() {
        loop {
            match conn.recv() {
                .Some(data) => {
                    sink.on_data(data).expect("deliver");
                }
                .None => {
                    break;
                }
            }
        }
        sink.on_close().expect("close");
    }
}

fn main() -> i64 {
    let deliveries = 50;
    let (ready_tx, ready_rx) = stream.pipe(deliveries).expect("ready");
    let ready = spawn Ready(tx: ready_tx);
    let listener = match net.listen("127.0.0.1:0") {
        .Ok(value) => value,
        .Err(_) => panic("network setup failed"),
    };
    let addr = f"127.0.0.1:{listener.local_port()}";
    for _ in 0..deliveries {
        // The kernel completes the handshake before `accept` takes it.
        let client = match net.connect(addr) {
            .Ok(value) => value,
            .Err(_) => panic("connect failed"),
        };
        let conn = listener.accept().expect("accept");
        let sink = spawn ProbeSink(ready: ready);
        let pump = spawn Pump(conn: conn, sink: sink);
        mailbox(pump, on_full: .Wait).run().expect("start pump");
        client.send(b"active-mode-delivery").expect("send");
        client.close();
    }
    for _ in 0..deliveries {
        ready_rx.recv();
    }
    println("DONE");
    0
}
