// Commit or rollback completes the transaction on every normal branch.
#[linear]
type Txn {
    id: i64,
}

impl Txn {
    fn rollback(consume self) -> i64 { 0 }
    fn commit(consume self) -> i64 {
        0
    }
}

fn main() -> i64 {
    let err = 0;
    let t = Txn { id: 0 };
    let _r = if err == 0 {
        let _commit = t.commit();
        1
    } else {
        let _rollback = t.rollback();
        0
    };
    42
}
