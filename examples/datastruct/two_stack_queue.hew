// Two-Stack Queue - Queue implemented with two stacks
// inbox: push here, outbox: pop from here
// When outbox empty, transfer all from inbox to outbox (reverses order = FIFO)
//
// A parameter is the callee's own copy, so every operation that moves elements
// hands both stacks back and the caller reassigns.
fn transfer(var inbox: Vec<i64>, var outbox: Vec<i64>) -> (Vec<i64>, Vec<i64>) {
    while !inbox.is_empty() {
        let val = inbox.pop();
        outbox.push(val);
    }
    (inbox, outbox)
}

fn tsq_enqueue(var inbox: Vec<i64>, val: i64) -> Vec<i64> {
    inbox.push(val);
    inbox
}

fn tsq_dequeue(var inbox: Vec<i64>, var outbox: Vec<i64>) -> (Vec<i64>, Vec<i64>, i64) {
    if outbox.is_empty() {
        let (drained, filled) = transfer(inbox, outbox);
        inbox = drained;
        outbox = filled;
    }
    let val = outbox.pop();
    (inbox, outbox, val)
}

// Peek only reports the front element, so it transfers into its own copies.
fn tsq_peek(inbox: Vec<i64>, var outbox: Vec<i64>) -> i64 {
    if outbox.is_empty() {
        let (_drained, filled) = transfer(inbox, outbox);
        outbox = filled;
    }
    outbox[outbox.len() - 1]
}

fn tsq_size(inbox: Vec<i64>, outbox: Vec<i64>) -> i64 {
    inbox.len() + outbox.len()
}

fn tsq_is_empty(inbox: Vec<i64>, outbox: Vec<i64>) -> i64 {
    if tsq_size(inbox, outbox) == 0 {
        1
    } else {
        0
    }
}

fn run_test(name: string, passed: i64) -> i64 {
    if passed == 1 {
        println(f"PASS: {name}");
    } else {
        println(f"FAIL: {name}");
    }
    passed
}

fn main() {
    var total = 0;
    var passed = 0;
    var inbox: Vec<i64> = Vec.new();
    var outbox: Vec<i64> = Vec.new();
    // Test 1: empty
    total = total + 1;
    let r1 = if tsq_is_empty(inbox, outbox) == 1 {
        1
    } else {
        0
    };
    passed = passed + run_test("new queue is empty", r1);

    // Test 2: enqueue and size
    total = total + 1;
    let seeds: Vec<i64> = [10, 20, 30];
    for seed in seeds {
        inbox = tsq_enqueue(inbox, seed);
    }
    let r2 = if tsq_size(inbox, outbox) == 3 {
        1
    } else {
        0
    };
    passed = passed + run_test("enqueue 3 size=3", r2);

    // Test 3: peek returns first enqueued (FIFO)
    total = total + 1;
    let r3 = if tsq_peek(inbox, outbox) == 10 {
        1
    } else {
        0
    };
    passed = passed + run_test("peek returns first", r3);

    // Test 4: dequeue FIFO order
    total = total + 1;
    let (in_d1, out_d1, d1) = tsq_dequeue(inbox, outbox);
    let (in_d2, out_d2, d2) = tsq_dequeue(in_d1, out_d1);
    let (in_d3, out_d3, d3) = tsq_dequeue(in_d2, out_d2);
    inbox = in_d3;
    outbox = out_d3;
    var r4 = 0;
    if d1 == 10 {
        if d2 == 20 {
            if d3 == 30 {
                r4 = 1;
            }
        }
    }
    passed = passed + run_test("dequeue FIFO order", r4);

    // Test 5: empty after all dequeued
    total = total + 1;
    let r5 = if tsq_is_empty(inbox, outbox) == 1 {
        1
    } else {
        0
    };
    passed = passed + run_test("empty after dequeue all", r5);

    // Test 6: interleaved enqueue/dequeue
    total = total + 1;
    let pair: Vec<i64> = [1, 2];
    for value in pair {
        inbox = tsq_enqueue(inbox, value);
    }
    let (in_i1, out_i1, id1) = tsq_dequeue(inbox, outbox); // should be 1
    inbox = tsq_enqueue(in_i1, 3);
    let (in_i2, out_i2, id2) = tsq_dequeue(inbox, out_i1); // should be 2
    let (in_i3, out_i3, id3) = tsq_dequeue(in_i2, out_i2); // should be 3
    inbox = in_i3;
    outbox = out_i3;
    var r6 = 0;
    if id1 == 1 {
        if id2 == 2 {
            if id3 == 3 {
                r6 = 1;
            }
        }
    }
    passed = passed + run_test("interleaved ops FIFO", r6);

    // Test 7: many elements
    total = total + 1;
    var in2: Vec<i64> = Vec.new();
    var out2: Vec<i64> = Vec.new();
    for i in 0 .. 50 {
        in2 = tsq_enqueue(in2, i);
    }
    var r7 = 1;
    for i in 0 .. 50 {
        let (next_in, next_out, val) = tsq_dequeue(in2, out2);
        in2 = next_in;
        out2 = next_out;
        if val != i {
            r7 = 0;
        }
    }
    passed = passed + run_test("50 elements FIFO", r7);

    // Summary
    println(f"{passed}/{total} tests passed");
    if passed == total {
        println("ALL PASS");
    } else {
        println("SOME FAILED");
    }
}
