//! A consumer actor drains a `Stream<bytes>` with `input.recv()`.
//! The producer calls `sink.send(item)` and closes the sink to signal EOF.
//! Empty frames are values; only `None` marks EOF. Run producer and consumer
//! concurrently when either can wait for the other.

import std.encoding.utf8;

import std.stream;

actor Drainer {
    let input: stream.Stream<bytes>,
    receive fn run() {

        // Consumer: each recv suspends until a frame is ready; None == EOF.
        var received = 0;
        var done = false;
        while !done {
            match input.recv() {
                .Some(frame) => {
                    let decoded_frame = utf8.decode(frame) handle error {
                        println(f"invalid UTF-8: {error}");
                        return;
                    };
                    println(f"recv {decoded_frame}");
                    received = received + 1;
                },
                .None => {
                    done = true;
                },
            }
        }
        println(f"drained {received} frames");
    }
}

fn main() {
    let (sink, input) = match stream.bytes_pipe(8) {
        .Ok(pair) => pair,
        .Err(error) => panic(error),
    };
    // The Stream half moves into the actor's state; the Sink half stays local.
    let d = spawn Drainer(input: input);
    let _ = d.run();
    // Producer side: drive the local sink, then close it to signal EOF.
    for i in 0 .. 3 {
        sink.send(f"frame-{i}".to_bytes());
    }
    sink.close();
    // Every printed line comes from the handler; runtime shutdown drains it to
    // quiescence after `main` returns. A trailing print here would be ordered
    // against the handler only by a sleep, which is not an edge.
}
