//! UTC calendar views of precise wall-clock timestamps.
//!
//! Calendar conversion uses Chrono's proleptic Gregorian range, years -262143
//! through +262142. A timestamp outside that range remains a valid timestamp
//! but calendar operations fail with Range. Unix time does not represent leap
//! seconds; parsing rejects them. Explicit offsets normalize to UTC.
//!
//! Use timestamp.now() for wall time and instant.now() for elapsed time.

/// Checked failures at the UTC calendar boundary.
pub enum DateTimeError {
    Range(string);
    Format(string);
    Parse(string);
}

impl Error for DateTimeError {}

impl Display for DateTimeError {
    fn fmt(self) -> string {
        match self {
            .Range(message) => message,
            .Format(message) => message,
            .Parse(message) => message,
        }
    }
}

/// A UTC calendar view. Monday is weekday zero; Sunday is six.
pub type Components {
    year: i64;
    month: i64;
    day: i64;
    hour: i64;
    minute: i64;
    second: i64;
    nanosecond: u32;
    weekday: i64;
    days_in_month: i64;
}

type CalendarTextResult {
    status: i32;
    text: string;
    message: string;
}

type CalendarTimeResult {
    status: i32;
    seconds: i64;
    nanoseconds: u32;
    message: string;
}

type CalendarPartsResult {
    status: i32;
    year: i64;
    month: i64;
    day: i64;
    hour: i64;
    minute: i64;
    second: i64;
    nanosecond: u32;
    weekday: i64;
    days_in_month: i64;
    message: string;
}

fn checked(status: i32, message: string) fails DateTimeError {
    match status {
        0 => {}
        1 => {
            return error DateTimeError.Range(message);
        }
        3 => {
            return error DateTimeError.Format(message);
        }
        _ => {
            return error DateTimeError.Parse(message);
        }
    }
}

fn checked_time(result: CalendarTimeResult) -> timestamp fails DateTimeError {
    checked(result.status, result.message)?;
    timestamp.from_unix_parts(result.seconds, result.nanoseconds).expect("normalized calendar result")
}

/// Format a timestamp using Chrono's strftime directives, including fractional
/// seconds with %.f or %.9f. Calendar output uses UTC.
pub fn format(value: timestamp, pattern: string) -> string fails DateTimeError {
    let (seconds, nanos) = value.unix_parts();
    let result = unsafe {
        hew_calendar_format(seconds, nanos, pattern)
    };
    checked(result.status, result.message)?;
    result.text
}

/// Parse strftime-formatted text. A missing offset means UTC; an explicit
/// offset is converted to UTC. Fractional seconds retain nanosecond precision.
pub fn parse(text: string, pattern: string) -> timestamp fails DateTimeError {
    checked_time(unsafe {
        hew_calendar_parse(text, pattern)
    })?
}

/// Extract the UTC civil fields of a timestamp.
pub fn components(value: timestamp) -> Components fails DateTimeError {
    let (seconds, nanos) = value.unix_parts();
    let result = unsafe {
        hew_calendar_components(seconds, nanos)
    };
    checked(result.status, result.message)?;
    Components { year: result.year, month: result.month, day: result.day, hour: result.hour, minute: result.minute, second: result.second, nanosecond: result.nanosecond, weekday: result.weekday, days_in_month: result.days_in_month }
}

/// Construct a UTC timestamp from civil fields, checking their ranges.
pub fn from_parts(year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64, nanosecond: u32) -> timestamp fails DateTimeError {
    checked_time(unsafe {
        hew_calendar_from_parts(year, month, day, hour, minute, second, nanosecond)
    })?
}

/// Extract the UTC year.
pub fn year(value: timestamp) -> i64 fails DateTimeError {
    (components(value)?).year
}
/// Extract the UTC month (1–12).
pub fn month(value: timestamp) -> i64 fails DateTimeError {
    (components(value)?).month
}
/// Extract the UTC day of month.
pub fn day(value: timestamp) -> i64 fails DateTimeError {
    (components(value)?).day
}
/// Extract the UTC hour (0–23).
pub fn hour(value: timestamp) -> i64 fails DateTimeError {
    (components(value)?).hour
}
/// Extract the UTC minute (0–59).
pub fn minute(value: timestamp) -> i64 fails DateTimeError {
    (components(value)?).minute
}
/// Extract the UTC second (0–59).
pub fn second(value: timestamp) -> i64 fails DateTimeError {
    (components(value)?).second
}
/// Return the UTC weekday (Monday = 0, Sunday = 6).
pub fn weekday(value: timestamp) -> i64 fails DateTimeError {
    (components(value)?).weekday
}

/// Add elapsed 24-hour days, with ordinary checked duration arithmetic.
pub fn add_days(value: timestamp, days: i64) -> timestamp {
    value + days * 24h
}
/// Add elapsed hours.
pub fn add_hours(value: timestamp, hours: i64) -> timestamp {
    value + hours * 1h
}
/// Return whole elapsed seconds, truncating towards zero.
pub fn diff_secs(a: timestamp, b: timestamp) -> i64 {
    (a - b).secs()
}

/// Format UTC ISO 8601, preserving the nonzero nanosecond fraction.
pub fn to_iso8601(value: timestamp) -> string fails DateTimeError {
    format(value, "%Y-%m-%dT%H:%M:%S%.fZ")?
}

/// Parse ISO 8601 with Z or a numeric offset, preserving fractional seconds.
pub fn parse_iso8601(text: string) -> timestamp fails DateTimeError {
    parse(text, "%Y-%m-%dT%H:%M:%S%.f%#z")?
}

extern "C" {
    fn hew_calendar_format(seconds: i64, nanoseconds: u32, pattern: string) -> CalendarTextResult;
    fn hew_calendar_parse(text: string, pattern: string) -> CalendarTimeResult;
    fn hew_calendar_components(seconds: i64, nanoseconds: u32) -> CalendarPartsResult;
    fn hew_calendar_from_parts(year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64, nanosecond: u32) -> CalendarTimeResult;
}
