//! Option methods and helper functions.
//!
//! The `impl Option<T>` block below is the method surface every program sees
//! without an import (`map`, `and_then`, `unwrap_or` and the rest). The
//! free functions are older type-specific helpers reached through
//! `import std.option`.
//!
//! # Examples
//!
//! ```
//! import std.option;
//!
//! fn main() {
//!     let x = Some(42);
//!     println(option.is_some_int(x));        // true
//!     println(option.unwrap_or_int(x, 0));   // 42
//!
//!     let y: Option<i64> = None;
//!     println(option.is_none_int(y));         // true
//!     println(option.unwrap_or_int(y, -1));   // -1
//! }
//! ```

// ── Predicates ──────────────────────────────────────────────────────
/// Returns `true` if the option contains a value.
pub fn is_some_int(opt: Option<i64>) -> bool {
    match opt {
        .Some(_) => true,
        .None => false,
    }
}

/// Returns `true` if the option is `None`.
pub fn is_none_int(opt: Option<i64>) -> bool {
    match opt {
        .Some(_) => false,
        .None => true,
    }
}

// ── Unwrap ──────────────────────────────────────────────────────────
/// Unwrap the `i64` value.  Panics if the option is `None`.
pub fn unwrap_int(opt: Option<i64>) -> i64 {
    match opt {
        .Some(v) => v,
        .None => {
            panic("option: unwrap called on None");
            0
        },
    }
}

/// Unwrap the `i64` value, or return `fallback` if `None`.
pub fn unwrap_or_int(opt: Option<i64>, fallback: i64) -> i64 {
    match opt {
        .Some(v) => v,
        .None => fallback,
    }
}

// ── Map ─────────────────────────────────────────────────────────────
/// Apply `f` to the contained `i64` value, or return `None` if empty.
pub fn map_int(opt: Option<i64>, f: fn(i64) -> i64) -> Option<i64> {
    match opt {
        .Some(v) => .Some(f(v)),
        .None => .None,
    }
}

// ── Contains ────────────────────────────────────────────────────────
/// Returns `true` if the option contains `needle`.
pub fn contains_int(opt: Option<i64>, needle: i64) -> bool {
    match opt {
        .Some(v) => v == needle,
        .None => false,
    }
}

// ── string variants ────────────────────────────────────────────────
/// Returns `true` if the option contains a value.
pub fn is_some_str(opt: Option<string>) -> bool {
    match opt {
        .Some(_) => true,
        .None => false,
    }
}

/// Returns `true` if the option is `None`.
pub fn is_none_str(opt: Option<string>) -> bool {
    match opt {
        .Some(_) => false,
        .None => true,
    }
}

/// Unwrap the `string` value.  Panics if the option is `None`.
pub fn unwrap_str(opt: Option<string>) -> string {
    match opt {
        .Some(v) => v,
        .None => {
            panic("option: unwrap called on None");
            ""
        },
    }
}

/// Unwrap the `string` value, or return `fallback` if `None`.
pub fn unwrap_or_str(opt: Option<string>, fallback: string) -> string {
    match opt {
        .Some(v) => v,
        .None => fallback,
    }
}

/// Apply `f` to the contained `string` value, or return `None` if empty.
pub fn map_str(opt: Option<string>, f: fn(string) -> string) -> Option<string> {
    match opt {
        .Some(v) => .Some(f(v)),
        .None => .None,
    }
}

/// Returns `true` if the option contains `needle`.
pub fn contains_str(opt: Option<string>, needle: string) -> bool {
    match opt {
        .Some(v) => v == needle,
        .None => false,
    }
}

// ── Float variants ─────────────────────────────────────────────────
/// Returns `true` if the option contains a value.
pub fn is_some_f64(opt: Option<f64>) -> bool {
    match opt {
        .Some(_) => true,
        .None => false,
    }
}

/// Returns `true` if the option is `None`.
pub fn is_none_f64(opt: Option<f64>) -> bool {
    match opt {
        .Some(_) => false,
        .None => true,
    }
}

/// Unwrap the `f64` value.  Panics if the option is `None`.
pub fn unwrap_f64(opt: Option<f64>) -> f64 {
    match opt {
        .Some(v) => v,
        .None => {
            panic("option: unwrap called on None");
            0.0
        },
    }
}

/// Unwrap the `f64` value, or return `fallback` if `None`.
pub fn unwrap_or_f64(opt: Option<f64>, fallback: f64) -> f64 {
    match opt {
        .Some(v) => v,
        .None => fallback,
    }
}

/// Apply `f` to the contained `f64` value, or return `None` if empty.
pub fn map_f64(opt: Option<f64>, f: fn(f64) -> f64) -> Option<f64> {
    match opt {
        .Some(v) => .Some(f(v)),
        .None => .None,
    }
}

/// Returns `true` if the option contains `needle`.
pub fn contains_f64(opt: Option<f64>, needle: f64) -> bool {
    match opt {
        .Some(v) => v == needle,
        .None => false,
    }
}

// ── Methods ─────────────────────────────────────────────────────────
//
// Every program sees these methods without an import, like `.len()`.
impl<T> Option<T> {
    /// Returns `true` if the option contains a value.
    pub fn is_some(self) -> bool {
        match self {
            .Some(_) => true,
            .None => false,
        }
    }
    /// Returns `true` if the option is `None`.
    pub fn is_none(self) -> bool {
        match self {
            .Some(_) => false,
            .None => true,
        }
    }
    /// Unwrap the value. Panics with `reason` if the option is `None`.
    pub fn expect(consume self, reason: string) -> T {
        match self {
            .Some(v) => v,
            .None => panic(f"expect failed: {reason}"),
        }
    }
    /// Unwrap the value, or return `fallback` if `None`.
    pub fn unwrap_or(consume self, consume fallback: T) -> T {
        match self {
            .Some(v) => v,
            .None => fallback,
        }
    }
    /// Unwrap the value, or compute a fallback from `f` if `None`. Prefer
    /// this over `unwrap_or` when the fallback is expensive to build, since
    /// `f` runs only on the `None` path.
    pub fn unwrap_or_else(consume self, f: fn() -> T) -> T {
        match self {
            .Some(v) => v,
            // Braced, not a bare `f()`: the pinned tree-sitter-hew grammar
            // does not yet parse a zero-argument call as a bare match-arm body.
            .None => {
                f()
            },
        }
    }
    /// Apply `f` to the contained value, or return `None` unchanged.
    pub fn map<U>(consume self, f: fn(T) -> U) -> Option<U> {
        match self {
            .Some(v) => .Some(f(v)),
            .None => .None,
        }
    }
    /// Apply `f` (itself `Option`-returning) to the contained value, or
    /// return `None` unchanged. Chains a fallible lookup without nesting
    /// `Option<Option<U>>`.
    pub fn and_then<U>(consume self, f: fn(T) -> Option<U>) -> Option<U> {
        match self {
            .Some(v) => f(v),
            .None => .None,
        }
    }
    /// Return the option unchanged if it holds a value, otherwise the
    /// option computed by `f`.
    pub fn or_else(consume self, f: fn() -> Option<T>) -> Option<T> {
        match self {
            .Some(v) => .Some(v),
            .None => {
                f()
            },
        }
    }
    /// Convert to a `Result`, using `err` as the `Err` value when `None`.
    pub fn ok_or<E>(consume self, consume err: E) -> Result<T, E> {
        match self {
            .Some(v) => .Ok(v),
            .None => .Err(err),
        }
    }
    /// Move the value out of this place and leave `None` behind.
    pub fn take(var self) -> Option<T> {
        let taken = self;
        self = .None;
        taken
    }
}
