// Direct iteration evaluates a side-effectful map source exactly once.

fn make_map() -> HashMap<i64, i64> {
    var m: HashMap<i64, i64> = HashMap.new();
    m.insert(1, 10);
    m.insert(2, 20);
    m.insert(3, 30);
    m
}

pub fn main() -> i64 {
    var total = 0;
    var count = 0;
    for (k, v) in make_map() {
        total = total + k + v;
        count = count + 1;
    }
    if count != 3 {
        return 100 + count;
    }
    total
}
