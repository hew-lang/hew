// A stack returns the most recently added value first.
import std.vec;

type Stack {
    values: Vec<i64>;
}

impl Stack {
    fn push(var self, value: i64) {
        self.values.push(value);
    }

    fn pop(var self) -> Option<i64> {
        if self.values.is_empty() {
            return .None;
        }
        .Some(self.values.pop())
    }

    fn peek(self) -> Option<i64> {
        vec.last(self.values)
    }
}

fn main() {
    var stack = Stack { values: [] };
    assert(stack.peek().is_none());
    for value in [10, 20, 30] {
        stack.push(value);
    }
    assert(stack.values.len() == 3);
    assert(stack.peek() == .Some(30));
    while let .Some(value) = stack.pop() {
        println(f"Popped {value}");
    }
    assert(stack.pop().is_none());
    stack.push(99);
    assert(stack.pop() == .Some(99));
    for value in 0..100 {
        stack.push(value);
    }
    assert(stack.values.len() == 100);
    assert(stack.peek() == .Some(99));
}
