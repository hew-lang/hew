//! Process execution.
//!
//! `run` and `run_argv` execute a command to completion and capture its
//! output. `start` launches a `Command` (never through a shell) and returns a
//! `Child` whose piped stdio are ordinary `Stream<bytes>` and `Sink<bytes>`
//! values.
//!
//! A `Child` owns its process until it is reaped. `wait` suspends the calling
//! task and holds no thread while the child runs: it parks on the I/O reactor
//! (a pidfd on Linux, a kqueue process filter on FreeBSD and macOS) or, on
//! Windows, on the system thread pool's wait for the process handle. Any
//! number of tasks may wait on children at once. The reaped status is kept,
//! so a second `wait` returns it again and a later `terminate` or `kill` does
//! nothing. Dropping a `Child` that is still running kills and reaps it.
//!
//! A child's stdout and stderr streams are `select` sources on every native
//! host. A losing selection leaves its data available for the next receive.
//! Windows retains at most 64 KiB of completed output per pipe; pending reads
//! use overlapped I/O and release their buffers after cancellation completes.
//!
//! # Examples
//!
//! ```hew,no_run
//! import std.encoding.utf8;
//! import std.process;
//!
//! fn main() {
//!     let output = process.run_argv("printf", ["<%s>", "hello world"]).expect("printf runs");
//!     println(output.stdout);
//!
//!     var command = process.command("cat", []);
//!     command.stdin = process.Stdio.Piped;
//!     command.stdout = process.Stdio.Piped;
//!     let child = process.start(command).expect("cat starts");
//!     let input = child.stdin().expect("stdin is piped");
//!     let echoed = child.stdout().expect("stdout is piped");
//!     input.send("ping".to_bytes()).expect("cat reads");
//!     input.finish();
//!     for chunk in echoed {
//!         println(utf8.decode_lossy(chunk));
//!     }
//!     println(f"{child.wait():?}");
//! }
//! ```

import std.stream;

/// A handle to a completed command invocation inside the runtime.
#[resource]
#[opaque]
pub type ProcessResultHandle {
}

impl ProcessResultHandle {
    fn close(consume self) {
        unsafe {
            hew_process_result_free(self)
        };
    }
}

/// The runtime-owned child-process handle behind a `Child`.
#[opaque]
type ChildHandle {
}

/// Where a child's standard stream goes.
pub enum Stdio {
    /// Share this program's stream.
    Inherit;
    /// Connect the stream to the null device.
    Null;
    /// Connect the stream to a pipe the parent takes once from the `Child`.
    Piped;
}

/// A program, its arguments and its stdio. The arguments reach the program
/// exactly as given; no shell interprets them.
pub type Command {
    program: string;
    args: Vec<string>;
    stdin: Stdio;
    stdout: Stdio;
    stderr: Stdio;
}

/// How a process ended.
pub enum ExitStatus {
    /// The process exited with this code.
    Exited(i64);
    /// A signal with this number ended the process (Unix only).
    Signalled(i64);
}

/// Captured output from a completed command.
pub type CommandOutput {
    status: ExitStatus;
    stdout: string;
    stderr: string;
}

/// Structured process failures.
pub enum ProcessError {
    InvalidArguments(string);
    LaunchFailed(string);
    /// The stream was not `Stdio.Piped` or was already taken.
    NotPiped;
    /// The operating system refused a wait or signal with this error code.
    System(i64);
}

/// A running or finished child process.
#[resource]
pub type Child {
    handle: ChildHandle;
}

impl Child {
    /// The child's operating-system process ID.
    fn id(self) -> i64 {
        unsafe {
            hew_process_id(self.handle)
        }
    }

    /// Take the write end of the child's stdin pipe. Finishing the sink
    /// closes the pipe, so the child reads end of input.
    fn stdin(self) -> Result<stream.Sink<bytes>, ProcessError> {
        unsafe {
            let pair = hew_process_take_pipe(self.handle, 0);
            if !hew_stream_pair_is_valid(pair) {
                return .Err(ProcessError.NotPiped);
            }
            let sink: stream.Sink<bytes> = stream.pair_sink(pair);
            pair.close();
            .Ok(sink)
        }
    }

    /// Take the read end of the child's stdout pipe.
    fn stdout(self) -> Result<stream.Stream<bytes>, ProcessError> {
        take_output(self.handle, 1)
    }

    /// Take the read end of the child's stderr pipe.
    fn stderr(self) -> Result<stream.Stream<bytes>, ProcessError> {
        take_output(self.handle, 2)
    }

    /// Wait for the child to exit and reap it. The task suspends and holds
    /// no thread; a wait cancelled by `scope within` releases its watch and
    /// leaves the child running and unreaped.
    fn wait(self) -> ExitStatus fails ProcessError {
        loop {
            match self.try_wait()? {
                .Some(status) => return status,
                .None => {}
            }
            let watch = unsafe {
                hew_process_exit_stream(self.handle)
            };
            if !unsafe {
                hew_stream_pair_is_valid(watch)
            } {
                let failure = unsafe {
                    hew_process_wait_error(self.handle)
                };
                return error ProcessError.System(failure as i64);
            }
            // The stream carries no items; it ends once the child exits.
            let exited: stream.Stream<bytes> = stream.pair_stream(watch);
            watch.close();
            let _ = exited.recv();
        }
    }

    /// Reap the child if it has exited, without waiting.
    fn try_wait(self) -> Result<Option<ExitStatus>, ProcessError> {
        let state = unsafe {
            hew_process_poll(self.handle)
        };
        if state < 0 {
            return .Err(ProcessError.System(0 - state as i64));
        }
        if state == 0 {
            return .Ok(.None);
        }
        let number = unsafe {
            hew_process_status(self.handle)
        };
        if unsafe {
            hew_process_signalled(self.handle)
        } {
            .Ok(.Some(ExitStatus.Signalled(number)))
        } else {
            .Ok(.Some(ExitStatus.Exited(number)))
        }
    }

    /// Ask the child to stop: SIGTERM on Unix. Windows has no request to
    /// stop, so this terminates the child like `kill`. A reaped child is not
    /// signalled.
    fn terminate(self) -> Result<(), ProcessError> {
        signal_result(unsafe {
            hew_process_signal(self.handle, false)
        })
    }

    /// Stop the child at once: SIGKILL on Unix, `TerminateProcess` on
    /// Windows. A reaped child is not signalled.
    fn kill(self) -> Result<(), ProcessError> {
        signal_result(unsafe {
            hew_process_signal(self.handle, true)
        })
    }

    /// Release the child at scope exit, killing and reaping it first if it
    /// is still running.
    fn close(consume self) {
        unsafe {
            hew_process_drop(self.handle)
        };
    }
}

impl Display for ExitStatus {
    fn fmt(self) -> string {
        match self {
            ExitStatus.Exited(code) => f"Exited({code})",
            ExitStatus.Signalled(signal) => f"Signalled({signal})",
        }
    }
}

impl Display for ProcessError {
    fn fmt(self) -> string {
        match self {
            ProcessError.InvalidArguments(message) => message,
            ProcessError.LaunchFailed(message) => message,
            ProcessError.NotPiped => "NotPiped: the stream was not piped or was already taken",
            ProcessError.System(code) => f"System({code}): the operating system refused the operation",
        }
    }
}

fn take_output(handle: ChildHandle, which: i32) -> Result<stream.Stream<bytes>, ProcessError> {
    unsafe {
        let pair = hew_process_take_pipe(handle, which);
        if !hew_stream_pair_is_valid(pair) {
            return .Err(ProcessError.NotPiped);
        }
        let output: stream.Stream<bytes> = stream.pair_stream(pair);
        pair.close();
        .Ok(output)
    }
}

fn signal_result(failure: i32) -> Result<(), ProcessError> {
    if failure == 0 {
        .Ok(())
    } else {
        .Err(ProcessError.System(failure as i64))
    }
}

fn stdio_mode(stdio: Stdio) -> i32 {
    match stdio {
        Stdio.Inherit => 0,
        Stdio.Null => 1,
        Stdio.Piped => 2,
    }
}

fn last_process_error(default_message: string) -> ProcessError {
    unsafe {
        let message = hew_process_last_error();
        hew_clear_error();
        if message == "" {
            ProcessError.LaunchFailed(default_message)
        } else {
            // A runtime execution failure is always a launch failure; never
            // classify it by searching attacker-controlled command text.
            ProcessError.LaunchFailed(message)
        }
    }
}

fn take_command_output(consume result: ProcessResultHandle) -> CommandOutput {
    unsafe {
        let number = hew_process_result_status(result);
        let status = if hew_process_result_signalled(result) {
            ExitStatus.Signalled(number)
        } else {
            ExitStatus.Exited(number)
        };
        let output = CommandOutput { status: status, stdout: hew_process_result_stdout(result), stderr: hew_process_result_stderr(result) };
        hew_process_result_free(result);
        output
    }
}

// ── Module-level functions ────────────────────────────────────────────
/// Run a shell command synchronously and capture its status and output.
pub fn run(command: string) -> Result<CommandOutput, ProcessError> {
    unsafe {
        hew_clear_error();
        let result = hew_process_run(command);
        if hew_process_result_is_valid(result) {
            .Ok(take_command_output(result))
        } else {
            let error = last_process_error("process.run: command execution failed");
            hew_process_result_free(result);
            .Err(error)
        }
    }
}

/// Run a program without the shell and capture its status and output.
pub fn run_argv(command: string, args: Vec<string>) -> Result<CommandOutput, ProcessError> {
    unsafe {
        hew_clear_error();
        let result = hew_process_run_argv(command, args);
        if hew_process_result_is_valid(result) {
            .Ok(take_command_output(result))
        } else {
            let error = last_process_error("process.run_argv: command execution failed");
            hew_process_result_free(result);
            .Err(error)
        }
    }
}

/// A `Command` for `program` with `args` and every stream inherited.
pub fn command(program: string, args: Vec<string>) -> Command {
    Command { program: program, args: args, stdin: Stdio.Inherit, stdout: Stdio.Inherit, stderr: Stdio.Inherit }
}

/// Launch `command` without waiting. A program that cannot be launched is
/// `Err(ProcessError.LaunchFailed)`.
pub fn start(command: Command) -> Result<Child, ProcessError> {
    unsafe {
        hew_clear_error();
        let handle = hew_process_start(command.program, command.args, stdio_mode(command.stdin), stdio_mode(command.stdout), stdio_mode(command.stderr));
        if hew_process_is_valid(handle) {
            .Ok(Child { handle: handle })
        } else {
            let error = last_process_error(f"process.start: could not launch {command.program}");
            hew_process_drop(handle);
            .Err(error)
        }
    }
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    fn hew_process_run(command: string) -> ProcessResultHandle;
    fn hew_process_run_argv(command: string, args: Vec<string>) -> ProcessResultHandle;
    fn hew_process_result_is_valid(result: ProcessResultHandle) -> bool;
    fn hew_process_result_signalled(result: ProcessResultHandle) -> bool;
    fn hew_process_result_status(result: ProcessResultHandle) -> i64;
    fn hew_process_result_stdout(result: ProcessResultHandle) -> string;
    fn hew_process_result_stderr(result: ProcessResultHandle) -> string;
    fn hew_process_result_free(consume result: ProcessResultHandle);
    fn hew_process_start(program: string, args: Vec<string>, stdin: i32, stdout: i32, stderr: i32) -> ChildHandle;
    fn hew_process_is_valid(child: ChildHandle) -> bool;
    fn hew_process_id(child: ChildHandle) -> i64;
    fn hew_process_take_pipe(child: ChildHandle, which: i32) -> stream.StreamPair;
    fn hew_process_exit_stream(child: ChildHandle) -> stream.StreamPair;
    fn hew_process_wait_error(child: ChildHandle) -> i32;
    fn hew_process_poll(child: ChildHandle) -> i32;
    fn hew_process_signalled(child: ChildHandle) -> bool;
    fn hew_process_status(child: ChildHandle) -> i64;
    fn hew_process_signal(child: ChildHandle, force: bool) -> i32;
    fn hew_process_drop(handle: ChildHandle);
    fn hew_process_last_error() -> string;
    fn hew_clear_error();
    fn hew_stream_pair_is_valid(pair: stream.StreamPair) -> bool;
}
