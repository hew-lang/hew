import std.time.datetime;

actor Worker {
    let value: i64 = 7;
    receive fn read() -> i64 {
        value
    }
    receive fn crash_me() {
        panic("restart the child");
    }
}

supervisor App {
    strategy: one_for_one;
    intensity: 20 within 60s;
    child worker: Worker(value: 7);
}

fn main() {
    let app = spawn App;
    let started = datetime.now_ms();
    for _ in 0 .. 9 {
        let _ = app.worker.crash_me();
        let fresh = {
            let __hew_migrated_role_458 = app.worker;
            restarted(__hew_migrated_role_458);
            __hew_migrated_role_458
        };
        match fresh.read() {
            .Ok(value) => assert(value == 7),
            .Err(_) => panic("restarted child unavailable"),
        }
    }
    let elapsed = datetime.now_ms() - started;
    println(elapsed >= 50000 && elapsed < 52000);
    {
        let __hew_migrated_actor_737 = app;
        stop(__hew_migrated_actor_737);
        stopped(__hew_migrated_actor_737);
    };
}
