import std.encoding.xml;

type ParseError {
    message: string,
    offset: i64,
}

enum ParseOutcome {
    Parsed(xml.Node),
    Failed(ParseError),
    Skipped(string),
}

enum ScalarSibling {
    Loaded(xml.Node),
    Count(i64),
}

fn classify(s: string) -> ParseOutcome {
    if s == "" {
        ParseOutcome.Skipped("empty".to_upper())
    } else {
        match xml.parse(s) {
            .Ok(node) => ParseOutcome.Parsed(node),
            .Err(message) => ParseOutcome.Failed(ParseError { message: message, offset: 0 }),
        }
    }
}

#[test]
fn result_resource_and_string_variants() {
    match xml.parse("<a/>") {
        .Ok(node) => assert(node.get_tag() == "a"),
        .Err(_) => assert(false),
    }
    match xml.parse("<a>") {
        .Ok(node) => {
            node.close();
            assert(false);
        },
        .Err(message) => assert(message.starts_with("xml:")),
    }
}

#[test]
fn user_enum_resource_and_heap_siblings() {
    match classify("<doc/>") {
        ParseOutcome.Parsed(node) => assert(node.get_tag() == "doc"),
        ParseOutcome.Failed(_) => assert(false),
        ParseOutcome.Skipped(_) => assert(false),
    }
    match classify("<doc>") {
        ParseOutcome.Parsed(node) => {
            node.close();
            assert(false);
        },
        ParseOutcome.Failed(error) => {
            assert(error.offset == 0);
            assert(error.message.starts_with("xml:"));
        },
        ParseOutcome.Skipped(_) => assert(false),
    }
    match classify("") {
        ParseOutcome.Parsed(node) => {
            node.close();
            assert(false);
        },
        ParseOutcome.Failed(_) => assert(false),
        ParseOutcome.Skipped(message) => assert(message == "EMPTY"),
    }
}

#[test]
fn scalar_sibling_control() {
    let value = match xml.parse("<x/>") {
        .Ok(node) => ScalarSibling.Loaded(node),
        .Err(reason) => panic(reason),
    };
    match value {
        ScalarSibling.Loaded(node) => assert(node.get_tag() == "x"),
        ScalarSibling.Count(_) => assert(false),
    }
}
