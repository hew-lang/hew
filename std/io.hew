//! Standard I/O operations.
//!
//! Read from stdin and write to stdout or stderr.
//!
//! # Examples
//!
//! ```hew,no_run
//! import std.io;
//!
//! fn main() {
//!     io.write("enter your name: ");
//!     let name = io.read_line() ?? "stranger";
//!     io.write("hello, ");
//!     io.write(name);
//!     io.write("\n");
//! }
//! ```

import std.encoding.utf8;

import std.stream;

/// Read one line from standard input.
///
/// The call waits without holding a scheduler thread, so other tasks keep
/// running while input is silent. The trailing `\n` or `\r\n` is removed and
/// invalid UTF-8 becomes U+FFFD. Returns `None` at end of input; a final line
/// without a newline is still returned first. A read error traps.
///
/// Concurrent reads take lines in the order they started, each line going to
/// exactly one of them. A read that a deadline or an enclosing scope cancels
/// consumes nothing: the next read returns the line that was pending.
pub fn read_line() -> Option<string> {
    var line = next_line();
    if line.is_empty() {
        return .None;
    }
    match line.get(line.len() - 1) {
        .Some(10) => {
            let _ = line.pop();
            match line.get(line.len() - 1) {
                .Some(13) => {
                    let _ = line.pop();
                }
                _ => {}
            }
        }
        _ => {}
    }
    .Some(utf8.decode_lossy(line))
}

/// Write a string to standard output without a trailing newline.
pub fn write(s: string) {
    unsafe {
        hew_io_write(s)
    };
}

/// Write a string to standard error without a trailing newline.
pub fn write_err(s: string) {
    unsafe {
        hew_io_write_err(s)
    };
}

/// Read standard input to its end.
///
/// Waits like `read_line`, and a read error traps. Invalid UTF-8 becomes
/// U+FFFD.
pub fn read_all() -> string {
    var all = next_line();
    var reading = !all.is_empty();
    while reading {
        let more = next_line();
        reading = !more.is_empty();
        all.append(more);
    }
    utf8.decode_lossy(all)
}

/// One raw line with its newline; empty only at end of input. A failed read
/// leaves its message in the stream error slot, which a success clears.
fn next_line() -> bytes {
    let line = unsafe {
        hew_stdin_read_line()
    };
    if line.is_empty() {
        let failure = unsafe {
            hew_stream_last_error()
        };
        if failure != "" {
            panic(f"io: {failure}");
        }
    }
    line
}

/// Why a descriptor cannot be watched for readability.
pub enum WatchError {
    /// The number is not an open descriptor.
    NotOpen;
    /// The descriptor is a regular file, which is always readable, or the
    /// platform has no descriptor readiness (Windows).
    Unsupported;
}

impl Display for WatchError {
    fn fmt(self) -> string {
        match self {
            WatchError.NotOpen => "NotOpen: the number is not an open descriptor",
            WatchError.Unsupported => "Unsupported: this descriptor cannot be watched for readability",
        }
    }
}

impl Error for WatchError {}

/// Watch a descriptor the program opened through FFI, such as a serial
/// device, a socket or a pipe, for readability.
///
/// Each receive waits, without holding a scheduler thread, until a read on
/// `fd` would not wait (data, end of input or an error is pending) and yields
/// `()`; it reads nothing, so the program then reads the descriptor itself.
/// Readiness is level-triggered: a receive returns at once while unread data
/// remains, and `try_recv` yields `()` exactly when a receive would not wait.
/// The stream is a `select` source and never ends on its own. It watches its
/// own duplicate of `fd`: closing it stops the watch and leaves `fd` open,
/// closing `fd` first is safe, and several watches of one descriptor, or a
/// watch of standard input alongside `read_line`, are independent. Unix only.
pub fn watch_readable(fd: i32) -> Result<stream.Stream<()>, WatchError> {
    unsafe {
        match hew_io_watch_check(fd) {
            0 => {}
            1 => return .Err(WatchError.NotOpen),
            _ => return .Err(WatchError.Unsupported),
        }
        let pair = hew_io_watch_readable(fd);
        if !hew_stream_pair_is_valid(pair) {
            return .Err(WatchError.NotOpen);
        }
        let ready: stream.Stream<()> = stream.pair_stream(pair);
        pair.close();
        .Ok(ready)
    }
}

// ── Declarative bytes receiver FFI ───────────────────────────────────
//
// Decode bytes explicitly with std.encoding.utf8.decode or decode_lossy.
// Every method routes to a dedicated hew_bytes_* runtime entry operating on
// the bytes ABI directly.
impl bytes {
    #[extern_symbol(hew_bytes_push)]
    fn push(self, byte: u8) {}
    /// Remove and return the last byte, or `None` when the buffer is empty.
    #[extern_symbol(hew_bytes_pop)]
    fn pop(self) -> Option<u8> {
        .None
    }
    #[runtime(family = BytesLen, lowering = direct, target = native, classification = stable, c_return = storage, receiver = borrow)]
    #[extern_symbol(hew_bytes_len)]
    fn len(self) -> i64 {
        0
    }
    #[extern_symbol(hew_bytes_get)]
    fn get(self, index: i64) -> Option<u8> {
        .None
    }
    #[extern_symbol(hew_bytes_set)]
    fn set(self, index: i64, byte: u8) {}
    #[runtime(family = BytesIsEmpty, lowering = direct, target = native, classification = stable, c_return = truth_bool, receiver = borrow)]
    #[extern_symbol(hew_bytes_is_empty)]
    fn is_empty(self) -> bool {
        false
    }
    #[extern_symbol(hew_bytes_clear)]
    fn clear(self) {}
    #[runtime(family = BytesContains, lowering = direct, target = native, classification = stable, c_return = truth_bool, receiver = borrow)]
    #[extern_symbol(hew_bytes_contains)]
    fn contains(self, byte: u8) -> bool {
        false
    }
    #[extern_symbol(hew_bytes_append)]
    fn append(self, other: bytes) {}
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    // One line with its newline, or the unterminated last line; empty at
    // end of input. A waiting call: it suspends the task.
    fn hew_stdin_read_line() -> bytes;
    fn hew_stream_last_error() -> string;
    fn hew_io_write(s: string);
    fn hew_io_write_err(s: string);
    fn hew_io_watch_check(fd: i32) -> i32;
    fn hew_io_watch_readable(fd: i32) -> stream.StreamPair;
    fn hew_stream_pair_is_valid(pair: stream.StreamPair) -> bool;
}
