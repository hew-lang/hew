import std.net.http.{Server};

import std.net;

fn serve_forever(server: Server) {
    loop {
        let req = server.accept();
        let path = req.path();
        match path {
            "/" => {
                req.respond_text(200, "Hello from Hew!").expect("failed to send HTTP response");
            },
            "/health" => {
                req.respond_text(200, "OK").expect("failed to send HTTP response");
            },
            _ => {
                req.respond_text(404, "Not Found").expect("failed to send HTTP response");
            },
        }
    }
}

fn main() {
    println("Listening on 0.0.0.0:18080");
    match http.listen("0.0.0.0:18080") {
        .Ok(server) => {
            serve_forever(server);
        },
        .Err(err) => {
            let reason = to_string(err);
            let detail = http.listen_error();
            println(f"cannot listen on 0.0.0.0:18080: {reason} - {detail}");
        },
    }
}
