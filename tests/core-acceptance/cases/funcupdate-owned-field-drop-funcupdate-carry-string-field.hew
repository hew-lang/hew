import std.string;

type Pair {
    keep: string;
    churn: string;
}

fn main() -> i64 {
    var p = Pair { keep: string.repeat("k", 32), churn: string.repeat("a", 32) };
    var i: i64 = 0;
    while i < 50 {
        p = Pair { ..p, churn: string.repeat("b", 32) };
        i = i + 1;
    }
    p.keep.len()
}
