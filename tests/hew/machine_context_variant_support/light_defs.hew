//! Support module for the cross-module contextual-variant coverage (#3149).
//!
//! Every transition here names its target in the head alone, so the machine's
//! state constructors are minted from the transition's expected type. Checking
//! this file on its own always resolved those; the point of the fixture is that
//! the bodies are checked while the file is an imported dependency of another
//! entry point, which is when the expected-type context used to be minted under
//! a bare name the imported `type_defs` row no longer carried.
//!
//! `Named` gives one transition a struct-payload state, so the expected type
//! also has to seed a struct-variant construction, not only a unit variant, and
//! `initial()` keeps the contextual spelling on a plain fn tail.

pub machine Light {
    events {
        Toggle,
        Label,
    }

    state On,
    state Off,
    state Named { label: string, },

    on Toggle: On => Off,
    on Toggle: Off => On,
    on Label: On => Named { label: "lit".to_upper() }

    default { state }
}

/// Factory returning the contextual spelling from a plain fn tail, so the
/// module covers both body shapes it owns.
pub fn initial() -> Light {
    .On
}
