type ParseFailure {
    detail: string;
}

impl Display for ParseFailure {
    fn fmt(self) -> string {
        f"parse failed: {self.detail}"
    }
}

impl Error for ParseFailure {
}

fn parse(text: string) -> i64 fails dyn Error {
    if text == "" {
        return error ParseFailure { detail: "empty input" };
    }
    return text.len();
}

fn main() {
    let width = parse("") handle _ {
        println("caught");
        0
    };
    println(f"width={width}");
}
