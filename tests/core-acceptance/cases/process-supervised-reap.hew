import std.process;
import std.os;
import "../fixtures/process-probe.hew" as process_probe;

// A supervised actor owns a child process. When the actor panics, releasing
// its state kills and reaps the child, so no zombie outlives the incarnation,
// and the restarted actor launches a replacement.
actor Owner {
    var child: Option<process.Child> = .None;
    receive fn launch() -> i64 {
        let started = process.start(process.command(os.args()[0], ["child"])).expect("child starts");
        let pid = started.id();
        child = .Some(started);
        pid
    }
    receive fn fail() {
        panic("owner fails");
    }
}

supervisor Group {
    intensity: 1 within 60s;
    child owner: Owner;
}

// `kill -0` succeeds for a running child and for an unreaped zombie alike, so
// a refusal proves the process was reaped. Windows checks termination and
// executable identity instead of process-object disappearance.
fn alive(pid: i64) -> bool {
    process_probe.alive(f"{pid}")
}

fn main() {
    let args = os.args();
    if args.len() > 1 && args[1] == "child" {
        sleep(60s);
        return;
    }
    let group = spawn Group;
    let first = group.owner.launch().expect("launch");
    println(f"first alive: {alive(first)}");
    let _ = group.owner.fail();
    let owner = group.owner;
    restarted(owner);
    println(f"first reaped: {!alive(first)}");
    let second = group.owner.launch().expect("relaunch");
    println(f"replacement alive: {second != first && alive(second)}");
    stop(group);
    stopped(group);
    println(f"replacement reaped: {!alive(second)}");
}
