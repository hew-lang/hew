// Treap: BST by key, heap by priority
// Each node: [key, priority, left, right] = 4 slots
// NIL = -1 means no child
//
// A parameter is the callee's own copy, so every helper that writes the node
// pool returns it and the caller reassigns. Helpers that also report a node
// index return a tuple.
fn node_key(nodes: Vec<i64>, i: i64) -> i64 {
    nodes[i * 4]
}

fn node_pri(nodes: Vec<i64>, i: i64) -> i64 {
    nodes[i * 4 + 1]
}

fn node_left(nodes: Vec<i64>, i: i64) -> i64 {
    nodes[i * 4 + 2]
}

fn node_right(nodes: Vec<i64>, i: i64) -> i64 {
    nodes[i * 4 + 3]
}

fn set_left(var nodes: Vec<i64>, i: i64, v: i64) -> Vec<i64> {
    nodes.set(i * 4 + 2, v);
    nodes
}

fn set_right(var nodes: Vec<i64>, i: i64, v: i64) -> Vec<i64> {
    nodes.set(i * 4 + 3, v);
    nodes
}

fn add_node(var nodes: Vec<i64>, key: i64, pri: i64, NIL: i64) -> (Vec<i64>, i64) {
    let idx = nodes.len() / 4;
    nodes.push(key);
    nodes.push(pri);
    nodes.push(NIL);
    nodes.push(NIL);
    (nodes, idx)
}

// Right rotate: y is root, x = y.left. Returns the pool and the new subtree root.
fn right_rotate(var nodes: Vec<i64>, y: i64) -> (Vec<i64>, i64) {
    let x = node_left(nodes, y);
    let t2 = node_right(nodes, x);
    nodes = set_right(nodes, x, y);
    nodes = set_left(nodes, y, t2);
    (nodes, x)
}

// Left rotate: x is root, y = x.right. Returns the pool and the new subtree root.
fn left_rotate(var nodes: Vec<i64>, x: i64) -> (Vec<i64>, i64) {
    let y = node_right(nodes, x);
    let t2 = node_left(nodes, y);
    nodes = set_left(nodes, y, x);
    nodes = set_right(nodes, x, t2);
    (nodes, y)
}

// Insert into treap; returns the pool and the new root
fn treap_insert(var nodes: Vec<i64>, root: i64, key: i64, pri: i64, NIL: i64) -> (Vec<i64>, i64) {
    if root == NIL {
        return add_node(nodes, key, pri, NIL);
    }
    // Track path from root to insertion point
    var path: Vec<i64> = Vec.new();
    var dirs: Vec<i64> = Vec.new();
    var cur = root;
    var placed = false;
    while !placed {
        let cur_key = node_key(nodes, cur);
        if key < cur_key {
            let left = node_left(nodes, cur);
            if left == NIL {
                let (grown, new_idx) = add_node(nodes, key, pri, NIL);
                nodes = set_left(grown, cur, new_idx);
                path.push(cur);
                dirs.push(0);
                placed = true;
            } else {
                path.push(cur);
                dirs.push(0);
                cur = left;
            }
        } else {
            let right = node_right(nodes, cur);
            if right == NIL {
                let (grown, new_idx) = add_node(nodes, key, pri, NIL);
                nodes = set_right(grown, cur, new_idx);
                path.push(cur);
                dirs.push(1);
                placed = true;
            } else {
                path.push(cur);
                dirs.push(1);
                cur = right;
            }
        }
    }
    // Fix heap property by rotating up from bottom
    var new_root = root;
    while !path.is_empty() {
        let parent = path.pop();
        let dir = dirs.pop();
        var child = NIL;
        if dir == 0 {
            child = node_left(nodes, parent);
        } else {
            child = node_right(nodes, parent);
        }
        // If child priority > parent priority, rotate
        if child != NIL {
            if node_pri(nodes, child) > node_pri(nodes, parent) {
                var new_subtree = NIL;
                if dir == 0 {
                    let (rotated, sub) = right_rotate(nodes, parent);
                    nodes = rotated;
                    new_subtree = sub;
                } else {
                    let (rotated, sub) = left_rotate(nodes, parent);
                    nodes = rotated;
                    new_subtree = sub;
                }
                // Update grandparent
                if !path.is_empty() {
                    let gp = path[path.len() - 1];
                    let gp_dir = dirs[dirs.len() - 1];
                    if gp_dir == 0 {
                        nodes = set_left(nodes, gp, new_subtree);
                    } else {
                        nodes = set_right(nodes, gp, new_subtree);
                    }
                } else {
                    new_root = new_subtree;
                }
            }
        }
    }
    (nodes, new_root)
}

// Insert every (key, priority) pair; pairs holds key, pri at i*2, i*2+1.
fn treap_insert_all(var nodes: Vec<i64>, root: i64, pairs: Vec<i64>, NIL: i64) -> (Vec<i64>, i64) {
    var curr_root = root;
    let count = pairs.len() / 2;
    for i in 0 .. count {
        let (grown, new_root) = treap_insert(nodes, curr_root, pairs[i * 2], pairs[i * 2 + 1], NIL);
        nodes = grown;
        curr_root = new_root;
    }
    (nodes, curr_root)
}

// Inorder traversal
fn inorder(nodes: Vec<i64>, root: i64, NIL: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec.new();
    if root == NIL {
        return result;
    }
    var stack: Vec<i64> = Vec.new();
    var cur = root;
    var running = true;
    while running {
        while cur != NIL {
            stack.push(cur);
            cur = node_left(nodes, cur);
        }
        if stack.is_empty() {
            running = false;
        } else {
            cur = stack.pop();
            result.push(node_key(nodes, cur));
            cur = node_right(nodes, cur);
        }
    }
    result
}

// Verify BST property
fn check_bst(nodes: Vec<i64>, root: i64, NIL: i64) -> bool {
    let result = inorder(nodes, root, NIL);
    if result.len() <= 1 {
        return true;
    }
    var i = 1;
    while i < result.len() {
        if result[i] <= result[i - 1] {
            return false;
        }
        i = i + 1;
    }
    true
}

// Verify max-heap property on priorities
fn check_heap(nodes: Vec<i64>, root: i64, NIL: i64) -> bool {
    if root == NIL {
        return true;
    }
    var stack: Vec<i64> = Vec.new();
    stack.push(root);
    var ok = true;
    while !stack.is_empty() {
        let cur = stack.pop();
        let l = node_left(nodes, cur);
        let r = node_right(nodes, cur);
        if l != NIL {
            if node_pri(nodes, l) > node_pri(nodes, cur) {
                ok = false;
            }
            stack.push(l);
        }
        if r != NIL {
            if node_pri(nodes, r) > node_pri(nodes, cur) {
                ok = false;
            }
            stack.push(r);
        }
    }
    ok
}

fn test_basic_treap() -> i64 {
    let NIL = 0 - 1;
    let pool: Vec<i64> = Vec.new();
    // key, priority pairs
    let pairs: Vec<i64> = [5, 10, 3, 20, 7, 5, 1, 15, 4, 8];
    let (nodes, root) = treap_insert_all(pool, NIL, pairs, NIL);
    let bst_ok = check_bst(nodes, root, NIL);
    let heap_ok = check_heap(nodes, root, NIL);
    if bst_ok {
        if heap_ok {
            println("PASS: treap BST + heap properties");
            return 1;
        }
    }
    print("FAIL: treap bst=");
    print(bst_ok);
    print(" heap=");
    println(heap_ok);
    0
}

fn test_inorder_sorted() -> i64 {
    let NIL = 0 - 1;
    let pool: Vec<i64> = Vec.new();
    let pairs: Vec<i64> = [10, 50, 5, 30, 15, 40, 3, 25, 7, 35, 12, 20, 20, 45];
    let (nodes, root) = treap_insert_all(pool, NIL, pairs, NIL);
    let result = inorder(nodes, root, NIL);
    var ok = true;
    if result.len() != 7 {
        ok = false;
    }
    if ok {
        if result[0] != 3 {
            ok = false;
        }
        if result[1] != 5 {
            ok = false;
        }
        if result[2] != 7 {
            ok = false;
        }
        if result[3] != 10 {
            ok = false;
        }
        if result[4] != 12 {
            ok = false;
        }
        if result[5] != 15 {
            ok = false;
        }
        if result[6] != 20 {
            ok = false;
        }
    }
    if ok {
        println("PASS: treap inorder is sorted");
        1
    } else {
        println("FAIL: treap inorder not sorted");
        0
    }
}

fn test_high_priority_at_root() -> i64 {
    let NIL = 0 - 1;
    let pool: Vec<i64> = Vec.new();
    // The middle pair carries the highest priority
    let pairs: Vec<i64> = [5, 10, 3, 100, 7, 20];
    let (nodes, root) = treap_insert_all(pool, NIL, pairs, NIL);
    // Node with priority 100 (key=3) should be at root
    let root_pri = node_pri(nodes, root);
    if root_pri == 100 {
        println("PASS: highest priority at root");
        1
    } else {
        print("FAIL: root priority expected 100 got ");
        println(root_pri);
        0
    }
}

fn test_sequential_inserts() -> i64 {
    let NIL = 0 - 1;
    var nodes: Vec<i64> = Vec.new();
    var root = NIL;
    // Use simple pseudo-random priorities
    var pri = 17;
    var i = 1;
    while i <= 15 {
        pri = pri * 31 + 7 - (pri * 31 + 7) / 100 * 100;
        let (grown, new_root) = treap_insert(nodes, root, i, pri, NIL);
        nodes = grown;
        root = new_root;
        i = i + 1;
    }
    let bst_ok = check_bst(nodes, root, NIL);
    let heap_ok = check_heap(nodes, root, NIL);
    let result = inorder(nodes, root, NIL);
    if bst_ok {
        if heap_ok {
            if result.len() == 15 {
                println("PASS: sequential inserts maintain properties");
                return 1;
            }
        }
    }
    println("FAIL: sequential inserts");
    0
}

fn test_single_node() -> i64 {
    let NIL = 0 - 1;
    let pool: Vec<i64> = Vec.new();
    let (nodes, root) = treap_insert(pool, NIL, 42, 99, NIL);
    let bst_ok = check_bst(nodes, root, NIL);
    let heap_ok = check_heap(nodes, root, NIL);
    if bst_ok {
        if heap_ok {
            if node_key(nodes, root) == 42 {
                println("PASS: single node treap");
                return 1;
            }
        }
    }
    println("FAIL: single node treap");
    0
}

fn main() {
    println("=== Treap ===");
    var passed = 0;
    let total = 5;
    passed = passed + test_basic_treap();
    passed = passed + test_inorder_sorted();
    passed = passed + test_high_priority_at_root();
    passed = passed + test_sequential_inserts();
    passed = passed + test_single_node();
    println("");
    print(passed);
    print("/");
    print(total);
    println(" tests passed");
    if passed == total {
        println("PASS");
    } else {
        println("FAIL");
    }
}
