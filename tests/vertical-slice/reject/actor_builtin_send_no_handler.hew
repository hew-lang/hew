// Reject: a named actor without a `receive fn send` handler cannot accept
// a `.send(...)` call. Use a declared handler, including through mailbox(A).
// The concrete actor interface determines which messages it accepts.
//
//
// Distinct from `actor_receive_fn_named_send.hew` (accept): a same-named
// handler is concrete actor dispatch and takes precedence.
actor Adder {
    var count: i64;
    receive fn increment(n: i64) {
        count = count + n;
    }
}

fn main() -> i64 {
    let a = spawn Adder { count: 0 };
    a.send(10);
    0
}
