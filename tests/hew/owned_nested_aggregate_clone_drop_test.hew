import std.encoding.utf8;

extern "C" {
    fn hew_bytes_from_str(s: string) -> bytes;
}

type Rec {
    s: string,
}

fn make_nested() -> ((string, i64), bool) {
    (("hi", 7), true)
}

#[test]
fn test_nested_tuple_return_drops_cleanly() {
    let t = make_nested();
    let (inner, flag) = t;
    let (s, n) = inner;
    assert(s == "hi");
    assert(n == 7);
    assert(flag);
}

#[test]
fn test_vec_clone_deep_copies_nested_tuple_fields() {
    var xs: Vec<((string, i64), bool)> = Vec.new();
    xs.push((("a", 1), true));
    xs.push((("b", 2), false));
    let ys = xs.clone();
    xs.set(0, (("zzz", 9), true));
    let first = match ys.get(0) {
        .Some(x) => x,
        .None => panic("ys.get(0) None"),
    };
    let second = match ys.get(1) {
        .Some(x) => x,
        .None => panic("ys.get(1) None"),
    };
    let (f_inner, f_flag) = first;
    let (f_s, f_n) = f_inner;
    let (s_inner, s_flag) = second;
    let (s_s, s_n) = s_inner;
    assert(ys.len() == 2);
    assert(f_s == "a");
    assert(f_n == 1);
    assert(f_flag);
    assert(s_s == "b");
    assert(s_n == 2);
    assert(!s_flag);
}

#[test]
fn test_vec_clone_drops_nested_bytes_leaf_cleanly() {
    var xs: Vec<((bytes, i64), bool)> = Vec.new();
    let a: bytes = unsafe {
        hew_bytes_from_str("ab")
    };
    let b: bytes = unsafe {
        hew_bytes_from_str("cd")
    };
    xs.push(((a, 11), true));
    xs.push(((b, 12), false));
    let ys = xs.clone();
    let first = match ys.get(0) {
        .Some(x) => x,
        .None => panic("ys.get(0) None"),
    };
    let second = match ys.get(1) {
        .Some(x) => x,
        .None => panic("ys.get(1) None"),
    };
    let (f_inner, f_flag) = first;
    let (f_b, f_n) = f_inner;
    let (s_inner, s_flag) = second;
    let (s_b, s_n) = s_inner;
    assert(ys.len() == 2);
    let decoded_f_b = utf8.decode(f_b) handle error {
        println(f"invalid UTF-8: {error}");
        assert(false);
        return;
    };
    assert(decoded_f_b == "ab");
    assert(f_n == 11);
    assert(f_flag);
    let decoded_s_b = utf8.decode(s_b) handle error {
        println(f"invalid UTF-8: {error}");
        assert(false);
        return;
    };
    assert(decoded_s_b == "cd");
    assert(s_n == 12);
    assert(!s_flag);
}

#[test]
fn test_vec_clone_drops_nested_record_leaf_cleanly() {
    var xs: Vec<((Rec, i64), bool)> = Vec.new();
    xs.push(((Rec { s: "hi" }, 21), true));
    xs.push(((Rec { s: "bye" }, 22), false));
    let ys = xs.clone();
    xs.set(0, ((Rec { s: "changed" }, 99), true));
    let first = match ys.get(0) {
        .Some(x) => x,
        .None => panic("ys.get(0) None"),
    };
    let second = match ys.get(1) {
        .Some(x) => x,
        .None => panic("ys.get(1) None"),
    };
    let (f_inner, f_flag) = first;
    let (f_rec, f_n) = f_inner;
    let (s_inner, s_flag) = second;
    let (s_rec, s_n) = s_inner;
    assert(ys.len() == 2);
    assert(f_rec.s == "hi");
    assert(f_n == 21);
    assert(f_flag);
    assert(s_rec.s == "bye");
    assert(s_n == 22);
    assert(!s_flag);
}
