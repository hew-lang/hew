actor TestSink {
    var hits: i64;

    receive fn take(v: Vec<i64>) -> i64 {
        let v_l = v.len();
        let v_0 = v[0];
        println(f"len={v_l} v0={v_0}");
        hits = hits + 1;
        hits
    }
}

fn main() {
    let x: Vec<i64> = Vec::new();
    x.push(10);
    x.push(20);
    let s = spawn TestSink(hits: 0);
    match await s.take(x) {
        Ok(n) => println(f"hits {n}"),
        Err(_) => println("err"),
    }
}
