#[resource]
type Handle {
    id: i64,
}

impl Handle {
    fn close(consume self) {
        println(f"close {self.id}");
    }
}

type Holder {
    h: Handle,
    name: string,
}

fn main() {
    let holder = Holder { h: Handle { id: 1 }, name: "one" };
    println(f"id={holder.h.id} name={holder.name}");
}
