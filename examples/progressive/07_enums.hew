enum Delivery {
    Pickup;
    Courier(string);
}

fn instructions(delivery: Delivery) -> string {
    match delivery {
        .Pickup => "Collect at the depot",
        .Courier(address) => f"Deliver to {address}",
    }
}

fn main() {
    println(instructions(.Pickup));
    println(instructions(.Courier("14 Oak Street")));
}
