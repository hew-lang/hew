type Boxed { payload: Vec<i64> }

enum Wrap { A(Boxed) }

fn build(n: i64) -> i64 {
    var inner: Vec<i64> = Vec.new();
    inner.push(n);
    inner.push(n + 1);
    let w: Wrap = Wrap.A(Boxed { payload: inner });
    match w {
        Wrap.A(_) => n,
    }
}

fn main() -> i64 {
    var total: i64 = 0;
    for i in 0..64 {
        total = total + build(i);
    }
    if total != 2016 { return 74; }
    0
}
