//! IP address and CIDR utilities.
//!
//! Parse and inspect IP addresses, and perform CIDR subnet calculations.
//!
//! # Examples
//!
//! ```
//! import std.net.ipnet;
//!
//! fn main() {
//!     if ipnet.is_valid("192.168.1.1") {
//!         if ipnet.is_private("192.168.1.1") {
//!             println("private IP");
//!         }
//!     }
//!     if ipnet.cidr_contains("10.0.0.0/8", "10.1.2.3").expect("valid CIDR") {
//!         println("in range");
//!     }
//! }
//! ```

/// Invalid address syntax or a host count outside the language's integer range.
pub enum IpNetError {
    InvalidCidr(string);
    InvalidAddress(string);
    HostCountOverflow;
}

impl Error for IpNetError {}

/// Test whether a string is a valid IP address (v4 or v6).
pub fn is_valid(addr: string) -> bool {
    (unsafe {
        hew_ip_parse(addr)
    }) != 0
}

/// Test whether an IP address is IPv4.
pub fn is_v4(addr: string) -> bool {
    (unsafe {
        hew_ip_is_v4(addr)
    }) != 0
}

/// Test whether an IP address is IPv6.
pub fn is_v6(addr: string) -> bool {
    (unsafe {
        hew_ip_is_v6(addr)
    }) != 0
}

/// Test whether an IP address is a loopback address (e.g. `127.0.0.1`, `::1`).
pub fn is_loopback(addr: string) -> bool {
    (unsafe {
        hew_ip_is_loopback(addr)
    }) != 0
}

/// Test whether an IP address is in a private range (e.g. `10.x`, `192.168.x`).
pub fn is_private(addr: string) -> bool {
    (unsafe {
        hew_ip_is_private(addr)
    }) != 0
}

/// Test whether a CIDR network contains a given IP address.
///
/// # Examples
///
/// ```
/// import std.net.ipnet;
///
/// fn main() {
///     println(ipnet.cidr_contains("10.0.0.0/8", "10.1.2.3").expect("valid CIDR"));   // true
///     println(ipnet.cidr_contains("10.0.0.0/8", "172.16.0.1").expect("valid CIDR"));   // false
/// }
/// ```
pub fn cidr_contains(cidr: string, ip: string) -> bool fails IpNetError {
    if !is_valid(ip) {
        return error IpNetError.InvalidAddress(ip);
    }
    let contains = unsafe {
        hew_cidr_contains(cidr, ip)
    };
    if contains < 0 {
        return error IpNetError.InvalidCidr(cidr);
    }
    contains == 1
}

/// Return the network address of a CIDR block.
///
/// # Examples
///
/// ```
/// import std.net.ipnet;
///
/// fn main() {
///     println(ipnet.cidr_network("192.168.1.0/24").expect("valid CIDR"));   // "192.168.1.0"
/// }
/// ```
pub fn cidr_network(cidr: string) -> string fails IpNetError {
    let network = unsafe {
        hew_cidr_network(cidr)
    };
    if network.is_empty() {
        return error IpNetError.InvalidCidr(cidr);
    }
    network
}

/// Return the IPv4 broadcast address; IPv6 networks have no broadcast address.
///
/// # Examples
///
/// ```
/// import std.net.ipnet;
///
/// fn main() {
///     println(ipnet.cidr_broadcast("192.168.1.0/24").expect("valid CIDR").expect("IPv4 broadcast"));   // "192.168.1.255"
/// }
/// ```
pub fn cidr_broadcast(cidr: string) -> Option<string> fails IpNetError {
    let network = cidr_network(cidr)?;
    if is_v6(network) {
        .None
    } else {
        .Some(unsafe {
            hew_cidr_broadcast(cidr)
        })
    }
}

/// Return the number of usable host addresses in a CIDR block.
///
/// # Examples
///
/// ```
/// import std.net.ipnet;
///
/// fn main() {
///     println(ipnet.cidr_hosts("192.168.1.0/24").expect("valid CIDR"));   // 254
/// }
/// ```
pub fn cidr_hosts(cidr: string) -> i64 fails IpNetError {
    let hosts = unsafe {
        hew_cidr_hosts(cidr)
    };
    if hosts == -1 {
        return error IpNetError.InvalidCidr(cidr);
    }
    if hosts == -2 {
        return error IpNetError.HostCountOverflow;
    }
    hosts
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    fn hew_ip_parse(addr: string) -> i32; // INTERNAL-ABI: 1 = true, 0 = false (matches Rust #[no_mangle] -> i32)
    fn hew_ip_is_v4(addr: string) -> i32; // INTERNAL-ABI: 1 = true, 0 = false (matches Rust #[no_mangle] -> i32)
    fn hew_ip_is_v6(addr: string) -> i32; // INTERNAL-ABI: 1 = true, 0 = false (matches Rust #[no_mangle] -> i32)
    fn hew_ip_is_loopback(addr: string) -> i32; // INTERNAL-ABI: 1 = true, 0 = false (matches Rust #[no_mangle] -> i32)
    fn hew_ip_is_private(addr: string) -> i32; // INTERNAL-ABI: 1 = true, 0 = false (matches Rust #[no_mangle] -> i32)
    fn hew_cidr_contains(cidr: string, ip: string) -> i32;
    fn hew_cidr_network(cidr: string) -> string;
    fn hew_cidr_broadcast(cidr: string) -> string;
    fn hew_cidr_hosts(cidr: string) -> i64;
}
