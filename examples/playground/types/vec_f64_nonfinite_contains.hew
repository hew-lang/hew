//! @name Vec<f64> Non-Finite Contains
//! @description Vec<f64>.contains uses total, bitwise float equality: NaN finds itself and the signed infinities stay distinct

fn main() {
    let zero: f64 = 0.0;
    let nan: f64 = zero / zero;
    let inf: f64 = 1.0 / zero;
    let neg_inf: f64 = -1.0 / zero;
    var nans: Vec<f64> = Vec.new();
    nans.push(nan);
    // Container equality is total: a NaN with the same bits is the same
    // element, unlike the IEEE `==` a bare `f64 == f64` expression lowers to.
    println(f"[nan].contains(nan)   {nans.contains(nan)}");
    println(f"[nan].contains(inf)   {nans.contains(inf)}");
    var infs: Vec<f64> = Vec.new();
    infs.push(inf);
    // +Infinity and -Infinity have different bits, so they are distinct.
    println(f"[inf].contains(-inf)  {infs.contains(neg_inf)}");

    // Finite exact match, and a finite value never matches NaN.
    var nums: Vec<f64> = Vec.new();
    nums.push(2.5);
    println(f"[2.5].contains(2.5)   {nums.contains(2.5)}");
    println(f"[2.5].contains(nan)   {nums.contains(nan)}");
}
