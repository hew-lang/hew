// `policy(target, on_full: ...)` is the completion view: a call through it
// waits for the handler exactly as a call on the handle does, and the policy
// decides only what happens when the destination mailbox is full. `.Reject`
// refuses instead of parking and reports `Rejected(SendFailure<Req>)`, which is
// the one outcome from which the same call may safely be made again. `.Wait`
// is the bare-handle behaviour and is the control here.
actor Gate {
    mailbox 1,
    var done: i64 = 0,

    // A one-way handler the mailbox view can submit to, and a value-returning
    // one the completion views call.
    receive fn occupy(ms: i64) {
        sleep(ms * 1ms);
        done = done + 1;
    }

    receive fn tally() -> i64 { done }
    receive fn echo(value: string) -> string { value }
}

actor Spare {
    receive fn echo(value: string) -> string { value }
}

fn describe<Req>(problem: ActorError<Never, Req>) -> string {
    match problem {
        ActorError.Rejected(failure) => f"rejected: {failure.reason}",
        _ => "unexpected error",
    }
}

fn main() {
    let gate = spawn Gate();
    let refusing = policy(gate, on_full: .Reject);
    let inbox = mailbox(gate, on_full: .Wait);
    // Two accepted submissions: one the actor is running for a long turn, one
    // occupying its single mailbox seat. Both return only once accepted, so
    // the seat is provably taken before the next call is made.
    match inbox.occupy(2000) {
        .Ok(outcome) => println(f"submitted: {outcome}"),
        .Err(_) => panic("the first submission was refused"),
    }
    match inbox.occupy(0) {
        .Ok(_) => {},
        .Err(_) => panic("the queued submission was refused"),
    }
    // No seat left while the long turn runs, so the refusing view refuses.
    match refusing.tally() {
        .Ok(v) => println(v),
        .Err(problem) => println(describe(problem)),
    }
    let spare = spawn Spare();
    // Preserve the result in a binding before extracting its request: recovery
    // must derive the protocol from the value, without the original call site.
    let rejected = refusing.echo("déjà\0vu".to_upper());
    match rejected {
        .Err(ActorError.Rejected(failure)) => {
            let redirected = failure.message.to(spare);
            match redirected {
                .Ok(value) => println(value == "DÉJÀ\0VU"),
                .Err(_) => panic("redirection failed"),
            }
        },
        _ => panic("the full mailbox accepted a request"),
    }
    // Dropping another rejection must release its original owned string.
    let _abandoned = refusing.echo("drop\0me".to_upper());
    let retained = match refusing.echo("retry\0me".to_upper()) {
        .Err(ActorError.Rejected(failure)) => failure.message,
        _ => panic("the full mailbox accepted the retained request"),
    };
    let orphaned = match refusing.echo("terminal\0origin".to_upper()) {
        .Err(ActorError.Rejected(failure)) => failure,
        _ => panic("the full mailbox accepted the terminal-origin request"),
    };
    // A bare-handle call waits for a seat instead, and completes.
    match gate.tally() {
        .Ok(v) => println(v),
        .Err(problem) => println(describe(problem)),
    }
    // Nothing was accepted from the refusal, so the same call is safe to make
    // again; the queue has drained and it is admitted.
    match refusing.tally() {
        .Ok(v) => println(v),
        .Err(problem) => println(describe(problem)),
    }
    match retained.retry() {
        .Ok(value) => println(value == "RETRY\0ME"),
        .Err(_) => panic("retry failed after capacity became available"),
    }
    close(gate);
    // The original destination is terminal. The detached request still owns
    // its payload, and redirection selects Spare.echo's own handler identity.
    match orphaned.to(spare) {
        .Ok(value) => println(value == "TERMINAL\0ORIGIN"),
        .Err(_) => panic("redirection after origin termination failed"),
    }
    close(spare);
    println("closed");
}
