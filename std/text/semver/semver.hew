//! Semantic versioning — pure Hew implementation.
//!
//! Parse, inspect, compare, and match semantic version strings
//! according to the SemVer 2.0.0 specification.
//!
//! # Examples
//!
//! ```
//! import std.text.semver;
//!
//! fn main() {
//!     let v = match semver.parse("1.2.3-beta.1") {
//!         .Ok(version) => version,
//!         .Err(reason) => panic(reason),
//!     };
//!     println(v.major());
//!     if v.matches(">=1.0.0") {
//!         println("compatible");
//!     }
//! }
//! ```

import std.string;

/// A parsed semantic version.
type Version {
    pre_release: string,
    build_meta: string,
    maj: string,
    min: string,
    pat: string,
}

/// Methods available on a parsed `Version`.
trait VersionMethods {
    /// Return the major version number.
    fn major(self) -> i64;

    /// Return the minor version number.
    fn minor(self) -> i64;

    /// Return the patch version number.
    fn patch(self) -> i64;

    /// Return the pre-release label, or an empty string if none.
    fn pre(self) -> string;

    /// Compare this version to another. Returns -1, 0, or 1.
    fn compare(self, other: Version) -> i64;

    /// Test whether this version satisfies a version requirement string.
    fn matches(self, req: string) -> bool;

    /// Return the version as a string.
    fn to_string(self) -> string;

    /// No-op for compatibility (struct versions don't need manual freeing).
    fn free(self);
}

impl VersionMethods for Version {
    /// Return the major version number.
    fn major(ver: Version) -> i64 {
        component_as_i64("major", ver.maj)
    }
    /// Return the minor version number.
    fn minor(ver: Version) -> i64 {
        component_as_i64("minor", ver.min)
    }
    /// Return the patch version number.
    fn patch(ver: Version) -> i64 {
        component_as_i64("patch", ver.pat)
    }
    /// Return the pre-release label, or an empty string if none.
    fn pre(ver: Version) -> string {
        ver.pre_release
    }
    /// Compare this version to another. Return -1, 0, or 1.
    fn compare(ver: Version, other: Version) -> i64 {
        // Bind to local to prevent extract_call_target from finding a direct
        // call, which would bypass this body via handle-method rewriting.
        let result = compare_versions(ver, other);
        result
    }
    /// Test whether this version satisfies a version requirement string.
    fn matches(ver: Version, req: string) -> bool {
        let result = matches_req(ver, req);
        result
    }
    /// Return the version as a string.
    fn to_string(ver: Version) -> string {
        let result = version_to_string(ver);
        result
    }
    /// No-op for compatibility (struct versions don't need manual freeing).
    fn free(ver: Version) {
        // No-op: struct versions are value types, no manual freeing needed.
    }
}

// The historic component accessors return i64. Parsing and precedence are
// unbounded per SemVer 2.0; when a caller explicitly asks an accessor to
// narrow an oversized component, fail observably rather than fabricating a
// sentinel. `to_string`, `compare`, and `matches` never narrow.
fn component_as_i64(name: string, digits: string) -> i64 {
    match string.to_int(digits) {
        .Ok(value) => value,
        .Err(_) => {
            panic(f"semver.Version.{name}: component does not fit in i64");
            0
        },
    }
}

// ── SemVer 2.0 grammar ────────────────────────────────────────────────
// A numeric identifier is one or more digits with no leading zero unless the
// identifier is exactly "0" (SemVer 2.0 §9). An alphanumeric identifier is one
// or more of [0-9A-Za-z-] and must contain at least one non-digit.
fn is_digit_char(c: string) -> bool {
    c >= "0" && c <= "9"
}

fn all_digits(s: string) -> bool {
    let n = s.len();
    if n == 0 {
        return false;
    }
    for i in 0 .. n {
        if !is_digit_char(s.slice(i, i + 1)) {
            return false;
        }
    }
    true
}

fn is_numeric_identifier(s: string) -> bool {
    if !all_digits(s) {
        return false;
    }
    // No leading zero unless the identifier is exactly "0".
    s.len() == 1 || s.slice(0, 1) != "0"
}

fn is_identifier_char(c: string) -> bool {
    is_digit_char(c) || c >= "a" && c <= "z" || c >= "A" && c <= "Z" || c == "-"
}

fn is_alphanumeric_identifier(s: string) -> bool {
    let n = s.len();
    if n == 0 {
        return false;
    }
    for i in 0 .. n {
        if !is_identifier_char(s.slice(i, i + 1)) {
            return false;
        }
    }
    true
}

// Validate a dot-separated series. `numeric_rules` applies the leading-zero
// prohibition, which SemVer 2.0 imposes on pre-release identifiers but not on
// build metadata (§10).
fn dotted_identifiers_are_valid(s: string, numeric_rules: bool) -> bool {
    let n = s.len();
    if n == 0 {
        return false;
    }
    var pos = 0;
    while pos <= n {
        let rest = s.slice(pos, n);
        var end = n;
        match rest.find(".") {
            .Some(i) => {
                end = pos + i;
            },
            .None => {},
        }
        let id = s.slice(pos, end);
        if !is_alphanumeric_identifier(id) {
            return false;
        }
        if numeric_rules && all_digits(id) && !is_numeric_identifier(id) {
            return false;
        }
        if end >= n {
            return true;
        }
        pos = end + 1;
    }
    true
}

// Strip leading zeros so two numeric identifiers of unequal written length
// still compare by magnitude. The grammar forbids leading zeros, but versions
// can also be constructed without going through `parse`.
fn strip_leading_zeros(s: string) -> string {
    let n = s.len();
    var i = 0;
    while i + 1 < n && s.slice(i, i + 1) == "0" {
        i = i + 1;
    }
    s.slice(i, n)
}

// Compare two arbitrary-length decimal strings numerically. Neither value need
// fit in an i64: a longer digit string is the larger number, and equal-length
// strings compare lexicographically.
fn compare_decimal_strings(a: string, b: string) -> i64 {
    let an = strip_leading_zeros(a);
    let bn = strip_leading_zeros(b);
    let alen = an.len();
    let blen = bn.len();
    if alen < blen {
        return -1;
    }
    if alen > blen {
        return 1;
    }
    let cmp = unsafe {
        hew_string_compare(an, bn)
    } as i64;
    if cmp < 0 {
        return -1;
    }
    if cmp > 0 {
        return 1;
    }
    0
}

// ── Module-level functions ────────────────────────────────────────────
/// Parse a semantic version string.
///
/// Returns `Err(string)` if the string is not a valid semantic version.
pub fn parse(s: string) -> Result<Version, string> {
    // Split off build metadata (+...)
    // Clone s so it remains available for error messages and further searches.
    var main_part = clone s;
    var build = "";
    var has_build = false;
    match s.find("+") {
        .Some(plus_idx) => {
            main_part = s.slice(0, plus_idx);
            build = s.slice(plus_idx + 1, s.len());
            has_build = true;
        },
        .None => {},
    }
    if has_build && !dotted_identifiers_are_valid(build, false) {
        return Err(f"semver: invalid build metadata: {s}");
    }
    // Split off pre-release (-...)
    // Clone main_part so it remains available for further searches.
    var version_part = clone main_part;
    var pre = "";
    var has_pre = false;
    match main_part.find("-") {
        .Some(dash_idx) => {
            version_part = main_part.slice(0, dash_idx);
            pre = main_part.slice(dash_idx + 1, main_part.len());
            has_pre = true;
        },
        .None => {},
    }
    if has_pre && !dotted_identifiers_are_valid(pre, true) {
        return Err(f"semver: invalid pre-release: {s}");
    }
    // Split major.minor.patch
    let first_dot = match version_part.find(".") {
        .Some(i) => i,
        .None => return Err(f"semver: invalid version string: {s}"),
    };
    let major_str = version_part.slice(0, first_dot);
    let rest = version_part.slice(first_dot + 1, version_part.len());
    let second_dot = match rest.find(".") {
        .Some(i) => i,
        .None => return Err(f"semver: invalid version string: {s}"),
    };
    let minor_str = rest.slice(0, second_dot);
    let patch_str = rest.slice(second_dot + 1, rest.len());
    // Each of major, minor, and patch must be a numeric identifier: digits
    // only, and no leading zero unless the component is exactly "0".
    if !is_numeric_identifier(major_str) || !is_numeric_identifier(minor_str) || !is_numeric_identifier(patch_str) {
        return Err(f"semver: invalid version string: {s}");
    }
    Ok(Version { pre_release: pre, build_meta: build, maj: major_str, min: minor_str, pat: patch_str })
}

/// Format a `Version` as its canonical string representation.
fn version_to_string(v: Version) -> string {
    let maj = v.maj;
    let min = v.min;
    let pat = v.pat;
    let pre = v.pre_release;
    let bld = v.build_meta;
    var s = maj + "." + min + "." + pat;
    if pre.len() > 0 {
        s = s + "-" + pre;
    }
    if bld.len() > 0 {
        s = s + "+" + bld;
    }
    s
}

// ── Comparison ────────────────────────────────────────────────────────
/// Compare two versions according to SemVer 2.0 precedence rules.
fn compare_versions(a: Version, b: Version) -> i64 {
    let a_maj = a.maj;
    let b_maj = b.maj;
    let a_min = a.min;
    let b_min = b.min;
    let a_pat = a.pat;
    let b_pat = b.pat;
    let maj_cmp = compare_decimal_strings(a_maj, b_maj);
    if maj_cmp != 0 {
        return maj_cmp;
    }
    let min_cmp = compare_decimal_strings(a_min, b_min);
    if min_cmp != 0 {
        return min_cmp;
    }
    let pat_cmp = compare_decimal_strings(a_pat, b_pat);
    if pat_cmp != 0 {
        return pat_cmp;
    }
    // Pre-release comparison per SemVer 2.0:
    // - Version without pre-release has higher precedence than one with
    // - If both have pre-release, compare dot-separated identifiers
    let a_has_pre = a.pre_release.len() > 0;
    let b_has_pre = b.pre_release.len() > 0;
    if !a_has_pre && !b_has_pre {
        return 0;
    }
    if !a_has_pre && b_has_pre {
        return 1;
    }
    if a_has_pre && !b_has_pre {
        return -1;
    }
    compare_pre(a.pre_release, b.pre_release)
}

/// Compare two dot-separated pre-release identifier strings.
fn compare_pre(a: string, b: string) -> i64 {
    // Compare dot-separated identifiers
    var a_pos = 0;
    var b_pos = 0;
    let a_len = a.len();
    let b_len = b.len();
    while a_pos < a_len && b_pos < b_len {
        // Extract next identifier from a
        let a_dot = a.slice(a_pos, a_len).find(".");
        var a_end = a_len;
        match a_dot {
            .Some(i) => {
                a_end = a_pos + i;
            },
            .None => {},
        }
        let a_id = a.slice(a_pos, a_end);
        // Extract next identifier from b
        let b_dot = b.slice(b_pos, b_len).find(".");
        var b_end = b_len;
        match b_dot {
            .Some(i) => {
                b_end = b_pos + i;
            },
            .None => {},
        }
        let b_id = b.slice(b_pos, b_end);
        let cmp = compare_pre_id(a_id, b_id);
        if cmp != 0 {
            return cmp;
        }
        a_pos = a_end + 1;
        b_pos = b_end + 1;
    }
    // If one side is exhausted, shorter pre-release has lower precedence
    if a_pos < a_len && b_pos >= b_len {
        return 1;
    }
    if a_pos >= a_len && b_pos < b_len {
        return -1;
    }
    0
}

/// Compare two individual pre-release identifiers (numeric or alphanumeric).
fn compare_pre_id(a: string, b: string) -> i64 {
    let a_num = string.is_numeric(a);
    let b_num = string.is_numeric(b);
    if a_num && b_num {
        // Numeric identifiers compare numerically at any length, so this must
        // not route through an i64: SemVer 2.0 puts no bound on the number of
        // digits, and a fixed-width parse collapses distinct versions onto the
        // same value.
        return compare_decimal_strings(a, b);
    }
    // Numeric identifiers have lower precedence than alphanumeric
    if a_num && !b_num {
        return -1;
    }
    if !a_num && b_num {
        return 1;
    }
    // Lexicographic comparison for non-numeric identifiers.
    // `<`/`>` on strings uses IntCmp which only handles integers; route through
    // the runtime strcmp shim instead.
    let cmp_r = unsafe {
        hew_string_compare(a, b)
    } as i64;
    if cmp_r < 0 {
        return -1;
    }
    if cmp_r > 0 {
        return 1;
    }
    0
}

// ── Requirement matching ──────────────────────────────────────────────
/// Test whether a version satisfies a comma-separated requirement string.
fn matches_req(v: Version, req: string) -> bool {
    // Process comma-separated constraints
    var pos = 0;
    let rlen = req.len();
    while pos <= rlen {
        // Find next comma
        let rest = req.slice(pos, rlen);
        let comma = rest.find(",");
        var end = rlen;
        match comma {
            .Some(i) => {
                end = pos + i;
            },
            .None => {},
        }
        let part = req.slice(pos, end).trim();
        if part.len() > 0 {
            if !matches_single(v, part) {
                return false;
            }
        }
        if comma.is_none() {
            break;
        }
        pos = end + 1;
    }
    true
}

/// Test whether a version satisfies a single version constraint.
fn matches_single(v: Version, constraint: string) -> bool {
    let c = constraint.trim();
    let clen = c.len();
    if clen == 0 {
        return true;
    }
    // Detect operator
    // Clone c so it remains available for the starts_with chain below.
    var op = "=";
    var ver_str = clone c;
    if c.starts_with(">=") {
        op = ">=";
        ver_str = c.slice(2, clen).trim();
    } else if c.starts_with("<=") {
        op = "<=";
        ver_str = c.slice(2, clen).trim();
    } else if c.starts_with("!=") {
        op = "!=";
        ver_str = c.slice(2, clen).trim();
    } else if c.starts_with(">") {
        op = ">";
        ver_str = c.slice(1, clen).trim();
    } else if c.starts_with("<") {
        op = "<";
        ver_str = c.slice(1, clen).trim();
    } else if c.starts_with("^") {
        op = "^";
        ver_str = c.slice(1, clen).trim();
    } else if c.starts_with("~") {
        op = "~";
        ver_str = c.slice(1, clen).trim();
    } else if c.starts_with("=") {
        op = "=";
        ver_str = c.slice(1, clen).trim();
    }
    let req_ver = match parse(ver_str) {
        .Ok(version) => version,
        .Err(_) => return false,
    };
    let cmp = compare_versions(v, req_ver);
    var matches = cmp == 0;
    if op == ">=" {
        matches = cmp >= 0;
    } else if op == "<=" {
        matches = cmp <= 0;
    } else if op == ">" {
        matches = cmp > 0;
    } else if op == "<" {
        matches = cmp < 0;
    } else if op == "!=" {
        matches = cmp != 0;
    } else if op == "^" {
        matches = cmp >= 0 && v.maj == req_ver.maj;
    } else if op == "~" {
        matches = cmp >= 0 && v.maj == req_ver.maj && v.min == req_ver.min;
    }
    matches
}

// ── FFI ───────────────────────────────────────────────────────────────
// Lexicographic string comparison: returns negative, zero, or positive.
// Declared here rather than via `import std.string` to avoid the module
// compile path that `impl string { ... }` currently blocks on C2.
extern "C" {
    fn hew_string_compare(a: string, b: string) -> i32;
}
