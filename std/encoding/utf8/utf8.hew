//! Validating and lossy UTF-8 decoding with explicit byte-position errors.

/// Details of invalid UTF-8 in an encoded byte sequence.
pub type Utf8Error {
    /// Number of valid bytes before the invalid or incomplete sequence.
    valid_up_to: i64,
    /// Invalid sequence length in bytes, or None for incomplete trailing input.
    error_len: Option<i64>,
}

impl Display for Utf8Error {
    fn fmt(error: Utf8Error) -> string {
        match error.error_len {
            .Some(length) => f"invalid UTF-8 at byte {error.valid_up_to} ({length}-byte sequence)",
            .None => f"incomplete UTF-8 sequence at byte {error.valid_up_to}",
        }
    }
}

/// Decode UTF-8 bytes, returning the first byte-position error as ordinary
/// `Result` data. Valid input preserves every Unicode scalar, including NUL.
#[intrinsic("utf8.decode")]
pub fn decode(data: bytes) -> string fails Utf8Error {}

/// Decode UTF-8 bytes and replace malformed sequences with U+FFFD.
#[intrinsic("utf8.decode_lossy")]
pub fn decode_lossy(data: bytes) -> string {}
