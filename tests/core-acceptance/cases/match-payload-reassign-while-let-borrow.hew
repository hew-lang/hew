enum Box {  Full(Vec<i64>), Empty }
fn main() -> i64 {
    let b = Box.Full(seed());
    var sum = 0;
    while let Box.Full(v) = b {
        sum = sum + v.len();
        if sum > 10 {
            break;
        }
    }
    sum
}

fn seed() -> Vec<i64> {
    var v: Vec<i64> = Vec.new();
    v.push(1);
    v.push(2);
    v.push(3);
    v
}
