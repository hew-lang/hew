// Fault after two suspending sleep calls in an actor handler.
// The completion call reports ActorError.Trapped; the actor owns the fault.
// Matching the caller's error does not recover the actor fault. An unrecovered
// fault reports a diagnostic and makes the native process exit with status 1.
// Cleanup must release the suspended frame exactly once.
actor Reader {
    receive fn go(trigger: i64) -> i64 {
        sleep(50ms);
        sleep(50ms);
        if trigger >= 0 {
            panic("reader crashed after sleep resume");
        }
        7
    }
}

fn main() {
    let reader = spawn Reader;
    let r = reader.go(0);
    match r {
        .Ok(v) => println(f"reader-returned: {v}"),
        .Err(_) => println("reader-crash-fallback"),
    }
    println("main-done");
}
