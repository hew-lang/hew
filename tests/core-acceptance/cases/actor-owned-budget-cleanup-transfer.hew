import std.stream;

#[resource]
type Ticket {
    values: Vec<i64>;
    ready: stream.Sink<i64>;
    gate: stream.Stream<i64>;
}

impl Ticket {
    fn close(consume self) {
        let Ticket { values, ready, gate } = self;
        ready.send(1).expect("cleanup started");
        ready.close();
        gate.recv().expect("cleanup released");
        gate.close();
        assert(values.len() == 4);
        let scratch = [0; 1024];
        println(scratch.len());
    }
}

fn finish_in_cleanup(consume ready: stream.Sink<i64>, consume gate: stream.Stream<i64>) -> i64 {
    var values: Vec<i64> = Vec.new();
    for i in 0..4 {
        values.push(i);
    }
    let ticket = Ticket { values: values, ready: ready, gate: gate };
    var sibling: Vec<i64> = Vec.new();
    for i in 0..4 { sibling.push(i); }
    // Reverse tuple cleanup reaches Ticket first. The other field remains
    // owned while Ticket.close parks, and must follow the transferred task.
    let _owners = (sibling, ticket);
    7
}

gen fn producer(consume ready: stream.Sink<i64>, consume gate: stream.Stream<i64>) -> i64 {
    scope {
        let child = fork finish_in_cleanup(ready, gate);
        yield 1;
        yield await child;
    }
}

#[max_heap(512)]
actor Drain {
    receive fn total(consume input: Generator<i64, ()>, consume release: stream.Sink<i64>) -> i64 {
        release.send(1).expect("release cleanup");
        release.close();
        var total = 0;
        for value in input {
            total += value;
        }
        total
    }
}

fn main() -> i64 {
    let (ready, started): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("ready pipe");
    let (release, gate): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("gate pipe");
    let values = producer(ready, gate);
    assert(values.next() == .Some(1));
    started.recv().expect("child is in cleanup");
    started.close();
    let drain = spawn Drain;
    match drain.total(values, release) {
        .Err(.Trapped) => println("cleanup transfer limit"),
        _ => return 2,
    }
    stopped(drain);
    0
}
