// Ordinary records retain value semantics when a consuming receiver needs
// an independent owner and the caller uses the record again.
pub type Builder {
    label: string;
}

impl Builder {
    fn build(consume self) -> string {
        self.label
    }
}

fn main() {
    let b = Builder { label: "hi" };
    let x = b.build();
    let y = b.build();
    println(f"{x} {y}");
}
