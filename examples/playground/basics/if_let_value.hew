//! @name Price a train ticket
//! @description Choose a fare from an optional discount using if let.

fn ticket(fare: i64, discount: Option<i64>) -> string {
    let price = if let .Some(amount) = discount {
        fare - amount
    } else {
        fare
    };
    f"Ticket: {price} dollars"
}

fn main() {
    println(ticket(20, .Some(5)));
    println(ticket(20, .None));
}
