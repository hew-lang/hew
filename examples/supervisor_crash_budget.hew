//! Status: runnable
//! Description: Crash Cascade Prevention (exits 1 after exhausting recovery)

// Crash Cascade Prevention
//
// The supervisor's `intensity: N within <window>` setting prevents infinite
// restart loops. When a child crashes more than N times within the window, the
// supervisor stops — it won't keep restarting a fundamentally broken actor.
//
// This is the "let it crash" philosophy with a safety valve: crash and restart
// is fine for transient failures, but persistent failures need human attention.
actor Fragile {
    let id: i32;
    let lives: i32;
    receive fn work() {
        print("fragile ");
        print(id);
        print(" working (lives left: ");
        print(lives);
        println(")");
    }
    receive fn break_it() {
        print("fragile ");
        print(id);
        println(" crashing!");
        panic("actor failure");
    }
}

// Allow three restarts in 60 seconds; a fourth crash exhausts recovery.
supervisor FragilePool {
    strategy: one_for_one;
    intensity: 3 within 60s;

    child f1: Fragile { id: 1, lives: 3 };
    child f2: Fragile { id: 2, lives: 3 };
}

fn main() {
    let sup = spawn FragilePool;
    let f1 = sup.f1;
    let f2 = sup.f2;
    f1.work().expect("first worker ready");
    f2.work().expect("second worker ready");

    // Wait for each failed call's actual recovery, including backoff, before
    // sending more work through the same stable role.
    for crash in 1..4 {
        println(f"--- crash {crash}: permitted restart ---");
        assert(f1.break_it().is_err());
        restarted(f1);
        f1.work().expect("failed worker restarted");
        f2.work().expect("one-for-one preserves the sibling");
    }
    // The fourth crash exceeds the supervisor's budget. The restart barrier
    // also completes when a role is permanently unavailable.
    println("--- crash 4: restart budget exhausted ---");
    assert(f1.break_it().is_err());
    restarted(f1);
    match f1.work() {
        .Err(ActorError.Dead) => {}
        _ => panic("an exhausted child role must be dead"),
    }
    stop(sup);
    stopped(sup);
    println("Restart budget exhausted; failed child is unavailable.");
    // No supervisor recovered the fourth fault, so this program exits 1.
}
