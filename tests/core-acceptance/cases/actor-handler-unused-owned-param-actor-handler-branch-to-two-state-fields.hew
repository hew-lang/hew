type Wrap { name: string }
actor Fan {
    var seen: i64,
    var one: Wrap,
    var two: Wrap,
    receive fn route(label: string, choose_one: bool) {
        let next = Wrap { name: label };
        if choose_one { one = next; } else { two = next; }
        seen = seen + 1;
    }
    receive fn total() -> i64 { seen + one.name.len() + two.name.len() }
}
fn main() -> i64 {
    let fan = spawn Fan(
        seen: 0,
        one: Wrap { name: "one" },
        two: Wrap { name: "two" }
    );
    var i: i64 = 0;
    while i < 50 {
        let _ = fan.route("either".to_upper(), i % 2 == 0);
        i = i + 1;
    }
    match fan.total() { .Ok(n) => if n > 50 { 0 } else { 95 }, .Err(_) => 96 }
}
