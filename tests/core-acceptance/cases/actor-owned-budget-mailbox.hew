#[max_heap(39)]
actor Small {
    receive fn accept(values: Vec<i64>) -> i64 {
        values.len()
    }
    #[on(crash)]
    fn crashed(info: CrashInfo) -> CrashAction {
        assert(match info.kind { .HeapExceeded => true, _ => false });
        assert(match info.trap { .Some(.HeapExceeded) => true, _ => false });
        assert(info.message == "HeapExceeded");
        .GiveUp
    }
}

fn main() -> i64 {
    var values: Vec<i64> = Vec.new();
    for i in 0..4 {
        values.push(i);
    }
    let small = spawn Small;
    match small.accept(values) {
        .Err(.Trapped(info)) => {
            assert(match info.kind { .HeapExceeded => true, _ => false });
            assert(match info.trap { .Some(.HeapExceeded) => true, _ => false });
            assert(info.message == "HeapExceeded");
            assert(match info.site { .None => true, _ => false });
            assert(match info.trace { .None => true, _ => false });
            println("admission limit");
        }
        _ => return 2,
    }
    stopped(small);
    assert(values.len() == 4);
    values.push(4);
    println(values.len());
    0
}
