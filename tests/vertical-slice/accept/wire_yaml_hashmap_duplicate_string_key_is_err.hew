// Validation (FAIL CLOSED): YAML mappings use the same duplicate-preserving
// typed text contract as JSON object maps; repeated semantic keys are errors.
import std.encoding.yaml;

#[wire]
type DuplicateStringMap {
    values: HashMap<string, string> @1;
}

fn main() -> i64 {
    match yaml.decode<DuplicateStringMap>("values:\n  same: old\n  same: new\n") {
        .Err(_) => 42,
        .Ok(_) => 1,
    }
}
