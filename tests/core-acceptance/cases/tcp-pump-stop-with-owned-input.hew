import std.net;

import std.stream;

// The pump owns the connection and hands each received chunk to its target.
actor Pump {
    let conn: net.Connection;
    let target: AttachedInput;
    receive fn run() {
        while let .Some(data) = conn.recv() {
            if let .Err(_) = target.on_data(data) {
                break;
            }
        }
    }
}

actor AttachedInput {
    let ready: stream.Sink<i64>;
    let never: stream.Stream<i64>;
    receive fn on_data(data: bytes) {
        ready.send(data.len()).expect("send");
        // The parent observes readiness before terminating this actor. The
        // input remains live across suspension on a pipe nothing writes, so
        // termination must clean its owner.
        let _ = never.recv();
        assert(data.len() > 0);
    }
}

fn main() {
    let (tx, rx): (stream.Sink<i64>, stream.Stream<i64>) = match stream.pipe(4) {
        .Ok(value) => value,
        .Err(_) => panic("pipe failed"),
    };
    let listener = match net.listen("127.0.0.1:0") {
        .Ok(value) => value,
        .Err(_) => panic("listen failed"),
    };
    let client = match net.connect(f"127.0.0.1:{listener.local_port()}") {
        .Ok(value) => value,
        .Err(_) => panic("connect failed"),
    };
    let (hold, never): (stream.Sink<i64>, stream.Stream<i64>) = match stream.pipe(1) {
        .Ok(value) => value,
        .Err(_) => panic("pipe failed"),
    };
    let receiver = spawn AttachedInput { ready: tx, never: never };
    let server = listener.accept().expect("accept");
    let pump = spawn Pump { conn: server, target: receiver };
    mailbox(pump, on_full: .Wait).run().expect("start pump");
    match client.send("owned\0input".to_bytes()) {
        .Ok(()) => {}
        .Err(_) => panic("write failed"),
    }
    match rx.recv() {
        .Some(size) => assert(size > 0),
        .None => panic("actor never received input"),
    }
    let _ = client.send("pending\0input".to_bytes());
    terminate(receiver);
    stopped(receiver);
    stop(pump);
    stopped(pump);
    client.close();
    listener.close();
    rx.close();
    hold.close();
    println("pumped input released on actor termination");
}
