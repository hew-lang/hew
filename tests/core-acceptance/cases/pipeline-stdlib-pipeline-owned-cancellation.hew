import std.pipeline;
import std.semaphore;
import pipeline_support.items;

fn main() {
    let closed = semaphore.new(0);
    scope within 100ms {
        for _index in pipeline.map(items.source(closed), |item: items.Item| {
            sleep(1h);
            item.index
        }, concurrency: 2) {
            panic("blocked worker yielded");
        }
    } handle failure {
        match failure {
            .Deadline { message: _ } => {}
            .Fault { message } => panic(message),
        }
    };
    assert(closed.count() == 6);
    println("pipeline cancellation passed");
}
