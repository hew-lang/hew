actor Counter {
    var count: i64,

    receive fn increment(n: i64) {
        count = count + n;
    }

    receive fn total() -> i64 {
        count
    }
}

fn main() -> i64 {
    let counter = spawn Counter(count: 0);
    let _ = counter.increment(10);
    let _ = counter.increment(32);
    match counter.total() {
        .Ok(v) => v,
        .Err(_e) => 0,
    }
}
