// The same authored `#[resource] #[opaque]` handle releases exactly once
// through its own `close` when it is owned by a record field, by a vector
// element, and by a frame cancelled at its suspension.
import std.stream;

#[resource]
#[opaque]
type Dq {}

impl Dq {
    fn close(consume self) {
        unsafe { hew_deque_free(self) };
        println("closed");
    }
}

extern "C" {
    fn hew_deque_new() -> Dq;
    fn hew_deque_free(consume dq: Dq);
}

type Holder {
    handle: Dq,
    label: string,
}

fn in_record() {
    let holder = Holder { handle: unsafe { hew_deque_new() }, label: "record" };
    println(holder.label);
}

fn in_vector() {
    let handles: Vec<Dq> = [unsafe { hew_deque_new() }, unsafe { hew_deque_new() }];
    println("vector " + to_string(handles.len()));
}

// Cancelled at the receive on a gate nothing feeds, after it reports that it
// reached it: the losing frame's record is still held, so the cancellation
// edge runs the field's close exactly once.
fn cancelled(parked: stream.Sink<i64>, gate: stream.Stream<i64>) -> i64 {
    let holder = Holder { handle: unsafe { hew_deque_new() }, label: "cancelled" };
    println(holder.label);
    parked.send(1).expect("parked");
    gate.recv();
    0
}

fn winner(parked: stream.Stream<i64>) -> i64 {
    parked.recv();
    println("winner");
    7
}

fn main() {
    in_record();
    in_vector();
    let (_hold, gate): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("gate");
    let (parked_tx, parked): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("parked");
    let picked = race { winner(parked), cancelled(parked_tx, gate) };
    println("picked " + to_string(picked));
}
