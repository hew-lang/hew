type Row { name: string, }

fn make(n: i64) -> Option<Row> {
    if n > 0 { .Some(Row { name: "g64-fieldload-heap".to_upper() }) } else { .None }
}

fn run_cycle(n: i64) -> i64 {
    let opt = make(n);
    var got: i64 = 0;
    match opt {
        .Some(r) => { let name = r.name.to_upper(); if !name.is_empty() { got = name.len(); } }
        .None => {}
    }
    got
}

fn run_loop(frames: i64) -> i64 {
    var total: i64 = 0;
    for i in 0..frames { total = total + run_cycle(i + 1); }
    total
}

fn main() -> i64 { run_loop(50) }
