import std.net.http.server as http;

fn serve_forever(server: http.Server) {
    loop {
        let req = server.accept().expect("accept request");
        let path = req.path();
        match path {
            "/" => {
                req.respond_text(200, "Hello from Hew!").expect("respond_text succeeds");
            }
            "/health" => {
                req.respond_text(200, "OK").expect("respond_text succeeds");
            }
            _ => {
                req.respond_text(404, "Not Found").expect("respond_text succeeds");
            }
        }
    }
}

// HTTP server with one request handled at a time in the main loop.
// http.Request handles remain local and are released after each response.
// Benchmark results depend on the compiler revision and workload; this
// example does not establish actor-transfer safety or a throughput guarantee.
fn main() {
    let addr = "0.0.0.0:18080";
    println("Listening on " + addr);
    match http.listen(addr) {
        .Ok(server) => {
            serve_forever(server);
        }
        .Err(err) => {
            let reason = to_string(err);
            println(f"cannot listen on {addr}: {reason}");
        }
    }
}
