trait Named {
    fn name(val: Self) -> string;
}

type P {
    n: string;
}

impl Named for P {
    fn name(val: P) -> string {
        val.n
    }
}

type Q {
    n: string;
}

impl Named for Q {
    fn name(val: Q) -> string {
        val.n
    }
}

fn show_named(v: dyn Named) {
    let s = v.name();
    println(s);
}

fn main() {
    let a: dyn Named = P { n: "p0" };
    let b: dyn Named = P { n: "p1" };
    let v: Vec<dyn Named> = Vec::new();
    v.push(a);
    v.push(b);
    for e in v {
        show_named(e);
    }
}
