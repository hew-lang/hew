fn main() -> i64 {
    var rows: Vec<Vec<i64>> = Vec.new();
    var a: Vec<i64> = Vec.new();
    a.push(1);
    a.push(2);
    rows.push(a);
    var b: Vec<i64> = Vec.new();
    b.push(3);
    b.push(4);
    rows.push(b);
    var sum: i64 = 0;
    for v in rows[0] {
        sum = sum + v;
    }
    sum
}
