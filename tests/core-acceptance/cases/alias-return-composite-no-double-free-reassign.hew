type Holder { s: string }
fn borrowLen(h: Holder) -> i64 { h.s.len() }
fn remake(h: Holder) -> Holder { var x: Holder = Holder { s: "z" }; x = h; x }
fn main() -> i64 {
    var total: i64 = 0;
    for i in 0..50 {
        let y: Holder = Holder { s: "a" + "b" };
        total = total + borrowLen(remake(y));
    }
    if total != 50 * 2 { return 64; }
    0
}
