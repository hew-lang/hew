actor Echo {
    var seen: i64;

    receive fn take(v: i64) -> i64 {
        seen = seen + v;
        seen
    }
}

fn main() {
    let x = spawn Echo(seen: 0);
    let m: HashMap<string, LocalPid<Echo>> = HashMap.new();
    m.insert("k", x);
    match m.get("k") {
        Option.Some(e) => {
            match await e.take(1) { Result.Ok(e_v) => println(f"echo {e_v}"), Result.Err(_) => println("err"), }
        },
        Option.None => println("missing"),
    }
}
