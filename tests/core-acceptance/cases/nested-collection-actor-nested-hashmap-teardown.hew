actor Registry {
    var buckets: Vec<HashMap<string, i64>>,

    receive fn total() -> i64 {
        buckets.len()
    }
}

fn main() -> i64 {
    var buckets: Vec<HashMap<string, i64>> = Vec.new();
    for i in 0..50 {
        var m: HashMap<string, i64> = HashMap.new();
        m.insert("a", i);
        m.insert("b", i + 1);
        buckets.push(m);
    }
    let reg = spawn Registry(buckets: buckets);
    match reg.total() {
        .Ok(v) => v,
        .Err(_) => -1,
    }
}
