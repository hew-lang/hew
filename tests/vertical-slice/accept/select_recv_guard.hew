// Regression guard for select's stream-receive arm: a `select`
// stream-receive arm (`pat from rx.recv()`) is valid and must keep
// checking OK independently of batch fork's actor-ask-only branch
// enforcement.
import std.stream;

actor Worker {
    #[on(start)]
    fn start() {
        let (txa, rxa): (stream.Sink<i64>, stream.Stream<i64>) = match stream.pipe(4) {
            .Ok(pair) => pair,
            .Err(_) => return,
        };
        txa.send(7).expect("send");
        select {
            a from rxa.recv() => {
                match a {
                    .Some(n) => println(f"a:{n}"),
                    .None => println("a:none"),
                }
            },
            after 1s => println("timeout"),
        };
        txa.close();
        rxa.close();
    }
}

fn main() {
    let _w = spawn Worker;
    sleep(50ms);
}
