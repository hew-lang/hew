//! Status: runnable
//! Description: Closure types from context and inferred generic signatures

fn apply(f: fn(i32, i32) -> i32, a: i32, b: i32) -> i32 {
    f(a, b)
}

fn transform(f: fn(i32) -> i32, x: i32) -> i32 {
    f(x)
}

fn main() {
    // Pipe closure with types inferred from apply's signature
    let sum = apply(|x, y| x + y, 3, 4);
    let product = apply(|x, y| x * y, 3, 4);
    println(sum);
    println(product);

    // Pipe closure with single param
    let doubled = transform(|x| x * 2, 21);
    println(doubled);

    // The same argument context supplies types inside a block body.
    let diff = apply(|x, y| {
        x - y
    }, 10, 3);
    println(diff);

    // Pipe closure with inferred types
    let modulo = apply(|x, y| {
        x - y * (x / y)
    }, 17, 5);
    println(modulo);

    // A directly bound literal can use a different type at each call.
    let identity = |value| value;
    assert(identity(42) == 42 && identity("hello") == "hello");
    let equal = |left, right| left == right;
    assert(equal(7, 7) && equal("word", "word"));

    // Different argument types share the closure's private captured counter.
    let count = 0;
    var counted = |value| {
        count += 1;
        (count, value)
    };
    let (first, number) = counted(42);
    let (second, text) = counted("next");
    assert(first == 1 && number == 42);
    assert(second == 2 && text == "next");
    assert(count == 0);
}
