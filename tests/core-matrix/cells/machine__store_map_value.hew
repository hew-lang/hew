machine Counter {
    events { Inc; Reset; }
    state Zero;
    state NonZero { value: i64; }
    on Inc: Zero => NonZero { NonZero { value: 1 } }
    on Inc: NonZero => NonZero reenter { NonZero { value: self.value + 1 } }
    on Reset: NonZero => Zero { Zero }
    default { state }
}

fn main() {
    var x = Zero;
    x.step(Inc);
    let m: HashMap<string, Counter> = HashMap.new();
    m.insert("k", x);
    match m.get("k") {
        Option.Some(e) => {
            match e {
                Zero => println("zero"),
                NonZero { value } => println(f"n {value}"),
            }
        },
        None => println("missing"),
    }
}
