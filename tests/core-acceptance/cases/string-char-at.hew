fn main() {
    let text = "é🙂\0雪".repeat(2);
    assert(text.get(0).expect("Unicode scalar") == 'é');
    assert(text.get(1).expect("Unicode scalar") == '🙂');
    assert(text.get(2).expect("Unicode scalar") == '\0');
    assert(text.get(3).expect("Unicode scalar") == '雪');
    assert(text.get(7).expect("Unicode scalar") == '雪');
    assert(text.get(-1).is_none());
    assert(text.get(8).is_none());
    assert(text.get(9223372036854775807).is_none());
    assert("".get(0).is_none());
    assert(text.find("雪").expect("scalar offset") == 3);
    assert(text.find("absent").is_none());
    assert(text.len() == 8);
    println("character lookup preserves Unicode scalars and bounds");
}
