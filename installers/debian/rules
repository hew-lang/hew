#!/usr/bin/make -f
# Debian rules — binary-only packaging from GitHub releases.
# Usage: dpkg-buildpackage -b -us -uc
#   or:  debian/rules binary HEW_VERSION=0.1.0

DEB_HOST_ARCH     ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
HEW_VERSION       ?= $(shell cat debian/hew-version)
GITHUB_ORG        := hew-lang
GITHUB_REPO       := hew

# Map Debian arch to Hew release arch
ifeq ($(DEB_HOST_ARCH),amd64)
  HEW_ARCH := x86_64
else ifeq ($(DEB_HOST_ARCH),arm64)
  HEW_ARCH := aarch64
else
  $(error Unsupported architecture: $(DEB_HOST_ARCH))
endif

RELEASE_URL   := https://github.com/$(GITHUB_ORG)/$(GITHUB_REPO)/releases/download/v$(HEW_VERSION)
ARCHIVE       := hew-v$(HEW_VERSION)-linux-$(HEW_ARCH).tar.gz
DEBUG_ARCHIVE := hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)-debug.tar.gz
DESTDIR       := debian/hew
DBGSYM_DIR    := debian/hew-dbgsym

%:
	dh $@

override_dh_auto_build:
	@for archive in "$(ARCHIVE)" "$(DEBUG_ARCHIVE)"; do \
		if [ ! -f "$$archive" ]; then \
			echo "Downloading $$archive..."; \
			curl -fsSL -o "$$archive" "$(RELEASE_URL)/$$archive" || exit 1; \
		else \
			echo "Using local $$archive"; \
		fi; \
		tar -xzf "$$archive" || exit 1; \
	done

override_dh_auto_install:
	install -d $(DESTDIR)/usr/bin
	install -d $(DESTDIR)/usr/lib/hew
	install -d $(DESTDIR)/usr/share/hew/std
	install -d $(DESTDIR)/usr/include
	install -d $(DESTDIR)/usr/share/bash-completion/completions
	install -d $(DESTDIR)/usr/share/zsh/site-functions
	install -d $(DESTDIR)/usr/share/fish/vendor_completions.d
	install -d $(DESTDIR)/usr/share/doc/hew

	install -m755 hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)/bin/hew          $(DESTDIR)/usr/bin/hew
	install -m644 hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)/lib/libhew.a \
	              $(DESTDIR)/usr/lib/hew/libhew.a
	cp -r hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)/std/. $(DESTDIR)/usr/share/hew/std/ 2>/dev/null || true
	cp -r hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)/include/. $(DESTDIR)/usr/include/
	if [ -d hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)/share ]; then cp -r hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)/share/. $(DESTDIR)/usr/share/; fi
	cp hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)/completions/hew.bash \
	   $(DESTDIR)/usr/share/bash-completion/completions/hew 2>/dev/null || true
	cp hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)/completions/hew.zsh \
	   $(DESTDIR)/usr/share/zsh/site-functions/_hew 2>/dev/null || true
	cp hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)/completions/hew.fish \
	   $(DESTDIR)/usr/share/fish/vendor_completions.d/hew.fish 2>/dev/null || true
	install -m644 hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)/LICENSE-MIT \
	              $(DESTDIR)/usr/share/doc/hew/LICENSE-MIT
	install -m644 hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)/LICENSE-APACHE \
	              $(DESTDIR)/usr/share/doc/hew/LICENSE-APACHE
	install -m644 hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)/NOTICE \
	              $(DESTDIR)/usr/share/doc/hew/NOTICE
	# The release binary is already stripped; its DWARF ships in the debug
	# archive under .build-id/, which gdb finds below /usr/lib/debug.
	install -d $(DBGSYM_DIR)/usr/lib/debug
	cp -r hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)-debug/.build-id $(DBGSYM_DIR)/usr/lib/debug/
	install -d $(DBGSYM_DIR)/usr/share/doc
	ln -s hew $(DBGSYM_DIR)/usr/share/doc/hew-dbgsym

# hew-dbgsym is built from the release's debug archive, so debhelper must not
# generate its own (empty) automatic dbgsym package for the stripped binary.
override_dh_strip:
	dh_strip --no-automatic-dbgsym

# The debug file arrives finished from the release; dwz must not rewrite it.
override_dh_dwz:

# LLVM/MLIR and libstdc++ are statically linked into the hew binary.
# Rust binaries link only glibc.  dpkg-shlibdeps auto-detects the actual
# runtime deps from the installed binaries and populates ${shlibs:Depends}.

override_dh_auto_clean:
	rm -rf hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)/ hew-v$(HEW_VERSION)-linux-$(HEW_ARCH)-debug/ \
		$(ARCHIVE) $(DEBUG_ARCHIVE) || true
