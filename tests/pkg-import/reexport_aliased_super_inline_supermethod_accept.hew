// The aliased re-exported supertrait edge resolves to its original Base impl.
import hew.reexsubalias.{SubA};
import hew.reexbase.{Base};

type W {
    id: i64,
}

impl Base for W {
    fn base(w: W) -> i64 {
        w.id
    }
}

impl SubA for W {
    fn tag(w: W) -> i64 {
        w.id + 100
    }
}

fn main() {
    let w = W { id: 7 };
    println(f"tag {w.tag()} base {w.base()}");
}
