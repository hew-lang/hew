import std.encoding.cbor;

#[wire]
type TwoStr {
    a: string @1;
    b: string @2;
}

#[wire]
type Pair {
    a: string @1;
    b: i64 @2;
}

fn main() -> i64 {
    let t = TwoStr { a: "owned-field-a-value", b: "owned-field-b-value" };
    let raw = cbor.encode(t);
    match cbor.decode<Pair>(raw) {
        .Ok(p) => p.b,
        .Err(e) => {
            println(e);
            0
        }
    }
}
