fn inspect(values: Vec<string>) -> i64 {
    var count = 0;
    for value in values {
        if value.len() > 0 { count = count + 1; }
    }
    count
}
fn make_vec(seed: i64) -> Vec<string> {
    [f"made-{seed}-a", f"made-{seed}-b", f"made-{seed}-c"]
}
fn frame(seed: i64) -> i64 {
    var map: HashMap<string, string> = HashMap.new();
    var set: HashSet<string> = HashSet.new();
    var values: Vec<string> = Vec.new();
    var i = 0;
    while i < 3 {
        map.insert(f"key-{seed}-{i}", f"value-{seed}-{i}");
        set.insert(f"member-{seed}-{i}");
        values.push(f"item-{seed}-{i}");
        i = i + 1;
    }
    let receiver = map.keys().len()
        + map.values().len()
        + set.clone().len()
        + values[..].len()
        + make_vec(seed).clone().len();
    var iterated = 0;
    for key in map.keys() {
        if key.len() > 0 { iterated = iterated + 1; }
    }
    let argument = inspect(map.keys());
    let bound = map.keys();
    receiver + iterated + argument + bound.len()
}
fn main() -> i64 {
    var total = 0;
    var i = 0;
    while i < 200 {
        total = total + frame(i);
        i = i + 1;
    }
    if total == 4800 { 0 } else { 95 }
}
