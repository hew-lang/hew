        }
        Result.Ok(res) => {
            if res.tag == 0 {
                println(f"PASS wire_cbor ping-tag={res.tag}");
            } else {
                println(f"FAIL wire_cbor ping-tag={res.tag}");
                return 6;
            }
            if res.sum == 0 {
                println(f"PASS wire_cbor ping-sum={res.sum}");
            } else {
                println(f"FAIL wire_cbor ping-sum={res.sum}");
                return 7;
            }
        }
    }
    0
}

fn scenario_identity_location(identity: IdentityProbe) -> i64 {
    let local_node = match Node.id() {
        .Some(id) => id,
        .None => {
            println("FAIL identity_location local-node-id-missing");
            return 2;
        }
    };
    let location = discover_with_retry("identity").expect("identity metadata");
    let remote_node = location.node_id();
    let remote_location = location.display();
    let remote_incarnation = location.incarnation();
    // Discovery metadata must match the identity returned across the wire.
    if local_node.display() == remote_node.display() {
        println("FAIL identity_location node-ids-not-distinct");
        return 3;
    }
    let inspected = identity.handle(IdentityReq.Inspect);
    match inspected {
        Result.Err(_) => {
            println("FAIL identity_location inspect-ask-error");
            return 7;
        }
        Result.Ok(resp) => {
            match resp {
                IdentityResp.Value(actual) => {
                    if actual.node_id != remote_node.display() {
                        println("FAIL identity_location node-mismatch");
                        return 8;
                    }
                    if actual.location != remote_location {
                        println("FAIL identity_location location-mismatch");
                        return 9;
                    }
                    if actual.incarnation != remote_incarnation {
                        println("FAIL identity_location incarnation-mismatch");
                        return 10;
                    }
                }
            }
        }
    }
    println(f"PASS identity_location local={local_node.display()} remote={remote_node.display()} location={remote_location} incarnation={remote_incarnation}");
    0
}

fn scenario_identity_display(_identity: IdentityProbe, scenario: string, iterations: i64) -> i64 {
    let location = discover_with_retry("identity").expect("identity metadata");
    let node_id = location.node_id();
    for _ in 0..iterations {
        // Direct temporaries must release fresh strings after `.len()`.
        println(node_id.display().len());
        println(location.display().len());
        let named_node = node_id.display();
        let named_location = location.display();
        println(named_node.len());
        println(named_location.len());
        let mixed_node = node_id.display();
        println(mixed_node.len());
        println(location.display().len());
        println("frame");
    }
    println(f"PASS {scenario} iterations={iterations}");
    0
}

fn monitor_hook_scenario(kv: KeyValue, scenario: string, drive: i64, expected: i64, ready_drop: bool) -> i64 {
    let probe = spawn MonitorProbe { active_monitor: .Err(LinkError.NoContext), expected_monitor_id: 0, down_count: 0, down_reason: 100 };
    let armed = probe.arm(kv, drive);
    let arm_status = match armed {
        Result.Ok(status) => status,
        Result.Err(_) => {
            println(f"FAIL {scenario} arm-ask-error");
            return 2;
        }
    };
    if arm_status != 0 {
        println(f"FAIL {scenario} arm-status={arm_status}");
        return 3;
    }
    let id_result = probe.monitor_id();
    let monitor_id = match id_result {
        Result.Ok(value) => value,
        Result.Err(_) => {
            println(f"FAIL {scenario} monitor-id-ask-error");
            return 9;
        }
    };
    if monitor_id == 0 {
        println(f"FAIL {scenario} monitor-id-zero");
        return 10;
    }
    if ready_drop {
        println(f"READY_DROP {scenario}");
    }
    var attempts: i64 = 0;
    loop {
        let status = probe.status();
        let observed = match status {
            Result.Ok(value) => value,
            Result.Err(_) => {
                println(f"FAIL {scenario} status-ask-error");
                return 4;
            }
        };
        if observed != 100 {
            if observed != expected {
                println(f"FAIL {scenario} reason={observed}");
                return 5;
            }
            break;
        }
        attempts = attempts + 1;
        if attempts >= 300 {
            println(f"FAIL {scenario} down-timeout");
            return 6;
        }
        sleep(100ms);
    }
    println(f"PASS {scenario} reason={expected}");
    sleep(1200ms);
    let duplicate_check = probe.status();
    match duplicate_check {
        Result.Ok(value) => {
            if value != expected {
                println(f"FAIL {scenario} duplicate-status={value}");
                return 7;
            }
        }
        Result.Err(_) => {
            println(f"FAIL {scenario} duplicate-check-error");
            return 8;
        }
    }
    println(f"PASS {scenario} no-dup");
    println(f"PASS {scenario} monitor-id-match={monitor_id}");
    0
}

fn scenario_remote_monitor_clean_exit(kv: KeyValue) -> i64 {
    monitor_hook_scenario(kv, "remote_monitor_clean_exit", 0, 6, false)
}

fn scenario_remote_monitor_crash(kv: KeyValue) -> i64 {
    monitor_hook_scenario(kv, "remote_monitor_crash", 1, 5, false)
}

fn scenario_remote_monitor_conn_drop(kv: KeyValue) -> i64 {
    monitor_hook_scenario(kv, "remote_monitor_conn_drop", 2, -1, true)
}

// Wait until a probe's DOWN reports, or give up after ~10s.
fn wait_for_down(probe: MonitorProbe) -> i64 {
    var attempts: i64 = 0;
    while attempts < 100 {
        let status = match probe.status() {
            Result.Ok(value) => value,
            Result.Err(_) => return -98,
        };
        if status != 100 {
            return status;
        }
        attempts = attempts + 1;
        sleep(100ms);
    }
    100
}

fn scenario_remote_monitor_setup_after_drop(kv: KeyValue) -> i64 {
    // The first monitor observes the route teardown; a monitor set up after it
    // is not an error and answers with an immediate MonitorLost DOWN.
    let before = spawn MonitorProbe { active_monitor: .Err(LinkError.NoContext) };
    match before.arm(kv, 2) {
        Result.Ok(0) => {}
        _ => {
            println("FAIL remote_monitor_setup_after_drop arm-before");
            return 2;
        }
    }
    println("READY_DROP remote_monitor_setup_after_drop");
    if wait_for_down(before) != -1 {
        println("FAIL remote_monitor_setup_after_drop no-teardown");
        return 3;
    }
    let after = spawn MonitorProbe { active_monitor: .Err(LinkError.NoContext) };
    match after.arm(kv, 2) {
        Result.Ok(0) => {}
        _ => {
            println("FAIL remote_monitor_setup_after_drop refused");
            return 4;
        }
    }
    if wait_for_down(after) == -1 {
        println("PASS remote_monitor_setup_after_drop down=MonitorLost");
        0
    } else {
        println("FAIL remote_monitor_setup_after_drop no-down");
        5
    }
}

fn scenario_remote_setup_exit_race(monitor_target: KeyValue, link_target: KeyValue) -> i64 {
    // The server pauses setup until the stopper has completed target cleanup.
    // This is a proved terminal actor, so preserve Stopped rather than lost reachability.
    let monitor_status = monitor_hook_scenario(monitor_target, "remote_setup_exit_race_monitor", 2, 6, false);
    if monitor_status != 0 {
        return monitor_status;
    }
    let probe = spawn LinkSetupRaceProbe { active_monitor: .Err(LinkError.NoContext), expected_monitor_id: 0, down_count: 0, down_reason: 100 };
    let armed = probe.arm(link_target);
    let linker_id = match armed {
        Result.Ok(value) => value,
        Result.Err(_) => {
            println("FAIL remote_setup_exit_race link-arm-error");
            return 20;
        }
    };
    if linker_id == 0 {
        println("FAIL remote_setup_exit_race link-register-failed");
        return 21;
    }
    var attempts: i64 = 0;
    loop {
        let status = probe.status();
        let observed = match status {
            Result.Ok(value) => value,
            Result.Err(_) => {
                println("FAIL remote_setup_exit_race link-status-error");
                return 22;
            }
        };
        if observed != 100 {
            if observed != 5 {
                println(f"FAIL remote_setup_exit_race link-down={observed}");
                return 23;
            }
            break;
        }
        attempts = attempts + 1;
        if attempts >= 300 {
            println("FAIL remote_setup_exit_race link-down-timeout");
            return 24;
        }
        sleep(100ms);
    }
    println("PASS remote_setup_exit_race link-down=5");
    sleep(1200ms);
    match probe.status() {
        Result.Ok(value) => {
            if value != 5 {
                println(f"FAIL remote_setup_exit_race link-duplicate={value}");
                return 25;
            }
        }
        Result.Err(_) => {
            println("FAIL remote_setup_exit_race link-duplicate-check-error");
            return 26;
        }
    }
    println("PASS remote_setup_exit_race link-no-dup");
    0
}

fn scenario_partition_ask(kv: KeyValue) -> i64 {
    let injector = spawn PartitionInjector;
    let _ = fork injector.arm();
    let fast_fail_ceiling_ms: i64 = 900;
    // Phase A — the armed probe must PROVE it fired. The route is still live
    // (READY_DROP has not been printed, so the harness has not killed the
    // server) and KvReq::Stall holds the server-side reply past this ask's
    // whole 3 s deadline. The only path that can resolve the pending ask
    // before its deadline is therefore the injector's Partition fan-out: no
    // reply arrives, no socket drops, no route is torn down. A broken or
    // no-op probe surfaces here as a deadline timeout -> FAIL, instead of
    // hiding behind the kill's routing-failure / socket-drop outcomes.
    let probe_started = instant.now();
    let probe = scope within 3s {
        kv.handle(KvReq.Stall)
    } handle failure {
        match failure {
            .Deadline { message } => .Err(ActorError.TimedOut),
            .Fault { message } => panic(message),
        }
    };
    let probe_elapsed = probe_started.elapsed().millis();
    match probe {
        Result.Ok(_) => {
            println("FAIL partition_ask probe-replied");
            return 4;
        }
        Result.Err(e) => {
            match e {
                ActorError.Partition => {
                    if probe_elapsed >= fast_fail_ceiling_ms {
                        println(f"FAIL partition_ask probe-slow ms={probe_elapsed}");
                        return 5;
                    }
                    println(f"PASS partition_ask probe-partition ms={probe_elapsed}");
                }
                _ => {
                    println(f"FAIL partition_ask probe-not-partition ms={probe_elapsed}");
                    return 6;
                }
            }
        }
    }
    // Phase B — the real-teardown no-hang gate: kill the server, then the ask
    // must fail closed with ANY typed cause without hanging. Re-arm the
    // injector (phase A consumed its first arm) so the typed verdict again
    // does not race the socket-teardown / SWIM detector latency.
    let _ = fork injector.arm();
    println("READY_DROP partition_ask");
    var attempts: i64 = 0;
    loop {
        let started = instant.now();
        let probe = scope within 1s {
            kv.handle(KvReq.GetKey("hello"))
        } handle failure {
            match failure {
                .Deadline { message } => .Err(ActorError.TimedOut),
                .Fault { message } => panic(message),
            }
        };
        let elapsed_ms = started.elapsed().millis();
        match probe {
            Result.Ok(_) => {
                attempts = attempts + 1;
                if attempts >= 20 {
                    println("FAIL partition_ask never-partitioned");
                    return 2;
                }
                sleep(200ms);
            }
            Result.Err(e) => {
                let timed_out = match e {
                    ActorError.TimedOut => true,
                    _ => elapsed_ms >= fast_fail_ceiling_ms,
                };
                if timed_out {
                    attempts = attempts + 1;
                    if attempts >= 20 {
                        println("FAIL partition_ask reason=timeout");
                        return 3;
                    }
                    sleep(200ms);
                } else {
                    match e {
                        ActorError.Partition => println(f"PASS partition_ask reason=partition ms={elapsed_ms}"),
                        ActorError.ConnectionDropped => println(f"PASS partition_ask reason=conn-dropped ms={elapsed_ms}"),
                        ActorError.RoutingFailed => println(f"PASS partition_ask reason=routing-failed ms={elapsed_ms}"),
                        ActorError.NodeNotRunning => println(f"PASS partition_ask reason=node-not-running ms={elapsed_ms}"),
                        // Rejected retains the request when delivery was not accepted.
                        ActorError.Rejected(_) => println(f"PASS partition_ask reason=rejected ms={elapsed_ms}"),
                        // A stale incarnation is Dead: that destination cannot return.
                        ActorError.Dead => println(f"PASS partition_ask reason=dead ms={elapsed_ms}"),
                        _ => println(f"PASS partition_ask reason=fail-closed ms={elapsed_ms}"),
                    }
                    return 0;
                }
            }
        }
    }
}

fn scenario_repoint_preserves_ref(kv: KeyValue, kx: string) -> i64 {
    let seeded = kv.handle(KvReq.Put(KvPut { key: "owner", val: "original" }));
    match seeded {
        Result.Err(_) => {
            println("FAIL repoint_preserves_ref seed-error");
            return 2;
        }
        Result.Ok(_) => {}
    }
    publish_atomic(kx, "client.seeded", "1");
    var attempts: i64 = 0;
    loop {
        let current = fixture_peer().receive_service<KeyValue>();
        match current {
            Result.Err(_) => {
                attempts = attempts + 1;
                if attempts >= 60 {
                    println("FAIL repoint_preserves_ref lookup-error");
                    return 3;
                }
                sleep(100ms);
            }
            Result.Ok(replacement) => {
                if replacement is kv {
                    attempts = attempts + 1;
                    if attempts >= 60 {
                        println("FAIL repoint_preserves_ref location-never-changed");
                        return 4;
                    }
                    sleep(100ms);
                } else {
                    let old_value = kv.handle(KvReq.GetKey("owner"));
                    match old_value {
                        Result.Err(_) => {
                            println("FAIL repoint_preserves_ref captured-ref-error");
                            return 5;
                        }
                        Result.Ok(KvResp.Ack) => {
                            println("FAIL repoint_preserves_ref captured-ref-ack");
                            return 6;
                        }
                        Result.Ok(KvResp.Value(v)) => {
                            if v != "original" {
                                println("FAIL repoint_preserves_ref captured-ref-wrong-actor");
                                return 7;
                            }
                        }
                    }
                    let new_value = replacement.handle(KvReq.GetKey("owner"));
                    match new_value {
                        Result.Err(_) => {
                            println("FAIL repoint_preserves_ref replacement-error");
                            return 8;
                        }
                        Result.Ok(KvResp.Ack) => {
                            println("FAIL repoint_preserves_ref replacement-ack");
                            return 9;
                        }
                        Result.Ok(KvResp.Value(v)) => {
                            if v != "" {
                                println("FAIL repoint_preserves_ref replacement-not-fresh");
                                return 10;
                            }
                        }
                    }
                    println("PASS repoint_preserves_ref captured=live future=replacement");
                    return 0;
                }
            }
        }
    }
}

extern "C" {
    fn hew_dist_monitor_remote_watcher_count() -> i64;
