// Repeated actor completion calls from a hub. Each call waits for its reply
// and can suspend the caller so other work can run.
actor Worker {
    let base: i64,
    receive fn work(n: i64) -> i64 {
        n + base
    }
}

actor Hub {
    let worker: Worker,
    receive fn relay(n: i64) -> i64 {
        let r = worker.work(n);
        match r {
            .Ok(v) => v,
            .Err(_) => -1,
        }
    }
}

fn main() {
    let w = spawn Worker(base: 100);
    let h = spawn Hub(worker: w);
    var total = 0;
    for i in 0 .. 5 {
        let r = h.relay(i);
        match r {
            .Ok(v) => {
                total = total + v;
            },
            .Err(_) => {},
        }
    }
    println(f"total={total}");
}
