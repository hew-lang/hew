import std.string;

type Pair {
    keep: HashMap<string, string>;
    churn: string;
}

fn main() -> i64 {
    var m: HashMap<string, string> = HashMap.new();
    m.insert(("k").repeat(32), ("v").repeat(32));
    var p = Pair { keep: m, churn: ("a").repeat(32) };
    var i: i64 = 0;
    while i < 50 {
        p = Pair { ..p, churn: ("b").repeat(32) };
        i = i + 1;
    }
    p.keep.len()
}
