// examples/distributed/kv_client.hew — authenticated KV service client
//
// Run both peers once without arguments to create their node keys and print
// their public credentials. Then exchange the credentials and run:
//   hew run examples/distributed/kv_server.hew <client-credential>
//   hew run examples/distributed/kv_client.hew <server-credential> [host] [port]
// Keep the key files between runs. Start this client while the server listens.
import std.net;

import std.os;

// This declaration mirrors the server's portable receive interface. The client
// receives an ordinary KeyValue handle from the authenticated service offer.
actor KeyValue {
    #[wire]
    receive fn put(key: string, value: string) -> string {
        ""
    }

    #[wire]
    receive fn get(key: string) -> string {
        ""
    }
}

fn authenticated_peer(credential: string) -> net.PeerSession {
    for attempt in 0..300 {
        match Node.peer(credential) {
            .Ok(peer) => return peer,
            .Err(_) => {
                if attempt == 299 {
                    panic("authenticated KV server session did not arrive");
                }
                sleep(50ms);
            }
        }
    }
    panic("authenticated KV server session did not arrive");
}

fn main() -> i64 {
    let args = os.args();
    let server_credential = match args.get(1) {
        .Some(value) => value,
        .None => "--identity",
    };
    let host = match args.get(2) {
        .Some(value) => value,
        .None => "127.0.0.1",
    };
    let port = match args.get(3) {
        .Some(value) => value,
        .None => "9100",
    };
    var config = NodeConfig { bind: "127.0.0.1:0", transport: NodeTransport.Tcp, key: "kv-client.key", peers: [], seeds: [] };
    if server_credential != "--identity" {
        config.peers = [server_credential];
    }
    Node.start(config).expect("KV client node starts");
    println(f"[kv-client] public credential: {Node.identity_key()}");
    if server_credential == "--identity" {
        Node.shutdown();
        return 0;
    }
    let address = f"1@{host}:{port}";
    Node.connect(address).expect("connect to pinned KV server");
    let peer = authenticated_peer(server_credential);
    let kv: KeyValue = peer.receive_service<KeyValue>().expect("receive KeyValue service");
    println("[kv-client] received the KeyValue service");
    let first = kv.put("hello", "world").expect("store first value completes");
    let second = kv.put("count", "42").expect("store second value completes");
    if first != "stored" || second != "stored" {
        println("[kv-client] FAIL: a put returned an unexpected result");
        Node.shutdown();
        return 1;
    }
    let hello = kv.get("hello").expect("read hello completes");
    if hello != "world" {
        println(f"[kv-client] FAIL: get('hello') returned '{hello}'");
        Node.shutdown();
        return 2;
    }
    println("[kv-client] PASS: get('hello') == 'world'");
    let count = kv.get("count").expect("read count completes");
    if count != "42" {
        println(f"[kv-client] FAIL: get('count') returned '{count}'");
        Node.shutdown();
        return 3;
    }
    println("[kv-client] PASS: get('count') == '42'");
    Node.shutdown();
    println("[kv-client] all assertions passed");
    0
}
