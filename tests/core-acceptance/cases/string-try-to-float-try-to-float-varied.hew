import std.string;

fn main() -> i64 {
    var checks: i64 = 0;
    for i in 0..50 {
        match "1234567".to_float() {
            .Ok(value) => {
                if value != 1234567.0 {
                    return 101;
                }
                checks = checks + 1;
            }
            .Err(_) => {
                return 102;
            }
        }
        match "12.5".to_float() {
            .Ok(value) => {
                if value != 12.5 {
                    return 103;
                }
                checks = checks + 1;
            }
            .Err(_) => {
                return 104;
            }
        }
        match "6e2".to_float() {
            .Ok(value) => {
                if value != 600.0 {
                    return 105;
                }
                checks = checks + 1;
            }
            .Err(_) => {
                return 106;
            }
        }
        match "-2.5E-1".to_float() {
            .Ok(value) => {
                if value != -0.25 {
                    return 107;
                }
                checks = checks + 1;
            }
            .Err(_) => {
                return 108;
            }
        }
        match "+.75".to_float() {
            .Ok(value) => {
                if value != 0.75 {
                    return 109;
                }
                checks = checks + 1;
            }
            .Err(_) => {
                return 110;
            }
        }
        match "4.".to_float() {
            .Ok(value) => {
                if value != 4.0 {
                    return 111;
                }
                checks = checks + 1;
            }
            .Err(_) => {
                return 112;
            }
        }
        match "1.2.3".to_float() {
            .Ok(_) => {
                return 113;
            }
            .Err(_) => {
                checks = checks + 1;
            }
        }
        match "9e2ms".to_float() {
            .Ok(_) => {
                return 114;
            }
            .Err(_) => {
                checks = checks + 1;
            }
        }
        match "1e2e3".to_float() {
            .Ok(_) => {
                return 115;
            }
            .Err(_) => {
                checks = checks + 1;
            }
        }
        match "-".to_float() {
            .Ok(_) => {
                return 116;
            }
            .Err(_) => {
                checks = checks + 1;
            }
        }
    }
    if checks == 500 {
        0
    } else {
        117
    }
}
