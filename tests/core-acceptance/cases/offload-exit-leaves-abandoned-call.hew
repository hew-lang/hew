extern "C" {
    #[offload]
    fn hew_sleep_ns(ns: i64);
}

fn main() {
    let outcome = scope within 50ms {
        unsafe { hew_sleep_ns(9223372036854775807) };
        "completed"
    } handle failure {
        match failure {
            .Deadline { message } => "deadline",
            .Fault { message } => "fault",
        }
    };
    println(outcome);
}
