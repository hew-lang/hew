trait Named {
    fn name(val: Self) -> string;
}

type P {
    n: string;
}

impl Named for P {
    fn name(val: P) -> string {
        val.n
    }
}

type Q {
    n: string;
}

impl Named for Q {
    fn name(val: Q) -> string {
        val.n
    }
}

fn show_named(v: dyn Named) {
    let s = v.name();
    println(s);
}

fn main() {
    let k: dyn Named = P { n: "p0" };
    let m: HashMap<dyn Named, i64> = HashMap::new();
    m.insert(k, 9);
    match m.get(k) {
        Some(v) => println(f"got {v}"),
        None => println("missing"),
    }
}
