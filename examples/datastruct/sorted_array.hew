// Sorted Array - maintains sorted order on insert using binary search
// All elements in Vec<i64> are kept in ascending order
//
// A parameter is the callee's own copy, so insert and remove hand the array
// back and the caller reassigns; remove also reports whether it found the value.
fn sa_find_insert_pos(arr: Vec<i64>, val: i64) -> i64 {
    // Binary search for insertion point
    var lo = 0;
    var hi = arr.len();
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if arr[mid] < val {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo
}

fn sa_insert(var arr: Vec<i64>, val: i64) -> Vec<i64> {
    let pos = sa_find_insert_pos(arr, val);
    // Append and shift right
    arr.push(0);
    var i = arr.len() - 1;
    while i > pos {
        let prev = arr[i - 1];
        arr.set(i, prev);
        i = i - 1;
    }
    arr.set(pos, val);
    arr
}

// Insert every value in order.
fn sa_insert_all(var arr: Vec<i64>, values: Vec<i64>) -> Vec<i64> {
    for value in values {
        arr = sa_insert(arr, value);
    }
    arr
}

fn sa_search(arr: Vec<i64>, val: i64) -> i64 {
    // Binary search, returns index or -1
    var lo = 0;
    var hi = arr.len();
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        let m = arr[mid];
        if m == val {
            return mid;
        }
        if m < val {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    0 - 1
}

fn sa_remove(var arr: Vec<i64>, val: i64) -> (Vec<i64>, i64) {
    let idx = sa_search(arr, val);
    if idx < 0 {
        return (arr, 0);
    }
    // Shift left
    var i = idx;
    while i < arr.len() - 1 {
        let next = arr[i + 1];
        arr.set(i, next);
        i = i + 1;
    }
    let _ = arr.pop();
    (arr, 1)
}

fn sa_is_sorted(arr: Vec<i64>) -> i64 {
    if arr.len() < 2 {
        return 1;
    }
    for i in 0 .. arr.len() - 1 {
        if arr[i] > arr[i + 1] {
            return 0;
        }
    }
    1
}

fn run_test(name: string, passed: i64) -> i64 {
    if passed == 1 {
        println(f"PASS: {name}");
    } else {
        println(f"FAIL: {name}");
    }
    passed
}

fn main() {
    var total = 0;
    var passed = 0;
    var arr: Vec<i64> = Vec.new();
    // Test 1: insert maintains sorted order
    total = total + 1;
    let seeds: Vec<i64> = [30, 10, 50, 20, 40];
    arr = sa_insert_all(arr, seeds);
    let r1 = if sa_is_sorted(arr) == 1 {
        1
    } else {
        0
    };
    passed = passed + run_test("insert maintains sorted", r1);

    // Test 2: correct values [10, 20, 30, 40, 50]
    total = total + 1;
    var r2 = 0;
    if arr[0] == 10 {
        if arr[1] == 20 {
            if arr[2] == 30 {
                if arr[3] == 40 {
                    if arr[4] == 50 {
                        r2 = 1;
                    }
                }
            }
        }
    }
    passed = passed + run_test("correct sorted values", r2);

    // Test 3: search finds existing
    total = total + 1;
    let idx = sa_search(arr, 30);
    let r3 = if idx == 2 {
        1
    } else {
        0
    };
    passed = passed + run_test("search finds 30 at idx 2", r3);

    // Test 4: search returns -1 for missing
    total = total + 1;
    let idx2 = sa_search(arr, 99);
    let r4 = if idx2 < 0 {
        1
    } else {
        0
    };
    passed = passed + run_test("search missing returns -1", r4);

    // Test 5: remove element
    total = total + 1;
    let (after_remove, removed) = sa_remove(arr, 30);
    arr = after_remove;
    var r5 = 0;
    if removed == 1 {
        if arr.len() == 4 {
            if sa_is_sorted(arr) == 1 {
                r5 = 1;
            }
        }
    }
    passed = passed + run_test("remove keeps sorted", r5);

    // Test 6: remove missing returns 0
    total = total + 1;
    let (after_miss, removed2) = sa_remove(arr, 99);
    arr = after_miss;
    let r6 = if removed2 == 0 {
        1
    } else {
        0
    };
    passed = passed + run_test("remove missing returns 0", r6);

    // Test 7: insert duplicates
    total = total + 1;
    let dups: Vec<i64> = [20, 20];
    arr = sa_insert_all(arr, dups);
    var r7 = 0;
    if sa_is_sorted(arr) == 1 {
        if arr.len() == 6 {
            r7 = 1;
        }
    }
    passed = passed + run_test("duplicates maintain sorted", r7);

    // Test 8: many elements
    total = total + 1;
    var arr2: Vec<i64> = Vec.new();
    // Insert in reverse order
    var j = 50;
    while j > 0 {
        j = j - 1;
        arr2 = sa_insert(arr2, j);
    }
    var r8 = 0;
    if arr2.len() == 50 {
        if sa_is_sorted(arr2) == 1 {
            r8 = 1;
        }
    }
    passed = passed + run_test("50 reverse inserts sorted", r8);

    // Summary
    println(f"{passed}/{total} tests passed");
    if passed == total {
        println("ALL PASS");
    } else {
        println("SOME FAILED");
    }
}
