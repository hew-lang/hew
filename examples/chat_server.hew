//! Status: runnable (local TCP; distributed Node API remains roadmap)
//! Description: TCP Chat Server — idiomatic Hew actor-based design.

// TCP Chat Server — idiomatic Hew actor-based design.
//
// Architecture:
//   main          — accept loop; spawns a ClientHandler and a ClientReader per
//                   connection and forks the reader's pump, so the loop never
//                   waits on a connection
//   ChatRoom      — holds Vec<ClientHandler>, fans out via mailbox submission
//   ClientHandler — owns the write half of one connection
//   ClientReader  — owns the read half and forwards frames to its handler
//
// Every actor call is an ask: it waits for the handler's turn. A connection is
// therefore consumed into independently owned Stream<bytes> and Sink<bytes>
// halves, so an idle reader never occupies the handler that has to deliver a
// broadcast to it. The room fans out through `mailbox(..., on_full: .Wait)`
// because the target handler may itself be inside `on_data`, waiting on the
// broadcast it triggered.
import std.encoding.utf8;

import std.net;

import std.os;

import std.stream.{Sink, Stream};

extern "C" {
    fn hew_actor_self_stop();
    fn hew_sink_shutdown(sink: Sink<bytes>);
}

actor ChatRoom {
    var handlers: Vec<ClientHandler>,
    var names: Vec<string>,
    receive fn register(handler: ClientHandler, name: string) {
        handlers.push(handler);
        names.push(name);
        println(f"{name} joined the chat");
    }
    receive fn unregister(name: string) {
        var new_handlers: Vec<ClientHandler> = Vec.new();
        var new_names: Vec<string> = Vec.new();
        for i in 0 .. names.len() {
            if names[i] != name {
                new_handlers.push(handlers[i]);
                new_names.push(names[i]);
            }
        }
        handlers = new_handlers;
        names = new_names;
        println(f"{name} left the chat");
    }
    receive fn broadcast(sender_name: string, msg: string) {
        for i in 0 .. names.len() {
            if names[i] != sender_name {
                // Submit without waiting: the target is usually inside
                // `on_data`, waiting on the broadcast it just triggered.
                let outbox = mailbox(handlers[i], on_full: .Wait);
                let _ = outbox.deliver(msg);
            }
        }
    }
}

// ClientHandler owns the write half. It never blocks on the socket read, so a
// broadcast reaches it while its own peer is idle.
actor ClientHandler {
    let sink: Sink<bytes>,
    let name: string,
    let room: ChatRoom,
    var registered: bool,
    receive fn welcome() {
        sink.send(f"[server] welcome {name}".to_bytes());
    }
    receive fn on_data(chunk: bytes) -> bool {
        let data = utf8.decode(chunk) handle error {
            println(f"[server] invalid UTF-8 from {name}: {error}");
            self_close();
            return false;
        };
        if data.is_empty() {
            self_close();
            return false;
        }
        if data.contains("__HEW_TCP_DISCONNECT__") {
            sink.send("__HEW_TCP_DISCONNECT__".to_bytes());
            self_close();
            return false;
        }
        let line = f"{name}: {data}";
        println(line);
        let _ = room.broadcast(name, line);
        true
    }
    receive fn on_close() {
        self_close();
    }
    receive fn deliver(msg: string) {
        sink.send(msg.to_bytes());
    }
    fn self_close() {
        if registered {
            let _ = room.unregister(name);
            registered = false;
        }
        unsafe {
            hew_sink_shutdown(sink)
        };
        unsafe {
            hew_actor_self_stop()
        };
    }
}

// ClientReader is the sole owner of the readable half. Dropping this actor
// closes the stream half exactly once.
actor ClientReader {
    let input: Stream<bytes>,
    let client: ClientHandler,
    receive fn start() {
        var reading = true;
        while reading {
            match input.recv() {
                .Some(chunk) => {
                    reading = match client.on_data(chunk) {
                        .Ok(keep_reading) => keep_reading,
                        .Err(_) => false,
                    };
                },
                .None => {
                    let _ = client.on_close();
                    reading = false;
                },
            }
        }
        unsafe {
            hew_actor_self_stop()
        };
    }
}

fn main() {
    var port: string = "9000";
    let arguments = os.args();
    let argc = arguments.len();
    if argc > 1 {
        if let .Some(value) = arguments.get(1) {
            port = value;
        }
    }
    let addr = f"0.0.0.0:{port}";
    let listener = match net.listen(addr) {
        .Ok(listener) => listener,
        .Err(_) => panic(f"[server] listen on {addr} failed"),
    };
    println("=== Hew TCP Chat Server ===");
    println(f"Listening on {addr}");
    let handlers: Vec<ClientHandler> = Vec.new();
    let names: Vec<string> = Vec.new();
    let room = spawn ChatRoom(handlers: handlers, names: names);
    var next_id: i32 = 1;
    loop {
        let conn = listener.accept();
        let name = f"client-{next_id}";
        let (input, sink) = conn.into_stream_sink();
        let handler = spawn ClientHandler(sink: sink, name: name.clone(), room: room, registered: true);
        let _ = room.register(handler, name);
        let _ = handler.welcome();
        // The pump runs as a forked task owned by this accept loop's scope,
        // which never exits, so the loop returns to `accept`.
        let reader = spawn ClientReader(input: input, client: handler);
        fork reader.start();
        next_id = next_id + 1;
    }
}
