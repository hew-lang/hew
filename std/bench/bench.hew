//! Benchmarks run with `hew bench` on the host clock.
//!
//! ```hew,no_run
//! import std.bench;
//!
//! #[bench]
//! fn concatenate(b: bench.Bencher) {
//!     b.iter(|| "hello" + " world");
//! }
//! ```


/// Supplied by the benchmark dispatcher.
pub type Bencher {
}

trait BencherMethods {
    /// Calibrate a batch, then measure 31 samples with automatic result cleanup.
    fn iter<T>(self, f: fn() -> T);
}

impl BencherMethods for Bencher {
    fn iter<T>(self, f: fn() -> T) {
        var iterations: i64 = 1;
        loop {
            let start = instant.now();
            for i in 0..iterations {
                f();
            }
            let elapsed = start.elapsed().nanos();
            if elapsed >= 1000000 || iterations >= 1048576 {
                break;
            }
            iterations = iterations * 2;
        }
        for sample in 0..31 {
            let start = instant.now();
            for i in 0..iterations {
                f();
            }
            let elapsed = start.elapsed().nanos();
            unsafe {
                hew_bench_record(elapsed, iterations);
            }
        }
    }
}

extern "C" {
    fn hew_bench_record(elapsed_ns: i64, iterations: i64);
}
