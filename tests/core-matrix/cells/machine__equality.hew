machine Counter {
    events { Inc, Reset, }
    state Zero,
    state NonZero { value: i64, },
    on Inc: Zero => NonZero { value: 1 }
    on Inc: NonZero => NonZero reenter { value: state.value + 1 }
    on Reset: NonZero => Zero,
    default { state }
}

fn main() {
    var a = Zero;
    a.step(.Inc);
    var b = Zero;
    b.step(.Inc);
    var c = Zero;
    c.step(.Inc);
    c.step(.Inc);
    let same = a == b;
    let diff = a == c;
    println(f"{same} {diff}");
}
