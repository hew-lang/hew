#[resource]
type Ticket { name: string }
impl Ticket {
    fn close(consume self) { println(f"close {self.name}"); }
}
type Booking { ticket: Ticket, label: string }
fn booking(name: string) -> Booking {
    Booking { ticket: Ticket { name: name.to_upper() }, label: name.to_upper() }
}
fn main() {
    let first = booking("let");
    let Booking { ticket: t, label: _ } = first;
    t.close();
    println(first.label);
    let second = booking("match");
    let matched = match second { Booking { ticket: selected, .. } => selected };
    matched.close();
    println(second.label);
    let pair = (Ticket { name: "tuple".to_upper() }, "sibling".to_upper());
    let (tuple_ticket, _) = pair;
    tuple_ticket.close();
    println(pair.1);
    let kept = booking("wildcard");
    let Booking { ticket: _, label } = kept;
    println(label);
    kept.ticket.close();
    let Booking { ticket: _, label: temporary_label } = booking("temporary");
    println(temporary_label);
    let guarded = booking("guarded");
    match guarded {
        Booking { ticket: declined, .. } if false => { declined.close(); }
        Booking { ticket: _, .. } => { println(guarded.ticket.name); }
    }
}
