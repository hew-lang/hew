// The corpus's deliberate hard refusal: a record hands one owned field away
// and then reads that same field back.
//
// Reading the sibling `label` is legal — the move took `booking.ticket` and
// nothing else — so the refusal below is the only blocking diagnostic this
// fixture produces.
#[resource]
type Ticket {
    id: i64,
}

impl Ticket {
    fn close(consume self) {
        println(f"closing ticket {self.id}");
    }
}

type Booking {
    ticket: Ticket,
    label: string,
}

fn redeem(consume ticket: Ticket) -> i64 {
    ticket.id
}

fn main() -> i64 {
    let booking = Booking { ticket: Ticket { id: 7 }, label: "seat-1" };
    let redeemed = redeem(booking.ticket);
    println(f"redeemed {redeemed}");
    println(booking.label);
    let again = redeem(booking.ticket);
    println(f"redeemed {again}");
    0
}
