//! Retained future semantic fixture for a closure that awaits a captured
//! Connection twice. Once function types carry suspension metadata, this will
//! exercise a matching closure driver across both parks: the first read should
//! bind the server payload and the second should resume on EOF with an empty
//! string. Today closure invocation sites cannot select that driver safely, so
//! MIR deliberately rejects this fixture with `suspension inside a closure`
//! before code generation.

import std.net.{Listener};

extern "C" {
    fn hew_tcp_listener_local_port(listener: Listener) -> i32;
}

actor Reader {
    let addr: string,

    receive fn go(unused: i64) {
        sleep(200ms);
        let conn = match net.connect(addr) {
            .Ok(conn) => conn,
            .Err(_) => panic(f"network setup failed"),
        };
        let read_twice = || {
            let first = await conn.read_string();
            let second = await conn.read_string();
            f"{first}|{second}"
        };
        let body = read_twice();
        println(f"reader-received: {body}");
        let _ = conn.close();
    }
}

fn main() {
    let listener = match net.listen("127.0.0.1:0") {
        .Ok(listener) => listener,
        .Err(_) => panic(f"network setup failed"),
    };
    let port = unsafe {
        hew_tcp_listener_local_port(listener)
    };
    let reader = spawn Reader(addr: f"127.0.0.1:{port}");
    reader.go(0);
    let client = listener.accept();
    let _ = client.write_string("payload");
    sleep(300ms);
    let _ = client.close();
    sleep(300ms);
    println("server-done");
}
