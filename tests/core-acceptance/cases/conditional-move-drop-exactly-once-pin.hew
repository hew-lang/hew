fn make_vec() -> Vec<i64> {
    var v: Vec<i64> = Vec.new();
    v.push(40);
    v.push(2);
    return v;
}

fn make_strs() -> Vec<string> {
    var v: Vec<string> = Vec.new();
    v.push("alpha");
    v.push("beta");
    return v;
}

fn cond_move(take: bool) -> i64 {
    let xs = make_vec();
    var out: i64 = 0;
    if take {
        let ys = xs;
        out = ys.len();
    }
    out
}

fn nested(a: bool, b: bool) -> i64 {
    let xs = make_vec();
    var out: i64 = 0;
    if a {
        if b {
            let ys = xs;
            out = out + ys.len();
        }
        out = out + 1;
    }
    out
}

fn loop_move(limit: i64) -> i64 {
    let xs = make_vec();
    var hits: i64 = 0;
    for i in 0..4 {
        if i == limit {
            let ys = xs;
            hits = hits + ys.len();
            break;
        }
        hits = hits + 1;
    }
    hits
}

fn array_chain(take: bool) -> i64 {
    let v: Vec<i64> = [7, 8, 9];
    var out: i64 = 1;
    if take {
        let w = v;
        out = w.len();
    }
    out
}

fn map_move(take: bool) -> i64 {
    var m: HashMap<string, i64> = HashMap.new();
    m.insert("k", 42);
    var out: i64 = 2;
    if take {
        let n = m;
        out = n.len();
    }
    out
}

fn strs_move(take: bool) -> i64 {
    let xs = make_strs();
    var out: i64 = 3;
    if take {
        let ys = xs;
        out = ys.len();
    }
    out
}

type Crate {
    items: Vec<i64>,
}

fn double_dest(a: bool, b: bool) -> i64 {
    let xs = make_vec();
    var out: i64 = 0;
    if a {
        let y = xs;
        out = y.len();
    } else if b {
        let z = xs;
        out = z.len() + 100;
    } else {
        out = 999;
    }
    out
}

fn both_arms(c: bool) -> i64 {
    let xs = make_vec();
    if c {
        let a = xs;
        return a.len();
    } else {
        let b = xs;
        return b.len() + 10;
    }
}

fn mixed_ingress(a: bool, b: bool) -> i64 {
    let xs = make_vec();
    var out: i64 = 0;
    if a {
        let y = xs;
        out = y.len();
    } else if b {
        let h = Crate { items: xs };
        out = h.items.len() + 100;
    } else {
        out = 999;
    }
    out
}

fn main() {
    print(cond_move(false));
    print(cond_move(true));
    print(nested(false, false));
    print(nested(true, false));
    print(nested(true, true));
    print(loop_move(2));
    print(loop_move(9));
    print(array_chain(false));
    print(array_chain(true));
    print(map_move(false));
    print(map_move(true));
    print(strs_move(false));
    print(strs_move(true));
    print(double_dest(true, false));
    print(double_dest(false, true));
    print(double_dest(false, false));
    print(both_arms(true));
    print(both_arms(false));
    print(mixed_ingress(true, false));
    print(mixed_ingress(false, true));
    print(mixed_ingress(false, false));
    print("OK");
}
