fn make() -> Vec<string> {
    var v: Vec<string> = Vec.new();
    v.push("per-call-element-one");
    v.push("per-call-element-two");
    return v;
}

fn probe(c: bool) -> i64 {
    let a = make();
    let b = make();
    let out = match c { true => a, false => b };
    out.len()
}

fn main() -> i64 {
    var total: i64 = 0;
    for seed in 0..50 {
        total = total + probe(seed % 2 == 0);
        println("frame");
    }
    match total >= 0 {
        true => 0,
        false => 1,
    }
}
