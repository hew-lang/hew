fn some_f() -> Option<string> { .Some("g2429-letelse-taken".to_upper()) }
fn none_f() -> Option<string> { .None }

fn use_return() -> i64 {
    let .Some(b) = some_f() else { return 0; };
    b.len()
}

fn miss_return() -> i64 {
    let .Some(b) = none_f() else { return 7; };
    b.len()
}

fn loop_continue() -> i64 {
    var seen = 0;
    var i = 0;
    while i < 3 {
        i = i + 1;
        let .Some(b) = some_f() else { continue; };
        seen = seen + b.len();
    }
    seen
}

fn main() {
    let a = use_return();
    let b = miss_return();
    let c = loop_continue();
    if a > 0 && b == 7 && c > 0 { print("ok"); }
}
