// `xs[a..=b]` lowers to the exclusive `xs[a..b + 1]`, so the inclusive and
// exclusive forms share one bounds contract and the added bound traps on
// overflow.

fn main() {
    var nums: Vec<i64> = Vec.new();
    nums.push(10);
    nums.push(20);
    nums.push(30);
    let inclusive = nums[0..=2];
    // Negative control: the exclusive form beside it stops one short.
    let exclusive = nums[0..2];
    let open_start = nums[..=1];
    println(f"inclusive slice len: {inclusive.len()}");
    println(f"exclusive slice len: {exclusive.len()}");
    println(f"open start len: {open_start.len()}");
    println(f"inclusive last: {inclusive[2]}");

    let text = "hello";
    println(f"string inclusive: {text[1..=3]}");
    println(f"string exclusive: {text[1..3]}");

    let raw = "hi".to_bytes();
    println(f"bytes inclusive len: {raw[0..=1].len()}");
}
