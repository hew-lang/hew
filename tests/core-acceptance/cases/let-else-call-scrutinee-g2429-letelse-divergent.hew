fn f() -> Option<string> { .None }

fn body() -> i64 {
    var misses = 0;
    var i = 0;
    while i < 64 {
        i = i + 1;
        let .Some(b) = f() else { misses = misses + 1; continue; };
        misses = misses + b.len();
    }
    misses
}

fn main() -> i64 {
    var acc = 0;
    var i = 0;
    while i < 50 {
        acc = acc + body();
        i = i + 1;
    }
    if acc > 0 { 0 } else { 1 }
}
