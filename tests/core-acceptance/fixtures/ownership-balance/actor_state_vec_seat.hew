// An actor state `Vec` is mutated in its own seat and explicitly replaced
// before its previous contents are drained. Each turn must leave exactly one
// owner of every buffer and element. A publish that did not release what it
// replaced shows up here as a slope: one string and one element slot per turn.

actor Basket {
    var items: Vec<string> = Vec.new();
    receive fn add(label: string) {
        items.push(label);
    }
    receive fn drain() -> i64 {
        let queued = items;
        items = Vec.new();
        var seen: i64 = 0;
        for item in queued.into_iter() {
            seen = seen + item.len();
        }
        seen
    }
    #[on(start)]
    fn boot() {
        items.push("seed");
    }
}

fn main() {
    // Driven 200k times so the leak oracle reads a slope, not one dispatch: a
    // per-turn residue of one allocation is invisible at a single iteration.
    let basket = spawn Basket;
    var total = 0;
    var k = 0;
    while k < 200000 {
        basket.add("alpha").expect("add");
        basket.add("beta").expect("add");
        total = total + basket.drain().expect("drain");
        k = k + 1;
    }
    println(total);
}
