// Reports from producers that once followed hash-table order.
import std.fs;

fn acquire() {
    let _ = fs.open_read("ungranted.txt");
}

#[confined]
fn boundary_0() {
    acquire();
}

#[confined]
fn boundary_1() {
    acquire();
}

#[confined]
fn boundary_2() {
    acquire();
}

#[confined]
fn boundary_3() {
    acquire();
}

#[confined]
fn boundary_4() {
    acquire();
}

#[confined]
fn boundary_5() {
    acquire();
}

