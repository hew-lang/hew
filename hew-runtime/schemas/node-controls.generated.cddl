; Generated from hew-runtime/protocol/node_controls.hew; run make node-protocol.
; Structural types only. Runtime owners enforce identity and resource policy.
wire-location = {
    1 => bstr, ; node
    2 => uint, ; target_id
    3 => 0..4294967295, ; incarnation
    4 => 0..4294967295, ; target_kind
}

wire-session = {
    1 => bstr, ; node
    2 => 0..4294967295, ; incarnation
}

cleanup-fault = {
    1 => -2147483648..2147483647, ; code
    2 => tstr, ; message
}

down-reason = {
    1 => 0..255, ; tag
    2 => -2147483648..2147483647, ; code
}

service-offer = {
    1 => uint, ; grant_id
    2 => wire-location, ; target
    3 => wire-session, ; recipient
    4 => [* tstr], ; handlers
    5 => uint, ; request_id
}

monitor-down = {
    1 => uint, ; ref_id
    2 => wire-location, ; target
    3 => down-reason, ; reason
    4 => -2147483648..2147483647, ; crash_kind
    5 => 0..255, ; end_reason
    6 => (cleanup-fault) / nil, ; close_fault
}

registry-gossip = {
    1 => 0..255, ; op
    2 => tstr, ; name
    3 => wire-location, ; location
}

swim-gossip = {
    1 => wire-session, ; member
    2 => -2147483648..2147483647, ; state
    3 => uint, ; incarnation
}

swim-control = {
    1 => -2147483648..2147483647, ; msg_type
    2 => wire-session, ; from
    3 => uint, ; incarnation
    4 => (wire-session) / nil, ; target
    5 => [* swim-gossip], ; gossip
}

cluster-member = {
    1 => 0..255, ; transport
    2 => bstr, ; credential
}

cluster-enrollment = {
    1 => bstr, ; authority
    2 => bstr, ; member
    3 => bstr, ; signature
}

node-handshake = {
    1 => 0..65535, ; protocol_version
    2 => 0..4294967295, ; schema_hash
    3 => 0..4294967295, ; feature_flags
    4 => bstr, ; node
    5 => 0..4294967295, ; incarnation
    6 => bstr, ; noise_key
    7 => bstr, ; enrollment
}

relay-open = {
    1 => uint, ; circuit
    2 => wire-session, ; origin
    3 => wire-session, ; target
}

relay-chunk = {
    1 => uint, ; circuit
    2 => uint, ; offset
    3 => bstr, ; body
}

relay-close = {
    1 => uint, ; circuit
}

