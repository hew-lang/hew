actor Keeper {
    var name: string,
    var count: i64 = 0,
    #[on(stop)]
    fn stopping() { println("stopped " + name); }
    receive fn bump() -> i64 { count = count + 1; count }
}

fn main() {
    // `close` waits: the stop hook has run by the time it returns.
    let waited = spawn Keeper(name: "waited");
    match waited.bump() {
        .Ok(count) => println(count),
        .Err(_) => panic("bump failed"),
    }
    close(waited);
    println("after close");

    // `fork close` requests without waiting; `await` joins the same point.
    let forked = spawn Keeper(name: "forked");
    let request = fork close(forked);
    await request;
    println("after join");

    // `closed` waits for a stop another party requested.
    let observed = spawn Keeper(name: "observed");
    fork close(observed);
    closed(observed);
    println("after closed");
}
