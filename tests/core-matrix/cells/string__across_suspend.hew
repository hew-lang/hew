actor Holder {
    var ready: bool;

    receive fn hold(v: string) -> i64 {
        sleep(2ms);
        println(f"{v}");
        ready = true;
        1
    }
}

fn main() {
    let x: string = "ab";
    let h = spawn Holder(ready: false);
    match await h.hold(x) {
        Result.Ok(n) => println(f"held {n}"),
        Err(_) => println("err"),
    }
}
