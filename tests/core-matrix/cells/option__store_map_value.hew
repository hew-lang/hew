fn main() {
    let x: Option<i64> = Option.Some(5);
    let m: HashMap<string, Option<i64>> = HashMap.new();
    m.insert("k", x);
    match m.get("k") {
        Option.Some(e) => {
            match e { Option.Some(e_v) => println(f"some {e_v}"), None => println("none"), }
        },
        None => println("missing"),
    }
}
