//! A `Vec` element keeps the layout-descriptor path for a direct `enum` and
//! carries a boxed node for an `indirect enum`. Both round-trip through push
//! and index, and both release their elements when the vector goes out of
//! scope.

import std.testing;

enum Dir {
    North,
    South,
    East(i64),
}

indirect enum Tree {
    Leaf(i64),
    Node(Tree, Tree),
}

fn dir_name(d: Dir) -> string {
    match d {
        .North => "N",
        .South => "S",
        .East(n) => f"E{n}",
    }
}

fn total(consume t: Tree) -> i64 {
    match t {
        .Leaf(n) => n,
        .Node(left, right) => total(left) + total(right),
    }
}

#[test]
fn direct_enum_vec_keeps_the_layout_path() {
    var v: Vec<Dir> = Vec.new();
    v.push(Dir.North);
    v.push(Dir.East(7));
    v.push(Dir.South);
    testing.assert_eq_str(dir_name(v[0]), "N");
    testing.assert_eq_str(dir_name(v[1]), "E7");
    testing.assert_eq_str(dir_name(v[2]), "S");
}

#[test]
fn indirect_enum_vec_round_trips_its_boxed_elements() {
    var v: Vec<Tree> = Vec.new();
    v.push(Tree.Leaf(4));
    v.push(Tree.Node(Tree.Leaf(1), Tree.Node(Tree.Leaf(2), Tree.Leaf(3))));
    testing.assert_eq(v.len(), 2);
    testing.assert_eq(total(v.pop()), 6);
    testing.assert_eq(total(v.pop()), 4);
}
