// Runnable fixture: machine with unit-event emit, executed end-to-end.
//
// Drives the MachineEmitPlaceholder codegen path via `hew run`:
//   1. Construct a `Signal` machine at its initial state.
//   2. Step with `Start`, which triggers `emit Ready {}` then transitions
//      to `Active`.
//   3. Observe that the step succeeds and state_name() reflects the new state.
//   4. Read the emitted output from the step's own report: outputs are
//      returned per-step (MACHINE-SPEC's `MStep.outputs`), not pulled from a
//      separate queue — a later step with no `emit` reports an empty vector.
//
// The emit call (`emit Ready {}`) is a unit-payload Mealy output. It lowers
// through `Instr::MachineEmitPlaceholder` in the LLVM IR, tagged with the
// machine's stable type id, and is collected into the step's `MStep.outputs`
// (see docs/specs/MACHINE-SPEC.md's emit section).
//
// `tests/exec/machine_exec.rs::run_emit_signal_fixture_executes` is the
// end-to-end signal for this fixture.
machine Signal {
    events {
        Start,
        Stop,
        Ready,
    }

    emits {
        Ready,
    }

    state Idle,
    state Active,

    on Start: Idle => Active {
        emit Ready {};
        Signal.Active
    }
    on Stop: Active => Idle {
        Signal.Idle
    }
    on Ready: Idle => Idle reenter {
        Signal.Idle
    }
    on Ready: Active => Active reenter {
        Signal.Active
    }
    on Start: Active => Active reenter {
        Signal.Active
    }
    on Stop: Idle => Idle reenter {
        Signal.Idle
    }
}

fn main() {
    var s = Idle;
    println(s.state_name());
    let started = s.step(.Start);
    println(s.state_name());
    println(started.outputs.len());
    let stopped = s.step(.Stop);
    println(stopped.outputs.len());
    println(s.state_name());
}
