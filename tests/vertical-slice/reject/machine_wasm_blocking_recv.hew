// A machine transition cannot perform externally visible stream I/O.
// The checker rejects the receive through its checked runtime target,
// after inferring the pipe's element type from the expected receive type.
//
// The .recv() call is on a real `Stream<i64>` obtained from the successful
// `stream.pipe(capacity)` result, rather than an unknown method or fake handle.
// The purity diagnostic must identify the receive on every target.
import std.stream;

machine M {
    events {
        Tick;
    }

    state Idle;
    state Done;

    on Tick: Idle => Done {
        match stream.pipe(8) {
            .Ok((_tx, rx)) => {
                let _received: Option<i64> = rx.recv();
                Done
            }
            .Err(_) => Done,
        }
    }

    default { state }
}

fn main() {}
