fn make_nested(k: i64) -> (((string, string), string), string) {
    let a = "tup-a-heap-payload".to_upper();
    let b = "tup-b-heap-payload".to_upper();
    let c = "tup-c-heap-payload".to_upper();
    let d = "tup-d-heap-payload".to_upper();
    ((( a, b ), c ), d)
}

fn run_cycle(k: i64) -> i64 {
    let o = make_nested(k);
    let mid = o.0;
    let leaf = mid.0;
    let x = match leaf {
        (s, _) => s.len(),
    };
    x
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        total = total + run_cycle(i);
        i = i + 1;
    }
    if total > 0 { 0 } else { 1 }
}
