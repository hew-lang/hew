#[test]
fn test_first_f64_single_element_returns_some() {
    var v: Vec<f64> = Vec.new();
    v.push(1.5);
    let result = vec.first_f64(v);
    assert(result.is_some());
    assert(result.unwrap_or(0.0) == 1.5);
