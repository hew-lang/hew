// Markdown identifier index.
//
// Walks a directory tree of markdown files, extracts identifier patterns
// ("A###", "Q###", "D##") from prose, builds an in-memory frequency index and
// prints a summary.
//
// A parameter is the callee's own copy, so every collector here returns the
// collection it grew and the caller reassigns. Only handles — actors, channels,
// resources — share identity across a call.
//
// Run it as `hew run examples/hew-orch/main.hew -- <dir>`; it defaults to
// `docs` so it has something to read from a fresh checkout.
import std.fs;

import std.os;

// ---------------------------------------------------------------------------
// Character classification
//
// The public `string` surface has no codepoint accessor, so a one-character
// slice is classified by membership in a literal set. That is equivalent to a
// codepoint range for the ASCII identifiers this indexer looks for.
const DIGITS: string = "0123456789";

const ID_HEADS: string = "AQD";

fn is_digit_str(c: string) -> bool {
    DIGITS.contains(c)
}

fn is_id_head_str(c: string) -> bool {
    ID_HEADS.contains(c)
}

// ---------------------------------------------------------------------------
// ID extraction
//
// Scan a single line and append its first "A###" / "Q###" / "D##" occurrence
// to `out`, which comes back through the return value. The digit run is probed
// with `for j in i + 1 .. n`, whose empty range skips on its own.
fn extract_ids_in_line(line: string, var out: Vec<string>) -> Vec<string> {
    let n = line.len();
    for i in 0 .. n {
        let head = line.slice(i, i + 1);
        if is_id_head_str(head) {
            // Walk the digit run.
            var end = i + 1;
            for j in i + 1 .. n {
                if is_digit_str(line.slice(j, j + 1)) {
                    end = j + 1;
                } else {
                    break;
                }
            }
            if end > i + 1 {
                out.push(line.slice(i, end));
                break;
            }
        }
    }
    out
}

// ---------------------------------------------------------------------------
// Recursive .md collection
fn collect_md_files(dir: string, var out: Vec<string>) -> Vec<string> {
    let entries = match fs.list_dir(dir) {
        .Ok(entries) => entries,
        .Err(_) => return out,
    };
    for name in entries {
        let full = dir + "/" + name;
        if fs.is_dir(full) {
            out = collect_md_files(full, out);
        } else if name.ends_with(".md") {
            out.push(full);
        }
    }
    out
}

// ---------------------------------------------------------------------------
// Index ingest
//
// Index shape: HashMap<string, i32> (id -> reference count). Subscript
// assignment does not lower for HashMap, so this reads with `get` and writes
// with `insert`.
fn ingest_file(path: string, var index: HashMap<string, i32>) -> HashMap<string, i32> {
    let content = match fs.read(path) {
        .Ok(content) => content,
        .Err(_) => return index,
    };
    var ids: Vec<string> = Vec.new();
    for line in content.lines() {
        ids = extract_ids_in_line(line, ids);
    }
    for id in ids {
        match index.get(id) {
            .Some(prev) => {
                index.insert(id, prev + 1);
            },
            .None => {
                index.insert(id, 1);
            },
        }
    }
    index
}

fn main() {
    var dir = "docs";
    let arguments = os.args();
    if arguments.len() > 1 {
        if let .Some(value) = arguments.get(1) {
            dir = value;
        }
    }
    if !fs.is_dir(dir) {
        println(f"hew-orch: {dir} is not a directory");
        return;
    }
    println(f"hew-orch ingest {dir}");
    let empty: Vec<string> = Vec.new();
    let files = collect_md_files(dir, empty);
    println(f"files found: {files.len()}");
    var index: HashMap<string, i32> = HashMap.new();
    for file in files {
        index = ingest_file(file, index);
    }
    let keys = index.keys();
    println(f"distinct ids indexed: {keys.len()}");

    // Ranking the top identifiers needs a sort-by-second-element closure over
    // Vec<(string, i32)>; the public surface exposes only natural-order sorts
    // today, so this prints the first five keys unranked.
    println("first 5 ids (unranked):");
    let kn = keys.len();
    let limit = if kn < 5 {
        kn
    } else {
        5
    };
    for k in 0 .. limit {
        let id = keys[k];
        if let .Some(c) = index.get(id) {
            println(f"{id} {c}");
        }
    }
}
