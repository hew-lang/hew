type Pair { a: i64, b: Vec<i64> }

fn make(n: i64) -> Pair {
    var inner: Vec<i64> = Vec.new();
    inner.push(n);
    inner.push(n + 1);
    Pair { a: n, b: inner }
}

fn build(n: i64) -> i64 {
    let p = make(n);
    p.a
}

fn main() -> i64 {
    var total: i64 = 0;
    for i in 0..64 {
        total = total + build(i);
    }
    if total != 2016 { return 60; }
    0
}
