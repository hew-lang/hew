// A lambda actor call waits for its reply and exposes a typed completion.
// The successful result must contain the value produced by the body.
fn main() {
    let dbl = actor |n: i64| -> i64 {
        n * 2
    };
    let r = dbl(5);
    match r {
        .Ok(v) => println(f"ask {v}"),
        .Err(_) => println("err"),
    }
}
