// An explicitly imported trait contributes both its leaf default and the
// default that dispatches through a required method. The root implementation
// overrides only the required method.
import file_import_trait_default_method_lib.{Greet};

type RootThing {
    label: string;
}

impl Greet for RootThing {
    fn name(self) -> string {
        self.label
    }
}

fn main() {
    let t = RootThing { label: "hew" };
    println(t.name());
    println(t.simple());
    println(t.greeting());
}
