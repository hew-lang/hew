// Compile-measure fixture for MIR lowering time.
//
// Shape, not content: a document emitter that accumulates one `string` through
// a long chain of `+` concatenations, guarded field emissions, and nested loops
// over `Vec<record>`, calling helpers with record projections as arguments.
// Every `+` is a call, so a single body here carries hundreds of call
// terminators with their normal/unwind successors — the shape whose ownership
// replay cost `make bench-mir` budgets. Modelled on a real multi-module
// project's serializer; no content is copied from it.
import std.string;

type Attribute {
    key: string,
    value: string,
    unit: string,
    note: string,
}

type Endpoint {
    kind: string,
    address: string,
    protocol: string,
    credential: string,
    fallback: string,
    labels: Vec<string>,
    attributes: Vec<Attribute>,
}

type Limits {
    present: bool,
    max_parallel: i64,
    max_per_hour: i64,
    max_depth: i64,
    max_pending: i64,
}

type Stage {
    name: string,
    kind: string,
    goal: string,
    owner: string,
    integrity: string,
    region: string,
    channel: string,
    contact: string,
    retention: string,
    checksum: string,
    origin: string,
    revision: string,
    summary: string,
    category: string,
    severity: string,
    visibility: string,
    locale: string,
    inputs: Vec<string>,
    command: Vec<string>,
    endpoints: Vec<Endpoint>,
    attributes: Vec<Attribute>,
    limits: Limits,
}

type Document {
    api_version: string,
    kind: string,
    schema_version: string,
    name: string,
    group: string,
    display_name: string,
    start: string,
    region: string,
    tier: string,
    channel: string,
    owner: string,
    contact: string,
    licence: string,
    retention: string,
    checksum: string,
    origin: string,
    revision: string,
    author: string,
    summary: string,
    category: string,
    severity: string,
    visibility: string,
    locale: string,
    requires: Vec<string>,
    endpoints: Vec<Endpoint>,
    stages: Vec<Stage>,
    limits: Limits,
}

fn quote(value: string) -> string {
    if value == "" {
        return "\"\"";
    }
    if value.starts_with("#") {
        return "\"" + value + "\"";
    }
    "\"" + value.trim() + "\""
}

fn emit_list(indent: string, label: string, items: Vec<string>) -> string {
    if items.is_empty() {
        return "";
    }
    var out = indent + label + ":\n";
    for item in items {
        out = out + indent + "  - " + quote(item) + "\n";
    }
    out
}

fn emit_attributes(indent: string, items: Vec<Attribute>) -> string {
    if items.is_empty() {
        return "";
    }
    var out = indent + "attributes:\n";
    for item in items {
        out = out + indent + "  - key: " + quote(item.key) + "\n";
        out = out + indent + "    value: " + quote(item.value) + "\n";
        if item.unit != "" {
            out = out + indent + "    unit: " + quote(item.unit) + "\n";
        }
        if item.note != "" {
            out = out + indent + "    note: " + quote(item.note) + "\n";
        }
    }
    out
}

fn emit_limits(indent: string, limits: Limits) -> string {
    if !limits.present {
        return "";
    }
    var out = indent + "limits:\n";
    out = out + indent + "  maxParallel: " + string.from_int(limits.max_parallel) + "\n";
    out = out + indent + "  maxPerHour: " + string.from_int(limits.max_per_hour) + "\n";
    if limits.max_depth > 0 {
        out = out + indent + "  maxDepth: " + string.from_int(limits.max_depth) + "\n";
    }
    if limits.max_pending > 0 {
        out = out + indent + "  maxPending: " + string.from_int(limits.max_pending) + "\n";
    }
    out
}

fn emit_endpoint(indent: string, endpoint: Endpoint) -> string {
    var out = indent + "- kind: " + quote(endpoint.kind) + "\n";
    out = out + indent + "  address: " + quote(endpoint.address) + "\n";
    if endpoint.protocol != "" {
        out = out + indent + "  protocol: " + quote(endpoint.protocol) + "\n";
    }
    if endpoint.credential != "" {
        out = out + indent + "  credential: " + quote(endpoint.credential) + "\n";
    }
    if endpoint.fallback != "" {
        out = out + indent + "  fallback: " + quote(endpoint.fallback) + "\n";
    }
    out = out + emit_list(indent + "  ", "labels", endpoint.labels);
    out = out + emit_attributes(indent + "  ", endpoint.attributes);
    out
}

fn emit_document(doc: Document) -> string {
    var s = "";
    s = s + "apiVersion: " + quote(doc.api_version) + "\n";
    s = s + "kind: " + quote(doc.kind) + "\n";
    s = s + "schemaVersion: " + quote(doc.schema_version) + "\n";
    s = s + "name: " + quote(doc.name) + "\n";
    s = s + "group: " + quote(doc.group) + "\n";
    s = s + "displayName: " + quote(doc.display_name) + "\n";
    s = s + "start: " + quote(doc.start) + "\n";
    if doc.region != "" {
        s = s + "  region: " + quote(doc.region) + "\n";
    }
    if doc.tier != "" {
        s = s + "  tier: " + quote(doc.tier) + "\n";
    }
    if doc.channel != "" {
        s = s + "  channel: " + quote(doc.channel) + "\n";
    }
    if doc.owner != "" {
        s = s + "  owner: " + quote(doc.owner) + "\n";
    }
    if doc.contact != "" {
        s = s + "  contact: " + quote(doc.contact) + "\n";
    }
    if doc.licence != "" {
        s = s + "  licence: " + quote(doc.licence) + "\n";
    }
    if doc.retention != "" {
        s = s + "  retention: " + quote(doc.retention) + "\n";
    }
    if doc.checksum != "" {
        s = s + "  checksum: " + quote(doc.checksum) + "\n";
    }
    if doc.origin != "" {
        s = s + "  origin: " + quote(doc.origin) + "\n";
    }
    if doc.revision != "" {
        s = s + "  revision: " + quote(doc.revision) + "\n";
    }
    if doc.author != "" {
        s = s + "  author: " + quote(doc.author) + "\n";
    }
    if doc.summary != "" {
        s = s + "  summary: " + quote(doc.summary) + "\n";
    }
    if doc.category != "" {
        s = s + "  category: " + quote(doc.category) + "\n";
    }
    if doc.severity != "" {
        s = s + "  severity: " + quote(doc.severity) + "\n";
    }
    if doc.visibility != "" {
        s = s + "  visibility: " + quote(doc.visibility) + "\n";
    }
    if doc.locale != "" {
        s = s + "  locale: " + quote(doc.locale) + "\n";
    }
    s = s + emit_list("  ", "requires", doc.requires);
    s = s + emit_limits("  ", doc.limits);
    if !doc.endpoints.is_empty() {
        s = s + "  endpoints:\n";
        for endpoint in doc.endpoints {
            s = s + emit_endpoint("    ", endpoint);
        }
    }
    s = s + "  stages:\n";
    for stage in doc.stages {
        if stage.name != "" {
            s = s + "    - name: " + quote(stage.name) + "\n";
        }
        if stage.kind != "" {
            s = s + "    - type: " + quote(stage.kind) + "\n";
        }
        if stage.goal != "" {
            s = s + "    - goal: " + quote(stage.goal) + "\n";
        }
        if stage.owner != "" {
            s = s + "    - owner: " + quote(stage.owner) + "\n";
        }
        if stage.integrity != "" {
            s = s + "    - integrity: " + quote(stage.integrity) + "\n";
        }
        if stage.region != "" {
            s = s + "      region: " + quote(stage.region) + "\n";
        }
        if stage.channel != "" {
            s = s + "      channel: " + quote(stage.channel) + "\n";
        }
        if stage.contact != "" {
            s = s + "      contact: " + quote(stage.contact) + "\n";
        }
        if stage.retention != "" {
            s = s + "      retention: " + quote(stage.retention) + "\n";
        }
        if stage.checksum != "" {
            s = s + "      checksum: " + quote(stage.checksum) + "\n";
        }
        if stage.origin != "" {
            s = s + "      origin: " + quote(stage.origin) + "\n";
        }
        if stage.revision != "" {
            s = s + "      revision: " + quote(stage.revision) + "\n";
        }
        if stage.summary != "" {
            s = s + "      summary: " + quote(stage.summary) + "\n";
        }
        if stage.category != "" {
            s = s + "      category: " + quote(stage.category) + "\n";
        }
        if stage.severity != "" {
            s = s + "      severity: " + quote(stage.severity) + "\n";
        }
        if stage.visibility != "" {
            s = s + "      visibility: " + quote(stage.visibility) + "\n";
        }
        if stage.locale != "" {
            s = s + "      locale: " + quote(stage.locale) + "\n";
        }
        s = s + emit_list("      ", "inputs", stage.inputs);
        s = s + emit_list("      ", "command", stage.command);
        s = s + emit_attributes("      ", stage.attributes);
        s = s + emit_limits("      ", stage.limits);
        if !stage.endpoints.is_empty() {
            s = s + "      endpoints:\n";
            for endpoint in stage.endpoints {
                s = s + emit_endpoint("        ", endpoint);
            }
        }
    }
    s
}

fn main() {
    let requires: Vec<string> = Vec.new();
    let endpoints: Vec<Endpoint> = Vec.new();
    let stages: Vec<Stage> = Vec.new();
    let doc = Document {
        api_version: "v1",
        kind: "Document",
        schema_version: "2.0",
        name: "sample",
        group: "core",
        display_name: "Sample",
        start: "first",
        region: "",
        tier: "",
        channel: "",
        owner: "",
        contact: "",
        licence: "",
        retention: "",
        checksum: "",
        origin: "",
        revision: "",
        author: "",
        summary: "",
        category: "",
        severity: "",
        visibility: "",
        locale: "",
        requires: requires,
        endpoints: endpoints,
        stages: stages,
        limits: Limits {
            present: false,
            max_parallel: 0,
            max_per_hour: 0,
            max_depth: 0,
            max_pending: 0,
        },
    };
    println(emit_document(doc).len());
}
