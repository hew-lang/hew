//! TOML values with automatic cleanup and independent copies.
//!
//! Inspect values with checked accessors. Mutate a `var` value with `set`
//! or `push`; supplied children remain usable and independent. For data with
//! a known shape, prefer `toml.decode<T>(text)`.
//!
//! # Examples
//!
//! ```
//! import std.encoding.toml;
//!
//! fn main() {
//!     let doc = toml.parse("[package]\nname = \"hew\"").expect("valid TOML");
//!     let pkg = doc.get_field("package").expect("document is a table")
//!         .expect("[package] is present");
//!     let name = pkg.get_field("name").expect("package is a table")
//!         .expect("package.name is present");
//!     println(name.get_string().expect("package.name is a string")); // hew
//! }
//! ```

import std.encoding.wire;

/// The represented TOML kind, without exposing runtime tags. TOML has no null.
pub enum Kind {
    Bool;
    Integer;
    Float;
    String;
    Datetime;
    Array;
    Table;
}

/// Malformed TOML input. Carries the native parser message.
pub enum ParseError {
    Invalid(string);
}

impl Display for ParseError {
    fn fmt(self) -> string {
        match self {
            ParseError.Invalid(message) => message,
        }
    }
}

/// A value cannot be written as a TOML document. Carries the native message.
pub enum EncodeError {
    Invalid(string);
}

impl Display for EncodeError {
    fn fmt(self) -> string {
        match self {
            EncodeError.Invalid(message) => message,
        }
    }
}

impl Error for EncodeError {}

/// A checked access or mutation failed without changing the value.
pub enum AccessError {
    /// Expected kind, followed by the actual kind.
    WrongKind(Kind, Kind);
    /// The index is negative or exceeds the supported runtime index range.
    InvalidIndex(i64);
}

impl Display for AccessError {
    fn fmt(self) -> string {
        match self {
            AccessError.WrongKind(_, _) => "toml: unexpected value kind",
            AccessError.InvalidIndex(index) => f"toml: unsupported array index {index}",
        }
    }
}

/// An owning TOML value. Assignment and extraction produce independent values.
/// Cleanup is automatic; the representation remains private.
#[opaque]
pub type Value {
}

impl Eq for Value {
    fn eq(self, other: Value) -> bool {
        unsafe {
            hew_toml_eq(self, other) == 1
        }
    }
}

trait ValueMethods {
    fn type_of(self) -> Kind;

    /// Only a Table can be a document root; any other root is
    /// `EncodeError.Invalid`.
    fn stringify(self) -> Result<string, EncodeError>;

    fn get_bool(self) -> Result<bool, AccessError>;

    fn get_int(self) -> Result<i64, AccessError>;

    /// Read a float without coercing an integer to a float.
    fn get_float(self) -> Result<f64, AccessError>;

    fn get_string(self) -> Result<string, AccessError>;

    /// The TOML lexical form: an offset or local date-time, a local date, or
    /// a local time.
    fn get_datetime(self) -> Result<string, AccessError>;

    /// Missing keys return None; a non-table receiver returns
    /// `WrongKind(Table, actual)`.
    fn get_field(self, key: string) -> Result<Option<Value>, AccessError>;

    /// Return an independent Array of the table's keys as Strings, in sorted
    /// key order.
    fn keys(self) -> Result<Value, AccessError>;

    fn array_len(self) -> Result<i64, AccessError>;

    /// Missing elements return None; unsupported indices return InvalidIndex.
    fn array_get(self, index: i64) -> Result<Option<Value>, AccessError>;

    /// Set a string-keyed field, preserving the supplied child.
    fn set(var self, key: string, child: Value) -> Result<(), AccessError>;

    /// Append an independent copy of the child.
    fn push(var self, child: Value) -> Result<(), AccessError>;
}

fn require_kind(value: Value, expected: Kind) -> Result<(), AccessError> {
    let actual = value.type_of();
    if actual == expected { .Ok(()) } else { .Err(AccessError.WrongKind(expected, actual)) }
}

impl ValueMethods for Value {
    fn type_of(self) -> Kind {
        match unsafe {
            hew_toml_type(self)
        } {
            1 => Kind.Bool,
            2 => Kind.Integer,
            3 => Kind.Float,
            4 => Kind.String,
            5 => Kind.Array,
            6 => Kind.Table,
            7 => Kind.Datetime,
            _ => panic("toml: invalid internal value"),
        }
    }
    fn stringify(self) -> Result<string, EncodeError> {
        let text = unsafe {
            hew_toml_stringify(self)
        };
        // Read immediately: the runtime clears this slot on successful encoding.
        let reason = unsafe {
            hew_toml_last_error()
        };
        if !reason.is_empty() { .Err(EncodeError.Invalid(reason)) } else { .Ok(text) }
    }
    fn get_bool(self) -> bool fails AccessError {
        require_kind(self, Kind.Bool)?;
        unsafe {
            hew_toml_get_bool(self) == 1
        }
    }
    fn get_int(self) -> i64 fails AccessError {
        require_kind(self, Kind.Integer)?;
        unsafe {
            hew_toml_get_int(self)
        }
    }
    fn get_float(self) -> f64 fails AccessError {
        require_kind(self, Kind.Float)?;
        unsafe {
            hew_toml_get_float(self)
        }
    }
    fn get_string(self) -> string fails AccessError {
        require_kind(self, Kind.String)?;
        unsafe {
            hew_toml_get_string(self)
        }
    }
    fn get_datetime(self) -> string fails AccessError {
        require_kind(self, Kind.Datetime)?;
        unsafe {
            hew_toml_get_datetime(self)
        }
    }
    fn get_field(self, key: string) -> Option<Value> fails AccessError {
        require_kind(self, Kind.Table)?;
        let child = unsafe {
            hew_toml_get_field(self, key)
        };
        if unsafe {
            hew_toml_type(child)
        } < 0 {
            .None
        } else {
            .Some(child)
        }
    }
    fn keys(self) -> Value fails AccessError {
        require_kind(self, Kind.Table)?;
        unsafe {
            hew_toml_object_keys(self)
        }
    }
    fn array_len(self) -> i64 fails AccessError {
        require_kind(self, Kind.Array)?;
        unsafe {
            hew_toml_array_len(self) as i64
        }
    }
    fn array_get(self, index: i64) -> Option<Value> fails AccessError {
        require_kind(self, Kind.Array)?;
        if index < 0 || index > 2147483647 {
            return error AccessError.InvalidIndex(index);
        }
        let child = unsafe {
            hew_toml_array_get(self, index as i32)
        };
        if unsafe {
            hew_toml_type(child)
        } < 0 {
            .None
        } else {
            .Some(child)
        }
    }
    fn set(var self, key: string, child: Value) fails AccessError {
        require_kind(self, Kind.Table)?;
        // Assignment acquires an independent value; insertion transfers that owner.
        let owned_child = child;
        unsafe {
            hew_toml_object_set(self, key, owned_child)
        };
    }
    fn push(var self, child: Value) fails AccessError {
        require_kind(self, Kind.Array)?;
        let owned_child = child;
        unsafe {
            hew_toml_array_push(self, owned_child)
        };
    }
}

/// Parse a TOML document, retaining the parser's diagnostic on failure.
pub fn parse(text: string) -> Result<Value, ParseError> {
    let value = unsafe {
        hew_toml_parse(text)
    };
    let reason = unsafe {
        hew_toml_last_error()
    };
    if unsafe {
        hew_toml_type(value)
    } < 0 {
        .Err(ParseError.Invalid(reason))
    } else {
        .Ok(value)
    }
}

/// Create an empty Table.
pub fn table() -> Value {
    unsafe {
        hew_toml_object_new()
    }
}

/// Create an empty Array.
pub fn array() -> Value {
    unsafe {
        hew_toml_array_new()
    }
}

pub fn from_int(val: i64) -> Value {
    unsafe {
        hew_toml_from_int(val)
    }
}

/// Construct a float; TOML admits `inf` and `nan`, so this cannot fail.
pub fn from_float(val: f64) -> Value {
    unsafe {
        hew_toml_from_float(val)
    }
}

pub fn from_string(val: string) -> Value {
    unsafe {
        hew_toml_from_string(val)
    }
}

pub fn from_bool(val: bool) -> Value {
    unsafe {
        hew_toml_from_bool(val as i32)
    }
}

// Runtime tags, private copies and consuming child insertion stay behind the API.
extern "C" {
    fn hew_toml_parse(text: string) -> Value;
    fn hew_toml_last_error() -> string;
    fn hew_toml_stringify(val: Value) -> string;
    fn hew_toml_type(val: Value) -> i32;
    fn hew_toml_eq(lhs: Value, rhs: Value) -> i32;
    fn hew_toml_get_bool(val: Value) -> i32;
    fn hew_toml_get_int(val: Value) -> i64;
    fn hew_toml_get_float(val: Value) -> f64;
    fn hew_toml_get_string(val: Value) -> string;
    fn hew_toml_get_datetime(val: Value) -> string;
    fn hew_toml_get_field(val: Value, key: string) -> Value;
    fn hew_toml_array_len(val: Value) -> i32;
    fn hew_toml_array_get(val: Value, index: i32) -> Value;
    fn hew_toml_object_keys(val: Value) -> Value;
    fn hew_toml_object_new() -> Value;
    fn hew_toml_array_new() -> Value;
    fn hew_toml_object_set(tbl: Value, key: string, consume child: Value);
    fn hew_toml_array_push(arr: Value, consume child: Value);
    fn hew_toml_from_int(val: i64) -> Value;
    fn hew_toml_from_float(val: f64) -> Value;
    fn hew_toml_from_string(val: string) -> Value;
    fn hew_toml_from_bool(val: i32) -> Value;
}

/// Encode any data value as a TOML document. Records encode as tables keyed by
/// field name in declaration order.
#[intrinsic("codec.toml.encode")]
pub fn encode<T: Serializable>(value: T) -> string {}

/// Decode a TOML document as `T`. A failure names the path of the value that did
/// not fit, for example `Type: .tags[1]: expected string, found integer`.
#[intrinsic("codec.toml.decode")]
pub fn decode<T: Serializable>(text: string) -> Result<T, wire.DecodeError> {}
