actor Audit {
    receive fn record(id: i64) { sleep(1ms); println(f"closed {id}"); }
}
#[resource]
type Ticket { audit: Audit, id: i64, }
impl Ticket {
    fn close(consume self) { self.audit.record(self.id).expect("audit"); }
}
actor Worker {
    receive fn create(audit: Audit) -> Ticket { sleep(3ms); Ticket { audit: audit, id: 9 } }
    receive fn ready() { println("ready"); }
}
fn main() {
    let audit = spawn Audit;
    let worker = spawn Worker;
    scope within 1ms {
        let ticket = worker.create(audit).expect("created");
        println(ticket.id);
    } handle failure {
        match failure {
            .Deadline { message } => println("deadline"),
            .Fault { message } => panic(message),
        }
    };
    worker.ready().expect("ready");
    close(worker);
    close(audit);
}
