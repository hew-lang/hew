fn duration::fmt -> string
  statements:
    use BindingId(33) val site=SiteId(156) ty=duration intent=Read
    bind BindingId(4294967231) __hew_produced_value site=SiteId(154) ty=string
    bind BindingId(4294967230) __hew_produced_value site=SiteId(153) ty=string
    use BindingId(4294967230) __hew_produced_value site=SiteId(153) ty=string intent=Consume
    return site=Some(SiteId(153)) ty=string
    drop BindingId(4294967230) __hew_produced_value ty=string
    drop BindingId(4294967231) __hew_produced_value ty=string
  decisions:
    site=s0 ty=duration value_class=BitCopy intent=Unknown strategy=ParamBoundary(ParamBoundaryFact { param_index: 0, param_count: 1, caller_visible_projection: false, mode: BorrowReadOnly }) why="checker-authoritative parameter boundary classification"
    site=s153 ty=string value_class=CowValue intent=Read strategy=CowShare why="first vertical-slice classifier"
    site=s154 ty=string value_class=CowValue intent=Read strategy=CowShare why="first vertical-slice classifier"
    site=s155 ty=i64 value_class=BitCopy intent=Read strategy=BorrowRead why="first vertical-slice classifier"
    site=s156 ty=duration value_class=BitCopy intent=Read strategy=BorrowRead why="first vertical-slice classifier"
    site=s159 ty=string value_class=CowValue intent=Read strategy=CowShare why="first vertical-slice classifier"
  blocks:
    id=0 kind=normal
      successor: none
    id=1 kind=normal
      successor: none
    id=2 kind=normal
      successor: none
    id=3 kind=normal
      successor: none
  drop_plans:
    call[bb0 hew_duration_nanos -> bb1] ->
      (none)
    unwind[bb0 hew_duration_nanos] ->
      (none)
    cancel[bb0] ->
      (none)
    call[bb1 hew_i64_to_string -> bb2] ->
      (none)
    unwind[bb1 hew_i64_to_string] ->
      (none)
    call[bb2 hew_string_concat -> bb3] ->
      (none)
    unwind[bb2 hew_string_concat] ->
      drop _2 ty=string kind=cow_heap(hew_string_drop)
    return[bb3] ->
      (none)

