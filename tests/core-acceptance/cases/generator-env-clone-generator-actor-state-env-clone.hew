type Config { label: string }

actor Reader {
    var name: string,
    receive gen fn stream() -> i64 {
        yield name.len();
        yield name.len() + 1;
    }
}

supervisor App(config: Config) {
    strategy: one_for_one,
    intensity: 3 within 60s,
    child reader: Reader(name: config.label),
}

fn main() {
    let config = Config { label: "actor-state" };
    let app = spawn App(config: config);
    let reader = app.reader;
    var seen: i64 = 0;
    var i: i64 = 0;
    while i < 16 {
        for value in reader.stream() {
            if value <= 0 { panic("actor state value"); }
            seen = seen + 1;
        }
        i = i + 1;
    }
    supervisor_stop(app);
    print(f"{seen}:OK");
}
