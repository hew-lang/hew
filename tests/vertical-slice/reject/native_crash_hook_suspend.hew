// Native limitation: lifecycle adapters need actor-owned coroutine scheduling.
import std.failure;
actor Peer { receive fn ping() {} }
actor Watcher {
    let peer: Peer,
    #[on(crash)] fn notified(note: failure.CrashInfo) -> failure.CrashAction {
        peer.ping().expect("peer");
        failure.CrashAction.Restart
    }
}
fn main() {
    let peer = spawn Peer;
    let watcher = spawn Watcher(peer: peer);
    close(watcher);
    close(peer);
}
