// An `#[extern_symbol]` method declares its C boundary with its own Hew
// signature: a borrowed receiver, its declared parameters and its declared
// return type, including a scalar optional whose absent case is the runtime's
// sentinel.

fn main() {
    let text = "Hé 9世!";
    println(f"runes={text.len()} bytes={text.byte_len()} codepoints={text.len()}");
    match text.get(3) {
        .Some(cp) => println(f"at3={cp.as_i64()}"),
        .None => println("at3=none"),
    }
    match text.get(99) {
        .Some(cp) => println(f"at99={cp.as_i64()}"),
        .None => println("at99=none"),
    }
    println(f"trim=[{"  pad  ".trim()}] contains={text.contains("9")}");
    // The receiver keeps its value: a borrowed extern receiver is not consumed.
    println(f"again={text.byte_len()}");
}
