import std.failure;

actor Worker {
    var label: string = "initial";
    receive fn rename(value: string) {
        label = value;
    }
    receive fn get() -> string {
        label
    }
    receive fn fail() {
        label = label + "!";
        panic("crash incarnation");
    }
    #[on(crash)]
    fn crashed(info: failure.CrashInfo) -> failure.CrashAction {
        assert(label == "CHANGED!");
        assert(info.code != 0);
        println(label);
        failure.CrashAction.Restart
    }
}

supervisor Group {
    intensity: 1 within 60s;
    child worker: Worker;
}

fn main() {
    let group = spawn Group;
    group.worker.rename("changed".to_upper()).expect("rename");
    let _ = group.worker.fail();
    let _ = {
        let __hew_migrated_role_734 = group.worker;
        restarted(__hew_migrated_role_734);
        __hew_migrated_role_734
    };
    assert(group.worker.get().expect("fresh") == "initial");
    {
        let __hew_migrated_actor_827 = group;
        stop(__hew_migrated_actor_827);
        stopped(__hew_migrated_actor_827);
    };
    println("last valid crash state, fresh restart");
}
