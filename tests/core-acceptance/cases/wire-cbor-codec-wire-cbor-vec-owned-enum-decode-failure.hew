import std.encoding.cbor;

#[wire]
enum Payload {
    Empty @0;
    Full(string) @1;
}

#[wire]
type BagGood {
    items: Vec<Payload> @1;
    tail: string @2;
}

#[wire]
type BagBad {
    items: Vec<Payload> @1;
    tail: i64 @2;
}

fn main() -> i64 {
    var xs: Vec<Payload> = Vec.new();
    xs.push(Payload.Full("first-owned-element"));
    xs.push(Payload.Empty);
    xs.push(Payload.Full("second-owned-element"));
    let g = BagGood { items: xs, tail: "owned-tail-value" };
    let raw = cbor.encode(g);
    match cbor.decode<BagBad>(raw) {
        .Ok(bad) => bad.tail,
        .Err(e) => {
            println(e);
            0
        }
    }
}
