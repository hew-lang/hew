actor Echo {
    var seen: i64,

    receive fn take(v: i64) -> i64 {
        seen = seen + v;
        seen
    }
}

fn main() {
    let a = spawn Echo(seen: 0);
    let b = spawn Echo(seen: 1);
    let v: Vec<LocalPid<Echo>> = Vec.new();
    v.push(a);
    v.push(b);
    for e in v {
        match await e.take(1) { Result.Ok(e_v) => println(f"echo {e_v}"), Result.Err(_) => println("err"), }
    }
}
