import std.string;

type Snap { label: string, n: i64, terminal: bool }
enum Fail { Missing(i64) }

// Direct-call carrier, payload binder returned directly, NO enclosing loop.
// Narrows whether the loop or the binder-return is the discriminator.
fn snapshot(k: i64) -> Result<Snap, Fail> {
    if k % 4 == 3 {
        return Err(Fail.Missing(k));
    }
    Ok(Snap { label: "snap-" + string.from_int(k), n: k, terminal: k % 7 == 6 })
}

fn empty_snap() -> Snap {
    Snap { label: "", n: -1, terminal: false }
}

fn once(k: i64) -> Snap {
    match snapshot(k) {
        .Ok(s) => {
            if s.terminal {
                return s;
            }
        },
        .Err(_) => {},
    }
    empty_snap()
}

fn main() {
    var k: i64 = 0;
    while k < 200000 {
        let _ = once(k);
        k = k + 1;
    }
    println(once(6).label);
}
