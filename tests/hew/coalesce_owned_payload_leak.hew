//! Owned-payload coalesce oracle. Each superseded string must be dropped once:
//! skipping a drop leaks under the vertical-slice leak oracle, while dropping
//! twice trips the poisoned allocator/double-free path.

import std.stream;

actor OwnedCoalescer {
    var processed: i64 = 0,
    var latest_len: i64 = -1,

    mailbox 1 overflow coalesce(id) fallback drop_new,

    // Holds the actor: reports that it is running, then waits for its gate.
    receive fn hold(started: stream.Sink<i64>, gate: stream.Stream<i64>) {
        started.send(1).expect("started");
        gate.recv();
    }

    receive fn update(id: i64, payload: string) {
        processed = processed + 1;
        latest_len = payload.len() as i64;
    }

    receive fn count() -> i64 {
        processed
    }

    receive fn length() -> i64 {
        latest_len
    }
}

#[test]
fn coalesce_owned_payload_superseded_values_drop_once() {
    let worker = spawn OwnedCoalescer(processed: 0, latest_len: -1);
    let intake = mailbox(worker);
    let (started_tx, started) = stream.pipe(1).expect("started");
    let (release, gate) = stream.pipe(1).expect("gate");
    let _ = intake.hold(started_tx, gate);
    started.recv();
    let _ = intake.update(9, "one");
    let _ = intake.update(9, "two-two");
    let _ = intake.update(9, "three-three-three");
    let _ = intake.update(9, "latest-payload");
    release.send(1).expect("release");
    match worker.count() {
        .Ok(value) => assert(value == 1),
        .Err(_) => assert(false),
    }
    match worker.length() {
        .Ok(value) => assert(value == 14),
        .Err(_) => assert(false),
    }
}
