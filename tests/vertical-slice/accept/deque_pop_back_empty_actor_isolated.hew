import std.deque;

// EXIT: 1
actor DequePopBackCrasher {
    receive fn boom() {
        let dq = deque.new();
        let _ = dq.pop_back();
    }
}

actor DequePopBackProbe {
    receive fn ping() -> i64 {
        0
    }
}

fn main() -> i64 {
    let crasher = spawn DequePopBackCrasher;
    let probe = spawn DequePopBackProbe;
    let _ = crasher.boom();
    sleep(300ms);
    match probe.ping() {
        .Ok(v) => v,
        .Err(_) => 1,
    }
}
