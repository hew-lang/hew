// The reverse direction of #2810: `var` on a by-value `Vec` parameter IS
// caller-visible. The parameter carries a handle to storage the caller still
// references, so the write through it must reach the caller and the widened
// ineffective-var guard must not flag it.
//
// Expected stdout:
//   9
//   3
fn set_first(var v: Vec<i64>) {
    v[0] = 9;
}

fn append(var v: Vec<i64>) {
    v.push(7);
}

fn main() -> i64 {
    let v: Vec<i64> = [1, 2];
    set_first(v);
    append(v);
    println(v[0]);
    println(v.len());
    0
}
