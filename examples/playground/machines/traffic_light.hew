//! @name Traffic Light
//! @description A traffic signal state machine

machine TrafficLight {
    events {
        Tick;
    }

    state Red;
    state Green;
    state Yellow;

    on Tick: Red => Green {
        TrafficLight.Green
    }
    on Tick: Green => Yellow {
        TrafficLight.Yellow
    }
    on Tick: Yellow => Red {
        TrafficLight.Red
    }
}

fn main() {
    var light: TrafficLight = .Red;
    println(light.state_name());
    light.step(.Tick);
    println(light.state_name());
    light.step(.Tick);
    println(light.state_name());
    light.step(.Tick);
    println(light.state_name());
}
