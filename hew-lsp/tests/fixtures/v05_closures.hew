fn closure_probe(x: i32) -> i32 {
    x + 1
}

fn closures() -> i32 {
    let inc = |x: i32| -> i32 { closure_probe(x) };
    let twice = |x: i32| -> i32 { inc(inc(x)) };
    twice(closure_probe(5))
}

fn generic_identity() -> fn<T>(T) -> T {
    |<T> value: T| -> T { value }
}

fn quantified_closures() -> i64 {
    let identity = generic_identity();
    assert(identity<string>("editor") == "editor");
    identity(9)
}
