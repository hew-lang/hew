//! HTTP server for handling web requests.
//!
//! Provides a blocking HTTP server that listens on a TCP address,
//! accepts incoming requests, and sends responses. Request-body reads time out
//! after 30 seconds by default so slow trickle-feed clients cannot hold the
//! server indefinitely.
//!
//! # Examples
//!
//! ```hew,no_run
//! import std.net.http.server as http;
//!
//! fn main() {
//!     match http.listen(":8080") {
//!         .Ok(server) => {
//!             let req = server.accept().expect("accept request");
//!             req.respond_text(200, "Hello from Hew!").expect("respond_text succeeds");
//!             server.close();
//!         }
//!         .Err(err) => {
//!             println(f"{err}");
//!         }
//!     }
//! }
//! ```

import std.net;

/// An HTTP server bound to a TCP address.
///
/// Created by calling `http.listen(addr)`, which returns `Err` when the
/// address cannot be bound. Use `accept()` to wait for
/// incoming requests in a loop, then call `close()` before the value goes
/// out of scope.
#[resource]
#[opaque]
pub type Server {
}

/// An incoming HTTP request.
///
/// Obtained from `server.accept()`. Provides accessors for the request
/// method, path, headers, and body. Must be responded to with one of
/// the `respond` methods. Requests close automatically at scope exit; call
/// `close()` to release one early.
#[resource]
#[opaque]
pub type Request {
}

// ── Server methods ────────────────────────────────────────────────────
/// Methods available on an HTTP `Server`.
trait ServerMethods {
    /// Return the TCP port selected for this listener.
    fn port(self) -> i64;
    /// Block until a client connects and return the next `Request`.
    fn accept(self) -> Request fails net.NetError;

    /// Set a positive per-request body read deadline.
    fn set_request_timeout(self, timeout: duration) fails net.NetError;
}

impl ServerMethods for Server {
    fn port(self) -> i64 {
        unsafe {
            hew_http_server_port(self) as i64
        }
    }
    /// Accept the next incoming HTTP request.
    fn accept(self) -> Request fails net.NetError {
        let request = unsafe {
            hew_http_server_recv(self)
        };
        if unsafe {
            hew_http_request_is_valid(request)
        } {
            request
        } else {
            return error net.NetError.Protocol(unsafe {
                hew_http_last_error()
            });
        }
    }
    /// Set a positive per-request body read deadline.
    fn set_request_timeout(self, timeout: duration) fails net.NetError {
        if timeout <= 0ns {
            return error net.NetError.InvalidArgument("HTTP request timeout must be positive");
        }
        let status = unsafe {
            hew_http_server_set_request_timeout_ms(self, timeout.millis_ceil())
        };
        if status < 0 {
            return error net.NetError.InvalidArgument("HTTP request timeout could not be set");
        }
    }
}

impl Server {
    /// Release this server early. Scope exit performs the same release.
    fn close(consume self) {
        unsafe {
            hew_http_server_close(self)
        };
    }
}

// ── Request methods ───────────────────────────────────────────────────
/// Methods available on an HTTP `Request`.
trait RequestMethods {
    /// Return the HTTP method (e.g. `"GET"`, `"POST"`).
    fn method(self) -> string;

    /// Return the request path (e.g. `"/api/users"`).
    fn path(self) -> string;

    /// Return the named header, or `None` when absent.
    fn header(self, name: string) -> Option<string> fails net.NetError;

    /// Return all request headers as a list of `(name, value)` pairs.
    ///
    /// The returned vector is owned by the caller; Hew frees it automatically
    /// when it goes out of scope. Returns an empty vector if no headers were
    /// present or the request is invalid.
    fn headers(self) -> Vec<(string, string)>;

    /// Return the request body, decoded according to `encoding`.
    ///
    /// Text is decoded as UTF-8. An empty encoding selects UTF-8; other
    /// encodings and invalid UTF-8 bytes return errors.
    fn body(self, encoding: string) -> string fails net.NetError;

    /// Consume this request and send a full HTTP response.
    ///
    /// The `Content-Length` header is derived from `body` automatically.
    fn respond(consume self, status: i64, content_type: string, body: string) -> Result<(), net.NetError>;

    /// Send a plain-text HTTP response.
    ///
    /// # Examples
    ///
    /// ```hew,no_run
    /// import std.net.http.server as http;
    ///
    /// fn main() {
    ///     match http.listen(":8080") {
    ///         .Ok(server) => {
    ///             let req = server.accept().expect("accept request");
    ///             req.respond_text(200, "OK").expect("respond_text succeeds");
    ///             server.close();
    ///         }
    ///         .Err(err) => println(f"{err}"),
    ///     }
    /// }
    /// ```
    fn respond_text(consume self, status: i64, body: string) -> Result<(), net.NetError>;

    /// Send a JSON HTTP response with `Content-Type: application/json`.
    fn respond_json(consume self, status: i64, json: string) -> Result<(), net.NetError>;

    /// Consume this request and return a `Sink` for chunked response output.
    ///
    /// Each `sink.send(chunk)` sends data to the client immediately.
    /// Call `sink.close()` to finish the response.
    ///
    /// # Examples
    ///
    /// ```hew,no_run
    /// import std.net.http.server as http;
    ///
    /// fn main() {
    ///     match http.listen(":8080") {
    ///         .Ok(server) => {
    ///             let req = server.accept().expect("accept request");
    ///             let body = req.respond_stream(200, "text/plain").expect("begin response");
    ///             body.send("chunk 1").expect("send");
    ///             body.send("chunk 2").expect("send");
    ///             body.close();
    ///             server.close();
    ///         }
    ///         .Err(err) => println(f"{err}"),
    ///     }
    /// }
    /// ```
    fn respond_stream(consume self, status: i64, content_type: string) -> Result<Sink<string>, net.NetError>;
}

impl RequestMethods for Request {
    /// Return the HTTP method (e.g. `"GET"`, `"POST"`).
    fn method(self) -> string {
        unsafe {
            hew_http_request_method(self)
        }
    }
    /// Return the request path (e.g. `"/api/users"`).
    fn path(self) -> string {
        unsafe {
            hew_http_request_path(self)
        }
    }
    /// Return the named header, or `None` when absent.
    fn header(self, name: string) -> Option<string> fails net.NetError {
        let value = unsafe {
            hew_http_request_header(self, name)
        };
        let detail = unsafe {
            hew_http_last_error()
        };
        if !detail.is_empty() {
            return error net.NetError.Protocol(detail);
        }
        if unsafe {
            hew_http_request_has_header(self, name)
        } {
            .Some(value)
        } else {
            .None
        }
    }
    /// Return all request headers as a list of `(name, value)` pairs.
    fn headers(self) -> Vec<(string, string)> {
        unsafe {
            hew_http_request_headers(self)
        }
    }
    /// Return the request body decoded according to `encoding`.
    fn body(self, encoding: string) -> string fails net.NetError {
        if !encoding.is_empty() && encoding.to_lower() != "utf-8" {
            return error net.NetError.InvalidArgument(f"unsupported HTTP body encoding: {encoding}");
        }
        let value = unsafe {
            hew_http_request_body_string(self, encoding)
        };
        let detail = unsafe {
            hew_http_last_error()
        };
        if !detail.is_empty() {
            return error net.NetError.Protocol(detail);
        }
        value
    }
    /// Consume this request and send a full HTTP response.
    fn respond(consume self, status: i64, content_type: string, body: string) fails net.NetError {
        if !valid_response_status(status) {
            return error net.NetError.InvalidArgument(f"HTTP response status {status} must be in 100..=599");
        }
        let result = unsafe {
            hew_http_respond_bridge(self, status as i32, content_type, body)
        };
        if result < 0 {
            return error net.NetError.Protocol(unsafe {
                hew_stream_last_error()
            });
        }
    }
    /// Send a plain-text HTTP response.
    fn respond_text(consume self, status: i64, body: string) fails net.NetError {
        self.respond(status, "text/plain; charset=utf-8", body)?;
    }
    /// Send a JSON HTTP response.
    fn respond_json(consume self, status: i64, json: string) fails net.NetError {
        self.respond(status, "application/json", json)?;
    }
    /// Begin a streaming response.
    fn respond_stream(consume self, status: i64, content_type: string) -> Sink<string> fails net.NetError {
        if !valid_response_status(status) {
            return error net.NetError.InvalidArgument(f"HTTP response status {status} must be in 100..=599");
        }
        let sink = unsafe {
            hew_http_respond_stream(self, status as i32, content_type)
        };
        if unsafe {
            hew_sink_is_valid(sink)
        } {
            sink
        } else {
            return error net.NetError.Protocol(unsafe {
                hew_stream_last_error()
            });
        }
    }
}

fn valid_response_status(status: i64) -> bool {
    status >= 100 && status <= 599
}

impl Request {
    /// Release this request early. Scope exit performs the same release.
    fn close(consume self) {
        unsafe {
            hew_http_request_free(self)
        };
    }
}

// ── Module-level functions ────────────────────────────────────────────
/// Create a new HTTP server listening on the given address.
///
/// The address format is `"host:port"` or `":port"` to listen on all
/// interfaces.
///
/// Returns `Err(net.NetError)` when the address cannot be bound — the port is
/// already in use, the address is not local, or the string is not a valid
/// endpoint. The returned error carries the failure detail.
///
/// # Examples
///
/// ```hew,no_run
/// import std.net;
/// import std.net.http.server as http;
///
/// fn main() {
///     match http.listen("127.0.0.1:0") {
///         .Ok(server) => server.close(),
///         .Err(_) => println(f"listen failed"),
///     }
/// }
/// ```
pub fn listen(addr: string) -> Result<Server, net.NetError> {
    let server = unsafe {
        hew_http_server_new(addr)
    };
    let ok = unsafe {
        hew_http_server_is_valid(server)
    };
    if ok {
        return .Ok(server);
    }
    let errno = unsafe {
        hew_http_last_listen_errno()
    };
    if errno == -1 {
        let detail = unsafe {
            hew_http_last_error()
        };
        return .Err(net.NetError.InvalidArgument(detail));
    }
    if errno == 0 {
        return .Err(net.NetError.Protocol(unsafe {
            hew_http_last_error()
        }));
    }
    .Err(net.net_error_from_errno(errno))
}

// ── FFI bindings (implementation detail) ──────────────────────────────
extern "C" {
    fn hew_http_server_new(addr: string) -> Server;
    fn hew_http_server_is_valid(server: Server) -> bool;
    fn hew_http_server_port(server: Server) -> i32;
    fn hew_http_last_listen_errno() -> i64;
    fn hew_http_last_error() -> string;
    fn hew_http_server_recv(server: Server) -> Request;
    fn hew_http_server_set_request_timeout_ms(server: Server, timeout_ms: i64) -> i32;
    fn hew_http_request_is_valid(req: Request) -> bool;
    fn hew_http_request_has_header(req: Request, name: string) -> bool;
    fn hew_http_request_method(req: Request) -> string;
    fn hew_http_request_path(req: Request) -> string;
    fn hew_http_request_body_string(req: Request, encoding: string) -> string;
    fn hew_http_request_header(req: Request, name: string) -> string;
    fn hew_http_request_headers(req: Request) -> Vec<(string, string)>;
    fn hew_http_respond_bridge(req: Request, status: i32, content_type: string, body: string) -> i32;
    fn hew_http_respond_text(req: Request, status: i32, body: string) -> i32;
    fn hew_http_respond_json(req: Request, status: i32, json: string) -> i32;
    fn hew_http_respond_stream(req: Request, status: i32, content_type: string) -> Sink<string>;
    fn hew_http_server_close(consume server: Server);
    fn hew_http_request_free(consume req: Request);
    fn hew_sink_is_valid(sink: Sink<string>) -> bool;
    fn hew_stream_last_error() -> string;
}
