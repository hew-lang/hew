//! Status: runnable
//! Description: HTTP + JSON pipeline demo.

// HTTP + JSON pipeline demo.
//
// Demonstrates `std.net.http.http_client` and `std.encoding.json`
// working together: fetch a JSON payload over HTTP, navigate a nested
// object, extract typed fields, and count an array.
//
// How to run:
//   hew run examples/http_json_demo.hew
//
// Expected output (online):
//   Fetching https://httpbin.org/json...
//   title:  Sample Slide Show
//   author: Yours Truly
//   date:   date of publication
//   slides: 2
//
// Expected output (offline / server unreachable):
//   Fetching https://httpbin.org/json...
//   http request failed (no network or server unreachable)
//
// Note: requires internet access. Not included in the automated test
// suite because output depends on network availability.
//
import std.net.http.http_client;

import std.encoding.json.{self, Value};

// Fetch a URL and return the body string, or None on transport failure.
fn fetch(url: string) -> Option<string> {
    http_client.get_string(url)
}

// Distinguish a missing field from a value of the wrong kind.
fn required_field(obj: Value, key: string) -> Result<Value, string> {
    match obj.get_field(key) {
        .Ok(.Some(value)) => Ok(value),
        .Ok(.None) => Err(f"missing field: {key}"),
        .Err(error) => Err(f"{key}: {error}"),
    }
}

fn print_field(obj: Value, key: string) -> Result<(), string> {
    let child = required_field(obj, key)?;
    match child.get_string() {
        .Ok(value) => {
            println(f"{key}:  {value}");
            Ok(())
        },
        .Err(error) => Err(f"{key}: {error}"),
    }
}

fn print_slideshow(root: Value) -> Result<(), string> {
    let slideshow = required_field(root, "slideshow")?;
    print_field(slideshow, "title")?;
    print_field(slideshow, "author")?;
    print_field(slideshow, "date")?;
    let slides = required_field(slideshow, "slides")?;
    match slides.array_len() {
        .Ok(count) => {
            println(f"slides: {count}");
            Ok(())
        },
        .Err(error) => Err(f"slides: {error}"),
    }
}

fn main() {
    let url = "https://httpbin.org/json";
    println(f"Fetching {url}...");
    match fetch(url) {
        .Some(body) => {
            match json.parse(body) {
                .Ok(root) => {
                    match print_slideshow(root) {
                        .Ok(()) => {},
                        .Err(message) => println(f"json data error: {message}"),
                    }
                },
                .Err(error) => println(f"json parse failed: {error}"),
            }
        },
        .None => println("http request failed (no network or server unreachable)"),
    }
}
