// A copyable collection cursor observes the logical value at loop entry.
// Mutating the source detaches it through COW and cannot alter that cursor.
type Holder { items: Vec<i64> }

fn push_clear_snapshot() {
    var items: Vec<i64> = Vec.new();
    items.push(40);
    items.push(2);
    var holder = Holder { items: items };
    var seen = 0;
    var total = 0;
    for value in holder.items {
        seen = seen + 1;
        total = total + value;
        if seen == 1 { holder.items.push(7); }
        if seen == 2 { holder.items.clear(); }
    }
    println(f"push-clear {seen} {total} {holder.items.len()}");
}

fn index_snapshot() {
    var items: Vec<i64> = Vec.new();
    items.push(40);
    items.push(2);
    var holder = Holder { items: items };
    var seen = 0;
    var total = 0;
    for value in holder.items {
        if seen == 0 { holder.items[1] = 9; }
        seen = seen + 1;
        total = total + value;
    }
    println(f"index {seen} {total} {holder.items[1]}");
}

fn main() {
    push_clear_snapshot();
    index_snapshot();
}
