// An authored `#[resource] #[opaque]` handle has no checked release contract on
// the final path, so any program that names one fails in SIR verification:
//
//   internal compiler error: E_SIR_VERIFY: SIR verification failed:
//   InvalidResourceType { ty: Dq, reason: "resource type has no checked release contract" }
//
// HIR admits the lifecycle: `admit_declared_opaque_resource_lifecycles`
// (hew-hir/src/lower.rs) records one whose `release_declaration` IS the close
// method, because an authored handle declares no separate release ABI. SIR's
// `resource_release_from_hir` (hew-sir/src/resource.rs) then looks that
// declaration up among `HirItem::ExternFn` items, finds nothing, and publishes
// no release at all. `ResourceRelease` has an extern-backed `Nominal` arm and a
// record-shaped `RecordClose` arm; the authored opaque form needs the second
// shape - release by semantic callable - with the first shape's pointer
// carrier.
//
// The record form of the same program compiles and runs; see the
// `resource-field-record-drop` acceptance case.
#[resource]
#[opaque]
type Dq {}

impl Dq {
    fn close(consume self) {
        unsafe { hew_deque_free(self) };
        println("closed");
    }
}

extern "C" {
    fn hew_deque_new() -> Dq;
    fn hew_deque_free(consume dq: Dq);
}

type Holder {
    dq: Dq,
}

fn main() {
    let h = Holder { dq: unsafe { hew_deque_new() } };
    println("made");
}
