// A value that is not data is refused where the facade is called: a resource,
// and a collection or tuple reaching one. Plain records, tuples and
// collections of them are data. A plain type carries no per-type codec method.
import std.encoding.wire;

type Plain {
    a: i64;
    b: string;
}

#[resource]
type Handle {
    fd: i64;
}

impl Handle {
    fn close(consume self) {}
}

fn main() {
    let plains: Vec<Plain> = [Plain { a: 1, b: "x" }];
    println(wire.to_json(plains));
    let handle = Handle { fd: 3 };
    println(wire.to_json(handle));
    println(wire.to_json((1, "a")));
    let plain = Plain { a: 2, b: "y" };
    println(plain.to_json());
}
