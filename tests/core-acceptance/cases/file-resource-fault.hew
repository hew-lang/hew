import std.stream;

type Reader { input: Stream<string>, label: string }

fn open(path: string) -> Stream<string> {
    match stream.from_file(path) {
        .Ok(input) => input,
        .Err(_) => panic("fixture open failed"),
    }
}

fn fail(divisor: i64) -> i64 {
    let _reader = Reader { input: open("resource-fault-record.txt"), label: "owned record".to_upper() };
    let input = open("resource-fault-capture.txt");
    let _uncalled: fn[once]() -> string = move || input.collect();
    let _local = open("resource-fault-local.txt");
    7 / divisor
}

fn main() -> i64 {
    let _caller = open("resource-fault-caller.txt");
    fail(0)
}
