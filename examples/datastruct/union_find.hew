// Union-Find (Disjoint Set) with path compression and union by rank
//
// A parameter is the callee's own copy, so path compression and union hand the
// parent and rank vectors back and the caller reassigns. Lookups that only read
// stay pure.
fn find_root(parent: Vec<i64>, x: i64) -> i64 {
    var r = x;
    while parent[r] != r {
        r = parent[r];
    }
    r
}

// Path compression: point every node on the path from x straight at the root.
fn compress(var parent: Vec<i64>, x: i64, root: i64) -> Vec<i64> {
    var c = x;
    while c != root {
        let next = parent[c];
        parent.set(c, root);
        c = next;
    }
    parent
}

// Join the sets holding a and b; the bool reports whether they were separate.
fn union(var parent: Vec<i64>, var rank: Vec<i64>, a: i64, b: i64) -> (Vec<i64>, Vec<i64>, bool) {
    let ra = find_root(parent, a);
    let rb = find_root(parent, b);
    parent = compress(parent, a, ra);
    parent = compress(parent, b, rb);
    if ra == rb {
        return (parent, rank, false);
    }
    let rka = rank[ra];
    let rkb = rank[rb];
    if rka < rkb {
        parent.set(ra, rb);
    } else if rka > rkb {
        parent.set(rb, ra);
    } else {
        parent.set(rb, ra);
        rank.set(ra, rka + 1);
    }
    (parent, rank, true)
}

// Union every (a, b) pair; the pairs vector holds a, b at i*2, i*2+1.
fn union_pairs(var parent: Vec<i64>, var rank: Vec<i64>, pairs: Vec<i64>) -> (Vec<i64>, Vec<i64>) {
    let count = pairs.len() / 2;
    for i in 0 .. count {
        let (joined, ranked, _changed) = union(parent, rank, pairs[i * 2], pairs[i * 2 + 1]);
        parent = joined;
        rank = ranked;
    }
    (parent, rank)
}

fn connected(parent: Vec<i64>, a: i64, b: i64) -> bool {
    find_root(parent, a) == find_root(parent, b)
}

fn count_components(parent: Vec<i64>) -> i64 {
    let n = parent.len();
    var count = 0;
    for i in 0 .. n {
        if find_root(parent, i) == i {
            count = count + 1;
        }
    }
    count
}

fn main() {
    var passed = 0;
    var failed = 0;
    let n = 8;
    // Initialize: each node is its own parent
    var parent: Vec<i64> = Vec.new();
    var rank: Vec<i64> = Vec.new();
    for i in 0 .. n {
        parent.push(i);
        rank.push(0);
    }
    // Test 1: Initially 8 components
    if count_components(parent) == 8 {
        println("PASS: initial 8 components");
        passed = passed + 1;
    } else {
        println("FAIL: initial components");
        failed = failed + 1;
    }
    // Test 2: Union 0-1, 2-3, 4-5, 6-7 -> 4 components
    let first_pairs: Vec<i64> = [0, 1, 2, 3, 4, 5, 6, 7];
    let (after_pairs, rank_pairs) = union_pairs(parent, rank, first_pairs);
    parent = after_pairs;
    rank = rank_pairs;
    if count_components(parent) == 4 {
        println("PASS: 4 components after pairs");
        passed = passed + 1;
    } else {
        println("FAIL: components after pairs");
        failed = failed + 1;
    }
    // Test 3: 0 and 1 connected
    if connected(parent, 0, 1) {
        println("PASS: 0 and 1 connected");
        passed = passed + 1;
    } else {
        println("FAIL: 0 and 1 connected");
        failed = failed + 1;
    }
    // Test 4: 0 and 2 not connected
    if connected(parent, 0, 2) {
        println("FAIL: 0 and 2 should not be connected");
        failed = failed + 1;
    } else {
        println("PASS: 0 and 2 not connected");
        passed = passed + 1;
    }
    // Test 5: Union {0,1} with {2,3} -> 3 components
    let merge_pair: Vec<i64> = [1, 3];
    let (after_merge, rank_merge) = union_pairs(parent, rank, merge_pair);
    parent = after_merge;
    rank = rank_merge;
    if count_components(parent) == 3 {
        println("PASS: 3 components after merge");
        passed = passed + 1;
    } else {
        println("FAIL: components after merge");
        failed = failed + 1;
    }
    // Test 6: Now 0 and 2 connected (transitive)
    if connected(parent, 0, 2) {
        println("PASS: 0 and 2 now connected");
        passed = passed + 1;
    } else {
        println("FAIL: 0 and 2 should be connected");
        failed = failed + 1;
    }
    // Test 7: Redundant union returns false
    let (after_dup, rank_dup, dup) = union(parent, rank, 0, 3);
    parent = after_dup;
    rank = rank_dup;
    if dup {
        println("FAIL: redundant union should return false");
        failed = failed + 1;
    } else {
        println("PASS: redundant union returns false");
        passed = passed + 1;
    }
    // Test 8: Merge all into 1 component
    let last_pairs: Vec<i64> = [0, 4, 4, 6];
    let (after_last, rank_last) = union_pairs(parent, rank, last_pairs);
    parent = after_last;
    rank = rank_last;
    if count_components(parent) == 1 {
        if connected(parent, 0, 7) {
            println("PASS: all in one component");
            passed = passed + 1;
        } else {
            println("FAIL: all connected");
            failed = failed + 1;
        }
    } else {
        println("FAIL: single component");
        failed = failed + 1;
    }
    println("---");
    print("Passed: ");
    print(passed);
    print("/");
    println(8);
    if failed == 0 {
        println("ALL PASS");
    } else {
        println("SOME FAILED");
    }
}
