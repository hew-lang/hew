// A `.DropNewest` mailbox view reports the discard to its sender as the
// submission's own outcome: the policy chose to lose the message, so it is a
// described delivery, not a failure. The sender is itself
// an actor handler: with one worker, that handler occupies the only thread that
// could activate LossyWorker, so the first message is still queued when the
// second send observes the full mailbox. `main` runs on the process main
// thread, not on a scheduler worker, so sending from `main` would race the
// worker's wake.
actor LossyWorker {
    mailbox 1 overflow drop_new,
    receive fn work(value: i64) {
        if value == 2 {
            println("DROPPED_WORK_DELIVERED");
        }
    }
}

actor Driver {
    receive fn run(worker: LocalPid<LossyWorker>) {
        let inbox = mailbox(worker, on_full: .DropNewest);
        match inbox.work(1) {
            .Ok(_) => {},
            .Err(_) => {
                println("FIRST_SEND_FAILED");
                exit(41);
            },
        }
        match inbox.work(2) {
            .Ok(delivery) => match delivery {
                Delivery.Discarded => {
                    println("LOSS_VISIBLE");
                    exit(42);
                },
                Delivery.Accepted => {
                    println("LOSS_HIDDEN");
                    exit(44);
                },
            },
            .Err(_) => {
                println("UNEXPECTED_SEND_ERROR");
                exit(43);
            },
        }
    }
}

fn main() {
    let worker = spawn LossyWorker;
    let driver = spawn Driver;
    let _ = driver.run(worker);
}
