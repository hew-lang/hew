// Create one authority with `hew node authority --key authority.key`.
// Enrol both node credentials under it with
// `hew node identity --key PATH --transport TRANSPORT` and
// `hew node admit --authority authority.key --credential HEX --transport TRANSPORT --output FILE`.
// Set HEW_NODE_CLUSTER to this node's enrolment file, then start the server
// and client. Without that setting, each program prints its credential and exits.
// TCP: server [port], client [host] [port]. Mesh uses loopback ports 9000/9001.
import std.net;
import std.net.cluster;

import std.os;

// This declaration mirrors the server's portable receive interface. The client
// receives an ordinary KeyValue handle from the authenticated service offer.
actor KeyValue {
    #[wire]
    receive fn put(key: string, value: string) -> string {
        ""
    }

    #[wire]
    receive fn get(key: string) -> string {
        ""
    }
}

fn main() -> i64 {
    let args = os.args();
    let host = match args.get(1) {
        .Some(value) => value,
        .None => "127.0.0.1",
    };
    let port = match args.get(2) {
        .Some(value) => value,
        .None => "9100",
    };
    let config = NodeConfig { bind: "127.0.0.1:0", transport: NodeTransport.Tcp, key: "kv-client.key", cluster: os.env("HEW_NODE_CLUSTER") ?? "", seeds: [] };
    Node.start(config).expect("KV client node starts");
    println(f"[kv-client] public credential: {Node.identity_key()}");
    if (os.env("HEW_NODE_CLUSTER") ?? "").is_empty() {
        Node.shutdown();
        return 0;
    }
    let address = f"{host}:{port}";
    Node.connect(address).expect("connect to admitted KV server");
    let location = cluster.wait_registered("kv").expect("discover KV server");
    let peer = Node.peer(location.node_id()).expect("admitted KV server");
    let kv: KeyValue = peer.receive_service<KeyValue>().expect("receive KeyValue service");
    println("[kv-client] received the KeyValue service");
    let first = kv.put("hello", "world").expect("store first value completes");
    let second = kv.put("count", "42").expect("store second value completes");
    if first != "stored" || second != "stored" {
        println("[kv-client] FAIL: a put returned an unexpected result");
        Node.shutdown();
        return 1;
    }
    let hello = kv.get("hello").expect("read hello completes");
    if hello != "world" {
        println(f"[kv-client] FAIL: get('hello') returned '{hello}'");
        Node.shutdown();
        return 2;
    }
    println("[kv-client] PASS: get('hello') == 'world'");
    let count = kv.get("count").expect("read count completes");
    if count != "42" {
        println(f"[kv-client] FAIL: get('count') returned '{count}'");
        Node.shutdown();
        return 3;
    }
    println("[kv-client] PASS: get('count') == '42'");
    Node.shutdown();
    println("[kv-client] all assertions passed");
    0
}
