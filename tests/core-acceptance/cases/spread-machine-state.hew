//! A machine state literal takes the same `..base` spread as any record
//! literal: inside a transition the source state's fields are readable, so
//! `..state` carries the fields the literal does not name and the transition
//! only writes what actually changes.
//!
//! Harness verb: hew run

machine Till {
    events { Sale, Void, Close, }
    state Empty,
    state Filled { count: i64, label: string, },
    on Sale: Empty => Filled { count: 1, label: "open" }
    on Sale: Filled => Filled reenter { ..state, count: state.count + 1 }
    on Void: Filled => Filled reenter { ..state, label: "voided" }
    on Close: Filled => Empty,
    default { state }
}

fn show(till: Till) {
    match till {
        .Empty => println("empty"),
        .Filled { count, label } => println(f"{label}:{count}"),
    }
}

fn main() {
    var till = Till.Empty;
    show(till);
    let _ = till.step(.Sale);
    show(till);
    let _ = till.step(.Sale);
    let _ = till.step(.Sale);
    show(till);
    let _ = till.step(.Void);
    show(till);
    let _ = till.step(.Close);
    show(till);
}
