type Pair<A, B> { a: A, b: B, }

fn build(seed: string) -> i64 {
    let inner = Pair { a: seed + "-a", b: seed + "-b" };
    let p = Pair { a: inner, b: seed + "-c" };
    p.a.a.len() + p.a.b.len() + p.b.len()
}

fn main() -> i64 {
    var total: i64 = 0;
    for i in 0..64 {
        total = total + build("seed");
    }
    if total != 1152 { return 72; }
    0
}
