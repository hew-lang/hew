// Arguments: scalar|shared|managed|affine early|full|mixed SIZE (SIZE >= 2).
import std.os;

#[resource]
type Token {
    id: i64;
}

impl Token {
    fn close(consume self) {}
}

type Entry {
    label: string;
    id: i64;
}

fn main() {
    let args = os.args();
    assert(args.len() == 4);
    let kind = args[1];
    let mode = args[2];
    let n = args[3].to_int().expect("size");
    assert(n >= 2);
    assert(mode == "early" || mode == "full" || mode == "mixed");
    var sum = 0;
    if kind == "scalar" {
        var values: Vec<i64> = [];
        for i in 0..n {
            values.push(i);
        }
        var cursor = values.into_iter();
        if mode == "full" {
            while let .Some(x) = cursor.next() {
                sum += x;
            }
        }
        if mode == "mixed" {
            sum += cursor.next().expect("front");
            sum += cursor.next_back().expect("back");
        }
    } else if kind == "shared" {
        var values: Vec<i64> = [];
        for i in 0..n {
            values.push(i);
        }
        var cursor = values.iter();
        if mode == "full" {
            while let .Some(x) = cursor.next() {
                sum += x;
            }
        }
        if mode == "mixed" {
            sum += cursor.next().expect("front");
            sum += cursor.next_back().expect("back");
        }
        assert(values.len() == n && values[0] == 0 && values[n - 1] == n - 1);
    } else if kind == "managed" {
        var values: Vec<Entry> = [];
        for i in 0..n {
            values.push(Entry { label: f"item{i}", id: i });
        }
        var cursor = values.into_iter();
        if mode == "full" {
            while let .Some(x) = cursor.next() {
                sum += x.id;
            }
        }
        if mode == "mixed" {
            sum += cursor.next().expect("front").id;
            sum += cursor.next_back().expect("back").id;
        }
    } else {
        assert(kind == "affine");
        var values: Vec<Token> = [];
        for i in 0..n {
            values.push(Token { id: i });
        }
        var cursor = values.into_iter();
        if mode == "full" {
            while let .Some(x) = cursor.next() {
                sum += x.id;
                x.close();
            }
        }
        if mode == "mixed" {
            let a = cursor.next().expect("front");
            let b = cursor.next_back().expect("back");
            sum += a.id + b.id;
            a.close();
            b.close();
        }
    }
    println(sum);
}
