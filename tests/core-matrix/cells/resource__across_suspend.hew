#[resource]
type Tok {
    id: i64
}

impl Tok {
    fn close(self) {
        println(f"close {self.id}");
    }
}

actor Holder {
    var ready: bool,

    receive fn hold(v: Tok) -> i64 {
        sleep(2ms);
        let v_i = v.id;
        println(f"tok {v_i}");
        ready = true;
        1
    }
}

fn main() {
    let x = Tok { id: 1 };
    let h = spawn Holder(ready: false);
    match await h.hold(x) {
        Result.Ok(n) => println(f"held {n}"),
        Result.Err(_) => println("err"),
    }
}
