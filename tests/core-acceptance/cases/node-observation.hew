import std.net.cluster;
import std.os;

actor Service {
    receive fn ping() -> i64 {
        42
    }
    receive fn instance() -> Service {
        self
    }
}

supervisor ServiceRack {
    strategy: one_for_one;
    intensity: 3 within 60s;
    child service: Service;
}

fn check_named_role() {
    let rack = spawn ServiceRack;
    let role = rack.service;
    assert(Node.register("role", role) == 0);
    let occupant = role.instance().expect("direct occupant");
    assert(Node.register("occupant", occupant) == 0);
    let direct = Node.lookup("occupant").expect("direct location");
    let original = Node.lookup("role").expect("stable role location");
    assert(original != direct);
    assert(role.ping().expect("first worker") == 42);
    stop(role);
    restarted(role);
    assert(role.ping().expect("replacement worker") == 42);
    stopped(occupant);
    match Node.lookup("occupant") {
        .Err(.NotFound) => {}
        _ => panic("worker completion retained direct discovery"),
    }
    assert(Node.lookup("role").expect("role survives worker completion") == original);
    assert(Node.register("role-again", role) == 0);
    assert(Node.lookup("role-again").expect("same role") == original);
    stop(rack);
    stopped(rack);
    match Node.lookup("role") {
        .Err(.NotFound) => {}
        _ => panic("terminal supervisor retained role discovery"),
    }
    match Node.lookup("role-again") {
        .Err(.NotFound) => {}
        _ => panic("terminal supervisor retained role alias"),
    }
}

fn configured() -> NodeConfig {
    var config = NodeConfig.at("127.0.0.1:0");
    config.key = f"{os.temp_dir()}/hew-node-observation-{os.pid()}.key";
    config
}

fn publish(service: Service) {
    assert(Node.register("later", service) == 0);
}

fn main() {
    match cluster.snapshot() {
        .Err(.NotRunning) => {}
        _ => panic("snapshot without node"),
    }
    match cluster.watch() {
        .Err(.NotRunning) => {}
        _ => panic("watch without node"),
    }
    Node.start(configured()).expect("start");
    let observation = cluster.watch().expect("watch");
    let initial = observation.initial;
    assert(initial.local.id == Node.id().expect("running identity"));
    assert(initial.local.session > 0);
    assert(initial.members.len() == 1);
    assert(initial.registrations.is_empty());
    scope {
        let service = spawn Service;
        assert(Node.register("first", service) == 0);
        observation.changes.recv().expect("registration readiness");
        let current = observation.snapshot().expect("snapshot after recv");
        assert(current.registrations.len() == 1);
        assert(current.local_registrations().len() == 1);
        assert(current.registrations[0].name == "first");
        assert(current.registrations[0].location == Node.lookup("first").expect("lookup"));
        assert(cluster.wait_registered("first").expect("already registered") == current.registrations[0].location);
        scope {
            let publishing = fork publish(service);
            let location = cluster.wait_registered("later").expect("registration wait");
            assert(location == Node.lookup("later").expect("later lookup"));
            await publishing;
        };
        stop(service);
        stopped(service);
        assert(observation.snapshot().expect("retained handle withdrawal").registrations.is_empty());
        let predecessor = spawn Service;
        let replacement = spawn Service;
        assert(Node.register("repointed", predecessor) == 0);
        assert(Node.register("repointed", replacement) == 0);
        let repointed = Node.lookup("repointed").expect("replacement location");
        stop(predecessor);
        stopped(predecessor);
        let retained = observation.snapshot().expect("predecessor cleanup");
        assert(retained.registrations.len() == 1);
        assert(retained.registrations[0].location == repointed);
        assert(Node.lookup("repointed").expect("replacement survives") == repointed);
        stop(replacement);
        stopped(replacement);
        assert(observation.snapshot().expect("replacement cleanup").registrations.is_empty());
    };
    observation.changes.recv().expect("withdrawal readiness");
    assert(observation.snapshot().expect("withdrawal snapshot").registrations.is_empty());
    check_named_role();
    assert(observation.snapshot().expect("role terminal cleanup").registrations.is_empty());
    // Scope cancellation releases the suspended stream and its subscription.
    let cancelled = scope within 10ms {
        cluster.wait_registered("missing").expect("wait until cancelled");
        false
    } handle failure {
        match failure {
            .Deadline { message } => true,
            .Fault { message } => panic(message),
        }
    };
    assert(cancelled);
    Node.shutdown();
    observation.wait_shutdown();
    match observation.snapshot() {
        .Err(.NotRunning) => {}
        _ => panic("retired snapshot"),
    }
    Node.start(configured()).expect("restart");
    let restarted = cluster.snapshot().expect("successor snapshot");
    assert(restarted.local.id == initial.local.id);
    assert(restarted.local.session > initial.local.session);
    match observation.snapshot() {
        .Err(.NotRunning) => {}
        _ => panic("adopted successor"),
    }
    cluster.wait_departed(initial.local).expect("old session has departed");
    let successor = cluster.watch().expect("successor watch");
    Node.shutdown();
    successor.wait_shutdown();
}
