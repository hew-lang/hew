// Local-shadow trait-signature REJECT oracle (side-specific carve-out).
//
// `hew::closableerr` exports the trait `LocalShadowClosable` whose `close`
// returns `Result<(), LocalShadowError>` (the error type spelled bare inside
// the defining module, so the trait requires
// `closableerr.LocalShadowError`). This importer opts only the trait into scope
// and defines its OWN LOCAL `LocalShadowError` — a DISTINCT nominal type that
// merely shares the bare name.
//
// The impl returns the LOCAL `LocalShadowError` (bare).
// The signature comparison must REJECT this with `TraitImplSignatureMismatch`:
// the trait side's bare `LocalShadowError` qualifies to the trait owner, while
// the impl side's bare `LocalShadowError` shadows a local type and keeps its
// local identity. They are different types, so the wrong-module impl must NOT
// be accepted.
//
// This is the fail-open the side-specific carve-out closes: a SHARED
// local-shadow filter would also leave the TRAIT side's bare error name bare
// when the importer has a local declaration, conflating the two and falsely
// accepting the impl. The carve-out only preserves local shadows on the
// IMPL/actual side.
//
// Harness verb: hew check (negative — see run.sh).
import hew::closableerr::{LocalShadowClosable as ForeignClosable};

pub type ClosableHandle {
    id: i64;
}

// Local type shadowing the trait owner's sibling error type by bare name.
pub type LocalShadowError {
    detail: i64;
}

impl ForeignClosable for ClosableHandle {
    fn close(handle: ClosableHandle) -> Result<(), LocalShadowError> {
        Ok(())
    }
}

fn main() {
    let m = ClosableHandle { id: 1 };
    match m.close() {
        Ok(_) => println("ok"),
        Err(_) => println("err"),
    }
}
