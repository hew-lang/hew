import std.stream;

type Reader { input: Stream<string>, label: string }

fn open() -> Stream<string> {
    match stream.from_file("resource-read.bin") {
        .Ok(input) => input,
        .Err(_) => panic("fixture open failed"),
    }
}

fn early(leave: bool) -> i64 {
    let input = open();
    defer { input.close(); println("closed"); }
    if leave { return 7; }
    8
}

fn main() {
    println(early(true));
    println(early(false));
    {
        let reader = Reader { input: open(), label: "record".to_upper() };
        defer { println(reader.label); }
        defer { reader.input.close(); }
    }
    for _ in 0..3 {
        let input = open();
        defer { input.close(); }
    }
    println("released");
}
