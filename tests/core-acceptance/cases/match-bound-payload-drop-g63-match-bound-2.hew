fn make(n: i64) -> Option<string> {
    if n > 0 {
        .Some("g63-match-heap-payload".to_upper())
    } else {
        .None
    }
}

fn run() {
    let opt = make(1);
    match opt {
        .Some(s) => { if !s.is_empty() { print("m"); } }
        .None => { print("e"); }
    }
}

fn main() {
    run();
}
