//! Runtime coverage for cancellable actor work expressed as periodic receive
//! handlers.
//!
//! The worker checks a boolean flag on each `#[every]` tick. The `halt` receive
//! handler is a normal actor message, so it can interleave between ticks because
//! each tick returns control to the mailbox.

actor Worker {
    var running: bool = true,
    var ticks: i64 = 0,

    #[every(25ms)]
    receive fn tick() {
        if !running {
            return;
        }
        ticks += 1;
    }

    receive fn halt() {
        running = false;
    }

    receive fn total() -> i64 {
        ticks
    }
}

#[test]
fn halt_message_prevents_more_periodic_work() {
    let worker = spawn Worker(running: true, ticks: 0);
    sleep(250ms);
    let before = worker.total();
    let _ = worker.halt();
    sleep(150ms);
    let after = worker.total();
    sleep(150ms);
    let final = worker.total();
    match before {
        .Ok(n) => assert(n >= 2),
        .Err(_) => assert(false),
    }
    match after {
        .Ok(a) => match final {
            .Ok(f) => assert(a == f),
            .Err(_) => assert(false),
        },
        .Err(_) => assert(false),
    }
}
