#[opaque]
type DqH {
}

#[resource]
type Dq {
    handle: DqH;
    tag: i64;
}

impl Dq {
    fn close(self) {
        unsafe { hew_deque_free(self.handle) };
        println(f"close {self.tag}");
    }
}

extern "C" {
    fn hew_deque_new() -> DqH;
    fn hew_deque_free(dq: DqH);
    fn hew_deque_len(dq: DqH) -> i64;
}

fn main() {
    var x = Dq { handle: unsafe { hew_deque_new() }, tag: 1 };
    x = Dq { handle: unsafe { hew_deque_new() }, tag: 2 };
    let x_l = unsafe { hew_deque_len(x.handle) };
    let x_t = x.tag;
    println(f"dq {x_t} len={x_l}");
}
