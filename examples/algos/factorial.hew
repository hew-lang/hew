// Multiply the integers from 1 through n. A factorial may exceed i64.
fn factorial(n: i64) -> Option<i64> {
    if n < 0 {
        return .None;
    }
    var product: i64 = 1;
    for factor in 2..=n {
        product = product.checked_mul(factor)?;
    }
    .Some(product)
}

fn main() {
    for n in [0, 1, 5, 10, 20, 21] {
        match factorial(n) {
            .Some(product) => println(f"{n}! = {product}"),
            .None => println(f"{n}! cannot be represented as an i64"),
        }
    }
    assert(factorial(-1).is_none());
}
