// A program the strict SIR lane admits today: a closed graph of scalar
// direct calls with no owned values. It keeps `make sir-parity` from
// comparing nothing while the admitted set over the real corpora is small.
fn main() -> i64 {
    if twice(20) + increment(1) == 42 {
        0
    } else {
        1
    }
}

fn twice(value: i64) -> i64 {
    increment(value) + increment(value) - 2
}

fn increment(value: i64) -> i64 {
    value + 1
}
