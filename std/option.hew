//! Option methods.
//!
//! Every program sees these methods without an import, like `.len()`.

impl<T> Option<T> {
    /// Returns `true` if the option contains a value.
    pub fn is_some(self) -> bool {
        match self {
            .Some(_) => true,
            .None => false,
        }
    }
    /// Returns `true` if the option is `None`.
    pub fn is_none(self) -> bool {
        match self {
            .Some(_) => false,
            .None => true,
        }
    }
    /// Unwrap the value. Traps with `reason` if the option is `None`.
    pub fn expect(consume self, reason: string) -> T {
        match self {
            .Some(v) => v,
            .None => panic(reason),
        }
    }
    /// Apply `f` to the contained value, or return `None` unchanged.
    pub fn map<U>(consume self, f: fn(T) -> U) -> Option<U> {
        match self {
            .Some(v) => .Some(f(v)),
            .None => .None,
        }
    }
    /// Apply `f` (itself `Option`-returning) to the contained value, or
    /// return `None` unchanged. Chains a fallible lookup without nesting
    /// `Option<Option<U>>`.
    pub fn and_then<U>(consume self, f: fn(T) -> Option<U>) -> Option<U> {
        match self {
            .Some(v) => f(v),
            .None => .None,
        }
    }
    /// Return the option unchanged if it holds a value, otherwise the
    /// option computed by `f`.
    pub fn or_else(consume self, f: fn() -> Option<T>) -> Option<T> {
        match self {
            .Some(v) => .Some(v),
            .None => {
                f()
            }
        }
    }
    /// Convert to a `Result`, using `err` as the `Err` value when `None`.
    pub fn ok_or<E>(consume self, consume err: E) -> Result<T, E> {
        match self {
            .Some(v) => .Ok(v),
            .None => .Err(err),
        }
    }
    /// Move the value out of this place and leave `None` behind.
    pub fn take(var self) -> Option<T> {
        let taken = self;
        self = .None;
        taken
    }
}
