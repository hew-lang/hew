//! Shared types of the data codecs, and the `#[wire]` schema layer.
//!
//! The format modules encode and decode: `std.encoding.json`, `yaml`, `toml`,
//! `msgpack` and `cbor` each offer `encode(value)` and `decode<T>(document)`
//! over any data type. A decode that fails returns this module's
//! `DecodeError`, which names the path of the value that failed:
//!
//! ```
//! import std.encoding.json;
//!
//! type Config { name: string; retries: i64; }
//!
//! fn main() {
//!     println(json.encode(Config { name: "api", retries: 3 }));   // {"name":"api","retries":3}
//!     match json.decode<Config>("{\"name\":\"api\",\"retries\":\"x\"}") {
//!         .Ok(config) => println(config.name),
//!         .Err(e) => println(e),     // Type: .retries: expected integer, found string
//!     }
//! }
//! ```
//!
//! `#[wire]` on a record or enum gives it a stable schema for remote actors:
//! every field and variant carries a `@N` tag, assigned once and never
//! reused. A required `Option<T>` always emits its key and encodes `None` as
//! null; only `Option<T> @N optional` may omit the key for `None`. Check
//! schema compatibility between two versions with
//! `hew wire check <file.hew> --against <baseline.hew>`. See the `#[wire]`
//! section of `docs/hew-language-guide.md`.

/// Why a document did not decode as the requested type. Paths start at the
/// document root: `.field`, `[index]`, `["key"]`.
pub enum DecodeError {
    /// The input is not well-formed in its format. Text formats fill line and
    /// column; binary formats leave them `None`.
    Syntax { offset: i64; line: Option<i64>; column: Option<i64>; reason: string; }
    /// A value has the wrong kind for its target.
    Type { path: string; expected: string; found: string; }
    /// A required key is absent.
    Missing { path: string; }
    /// A number does not fit its target type.
    Range { path: string; value: string; target: string; }
    /// A variant name or tag matches no variant.
    UnknownVariant { path: string; name: string; }
    /// A map key or set element repeats.
    Duplicate { path: string; key: string; }
    /// A representation override refused its representation.
    Invalid { path: string; reason: string; }
}

fn at(path: string) -> string {
    if path.is_empty() {
        ""
    } else {
        f"{path}: "
    }
}

impl Display for DecodeError {
    fn fmt(self) -> string {
        match self {
            DecodeError.Syntax { offset, line, column, reason } => match (line, column) {
                (.Some(line), .Some(column)) => f"Syntax: line {line}, column {column}: {reason}",
                _ => f"Syntax: offset {offset}: {reason}",
            }
            DecodeError.Type { path, expected, found } => f"Type: {at(path)}expected {expected}, found {found}",
            DecodeError.Missing { path } => f"Missing: {path}",
            DecodeError.Range { path, value, target } => f"Range: {at(path)}{value} does not fit {target}",
            DecodeError.UnknownVariant { path, name } => f"UnknownVariant: {at(path)}no variant named {name}",
            DecodeError.Duplicate { path, key } => f"Duplicate: {at(path)}{key} repeats",
            DecodeError.Invalid { path, reason } => f"Invalid: {at(path)}{reason}",
        }
    }
}

impl Error for DecodeError {}
