// Discarded link()/monitor() calls lower to CallRuntimeAbi with dest=None.
//
// The local declarations take the actor's own name as its handle type while
// MIR's runtime-symbol bridge still routes the recognised names to
// hew_actor_link / hew_actor_mon
fn link(_a: Probe, _b: Probe) {}
fn monitor(_a: Probe, _b: Probe) {}

actor Probe {
    receive fn ping() {}
}

fn main() -> i64 {
    let p = spawn Probe();
    let q = spawn Probe();
    let r = spawn Probe();
    let s = spawn Probe();
    link(p, q);
    monitor(r, s);
    0
}
