//! Proofs for i64-facing stdlib numeric APIs.

import std.crypto.password;

import std.misc.log;

import std.testing;

#[test]
fn test_log_level_and_format_use_int_surface() {
    let original_level: i64 = log.get_level();
    let original_format: i64 = log.get_format();
    let level: i64 = 4;
    let format: i64 = 1;
    log.set_level(level);
    log.set_format(format);
    testing.assert_eq(log.get_level(), level);
    testing.assert_eq(log.get_format(), format);
    log.set_format(original_format);
    log.set_level(original_level);
}

#[test]
fn test_password_hash_custom_accepts_int_cost() {
    let cost: i64 = 2;
    let hash = match password.hash_custom("numeric-ergonomics", cost) {
        .Ok(h) => h,
        .Err(message) => panic(message),
    };
    let matches = match password.verify("numeric-ergonomics", hash.clone()) {
        .Ok(v) => v,
        .Err(message) => panic(message),
    };
    testing.assert_true(matches);
    let mismatches = match password.verify("numeric-ergonomics-miss", hash) {
        .Ok(v) => v,
        .Err(message) => panic(message),
    };
    testing.assert_false(mismatches);
}
