// Each loopback exchange must leave the single worker available to dispatch
// the peer task and an independent actor. Socket bytes, rather than host speed,
// prove that every readiness wait eventually resumes.
import std.net;

actor Probe {
    receive fn ping() -> bool { true }
}

fn echo(listener: net.Listener, probe: Probe) {
    let conn = listener.accept().expect("accept");
    loop {
        match conn.recv() {
            .Some(data) => {
                assert(probe.ping().expect("peer progress"));
                conn.send(data).expect("echo");
            }
            .None => break,
        }
    }
    conn.close();
}

fn main() {
    let listener = net.listen("127.0.0.1:0").expect("listen");
    let address = f"127.0.0.1:{listener.local_port()}";
    let probe = spawn Probe;
    scope {
        let server = fork echo(listener, probe);
        let client = net.connect(address).expect("connect");
        for round in 0..100 {
            let payload = f"round {round}".to_bytes();
            client.send(payload).expect("send");
            assert(client.recv().expect("echoed bytes") == payload);
        }
        client.close();
        await server;
    };
    stop(probe);
    stopped(probe);
    println("loopback readiness and actor progress");
}
