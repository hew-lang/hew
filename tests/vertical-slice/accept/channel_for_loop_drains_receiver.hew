// Accept + run: `for item in rx` drains the channel and closes the read half
// when the loop ends, so the program neither closes the receiver again nor
// leaks it.
import std.channel;

fn main() {
    let (tx, rx) = match channel.new(2) {
        .Ok(pair) => pair,
        .Err(_) => return,
    };
    tx.send("first");
    tx.send("second");
    tx.close();
    var seen = 0;
    for item in rx {
        println(item);
        seen = seen + 1;
    }
    println(f"drained {seen}");
}
