//! Status: runnable
//! Description: Static Content Web Server in Hew

// Static Content Web Server in Hew
//
// A blocking HTTP server: the accept loop serves each request with proper MIME
// types.
//
// Usage: hew build static_server.hew -o serve && ./serve [port] [root]
// Defaults: port 8080, root "."
import std.net.http.{Request, Server};

import std.fs;

import std.os;

import std.net.mime;

import std.net;

fn resolve_path(root: string, url_path: string) -> string {
    let path = root + url_path;
    if url_path.ends_with("/") {
        return path + "index.html";
    }
    // Bare directory -> try index.html inside it
    if !fs.exists(path) {
        let index = path + "/index.html";
        if fs.exists(index) {
            return index;
        }
    }
    path
}

fn serve_forever(root: string, server: Server) {
    // Accept loop: serve each request.
    loop {
        let req = server.accept();
        serve_request(root, req);
    }
}

fn serve_request(root: string, req: Request) {
    let request_path = req.path();
    if request_path.contains("..") {
        match req.respond_text(403, "403 Forbidden") {
            .Ok(_) => {},
            .Err(_) => panic("failed to send forbidden response"),
        }
    } else {
        let file_path = resolve_path(root, request_path);
        if fs.exists(file_path) {
            let body = match fs.read(file_path) {
                .Ok(body) => body,
                .Err(_) => panic("failed to read requested file"),
            };
            let content_type = mime.from_path(file_path);
            match req.respond(200, content_type, body) {
                .Ok(_) => {},
                .Err(_) => panic("failed to send file response"),
            }
        } else {
            match req.respond_text(404, "404 Not Found") {
                .Ok(_) => {},
                .Err(_) => panic("failed to send not-found response"),
            }
        }
    }
    req.close();
}

fn main() {
    var port = "8080";
    var root = ".";
    let arguments = os.args();
    let argc = arguments.len();
    if argc > 1 {
        if let .Some(value) = arguments.get(1) {
            port = value;
        }
    }
    if argc > 2 {
        if let .Some(value) = arguments.get(2) {
            root = value;
        }
    }
    let addr = f"0.0.0.0:{port}";
    println(f"Serving {root} on http://{addr}");
    match http.listen(addr) {
        .Ok(server) => {
            serve_forever(root, server);
        },
        .Err(_) => {
            let detail = http.listen_error();
            println(f"cannot listen on {addr}: {detail}");
        },
    }
}
