//! Regression coverage for compiler-derived structural clone.

import std.testing;

type Pair {
    number: i64,
    label: string,
}

#[test]
fn builtin_aggregates_clone_member_wise() {
    let option: Option<(i64, string)> = Some((7, "seven"));
    let option_copy = clone option;
    let result: Result<i64, string> = Err("failure");
    let result_copy = clone result;
    let pair = Pair { number: 9, label: "nine" };
    let pair_copy = clone pair;
    testing.assert_true(option == option_copy);
    testing.assert_true(result == result_copy);
    testing.assert_true(pair == pair_copy);
}

#[test]
fn tuple_clone_owns_nested_collections_independently() {
    let original: (Vec<i64>, string) = (Vec.new(), "left");
    original.0.push(1);
    let copy = clone original;
    copy.0.push(2);
    testing.assert_true(original.0.len() == 1);
    testing.assert_true(copy.0.len() == 2);
}

/// A type parameter's clone capability inside a generic template comes from its
/// declared bound; the concrete capability is decided at instantiation.
fn clone_option<T: Clone>(value: Option<T>) -> Option<T> {
    clone value
}

#[test]
fn bounded_generic_clone_is_admitted_and_instantiates() {
    let original: Option<i64> = Some(3);
    let copied = clone_option(original);
    testing.assert_true(copied == Some(3));
}
