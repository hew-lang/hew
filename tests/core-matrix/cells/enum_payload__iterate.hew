enum Shape {
    Empty;
    Circle(i64);
    Rect { w: i64; h: i64 }
}

fn main() {
    let a: Shape = Circle(3);
    let b: Shape = Circle(4);
    let v: Vec<Shape> = Vec.new();
    v.push(a);
    v.push(b);
    for e in v {
        match e {
            Empty => println("empty"),
            Circle(e_r) => println(f"circle {e_r}"),
            Rect { w, h } => println(f"rect {w}x{h}"),
        }
    }
}
