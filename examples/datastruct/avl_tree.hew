// AVL Tree using Vec<i64> with index-based pointers
// Each node: [value, left, right, height] = 4 slots
// NIL = -1 means no child
//
// A parameter is the callee's own copy, so every helper that writes into the
// node pool returns it and the caller reassigns. Allocation and the rotations
// also report an index, so they return a tuple.
fn node_val(nodes: Vec<i64>, i: i64) -> i64 {
    nodes[i * 4]
}

fn node_left(nodes: Vec<i64>, i: i64) -> i64 {
    nodes[i * 4 + 1]
}

fn node_right(nodes: Vec<i64>, i: i64) -> i64 {
    nodes[i * 4 + 2]
}

fn node_height(nodes: Vec<i64>, i: i64) -> i64 {
    nodes[i * 4 + 3]
}

fn set_left(var nodes: Vec<i64>, i: i64, v: i64) -> Vec<i64> {
    nodes.set(i * 4 + 1, v);
    nodes
}

fn set_right(var nodes: Vec<i64>, i: i64, v: i64) -> Vec<i64> {
    nodes.set(i * 4 + 2, v);
    nodes
}

fn set_height(var nodes: Vec<i64>, i: i64, v: i64) -> Vec<i64> {
    nodes.set(i * 4 + 3, v);
    nodes
}

fn add_node(var nodes: Vec<i64>, val: i64, NIL: i64) -> (Vec<i64>, i64) {
    let idx = nodes.len() / 4;
    nodes.push(val);
    nodes.push(NIL);
    nodes.push(NIL);
    nodes.push(1);
    (nodes, idx)
}

fn get_height(nodes: Vec<i64>, i: i64, NIL: i64) -> i64 {
    if i == NIL {
        0
    } else {
        node_height(nodes, i)
    }
}

fn max_val(a: i64, b: i64) -> i64 {
    if a > b {
        a
    } else {
        b
    }
}

fn update_height(var nodes: Vec<i64>, i: i64, NIL: i64) -> Vec<i64> {
    let lh = get_height(nodes, node_left(nodes, i), NIL);
    let rh = get_height(nodes, node_right(nodes, i), NIL);
    set_height(nodes, i, max_val(lh, rh) + 1)
}

fn balance_factor(nodes: Vec<i64>, i: i64, NIL: i64) -> i64 {
    let lh = get_height(nodes, node_left(nodes, i), NIL);
    let rh = get_height(nodes, node_right(nodes, i), NIL);
    lh - rh
}

// Right rotate: y is root, x = y.left, T2 = x.right
// After: x is root, y is x.right, T2 is y.left
fn right_rotate(var nodes: Vec<i64>, y: i64, NIL: i64) -> (Vec<i64>, i64) {
    let x = node_left(nodes, y);
    let t2 = node_right(nodes, x);
    nodes = set_right(nodes, x, y);
    nodes = set_left(nodes, y, t2);
    nodes = update_height(nodes, y, NIL);
    nodes = update_height(nodes, x, NIL);
    (nodes, x)
}

// Left rotate: x is root, y = x.right, T2 = y.left
fn left_rotate(var nodes: Vec<i64>, x: i64, NIL: i64) -> (Vec<i64>, i64) {
    let y = node_right(nodes, x);
    let t2 = node_left(nodes, y);
    nodes = set_left(nodes, y, x);
    nodes = set_right(nodes, x, t2);
    nodes = update_height(nodes, x, NIL);
    nodes = update_height(nodes, y, NIL);
    (nodes, y)
}

// Insert into AVL tree, returns the node pool and the new root index
fn avl_insert(var nodes: Vec<i64>, root: i64, val: i64, NIL: i64) -> (Vec<i64>, i64) {
    if root == NIL {
        return add_node(nodes, val, NIL);
    }
    // Track path from root to insertion point
    var path: Vec<i64> = Vec.new();
    var dirs: Vec<i64> = Vec.new(); // 0=left, 1=right
    var cur = root;
    var placed = false;
    while !placed {
        let cur_val = node_val(nodes, cur);
        if val < cur_val {
            let left = node_left(nodes, cur);
            if left == NIL {
                let (grown, new_idx) = add_node(nodes, val, NIL);
                nodes = set_left(grown, cur, new_idx);
                path.push(cur);
                dirs.push(0);
                placed = true;
            } else {
                path.push(cur);
                dirs.push(0);
                cur = left;
            }
        } else {
            let right = node_right(nodes, cur);
            if right == NIL {
                let (grown, new_idx) = add_node(nodes, val, NIL);
                nodes = set_right(grown, cur, new_idx);
                path.push(cur);
                dirs.push(1);
                placed = true;
            } else {
                path.push(cur);
                dirs.push(1);
                cur = right;
            }
        }
    }
    // Rebalance from bottom to top
    var new_root = root;
    while !path.is_empty() {
        let node = path.pop();
        let _ = dirs.pop(); // direction from node to its child (discard)
        nodes = update_height(nodes, node, NIL);
        let bf = balance_factor(nodes, node, NIL);
        var new_subtree_root = node;
        if bf > 1 {
            let left = node_left(nodes, node);
            if val >= node_val(nodes, left) {
                // Left-right: rotate the left child left first
                let (lifted, lifted_root) = left_rotate(nodes, left, NIL);
                nodes = set_left(lifted, node, lifted_root);
            }
            let (rotated, rotated_root) = right_rotate(nodes, node, NIL);
            nodes = rotated;
            new_subtree_root = rotated_root;
        } else if bf < 0 - 1 {
            let right = node_right(nodes, node);
            if val <= node_val(nodes, right) {
                // Right-left: rotate the right child right first
                let (lowered, lowered_root) = right_rotate(nodes, right, NIL);
                nodes = set_right(lowered, node, lowered_root);
            }
            let (rotated, rotated_root) = left_rotate(nodes, node, NIL);
            nodes = rotated;
            new_subtree_root = rotated_root;
        }
        // Update parent's pointer to this subtree
        if path.is_empty() {
            new_root = new_subtree_root;
        } else {
            let parent = path[path.len() - 1];
            let dir = dirs[dirs.len() - 1];
            if dir == 0 {
                nodes = set_left(nodes, parent, new_subtree_root);
            } else {
                nodes = set_right(nodes, parent, new_subtree_root);
            }
        }
    }
    (nodes, new_root)
}

// Build a tree by inserting vals in order; returns the pool and the root.
fn build_avl(vals: Vec<i64>, NIL: i64) -> (Vec<i64>, i64) {
    var nodes: Vec<i64> = Vec.new();
    var root = NIL;
    for val in vals {
        let (grown, new_root) = avl_insert(nodes, root, val, NIL);
        nodes = grown;
        root = new_root;
    }
    (nodes, root)
}

fn inorder(nodes: Vec<i64>, root: i64, NIL: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec.new();
    if root == NIL {
        return result;
    }
    var stack: Vec<i64> = Vec.new();
    var cur = root;
    var running = true;
    while running {
        while cur != NIL {
            stack.push(cur);
            cur = node_left(nodes, cur);
        }
        if stack.is_empty() {
            running = false;
        } else {
            cur = stack.pop();
            result.push(node_val(nodes, cur));
            cur = node_right(nodes, cur);
        }
    }
    result
}

fn is_sorted(v: Vec<i64>) -> bool {
    if v.len() <= 1 {
        return true;
    }
    var i = 1;
    while i < v.len() {
        if v[i] <= v[i - 1] {
            return false;
        }
        i = i + 1;
    }
    true
}

// Verify AVL height invariant for all nodes
fn check_avl(nodes: Vec<i64>, root: i64, NIL: i64) -> bool {
    if root == NIL {
        return true;
    }
    var stack: Vec<i64> = Vec.new();
    stack.push(root);
    var ok = true;
    while !stack.is_empty() {
        let cur = stack.pop();
        let bf = balance_factor(nodes, cur, NIL);
        if bf > 1 {
            ok = false;
        }
        if bf < 0 - 1 {
            ok = false;
        }
        let l = node_left(nodes, cur);
        if l != NIL {
            stack.push(l);
        }
        let r = node_right(nodes, cur);
        if r != NIL {
            stack.push(r);
        }
    }
    ok
}

fn test_basic_insert() -> i64 {
    let NIL = 0 - 1;
    let (nodes, root) = build_avl([5, 3, 7, 1, 4, 6, 8], NIL);
    let result = inorder(nodes, root, NIL);
    if is_sorted(result) {
        if result.len() == 7 {
            println("PASS: AVL basic insert + inorder sorted");
            return 1;
        }
    }
    println("FAIL: AVL basic insert");
    0
}

fn test_left_left() -> i64 {
    let NIL = 0 - 1;
    let (nodes, root) = build_avl([30, 20, 10], NIL);
    let balanced = check_avl(nodes, root, NIL);
    let result = inorder(nodes, root, NIL);
    if balanced {
        if is_sorted(result) {
            if result.len() == 3 {
                println("PASS: AVL LL rotation");
                return 1;
            }
        }
    }
    println("FAIL: AVL LL rotation");
    0
}

fn test_right_right() -> i64 {
    let NIL = 0 - 1;
    let (nodes, root) = build_avl([10, 20, 30], NIL);
    let balanced = check_avl(nodes, root, NIL);
    let result = inorder(nodes, root, NIL);
    if balanced {
        if is_sorted(result) {
            if result.len() == 3 {
                println("PASS: AVL RR rotation");
                return 1;
            }
        }
    }
    println("FAIL: AVL RR rotation");
    0
}

fn test_left_right() -> i64 {
    let NIL = 0 - 1;
    let (nodes, root) = build_avl([30, 10, 20], NIL);
    let balanced = check_avl(nodes, root, NIL);
    let result = inorder(nodes, root, NIL);
    if balanced {
        if is_sorted(result) {
            if result.len() == 3 {
                println("PASS: AVL LR rotation");
                return 1;
            }
        }
    }
    println("FAIL: AVL LR rotation");
    0
}

fn test_many_inserts() -> i64 {
    let NIL = 0 - 1;
    var vals: Vec<i64> = Vec.new();
    for i in 1 .. 21 {
        vals.push(i);
    }
    let (nodes, root) = build_avl(vals, NIL);
    let balanced = check_avl(nodes, root, NIL);
    let result = inorder(nodes, root, NIL);
    let h = node_height(nodes, root);
    if balanced {
        if is_sorted(result) {
            if result.len() == 20 {
                // Height should be O(log n), at most ~6 for 20 nodes
                if h <= 6 {
                    println("PASS: AVL 20 sequential inserts balanced");
                    return 1;
                }
            }
        }
    }
    print("FAIL: AVL many inserts, balanced=");
    print(balanced);
    print(" len=");
    print(result.len());
    print(" h=");
    println(h);
    0
}

fn main() {
    println("=== AVL Tree ===");
    var passed = 0;
    let total = 5;
    passed = passed + test_basic_insert();
    passed = passed + test_left_left();
    passed = passed + test_right_right();
    passed = passed + test_left_right();
    passed = passed + test_many_inserts();
    println("");
    print(passed);
    print("/");
    print(total);
    println(" tests passed");
    if passed == total {
        println("PASS");
    } else {
        println("FAIL");
    }
}
