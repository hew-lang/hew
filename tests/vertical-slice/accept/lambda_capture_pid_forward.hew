// A lambda actor captures an ordinary actor value and forwards calls to it.
// The captured descriptor must survive both dispatches and be released with
// the environment. Both completions precede the total reply, which is 42.
actor Counter {
    var count: i64;

    receive fn increment(n: i64) {
        count = count + n;
    }

    receive fn total() -> i64 {
        count
    }
}

fn main() -> i64 {
    let counter = spawn Counter { count: 0 };
    let forward = actor |by: i64| {
        let _ = counter.increment(by);
    };
    let _ = forward(10);
    let _ = forward(32);
    match counter.total() {
        .Ok(v) => v,
        .Err(_e) => 0,
    }
}
