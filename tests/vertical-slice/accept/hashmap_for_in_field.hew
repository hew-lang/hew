// Direct iteration over a record field preserves the source map type.

type MapBox {
    m: HashMap<i64, i64>;
}

fn make_map_box() -> MapBox {
    var m: HashMap<i64, i64> = HashMap.new();
    m.insert(1, 10);
    m.insert(2, 20);
    m.insert(3, 30);
    MapBox { m: m }
}

pub fn main() -> i64 {
    let b = make_map_box();
    var total = 0;
    var count = 0;
    for (k, v) in b.m {
        total = total + k + v;
        count = count + 1;
    }
    if count != 3 {
        return 100 + count;
    }
    // The field must still be usable after the loop (shared, not consumed).
    if b.m.len() != 3 {
        return 99;
    }
    total
}
