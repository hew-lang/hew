// `init` and an `#[on(start)]` hook reach the same actor method a handler
// does, including when the method writes the actor's state (#3285).
actor Greeter {
    var greeting: string = "",
    var greeted: i64 = 0,

    init(prefix: string) {
        greeting = prefix;
        remember();
    }

    #[on(start)]
    fn started() {
        remember();
    }

    fn remember() {
        greeted = greeted + 1;
    }

    fn shout(name: string) -> string {
        greeting + name
    }

    receive fn greet(name: string) {
        remember();
        println(shout(name));
        println(greeted);
    }
}

fn main() {
    let g = spawn Greeter(prefix: "hello ");
    g.greet("world");
}
