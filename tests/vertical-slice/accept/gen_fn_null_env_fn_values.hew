// Accept: a generator's `fn[clone](..)` parameter admits both null-env `fn(..)`
// value shapes - a named-function reference and a capture-free closure.
// A generator frame owns its captures, so the parameter type has to carry a
// copy operation: `fn[clone]` does, a bare written `fn` does not
// (see reject/gen_fn_borrowed_fn_param.hew for the refusal and its remedies).
gen fn mapped(n: i64, f: fn[clone](i64) -> i64) -> i64 {
    var i = 0;
    while i < n {
        yield f(i);
        i = i + 1;
    }
}

fn triple(x: i64) -> i64 {
    x * 3
}

fn main() {
    var named_total = 0;
    for v in mapped(3, triple) {
        named_total = named_total + v;
    }
    // 0*3 + 1*3 + 2*3
    println(named_total);
    var closure_total = 0;
    for v in mapped(3, |x: i64| x * 4) {
        closure_total = closure_total + v;
    }
    // 0*4 + 1*4 + 2*4
    println(closure_total);
}
