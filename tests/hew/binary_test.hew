//! Behavioural tests for std::encoding::binary.
//!
//! Covers:
//!   - Known byte-pattern assertions (LE and BE, each width).
//!   - Roundtrip (put then get) for every put/get pair.
//!   - Signed-integer sign extension (negative values, min/max).
//!   - Edge cases: zero, max unsigned value for each width.
//!
//! Note: `bytes` is a by-value type on this branch — `put_*` returns
//! a fresh buffer rather than mutating a caller-owned buffer.

import std.encoding.binary;

// ── u16 little-endian — known pattern ────────────────────────────────
#[test]
fn test_put_u16_le_known_pattern() {
    // 0x0102 in LE → [0x02, 0x01]
    let buf = binary.put_u16_le(0x102);
    assert(buf.len() == 2);
    assert((buf[0] as i64) == 0x2);
    assert((buf[1] as i64) == 0x1);
}

#[test]
fn test_get_u16_le_known_pattern() {
    let buf = binary.put_u16_le(0x102);
    assert(binary.get_u16_le(buf) == 0x102);
}

#[test]
fn test_roundtrip_u16_le() {
    let buf = binary.put_u16_le(0xABCD);
    assert(binary.get_u16_le(buf) == 0xABCD);
}

// ── u16 big-endian — known pattern ───────────────────────────────────
#[test]
fn test_put_u16_be_known_pattern() {
    // 0x0102 in BE → [0x01, 0x02]
    let buf = binary.put_u16_be(0x102);
    assert(buf.len() == 2);
    assert((buf[0] as i64) == 0x1);
    assert((buf[1] as i64) == 0x2);
}

#[test]
fn test_get_u16_be_known_pattern() {
    let buf = binary.put_u16_be(0x102);
    assert(binary.get_u16_be(buf) == 0x102);
}

#[test]
fn test_roundtrip_u16_be() {
    let buf = binary.put_u16_be(0xABCD);
    assert(binary.get_u16_be(buf) == 0xABCD);
}

// ── u32 little-endian — known pattern ────────────────────────────────
#[test]
fn test_put_u32_le_known_pattern() {
    // 0x01020304 in LE → [0x04, 0x03, 0x02, 0x01]
    let buf = binary.put_u32_le(0x1020304);
    assert(buf.len() == 4);
    assert((buf[0] as i64) == 0x4);
    assert((buf[1] as i64) == 0x3);
    assert((buf[2] as i64) == 0x2);
    assert((buf[3] as i64) == 0x1);
}

#[test]
fn test_get_u32_le_known_pattern() {
    let buf = binary.put_u32_le(0x1020304);
    assert(binary.get_u32_le(buf) == 0x1020304);
}

#[test]
fn test_roundtrip_u32_le() {
    let buf = binary.put_u32_le(0xDEADBEEF);
    assert(binary.get_u32_le(buf) == 0xDEADBEEF);
}

// ── u32 big-endian — known pattern ───────────────────────────────────
#[test]
fn test_put_u32_be_known_pattern() {
    // 0x01020304 in BE → [0x01, 0x02, 0x03, 0x04]
    let buf = binary.put_u32_be(0x1020304);
    assert(buf.len() == 4);
    assert((buf[0] as i64) == 0x1);
    assert((buf[1] as i64) == 0x2);
    assert((buf[2] as i64) == 0x3);
    assert((buf[3] as i64) == 0x4);
}

#[test]
fn test_get_u32_be_known_pattern() {
    let buf = binary.put_u32_be(0x1020304);
    assert(binary.get_u32_be(buf) == 0x1020304);
}

#[test]
fn test_roundtrip_u32_be() {
    let buf = binary.put_u32_be(0xDEADBEEF);
    assert(binary.get_u32_be(buf) == 0xDEADBEEF);
}

// ── u64 little-endian — known pattern ────────────────────────────────
#[test]
fn test_put_u64_le_known_pattern() {
    // 0x0102030405060708 in LE → [0x08, ..., 0x01]
    let buf = binary.put_u64_le(0x102030405060708);
    assert(buf.len() == 8);
    assert((buf[0] as i64) == 0x8);
    assert((buf[1] as i64) == 0x7);
    assert((buf[6] as i64) == 0x2);
    assert((buf[7] as i64) == 0x1);
}

#[test]
fn test_get_u64_le_known_pattern() {
    let buf = binary.put_u64_le(0x102030405060708);
    assert(binary.get_u64_le(buf) == 0x102030405060708);
}

#[test]
fn test_roundtrip_u64_le() {
    let buf = binary.put_u64_le(0x102030405060708);
    assert(binary.get_u64_le(buf) == 0x102030405060708);
}

// ── u64 big-endian — known pattern ───────────────────────────────────
#[test]
fn test_put_u64_be_known_pattern() {
    // 0x0102030405060708 in BE → [0x01, ..., 0x08]
    let buf = binary.put_u64_be(0x102030405060708);
    assert(buf.len() == 8);
    assert((buf[0] as i64) == 0x1);
    assert((buf[1] as i64) == 0x2);
    assert((buf[6] as i64) == 0x7);
    assert((buf[7] as i64) == 0x8);
}

#[test]
fn test_get_u64_be_known_pattern() {
    let buf = binary.put_u64_be(0x102030405060708);
    assert(binary.get_u64_be(buf) == 0x102030405060708);
}

#[test]
fn test_roundtrip_u64_be() {
    let buf = binary.put_u64_be(0x102030405060708);
    assert(binary.get_u64_be(buf) == 0x102030405060708);
}

// ── Edge case: zero ───────────────────────────────────────────────────
#[test]
fn test_put_u16_le_zero() {
    let buf = binary.put_u16_le(0);
    assert(buf.len() == 2);
    assert((buf[0] as i64) == 0);
    assert((buf[1] as i64) == 0);
    assert(binary.get_u16_le(buf) == 0);
}

#[test]
fn test_put_u32_le_zero() {
    let buf = binary.put_u32_le(0);
    assert(buf.len() == 4);
    assert((buf[0] as i64) == 0);
    assert((buf[3] as i64) == 0);
    assert(binary.get_u32_le(buf) == 0);
}

#[test]
fn test_put_u64_le_zero() {
    let buf = binary.put_u64_le(0);
    assert(buf.len() == 8);
    assert((buf[0] as i64) == 0);
    assert((buf[7] as i64) == 0);
    assert(binary.get_u64_le(buf) == 0);
}

// ── Edge case: max unsigned values ───────────────────────────────────
#[test]
fn test_put_u16_le_max() {
    // 0xFFFF → [0xFF, 0xFF]
    let buf = binary.put_u16_le(0xFFFF);
    assert((buf[0] as i64) == 0xFF);
    assert((buf[1] as i64) == 0xFF);
    assert(binary.get_u16_le(buf) == 0xFFFF);
}

#[test]
fn test_put_u32_le_max() {
    // 0xFFFFFFFF → [0xFF, 0xFF, 0xFF, 0xFF]
    let buf = binary.put_u32_le(0xFFFFFFFF);
    assert((buf[0] as i64) == 0xFF);
    assert((buf[3] as i64) == 0xFF);
    assert(binary.get_u32_le(buf) == 0xFFFFFFFF);
}

#[test]
fn test_put_u64_le_max_i64() {
    // i64::MAX = 0x7FFFFFFFFFFFFFFF
    let v: i64 = 9223372036854775807;
    let buf = binary.put_u64_le(v);
    assert(binary.get_u64_le(buf) == v);
}

// ── Signed integers: negative values ─────────────────────────────────
#[test]
fn test_put_i16_le_minus_one() {
    // -1 in i16 → all bits set → [0xFF, 0xFF]
    let buf = binary.put_i16_le(-1);
    assert((buf[0] as i64) == 0xFF);
    assert((buf[1] as i64) == 0xFF);
    assert(binary.get_i16_le(buf) == -1);
}

#[test]
fn test_put_i32_le_minus_one() {
    // -1 in i32 → [0xFF, 0xFF, 0xFF, 0xFF]
    let buf = binary.put_i32_le(-1);
    assert((buf[0] as i64) == 0xFF);
    assert((buf[3] as i64) == 0xFF);
    assert(binary.get_i32_le(buf) == -1);
}

#[test]
fn test_put_i64_le_minus_one() {
    // -1 in i64 → 8 bytes of 0xFF
    let buf = binary.put_i64_le(-1);
    assert(buf.len() == 8);
    assert((buf[0] as i64) == 0xFF);
    assert((buf[7] as i64) == 0xFF);
    assert(binary.get_i64_le(buf) == -1);
}

#[test]
fn test_roundtrip_i16_le_negative() {
    let buf = binary.put_i16_le(-1000);
    assert(binary.get_i16_le(buf) == -1000);
}

#[test]
fn test_roundtrip_i32_le_negative() {
    let buf = binary.put_i32_le(-1000000);
    assert(binary.get_i32_le(buf) == -1000000);
}

#[test]
fn test_roundtrip_i64_le_negative() {
    let buf = binary.put_i64_le(-1000000000000);
    assert(binary.get_i64_le(buf) == -1000000000000);
}

#[test]
fn test_put_i16_be_minus_one() {
    // -1 in i16 BE → [0xFF, 0xFF]
    let buf = binary.put_i16_be(-1);
    assert((buf[0] as i64) == 0xFF);
    assert((buf[1] as i64) == 0xFF);
    assert(binary.get_i16_be(buf) == -1);
}

#[test]
fn test_put_i32_be_minus_one() {
    let buf = binary.put_i32_be(-1);
    assert((buf[0] as i64) == 0xFF);
    assert((buf[3] as i64) == 0xFF);
    assert(binary.get_i32_be(buf) == -1);
}

#[test]
fn test_put_i64_be_minus_one() {
    let buf = binary.put_i64_be(-1);
    assert(buf.len() == 8);
    assert((buf[0] as i64) == 0xFF);
    assert((buf[7] as i64) == 0xFF);
    assert(binary.get_i64_be(buf) == -1);
}

// ── i16 boundary: min and max ─────────────────────────────────────────
#[test]
fn test_i16_le_min_value() {
    // i16 min = -32768 → [0x00, 0x80] in LE
    let buf = binary.put_i16_le(-32768);
    assert((buf[0] as i64) == 0x0);
    assert((buf[1] as i64) == 0x80);
    assert(binary.get_i16_le(buf) == -32768);
}

#[test]
fn test_i16_le_max_value() {
    // i16 max = 32767 → [0xFF, 0x7F] in LE
    let buf = binary.put_i16_le(32767);
    assert((buf[0] as i64) == 0xFF);
    assert((buf[1] as i64) == 0x7F);
    assert(binary.get_i16_le(buf) == 32767);
}

#[test]
fn test_i16_be_min_value() {
    // i16 min = -32768 → [0x80, 0x00] in BE
    let buf = binary.put_i16_be(-32768);
    assert((buf[0] as i64) == 0x80);
    assert((buf[1] as i64) == 0x0);
    assert(binary.get_i16_be(buf) == -32768);
}

// ── i32 boundary: min and max ─────────────────────────────────────────
#[test]
fn test_i32_le_min_value() {
    // i32 min = -2147483648 → [0x00, 0x00, 0x00, 0x80] in LE
    let buf = binary.put_i32_le(-2147483648);
    assert((buf[0] as i64) == 0x0);
    assert((buf[1] as i64) == 0x0);
    assert((buf[2] as i64) == 0x0);
    assert((buf[3] as i64) == 0x80);
    assert(binary.get_i32_le(buf) == -2147483648);
}

#[test]
fn test_i32_le_max_value() {
    // i32 max = 2147483647 → [0xFF, 0xFF, 0xFF, 0x7F] in LE
    let buf = binary.put_i32_le(2147483647);
    assert((buf[0] as i64) == 0xFF);
    assert((buf[1] as i64) == 0xFF);
    assert((buf[2] as i64) == 0xFF);
    assert((buf[3] as i64) == 0x7F);
    assert(binary.get_i32_le(buf) == 2147483647);
}

// ── BE vs LE byte order contrast ─────────────────────────────────────
#[test]
fn test_le_and_be_produce_distinct_byte_patterns() {

    // Same value, different byte orders — index 0 must differ.
    let buf_le = binary.put_u32_le(0x1020304);
    let buf_be = binary.put_u32_be(0x1020304);
    // LE[0] = 0x04, BE[0] = 0x01
    assert((buf_le[0] as i64) != (buf_be[0] as i64));
}

// ── Checked reads and writes ─────────────────────────────────────────
fn hex_bytes(values: Vec<i64>) -> bytes {
    var b = bytes.new();
    for v in values {
        b.push(v as u8);
    }
    b
}

#[test]
fn test_checked_uint_every_width_round_trips() {
    for width in 0..9 {
        let value = if width == 8 {
            -2
        } else if width == 0 {
            0
        } else {
            (1 << (8 * width - 1)) + 3
        };
        let le = binary.put_uint_le(value, width).expect("fits");
        let be = binary.put_uint_be(value, width).expect("fits");
        assert(le.len() == width);
        assert(be.len() == width);
        assert(binary.read_uint_le(le, 0, width).expect("in range") == value);
        assert(binary.read_uint_be(be, 0, width).expect("in range") == value);
        for k in 0..width {
            assert(le[k] == be[width - 1 - k]);
        }
    }
}

#[test]
fn test_checked_uint_known_patterns() {
    let data = hex_bytes([0x01, 0x02, 0x03, 0xFF, 0x80]);
    assert(binary.read_uint_le(data, 0, 3).expect("le") == 0x030201);
    assert(binary.read_uint_be(data, 0, 3).expect("be") == 0x010203);
    assert(binary.read_uint_be(data, 3, 2).expect("tail") == 0xFF80);
    assert(binary.read_int_be(data, 3, 2).expect("signed") == -128);
    assert(binary.read_int_le(data, 4, 1).expect("byte") == -128);
    assert(binary.read_int_le(data, 0, 0).expect("empty") == 0);
    assert(binary.put_uint_be(0xC000, 2).expect("PINGREQ") == hex_bytes([0xC0, 0x00]));
}

#[test]
fn test_checked_read_out_of_range() {
    let data = hex_bytes([1, 2, 3]);
    match binary.read_uint_le(data, -1, 1) {
        .Err(binary.BinaryError.OutOfRange(at, width, available)) => assert(at == -1 && width == 1 && available == 3),
        _ => panic("negative offset must be OutOfRange"),
    }
    match binary.read_uint_be(data, 3, 1) {
        .Err(binary.BinaryError.OutOfRange(at, width, available)) => assert(at == 3 && width == 1 && available == 3),
        _ => panic("offset at the end must be OutOfRange"),
    }
    assert(binary.read_uint_be(data, 3, 0).expect("empty field at the end") == 0);
    match binary.read_uint_le(data, 2, 2) {
        .Err(binary.BinaryError.OutOfRange(at, width, available)) => assert(at == 2 && width == 2 && available == 3),
        _ => panic("short tail must be OutOfRange"),
    }
    match binary.read_uint_le(data, 0, 9) {
        .Err(binary.BinaryError.InvalidWidth(width)) => assert(width == 9),
        _ => panic("width 9 must be InvalidWidth"),
    }
    match binary.read_int_le(data, 0, -1) {
        .Err(binary.BinaryError.InvalidWidth(width)) => assert(width == -1),
        _ => panic("negative width must be InvalidWidth"),
    }
}

#[test]
fn test_checked_put_uint_rejects_values_outside_width() {
    assert(binary.put_uint_le(65536, 2).is_err());
    assert(binary.put_uint_le(-1, 4).is_err());
    assert(binary.put_uint_le(1, 0).is_err());
    assert(binary.put_uint_le(1, 9).is_err());
    assert(binary.put_uint_le(65535, 2).is_ok());
}

#[test]
fn test_checked_slice() {
    let data = hex_bytes([1, 2, 3, 4]);
    assert(binary.slice(data, 1, 3).expect("inner") == hex_bytes([2, 3]));
    assert(binary.slice(data, 4, 4).expect("empty tail").len() == 0);
    match binary.slice(data, 1, 9) {
        .Err(binary.BinaryError.OutOfRange(at, width, available)) => assert(at == 1 && width == 8 && available == 4),
        _ => panic("end past the data must be OutOfRange"),
    }
    assert(binary.slice(data, 3, 2).is_err());
    assert(binary.slice(data, -1, 2).is_err());
}

// ── Checked binary32 ─────────────────────────────────────────────────
fn f32_pattern_be(bits: i64) -> bytes {
    binary.put_uint_be(bits, 4).expect("32-bit pattern")
}

#[test]
fn test_f32_known_patterns() {
    assert(binary.put_f32_be(1.0).expect("one") == f32_pattern_be(0x3F800000));
    assert(binary.put_f32_le(-2.5).expect("neg") == binary.put_uint_le(0xC0200000, 4).expect("pattern"));
    assert(binary.put_f32_be(0.0).expect("zero") == f32_pattern_be(0));
    assert(binary.put_f32_be(-0.0).expect("negative zero") == f32_pattern_be(0x80000000));
    assert(binary.read_f32_be(f32_pattern_be(0x41AC0000), 0).expect("21.5") == 21.5);
    let negative_zero = binary.read_f32_be(f32_pattern_be(0x80000000), 0).expect("negative zero");
    assert(negative_zero == 0.0 && negative_zero.is_sign_negative());
}

#[test]
fn test_f32_extremes_round_trip() {
    for bits in [0x00000001, 0x007FFFFF, 0x00800000, 0x7F7FFFFF, 0xFF7FFFFF, 0x80000001, 0x3EAAAAAB] {
        let value = binary.read_f32_le(binary.put_uint_le(bits, 4).expect("pattern"), 0).expect("finite");
        assert(binary.put_f32_le(value).expect("representable") == binary.put_uint_le(bits, 4).expect("pattern"));
    }
    let smallest = binary.read_f32_be(f32_pattern_be(1), 0).expect("smallest subnormal");
    assert(smallest > 0.0 && smallest < 1.5e-45);
}

#[test]
fn test_f32_rounds_to_nearest() {
    let third = binary.put_f32_be(1.0 / 3.0).expect("rounded");
    assert(third == f32_pattern_be(0x3EAAAAAB));
}

#[test]
fn test_f32_rejects_non_finite_and_overflow() {
    match binary.read_f32_be(f32_pattern_be(0x7F800000), 0) {
        .Err(binary.BinaryError.NonFinite) => {}
        _ => panic("infinity pattern must be NonFinite"),
    }
    match binary.read_f32_be(f32_pattern_be(0x7FC00001), 0) {
        .Err(binary.BinaryError.NonFinite) => {}
        _ => panic("NaN payload must be NonFinite"),
    }
    match binary.put_f32_le(3.5e38) {
        .Err(binary.BinaryError.Overflow) => {}
        _ => panic("3.5e38 must be Overflow"),
    }
    match binary.put_f32_le(1.0 / 0.0) {
        .Err(binary.BinaryError.NonFinite) => {}
        _ => panic("infinity must be NonFinite"),
    }
    match binary.read_f32_le(f32_pattern_be(0), 1) {
        .Err(binary.BinaryError.OutOfRange(at, width, available)) => assert(at == 1 && width == 4 && available == 4),
        _ => panic("short binary32 must be OutOfRange"),
    }
}

fn parse_record(record: bytes) -> (i64, f64) fails binary.BinaryError {
    (binary.read_uint_le(record, 0, 2)?, binary.read_f32_le(record, 2)?)
}

#[test]
fn test_checked_parser_with_question_mark() {
    var record = binary.put_uint_le(7, 2).expect("width 2");
    record.append(binary.put_f32_le(21.5).expect("finite"));
    assert(f"{parse_record(record):?}" == "Ok((7, 21.5))");
    assert(f"{parse_record(record[0..3]):?}" == "Err(OutOfRange(2, 4, 3))");
}
