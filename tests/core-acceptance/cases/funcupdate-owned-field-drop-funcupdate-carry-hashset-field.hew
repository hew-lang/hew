import std.string;

type Pair {
    keep: HashSet<string>,
    churn: string,
}

fn main() -> i64 {
    var s: HashSet<string> = HashSet.new();
    s.insert(string.repeat("k", 32));
    var p = Pair { keep: s, churn: string.repeat("a", 32) };
    var i: i64 = 0;
    while i < 50 {
        p = Pair { churn: string.repeat("b", 32), ..p };
        i = i + 1;
    }
    p.keep.len()
}
