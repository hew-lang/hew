actor Sink {
    var hits: i64,

    receive fn take(v: HashSet<i64>) -> i64 {
        let v_l = v.len();
        let v_h = v.contains(1);
        println(f"len={v_l} has1={v_h}");
        hits = hits + 1;
        hits
    }
}

fn main() {
    let x: HashSet<i64> = HashSet.new();
    x.insert(1);
    x.insert(2);
    let s = spawn Sink(hits: 0);
    match await s.take(x) {
        Result.Ok(n) => println(f"hits {n}"),
        Result.Err(_) => println("err"),
    }
}
