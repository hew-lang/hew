//! Symmetric encryption and decryption.
//!
//! Encrypt and decrypt data using AES-256-GCM.
//!
//! # Examples
//!
//! ```
//! import std.crypto.hash;
//! import std.crypto.encrypt;
//!
//! fn main() {
//!     let key = match hash.random_bytes(32) {
//!         .Ok(key) => key,
//!         .Err(reason) => panic(f"{reason}"),
//!     };
//!     let ciphertext = match encrypt.seal(key, "hello world") {
//!         .Ok(ciphertext) => ciphertext,
//!         .Err(error) => panic(to_string(error)),
//!     };
//!     match encrypt.open(key, ciphertext) {
//!         .Ok(plaintext) => println(plaintext),
//!         .Err(err) => println(err),
//!     }
//! }
//! ```

import std.encoding.base64;

/// Structured errors returned by `open`.
pub enum CryptoError {
    /// The key input was not a valid AES-256 key.
    InvalidKey;
    /// The ciphertext was too short to contain a nonce and GCM tag.
    ShortCiphertext;
    /// AES-GCM authentication failed.
    AuthFailed;
    /// The decrypted plaintext was not valid UTF-8.
    InvalidUtf8;
    /// Native string allocation failed.
    AllocationFailure;
    /// The system entropy source could not produce a nonce.
    EntropyFailure;
}

fn crypto_error_from_i32(code: i32) -> Option<CryptoError> { // INTERNAL-ABI: C ABI error tag is i32 repr(C)
    match code {
        0 => .None,
        1 => .Some(CryptoError.InvalidKey),
        2 => .Some(CryptoError.ShortCiphertext),
        3 => .Some(CryptoError.AuthFailed),
        4 => .Some(CryptoError.InvalidUtf8),
        5 => .Some(CryptoError.AllocationFailure),
        6 => .Some(CryptoError.EntropyFailure),
        _ => .Some(CryptoError.AuthFailed),
    }
}

impl Error for CryptoError {}

impl Display for CryptoError {
    fn fmt(self) -> string {
        match self {
            CryptoError.InvalidKey => "encrypt key must be 32 bytes",
            CryptoError.ShortCiphertext => "encrypt ciphertext is too short",
            CryptoError.AuthFailed => "encrypt authentication failed",
            CryptoError.InvalidUtf8 => "encrypt plaintext was not valid UTF-8",
            CryptoError.AllocationFailure => "encrypt native allocation failed",
            CryptoError.EntropyFailure => "encrypt system entropy source failed",
        }
    }
}

/// Return the last `open` error observed on this thread.
fn last_open_error() -> Option<CryptoError> {
    crypto_error_from_i32(unsafe {
        hew_encrypt_last_open_error_code()
    })
}

/// Return the last `seal` error observed on this thread.
///
/// Reading consumes the status, so a later successful seal is never read as
/// this failure.
fn last_seal_error() -> Option<CryptoError> {
    crypto_error_from_i32(unsafe {
        hew_encrypt_last_seal_error_code()
    })
}

/// Encrypt plaintext using AES-256-GCM, reporting an unusable key instead of
/// failing out of the FFI boundary.
///
/// A key that is not 32 bytes, a plaintext the boundary cannot read, an
/// entropy failure, and an allocation failure are all returned as
/// `Err(CryptoError)`. No path returns an empty ciphertext as success: an
/// empty plaintext still seals to a nonce plus a GCM tag.
pub fn seal(key: bytes, plaintext: string) -> Result<bytes, CryptoError> {
    let encoded = unsafe {
        hew_encrypt_try_seal_base64_hew(key, plaintext)
    };
    match last_seal_error() {
        .None => .Ok(base64.decode(encoded).expect("the native sealer returns Base64")),
        .Some(err) => .Err(err),
    }
}

/// Decrypt ciphertext using AES-256-GCM with the given key.
///
/// Returns `Err(CryptoError)` when the key or ciphertext is invalid, AES-GCM
/// authentication fails, or the decrypted bytes are not valid UTF-8.
pub fn open(key: bytes, ciphertext: bytes) -> Result<string, CryptoError> {
    let plaintext = unsafe {
        hew_encrypt_try_open_hew(key, ciphertext)
    };
    match last_open_error() {
        .None => .Ok(plaintext),
        .Some(err) => .Err(err),
    }
}

// -- FFI bindings --
extern "C" {
    fn hew_encrypt_try_seal_base64_hew(key: bytes, plaintext: string) -> string;
    fn hew_encrypt_last_seal_error_code() -> i32;
    fn hew_encrypt_try_open_hew(key: bytes, ciphertext: bytes) -> string;
    fn hew_encrypt_last_open_error_code() -> i32;
}

// Unknown ABI tags must remain failures rather than becoming successful results.
#[test]
fn crypto_error_from_i32_rejects_unknown_codes() {
    for code in [-1, 7, 99, 100] {
        match crypto_error_from_i32(code as i32) {
            .Some(.AuthFailed) => {}
            _ => panic("unknown encryption status must fail"),
        }
    }
    assert(crypto_error_from_i32(0) == .None);
}
