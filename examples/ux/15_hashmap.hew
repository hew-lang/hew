fn main() {
    var platforms: HashMap<string, i64> = HashMap.new();
    platforms.insert("Jasper", 2);
    platforms.insert("Churchill", 4);
    for destination in ["Jasper", "Churchill", "Moncton"] {
        match platforms.get(destination) {
            .Some(number) => println(f"{destination} leaves from platform {number}"),
            .None => println(f"No train to {destination} today"),
        }
    }
}
