//! Stable sorting and reversal for vectors.
//!
//! Each function returns an independent vector and preserves its input.
//! `sort` uses the element's ordering; `sort_by` accepts an explicit ordering.

fn sort_by_core<T>(var v: Vec<T>, consume var less: fn[var](T, T) -> bool) -> Vec<T> {
    let n = v.len();
    if n < 2 {
        return v;
    }
    var scratch = v.clone();
    var width = 1;
    while width < n {
        var start = 0;
        while start < n {
            let left_len = if width < n - start {
                width
            } else {
                n - start
            };
            let mid = start + left_len;
            let right_len = if width < n - mid {
                width
            } else {
                n - mid
            };
            let end = mid + right_len;
            var left = start;
            var right = mid;
            var write = start;
            while left < mid && right < end {
                let left_value = v[left];
                let right_value = v[right];
                // Taking the left element on equality makes each merge left-biased (stable).
                if less(right_value, left_value) {
                    scratch.set(write, right_value);
                    right = right + 1;
                } else {
                    scratch.set(write, left_value);
                    left = left + 1;
                }
                write = write + 1;
            }
            while left < mid {
                scratch.set(write, v[left]);
                left = left + 1;
                write = write + 1;
            }
            while right < end {
                scratch.set(write, v[right]);
                right = right + 1;
                write = write + 1;
            }
            start = end;
        }
        let previous = v;
        v = scratch;
        scratch = previous;
        width = if width > n / 2 {
            n
        } else {
            width * 2
        };
    }
    v
}

/// Sort a vector in ascending order using its element ordering.
/// Equal elements keep their relative order. The input is unchanged.
pub fn sort<T: Ord>(v: Vec<T>) -> Vec<T> {
    sort_by(v, |a: T, b: T| a < b)
}

/// Sort a vector using `less(a, b)` to place `a` strictly before `b`.
/// Equal elements keep their relative order. The input is unchanged.
/// A mutable comparator can maintain private state across comparisons.
/// The call consumes its comparator.
pub fn sort_by<T>(v: Vec<T>, consume var less: fn[var](T, T) -> bool) -> Vec<T> {
    sort_by_core(v, less)
}

/// Reverse a vector. The input is unchanged.
pub fn reverse<T>(v: Vec<T>) -> Vec<T> {
    var out: Vec<T> = Vec.new();
    var i = v.len();
    while i > 0 {
        i = i - 1;
        out.push(v[i]);
    }
    out
}
