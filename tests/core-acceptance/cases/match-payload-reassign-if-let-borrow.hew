enum Box {  Full(Vec<i64>), Empty }
fn main() -> i64 {
    let b = Box.Full(seed());
    var i = 0;
    var sum = 0;
    while i < 5 {
        if let Box.Full(v) = b {
            sum = sum + v.len();
        }
        i = i + 1;
    }
    sum
}

fn seed() -> Vec<i64> {
    var v: Vec<i64> = Vec.new();
    v.push(1);
    v.push(2);
    v.push(3);
    v
}
