import std.string;

pub type UserRecord { name: string; id: i64; }
pub enum UserEnum { Missing(string); }

pub fn fetch(n: i64) -> Result<UserRecord, UserEnum> {
    if n >= 0 {
        return Ok(UserRecord { name: "user" + string.from_int(n), id: n });
    }
    Err(UserEnum.Missing("missing" + string.from_int(n)))
}

pub fn relay(n: i64) -> Result<UserRecord, UserEnum> { fetch(n) }
