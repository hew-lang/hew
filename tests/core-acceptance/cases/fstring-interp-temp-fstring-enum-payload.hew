fn mkopt(i: i64) -> Option<string> { .Some(f"tok{i}") }
fn main() -> i64 {
    var i: i64 = 0;
    var total: i64 = 0;
    while i < 200 {
        match mkopt(i) {
            .Some(s) => { println(f"v={s}"); total = total + s.len(); }
            .None => {}
        }
        i = i + 1;
    }
    if total != 1090 { return 88; }
    0
}
