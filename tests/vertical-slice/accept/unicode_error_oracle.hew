fn main() {
    assert("hi".get(2).is_none());
    assert("hi".get(-1).is_none());
    assert((-1).try_to_char().is_none());
    assert((0x110000).try_to_char().is_none());
    assert((0xD800).try_to_char().is_none());
    assert((4294967329).try_to_char().is_none());
    println("invalid scalar conversions and missing indices return None");
}
