// Reject fixture: a process-local actor handle payload must never cross a
// RemotePid (cross-node) boundary. The handle names an actor in this process
// and has no wire representation, so `RemotePid::send` refuses it at the
// checker rather than ship a local identity to another node.
//
// Its companion accept fixture (accept/actor_single_arg_pid_payload.hew) proves
// the same handle payload runs on a same-node send, where the mailbox transfers
// it by value and no codec is involved.
actor Holder {
    receive fn take(p: Holder) {
        println("took");
    }
}

impl ActorMsg for Holder {
    type Msg = Holder;
    type Reply = ();
}

fn main() {
    let local: Holder = spawn Holder();
    let peer: RemotePid<Holder>;
    let sent: Result<(), SendError> = peer.send(local);
    match sent {
        .Ok(_) => println("sent"),
        .Err(_) => println("send failed"),
    }
}
