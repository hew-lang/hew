// An actor completion call can suspend its caller and resume with the reply.

actor Worker {
    let factor: i64,
    receive fn compute(n: i64) -> i64 {
        n * factor
    }
}

actor Coordinator {
    let worker: LocalPid<Worker>,
    receive fn run(n: i64) -> i64 {
        let r = worker.compute(n);
        match r {
            .Ok(v) => v,
            .Err(_) => -1,
        }
    }
}

fn main() {
    let w = spawn Worker(factor: 6);
    let c = spawn Coordinator(worker: w);
    let r = c.run(7);
    match r {
        .Ok(v) => println(f"result={v}"),
        .Err(_) => println("ask failed"),
    }
}
