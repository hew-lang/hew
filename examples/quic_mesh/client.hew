// Create one authority with `hew node authority --key authority.key`.
// Enrol both node credentials under it with
// `hew node identity --key PATH --transport TRANSPORT` and
// `hew node admit --authority authority.key --credential HEX --transport TRANSPORT --output FILE`.
// Set HEW_NODE_CLUSTER to this node's enrolment file, then start the server
// and client. Without that setting, each program prints its credential and exits.
// TCP: server [port], client [host] [port]. Mesh uses loopback ports 9000/9001.
import std.net;
import std.net.cluster;

import std.os;

actor Counter {
    var count: i64;
    #[wire]
    receive fn increment(by: i64) -> i64 {
        count = count + by;
        count
    }
    #[wire]
    receive fn get_count() -> i64 {
        count
    }
}

fn main() {
    let config = NodeConfig { bind: "127.0.0.1:9001", transport: NodeTransport.QuicMesh, key: "quic-mesh-client.key", cluster: os.env("HEW_NODE_CLUSTER") ?? "", seeds: [] };
    Node.start(config).expect("QUIC mesh node starts");
    println(f"[client] public credential: {Node.identity_key()}");
    if (os.env("HEW_NODE_CLUSTER") ?? "").is_empty() {
        Node.shutdown();
        return;
    }
    Node.connect("127.0.0.1:9000").expect("connect to admitted QUIC peer");
    let location = cluster.wait_registered("counter").expect("discover Counter server");
    let peer = Node.peer(location.node_id()).expect("admitted Counter server");
    let counter: Counter = peer.receive_service<Counter>().expect("receive Counter service");
    println("[client] received the Counter service");
    for amount in [10, 20, 30] {
        let total = counter.increment(amount).expect("increment completes");
        println(f"[client] incremented by {amount}: total={total}");
    }
    let total = counter.get_count().expect("read completes");
    println(f"[client] final count: {total}");
    Node.shutdown();
    println("[client] shut down");
}
