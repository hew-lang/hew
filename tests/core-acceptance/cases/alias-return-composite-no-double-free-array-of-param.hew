type Holder { s: string }
fn borrowLen(h: Holder) -> i64 { h.s.len() }
fn arrayOf(h: Holder) -> Vec<Holder> { [h] }
fn borrowVecLen(v: Vec<Holder>) -> i64 { v.len() }
fn main() -> i64 {
    var total: i64 = 0;
    for i in 0..50 {
        let y: Holder = Holder { s: "a" + "b" };
        total = total + borrowVecLen(arrayOf(y));
    }
    if total != 50 { return 66; }
    0
}
