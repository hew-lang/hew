//! Compiled/executed proof for imported std::bench impl methods.

import std.bench;

#[test]
fn test_imported_bench_suite_add_and_report() {
    var s = bench.suite("Imported Bench");
    s.add("noop", 1, || {});
    assert(s.results.len() == 1);
    assert(s.results[0].name == "noop");
    assert(s.results[0].iterations == 1);
    s.report();
}
