// A HashSet record field reaches its declared IntoIterator impl without
// changing the field's receiver type. The cursor owns its element snapshot,
// and the source field stays live after the loop. Elements 10, 20, 30 sum to
// 60; the count guard also rejects an incorrectly empty iteration.
type SetBox {
    s: HashSet<i64>;
}

fn make_set_box() -> SetBox {
    var s: HashSet<i64> = HashSet.new();
    s.insert(10);
    s.insert(20);
    s.insert(30);
    SetBox { s: s }
}

pub fn main() -> i64 {
    let b = make_set_box();
    var total = 0;
    var count = 0;
    for x in b.s {
        total = total + x;
        count = count + 1;
    }
    if count != 3 {
        return 100 + count;
    }
    // The field must still be usable after the loop (shared, not consumed).
    if b.s.len() != 3 {
        return 99;
    }
    total
}
