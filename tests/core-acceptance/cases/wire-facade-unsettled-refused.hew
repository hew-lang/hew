// A facade call must know its value type, and a codec has no body to use as a
// function value; both are refused at check time.
import std.encoding.wire;

fn main() {
    let parsed: Result<i64, string> = wire.from_json("1");
    match parsed {
        .Ok(n) => println(n),
        .Err(reason) => println(reason),
    }
    let _unknown = wire.from_json("[1]");
    let _encode = wire.to_json;
}
