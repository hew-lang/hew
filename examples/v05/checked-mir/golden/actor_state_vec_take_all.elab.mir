    call[bb1 hew_i64_to_string -> bb2] ->
      (none)
    unwind[bb1 hew_i64_to_string] ->
      (none)
    call[bb2 hew_string_concat -> bb3] ->
      (none)
    unwind[bb2 hew_string_concat] ->
      drop _2 ty=string kind=cow_heap(hew_string_drop)
    return[bb3] ->
      (none)

