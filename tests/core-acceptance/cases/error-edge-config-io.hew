// The failure edge applies a declared `From` at `?`, and `.context` erases
// into `dyn Error` for the report `main` prints.
import std.fs;

import std.string;

enum ConfigError {
    Io(fs.IoError);
    Missing(string);
}

impl Display for ConfigError {
    fn fmt(self) -> string {
        match self {
            .Io(e) => f"Io: {e}",
            .Missing(key) => f"Missing: {key}",
        }
    }
}

impl Error for ConfigError {
}

impl From<fs.IoError> for ConfigError {
    fn from(value: fs.IoError) -> ConfigError {
        .Io(value)
    }
}

fn read_port(path: string) -> i64 fails ConfigError {
    let text = fs.read(path)?;
    let trimmed = text.trim();
    if trimmed.is_empty() {
        return error ConfigError.Missing("port");
    }
    string.to_int(trimmed).map_err(|_| ConfigError.Missing("port"))?
}

fn main() fails dyn Error {
    let port = read_port("/nonexistent-hew-config/app.conf").context("loading app.conf")?;
    if port > 65535 {
        return error f"port {port} is out of range";
    }
    println(f"listening on {port}");
}
