type Leaf {
    s: string,
    t: string,
}
type Mid { leaf: Leaf, x: string }
type Outer { mid: Mid, c: string }
type Holder { held: Leaf }

fn make_outer(k: i64) -> Outer {
    Outer {
        mid: Mid {
            leaf: Leaf {
                s: "store-s-heap-payload".to_upper(),
                t: "store-t-heap-payload".to_upper(),
            },
            x: "store-x-heap-payload".to_upper(),
        },
        c: "store-c-heap-payload".to_upper(),
    }
}

fn deep(k: i64) -> Holder {
    let o = make_outer(k);
    let mid = o.mid;
    let leaf = mid.leaf;
    var h = Holder { held: Leaf {
        s: "old-s-heap-payload".to_upper(),
        t: "old-t-heap-payload".to_upper(),
    } };
    h.held = leaf;
    h
}

fn run_cycle(k: i64) -> i64 {
    let h = deep(k);
    h.held.s.len()
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        total = total + run_cycle(i);
        i = i + 1;
    }
    if total > 0 { 0 } else { 1 }
}
