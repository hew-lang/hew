// Lambda actor calls preserve multiple arguments and owned string payloads.
// Both unit and value handlers are observed through their completion results.
fn main() {
    let add = actor |a: i64, b: i64| -> i64 {
        a + b
    };
    let sum = add(3, 4);
    match sum {
        .Ok(v) => println(f"add={v}"),
        .Err(_) => println("add failed"),
    }
    let tag = actor |prefix: string, n: i64| -> string {
        f"{prefix}:{n * 2}"
    };
    let label = tag("answer", 21);
    match label {
        .Ok(s) => println(s),
        .Err(_) => println("tag failed"),
    }
    let log = actor |level: string, code: i64| {
        println(f"[{level}] code={code}");
    };
    let _ = log("warn", 7);
}
