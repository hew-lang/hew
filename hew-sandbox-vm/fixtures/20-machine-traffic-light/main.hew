machine TrafficLight {
    events {
        Tick;
    }

    state Red;
    state Green;
    state Yellow;

    on Tick: Red => Green;
    on Tick: Green => Yellow;
    on Tick: Yellow => Red;
}

fn main() {
    var light: TrafficLight = .Red;
    println(light.state_name());
    let _ = light.step(.Tick).expect("machine step failed");
    println(light.state_name());
}
