//! Scheduler calibration. Actor setup and one warm-up task precede timing.
//! Fanout times concurrent request/reply clients, including their task lifetime.
//! Timer sleeps run in a task, so they exercise the runtime timer path.
import std.os;

import std.string;
import std.stream;

type Measurement {
    elapsed_ns: i64;
    checksum: i64;
    latencies_ns: Vec<i64>;
}

actor Counter {
    var count: i64;
    receive fn increment() -> i64 {
        count += 1;
        count
    }
}

fn ready(index: i64) -> i64 {
    index % 251
}

fn increment(counter: Counter) -> i64 {
    match counter.increment() {
        .Ok(value) => value,
        .Err(_) => panic("counter request failed"),
    }
}

fn client(counter: Counter, iterations: i64) -> i64 {
    var sum = 0;
    for _ in 0..iterations {
        sum += increment(counter);
    }
    sum
}

fn task_ready(iterations: i64, size: i64) -> Measurement {
    var sum = 0;
    let start = instant.now();
    var offset = 0;
    while offset < iterations {
        let end = if offset + size < iterations {
            offset + size
        } else {
            iterations
        };
        var tasks = [fork ready(offset)];
        for index in (offset + 1) .. end {
            tasks.push(fork ready(index));
        }
        let values = await tasks;
        for value in values {
            sum += value;
        }
        offset = end;
    }
    Measurement { elapsed_ns: start.elapsed().nanos(), checksum: sum, latencies_ns: Vec.new() }
}

fn actor_roundtrip(iterations: i64, measure_latencies: bool) -> Measurement {
    let counter = spawn Counter { count: 0 };
    var samples: Vec<i64> = Vec.new();
    var sum = 0;
    let start = instant.now();
    for index in 0..iterations {
        if measure_latencies {
            let before = instant.now();
            sum += increment(counter);
            let elapsed = before.elapsed().nanos();
            if index < 10000 {
                samples.push(elapsed);
            }
        } else {
            sum += increment(counter);
        }
    }
    let elapsed = start.elapsed().nanos();
    stop(counter);
    stopped(counter);
    Measurement { elapsed_ns: elapsed, checksum: sum, latencies_ns: samples }
}

fn actor_fanout(iterations: i64, size: i64) -> Measurement {
    var counters: Vec<Counter> = Vec.new();
    for _ in 0..size {
        counters.push(spawn Counter { count: 0 });
    }
    let start = instant.now();
    var clients = [fork client(counters[0], iterations)];
    for index in 1..size {
        clients.push(fork client(counters[index], iterations));
    }
    let sums = await clients;
    var sum = 0;
    for value in sums {
        sum += value;
    }
    let elapsed = start.elapsed().nanos();
    for counter in counters {
        stop(counter);
        stopped(counter);
    }
    Measurement { elapsed_ns: elapsed, checksum: sum, latencies_ns: Vec.new() }
}

fn timer(iterations: i64) -> Measurement {
    var samples: Vec<i64> = Vec.new();
    let start = instant.now();
    for index in 0..iterations {
        let before = instant.now();
        sleep(1ms);
        let overshoot = before.elapsed().nanos() - 1000000;
        if index < 10000 {
            samples.push(if overshoot > 0 {
                overshoot
            } else {
                0
            });
        }
    }
    Measurement { elapsed_ns: start.elapsed().nanos(), checksum: iterations, latencies_ns: samples }
}

fn stream_worker(consume input: stream.Stream<i64>, consume output: stream.Sink<i64>, consume ready: stream.Sink<i64>, consume gate: stream.Stream<i64>, iterations: i64) {
    ready.send(1).expect("stream worker ready");
    let _ = gate.recv().expect("stream worker start");
    for _ in 0..iterations {
        let value = match input.recv() {
            .Some(value) => value,
            .None => panic("stream closed before expected request"),
        };
        output.send(value + 1).expect("stream reply");
    }
}

fn stream_client(consume requests: stream.Sink<i64>, consume returned: stream.Stream<i64>, consume ready: stream.Sink<i64>, consume gate: stream.Stream<i64>, iterations: i64, sample_latency: bool) -> Measurement {
    ready.send(2).expect("stream client ready");
    let _ = gate.recv().expect("stream client start");
    var samples: Vec<i64> = Vec.new();
    var checksum = 0;
    let start = instant.now();
    for index in 0..iterations {
        if sample_latency && index < 640000 && index % 64 == 0 {
            let before = instant.now();
            requests.send(index).expect("stream request");
            let reply = returned.recv().expect("stream reply");
            samples.push(before.elapsed().nanos());
            if reply != index + 1 {
                panic("stream sequence mismatch");
            }
        } else {
            requests.send(index).expect("stream request");
            let reply = returned.recv().expect("stream reply");
            if reply != index + 1 {
                panic("stream sequence mismatch");
            }
        }
        checksum += index;
    }
    Measurement { elapsed_ns: start.elapsed().nanos(), checksum: checksum, latencies_ns: samples }
}

fn stream_roundtrip(iterations: i64, sample_latency: bool) -> Measurement {
    let (requests, incoming): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("request pipe");
    let (replies, returned): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("reply pipe");
    let (ready, ready_input): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(2).expect("stream ready pipe");
    let (worker_gate, worker_start): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("worker start pipe");
    let (client_gate, client_start): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("client start pipe");
    let worker = fork stream_worker(incoming, replies, ready.clone(), worker_start, iterations);
    let client = fork stream_client(requests, returned, ready, client_start, iterations, sample_latency);
    let _ = ready_input.recv().expect("stream ready");
    let _ = ready_input.recv().expect("stream ready");
    ready_input.close();
    worker_gate.send(1).expect("worker start");
    client_gate.send(1).expect("client start");
    worker_gate.close();
    client_gate.close();
    let measured = await client;
    let _ = await worker;
    measured
}

fn pipeline_worker(consume output: stream.Sink<i64>, consume ready: stream.Sink<i64>, consume gate: stream.Stream<i64>, iterations: i64, id: i64, pairs: i64) {
    ready.send(id).expect("pipeline readiness");
    let _ = gate.recv().expect("pipeline start");
    for index in 0..iterations {
        let value = index * pairs + id;
        output.send(value).expect("pipeline output");
    }
    output.close();
}

fn pipeline_drain(consume input: stream.Stream<i64>, consume ready: stream.Sink<i64>, consume gate: stream.Stream<i64>, iterations: i64, id: i64, pairs: i64, sample_latency: bool, samples: stream.Sink<i64>) -> i64 {
    ready.send(id + pairs).expect("pipeline drain readiness");
    let _ = gate.recv().expect("pipeline drain start");
    var sum = 0;
    for index in 0..iterations {
        let expected = index * pairs + id;
        let value = if sample_latency && expected < 640000 && expected % 64 == 0 {
            let before = instant.now();
            let item = input.recv().expect("pipeline output");
            samples.send(before.elapsed().nanos()).expect("pipeline latency sample");
            item
        } else {
            input.recv().expect("pipeline output")
        };
        if value != expected {
            panic("pipeline sequence mismatch");
        }
        sum += value % 251;
    }
    sum
}

fn stream_pipeline(iterations: i64, pairs: i64, sample_latency: bool) -> Measurement {
    let (ready_sink, ready_input): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(pairs * 2).expect("pipeline ready pipe");
    let sample_capacity = if sample_latency {
        let count = (iterations * pairs + 63) / 64;
        if count < 10000 {
            count + 1
        } else {
            10001
        }
    } else {
        1
    };
    let (sample_sink, sample_input): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(sample_capacity).expect("pipeline samples pipe");
    var gates: Vec<stream.Sink<i64>> = Vec.new();
    let (output, input): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("pipeline output pipe");
    let (worker_gate, worker_start): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("pipeline worker gate");
    let (drain_gate, drain_start): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("pipeline drain gate");
    gates.push(worker_gate);
    gates.push(drain_gate);
    var workers = [fork pipeline_worker(output, ready_sink.clone(), worker_start, iterations, 0, pairs)];
    var drains = [fork pipeline_drain(input, ready_sink.clone(), drain_start, iterations, 0, pairs, sample_latency, sample_sink.clone())];
    for id in 1..pairs {
        let (next_output, next_input): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("pipeline output pipe");
        let (next_worker_gate, next_worker_start): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("pipeline worker gate");
        let (next_drain_gate, next_drain_start): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("pipeline drain gate");
        gates.push(next_worker_gate);
        gates.push(next_drain_gate);
        workers.push(fork pipeline_worker(next_output, ready_sink.clone(), next_worker_start, iterations, id, pairs));
        drains.push(fork pipeline_drain(next_input, ready_sink.clone(), next_drain_start, iterations, id, pairs, sample_latency, sample_sink.clone()));
    }
    for _ in 0 .. (pairs * 2) {
        let _ = ready_input.recv().expect("pipeline ready");
    }
    ready_input.close();
    ready_sink.close();
    var samples: Vec<i64> = Vec.new();
    let start = instant.now();
    for gate in gates {
        gate.send(1).expect("pipeline start gate");
    }
    let sums = await drains;
    let _ = await workers;
    let elapsed = start.elapsed().nanos();
    sample_sink.close();
    for sample in sample_input {
        samples.push(sample);
    }
    var checksum = 0;
    for sum in sums {
        checksum += sum;
    }
    Measurement { elapsed_ns: elapsed, checksum: checksum, latencies_ns: samples }
}

fn main() {
    let arguments = os.args();
    if arguments.len() != 4 {
        panic("usage: concurrency WORKLOAD ITERATIONS SIZE");
    }
    let workload = arguments[1];
    let iterations = (arguments[2]).to_int().expect("positive iteration count");
    let size = (arguments[3]).to_int().expect("positive size");
    if iterations <= 0 || size <= 0 {
        panic("iterations and size must be positive");
    }
    let _ = await fork ready(0);
    let measured = match workload {
        "task_ready" => task_ready(iterations, size),
        "actor_roundtrip" => actor_roundtrip(iterations, true),
        "actor_roundtrip_alloc" => actor_roundtrip(iterations, false),
        "actor_fanout" => actor_fanout(iterations, size),
        "timer" => await fork timer(iterations),
        "stream_roundtrip" => stream_roundtrip(iterations, true),
        "stream_roundtrip_alloc" => stream_roundtrip(iterations, false),
        "stream_pipeline" => stream_pipeline(iterations, size, true),
        "stream_pipeline_alloc" => stream_pipeline(iterations, size, false),
        _ => panic("unknown concurrency workload"),
    };
    var samples = "[";
    for index in 0..measured.latencies_ns.len() {
        if index > 0 {
            samples = samples + ",";
        }
        samples = samples + f"{measured.latencies_ns[index]}";
    }
    samples = samples + "]";
    let fields = f"\"workload\":\"{workload}\",\"iterations\":{iterations},\"size\":{size},\"elapsed_ns\":{measured.elapsed_ns},\"checksum\":{measured.checksum},\"latencies_ns\":{samples}";
    println("{" + fields + "}");
}
