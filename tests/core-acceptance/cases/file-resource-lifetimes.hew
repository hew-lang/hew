import std.fs;
import std.stream;

type Reader { input: Stream<string>, label: string }

fn open(path: string) -> Stream<string> {
    match stream.from_file(path) {
        .Ok(input) => input,
        .Err(_) => panic("fixture open failed"),
    }
}

fn early_return() -> i64 {
    let input = open("resource-return.txt");
    if true { return 7; }
    input.close();
    0
}

fn main() -> i64 {
    match fs.read("resource-read.txt") {
        .Ok(contents) => println(contents),
        .Err(_) => return 1,
    }
    let collected = open("resource-collect.txt");
    println(collected.collect());
    let closed = open("resource-close.txt");
    closed.close();
    {
        let _scoped = open("resource-scope.txt");
    }
    println(early_return());
    {
        let _record = Reader { input: open("resource-record.txt"), label: "record".to_upper() };
    }
    {
        let input = open("resource-capture-drop.txt");
        let _uncalled: fn[once]() -> string = move || input.collect();
    }
    let input = open("resource-capture-call.txt");
    let once: fn[once]() -> string = move || input.collect();
    println(once());
    println("released");
    0
}
