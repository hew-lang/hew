trait Named {
    fn name(val: Self) -> string;
}

type P {
    n: string;
}

impl Named for P {
    fn name(val: P) -> string {
        val.n
    }
}

type Q {
    n: string;
}

impl Named for Q {
    fn name(val: Q) -> string {
        val.n
    }
}

fn show_named(v: dyn Named) {
    let s = v.name();
    println(s);
}

fn main() {
    let x: dyn Named = P { n: "p0" };
    let v: Vec<dyn Named> = Vec.new();
    v.push(x);
    match v.get(0) {
        Option.Some(e) => {
            show_named(e);
        },
        Option.None => println("missing"),
    }
}
