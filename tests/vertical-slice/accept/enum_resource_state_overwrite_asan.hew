import std.encoding.xml;

enum DocState {
    Empty;
    Loaded(xml.Node);
    Broken(string);
}

actor DocHolder {
    var doc: DocState;

    receive fn load(s: string) -> i64 {
        match xml.parse(s) {
            .Ok(node) => {
                doc = DocState.Loaded(node);
            }
            .Err(.Malformed(message)) => {
                doc = DocState.Broken(message);
            }
        }
        1
    }
}

fn main() -> i64 {
    let holder = spawn DocHolder { doc: DocState.Empty };
    let first = (holder.load("<doc/>")) handle _ { 0 };
    let second = (holder.load("<doc>")) handle _ { 0 };
    first + second - 2
}
