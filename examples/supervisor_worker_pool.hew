//! Status: runnable
//! Description: Restart one worker and keep its sibling's state

actor Worker {
    var completed: i64;

    receive fn record(jobs: i64) {
        completed = completed + jobs;
    }

    receive fn count() -> i64 {
        completed
    }

    receive fn fail() {
        panic("worker failed while processing a job");
    }
}

supervisor WorkerPool {
    strategy: one_for_one;
    intensity: 5 within 10s;

    child alpha: Worker { completed: 0 };
    child beta: Worker { completed: 0 };
}

fn main() {
    let pool = spawn WorkerPool;
    let alpha = pool.alpha;
    let beta = pool.beta;
    alpha.record(3).expect("alpha records work");
    beta.record(7).expect("beta records work");
    match alpha.fail() {
        .Ok(_) => panic("the failed call unexpectedly replied"),
        .Err(failure) => println(f"alpha failed: {failure}"),
    }
    restarted(alpha);
    alpha.record(1).expect("the replacement accepts work");
    let alpha_count = alpha.count().expect("the replacement replies");
    let beta_count = beta.count().expect("beta still replies");
    assert(alpha_count == 1 && beta_count == 7);
    println(f"after the restart: alpha {alpha_count}, beta {beta_count}");
    stop(pool);
    stopped(pool);
}
