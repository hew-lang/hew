// Traffic light — Moore machine (outputs depend only on current state).
//
// Each state owns its signal colour. Transitions are driven by a single Tick
// event; entry/exit hooks are pure value computations (MACHINE-SPEC's
// Purity section) so they cannot do I/O directly — each hook emits a typed
// `Signal` output instead, and the caller prints it from the step's report.
//
// Run:
//   hew machine diagram examples/machine/traffic_light.hew
//   hew machine diagram examples/machine/traffic_light.hew --format graphviz
//   hew machine diagram examples/machine/traffic_light.hew --format json
machine TrafficLight {
    events {
        Tick,
    }

    emits {
        Signal { label: string, },
    }

    state Red {
        entry {
            emit Signal { label: "signal: RED — stop" };
        }
        exit {
            emit Signal { label: "leaving red" };
        }
    },
    state Green {
        entry {
            emit Signal { label: "signal: GREEN — go" };
        }
    },
    state Yellow {
        entry {
            emit Signal { label: "signal: YELLOW — prepare to stop" };
        }
    },

    // Red → Green → Yellow → Red cycle
    on Tick: Red => Green,
    on Tick: Green => Yellow,
    on Tick: Yellow => Red,
}

fn main() {
    var light = Red;
    for _ in 0 .. 4 {
        let report = light.step(.Tick);
        for output in report.outputs {
            match output {
                .Signal { label } => println(label),
            }
        }
    }
}
