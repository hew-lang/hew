//! Tests for the std::net::url percent-encoding helpers.

import std.net.url;

import std.string;

#[test]
fn test_encode_preserves_existing_ascii_behaviour() {
    assert(url.encode("") == "");
    assert(url.encode("hello world") == "hello%20world");
    assert(url.encode("a=1&b=2") == "a%3D1%26b%3D2");
}

#[test]
fn test_encode_utf8_bytes_as_uppercase_hex() {
    assert(url.encode("café") == "caf%C3%A9");
    assert(url.encode("éx🙂z") == "%C3%A9x%F0%9F%99%82z");
}

#[test]
fn test_decode_once_preserves_literal_plus() {
    assert(url.decode("hello%20world").expect("valid escape") == "hello world");
    assert(url.decode("plus+sign").expect("literal plus") == "plus+sign");
    assert(url.decode("%252F").expect("single decode") == "%2F");
}

#[test]
fn test_decode_malformed_escape_reports_input_byte_offset() {
    for text in ["é%", "é%2", "é%2Z"] {
        match url.decode(text) {
            .Err(.MalformedEscape(offset)) => assert(offset == 2),
            _ => panic("expected malformed escape at byte 2"),
        }
    }
}

#[test]
fn test_decode_invalid_utf8_reports_decoded_byte_offset() {
    match url.decode("ok%FF%FE") {
        .Err(.InvalidUtf8(error)) => assert(error.valid_up_to == 2),
        _ => panic("expected invalid decoded UTF-8"),
    }
}

#[test]
fn test_decode_preserves_decoded_nul_and_unicode() {
    let nul = f"{(0).try_to_char().expect("valid Unicode scalar")}";
    assert(url.decode("%00").expect("valid NUL") == nul);
    assert(url.decode("a%00b").expect("embedded NUL") == "a" + nul + "b");
    assert(url.decode("%C3%A9x%F0%9F%99%82z").expect("Unicode") == "éx🙂z");
    assert(url.decode("%E2%82").is_err());
    assert(url.decode("%ED%A0%80").is_err());
}

#[test]
fn test_decode_query_empty_returns_empty_vec() {
    let pairs = url.decode_query("").expect("empty query");
    assert(pairs.len() == 0);
}

#[test]
fn test_decode_query_decodes_form_pairs_in_order() {
    let pairs = url.decode_query("name=hello+world&x=a%2Bb&empty=&a=b=c").expect("valid query");
    assert(pairs.len() == 4);
    assert(pairs[0].0 == "name");
    assert(pairs[0].1 == "hello world");
    assert(pairs[1].0 == "x");
    assert(pairs[1].1 == "a+b");
    assert(pairs[2].0 == "empty");
    assert(pairs[2].1 == "");
    assert(pairs[3].0 == "a");
    assert(pairs[3].1 == "b=c");
}

#[test]
fn test_decode_query_preserves_nul_and_rejects_invalid_encoding() {
    let pairs = url.decode_query("value=a%00b").expect("embedded NUL");
    assert(pairs[0].1 == "a" + f"{(0).try_to_char().expect("valid Unicode scalar")}" + "b");
    assert(url.decode_query("value=ok&invalid=%FF").is_err());
    assert(url.decode_query("incomplete=%E2%82").is_err());
    assert(url.decode_query("bad%=value").is_err());
    assert(url.decode_query("value=bad%2Z").is_err());
}

#[test]
fn test_decode_query_skips_entries_without_equals() {
    let pairs = url.decode_query("skip-me&ok=yes&&also=no").expect("valid pairs");
    assert(pairs.len() == 2);
    assert(pairs[0].0 == "ok");
    assert(pairs[0].1 == "yes");
    assert(pairs[1].0 == "also");
    assert(pairs[1].1 == "no");
}

#[test]
fn test_port_returns_none_when_absent() {
    let parsed = url.parse("http://localhost/path");
    let port = parsed.port();
    parsed.close();
    if let .Some(value) = port {
        panic(f"expected None, got Some({value})");
    }
}

#[test]
fn test_port_returns_some_when_explicit() {
    let parsed = url.parse("http://localhost:8080/path");
    let port = parsed.port();
    parsed.close();
    match port {
        .Some(value) => assert(value == 8080),
        .None => panic("expected Some(8080), got None"),
    }
}

#[test]
fn test_encode_query_skips_invalid_lines_and_uses_first_equals() {
    assert(url.encode_query("name=hello world\nskip-me\na=b=c") == "name=hello%20world&a=b%3Dc");
}

#[test]
fn test_encode_query_matches_existing_pair_encoding() {
    assert(url.encode_query("name=hello world\r\npage=1&2\nother=a+b") == "name=hello%20world&page=1%262&other=a%2Bb");
}
