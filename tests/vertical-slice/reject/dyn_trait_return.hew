// A returned dyn value currently points at concrete storage in this callee's
// frame. Direct and carrier-nested signatures must fail closed until the
// compiler heap-promotes that storage and transfers drop authority to the
// caller.

trait Named {
    fn name(val: Self) -> string;
}

type Person {
    name: string;
}

impl Named for Person {
    fn name(person: Person) -> string {
        person.name
    }
}

fn make_person() -> dyn Named {
    Person { name: "Ada" }
}

fn _maybe_person() -> Option<dyn Named> {
    Some(Person { name: "Grace" })
}

fn main() {
    let person = make_person();
    println(person.name());
}
