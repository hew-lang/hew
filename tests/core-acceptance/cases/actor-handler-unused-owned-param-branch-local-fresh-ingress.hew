type Inner { name: string }
type Outer { inner: Inner }
actor Fan {
    var seen: i64,
    var held: Outer,
    receive fn route(flag: bool, other: bool) {
        let selected = if flag {
            let fresh = "hot".to_upper();
            Inner { name: fresh }
        } else {
            Inner { name: "cold" }
        };
        if other { held = Outer { inner: selected }; }
        else { held = Outer { inner: selected }; }
        seen = seen + 1;
    }
    receive fn total() -> i64 { seen + held.inner.name.len() }
}
fn main() -> i64 {
    let fan = spawn Fan(seen: 0, held: Outer { inner: Inner { name: "seed" } });
    var i: i64 = 0;
    while i < 12 {
        let _ = fan.route(i % 2 == 0, i % 3 == 0);
        i = i + 1;
    }
    match fan.total() { .Ok(n) => if n > 12 { 0 } else { 97 }, .Err(_) => 98 }
}
