}

fn link_cascade_common(kv: KeyValue, scenario: string, drive: string) -> i64 {
    let origin = discover_with_retry("kv").expect("linked peer metadata");
    println(f"LINK_ORIGIN {origin}");
    let linker = spawn Linker { policy_sel: 0 };
    let linker_id = linker.link_go(kv);
    let lid = match linker_id {
        Result.Ok(id) => id,
        Result.Err(_) => {
            println(f"FAIL {scenario} link-ask-error");
            return 2;
        }
    };
    if lid == 0 {
        println(f"FAIL {scenario} link-register-failed");
        return 3;
    }
    let live = linker.ping();
    match live {
        Result.Ok(value) => {
            if value != 7 {
                println(f"FAIL {scenario} linker-pre-cascade-wrong value={value}");
                return 7;
            }
        }
        Result.Err(_) => {
            println(f"FAIL {scenario} linker-died-during-setup");
            return 7;
        }
    }
    if drive == "stop" {
        let t = mailbox(kv).stop_self();
        match t {
            Result.Err(_) => {
                println(f"FAIL {scenario} stop-send-error");
                return 4;
            }
            Result.Ok(_) => {}
        }
    } else {
        if drive == "crash" {
            let t = mailbox(kv).crash_self();
            match t {
                Result.Err(_) => {
                    println(f"FAIL {scenario} crash-send-error");
                    return 4;
                }
                Result.Ok(_) => {}
            }
        }
    }
    if drive == "partition" {
        println(f"READY_DROP {scenario}");
    }
    var attempts: i64 = 0;
    loop {
        let st = unsafe {
            hew_link_probe_terminal_state(lid)
        };
        if st == 5 {
            println(f"PASS {scenario} linker-crashed reason={st}");
            return 0;
        }
        if st >= 0 {
            println(f"FAIL {scenario} linker-terminal-wrong reason={st}");
            return 5;
        }
        attempts = attempts + 1;
        if attempts >= 300 {
            println(f"FAIL {scenario} linker-never-crashed");
            return 6;
        }
        sleep(100ms);
    }
}

fn scenario_link_remote_clean_exit(kv: KeyValue) -> i64 {
    link_cascade_common(kv, "link_remote_clean_exit", "stop")
}

fn scenario_link_remote_typed_crash(kv: KeyValue) -> i64 {
    let observer = spawn RemoteCrashObserver { expected: discover_with_retry("kv").expect("kv metadata") };
    observer.attach(kv).expect("observer alive").expect("remote link registered");
    mailbox(kv).crash_self().expect("remote crash submitted");
    var attempts = 0;
    while observer.count().expect("typed hook survives") == 0 {
        attempts = attempts + 1;
        assert(attempts < 300);
        sleep(100ms);
    }
    assert(observer.count().expect("first notification") == 1);
    sleep(100ms);
    assert(observer.count().expect("one notification after settling") == 1);
    stop(observer);
    stopped(observer);
    println("PASS link_remote_typed_crash remote-origin class=fault count=1");
    0
}

