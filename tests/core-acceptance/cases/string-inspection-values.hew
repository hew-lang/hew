fn lines() -> Vec<string> {
    let text = "Zoë\r\n雪\n";
    text.lines()
}

fn main() {
    assert("１２3".is_digit());
    assert(!"12x".is_digit());
    assert("Zoë".is_alpha());
    assert(!"Zoë3".is_alpha());
    assert("Zoë3".is_alphanumeric());
    assert(!"Zoë 3".is_alphanumeric());
    assert(!"".is_digit());
    assert(!"".is_alpha());
    assert(!"".is_alphanumeric());
    let parts = lines();
    assert(parts.len() == 3);
    println(parts[0]);
    println(parts[1]);
    assert(parts[2] == "");
    println("string inspection passed");
}
