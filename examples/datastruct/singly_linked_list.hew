// Singly Linked List using Vec<i64> with index-based pointers
// Node layout: nodes[i*2] = value, nodes[i*2+1] = next
// NIL sentinel = -1
//
// A parameter is the callee's own copy, so every helper that writes the node
// pool returns it and the caller reassigns. Helpers that also move the head
// return a tuple.
fn node_val(nodes: Vec<i64>, idx: i64) -> i64 {
    nodes[idx * 2]
}

fn node_next(nodes: Vec<i64>, idx: i64) -> i64 {
    nodes[idx * 2 + 1]
}

fn set_next(var nodes: Vec<i64>, idx: i64, nxt: i64) -> Vec<i64> {
    nodes.set(idx * 2 + 1, nxt);
    nodes
}

fn alloc_node(var nodes: Vec<i64>, val: i64) -> (Vec<i64>, i64) {
    let idx = nodes.len() / 2;
    nodes.push(val);
    nodes.push(-1);
    (nodes, idx)
}

// Prepend: returns the pool and the new head
fn prepend(var nodes: Vec<i64>, head: i64, val: i64) -> (Vec<i64>, i64) {
    let (grown, n) = alloc_node(nodes, val);
    nodes = set_next(grown, n, head);
    (nodes, n)
}

// Append: returns the pool and the head (which changes if the list was empty)
fn append(var nodes: Vec<i64>, head: i64, val: i64) -> (Vec<i64>, i64) {
    let (grown, n) = alloc_node(nodes, val);
    nodes = grown;
    if head == -1 {
        return (nodes, n);
    }
    var curr = head;
    while node_next(nodes, curr) != -1 {
        curr = node_next(nodes, curr);
    }
    nodes = set_next(nodes, curr, n);
    (nodes, head)
}

// Append every value in order; returns the pool and the head.
fn append_all(var nodes: Vec<i64>, head: i64, values: Vec<i64>) -> (Vec<i64>, i64) {
    var curr_head = head;
    for value in values {
        let (grown, new_head) = append(nodes, curr_head, value);
        nodes = grown;
        curr_head = new_head;
    }
    (nodes, curr_head)
}

// Prepend every value in order; returns the pool and the head.
fn prepend_all(var nodes: Vec<i64>, head: i64, values: Vec<i64>) -> (Vec<i64>, i64) {
    var curr_head = head;
    for value in values {
        let (grown, new_head) = prepend(nodes, curr_head, value);
        nodes = grown;
        curr_head = new_head;
    }
    (nodes, curr_head)
}

// Delete first occurrence of val; returns the pool and the new head
fn delete_val(var nodes: Vec<i64>, head: i64, val: i64) -> (Vec<i64>, i64) {
    if head == -1 {
        return (nodes, -1);
    }
    if node_val(nodes, head) == val {
        return (nodes, node_next(nodes, head));
    }
    var prev = head;
    var curr = node_next(nodes, head);
    while curr != -1 {
        if node_val(nodes, curr) == val {
            nodes = set_next(nodes, prev, node_next(nodes, curr));
            return (nodes, head);
        }
        prev = curr;
        curr = node_next(nodes, curr);
    }
    (nodes, head)
}

// Find: returns index of first node with val, or -1
fn find(nodes: Vec<i64>, head: i64, val: i64) -> i64 {
    var curr = head;
    while curr != -1 {
        if node_val(nodes, curr) == val {
            return curr;
        }
        curr = node_next(nodes, curr);
    }
    -1
}

// Length of list
fn list_len(nodes: Vec<i64>, head: i64) -> i64 {
    var curr = head;
    var count = 0;
    while curr != -1 {
        count = count + 1;
        curr = node_next(nodes, curr);
    }
    count
}

// Collect values for verification
fn traverse(nodes: Vec<i64>, head: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec.new();
    var curr = head;
    while curr != -1 {
        result.push(node_val(nodes, curr));
        curr = node_next(nodes, curr);
    }
    result
}

fn vecs_equal(a: Vec<i64>, b: Vec<i64>) -> i64 {
    if a.len() != b.len() {
        return 0;
    }
    for i in 0 .. a.len() {
        if a[i] != b[i] {
            return 0;
        }
    }
    1
}

// --- Tests ---
fn test_prepend() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let values: Vec<i64> = [30, 20, 10];
    let (nodes, head) = prepend_all(pool, -1, values);
    let result = traverse(nodes, head);
    var expected: Vec<i64> = Vec.new();
    expected.push(10);
    expected.push(20);
    expected.push(30);
    if vecs_equal(result, expected) == 1 {
        println("PASS: prepend");
        return 1;
    }
    println("FAIL: prepend");
    0
}

fn test_append() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let values: Vec<i64> = [10, 20, 30];
    let (nodes, head) = append_all(pool, -1, values);
    let result = traverse(nodes, head);
    var expected: Vec<i64> = Vec.new();
    expected.push(10);
    expected.push(20);
    expected.push(30);
    if vecs_equal(result, expected) == 1 {
        println("PASS: append");
        return 1;
    }
    println("FAIL: append");
    0
}

fn test_delete_middle() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let values: Vec<i64> = [10, 20, 30];
    let (appended, first_head) = append_all(pool, -1, values);
    let (nodes, head) = delete_val(appended, first_head, 20);
    let result = traverse(nodes, head);
    var expected: Vec<i64> = Vec.new();
    expected.push(10);
    expected.push(30);
    if vecs_equal(result, expected) == 1 {
        println("PASS: delete middle");
        return 1;
    }
    println("FAIL: delete middle");
    0
}

fn test_delete_head() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let values: Vec<i64> = [10, 20];
    let (appended, first_head) = append_all(pool, -1, values);
    let (nodes, head) = delete_val(appended, first_head, 10);
    let result = traverse(nodes, head);
    if result.len() == 1 {
        if result[0] == 20 {
            println("PASS: delete head");
            return 1;
        }
    }
    println("FAIL: delete head");
    0
}

fn test_find() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let values: Vec<i64> = [10, 20, 30];
    let (nodes, head) = append_all(pool, -1, values);
    let found = find(nodes, head, 20);
    let not_found = find(nodes, head, 99);
    if found != -1 {
        if node_val(nodes, found) == 20 {
            if not_found == -1 {
                println("PASS: find");
                return 1;
            }
        }
    }
    println("FAIL: find");
    0
}

fn test_length() -> i64 {
    let pool: Vec<i64> = Vec.new();
    if list_len(pool, -1) != 0 {
        println("FAIL: length");
        return 0;
    }
    let values: Vec<i64> = [1, 2, 3];
    let (nodes, head) = append_all(pool, -1, values);
    if list_len(nodes, head) == 3 {
        println("PASS: length");
        return 1;
    }
    println("FAIL: length");
    0
}

fn main() {
    println("=== Singly Linked List Tests ===");
    var passed = 0;
    let total = 6;
    passed = passed + test_prepend();
    passed = passed + test_append();
    passed = passed + test_delete_middle();
    passed = passed + test_delete_head();
    passed = passed + test_find();
    passed = passed + test_length();
    println("");
    print("Passed: ");
    print(passed);
    println(f"/{total}");
    if passed == total {
        println("OVERALL: PASS");
    } else {
        println("OVERALL: FAIL");
    }
}
