// Accept: generic enum Maybe<T> with Some variant — end-to-end lowering.
// Maybe::Some(42) must lower through HIR EnumLayoutRegistry → MIR layout-gather
// → codegen and exit 42.
enum Maybe<T> {
    Some(T),
    None,
}

fn main() -> i64 {
    let x: Maybe<i64> = Maybe.Some(42);
    match x {
        Maybe.Some(v) => v,
        Maybe.None => 0,
    }
}
