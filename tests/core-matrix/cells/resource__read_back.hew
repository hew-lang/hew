#[resource]
type Tok {
    id: i64
}

impl Tok {
    fn close(self) {
        println(f"close {self.id}");
    }
}

fn main() {
    let x = Tok { id: 1 };
    let v: Vec<Tok> = Vec.new();
    v.push(x);
    match v.get(0) {
        Option.Some(e) => {
            let e_i = e.id;
            println(f"tok {e_i}");
        },
        Option.None => println("missing"),
    }
}
