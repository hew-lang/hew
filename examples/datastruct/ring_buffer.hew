// Ring Buffer with fixed capacity
// Layout: Vec<i64> = [capacity, head, tail, count, data...]
// head = read position, tail = write position
//
// A parameter is the callee's own copy, so a write or a read hands the buffer
// back and the caller reassigns; a read also reports the value it took.
fn rb_create(capacity: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec.new();
    v.push(capacity); // index 0: capacity
    v.push(0); // index 1: head (read pos)
    v.push(0); // index 2: tail (write pos)
    v.push(0); // index 3: count
    for i in 0 .. capacity {
        v.push(0); // data starts at index 4
    }
    v
}

fn rb_capacity(rb: Vec<i64>) -> i64 {
    rb[0]
}

fn rb_count(rb: Vec<i64>) -> i64 {
    rb[3]
}

fn rb_is_empty(rb: Vec<i64>) -> bool {
    rb_count(rb) == 0
}

fn rb_is_full(rb: Vec<i64>) -> bool {
    rb_count(rb) == rb_capacity(rb)
}

fn rb_available(rb: Vec<i64>) -> i64 {
    rb_capacity(rb) - rb_count(rb)
}

// Returns the buffer and whether the value fit.
fn rb_write(var rb: Vec<i64>, val: i64) -> (Vec<i64>, bool) {
    let cap = rb[0];
    let count = rb[3];
    if count == cap {
        return (rb, false);
    }
    let tail = rb[2];
    rb.set(4 + tail, val);
    let new_tail = (tail + 1) % cap;
    rb.set(2, new_tail);
    rb.set(3, count + 1);
    (rb, true)
}

// Write each value in order, ignoring the per-write success flag.
fn rb_write_all(var rb: Vec<i64>, values: Vec<i64>) -> Vec<i64> {
    for value in values {
        let (written, _fit) = rb_write(rb, value);
        rb = written;
    }
    rb
}

// Returns the buffer and the value read, or -1 when empty.
fn rb_read(var rb: Vec<i64>) -> (Vec<i64>, i64) {
    let count = rb[3];
    if count == 0 {
        return (rb, 0 - 1);
    }
    let head = rb[1];
    let cap = rb[0];
    let val = rb[4 + head];
    let new_head = (head + 1) % cap;
    rb.set(1, new_head);
    rb.set(3, count - 1);
    (rb, val)
}

fn main() {
    var passed = 0;
    var failed = 0;
    var rb = rb_create(4);
    // Test 1: Initially empty
    if rb_is_empty(rb) {
        if !rb_is_full(rb) {
            println("PASS: initially empty");
            passed = passed + 1;
        } else {
            println("FAIL: initially empty");
            failed = failed + 1;
        }
    } else {
        println("FAIL: initially empty");
        failed = failed + 1;
    }
    // Test 2: Available space
    if rb_available(rb) == 4 {
        println("PASS: available = capacity");
        passed = passed + 1;
    } else {
        println("FAIL: available = capacity");
        failed = failed + 1;
    }
    // Test 3: Write and read single element
    let (after_ten, _wrote_ten) = rb_write(rb, 10);
    rb = after_ten;
    let (after_v1, v1) = rb_read(rb);
    rb = after_v1;
    if v1 == 10 {
        println("PASS: write/read single");
        passed = passed + 1;
    } else {
        println("FAIL: write/read single");
        failed = failed + 1;
    }
    // Test 4: Write multiple, read in order (FIFO)
    let fifo: Vec<i64> = [20, 30, 40];
    rb = rb_write_all(rb, fifo);
    let (after_r1, r1) = rb_read(rb);
    rb = after_r1;
    let (after_r2, r2) = rb_read(rb);
    rb = after_r2;
    let (after_r3, r3) = rb_read(rb);
    rb = after_r3;
    if r1 == 20 {
        if r2 == 30 {
            if r3 == 40 {
                println("PASS: FIFO order");
                passed = passed + 1;
            } else {
                println("FAIL: FIFO order");
                failed = failed + 1;
            }
        } else {
            println("FAIL: FIFO order");
            failed = failed + 1;
        }
    } else {
        println("FAIL: FIFO order");
        failed = failed + 1;
    }
    // Test 5: Fill to capacity
    let fill: Vec<i64> = [1, 2, 3, 4];
    rb = rb_write_all(rb, fill);
    if rb_is_full(rb) {
        if rb_available(rb) == 0 {
            println("PASS: full buffer");
            passed = passed + 1;
        } else {
            println("FAIL: full buffer");
            failed = failed + 1;
        }
    } else {
        println("FAIL: full buffer");
        failed = failed + 1;
    }
    // Test 6: Write to full buffer fails
    let (after_full_write, w) = rb_write(rb, 99);
    rb = after_full_write;
    if !w {
        println("PASS: write full fails");
        passed = passed + 1;
    } else {
        println("FAIL: write full fails");
        failed = failed + 1;
    }
    // Test 7: Read from full, verify values
    let (after_f1, f1) = rb_read(rb);
    rb = after_f1;
    let (after_f2, f2) = rb_read(rb);
    rb = after_f2;
    let (after_f3, f3) = rb_read(rb);
    rb = after_f3;
    let (after_f4, f4) = rb_read(rb);
    rb = after_f4;
    if f1 == 1 {
        if f2 == 2 {
            if f3 == 3 {
                if f4 == 4 {
                    println("PASS: read all from full");
                    passed = passed + 1;
                } else {
                    println("FAIL: read all from full");
                    failed = failed + 1;
                }
            } else {
                println("FAIL: read all from full");
                failed = failed + 1;
            }
        } else {
            println("FAIL: read all from full");
            failed = failed + 1;
        }
    } else {
        println("FAIL: read all from full");
        failed = failed + 1;
    }
    // Test 8: Wraparound behaviour
    // head and tail have wrapped around; write more to verify correctness
    let wrapped: Vec<i64> = [100, 200];
    rb = rb_write_all(rb, wrapped);
    let (after_w1, w1) = rb_read(rb);
    rb = after_w1;
    let (after_w2, w2) = rb_read(rb);
    rb = after_w2;
    if w1 == 100 {
        if w2 == 200 {
            println("PASS: wraparound");
            passed = passed + 1;
        } else {
            println("FAIL: wraparound");
            failed = failed + 1;
        }
    } else {
        println("FAIL: wraparound");
        failed = failed + 1;
    }
    // Test 9: Read from empty returns sentinel
    let (after_empty, empty_val) = rb_read(rb);
    rb = after_empty;
    if empty_val == 0 - 1 {
        println("PASS: read empty sentinel");
        passed = passed + 1;
    } else {
        println("FAIL: read empty sentinel");
        failed = failed + 1;
    }
    // Test 10: Interleaved read/write across wraparound
    var rb2 = rb_create(3);
    let first_two: Vec<i64> = [10, 20];
    rb2 = rb_write_all(rb2, first_two);
    let (after_drop1, _drop1) = rb_read(rb2);
    rb2 = after_drop1;
    let thirty: Vec<i64> = [30];
    rb2 = rb_write_all(rb2, thirty);
    let (after_drop2, _drop2) = rb_read(rb2);
    rb2 = after_drop2;
    let forty: Vec<i64> = [40];
    rb2 = rb_write_all(rb2, forty);
    let (after_i1, i1) = rb_read(rb2);
    rb2 = after_i1;
    let (after_i2, i2) = rb_read(rb2);
    rb2 = after_i2;
    if i1 == 30 {
        if i2 == 40 {
            println("PASS: interleaved wraparound");
            passed = passed + 1;
        } else {
            println("FAIL: interleaved wraparound");
            failed = failed + 1;
        }
    } else {
        println("FAIL: interleaved wraparound");
        failed = failed + 1;
    }
    // Summary
    println("---");
    print("Passed: ");
    println(passed);
    print("Failed: ");
    println(failed);
    if failed == 0 {
        println("ALL PASS");
    } else {
        println("SOME FAILED");
    }
}
