// Use a range for a known number of trips and a condition for the countdown.
fn main() {
    var delivered = 0;
    for trip in 1..=3 {
        delivered += 2;
        println(f"Trip {trip}: {delivered} parcels delivered");
    }
    var seconds = 3;
    while seconds > 0 {
        println(f"Departing in {seconds}");
        seconds -= 1;
    }
}
