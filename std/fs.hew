//! File system operations.
//!
//! Read, write, and query files on the local file system.
//!
//! For path-only helpers prefer `std.path`, and for stdin/stdout prefer
//! `std.io`. `fs.exists(path)` checks whether a file-system entry exists.
//!
//! # Error Handling
//!
//! `IoError` is the stable user-facing error enum for file-system failures.
//! Use the Result-returning operations in this module—such as `read`,
//! `write`, `rename`, and `copy`—with `Result<T, IoError>`
//! and the `?` operator for clean error propagation:
//!
//! ```
//! import std.fs;
//!
//! fn load_config(path: string) -> Result<string, fs.IoError> {
//!     fs.read(path)
//! }
//!
//! fn main() {
//!     match load_config("config.toml") {
//!         .Ok(data) => println(data),
//!         .Err(e) => {
//!             match e {
//!                 fs.IoError.NotFound(_) => println("missing"),
//!                 _ => println("i/o error"),
//!             }
//!         }
//!     }
//! }
//! ```

import std.encoding.utf8;

// ── Error type ───────────────────────────────────────────────────────
/// Structured error type for file-system operations.
///
/// Define `Result<T, IoError>` return types in your own functions for
/// structured error handling with the `?` operator.
///
/// For network errors (`ConnectionRefused`, `AddressInUse`, etc.) see
/// `net.NetError` in `std.net`.
pub enum IoError {
    /// The target path does not exist.
    NotFound(i64);
    /// The process lacks permission for the operation.
    PermissionDenied(i64);
    /// A file or directory already exists at the target path.
    AlreadyExists(i64);
    /// The operation timed out (e.g. the blocking pool exceeded its deadline).
    TimedOut(i64);
    /// Operation was cancelled (e.g., the blocking pool was shut down mid-call).
    ///
    /// Distinct from `TimedOut`: `TimedOut` means the deadline expired; `Cancelled`
    /// means the operation was abandoned for another reason.
    Cancelled(i64);
    /// The platform cannot perform the operation as asked, such as a Unix
    /// permission mode on Windows. The code is 0: there is no OS error.
    Unsupported(i64);
    /// Any other I/O failure. The raw code is 0 when there is no OS error,
    /// including invalid UTF-8 file contents.
    Other(i64);
}

// WASM-TODO(wasi-errno): WASI uses wasi_errno codes; add a target-aware mapping.
/// Map an OS errno integer to a structured `IoError` variant.
///
/// The i64 payload carried in each variant is the raw OS errno so callers
/// can inspect the platform value. errno=0 (no OS error) maps to `Other(0)`.
///
/// This is a raw-integer helper: it recognises POSIX errno values plus the few
/// Windows Win32 codes that do not collide with a POSIX errno (only
/// `ERROR_ALREADY_EXISTS` = 183 today). Codes that mean *different* things on
/// each platform — for example 5 (`EIO` on POSIX, `ERROR_ACCESS_DENIED` on
/// Windows) — cannot be disambiguated from the integer alone; the
/// Result-returning operations classify those correctly through the runtime's canonical error-kind
/// channel (`hew_stream_last_error_kind`) and only fall back to this function
/// for kinds without a canonical tag.
///
/// Covers file-system errno values. For network errno values use
/// `net.net_error_from_errno` in `std.net`.
pub fn io_error_from_errno(errno: i64) -> IoError {
    // ENOENT: Linux=2, macOS=2
    if errno == 2 {
        IoError.NotFound(errno)
    // EACCES: Linux=13, macOS=13
    } else if errno == 13 {
        IoError.PermissionDenied(errno)
    // EEXIST: Linux=17, macOS=17; ERROR_ALREADY_EXISTS: Windows=183.
    // 183 is not a POSIX errno, so mapping it here is unambiguous.
    } else if errno == 17 || errno == 183 {
        IoError.AlreadyExists(errno)
    // ETIMEDOUT: Linux=110, macOS=60
    } else if errno == 110 || errno == 60 {
        IoError.TimedOut(errno)
    // ECANCELED: Linux=125, macOS=89
    } else if errno == 125 || errno == 89 {
        IoError.Cancelled(errno)
    } else {
        IoError.Other(errno)
    }
}

/// Map the runtime's canonical, platform-independent error-kind tag (from
/// `hew_stream_last_error_kind`) plus the raw OS errno to an `IoError`.
///
/// The tag classifies the failure identically on every platform — POSIX and
/// Windows raw codes diverge and collide, so classification cannot be done from
/// the errno alone — while the raw errno is preserved as the variant payload.
/// Tag 0 (`IO_ERROR_KIND_UNCLASSIFIED`) means "no canonical kind": fall back to
/// `io_error_from_errno`, which keeps platform detail for kinds without a tag
/// (e.g. `EISDIR`/`ENOTDIR` -> `Other(raw)`). Keep the tag values in sync with
/// the `IO_ERROR_KIND_*` constants in `hew-runtime/src/stream_error.rs`.
///
/// Public so sibling operations that read the same runtime error channel
/// classify failures through
/// this one authority rather than re-deriving it from the raw errno.
pub fn io_error_from_kind(kind: i64, errno: i64) -> IoError {
    if kind == 1 {
        IoError.NotFound(errno)
    } else if kind == 2 {
        IoError.PermissionDenied(errno)
    } else if kind == 3 {
        IoError.AlreadyExists(errno)
    } else if kind == 4 {
        IoError.TimedOut(errno)
    } else if kind == 6 {
        IoError.Unsupported(errno)
    } else {
        io_error_from_errno(errno)
    }
}

/// Print an `IoError`'s variant name and raw OS errno.
///
/// For network errors see `impl Display for net.NetError` in `std.net`.
///
/// ```hew,no_run
/// import std.fs;
///
/// fn main() {
///     let result: Result<(), fs.IoError> = fs.delete("/tmp/scratch-file");
///     match result {
///         .Err(e) => panic(f"operation failed: {e}"),
///         .Ok(_) => {}
///     }
/// }
/// ```
impl Display for IoError {
    fn fmt(self) -> string {
        match self {
            IoError.NotFound(code) => f"NotFound({code})",
            IoError.PermissionDenied(code) => f"PermissionDenied({code})",
            IoError.AlreadyExists(code) => f"AlreadyExists({code})",
            IoError.TimedOut(code) => f"TimedOut({code})",
            IoError.Cancelled(code) => f"Cancelled({code})",
            IoError.Unsupported(code) => f"Unsupported({code})",
            IoError.Other(code) => f"Other({code})",
        }
    }
}

impl Error for IoError {}

/// Construct an `IoError.TimedOut(0)` value without a platform-specific
/// errno. Useful for in-process deadline expiry where there is no OS error
/// to map (e.g. `fs.io_error_from_errno` would need a platform-aware errno
/// constant that the caller does not have).
pub fn io_error_timed_out() -> IoError {
    IoError.TimedOut(0)
}

/// Construct an `IoError.Cancelled(0)` value without a platform-specific
/// errno. Useful for in-process cancellation (e.g. blocking pool stopped)
/// where there is no OS error to map.
pub fn io_error_cancelled() -> IoError {
    IoError.Cancelled(0)
}

fn last_io_error() -> IoError {
    unsafe {
        // Read the canonical kind BEFORE the errno: hew_stream_last_errno
        // clears the kind tag as errno metadata, so the order matters.
        let kind = hew_stream_last_error_kind() as i64;
        let errno = hew_stream_last_errno() as i64;
        let _ = hew_stream_last_error();
        io_error_from_kind(kind, errno)
    }
}

/// Read the entire contents of a file as a UTF-8 string.
///
/// Returns a structured error if the file does not exist or cannot be read.
/// Invalid UTF-8 returns `IoError.Other(0)`; an empty file is valid empty text.
///
/// # Examples
///
/// ```
/// import std.fs;
///
/// fn main() {
///     match fs.read("main.hew") {
///         .Ok(src) => println(src),
///         .Err(_) => println("could not read main.hew"),
///     }
/// }
/// ```
pub fn read(file_path: string) -> Result<string, IoError> {
    let data = read_bytes(file_path)?;
    match utf8.decode(data) {
        .Ok(text) => .Ok(text),
        .Err(_) => .Err(IoError.Other(0)),
    }
}

/// Write a string to a file, creating or overwriting it.
///
/// Returns `Ok(())` on success.
pub fn write(file_path: string, content: string) -> Result<(), IoError> {
    match unsafe {
        hew_file_write(file_path, content)
    } {
        0 => .Ok(()),
        _ => .Err(last_io_error()),
    }
}

/// Append a string to the end of a file.
///
/// Creates the file if it does not exist.
pub fn append(file_path: string, content: string) -> Result<(), IoError> {
    match unsafe {
        hew_file_append(file_path, content)
    } {
        0 => .Ok(()),
        _ => .Err(last_io_error()),
    }
}

/// Check whether a file exists at the given path.
/// # Examples
///
/// ```
/// import std.fs;
///
/// fn main() {
///     if fs.exists("config.toml") {
///         println("found config");
///     }
/// }
/// ```
pub fn exists(path: string) -> bool {
    unsafe {
        hew_file_exists(path)
    }
}

/// Delete a file.
///
/// Returns `Err(IoError.NotFound(_))` when the path is missing.
pub fn delete(file_path: string) -> Result<(), IoError> {
    match unsafe {
        hew_file_delete(file_path)
    } {
        0 => .Ok(()),
        _ => .Err(last_io_error()),
    }
}

/// Returns the size of a file in bytes.
pub fn size(path: string) -> i64 {
    unsafe {
        hew_file_size(path)
    }
}

/// Read the raw bytes of a file into a `bytes` value.
///
/// Returns a structured error on failure.
///
/// # Examples
///
/// ```hew,no_run
/// import std.fs;
///
/// fn main() {
///     let data = (fs.read_bytes("image.png")).expect("the call succeeds");
///     println(data.len());
/// }
/// ```
pub fn read_bytes(file_path: string) -> Result<bytes, IoError> {
    unsafe {
        let data = hew_file_read_bytes(file_path);
        let kind = hew_stream_last_error_kind() as i64;
        let errno = hew_stream_last_errno();
        if errno != 0 {
            // Drain the thread-local error message on the failure path,
            // mirroring `read` above, so a stale
            // `hew_file_read_bytes: ...` message can't leak into a later,
            // unrelated `hew_last_error()` / `hew_stream_last_error()` read.
            let _ = hew_stream_last_error();
            .Err(io_error_from_kind(kind, errno as i64))
        } else {
            // `data` is the sole owner of the freshly-read buffer and is not
            // used after this point, so move it straight into the result. A
            // byte-by-byte copy would be pure overhead (bytes is a CoW value).
            .Ok(data)
        }
    }
}

/// Write a `bytes` value to a file, creating or overwriting it.
///
/// Write a `bytes` value to a file, creating or overwriting it.
pub fn write_bytes(file_path: string, data: bytes) -> Result<(), IoError> {
    match unsafe {
        hew_file_write_bytes(file_path, data)
    } {
        0 => .Ok(()),
        _ => .Err(last_io_error()),
    }
}

/// Why `write_atomic` did not prove a durable replacement.
pub enum CommitError {
    /// The target is untouched and the staging file is removed.
    NotCommitted(IoError);
    /// The new content is visible but its durability is unproven: the
    /// directory sync after the rename failed (Unix only).
    Uncertain(IoError);
}

/// Print a `CommitError` with its I/O error.
impl Display for CommitError {
    fn fmt(self) -> string {
        match self {
            CommitError.NotCommitted(error) => f"NotCommitted({error})",
            CommitError.Uncertain(error) => f"Uncertain({error})",
        }
    }
}

impl Error for CommitError {}

/// Replace `path` with `data` so readers see the old content or the new,
/// never a mix, and the new content survives a crash once this returns `Ok`.
///
/// The data is written to a new staging file beside the target (mode 0600
/// on Unix, a name no existing file has), flushed to stable storage (`F_FULLFSYNC` on macOS) and renamed
/// over the target; on Unix the directory is then synced. The target ends
/// with the staging file's permissions.
///
/// # Examples
///
/// ```hew,no_run
/// import std.fs;
///
/// fn main() {
///     match fs.write_atomic("state.json", "{}".to_bytes()) {
///         .Ok(()) => println("saved"),
///         .Err(fs.CommitError.NotCommitted(e)) => println(f"kept the old state: {e}"),
///         .Err(fs.CommitError.Uncertain(e)) => println(f"saved, durability unknown: {e}"),
///     }
/// }
/// ```
pub fn write_atomic(path: string, data: bytes) -> Result<(), CommitError> {
    match unsafe {
        hew_file_write_atomic(path, data)
    } {
        0 => .Ok(()),
        1 => .Err(CommitError.NotCommitted(last_io_error())),
        _ => .Err(CommitError.Uncertain(last_io_error())),
    }
}

// ── Owners, permissions and locks ────────────────────────────────────
//
// These read and create files the way a service guarding secrets needs:
// exact Unix permission modes, no following of a final symbolic link, owner
// checks on the file that was actually opened, and a file lock released
// when its owner goes out of scope. Windows has no Unix mode or numeric
// owner, so every operation that sets or checks one returns
// `IoError.Unsupported` there; the others work on every platform.

/// What a path names.
pub enum FileKind {
    File;
    Directory;
    Symlink;
    Other;
}

/// What `metadata` and `symlink_metadata` report about a path.
pub type Metadata {
    kind: FileKind;
    /// Length in bytes.
    size: i64;
    /// The permission bits, at most `0o7777`. `None` on Windows.
    mode: Option<i64>;
    /// The owning user ID. `None` on Windows.
    owner: Option<i64>;
}

impl Metadata {
    /// Whether the path is owned by this process's user and grants nothing
    /// to group or other. Always false on Windows.
    fn is_private(self) -> bool {
        match (self.mode, self.owner, current_owner()) {
            (.Some(mode), .Some(owner), .Some(me)) => owner == me && mode & 0o077 == 0,
            _ => false,
        }
    }
}

type RawMetadata {
    status: i64;
    kind: i64;
    size: i64;
    mode: i64;
    owner: i64;
}

fn present(value: i64) -> Option<i64> {
    if value < 0 {
        .None
    } else {
        .Some(value)
    }
}

fn metadata_from(raw: RawMetadata) -> Metadata fails IoError {
    if raw.status != 0 {
        return error last_io_error();
    }
    let kind = if raw.kind == 0 {
        FileKind.File
    } else if raw.kind == 1 {
        FileKind.Directory
    } else if raw.kind == 2 {
        FileKind.Symlink
    } else {
        FileKind.Other
    };
    Metadata { kind: kind, size: raw.size, mode: present(raw.mode), owner: present(raw.owner) }
}

/// Describe the file `path` names, following symbolic links.
pub fn metadata(path: string) -> Metadata fails IoError {
    metadata_from(unsafe {
        hew_fs_metadata(path)
    })?
}

/// Describe `path` itself: for a symbolic link, the link rather than its
/// target, so `kind` is `FileKind.Symlink`.
///
/// ```hew,no_run
/// import std.fs;
///
/// fn main() {
///     match fs.symlink_metadata("/etc/hew/key") {
///         .Ok(found) => match found.kind {
///             fs.FileKind.Symlink => println("refusing a linked key"),
///             _ => println(f"private: {found.is_private()}"),
///         }
///         .Err(error) => println(f"cannot inspect: {error}"),
///     }
/// }
/// ```
pub fn symlink_metadata(path: string) -> Metadata fails IoError {
    metadata_from(unsafe {
        hew_fs_symlink_metadata(path)
    })?
}

/// The user ID that owns files this process creates, the effective user on
/// Unix. `None` on Windows.
pub fn current_owner() -> Option<i64> {
    present(unsafe {
        hew_fs_current_owner()
    })
}

/// Create `path`, which must not already exist, write `data`, set exactly the
/// permission bits `mode` whatever the umask (set-user-ID and set-group-ID
/// included) and flush it to stable storage. A final symbolic link is
/// refused, and a failure after creation removes the file. An existing path
/// is `IoError.AlreadyExists`; a mode bit the system declines (set-group-ID
/// for a group the user is not in) is `IoError.PermissionDenied`.
/// `IoError.Unsupported` on Windows.
pub fn create_new(path: string, data: bytes, mode: i64) fails IoError {
    if unsafe {
        hew_fs_create_new(path, data, mode)
    } != 0 {
        return error last_io_error();
    }
}

/// Create `path` readable and writable by its owner alone (mode `0o600`);
/// see `create_new`.
///
/// ```hew,no_run
/// import std.fs;
///
/// fn main() {
///     match fs.create_private("identity.key", b"\x01\x02") {
///         .Ok(()) => println("saved"),
///         .Err(fs.IoError.AlreadyExists(_)) => println("a key is already there"),
///         .Err(error) => println(f"cannot save: {error}"),
///     }
/// }
/// ```
pub fn create_private(path: string, data: bytes) fails IoError {
    create_new(path, data, 0o600)?
}

/// Create the directory `path`, whose parent must exist, with exactly the
/// permission bits `mode` whatever the umask. `IoError.Unsupported` on
/// Windows.
pub fn mkdir_mode(path: string, mode: i64) fails IoError {
    if unsafe {
        hew_fs_mkdir_mode(path, mode)
    } != 0 {
        return error last_io_error();
    }
}

/// Create the directory `path` usable by its owner alone (mode `0o700`); see
/// `mkdir_mode`.
pub fn mkdir_private(path: string) fails IoError {
    mkdir_mode(path, 0o700)?
}

fn read_checked(data: bytes) -> bytes fails IoError {
    if unsafe {
        hew_stream_has_error()
    } {
        return error last_io_error();
    }
    data
}

/// Read a regular file of at most `limit` bytes without following a final
/// symbolic link. A link, a directory or a device fails, and a larger file
/// fails rather than being truncated.
pub fn read_nofollow(path: string, limit: i64) -> bytes fails IoError {
    read_checked(unsafe {
        hew_fs_read_nofollow(path, limit)
    })?
}

/// As `read_nofollow`, and the opened file must be owned by this process's
/// user with no group or other permission bits, or the read fails with
/// `IoError.PermissionDenied`. The checks read the file that was opened, so a
/// file swapped in after them is never read. `IoError.Unsupported` on
/// Windows.
pub fn read_private(path: string, limit: i64) -> bytes fails IoError {
    read_checked(unsafe {
        hew_fs_read_private(path, limit)
    })?
}

/// An exclusive lock on a file, held until this value is closed or goes out
/// of scope. It excludes other `try_lock` holders, in this process or
/// another. On Unix the lock is advisory: plain reads and writes of the file
/// still succeed. On Windows it is mandatory: while it is held, other handles
/// cannot read or write the file.
#[resource]
#[opaque]
pub type FileLock {
}

impl FileLock {
    fn close(consume self) {
        unsafe {
            hew_fs_unlock(self)
        };
    }
}

/// Take the exclusive lock on `path` without waiting, creating the file if
/// absent (mode `0o600` on Unix, never through a final symbolic link).
/// `None` means another holder has it.
///
/// ```hew,no_run
/// import std.fs;
///
/// fn main() {
///     match fs.try_lock("state.lock") {
///         .Ok(.Some(lock)) => {
///             println("this process owns the state");
///             lock.close();
///         }
///         .Ok(.None) => println("another process owns the state"),
///         .Err(error) => println(f"cannot lock: {error}"),
///     }
/// }
/// ```
pub fn try_lock(path: string) -> Option<FileLock> fails IoError {
    let lock = unsafe {
        hew_fs_try_lock(path)
    };
    if unsafe {
        hew_fs_lock_is_valid(lock)
    } {
        return .Some(lock);
    }
    lock.close();
    if unsafe {
        hew_stream_has_error()
    } {
        return error last_io_error();
    }
    .None
}

/// The capacity of a file system, in bytes. `available` is what this process
/// may still use, which can be less than `free`.
pub type Space {
    total: i64;
    free: i64;
    available: i64;
}

type RawSpace {
    status: i64;
    total: i64;
    free: i64;
    available: i64;
}

/// The capacity of the file system holding `path`.
pub fn space(path: string) -> Space fails IoError {
    let raw = unsafe {
        hew_fs_space(path)
    };
    if raw.status != 0 {
        return error last_io_error();
    }
    Space { total: raw.total, free: raw.free, available: raw.available }
}

// ── Directory operations ──────────────────────────────────────────────
/// Create a directory.
///
/// Fails if any parent directory does not exist. Use `mkdir_all` to create
/// parent directories automatically.
pub fn mkdir(dir_path: string) -> Result<(), IoError> {
    match unsafe {
        hew_fs_mkdir(dir_path)
    } {
        0 => .Ok(()),
        _ => .Err(last_io_error()),
    }
}

/// Create a directory and all its parent components.
///
/// Create a directory and all its parent components.
pub fn mkdir_all(dir_path: string) -> Result<(), IoError> {
    match unsafe {
        hew_fs_mkdir_all(dir_path)
    } {
        0 => .Ok(()),
        _ => .Err(last_io_error()),
    }
}

/// List the entries in a directory.
///
/// Returns a list of entry names (not full paths).
///
/// # Examples
///
/// ```
/// import std.fs;
///
/// fn main() {
///     let entries = fs.list_dir("/tmp").expect("list_dir succeeds");
///     for entry in entries {
///         println(entry);
///     }
/// }
/// ```
pub fn list_dir(dir_path: string) -> Result<Vec<string>, IoError> {
    unsafe {
        let entries = hew_fs_list_dir(dir_path);
        let kind = hew_stream_last_error_kind() as i64;
        let errno = hew_stream_last_errno();
        let _ = hew_stream_last_error();
        if errno == 0 {
            .Ok(entries)
        } else {
            .Err(io_error_from_kind(kind, errno as i64))
        }
    }
}

/// Rename or move a file or directory.
///
pub fn rename(from: string, to: string) -> Result<(), IoError> {
    match unsafe {
        hew_fs_rename(from, to)
    } {
        0 => .Ok(()),
        _ => .Err(last_io_error()),
    }
}

/// Copy a file.
///
pub fn copy(from: string, to: string) -> Result<(), IoError> {
    match unsafe {
        hew_fs_copy(from, to)
    } {
        0 => .Ok(()),
        _ => .Err(last_io_error()),
    }
}

/// Check whether a path is a directory.
pub fn is_dir(path: string) -> bool {
    unsafe {
        hew_fs_is_dir(path)
    }
}

// ── FFI bindings ──────────────────────────────────────────────────────
#[resource]
#[opaque]
pub type FileReadStream {
}

impl FileReadStream {
    fn close(consume self) {
        unsafe {
            hew_file_read_stream_close(self)
        };
    }
}

