fn make_nested(k: i64) -> (((string, string), string), string) {
    let a = "esc-a-heap-payload".to_upper();
    let b = "esc-b-heap-payload".to_upper();
    let c = "esc-c-heap-payload".to_upper();
    let d = "esc-d-heap-payload".to_upper();
    ((( a, b ), c ), d)
}

fn deep(k: i64) -> (string, string) {
    let o = make_nested(k);
    let mid = o.0;
    let leaf = match mid {
        (l, _) => l,
    };
    leaf
}

fn run_cycle(k: i64) -> i64 {
    let l = deep(k);
    l.0.len()
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        total = total + run_cycle(i);
        i = i + 1;
    }
    if total > 0 { 0 } else { 1 }
}
