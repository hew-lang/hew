// A token signed with one algorithm must be rejected — not silently
// accepted, not crash — when decoded/validated against a different
// algorithm.
#[test]
fn test_try_decode_rejects_token_signed_with_different_algorithm() {
    let payload = "{\"exp\":4102444800,\"sub\":\"user42\"}";
    let secret = "this secret is only for Hew tests and must never be used in production";
    let token = match jwt.encode(payload, secret, "HS384") {
        .Ok(t) => t,
        .Err(err) => panic(f"{err}"),
    };
    match jwt.decode(token, secret, "HS256") {
        .Ok(_) => panic("cross-algorithm decode must not silently succeed"),
        .Err(err) => match err {
            JwtError.SignatureInvalid => assert(true),
            _ => panic(f"expected SignatureInvalid, got: {err}"),
        }
    }
}

#[test]
fn test_validate_rejects_token_signed_with_different_algorithm() {
    let payload = "{\"exp\":4102444800,\"sub\":\"user42\"}";
    let secret = "this secret is only for Hew tests and must never be used in production";
    let token = match jwt.encode(payload, secret, "HS512") {
        .Ok(t) => t,
        .Err(err) => panic(f"{err}"),
    };
    assert(!jwt.validate(token, secret, "HS256"));
}

// ── Fail-closed error path (finding JWT-3) ────────────────────────────
// A malformed token must surface the typed `TokenMalformed` error, never
// decode as success. This proves the fail-closed direction on the compiled
// path: an error never reads as Ok.
#[test]
fn test_try_decode_malformed_token_surfaces_token_malformed() {
    match jwt.decode("not-a-real-jwt", "this secret is only for Hew tests and must never be used in production", "HS256") {
        .Ok(_) => panic("malformed token must not decode as Ok"),
        .Err(err) => match err {
            JwtError.TokenMalformed => assert(true),
            _ => panic(f"expected TokenMalformed, got: {err}"),
        }
    }
}

#[test]
fn test_insecure_decode_rejects_malformed_input() {
    match jwt.decode_insecure("...") {
        .Err(.TokenMalformed) => {}
        _ => panic("malformed inspection must return a typed error"),
    }
}

#[test]
fn test_verified_decode_requires_expiration() {
    let secret = "this secret is only for Hew tests and must never be used in production";
    let token = jwt.encode("{\"sub\":\"user42\"}", secret, "HS256").expect("encode succeeds");
    match jwt.decode(token, secret, "HS256") {
        .Ok(_) => panic("verified decode must reject a token without exp"),
        .Err(JwtError.ClaimsInvalid) => assert(true),
        .Err(err) => panic(f"expected ClaimsInvalid, got: {err}"),
    }
    assert(!jwt.validate(token, secret, "HS256"));
}

#[test]
fn test_verified_decode_rejects_expired_claims() {
    let secret = "this secret is only for Hew tests and must never be used in production";
    let token = jwt.encode("{\"sub\":\"user42\",\"exp\":1}", secret, "HS256").expect("encode succeeds");
    match jwt.decode(token, secret, "HS256") {
        .Ok(_) => panic("verified decode must reject an expired token"),
        .Err(JwtError.ClaimsExpired) => assert(true),
        .Err(err) => panic(f"expected ClaimsExpired, got: {err}"),
    }
}

#[test]
fn test_hmac_keys_must_match_algorithm_strength() {
    match jwt.encode("{\"exp\":4102444800}", "short secret", "HS256") {
        .Ok(_) => panic("HS256 must reject a key shorter than 32 bytes"),
        .Err(JwtError.InvalidKey) => assert(true),
        .Err(err) => panic(f"expected InvalidKey, got: {err}"),
    }
}

#[test]
fn test_policy_requires_matching_issuer_and_audience() {
    let secret = "this secret is only for Hew tests and must never be used in production";
    let claims = "{\"aud\":\"hew-service\",\"exp\":4102444800,\"iss\":\"https://issuer.example\",\"sub\":\"user42\"}";
    let token = jwt.encode(claims, secret, "HS256").expect("encode succeeds");
    assert(jwt.decode_with_policy(token, secret, "HS256", "https://issuer.example", "hew-service").expect("policy decode succeeds") == claims);
    assert(jwt.validate_with_policy(token, secret, "HS256", "https://issuer.example", "hew-service"));
    assert(!jwt.validate_with_policy(token, secret, "HS256", "https://other.example", "hew-service"));
    assert(!jwt.validate_with_policy(token, secret, "HS256", "https://issuer.example", "other-service"));
    let array_claims = "{\"aud\":[\"hew-service\",\"other-service\"],\"exp\":4102444800,\"iss\":\"https://issuer.example\"}";
    let array_token = jwt.encode(array_claims, secret, "HS256").expect("encode succeeds");
    assert(jwt.validate_with_policy(array_token, secret, "HS256", "https://issuer.example", "hew-service"));
}

#[test]
fn test_verified_decode_rejects_audience_without_policy_even_when_malformed() {
    let secret = "this secret is only for Hew tests and must never be used in production";
    let token = jwt.encode("{\"aud\":42,\"exp\":4102444800}", secret, "HS256").expect("encode succeeds");
    match jwt.decode(token, secret, "HS256") {
        .Ok(_) => panic("verified decode must reject aud without an audience policy"),
        .Err(JwtError.ClaimsInvalid) => assert(true),
        .Err(err) => panic(f"expected ClaimsInvalid, got: {err}"),
    }
}

#[test]
fn test_policy_rejects_non_string_issuer() {
    let secret = "this secret is only for Hew tests and must never be used in production";
    let claims = "{\"aud\":\"hew-service\",\"exp\":4102444800,\"iss\":[\"https://issuer.example\"]}";
    let token = jwt.encode(claims, secret, "HS256").expect("encode succeeds");
    assert(!jwt.validate_with_policy(token, secret, "HS256", "https://issuer.example", "hew-service"));
}

#[test]
fn test_verified_decode_rejects_future_not_before_without_leeway() {
    let secret = "this secret is only for Hew tests and must never be used in production";
    let token = jwt.encode("{\"exp\":4102444800,\"nbf\":4102444700}", secret, "HS256").expect("encode succeeds");
    match jwt.decode(token, secret, "HS256") {
        .Ok(_) => panic("verified decode must reject a future nbf"),
        .Err(JwtError.ClaimsInvalid) => assert(true),
        .Err(err) => panic(f"expected ClaimsInvalid, got: {err}"),
    }
}

#[test]
fn test_jwt_error_display_formats_each_variant() {
    assert(to_string(JwtError.AlgorithmUnsupported) == "JWT algorithm is not supported");
    assert(to_string(JwtError.TokenMalformed) == "JWT payload or token is malformed");
    assert(to_string(JwtError.ClaimsInvalid) == "JWT required claims are missing or invalid");
}
