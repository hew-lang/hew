actor Worker {
    #[on(stop)]
    fn done() {
        sleep(100ms);
        println("hook finished");
    }
}

supervisor Team {
    child worker: Worker stop: 500ms;
}

fn main() {
    let team = spawn Team;
    let role = team.worker;
    stop(team);
    stopped(role);
    println("role observed");
    stopped(team);
    println("team observed");
}
