// quic_mesh/client.hew — QUIC mesh service client
//
// First run both programs without arguments to create their node keys and
// print their public credentials. Then exchange those credentials and run:
//   hew run examples/quic_mesh/server.hew <client-credential>
//   hew run examples/quic_mesh/client.hew <server-credential>
// Start this client while the server is listening. Keep each key file between
// runs so the printed credentials continue to identify the same nodes.
import std.net;
import std.os;

actor Counter {
    var count: i64;
    #[wire]
    receive fn increment(by: i64) -> i64 {
        count = count + by;
        count
    }
    #[wire]
    receive fn get_count() -> i64 {
        count
    }
}

fn authenticated_peer(credential: string) -> net.PeerSession {
    for attempt in 0..300 {
        match Node.peer(credential) {
            .Ok(peer) => return peer,
            .Err(_) => {
                if attempt == 299 {
                    panic("authenticated server session did not arrive");
                }
                sleep(50ms);
            }
        }
    }
    panic("authenticated server session did not arrive");
}

fn main() {
    let args = os.args();
    let server_credential = match args.get(1) {
        .Some(value) => value,
        .None => "--identity",
    };
    var config = NodeConfig { bind: "127.0.0.1:9001", transport: NodeTransport.QuicMesh, key: "quic-mesh-client.key", peers: [], seeds: [] };
    if server_credential != "--identity" {
        config.peers = [server_credential];
    }
    Node.start(config).expect("QUIC mesh node starts");
    println(f"[client] public credential: {Node.identity_key()}");
    if server_credential == "--identity" {
        Node.shutdown();
        return;
    }

    Node.connect("1@127.0.0.1:9000").expect("connect to pinned QUIC peer");
    let peer = authenticated_peer(server_credential);
    let counter: Counter = peer.receive_service<Counter>().expect("receive Counter service");
    println("[client] received the Counter service");

    for amount in [10, 20, 30] {
        let total = counter.increment(amount).expect("increment completes");
        println(f"[client] incremented by {amount}: total={total}");
    }
    let total = counter.get_count().expect("read completes");
    println(f"[client] final count: {total}");
    Node.shutdown();
    println("[client] shut down");
}
