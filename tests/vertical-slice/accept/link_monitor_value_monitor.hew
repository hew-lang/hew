// Value-needed monitor(): returns a Result carrying a MonitorRef resource that
// is dropped at end of scope via hew_actor_demonitor. monitor() needs an actor
// context, so the value is built inside a handler.
actor Probe {
    receive fn ping() {}
}

actor Watcher {
    receive fn watch(p: Probe) {
        let m = monitor(p);
        let _ = m;
    }
}

fn main() {
    let p = spawn Probe;
    let w = spawn Watcher;
    let _ = w.watch(p);
}
