actor Worker {
    receive fn ping() {}
}

supervisor Group {
    child first: Worker;
    child second: Worker;
}

fn same(left: Worker, right: Worker) -> bool {
    left is right
}

fn main() {
    let first = spawn Worker;
    let second = spawn Worker;
    let alias = first;
    assert(same(first, alias));
    assert(!(first is second));
    let compare = |left, right| left is right;
    assert(compare(alias, first));
    let group = spawn Group;
    let other = spawn Group;
    let role = group.first;
    assert(role is group.first);
    assert(!(role is group.second));
    assert(!(role is other.first));
    {
        let __hew_migrated_actor_622 = first;
        stop(__hew_migrated_actor_622);
        stopped(__hew_migrated_actor_622);
    };
    {
        let __hew_migrated_actor_640 = second;
        stop(__hew_migrated_actor_640);
        stopped(__hew_migrated_actor_640);
    };
    {
        let __hew_migrated_actor_659 = group;
        stop(__hew_migrated_actor_659);
        stopped(__hew_migrated_actor_659);
    };
    {
        let __hew_migrated_actor_677 = other;
        stop(__hew_migrated_actor_677);
        stopped(__hew_migrated_actor_677);
    };
    println("identity preserved");
}
