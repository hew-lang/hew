type Holder {
    next: fn[var, clone]() -> i64,
    label: string,
}

fn advance(var holder: Holder, enabled: bool) -> i64 {
    if enabled {
        holder.next();
    }
    println(holder.label);
    holder.next()
}

fn advance_pair(var pair: (fn[var, clone]() -> i64, string)) -> i64 {
    var result = 0;
    for _index in 0..2 {
        result = pair.0();
    }
    println(pair.1);
    result
}

fn main() -> i64 {
    let count = 10;
    var holder = Holder {
        next: capture(var count) || {
            count += 1;
            count
        },
        label: "private record".to_upper(),
    };
    println(advance(holder, true));
    println(holder.next());
    var pair: (fn[var, clone]() -> i64, string) = (holder.next, "private tuple".to_upper());
    println(advance_pair(pair));
    println(pair.0());
    println(holder.next());
    println(holder.label);
    println(pair.1);
    0
}
