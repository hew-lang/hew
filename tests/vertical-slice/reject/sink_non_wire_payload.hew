// Reject fixture: a pipe carries data, not handles.
//
// An actor handle is an in-process identity, not a value the element-layout
// queue witness can clone or drop, so a `Sink<Foo>` over an actor type is
// refused at the first method use.
//
// Expected: hew check exits non-zero and the error names the element-layout
// queue witness.
actor Foo {
    receive fn ping() {}
}

fn _try_send(s: Sink<Foo>) {
    s.send(spawn Foo).expect("send");
}
