// Two guarded `.Ok(sink)` arms before the unguarded one: a false guard must
// fall through with the payload intact, so the arm finally selected sends its
// text and closes the sink exactly once.
import std.stream;

fn pick(first: bool, second: bool) {
    let (writer, input): (stream.Sink<string>, stream.Stream<string>) = match stream.pipe(4) {
        .Ok(pair) => pair,
        .Err(e) => panic(e),
    };
    let opened: Result<stream.Sink<string>, string> = Ok(writer);
    match opened {
        .Ok(sink) if first => {
            sink.send("first").expect("send");
            sink.close();
        },
        .Ok(sink) if second => {
            sink.send("second").expect("send");
            sink.close();
        },
        .Ok(sink) => {
            sink.send("third").expect("send");
            sink.close();
        },
        .Err(e) => println(f"pipe failed: {e}"),
    }
    println(input.collect());
}

fn main() {
    pick(true, false);
    pick(false, true);
    pick(false, false);
}
