// Static supervisor pool — per-member restart and live re-resolution.
//
// A `simple_one_for_one` pool member crashes. Each member occupies its own
// supervised slot, so only that member restarts, and `sup.workers[i]`
// re-resolves through the live slot to the fresh member — no stale PID cached.
//
// `await_restart sup.workers[0]` is the barrier: it returns only once that
// member's own slot is Live again (or permanently gone), so the following
// access is guaranteed to reach the restarted member.
//
// Exit code 7 proves:
//   - the crashed member was restarted per member, not as a whole pool;
//   - `sup.workers[0]` re-resolved through the live slot (a stale PID would
//     reach the dead actor and trap);
//   - the restarted member answers with value 7, its init template re-applied.
actor Worker {
    var value: i64,
    receive fn get_value() -> i64 {
        value
    }
    receive fn crash_me() {
        panic("test crash — supervisor should restart this pool member");
    }
}

supervisor Pool {
    strategy: simple_one_for_one,
    intensity: 5 within 60s,

    pool workers: Worker(value: 7) count: 2,
}

fn main() -> i64 {
    let sup = spawn Pool;

    // Confirm member 0 is Live with its init value before the crash.
    let m0 = sup.workers[0];
    match m0.get_value() {
        .Err(_) => { return 0; },
        .Ok(v) => {
            if v != 7 {
                return 0;
            }
        },
    }

    // Crash member 0 (fire-and-forget). Only its own slot restarts.
    let _ = m0.crash_me();

    // Wait for that member's slot to be Live again, then read through it.
    let m0b = await_restart sup.workers[0];
    match m0b.get_value() {
        .Ok(v) => v,
        .Err(_) => 0,
    }
}
