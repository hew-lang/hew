// A coalescing mailbox replaces the queued message its key supersedes. The
// superseded message owns a string, so each replacement must release exactly
// one payload: a missed release leaks and a double release corrupts the heap.
actor Latest {
    var processed: i64 = 0,
    var length: i64 = -1,

    mailbox 1 overflow coalesce(id) fallback drop_new,

    receive fn update(id: i64, payload: string, pause: duration) {
        sleep(pause);
        processed = processed + 1;
        length = payload.len() as i64;
    }

    receive fn seen() -> i64 {
        processed
    }

    receive fn latest() -> i64 {
        length
    }
}

fn main() {
    let worker = spawn Latest(processed: 0, length: -1);
    // The first message occupies the actor, so the rest queue behind it.
    let _ = mailbox(worker, on_full: .Wait).update(0, "busy", 150ms);
    sleep(20ms);
    let _ = mailbox(worker, on_full: .Wait).update(9, "one", 0ns);
    let _ = mailbox(worker, on_full: .Wait).update(9, "two-two", 0ns);
    let _ = mailbox(worker, on_full: .Wait).update(9, "three-three-three", 0ns);
    let _ = mailbox(worker, on_full: .Wait).update(9, "latest-payload", 0ns);
    sleep(350ms);
    match worker.seen() {
        .Ok(count) => println(count),
        .Err(_) => println("failed"),
    }
    match worker.latest() {
        .Ok(length) => println(length),
        .Err(_) => println("failed"),
    }
    close(worker);
}
