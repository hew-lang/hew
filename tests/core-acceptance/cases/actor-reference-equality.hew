// `==` on actor references is handle identity, the same test `is` makes, and
// values that carry actor references compare through it.
actor Printer {
    mailbox 2 overflow fail;

    var printed: i64 = 0;

    receive fn print(job: i64) {
        printed += job;
    }
}

actor Counter {
    receive fn occupant() -> Counter {
        self
    }
}

supervisor Shop {
    strategy: one_for_one;
    intensity: 3 within 60s;

    child counter: Counter;
}

type Desk {
    name: string;
    printer: Printer;
}

fn main() {
    let first = spawn Printer;
    let second = spawn Printer;
    let alias = first;
    println(f"same handle: {first == alias}");
    println(f"other actor: {first == second}");
    println(f"not equal: {first != second}");
    println(f"agrees with is: {(first == alias) == (first is alias)}");
    let desk = Desk { name: "front", printer: first };
    println(f"record: {desk == Desk { name: "front", printer: alias }}");
    println(f"record other: {desk == Desk { name: "front", printer: second }}");
    let maybe: Option<Printer> = .Some(first);
    println(f"option: {maybe == .Some(alias)}");

    // A submission result carries the actor in its rejected request.
    println(f"accepted: {mailbox(first).print(1) == .Ok(.Accepted)}");

    // A role is equal to its aliases, and differs from the incarnation that
    // occupies it, exactly as `is` answers.
    let shop = spawn Shop;
    let role = shop.counter;
    let occupant = role.occupant().expect("counter is running");
    println(f"role alias: {role == shop.counter}");
    println(f"role vs occupant: {role == occupant} {role is occupant}");
    stop(shop);
    stopped(shop);
    stop(first);
    stopped(first);
    stop(second);
    stopped(second);
}
