//! Receive a queued channel item, then observe closure with `rx.recv()`.
//! Calls wait directly. This example exercises the ready and closed paths;
//! it does not demonstrate suspension on an empty channel with a live sender.

import std.channel.channel;

actor Worker {
    receive fn run() {
        let (tx, rx): (channel.Sender<string>, channel.Receiver<string>) = match channel.new(4) {
            .Ok(pair) => pair,
            .Err(err) => panic(f"channel.new failed: {err}"),
        };
        tx.send("ping");
        tx.close();
        match rx.recv() {
            .Some(v) => println(v),
            .None => println("closed"),
        }
        match rx.recv() {
            .Some(v) => println(v),
            .None => println("closed"),
        }
        rx.close();
    }
}

fn main() {
    let w = spawn Worker;
    let _ = w.run();
    sleep(100ms);
}
