import std.text.template;

fn main() {
    var ctx = template.new_ctx();
    ctx.set_str("name", "Grace");
    ctx.set_int("count", 3);
    let t = match template.parse("{{.name}} has {{.count}} jobs") {
        .Ok(template) => template,
        .Err(_) => panic("valid template failed to parse"),
    };
    println(template.render_template(t, ctx));
}
