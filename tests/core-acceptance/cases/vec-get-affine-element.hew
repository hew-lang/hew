// `get` and range slices copy elements and refuse clone-free pipe endpoints.
// An index instead lends the collection slot without copying or moving it.
import std.stream;

fn main() {
    let (tx, rx): (stream.Sink<i64>, stream.Stream<i64>) = match stream.pipe(4) {
        .Ok(pair) => pair,
        .Err(error) => panic(error),
    };
    tx.close();
    var receivers: Vec<stream.Stream<i64>> = Vec.new();
    receivers.push(rx);
    let _got = receivers.get(0);
    let _indexed = receivers[0];
    let _sliced = receivers[0..1];
}
