import std.stream;

actor Keeper {
    var journal: Stream<string>;
    #[on(stop)]
    fn stopping() {
        println("stop");
        panic("goodbye failed");
    }
    #[on(stop)]
    fn never() {
        println("unreachable hook");
    }
    receive fn ping() -> i64 {
        1
    }
}

fn open(path: string) -> Stream<string> {
    match stream.open(path) {
        .Ok(input) => input.lines(),
        .Err(_) => panic("fixture open failed"),
    }
}

fn main() {
    let keeper = spawn Keeper(journal: open("resource-read.bin"));
    match keeper.ping() {
        .Ok(value) => println(value),
        .Err(_) => panic("ping failed"),
    }
    {
        let __hew_migrated_actor_655 = keeper;
        stop(__hew_migrated_actor_655);
        stopped(__hew_migrated_actor_655);
    };
    println("unreachable");
}
