//! Failure-philosophy stdlib types for lifecycle hooks.
//!
//! Import `std.failure` to name `CrashInfo` or `CrashAction` explicitly
//! in a `#[on(crash)]` hook's signature. The hook observes the actor's last
//! valid state after its handlers drain and chooses the supervisor's recovery
//! action. Actor state is released after the hook returns.
//!
//! ## `CrashInfo` carries `kind` + `message`
//!
//! `kind` identifies the public crash class using `CrashKind`. `message`
//! is a heap-owned diagnostic string the runtime supplies (empty when no
//! message is available); a crash hook can log or route on it.

/// Diagnostic payload passed to `#[on(crash)]` hooks.
///
/// Match `kind` to choose a recovery action. `message` carries a heap-owned
/// diagnostic string (empty when unavailable); private runtime fault codes
/// are not part of this record.
pub type CrashInfo {
    kind: CrashKind;
    message: string;
}

/// Recovery action returned by a `#[on(crash)]` hook.
///
/// - `Restart`: apply the child's ordinary restart policy, budget and circuit
///   breaker. A `temporary` child is not restarted.
/// - `Escalate`: transfer the failure to the parent supervisor instead of
///   restarting locally. At the root the failure remains unrecovered.
/// - `GiveUp`: permanently spend the child's role and leave the failure
///   unrecovered.
pub enum CrashAction {
    Restart;
    Escalate;
    GiveUp;
}

/// Actor identity carried by a monitor or link notification.
pub enum DownTarget {
    /// A process-local actor slot.
    Local(u64);
    /// A complete remote actor location.
    Remote(Location);
}

/// Identity and class of a crash propagated to a linked actor.
///
/// Delivered to the linked actor's `#[on(link)]` hook. Remote identities retain
/// the node, actor slot and session incarnation from the authenticated notice.
/// Signal numbers, fault addresses and other private crash details stay with
/// the crashed actor and its supervisor.
pub type CrashNotification {
    target: DownTarget;
    kind: CrashKind;
}

/// Class of an actor crash, observed by crash and link hooks.
///
/// These variants are the crash classes exposed at the link boundary; more
/// detailed runtime reasons remain private to the crashed actor and supervisor.
pub enum CrashKind {
    /// Generic crash from `panic(...)`, `hew_panic()`, or an
    /// unclassified trap (SEGV / BUS / FPE / ILL / TRAP).
    Fault;
    /// Per-actor arena cap exceeded.
    HeapExceeded;
    /// A remote link became unreachable under its partition policy.
    PartitionDetected;
    /// A mailbox handler returned a declared error without a waiting caller.
    HandlerFailed;
}
