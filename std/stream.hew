//! Stream<T> and Sink<T> — the one pipe family.
//!
//! A pipe moves data between actors, sockets and files. `Stream<T>` is the
//! read half and `Sink<T>` the write half; the same two handle types cover an
//! in-memory pipe (`pipe`), a file (`open`), a socket (`Connection.split`)
//! and an actor's `receive gen fn`.
//!
//! The contract, stated once:
//!
//! - `input.recv()` returns `Option<T>`: `Some(item)` is data, `None` means
//!   every sink finished. A transport failure traps the reading actor with a
//!   typed I/O fault; the loop never sees an error value. A zero-length
//!   `bytes` or empty `string` is a valid item.
//! - `sink.send(item)` waits for capacity and returns `Result<(), SendError>`:
//!   `Err(SendError.Closed)` once the reader is gone or the sink finished.
//!   `try_send` never waits and adds `Err(SendError.Full)`.
//! - `sink.clone()` adds a producer; the pipe reaches EOF when the last one
//!   finishes. `sink.finish()` publishes EOF and keeps the handle (on a
//!   socket: FIN to the peer). `close()` on either half consumes it; scope
//!   exit releases a live half the same way.
//! - In-memory pipes carry typed values, including containers, resources and
//!   local actor references, using each element's clone, move and drop behaviour.
//! - A sink released by a crashing actor marks the pipe faulted: the consumer
//!   traps on its next read instead of reading a clean end.
//! - `Stream<T>` is a `select` source: `item from input.recv() => ...`.
//!
//! # Example
//!
//! ```
//! import std.stream;
//!
//! fn main() {
//!     let (sink, input): (stream.Sink<string>, stream.Stream<string>) =
//!         match stream.pipe(16) { .Ok(pair) => pair, .Err(error) => panic(error), };
//!
//!     sink.send("hello").expect("send");
//!     sink.send("world").expect("send");
//!     sink.close();  // optional — would auto-close on drop
//!
//!     for item in input {
//!         println(item);
//!     }
//! }
//! ```

import std.encoding.binary;

import std.encoding.utf8;

/// The read half of a pipe, parameterised by element type.
pub type Stream<T> {
}

/// The write half of a pipe, parameterised by element type.
pub type Sink<T> {
}

// ── Constructors ──────────────────────────────────────────────────────
/// Create a bounded in-memory pipe with the given capacity.
///
/// The element type is inferred from use; write it at the binding when
/// nothing else fixes it: `let (tx, rx): (stream.Sink<i64>, stream.Stream<i64>) = ...`.
pub fn pipe<T>(capacity: i64) -> Result<(Sink<T>, Stream<T>), string> {
    if capacity < 0 {
        return .Err(f"stream.pipe: invalid capacity {capacity} (must be >= 0)");
    }
    unsafe {
        let pair = hew_stream_channel(capacity as i64);
        if !hew_stream_pair_is_valid(pair) {
            let detail = hew_stream_last_error();
            if detail == "" {
                return .Err("stream.pipe: pipe allocation failed");
            }
            return .Err(detail);
        }
        let sink = pair_sink(pair);
        let input = pair_stream(pair);
        hew_stream_pair_free(pair);
        .Ok((sink, input))
    }
}

/// Open a file as a chunked `Stream<bytes>`.
///
/// Each item is one chunk of the file; `.lines()` re-frames the bytes into
/// text lines. A read failure after open traps the reading actor.
pub fn open(path: string) -> Result<Stream<bytes>, string> {
    unsafe {
        let input = hew_stream_from_file_read(path);
        if hew_stream_is_valid(input) {
            .Ok(input)
        } else {
            let detail = hew_stream_last_error();
            if detail == "" {
                return .Err(f"stream.open: could not open {path}");
            }
            .Err(detail)
        }
    }
}

/// Drain `from` into `to`, then finish `to` and release both halves.
///
/// This is the streaming equivalent of `io.Copy`: it reads until EOF and
/// writes each item downstream, waiting on the destination's capacity.
///
/// # Examples
///
/// ```hew,no_run
/// import std.net.http;
/// import std.stream;
///
/// fn main() {
///     match http.listen(":8080") {
///         .Ok(server) => {
///             let req = server.accept();
///             match stream.open("data.txt") {
///                 .Ok(file) => {
///                     let body = match req.respond_stream(200, "text/plain") {
///                         .Ok(body) => body,
///                         .Err(error) => panic(to_string(error)),
///                     };
///                     stream.forward(file.lines(), body);  // streams file to the HTTP response
///                 }
///                 .Err(e) => println(e),
///             }
///             req.close();
///             server.close();
///         }
///         .Err(_err) => println(http.listen_error()),
///     }
/// }
/// ```
#[intrinsic("stream.forward")]
pub fn forward<T>(consume from: Stream<T>, consume to: Sink<T>) {}

// ── Codecs ────────────────────────────────────────────────────────────
/// Why a frame could not be decoded.
pub enum CodecError {
    /// The bytes do not form a frame of this codec.
    Malformed(string);
}

impl Display for CodecError {
    fn fmt(self) -> string {
        match self {
            CodecError.Malformed(detail) => f"malformed frame: {detail}",
        }
    }
}

/// One `decode` step: a complete frame with the bytes after it, or the
/// buffer handed back unchanged because more bytes are needed.
pub enum Decoded<T> {
    Frame(T, bytes);
    Incomplete(bytes);
}

/// Frames bytes into typed items and back.
///
/// `decode` takes the buffered bytes and returns the first complete frame
/// with the bytes that follow it, or `Incomplete` with the bytes to keep
/// when more bytes are needed (the buffer unchanged, unless the codec
/// discarded a malformed record). `encode` returns one item's frame. Values
/// are copy-on-write, so the caller keeps what `decode` hands back: a `var`
/// parameter is the callee's own copy and cannot advance the caller's
/// buffer. `Lines`, `LengthPrefixed` and `Slip` are the shipped codecs;
/// `Stream<bytes>.lines()` is the `Lines` case as a method.
pub trait Codec<T> {
    fn decode(self, buf: bytes) -> Result<Decoded<T>, CodecError>;

    fn encode(self, item: T) -> bytes;
}

/// Newline-terminated text frames. The newline is not part of the item.
pub type Lines {
}

impl Codec<string> for Lines {
    fn decode(self, buf: bytes) -> Result<Decoded<string>, CodecError> {
        var end = -1;
        for i in 0..buf.len() {
            if end < 0 && buf[i] == 10 {
                end = i;
            }
        }
        if end < 0 {
            return .Ok(Decoded.Incomplete(buf));
        }
        let line = buf[0..end];
        let rest = buf[end + 1 .. buf.len()];
        match utf8.decode(line) {
            .Ok(text) => .Ok(Decoded.Frame(text, rest)),
            .Err(error) => .Err(CodecError.Malformed(to_string(error))),
        }
    }
    fn encode(self, item: string) -> bytes {
        var out = item.to_bytes();
        out.push(10);
        out
    }
}

/// Frames prefixed by their length: an unsigned integer of `width` bytes
/// (1, 2 or 4) in `order`, followed by that many bytes.
///
/// `decode` refuses a bad width or a declared length above `max` as
/// `Malformed`; a length-prefixed stream cannot resynchronize, so the caller
/// retires it. A zero length is a valid empty frame. `encode` panics on an
/// item longer than `max` or than the width can declare.
pub type LengthPrefixed {
    width: i64;
    order: binary.ByteOrder;
    max: i64;
}

impl Codec<bytes> for LengthPrefixed {
    fn decode(self, buf: bytes) -> Result<Decoded<bytes>, CodecError> {
        if self.width != 1 && self.width != 2 && self.width != 4 {
            return .Err(CodecError.Malformed(f"length prefix width {self.width} is not 1, 2 or 4"));
        }
        let declared = match self.order {
            binary.ByteOrder.Big => binary.read_uint_be(buf, 0, self.width),
            binary.ByteOrder.Little => binary.read_uint_le(buf, 0, self.width),
        };
        let length = match declared {
            .Ok(length) => length,
            .Err(_) => return .Ok(Decoded.Incomplete(buf)),
        };
        if length > self.max {
            return .Err(CodecError.Malformed(f"declared length {length} exceeds the maximum {self.max}"));
        }
        if buf.len() - self.width < length {
            return .Ok(Decoded.Incomplete(buf));
        }
        let frame = buf[self.width .. self.width + length];
        let rest = buf[self.width + length .. buf.len()];
        .Ok(Decoded.Frame(frame, rest))
    }
    fn encode(self, item: bytes) -> bytes {
        if item.len() > self.max {
            panic(f"stream.LengthPrefixed: item of {item.len()} bytes exceeds the maximum {self.max}");
        }
        let prefix = match self.order {
            binary.ByteOrder.Big => binary.put_uint_be(item.len(), self.width),
            binary.ByteOrder.Little => binary.put_uint_le(item.len(), self.width),
        };
        match prefix {
            .Ok(header) => {
                var out = header;
                out.append(item);
                out
            }
            .Err(error) => panic(f"stream.LengthPrefixed: cannot declare {item.len()} bytes in width {self.width}: {error}"),
        }
    }
}

/// SLIP framing (RFC 1055): each frame ends with END (0xC0); END and ESC
/// (0xDB) inside a frame are escaped as ESC 0xDC and ESC 0xDD.
///
/// `decode` skips an empty, malformed (bad escape) or oversized record to the
/// next END and returns the next good frame, so it never errors and a line
/// error costs only the damaged frame. A record without its END is buffered
/// until it decodes past `max` bytes (at most `2 * max + 2` buffered bytes);
/// then the partial record is dropped and the rest of it is skipped when
/// its END arrives. Empty frames are not representable. `encode` panics on
/// an item longer than `max`.
pub type Slip {
    max: i64;
}

impl Codec<bytes> for Slip {
    fn decode(self, buf: bytes) -> Result<Decoded<bytes>, CodecError> {
        var start = 0;
        var frame = bytes.new();
        var damaged = false;
        var i = 0;
        while i < buf.len() {
            let byte = buf[i];
            if byte == 0xC0 {
                if !damaged && frame.len() > 0 {
                    return .Ok(Decoded.Frame(frame, buf[i + 1 .. buf.len()]));
                }
                start = i + 1;
                frame = bytes.new();
                damaged = false;
            } else if !damaged {
                if byte == 0xDB {
                    let next = if i + 1 < buf.len() {
                        buf[i + 1] as i64
                    } else {
                        -1
                    };
                    if next == 0xDC {
                        frame.push(0xC0);
                        i = i + 1;
                    } else if next == 0xDD {
                        frame.push(0xDB);
                        i = i + 1;
                    } else if next != -1 {
                        damaged = true;
                    } else {
                        // A trailing ESC waits for its escaped byte.
                        return .Ok(Decoded.Incomplete(buf[start..buf.len()]));
                    }
                } else {
                    frame.push(byte);
                }
                if frame.len() > self.max {
                    damaged = true;
                }
            }
            i = i + 1;
        }
        if damaged {
            // Keep a bad escape so the rest of this record is discarded at
            // its END rather than delivered as a frame of its own.
            var marker = bytes.new();
            marker.push(0xDB);
            marker.push(0xDB);
            return .Ok(Decoded.Incomplete(marker));
        }
        .Ok(Decoded.Incomplete(buf[start..buf.len()]))
    }
    fn encode(self, item: bytes) -> bytes {
        if item.len() > self.max {
            panic(f"stream.Slip: item of {item.len()} bytes exceeds the maximum {self.max}");
        }
        var out = bytes.new();
        out.push(0xC0);
        for byte in item {
            if byte == 0xC0 {
                out.push(0xDB);
                out.push(0xDC);
            } else if byte == 0xDB {
                out.push(0xDB);
                out.push(0xDD);
            } else {
                out.push(byte);
            }
        }
        out.push(0xC0);
        out
    }
}

// ── FFI bindings ──────────────────────────────────────────────────────
/// Internal paired pipe handle: both halves before extraction.
#[resource]
#[opaque]
pub type StreamPair {
}

impl StreamPair {
    fn close(consume self) {
        unsafe {
            hew_stream_pair_free(self)
        };
    }
}

extern "C" {
    fn hew_stream_channel(capacity: i64) -> StreamPair;
    fn hew_stream_pair_is_valid(pair: StreamPair) -> bool;
    fn hew_stream_pair_free(consume pair: StreamPair);
    fn hew_stream_from_file_read(path: string) -> Stream<bytes>;
    fn hew_stream_is_valid(stream: Stream<bytes>) -> bool;
    fn hew_stream_last_error() -> string;
    // hew_stream_next_layout / hew_stream_try_next_layout /
    // hew_stream_send_layout / hew_stream_try_send_layout carry an
    // out-parameter + element-layout witness ABI and are declared by codegen
    // with the correct calling convention.
}

/// Extract the write half of a pair. Used by `std.net` to split a socket.
#[intrinsic("stream.pair_sink")]
pub fn pair_sink<T>(pair: StreamPair) -> Sink<T> {}

/// Extract the read half of a pair. Used by `std.net` to split a socket.
#[intrinsic("stream.pair_stream")]
pub fn pair_stream<T>(pair: StreamPair) -> Stream<T> {}
