actor Holder {
    var ready: bool;

    receive fn hold(v: Option<i64>) -> i64 {
        sleep(2ms);
        match v { Some(v_v) => println(f"some {v_v}"), None => println("none"), }
        ready = true;
        1
    }
}

fn main() {
    let x: Option<i64> = Some(5);
    let h = spawn Holder(ready: false);
    match await h.hold(x) {
        Ok(n) => println(f"held {n}"),
        Err(_) => println("err"),
    }
}
