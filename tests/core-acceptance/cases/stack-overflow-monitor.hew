// A monitor and a link observe an actor that exhausted its stack with the
// crash kind StackOverflow, and the watcher carries on.
import std.failure;
import std.link_monitor;

fn descend(n: i64) -> i64 {
    let below = descend(n + 1);
    below - n
}

actor Walker {
    receive fn unbounded() -> i64 {
        descend(0)
    }
}

actor Watcher {
    var exits: i64 = 0;
    var downs: i64 = 0;

    receive fn watch(target: Walker) -> link_monitor.MonitorRef {
        link(target).expect("link walker");
        monitor(target).expect("monitor walker")
    }

    receive fn counts() -> i64 {
        exits * 10 + downs
    }

    #[on(link)]
    fn exited(note: failure.CrashNotification) {
        assert(note.kind == failure.CrashKind.StackOverflow);
        exits = exits + 1;
    }

    #[on(down)]
    fn down(note: link_monitor.DownNotification) {
        assert(match note.reason {
            .Crashed(kind) => kind == failure.CrashKind.StackOverflow,
            _ => false,
        });
        downs = downs + 1;
    }
}

fn main() {
    let walker = spawn Walker;
    let watcher = spawn Watcher;
    let observation = watcher.watch(walker).expect("watch walker");
    assert(walker.unbounded().is_err());
    while watcher.counts().expect("hook outcomes") != 11 {
        sleep(1ms);
    }
    println("link and monitor saw StackOverflow");
    observation.close();
    stop(watcher);
    stopped(watcher);
}
