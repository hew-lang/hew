// A failed Option `expect` inside a std method body releases the owners the
// chain already produced and the caller's siblings before the panic leaves.
fn first_long(words: Vec<string>) -> string {
    let sibling = ["callee owner".to_upper(), "retained".to_upper()];
    println(sibling[0]);
    words.into_iter().filter(|word: string| word.len() > 10).map(|word: string| word.to_upper()).find(|word: string| !word.is_empty()).expect("a long word was present")
}

fn main() -> i64 {
    let caller = "caller owner".to_upper();
    println(caller);
    println(first_long(["short".to_upper(), "tiny".to_upper()]));
    0
}
