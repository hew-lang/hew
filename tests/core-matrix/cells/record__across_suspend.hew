type Rec {
    a: i64;
    b: string;
}

actor Holder {
    var ready: bool;

    receive fn hold(v: Rec) -> i64 {
        sleep(2ms);
        let v_a = v.a;
        let v_b = v.b;
        println(f"{v_a} {v_b}");
        ready = true;
        1
    }
}

fn main() {
    let x = Rec { a: 1, b: "x0" };
    let h = spawn Holder(ready: false);
    match await h.hold(x) {
        Ok(n) => println(f"held {n}"),
        Err(_) => println("err"),
    }
}
