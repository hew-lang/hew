//! A `bytes` value grown past its initial length inside a callee, with
//! drop-safety. `append_world` appends six bytes to the `hello` buffer it
//! receives; the pushes grow the buffer past its initial length, so the realloc
//! travels back with the returned value. The caller rebinds, reads the combined
//! buffer, and the runtime frees it exactly once at scope exit — the callee
//! never frees the buffer it hands back. A successful run prints `hello world`.

import std.encoding.utf8;

fn append_world(var b: bytes) -> bytes {
    b.push(32); // ' '
    b.push(119); // 'w'
    b.push(111); // 'o'
    b.push(114); // 'r'
    b.push(108); // 'l'
    b.push(100); // 'd'
    b
}

fn main() -> i64 {
    var b: bytes = "hello".to_bytes();
    b = append_world(b);
    let decoded_b = utf8.decode(b) handle error {
        println(f"invalid UTF-8: {error}");
        return 1;
    };
    println(decoded_b);
    0
}
