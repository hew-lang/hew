type Rec {
    name: string,
}

fn make() -> Rec {
    Rec { name: "payload-".to_upper() }
}

fn main() -> i64 {
    var r: Rec = make();
    var i: i64 = 0;
    var acc: i64 = 0;
    while i < 50 {
        if i % 2 == 0 {
            let moved: Rec = r;
            acc = acc + moved.name.len();
            r = make();
        } else {
            r = make();
        }
        i = i + 1;
    }
    r.name.len()
}
