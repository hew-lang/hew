actor Echo {
    receive fn ping() -> i64 { 0 }
}

fn main() {
    let e = spawn Echo();
    let c = {
        var v: Vec<i64> = Vec.new();
        v.push(40);
        v.push(2);
        v.iter()
    };
    let _ = e.ping();
    var sum: i64 = 0;
    for x in c {
        sum = sum + x;
    }
    print(sum);
    print("OK");
}
