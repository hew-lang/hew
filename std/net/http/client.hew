//! HTTP client module for outbound requests.
//!
//! Provides basic outbound HTTP functionality for native Hew programs via
//! `import std.net.http.client;`.
//!
//! Requests and body decoding return checked errors with operation detail.
//!
//! Response accessors: `status()`, `body()`, `header(name)`, `content_type()`,
//! `headers()` (all headers as `Vec<(string, string)>`), and `close()`.
//! The `_string` convenience helpers (`request_string`, `get_string`,
//! `post_string`) return checked results, preserving transport and decoding errors.
//!
//! # Examples
//!
//! ```hew,no_run
//! import std.net.http.client;
//!
//! fn main() {
//!     match client.get_string("https://example.com") {
//!         .Ok(body) => println(body),
//!         .Err(err) => println(f"request failed: {err}"),
//!     }
//!
//!     var headers: Vec<(string, string)> = Vec.new();
//!     headers.push(("Accept", "application/json"));
//!     let resp = client.request("GET", "https://api.example.com/data", "", headers).expect("request succeeds");
//!     println(resp.status());
//!     resp.close();
//! }
//! ```

//
// WASM-TODO(http-client): outbound std.net.http client wrappers remain native-only until
// a browser/WASM networking bridge exists.
import std.net;

/// An opaque HTTP response handle.
///
/// Obtained from `client.request(...)`, `client.get(...)`, or
/// `client.post(...)`. Responses close automatically at scope exit; call
/// `close()` to release one early.
#[resource]
#[opaque]
pub type Response {
}

/// A failed HTTP operation and its transport, protocol or decoding detail.
pub enum HttpError {
    Request(string);
    Body(string);
    Header(string);
}

impl Error for HttpError {}

impl Display for HttpError {
    fn fmt(self) -> string {
        match self {
            .Request(detail) => f"HTTP request: {detail}",
            .Body(detail) => f"HTTP body: {detail}",
            .Header(detail) => f"HTTP header: {detail}",
        }
    }
}

// ── Response methods ──────────────────────────────────────────────────
/// Methods available on an HTTP `Response`.
trait ResponseMethods {
    /// Return the HTTP status code (e.g. 200, 404). The response has a valid HTTP status.
    fn status(self) -> i64;

    /// Return a copy of the response body as a string.
    fn body(self) -> string fails HttpError;

    /// Look up a response header by name (case-insensitive).
    ///
    /// Returns `None` if the header is not present.
    fn header(self, name: string) -> Option<string> fails HttpError;

    /// Return the `Content-Type` response header.
    ///
    /// Returns `None` if not present.
    fn content_type(self) -> Option<string> fails HttpError;

    /// Return all response headers as a list of `(name, value)` pairs.
    ///
    /// The returned vector is owned by the caller; Hew frees it automatically
    /// when it goes out of scope. Returns an empty vector if no headers were
    /// captured or the response is invalid.
    fn headers(self) -> Vec<(string, string)>;
}

impl ResponseMethods for Response {
    /// Return the HTTP status code (e.g. 200, 404).
    fn status(self) -> i64 {
        unsafe {
            hew_http_response_status(self) as i64
        }
    }
    /// Return a copy of the response body as a string.
    fn body(self) -> string fails HttpError {
        let body = unsafe {
            hew_http_response_body(self)
        };
        let detail = unsafe {
            hew_http_last_error()
        };
        if !detail.is_empty() {
            return error HttpError.Body(detail);
        }
        body
    }
    /// Look up a response header by name (case-insensitive).
    fn header(self, name: string) -> Option<string> fails HttpError {
        let value = unsafe {
            hew_http_response_header(self, name)
        };
        let detail = unsafe {
            hew_http_last_error()
        };
        if !detail.is_empty() {
            return error HttpError.Header(detail);
        }
        if unsafe {
            hew_http_response_has_header(self, name)
        } {
            .Some(value)
        } else {
            .None
        }
    }
    /// Return the `Content-Type` response header.
    fn content_type(self) -> Option<string> fails HttpError {
        self.header("content-type")?
    }
    /// Return all response headers as a list of `(name, value)` pairs.
    fn headers(self) -> Vec<(string, string)> {
        unsafe {
            hew_http_response_headers(self)
        }
    }
}

impl Response {
    /// Release this response early.
    fn close(consume self) {
        unsafe {
            hew_http_response_free(self)
        };
    }
}

// ── Module-level helpers ──────────────────────────────────────────────
fn empty_headers() -> Vec<(string, string)> {
    var headers: Vec<(string, string)> = Vec.new();
    headers
}

fn content_type_headers(content_type: string) -> Vec<(string, string)> {
    var headers: Vec<(string, string)> = Vec.new();
    headers.push(("Content-Type", content_type));
    headers
}

// ── Module-level functions ────────────────────────────────────────────
/// Perform an HTTP request and return a `Response` handle.
///
/// Each header entry is a `(name, value)` pair, e.g. `("Accept", "application/json")`.
///
/// # Examples
///
/// ```hew,no_run
/// import std.net.http.client;
///
/// fn main() {
///     var headers: Vec<(string, string)> = Vec.new();
///     headers.push(("Accept", "application/json"));
///     let resp = client.request("GET", "https://example.com", "", headers).expect("request succeeds");
///     println(resp.status());
///     resp.close();
/// }
/// ```
pub fn request(method: string, url: string, body: string, headers: Vec<(string, string)>) -> Response fails HttpError {
    let response = unsafe {
        hew_http_request_hew(method, url, body, headers)
    };
    if response.status() < 0 {
        let reason = unsafe {
            hew_http_response_body(response)
        };
        let detail = unsafe {
            hew_http_last_error()
        };
        if !detail.is_empty() {
            return error HttpError.Request(detail);
        }
        return error HttpError.Request(reason);
    }
    response
}

/// Perform an HTTP request and return the response body as a string.
///
/// Each header entry is a `(name, value)` pair, e.g. `("Accept", "application/json")`.
/// Returns an error on transport or network failure. Non-2xx HTTP responses
/// still return `Ok` (the body may be empty); use `client.request`
/// to inspect the status code.
///
/// # Examples
///
/// ```hew,no_run
/// import std.net.http.client;
///
/// fn main() {
///     var headers: Vec<(string, string)> = Vec.new();
///     match client.request_string("GET", "https://example.com", "", headers) {
///         .Ok(body) => println(body),
///         .Err(err) => println(f"request failed: {err}"),
///     }
/// }
/// ```
pub fn request_string(method: string, url: string, body: string, headers: Vec<(string, string)>) -> string fails HttpError {
    let response = request(method, url, body, headers)?;
    response.body()?
}

/// Set the global outbound-request timeout, rejecting a value the C ABI
/// cannot represent rather than narrowing it into a different deadline.
pub fn set_timeout(timeout: duration) fails net.NetError {
    let checked = net.duration_ms("client.set_timeout", timeout)?;
    unsafe {
        hew_http_set_timeout(checked as i32) // INTERNAL-ABI: range-checked above
    };
}

/// Perform an HTTP GET request and return a `Response` handle.
///
/// # Examples
///
/// ```hew,no_run
/// import std.net.http.client;
///
/// fn main() {
///     let resp = client.get("https://example.com").expect("request succeeds");
///     println(resp.status());
///     resp.close();
/// }
/// ```
pub fn get(url: string) -> Response fails HttpError {
    request("GET", url, "", empty_headers())?
}

/// Perform an HTTP POST request and return a `Response` handle.
///
/// # Examples
///
/// ```hew,no_run
/// import std.net.http.client;
///
/// fn main() {
///     let resp = client.post("https://api.example.com/data", "application/json", "{}").expect("request succeeds");
///     resp.close();
/// }
/// ```
pub fn post(url: string, content_type: string, body: string) -> Response fails HttpError {
    request("POST", url, body, content_type_headers(content_type))?
}

/// Perform an HTTP GET request and return the response body as a string.
///
/// This is a convenience function that combines the request and body
/// extraction in a single call.
///
/// Returns an error on transport or network failure. Non-2xx HTTP responses
/// still return `Ok` (the body may be empty); use `client.get`
/// to inspect the status code.
///
/// # Examples
///
/// ```hew,no_run
/// import std.net.http.client;
///
/// fn main() {
///     match client.get_string("https://example.com") {
///         .Ok(body) => println(body),
///         .Err(err) => println(f"request failed: {err}"),
///     }
/// }
/// ```
pub fn get_string(url: string) -> string fails HttpError {
    request_string("GET", url, "", empty_headers())?
}

/// Perform an HTTP POST request and return the response body as a string.
///
/// Returns an error on transport or network failure. Non-2xx HTTP responses
/// still return `Ok` (the body may be empty); use `client.post`
/// to inspect the status code.
///
/// # Examples
///
/// ```hew,no_run
/// import std.net.http.client;
///
/// fn main() {
///     match client.post_string(
///         "https://api.example.com/submit",
///         "application/json",
///         "{\"key\": \"value\"}",
///     ) {
///         .Ok(body) => println(body),
///         .Err(err) => println(f"request failed: {err}"),
///     }
/// }
/// ```
pub fn post_string(url: string, content_type: string, body: string) -> string fails HttpError {
    request_string("POST", url, body, content_type_headers(content_type))?
}

// ── FFI bindings (implementation detail) ──────────────────────────────
extern "C" {
    fn hew_http_request_hew(method: string, url: string, body: string, headers: Vec<(string, string)>) -> Response;
    fn hew_http_set_timeout(timeout_ms: i32);
    fn hew_http_last_error() -> string;
    fn hew_http_response_free(consume resp: Response);
    fn hew_http_response_status(resp: Response) -> i32;
    fn hew_http_response_body(resp: Response) -> string;
    fn hew_http_response_header(resp: Response, name: string) -> string;
    fn hew_http_response_has_header(resp: Response, name: string) -> bool;
    fn hew_http_response_headers(resp: Response) -> Vec<(string, string)>;
}
