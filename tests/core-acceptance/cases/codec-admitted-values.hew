// The format modules encode and decode a bare `#[wire]` type, a literal
// collection whose element type settles only after defaulting, an encoder
// imported by name and a type parameter bounded by `Serializable`.
import std.encoding.cbor;

import std.encoding.json;

import std.encoding.yaml.{encode};

#[wire]
type Config {
    name: string @1;
    ports: Vec<i64> @2;
    tag: Option<string> @3;
}

fn show<T: Serializable>(values: Vec<T>) -> string {
    json.encode(values)
}

fn main() {
    let config = Config { name: "svc", ports: [80, 443], tag: .None };
    let text = json.encode(config);
    println(text);
    match json.decode<Config>(text) {
        .Ok(back) => println(f"{back.name} {back.ports.len()}"),
        .Err(reason) => println(f"decode failed: {reason}"),
    }
    println(json.encode([1, 2, 3]));
    let packed = cbor.encode([4, 5]);
    let unpacked: Vec<i64> = cbor.decode(packed).expect("decode");
    println(f"{unpacked.len()}");
    print(encode(["a", "b"]));
    println(show([Config { name: "x", ports: [], tag: .Some("t") }]));
    println(show([true, false]));
}
