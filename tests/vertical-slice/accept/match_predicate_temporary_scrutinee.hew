//! Accept: a literal-predicate record match on a temporary scrutinee.
//!
//! The temporary is the match's own owned aggregate; the selected arm
//! destructures it and its unbound owning fields join the arm's cleanup set.
//!
//! Observable contract: prints the selected arm's result.

type Pair { tag: i64, a: string, b: string }

fn make() -> Pair {
    Pair { tag: 0, a: "a" + "x", b: "b" + "y" }
}

fn main() -> i64 {
    let result = match make() {
        Pair { tag: 0, a, b: _ } => a.len(),
        Pair { tag: _, a: _, b: _ } => 2,
    };
    println(result);
    0
}
