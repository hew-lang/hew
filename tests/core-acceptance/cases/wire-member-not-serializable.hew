// Every member of a `#[wire]` type must be data: a resource and a nested
// `Option` are refused at the member. Plain records, tuples and a schema that
// contains itself are data and are accepted.
import std.encoding.json;

#[resource]
type Handle {
    fd: i64;
}

type Plain {
    a: i64;
}

#[wire]
type HasHandle {
    h: Handle @1;
}

#[wire]
type HasNested {
    n: Option<Option<i64>> @1;
}

#[wire]
type Tree {
    v: i64 @1;
    kids: Vec<Tree> @2;
    plain: Plain @3;
    pair: (i64, i64) @4;
}

fn main() {
    let tree = Tree { v: 1, kids: [], plain: Plain { a: 2 }, pair: (3, 4) };
    println(json.encode(tree));
}
