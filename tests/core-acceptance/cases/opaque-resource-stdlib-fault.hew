import std.process;
import std.stream;

fn fail(divisor: i64) -> i64 {
    let _pair: (Sink<bytes>, Stream<bytes>) = match stream.pipe(1) {
        .Ok(pair) => pair,
        .Err(_) => panic("bytes pipe allocation failed"),
    };
    let _output = match process.run("echo cleanup") {
        .Ok(output) => output,
        .Err(_) => panic("command failed"),
    };
    7 / divisor
}

fn main() -> i64 {
    let _caller: (Sink<string>, Stream<string>) = match stream.pipe(1) {
        .Ok(pair) => pair,
        .Err(_) => panic("text pipe allocation failed"),
    };
    fail(0)
}
