//! URL parsing.
//!
//! Parse URLs into their components (scheme, host, port, path, query,
//! fragment) and reconstruct or join them.
//!
//! # Examples
//!
//! ```
//! import std.net.url;
//!
//! fn main() {
//!     let u = url.parse("https://example.com:8080/path?key=val#frag");
//!     println(u.host());
//!     match u.port() {
//!         .Some(port) => println(port),
//!         .None => println("no port"),
//!     }
//!     u.close();
//! }
//! ```

import std.string;

import std.encoding.utf8;

/// A parsed URL.
///
/// Created by `url.parse(s)`. URLs close automatically at scope exit; call
/// `close()` to release one early.
#[opaque]
type UrlHandle {
}

#[resource]
pub type Url {
    handle: UrlHandle;
}

pub enum UrlError {
    Resolve { path: string; base: string; }
}

impl Display for UrlError {
    fn fmt(self) -> string {
        match self {
            .Resolve { path, base } => f"url.resolve: cannot resolve `{path}` against `{base}`",
        }
    }
}

impl Error for UrlError {}

/// Invalid percent-encoded text. Offsets count bytes, not Unicode scalars.
pub enum DecodeError {
    /// Offset of `%` in the encoded input, without two hexadecimal digits.
    MalformedEscape(i64);
    /// UTF-8 error position in the decoded byte sequence.
    InvalidUtf8(utf8.Utf8Error);
}

impl Display for DecodeError {
    fn fmt(self) -> string {
        match self {
            .MalformedEscape(offset) => f"malformed percent escape at byte {offset}",
            .InvalidUtf8(error) => f"decoded URL component: {error}",
        }
    }
}

impl Error for DecodeError {}

/// Methods available on a parsed `Url`.
trait UrlMethods {
    /// Return the URL scheme (e.g. `"https"`).
    fn scheme(self) -> string;

    /// Return the host name.
    fn host(self) -> string;

    /// Return the explicit port number, if specified.
    fn port(self) -> Option<i64>;

    /// Return the path component.
    fn path(self) -> string;

    /// Return the query string (without the leading `?`).
    fn query(self) -> string;

    /// Return the fragment (without the leading `#`).
    fn fragment(self) -> string;

    /// Return the full URL as a string.
    fn to_string(self) -> string;

    /// Resolve a relative path onto this URL, returning a new `Url`.
    fn resolve(self, path: string) -> Url fails UrlError;
}

impl UrlMethods for Url {
    /// Return the URL scheme (e.g. `"https"`).
    fn scheme(self) -> string {
        unsafe {
            hew_url_scheme(self.handle)
        }
    }
    /// Return the host name.
    fn host(self) -> string {
        unsafe {
            hew_url_host(self.handle)
        }
    }
    /// Return the explicit port number, if specified.
    fn port(self) -> Option<i64> {
        let port: i32 = unsafe {
            hew_url_port(self.handle)
        };
        if port < 0 {
            .None
        } else {
            .Some(port as i64)
        }
    }
    /// Return the path component.
    fn path(self) -> string {
        unsafe {
            hew_url_path(self.handle)
        }
    }
    /// Return the query string (without the leading `?`).
    fn query(self) -> string {
        unsafe {
            hew_url_query(self.handle)
        }
    }
    /// Return the fragment (without the leading `#`).
    fn fragment(self) -> string {
        unsafe {
            hew_url_fragment(self.handle)
        }
    }
    /// Return the full URL as a string.
    fn to_string(self) -> string {
        unsafe {
            hew_url_to_string(self.handle)
        }
    }
    /// Resolve a relative path onto this URL, returning a new `Url`.
    ///
    /// Fails with `UrlError.Resolve` when the path cannot be resolved against this
    /// base. A failed join produces a null handle, which is otherwise
    /// indistinguishable from a resolved URL until the handle is read.
    fn resolve(self, path: string) -> Url fails UrlError {
        let handle = unsafe {
            hew_url_join(self.handle, path)
        };
        let ok = unsafe {
            hew_url_is_valid(handle)
        };
        if ok {
            Url { handle: handle }
        } else {
            return error .Resolve { path: path, base: self.to_string() };
        }
    }
}

impl Url {
    /// Release this parsed URL early.
    fn close(consume self) {
        unsafe {
            hew_url_free(self.handle)
        };
    }
}

// ── Module-level functions ────────────────────────────────────────────
/// Parse a URL string.
///
/// Panics if the string is not a valid URL.
///
/// # Examples
///
/// ```
/// import std.net.url;
///
/// fn main() {
///     let u = url.parse("https://example.com/api/v1");
/// }
/// ```
pub fn parse(s: string) -> Url {
    unsafe {
        let u = Url { handle: hew_url_parse(s) };
        if !hew_url_is_valid(u.handle) {
            panic(f"url.parse: invalid URL: {s}");
        }
        u
    }
}

// ── Percent-encoding ──────────────────────────────────────────────────
/// Percent-encode a string (RFC 3986 unreserved characters are left unchanged).
///
/// # Examples
///
/// ```
/// import std.net.url;
///
/// fn main() {
///     let encoded = url.encode("hello world");  // "hello%20world"
/// }
/// ```
pub fn encode(s: string) -> string {
    encode_impl(s)
}

fn encode_impl(s: string) -> string {
    // RFC 3986 percent-encoding operates on the UTF-8 byte stream, not on
    // codepoints: each non-unreserved byte becomes %XX.
    let data = s.to_bytes();
    var out = "";
    for i in 0..data.len() {
        let b = data[i];
        if is_unreserved_byte(b) {
            out = out + f"{(b as i64).try_to_char().expect("valid Unicode scalar")}";
        } else {
            out = out + percent_encode_byte(b);
        }
    }
    out
}

/// Decode a percent-encoded component exactly once.
///
/// Malformed escapes and invalid decoded UTF-8 return `DecodeError`. A literal
/// `+` stays `+`; only form/query decoding treats it as a space. Valid NUL is
/// preserved. This does not split paths or normalize decoded text.
///
/// # Examples
///
/// ```
/// import std.net.url;
///
/// fn main() {
///     let decoded = url.decode("hello%20world").expect("valid component");
/// }
/// ```
pub fn decode(s: string) -> string fails DecodeError {
    decode_component(s, false)?
}

fn decode_component(s: string, form: bool) -> string fails DecodeError {
    let data = s.to_bytes();
    var out: bytes = bytes.new();
    var i = 0;
    while i < data.len() {
        let b = data[i];
        if form && b == 43 {
            out.push(32 as u8);
            i = i + 1;
            continue;
        }
        if b == 37 {
            if i + 2 >= data.len() {
                return error .MalformedEscape(i);
            }
            let hi = hex_nibble(data[i + 1]);
            let lo = hex_nibble(data[i + 2]);
            if hi < 0 || lo < 0 {
                return error .MalformedEscape(i);
            }
            out.push((hi * 16 + lo) as u8);
            i = i + 3;
            continue;
        }
        out.push(b);
        i = i + 1;
    }
    match utf8.decode(out) {
        .Ok(text) => text,
        .Err(error) => return error .InvalidUtf8(error),
    }
}

/// Decode an `application/x-www-form-urlencoded` query string into
/// `(key, value)` pairs.
///
/// Entries are separated by `&`; each entry must contain `=` and entries
/// without one are skipped, matching `encode_query`'s invalid-line convention.
/// Percent-escapes are decoded like [`decode`], and `+` decodes to a space.
/// Invalid encoding fails the whole operation instead of returning partial
/// pairs. Malformed-escape offsets are relative to the encoded key or value.
///
/// # Examples
///
/// ```
/// import std.net.url;
///
/// fn main() {
///     let pairs = url.decode_query("name=hello+world&x=a%2Bb").expect("valid query");
///     // [("name", "hello world"), ("x", "a+b")]
/// }
/// ```
pub fn decode_query(params: string) -> Vec<(string, string)> fails DecodeError {
    var decoded: Vec<(string, string)> = Vec.new();
    if (params).is_empty() {
        return decoded;
    }
    let entries = (params).split("&");
    for i in 0..entries.len() {
        let entry = entries[i];
        match entry.find("=") {
            .Some(eq) => {
                let key = entry[0..eq];
                let value = entry[eq + 1 .. entry.len()];
                decoded.push((decode_component(key, true)?, decode_component(value, true)?));
            }
            .None => {}
        }
    }
    decoded
}

/// Build a percent-encoded query string from a newline-separated list of
/// `key=value` pairs.
///
/// Each line should be `key=value`. Lines without `=` are skipped. Pairs are
/// joined with `&`.
///
/// # Examples
///
/// ```
/// import std.net.url;
///
/// fn main() {
///     let qs = url.encode_query("name=hello world\npage=1");
///     // "name=hello%20world&page=1"
/// }
/// ```
pub fn encode_query(params: string) -> string {
    encode_query_impl(params)
}

fn encode_query_impl(params: string) -> string {
    var encoded: Vec<string> = Vec.new();
    let lines = (params).lines();
    for i in 0..lines.len() {
        let line = lines[i];
        match line.find("=") {
            .Some(eq) => {
                let key = line[0..eq];
                let value = line[eq + 1 .. line.len()];
                encoded.push(encode(key) + "=" + encode(value));
            }
            .None => {}
        }
    }
    (encoded).join("&")
}

/// RFC 3986 unreserved bytes: `A-Z a-z 0-9 - . _ ~`.
fn is_unreserved_byte(b: u8) -> bool {
    b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 48 && b <= 57 || b == 45 || b == 46 || b == 95 || b == 126
}

/// Render one byte as `%XX` with uppercase hex digits.
fn percent_encode_byte(b: u8) -> string {
    let hex = "0123456789ABCDEF";
    let hi = (b / 16) as i64;
    let lo = (b % 16) as i64;
    "%" + hex[hi .. hi + 1] + hex[lo .. lo + 1]
}

fn hex_nibble(b: u8) -> i32 { // INTERNAL-ABI: nibble values 0-15 and sentinel -1; internal URL percent-decoder helper
    if b >= 48 && b <= 57 {
        (b - 48) as i32
    } else if b >= 65 && b <= 70 {
        (b - 55) as i32
    } else if b >= 97 && b <= 102 {
        (b - 87) as i32
    } else {
        -1 as i32
    }
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    fn hew_url_parse(s: string) -> UrlHandle;
    fn hew_url_is_valid(url: UrlHandle) -> bool;
    fn hew_url_scheme(url: UrlHandle) -> string;
    fn hew_url_host(url: UrlHandle) -> string;
    fn hew_url_port(url: UrlHandle) -> i32;
    fn hew_url_path(url: UrlHandle) -> string;
    fn hew_url_query(url: UrlHandle) -> string;
    fn hew_url_fragment(url: UrlHandle) -> string;
    fn hew_url_to_string(url: UrlHandle) -> string;
    fn hew_url_join(base: UrlHandle, path: string) -> UrlHandle;
    fn hew_url_free(url: UrlHandle);
}
