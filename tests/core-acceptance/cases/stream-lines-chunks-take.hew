import std.encoding.utf8;
import std.fs;
import std.os;
import std.stream;

fn main() {
    let path = f"{os.temp_dir()}/hew-stream-adaptors-{os.pid()}.txt";
    fs.write(path, "alpha\nbravo\ncharlie\ndelta\n").expect("write input");

    // `lines()` re-frames the file stream's fixed-size reads as newline-free
    // lines; `take(2)` stops before the source is drained.
    let first_two = stream.open(path).expect("open lines").lines().take(2);
    var seen = "";
    loop {
        match first_two.recv() {
            .Some(line) => { seen = seen + line + ";"; },
            .None => { break; },
        }
    }
    assert(seen == "alpha;bravo;");
    first_two.close();

    // `chunks(n)` counts bytes. The early stop leaves the file stream
    // underneath unread, so cleanup has to close the whole chain.
    let two_chunks = stream.open(path).expect("open chunks").chunks(4).take(2);
    var chunks = "";
    loop {
        match two_chunks.recv() {
            .Some(chunk) => { chunks = chunks + utf8.decode(chunk).expect("utf-8 chunk") + "|"; },
            .None => { break; },
        }
    }
    assert(chunks == "alph|a\nbr|");

    fs.delete(path).expect("remove input");
    println("stream adaptors");
}
