actor TestSink {
    var hits: i64;

    receive fn take(v: HashMap<string, i64>) -> i64 {
        let v_l = v.len();
        let v_a = match v.get("a") { Some(v_g) => v_g, None => -1, };
        println(f"len={v_l} a={v_a}");
        hits = hits + 1;
        hits
    }
}

fn main() {
    let x: HashMap<string, i64> = HashMap::new();
    x.insert("a", 1);
    x.insert("b", 2);
    let s = spawn TestSink(hits: 0);
    match await s.take(x) {
        Ok(n) => println(f"hits {n}"),
        Err(_) => println("err"),
    }
}
