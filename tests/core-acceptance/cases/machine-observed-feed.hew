import std.machine.watch;

import std.stream;

machine Counter {
    events {
        Add { value: i64; }
        Ping;
    }
    emits {
        Added { value: i64; }
    }
    state Ready { value: i64; }
    on Add: Ready => Ready {
        if event.value < 0 {
            panic("reject negative input");
        }
        emit Added { value: event.value };
        Ready { value: state.value + event.value }
    }
    default { state }
}

fn value(state: Counter) -> i64 {
    match state {
        .Ready { value } => value,
    }
}

fn ordered(consume subscriber: watch.Subscription<Counter>) {
    let one = subscriber.recv().expect("complete").expect("first notice");
    let two = subscriber.recv().expect("complete").expect("second notice");
    assert(one.revision == 1 && two.revision == 2);
    assert(one.transition.input == "Add");
    assert(two.transition.input == "Ping");
    assert(one.transition.disposition == .Taken);
    assert(two.transition.disposition == .Ignored);
    assert(value(one.state) == 4 && value(two.state) == 4);
    println("ordered");
}

fn feed_baseline(feed: watch.Feed<Counter>) -> i64 {
    let updates = feed.subscribe().expect("parallel subscription");
    updates.initial().revision
}

actor Reader {
    let feed: watch.Feed<Counter>;
    receive fn baseline() -> i64 {
        feed_baseline(self.feed)
    }
}

fn cancel_pending(feed: watch.Feed<Counter>) {
    let cancelled = scope within 10ms {
        let waiting = feed.subscribe().expect("pending subscription");
        let _ = waiting.recv();
        false
    } handle failure {
        match failure {
            .Deadline { message: _ } => true,
            .Fault { message } => panic(message),
        }
    };
    assert(cancelled);
    println("detached");
}

#[resource]
type Completion {
    done: stream.Sink<i64>;
}

impl Completion {
    fn close(consume self) {
        let _ = self.done.send(1);
    }
}

fn delayed_owned(consume completion: Completion) -> i64 {
    sleep(20ms);
    let _ = completion.done.send(2);
    41
}

fn prepared_calls() {
    let (sender, done) = stream.pipe<i64>(1).expect("completion pipe");
    let timed_out = select {
        result from delayed_owned(Completion { done: sender }) => false,
        after 1ms => true,
    };
    assert(timed_out);
    assert(done.recv() == .Some(1));
    let callback = |value: i64| -> i64 {
        sleep(1ms);
        value + 1
    };
    let answer = select {
        result from callback(8) => result,
        after 1s => panic("callback select timed out"),
    };
    assert(answer == 9);
    let count = 0;
    var counter = move capture(var count) || -> i64 {
        sleep(1ms);
        count += 1;
        count
    };
    let advanced = select {
        result from counter() => result,
        after 1s => panic("mutable callback timed out"),
    };
    assert(advanced == 1);
    assert(counter() == 2);
    let (retained_sender, retained_done) = stream.pipe<i64>(2).expect("retained task pipe");
    scope {
        select {
            result from callback(9) => {
                assert(result == 10);
            }
            result from fork delayed_owned(Completion { done: retained_sender }) => {
                assert(result == 41);
            }
        };
        assert(retained_done.recv() == .Some(2));
        assert(retained_done.recv() == .Some(1));
    };
    let identity = |<T: Send> value: T| -> T {
        sleep(1ms);
        value
    };
    let generic_answer = select {
        result from identity(12) => result,
        after 1s => panic("generic callback select timed out"),
    };
    assert(generic_answer == 12);
}

type Meter {
    count: i64;
}

impl Meter {
    fn advance(var self, delay: duration) -> i64 {
        self.count += 1;
        sleep(delay);
        self.count
    }
}

#[resource]
type MeterOwner {
    meter: Meter;
    label: string;
}

impl MeterOwner {
    fn close(consume self) {
        assert(self.meter.count == 1);
    }
}

trait Gauge {
    fn[suspends] advance(var self, delay: duration, fail: bool) -> i64;
    fn value(self) -> i64;
    fn finish(consume self) -> string;
}

#[resource]
type Reading {
    count: i64;
    label: string;
}

impl Reading {
    fn close(consume self) {
        assert(self.count == 3);
    }
}

impl Gauge for Reading {
    fn advance(var self, delay: duration, fail: bool) -> i64 {
        self.count += 1;
        sleep(delay);
        if fail {
            panic("gauge failed");
        }
        self.count
    }
    fn value(self) -> i64 {
        self.count
    }
    fn finish(consume self) -> string {
        self.label
    }
}

fn prepared_methods() {
    var meter = Meter { count: 0 };
    let one = select {
        result from meter.advance(1ms) => result,
        after 1s => panic("method timed out"),
    };
    assert(one == 1 && meter.count == 1);
    let timeout = select {
        result from meter.advance(1s) => false,
        after 1ms => true,
    };
    assert(timeout && meter.count == 2);
    let cancelled = scope within 1ms {
        select {
            result from meter.advance(1s) => {}
            after 2s => {}
        };
        false
    } handle failure { true };
    assert(cancelled && meter.count == 3);
    let pair = (Meter { count: 0 }, 0);
    var captured = move capture(var pair) || -> i64 {
        let timed_out = select {
            result from pair.0.advance(1s) => false,
            after 1ms => true,
        };
        assert(timed_out);
        pair.0.count
    };
    assert(captured() == 1 && captured() == 2);
    var field = MeterOwner { meter: Meter { count: 0 }, label: "held".to_upper() };
    let field_timeout = select {
        result from field.meter.advance(1s) => false,
        after 1ms => true,
    };
    assert(field_timeout && field.meter.count == 1);
    var staged: Counter = .Ready { value: 0 };
    let report = select {
        result from staged.step(.Add { value: 5 }) => result,
        after 1s => panic("staged step timed out"),
    };
    assert(value(staged) == 5 && report.outputs.len() == 1);
    let staged_failed = scope {
        select {
            result from staged.step(.Add { value: -1 }) => {}
            after 1s => {}
        };
        false
    } handle failure { true };
    assert(staged_failed && value(staged) == 5);
    var gauge: dyn (Gauge + Send + Sync) = Reading { count: 0, label: "retained".to_upper() };
    let dynamic_one = select {
        result from gauge.advance(1ms, false) => result,
        after 1s => panic("dynamic method timed out"),
    };
    assert(dynamic_one == 1 && gauge.value() == 1);
    let dynamic_timeout = select {
        result from gauge.advance(1s, false) => false,
        after 1ms => true,
    };
    assert(dynamic_timeout && gauge.value() == 2);
    let failed = scope {
        select {
            result from gauge.advance(1ms, true) => {}
            after 1s => {}
        };
        false
    } handle failure { true };
    assert(failed && gauge.value() == 3);
    let label = select {
        result from gauge.finish() => result,
        after 1s => panic("consuming method timed out"),
    };
    assert(label == "RETAINED");
}

fn reusable_select() {
    let (owner, feed) = watch.observe(Counter.Ready { value: 0 }, capacity: 2, subscribers: 1).expect("select owner");
    var live = owner;
    let updates = feed.subscribe().expect("select subscription");
    let timed_out = select {
        item from updates.recv() => false,
        after 1ms => true,
    };
    assert(timed_out);
    let _ = live.step(.Add { value: 8 });
    let received = select {
        item from updates.recv() => item.expect("no lag").expect("notice").revision,
        after 1s => panic("select notice timed out"),
    };
    assert(received == 1);
    let cancelled = scope within 1ms {
        select {
            item from updates.recv() => {}
            after 1s => {}
        };
        false
    } handle failure { true };
    assert(cancelled);
    let _ = live.step(.Ping);
    assert(updates.recv().expect("later read").expect("later notice").revision == 2);
    live.close();
    assert(updates.recv().expect("end").is_none());
}

fn main() {
    reusable_select();
    prepared_calls();
    prepared_methods();
    let original: Counter = .Ready { value: 0 };
    let (owner, feed) = watch.observe(original, capacity: 2, subscribers: 3).expect("observe");
    var live = owner;
    cancel_pending(feed);
    let baseline = fork feed_baseline(feed);
    assert(await baseline == 0);
    let reader = spawn Reader { feed };
    assert(reader.baseline().expect("reader reply") == 0);
    terminate(reader);
    let first = feed.subscribe().expect("first");
    let copied_feed = feed;
    let second = copied_feed.subscribe().expect("second");
    let slow = feed.subscribe().expect("slow");
    assert(first.initial().revision == 0);
    assert(value(first.initial().state) == 0);
    assert(feed.subscribe().is_err());
    let step = live.step(.Add { value: 4 });
    assert(step.outputs.len() == 1);
    assert(step.rules == [0]);
    let _ignored = live.step(.Ping);
    ordered(first);
    ordered(second);
    let _next = live.step(.Add { value: 3 });
    match slow.recv() {
        .Err(lag) => {
            assert(lag.last_seen == 0 && lag.available_from == 2);
            println("lagged");
        }
        _ => panic("slow observer silently skipped history"),
    }
    let drain = feed.subscribe().expect("replacement subscription");
    assert(drain.initial().revision == 3);
    assert(value(drain.initial().state) == 7);
    let failed = scope {
        let _ = live.step(.Add { value: -1 });
        false
    } handle failure { true };
    assert(failed);
    let _last = live.step(.Add { value: 2 });
    live.close();
    let final_notice = drain.recv().expect("retained").expect("final notice");
    assert(final_notice.revision == 4 && value(final_notice.state) == 9);
    assert(drain.recv().expect("closed").is_none());
    assert(feed.subscribe().is_err());
    assert(value(original) == 0);
    println("closed");
    let (other, other_feed) = watch.observe(original, capacity: 1, subscribers: 1).expect("independent owner");
    var independent = other;
    let independent_subscriber = other_feed.subscribe().expect("independent subscription");
    assert(independent_subscriber.initial().revision == 0);
    let _ = independent.step(.Add { value: 20 });
    let independent_notice = independent_subscriber.recv().expect("independent delivery").expect("independent notice");
    assert(independent_notice.revision == 1 && value(independent_notice.state) == 20);
    independent.close();
    assert(independent_subscriber.recv().expect("independent close").is_none());
}
