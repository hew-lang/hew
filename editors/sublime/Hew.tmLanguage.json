{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hew",
  "scopeName": "source.hew",
  "fileTypes": ["hew"],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#wire-annotations"
    },
    {
      "include": "#legacy-syntax"
    },
    {
      "include": "#paths"
    },
    {
      "include": "#function-definitions"
    },
    {
      "include": "#actors"
    },
    {
      "include": "#callable-syntax"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#types"
    },
    {
      "include": "#closures"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.inner.hew",
          "match": "//!.*$"
        },
        {
          "name": "comment.line.documentation.hew",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.hew",
          "match": "//.*$"
        },
        {
          "name": "comment.block.hew",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "string-escape": {
      "name": "constant.character.escape.hew",
      "match": "\\\\(n|r|t|\\\\|\"|0|x[0-9a-fA-F]{2})"
    },
    "strings": {
      "patterns": [
        {
          "comment": "Char literal: 'a', '\\n'",
          "name": "string.quoted.single.char.hew",
          "match": "'([^'\\\\]|\\\\.)'"
        },
        {
          "comment": "Byte string literal: b\"data\"",
          "name": "string.quoted.byte.hew",
          "begin": "b\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "comment": "Interpolated string: f\"hello {name}\"",
          "name": "string.interpolated.hew",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.interpolation.hew",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.hew"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.hew"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            },
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "comment": "Regex literal: re\"pattern\"",
          "name": "string.regexp.hew",
          "begin": "re\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "comment": "Raw string: r\"no escapes\"",
          "name": "string.quoted.raw.hew",
          "begin": "r\"",
          "end": "\""
        },
        {
          "comment": "Regular double-quoted string",
          "name": "string.quoted.double.hew",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "comment": "Duration literals: 100ms, 5s, 1h",
          "name": "constant.numeric.duration.hew",
          "match": "\\b[0-9][0-9_]*(ns|us|ms|s|m|h)\\b"
        },
        {
          "comment": "Hex integer: 0xFF",
          "name": "constant.numeric.hex.hew",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "comment": "Octal integer: 0o17",
          "name": "constant.numeric.octal.hew",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "comment": "Binary integer: 0b1010",
          "name": "constant.numeric.binary.hew",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "comment": "Float: 3.14, 1.0e-5",
          "name": "constant.numeric.float.hew",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?\\b"
        },
        {
          "comment": "Decimal integer",
          "name": "constant.numeric.integer.hew",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "attributes": {
      "comment": "Attribute syntax: #[test], #[inline]",
      "name": "meta.attribute.hew",
      "begin": "#\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.begin.hew"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.end.hew"
        }
      },
      "patterns": [
        {
          "name": "entity.name.function.attribute.hew",
          "match": "[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "include": "#strings"
        }
      ]
    },
    "wire-annotations": {
      "comment": "Wire field tags (@1, @2) and loop labels (@outer, @inner)",
      "patterns": [
        {
          "comment": "Wire field tag: @1, @2",
          "name": "constant.numeric.wire-tag.hew",
          "match": "@\\d+"
        },
        {
          "comment": "Loop / block label: @outer, @inner",
          "name": "entity.name.label.hew",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "Failure return `return error <expr>`. After `return`, `error` begins a failure return unless an operator, call, index, `?`, `as`, `else`, `handle` or terminator follows, in which case it stays an ordinary binding.",
          "match": "\\b(return)\\s+(error)(?=\\s+(?!(?:as|else|handle)\\b)[A-Za-z0-9_\"'{.])",
          "captures": {
            "1": {
              "name": "keyword.control.hew"
            },
            "2": {
              "name": "keyword.control.failure.hew"
            }
          }
        },
        {
          "comment": "Failure clause `-> T fails E`: `fails` after a return type, before the error type.",
          "name": "keyword.control.failure.hew",
          "match": "(?<=[\\w>\\])]\\s)\\s*\\bfails\\b(?=\\s+[A-Za-z_(\\[])"
        },
        {
          "comment": "`clone <operand>` — the eager copy-on-write cost operation. A contextual prefix operator, highlighted only in prefix position: preceded by a non-member, non-word char and followed by whitespace then an operand start. This deliberately skips `x.clone()`, `fn clone(`, `clone(args)`, and `clone = ...` where `clone` stays an ordinary identifier.",
          "name": "keyword.operator.clone.hew",
          "match": "(?<![.\\w])clone(?=\\s+[A-Za-z0-9_\"'\\[{])"
        },
        {
          "comment": "The contextual keywords `state` and `from` as field labels in a field list (`{ state: s }`, `{ from, to }`, `{ to, from }`) are ordinary names. A lone `{ state }` stays the keyword: it is the block yielding the source state.",
          "name": "variable.other.hew",
          "match": "(?:(?<=[{,])|(?<=[{,]\\s))\\b(?:state|from)\\b(?=\\s*(?::(?!:)|,))|(?:(?<=,)|(?<=,\\s))\\b(?:state|from)\\b(?=\\s*})"
        },
        {
          "comment": "Control flow",
          "name": "keyword.control.hew",
          "match": "\\b(after|await|await_restart|break|continue|defer|else|for|from|if|in|loop|match|race|return|scope|select|while|yield)\\b"
        },
        {
          "comment": "Declarations",
          "name": "keyword.declaration.hew",
          "match": "\\b(as|const|enum|extern|fn|gen|impl|import|indirect|let|package|pub|trait|type|var|where)\\b"
        },
        {
          "comment": "Actor and concurrency",
          "name": "keyword.actor.hew",
          "match": "\\b(actor|fork|init|move|receive|spawn)\\b"
        },
        {
          "comment": "Supervisor",
          "name": "keyword.supervisor.hew",
          "match": "\\b(child|restart|strategy|supervisor)\\b"
        },
        {
          "comment": "Supervisor strategy and overflow policy values",
          "name": "constant.language.strategy.hew",
          "match": "\\b(one_for_all|one_for_one|permanent|rest_for_one|simple_one_for_one|temporary|transient)\\b"
        },
        {
          "comment": "Wire protocol keywords",
          "name": "keyword.wire.hew",
          "match": "\\b(deprecated|optional|reserved)\\b"
        },
        {
          "comment": "State machine keywords",
          "name": "keyword.control.machine.hew",
          "match": "\\b(entry|event|exit|machine|on|state|when)\\b"
        },
        {
          "comment": "Other keywords",
          "name": "keyword.other.hew",
          "match": "\\b(dyn|is|unsafe)\\b"
        },
        {
          "comment": "Boolean literals",
          "name": "constant.language.boolean.hew",
          "match": "\\b(false|true)\\b"
        },
        {
          "comment": "None literal",
          "name": "constant.language.none.hew",
          "match": "\\bNone\\b"
        },
        {
          "comment": "Removed/rejected keywords — parser explicitly rejects these with migration diagnostics. Highlight as invalid so users know these are not valid v0.6 syntax.",
          "name": "invalid.removed.hew",
          "match": "\\b(await_restart|brutal_kill|catch|cooperate|foreign|try)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "comment": "Raw pointer type prefix *const/*mut — valid only in extern/FFI/unsafe context. *var T is LEGACY and rejected by the parser.",
          "name": "meta.type.pointer.raw.hew",
          "match": "(\\*)\\s*(const|mut)\\b",
          "captures": {
            "1": {
              "name": "keyword.operator.pointer.hew"
            },
            "2": {
              "name": "storage.modifier.pointer-mutability.hew"
            }
          }
        },
        {
          "comment": "Numeric types",
          "name": "storage.type.numeric.hew",
          "match": "\\b(f32|f64|i16|i32|i64|i8|isize|u16|u32|u64|u8|usize)\\b"
        },
        {
          "comment": "Primitive types",
          "name": "storage.type.primitive.hew",
          "match": "\\b(bool|bytes|char|duration|instant|string)\\b"
        },
        {
          "comment": "Generic / collection types",
          "name": "storage.type.generic.hew",
          "match": "\\b(Arc|Err|HashMap|HashSet|Ok|Option|Range|Rc|Result|Some|Vec|Weak)\\b"
        },
        {
          "comment": "Concurrency types",
          "name": "storage.type.concurrency.hew",
          "match": "\\b(Generator|RemotePid|Scope|Sink|Stream|Task)\\b"
        },
        {
          "comment": "Built-in trait names",
          "name": "storage.type.trait.hew",
          "match": "\\b(Copy|Frozen|Send)\\b"
        },
        {
          "comment": "Self types",
          "name": "storage.type.self.hew",
          "match": "\\bSelf\\b"
        },
        {
          "comment": "PascalCase type name",
          "name": "entity.name.type.hew",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "comment": "Consuming receiver; consume remains an identifier elsewhere.",
          "name": "meta.parameter.receiver.hew",
          "match": "\\b(consume)\\s+(self)\\b",
          "captures": {
            "1": {
              "name": "storage.modifier.receiver.hew"
            },
            "2": {
              "name": "variable.language.self.hew"
            }
          }
        },
        {
          "comment": "Generator function definition (gen fn and receive gen fn)",
          "match": "\\b((?:receive\\s+)?gen)\\s+(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.hew"
            },
            "2": {
              "name": "keyword.declaration.hew"
            },
            "3": {
              "name": "entity.name.function.hew"
            }
          }
        },
        {
          "comment": "Receive fn definition",
          "match": "\\b(receive)\\s+(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.actor.hew"
            },
            "2": {
              "name": "keyword.declaration.hew"
            },
            "3": {
              "name": "entity.name.function.hew"
            }
          }
        },
        {
          "comment": "Named receive handler: receive Ping(...)",
          "match": "\\b(receive)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "keyword.actor.hew"
            },
            "2": {
              "name": "entity.name.function.hew"
            }
          }
        },
        {
          "comment": "Function definition",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.hew"
            },
            "2": {
              "name": "entity.name.function.hew"
            }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "comment": "Function call (placed after keywords to prevent matching if/match/etc.)",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.hew"
            }
          }
        }
      ]
    },
    "actors": {
      "patterns": [
        {
          "comment": "Actor declaration",
          "match": "\\b(actor)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.actor.hew"
            },
            "2": {
              "name": "entity.name.type.actor.hew"
            }
          }
        },
        {
          "comment": "Supervisor declaration",
          "match": "\\b(supervisor)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.supervisor.hew"
            },
            "2": {
              "name": "entity.name.type.supervisor.hew"
            }
          }
        },
        {
          "comment": "Trait declaration",
          "match": "\\b(trait)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.hew"
            },
            "2": {
              "name": "entity.name.type.trait.hew"
            }
          }
        },
        {
          "comment": "Machine declaration",
          "match": "\\b(machine)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.machine.hew"
            },
            "2": {
              "name": "entity.name.type.machine.hew"
            }
          }
        },
        {
          "comment": "Enum declaration",
          "match": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.hew"
            },
            "2": {
              "name": "entity.name.type.enum.hew"
            }
          }
        },
        {
          "comment": "Impl Trait for Type",
          "match": "\\b(impl)\\s+([A-Z][a-zA-Z0-9_]*)\\s+(for)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.hew"
            },
            "2": {
              "name": "entity.name.type.trait.hew"
            },
            "3": {
              "name": "keyword.declaration.hew"
            },
            "4": {
              "name": "entity.name.type.hew"
            }
          }
        },
        {
          "comment": "Child spec in supervisor",
          "match": "\\b(child)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*:\\s*([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.supervisor.hew"
            },
            "2": {
              "name": "variable.other.hew"
            },
            "3": {
              "name": "entity.name.type.hew"
            }
          }
        },
        {
          "comment": "Spawn expression",
          "match": "\\b(spawn)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.actor.hew"
            },
            "2": {
              "name": "entity.name.type.hew"
            }
          }
        }
      ]
    },
    "legacy-syntax": {
      "patterns": [
        {
          "comment": "Retired turbofish syntax: Vec::<T>(). The compiler reports E_LEGACY_TURBOFISH and suggests the migrated dotted form.",
          "name": "invalid.removed.hew",
          "begin": "(::)(<)",
          "end": "(>)",
          "patterns": [
            {
              "include": "#types"
            },
            {
              "name": "punctuation.separator.comma.hew",
              "match": ","
            }
          ]
        },
        {
          "comment": "Retired dotted glob import syntax: import a.b.*. The compiler reports E_IMPORT_GLOB_REMOVED.",
          "name": "invalid.removed.hew",
          "match": "\\.\\*"
        },
        {
          "comment": "Retired :: path separator. The compiler reports E_PATH_LEGACY_SEPARATOR and suggests a dotted path.",
          "name": "invalid.removed.hew",
          "match": "::"
        },
        {
          "name": "invalid.removed.hew",
          "match": "\\basync\\s+gen\\s+fn\\b",
          "comment": "Generator functions no longer use an async modifier."
        },
        {
          "name": "invalid.removed.hew",
          "match": "\\|\\s*after\\b",
          "comment": "Timeouts use select or scope deadlines."
        },
        {
          "name": "invalid.removed.hew",
          "match": "\\bfor\\s+await\\b",
          "comment": "Stream iteration uses plain for and waits for each item automatically."
        }
      ]
    },
    "closures": {
      "patterns": [
        {
          "comment": "Pipe closure parameters following an expression introducer, move, actor or a private capture list. Logical and bitwise operators keep their ordinary scopes.",
          "begin": "(?<=[=(,\\[]\\s*|=>\\s*|\\bmove\\s+|\\bactor\\s+|\\bcapture\\s*\\([^)]*\\)\\s*)(\\|)(?!\\|)(?=[^|]*\\|)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.begin.hew"
            }
          },
          "end": "(\\|)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.end.hew"
            }
          },
          "patterns": [
            {
              "include": "#types"
            },
            {
              "name": "variable.parameter.hew",
              "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.colon.hew",
              "match": ":"
            },
            {
              "name": "punctuation.separator.comma.hew",
              "match": ","
            }
          ]
        }
      ]
    },
    "paths": {
      "patterns": [
        {
          "comment": "Explicit import selection syntax: import module.{Name, Other}. The import prefix prevents invalid value.{Name} expressions from receiving this scope.",
          "name": "meta.import.selection.hew",
          "begin": "\\b(import)(?=\\s+[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*\\.\\{)",
          "end": "(\\})",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.hew"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.section.selection.end.hew"
            }
          },
          "patterns": [
            {
              "match": "(\\.)(\\{)",
              "captures": {
                "1": {
                  "name": "punctuation.accessor.selection.hew"
                },
                "2": {
                  "name": "punctuation.section.selection.begin.hew"
                }
              }
            },
            {
              "include": "#keywords"
            },
            {
              "name": "punctuation.accessor.path.hew",
              "match": "\\.(?!\\{)"
            },
            {
              "include": "#types"
            },
            {
              "include": "#variables"
            },
            {
              "name": "punctuation.separator.comma.hew",
              "match": ","
            }
          ]
        },
        {
          "comment": "Contextual enum variant: .Variant.",
          "match": "(?<![A-Za-z0-9_])(\\.)([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.variant.hew"
            },
            "2": {
              "name": "entity.name.variant.hew"
            }
          }
        },
        {
          "comment": "Dotted path segment: std.time, value.method.",
          "name": "punctuation.accessor.path.hew",
          "match": "(?<!\\.)\\.(?![.\\{])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "comment": "Arrow operators",
          "name": "keyword.operator.arrow.hew",
          "match": "->|=>"
        },
        {
          "comment": "Range operators",
          "name": "keyword.operator.range.hew",
          "match": "\\.\\.=|\\.\\.(?!\\.)"
        },
        {
          "comment": "Removed regex match operators — parser rejects with E_REGEX_OP_REMOVED",
          "name": "invalid.removed.hew",
          "match": "=~|!~"
        },
        {
          "comment": "Logical operators",
          "name": "keyword.operator.logical.hew",
          "match": "&&|\\|\\|"
        },
        {
          "comment": "Bitwise shift compound assignment",
          "name": "keyword.operator.assignment.compound.hew",
          "match": "<<=|>>="
        },
        {
          "comment": "Bitwise shift operators",
          "name": "keyword.operator.bitwise.shift.hew",
          "match": "<<|>>"
        },
        {
          "comment": "Comparison operators",
          "name": "keyword.operator.comparison.hew",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "comment": "Bitwise compound assignment",
          "name": "keyword.operator.assignment.compound.bitwise.hew",
          "match": "&=|\\|=|\\^="
        },
        {
          "comment": "Compound assignment operators",
          "name": "keyword.operator.assignment.compound.hew",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "comment": "Assignment operator",
          "name": "keyword.operator.assignment.hew",
          "match": "="
        },
        {
          "comment": "Bitwise XOR operator",
          "name": "keyword.operator.bitwise.xor.hew",
          "match": "\\^"
        },
        {
          "comment": "Bitwise NOT operator",
          "name": "keyword.operator.bitwise.not.hew",
          "match": "~"
        },
        {
          "comment": "Wrapping arithmetic operators: &+ &- &* (two's-complement overflow semantics, maximal-munch — only when no whitespace separates & from the following +/-/*)",
          "name": "keyword.operator.wrapping.hew",
          "match": "&[+\\-*]"
        },
        {
          "comment": "Arithmetic operators",
          "name": "keyword.operator.arithmetic.hew",
          "match": "[+\\-*/%]"
        },
        {
          "comment": "Optional default: value ?? fallback",
          "name": "keyword.operator.coalesce.hew",
          "match": "\\?\\?"
        },
        {
          "comment": "Error propagation",
          "name": "keyword.operator.question.hew",
          "match": "\\?"
        },
        {
          "comment": "Logical not",
          "name": "keyword.operator.not.hew",
          "match": "!"
        },
        {
          "comment": "Attribute / wire tag marker",
          "name": "keyword.operator.at.hew",
          "match": "@"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.brackets.round.hew",
          "match": "[()]"
        },
        {
          "name": "punctuation.brackets.curly.hew",
          "match": "[{}]"
        },
        {
          "name": "punctuation.brackets.square.hew",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.comma.hew",
          "match": ","
        },
        {
          "name": "punctuation.terminator.semicolon.hew",
          "match": ";"
        },
        {
          "name": "punctuation.separator.colon.hew",
          "match": ":"
        },
        {
          "name": "punctuation.separator.dot.hew",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.pipe.hew",
          "match": "\\|"
        },
        {
          "name": "punctuation.separator.ampersand.hew",
          "match": "&"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "comment": "self reference",
          "name": "variable.language.self.hew",
          "match": "\\bself\\b"
        },
        {
          "comment": "Wildcard pattern",
          "name": "variable.language.wildcard.hew",
          "match": "\\b_\\b"
        },
        {
          "comment": "Contextual identifiers (special meaning in specific contexts)",
          "name": "variable.language.contextual.hew",
          "match": "\\b(block|clone|coalesce|consume|default|drop_new|drop_old|emit|emits|error|events|export|fail|fails|fallback|handle|initial|intensity|json|mailbox|overflow|pool|reenter|repeated|stop|suspends|wired_to|within|yaml)\\b"
        },
        {
          "comment": "Identifier (catch-all for variables, parameters, fields)",
          "name": "variable.other.hew",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "callable-syntax": {
      "patterns": [
        {
          "name": "meta.type.callable-capabilities.hew",
          "begin": "\\b(fn)\\s*(\\[)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.hew"
            },
            "2": {
              "name": "punctuation.section.brackets.begin.hew"
            }
          },
          "end": "(\\])",
          "endCaptures": {
            "1": {
              "name": "punctuation.section.brackets.end.hew"
            }
          },
          "patterns": [
            {
              "name": "keyword.callable-capability.hew",
              "match": "\\b(var|once|clone|suspends)\\b"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        {
          "name": "meta.closure.capture.hew",
          "begin": "(?<![.\\w])(capture)\\s*(\\()(?=\\s*var\\b)",
          "beginCaptures": {
            "1": {
              "name": "keyword.closure.capture.hew"
            },
            "2": {
              "name": "punctuation.section.parens.begin.hew"
            }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": {
              "name": "punctuation.section.parens.end.hew"
            }
          },
          "patterns": [
            {
              "name": "keyword.closure.capture-mutability.hew",
              "match": "\\bvar\\b"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#variables"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    }
  }
}
