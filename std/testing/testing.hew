//! Controls for deterministic Hew tests and runs.

/// Return the seed selected for this deterministic run.
pub fn seed() -> u64 {
    if !unsafe { hew_test_driver_active() } {
        panic("testing.seed requires deterministic execution");
    }
    unsafe { hew_test_seed() }
}

/// Run ready actors and tasks until nothing is ready or due at the current
/// virtual time. The clock does not advance.
pub fn settle() {
    if !unsafe { hew_test_driver_active() } {
        panic("testing.settle requires deterministic execution");
    }
    unsafe { hew_test_settle(); }
}

extern "C" {
    fn hew_test_driver_active() -> bool;
    fn hew_test_seed() -> u64;
    fn hew_test_settle();
}
