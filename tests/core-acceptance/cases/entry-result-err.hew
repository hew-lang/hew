enum AppError {
    Failed(string);
}

impl Display for AppError {
    fn fmt(self) -> string {
        match self {
            AppError.Failed(message) => "failed: " + message,
        }
    }
}

impl Error for AppError {
}

fn check(value: i64) -> Result<(), AppError> {
    if value > 2 {
        return .Err(AppError.Failed("too large"));
    }
    .Ok(())
}

// A `main` that returns its Result as a value exits exactly as one that
// fails through its edge.
fn main() -> Result<(), AppError> {
    let held = "held:" + "err";
    println(held);
    let checked = check(3);
    if checked.is_ok() {
        println("unreachable");
    }
    checked
}
