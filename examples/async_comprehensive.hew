//! Status: runnable
//! Description: Comprehensive actor completion-call demo for Hew language

// Comprehensive actor completion-call demo for Hew language
actor Calculator {
    receive fn simple_calculation(n: i64) -> i64 {
        let result = n * 2 + 1;
        result
    }
}

actor Messenger {
    receive fn print_message(msg: i64) -> i64 {
        println(msg);
        0
    }
}

fn main() {
    // Actor call with return value.
    let calculator = spawn Calculator;
    let r = calculator.simple_calculation(21);
    match r {
        .Ok(result) => println(result),
        .Err(_) => println(-1),
    }
    // Actor completion-call with discarded return value.
    let messenger = spawn Messenger;
    let _ = messenger.print_message(123);
    println(999);
}
