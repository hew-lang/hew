fn main() {
    let x: bytes = bytes.new();
    x.push(65);
    x.push(66);
    let v: Vec<bytes> = Vec.new();
    v.push(x);
    match v.get(0) {
        Option.Some(e) => {
            let e_l = e.len();
            let e_0 = e[0];
            println(f"len={e_l} b0={e_0}");
        },
        None => println("missing"),
    }
}
