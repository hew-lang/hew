enum Colour { Red, Green, Blue, }

fn tag(c: Colour) -> i64 {
    match c {
        Colour.Red => 1,
        Colour.Green => 2,
        Colour.Blue => 3,
    }
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        var v: Vec<Colour> = Vec.new();
        v.push(Colour.Red);
        v.push(Colour.Green);
        total = total + v.len() + tag(v[0]);
        i = i + 1;
    }
    total
}
