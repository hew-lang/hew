//! Generic Vec<T>::contains must re-resolve through the concrete element ABI.

type VecContainsName {
    label: string,
}

fn generic_contains<T>(xs: Vec<T>, needle: T) -> bool {
    xs.contains(needle)
}

#[test]
fn test_generic_vec_contains_i64_string_owned_record() {
    var ints: Vec<i64> = Vec.new();
    ints.push(10);
    ints.push(20);
    assert(generic_contains(ints, 20));
    assert(!generic_contains(ints, 99));
    var names: Vec<string> = Vec.new();
    names.push("ada");
    names.push("grace");
    assert(generic_contains(names, "grace"));
    assert(!generic_contains(names, "linus"));
    var records: Vec<VecContainsName> = Vec.new();
    records.push(VecContainsName { label: "owned" });
    records.push(VecContainsName { label: "record" });
    assert(generic_contains(records, VecContainsName { label: "record" }));
    assert(!generic_contains(records, VecContainsName { label: "missing" }));
}
