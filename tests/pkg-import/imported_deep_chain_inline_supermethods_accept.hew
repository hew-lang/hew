// Separate impls satisfy every level of the imported supertrait chain.
import hew.supertraits.{Base, Mid, Deep};

type DW {
    id: i64,
}

impl Base for DW {
    fn base(w: DW) -> i64 {
        w.id
    }
}

impl Mid for DW {
    fn mid(w: DW) -> i64 {
        w.id + 1
    }
}

impl Deep for DW {
    fn deep(w: DW) -> i64 {
        w.id + 2
    }
}

fn main() {
    let w = DW { id: 7 };
    println(f"deep {w.deep()} mid {w.mid()} base {w.base()}");
}
