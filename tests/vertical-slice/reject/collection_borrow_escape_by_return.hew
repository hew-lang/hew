// A borrowed collection element (v[i] over a close-obligated element type)
// must not escape the frame: the collection is its single release authority,
// so a returned borrow would be read by the caller AFTER the collection closed
// it (use-after-close) and closed a second time by any downstream owner.
#[resource]
type Tok {
    id: i64
}

impl Tok {
    fn close(self) {
        println(f"close {self.id}");
    }
}

fn take() -> Tok {
    let v: Vec<Tok> = Vec.new();
    v.push(Tok { id: 1 });
    let e = v[0];
    return e;
}

fn main() {
    let t = take();
    let i = t.id;
    println(f"got {i}");
}