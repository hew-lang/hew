// A permanently dead supervised role produces a ready error in both an
// ordinary call and a select arm. The error arm must beat the timer without
// trapping. Exhausting the root supervisor's restart budget still owns the
// process exit status; the stdout sentinel proves the recoverable call results.
actor Worker {
    var value: i64 = 5,
    receive fn get_value() -> i64 {
        value
    }
    receive fn crash_me() {
        panic("worker crash");
    }
}

supervisor App {
    strategy: one_for_one,
    intensity: 1 within 60s,

    child w1: Worker(value: 5),
}

fn main() -> i64 {
    let sup = spawn App;
    let w = sup.w1;
    // The budget is one restart, so the second crash leaves the role
    // permanently dead; each `await_restart` waits for the ruling on the crash
    // its own call already observed.
    let _ = w.crash_me();
    let _ = await_restart sup.w1;
    let _ = w.crash_me();
    let _ = await_restart sup.w1;

    // Single-shot ask to a permanently-dead child: recoverable Err, NOT a trap.
    let ask_code = match w.get_value() {
        .Ok(_) => 1,
        .Err(_) => 20,
    };
    // A terminal error is a completion, not an indefinitely pending source:
    // a pending one would hang this selection.
    let select_code = select {
        reply from w.get_value() => match reply {
            .Ok(value) => value,
            .Err(_) => 25,
        },
    };
    let sentinel = if ask_code == 20 && select_code == 25 {
        46
    } else {
        ask_code + select_code
    };
    println(f"DEAD_CHILD_SELECT:{sentinel}");
    0
}
