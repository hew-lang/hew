fn f() -> Result<bytes, string> {
    .Ok("g2429-bytes-payload".to_bytes())
}

fn main() -> i64 {
    var total = 0;
    var i = 0;
    while i < 50 {
        match f() {
            .Ok(b) => { total = total + b.len(); }
            .Err(e) => {}
        }
        i = i + 1;
    }
    if total > 0 { 0 } else { 1 }
}
