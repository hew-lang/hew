// A selection over mixed sources takes the first one that is ready. The forked
// task sleeps well past the pipe's readiness, so the pipe arm wins even
// though the task arm is written first; the loser is neither cancelled nor
// consumed, and the scope joins it on exit.
import std.stream;

fn slow() -> i64 {
    sleep(60ms);
    // Printed only if the losing task runs to completion. A cancelled task
    // would join too, so this line is what separates joined from cancelled.
    println("slow finished");
    return 7;
}

fn main() {
    let (tx, rx): (stream.Sink<string>, stream.Stream<string>) =
        match stream.pipe(4) {
            .Ok(pair) => pair,
            .Err(error) => {
                println(error);
                return;
            },
        };
    tx.send("payload-with-owned-heap").expect("send");
    scope {
        let winner = fork slow();
        select {
            v from winner => println(f"task {v}"),
            v from rx.recv() => match v {
                .Some(item) => println(f"channel {item}"),
                .None => println("channel closed"),
            },
        }
    }
    println("scope joined");
    // The losing arm never consumed the receiver, so it still drains.
    tx.send("second").expect("send");
    tx.close();
    match rx.recv() {
        .Some(item) => println(f"after {item}"),
        .None => println("after closed"),
    }
    rx.close();
}
