import std.net;

import std.stream;

actor Acceptor {
    let ready: stream.Sink<i64>;
    receive fn run() {
        let listener = net.listen("127.0.0.1:0").expect("listen");
        defer {
            listener.close();
            println("accept admission cancelled");
        }
        ready.send(listener.local_port()).expect("ready");
        sleep(100ms);
        let connection = listener.accept().expect("accept");
        connection.close();
        panic("admission unexpectedly accepted");
    }
}

fn main() {
    let (ready, entered): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("pipe");
    let acceptor = spawn Acceptor { ready: ready };
    mailbox(acceptor, on_full: .Wait).run().expect("start");
    entered.recv().expect("listener bound");
}
