// File-import library for the mixed-import dedup regression.
//
// Deliberately declares a `TestResult` type, a `TestResultMethods` trait, and an
// `impl TestResultMethods for TestResult` whose BARE names collide exactly with the
// distinct `TestResult` / `TestResultMethods` / `impl` the `hew.testffi` PACKAGE
// declares. Hew's per-module-type-identity model makes these two genuinely
// different types that merely share a bare name. The earlier
// bare-name dedup key (`"TestResult:TestResultMethods"`) collapsed both, silently
// dropping the package-import impl; the provenance-based skip keeps both.
type TestResult {
    handle: i64,
}

trait TestResultMethods {
    fn tag(self) -> i32;
}

impl TestResultMethods for TestResult {
    fn tag(self) -> i32 {
        (self.handle * 10) as i32
    }
}
