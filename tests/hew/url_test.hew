//! Tests for the std::net::url percent-encoding helpers.

import std.net.url;

import std.string;

#[test]
fn test_encode_preserves_existing_ascii_behaviour() {
    assert(url.encode("") == "");
    assert(url.encode("hello world") == "hello%20world");
    assert(url.encode("a=1&b=2") == "a%3D1%26b%3D2");
}

#[test]
fn test_encode_utf8_bytes_as_uppercase_hex() {
    assert(url.encode("café") == "caf%C3%A9");
    assert(url.encode("éx🙂z") == "%C3%A9x%F0%9F%99%82z");
}

#[test]
fn test_decode_preserves_existing_behaviour() {
    assert(url.decode("hello%20world") == "hello world");
    assert(url.decode("bad%2Zseq") == "bad%2Zseq");
    assert(url.decode("plus+sign") == "plus+sign");
}

#[test]
fn test_decode_invalid_utf8_returns_empty_string() {
    assert(url.decode("%FF%FE") == "");
}

#[test]
fn test_decode_preserves_decoded_nul_and_unicode() {
    let nul = string.from_char(0);
    assert(url.decode("%00") == nul);
    assert(url.decode("a%00b") == "a" + nul + "b");
    assert(url.decode("%C3%A9x%F0%9F%99%82z") == "éx🙂z");
    assert(url.decode("%E2%82") == "");
    assert(url.decode("%ED%A0%80") == "");
}

#[test]
fn test_decode_query_empty_returns_empty_vec() {
    let pairs = url.decode_query("");
    assert(pairs.len() == 0);
}

#[test]
fn test_decode_query_decodes_form_pairs_in_order() {
    let pairs = url.decode_query("name=hello+world&x=a%2Bb&empty=&a=b=c");
    assert(pairs.len() == 4);
    assert(pairs[0].0 == "name");
    assert(pairs[0].1 == "hello world");
    assert(pairs[1].0 == "x");
    assert(pairs[1].1 == "a+b");
    assert(pairs[2].0 == "empty");
    assert(pairs[2].1 == "");
    assert(pairs[3].0 == "a");
    assert(pairs[3].1 == "b=c");
}

#[test]
fn test_decode_query_preserves_nul_and_rejects_invalid_utf8() {
    let pairs = url.decode_query("value=a%00b&invalid=%FF&incomplete=%E2%82");
    assert(pairs[0].1 == "a" + string.from_char(0) + "b");
    assert(pairs[1].1 == "");
    assert(pairs[2].1 == "");
}

#[test]
fn test_decode_query_skips_entries_without_equals() {
    let pairs = url.decode_query("skip-me&ok=yes&&also=no");
    assert(pairs.len() == 2);
    assert(pairs[0].0 == "ok");
    assert(pairs[0].1 == "yes");
    assert(pairs[1].0 == "also");
    assert(pairs[1].1 == "no");
}

#[test]
fn test_port_returns_none_when_absent() {
    let parsed = url.parse("http://localhost/path");
    let port = parsed.port();
    parsed.close();
    if let .Some(value) = port {
        panic(f"expected None, got Some({value})");
    }
}

#[test]
fn test_port_returns_some_when_explicit() {
    let parsed = url.parse("http://localhost:8080/path");
    let port = parsed.port();
    parsed.close();
    match port {
        .Some(value) => assert(value == 8080),
        .None => panic("expected Some(8080), got None"),
    }
}

#[test]
fn test_encode_query_skips_invalid_lines_and_uses_first_equals() {
    assert(url.encode_query("name=hello world\nskip-me\na=b=c") == "name=hello%20world&a=b%3Dc");
}

#[test]
fn test_encode_query_matches_existing_pair_encoding() {
    assert(url.encode_query("name=hello world\r\npage=1&2\nother=a+b") == "name=hello%20world&page=1%262&other=a%2Bb");
}
