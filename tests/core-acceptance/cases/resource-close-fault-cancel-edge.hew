// A losing race operand is cancelled while holding a resource whose close
// fails. The frame releases the operand's owner on the cancellation edge and
// records the close fault against the cancellation. The race then consumes its
// own cancellation marker, which leaves the close fault as the surviving
// failure: a cancellation is a request, and a cleanup that genuinely failed
// during it is not something the request answers for.
import std.stream;

#[resource]
type Conn { fd: i64, }

impl Conn {
    fn close(consume self) {
        println(f"close {self.fd}");
        panic(f"close {self.fd} failed");
    }
}

fn cancelled(parked: stream.Sink<i64>, gate: stream.Stream<i64>) -> i64 {
    let conn = Conn { fd: 9 };
    parked.send(1).expect("parked");
    gate.recv();
    conn.fd
}

fn winner(parked: stream.Stream<i64>) -> i64 {
    parked.recv();
    7
}

fn main() {
    let (_hold, gate): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("gate");
    let (parked_tx, parked): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("parked");
    let picked = race { winner(parked), cancelled(parked_tx, gate) };
    println(f"picked {picked}");
}
