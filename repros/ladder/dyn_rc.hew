trait Show {
    fn show(self) -> i64;
}

type Holder {
    r: Rc<i64>;
}

impl Show for Holder {
    fn show(self) -> i64 {
        self.r.get()
    }
}

fn main() {
    let h = Holder { r: Rc.new(5) };
    let w = h.r.downgrade();
    let d: dyn Show = h;
    println(f"{d.show()}");
    match w.upgrade() {
        .Some(v) => println("alive"),
        .None => println("dead"),
    }
}
