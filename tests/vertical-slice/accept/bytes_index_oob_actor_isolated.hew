// EXIT: 1
actor BytesIndexCrasher {
    receive fn boom() {
        var b: bytes = bytes.new();
        b.push(1);
        let _x: u8 = b[99];
    }
}

actor BytesIndexProbe {
    receive fn ping() -> i64 {
        0
    }
}

fn main() -> i64 {
    let crasher = spawn BytesIndexCrasher;
    let probe = spawn BytesIndexProbe;
    let _ = crasher.boom();
    sleep(300ms);
    match probe.ping() {
        .Ok(v) => v,
        .Err(_) => 1,
    }
}
