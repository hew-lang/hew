import std.net;

fn cycle() -> i64 {
    let addr = "10.0.0.1:8080".to_upper();
    let Endpoint { host, port } = match net.parse_endpoint("oracle", addr) {
        .Ok(e) => e,
        .Err(err) => { panic("bad"); }
    };
    host.len() + port
}

fn main() -> i64 {
    var total: i64 = 0;
    for i in 0..50 {
        total = total + cycle();
    }
    total
}
