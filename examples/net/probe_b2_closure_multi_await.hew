//! Closure probe with two reads from a captured connection.
//! Each ordinary read waits for data or EOF; the closure must preserve its
//! captured handle across suspension. `await_e2e` runs this under both pools.

import std.encoding.utf8;

import std.net.{Listener};

extern "C" {
    fn hew_tcp_listener_local_port(listener: Listener) -> i32;
}

actor Reader {
    let addr: string,

    receive fn go(unused: i64) {
        sleep(200ms);
        let conn = match net.connect(addr) {
            .Ok(conn) => conn,
            .Err(_) => panic(f"network setup failed"),
        };
        let read_twice = move || {
            let first = utf8.decode(conn.read());
            let second = utf8.decode(conn.read());
            let _ = conn.close();
            (first, second)
        };
        let (first_result, second_result) = read_twice();
        let first = first_result handle error {
            println(f"invalid UTF-8: {error}");
            return;
        };
        let second = second_result handle error {
            println(f"invalid UTF-8: {error}");
            return;
        };
        let body = f"{first}|{second}";
        println(f"reader-received: {body}");
    }
}

fn main() {
    let listener = match net.listen("127.0.0.1:0") {
        .Ok(listener) => listener,
        .Err(_) => panic(f"network setup failed"),
    };
    let port = unsafe {
        hew_tcp_listener_local_port(listener)
    };
    let reader = spawn Reader(addr: f"127.0.0.1:{port}");
    fork reader.go(0);
    let client = listener.accept();
    let _ = client.write_string("payload");
    sleep(300ms);
    let _ = client.close();
    sleep(300ms);
    println("server-done");
}
