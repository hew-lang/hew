// Cuckoo Hashing with 2 hash functions and 2 tables
// Insert displaces existing elements on collision
//
// A parameter is the callee's own copy, so insert and remove return both
// tables in parameter order followed by their result, and the caller
// reassigns each one.
fn hash1(key: i64, capacity: i64) -> i64 {
    let h = key % capacity;
    if h < 0 {
        h + capacity
    } else {
        h
    }
}

fn hash2(key: i64, capacity: i64) -> i64 {
    // Use capacity-1 as modulus to avoid systematic collisions
    let m = capacity - 1;
    let h = (key * 11 + 7) % m;
    if h < 0 {
        h + m
    } else {
        h
    }
}

fn make_table(capacity: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec.new();
    let EMPTY = 0 - 1;
    for i in 0 .. capacity {
        v.push(EMPTY);
    }
    v
}

fn cuckoo_insert(var t1: Vec<i64>, var t2: Vec<i64>, key: i64) -> (Vec<i64>, Vec<i64>, bool) {
    let capacity = t1.len();
    let EMPTY = 0 - 1;
    let max_loops = capacity * 2;
    // Check if already present
    let idx1 = hash1(key, capacity);
    if t1[idx1] == key {
        return (t1, t2, true);
    }
    let idx2 = hash2(key, capacity);
    if t2[idx2] == key {
        return (t1, t2, true);
    }
    var cur = key;
    var i = 0;
    while i < max_loops {
        // Try table 1
        let pos1 = hash1(cur, capacity);
        let old1 = t1[pos1];
        t1.set(pos1, cur);
        if old1 == EMPTY {
            return (t1, t2, true);
        }
        cur = old1;

        // Try table 2
        let pos2 = hash2(cur, capacity);
        let old2 = t2[pos2];
        t2.set(pos2, cur);
        if old2 == EMPTY {
            return (t1, t2, true);
        }
        cur = old2;
        i = i + 1;
    }
    (t1, t2, false)
}

// Insert each key in turn; reports false if any insert hit the loop limit.
fn cuckoo_insert_all(var t1: Vec<i64>, var t2: Vec<i64>, keys: Vec<i64>) -> (Vec<i64>, Vec<i64>, bool) {
    var all_ok = true;
    for key in keys {
        let (next1, next2, ok) = cuckoo_insert(t1, t2, key);
        t1 = next1;
        t2 = next2;
        if !ok {
            all_ok = false;
        }
    }
    (t1, t2, all_ok)
}

fn cuckoo_lookup(t1: Vec<i64>, t2: Vec<i64>, key: i64) -> bool {
    let capacity = t1.len();
    let idx1 = hash1(key, capacity);
    if t1[idx1] == key {
        return true;
    }
    let idx2 = hash2(key, capacity);
    if t2[idx2] == key {
        return true;
    }
    false
}

fn cuckoo_remove(var t1: Vec<i64>, var t2: Vec<i64>, key: i64) -> (Vec<i64>, Vec<i64>, bool) {
    let capacity = t1.len();
    let EMPTY = 0 - 1;
    let idx1 = hash1(key, capacity);
    if t1[idx1] == key {
        t1.set(idx1, EMPTY);
        return (t1, t2, true);
    }
    let idx2 = hash2(key, capacity);
    if t2[idx2] == key {
        t2.set(idx2, EMPTY);
        return (t1, t2, true);
    }
    (t1, t2, false)
}

fn cuckoo_size(t1: Vec<i64>, t2: Vec<i64>) -> i64 {
    let capacity = t1.len();
    let EMPTY = 0 - 1;
    var count = 0;
    for i in 0 .. capacity {
        if t1[i] != EMPTY {
            count = count + 1;
        }
        if t2[i] != EMPTY {
            count = count + 1;
        }
    }
    count
}

fn main() {
    var passed = 0;
    var failed = 0;
    let cap = 16;
    // Test 1: Basic insert and lookup
    let (seeded1, seeded2, _seeded_ok) = cuckoo_insert_all(make_table(cap), make_table(cap), [5, 10, 15]);
    var t1 = seeded1;
    var t2 = seeded2;
    if cuckoo_lookup(t1, t2, 5) {
        if cuckoo_lookup(t1, t2, 10) {
            if cuckoo_lookup(t1, t2, 15) {
                println("PASS: insert and lookup");
                passed = passed + 1;
            } else {
                println("FAIL: insert and lookup");
                failed = failed + 1;
            }
        } else {
            println("FAIL: insert and lookup");
            failed = failed + 1;
        }
    } else {
        println("FAIL: insert and lookup");
        failed = failed + 1;
    }
    // Test 2: Lookup missing key
    if cuckoo_lookup(t1, t2, 99) {
        println("FAIL: lookup missing");
        failed = failed + 1;
    } else {
        println("PASS: lookup missing");
        passed = passed + 1;
    }
    // Test 3: Size
    let sz = cuckoo_size(t1, t2);
    if sz == 3 {
        println("PASS: size");
        passed = passed + 1;
    } else {
        print("FAIL: size, got ");
        println(sz);
        failed = failed + 1;
    }
    // Test 4: Duplicate insert doesn't increase size
    let (dup1, dup2, _dup_ok) = cuckoo_insert(t1, t2, 5);
    t1 = dup1;
    t2 = dup2;
    let sz2 = cuckoo_size(t1, t2);
    if sz2 == 3 {
        println("PASS: duplicate insert");
        passed = passed + 1;
    } else {
        print("FAIL: duplicate insert, size ");
        println(sz2);
        failed = failed + 1;
    }
    // Test 5: Remove
    let (pruned1, pruned2, _removed) = cuckoo_remove(t1, t2, 10);
    t1 = pruned1;
    t2 = pruned2;
    if cuckoo_lookup(t1, t2, 10) {
        println("FAIL: remove");
        failed = failed + 1;
    } else {
        let sz3 = cuckoo_size(t1, t2);
        if sz3 == 2 {
            println("PASS: remove");
            passed = passed + 1;
        } else {
            println("FAIL: remove");
            failed = failed + 1;
        }
    }
    // Test 6: Displacement chains - insert keys that collide in table 1
    var all_ok = true;
    // Keys 3, 19, 35 all hash to 3 in table 1 (mod 16), causing displacements
    let (chained1, chained2, _chain_ok) = cuckoo_insert_all(make_table(16), make_table(16), [3, 19, 35]);
    var t1b = chained1;
    var t2b = chained2;
    if !cuckoo_lookup(t1b, t2b, 3) {
        all_ok = false;
    }
    if !cuckoo_lookup(t1b, t2b, 19) {
        all_ok = false;
    }
    if !cuckoo_lookup(t1b, t2b, 35) {
        all_ok = false;
    }
    if all_ok {
        println("PASS: displacement chains");
        passed = passed + 1;
    } else {
        println("FAIL: displacement chains");
        failed = failed + 1;
    }
    // Test 7: Remove and re-insert
    let (without1, without2, _dropped) = cuckoo_remove(t1b, t2b, 19);
    let (again1, again2, _readded) = cuckoo_insert(without1, without2, 19);
    t1b = again1;
    t2b = again2;
    if cuckoo_lookup(t1b, t2b, 19) {
        println("PASS: remove and re-insert");
        passed = passed + 1;
    } else {
        println("FAIL: remove and re-insert");
        failed = failed + 1;
    }
    // Test 8: Multiple elements test
    var triples: Vec<i64> = Vec.new();
    for i in 0 .. 20 {
        triples.push(i * 3);
    }
    let (t1c, t2c, insert_ok) = cuckoo_insert_all(make_table(32), make_table(32), triples);
    var lookup_ok = true;
    for i in 0 .. 20 {
        if !cuckoo_lookup(t1c, t2c, i * 3) {
            lookup_ok = false;
        }
    }
    if insert_ok {
        if lookup_ok {
            let szc = cuckoo_size(t1c, t2c);
            if szc == 20 {
                println("PASS: multiple elements");
                passed = passed + 1;
            } else {
                print("FAIL: multiple elements, size ");
                println(szc);
                failed = failed + 1;
            }
        } else {
            println("FAIL: multiple elements lookup");
            failed = failed + 1;
        }
    } else {
        println("FAIL: multiple elements insert");
        failed = failed + 1;
    }
    // Summary
    println("---");
    print("Passed: ");
    println(passed);
    print("Failed: ");
    println(failed);
    if failed == 0 {
        println("ALL PASS");
    } else {
        println("SOME FAILED");
    }
}
