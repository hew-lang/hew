//! Bounded concurrent adapters for owned iterators.
//!
//! Adapters own their source and start work when iterated. Closing an adapter,
//! leaving its loop early, or cancelling its consumer cancels and joins its
//! child tasks before releasing the source and buffered values.

import std.stream;
import std.semaphore;

/// Whether map emits source order or the order in which workers finish.
pub enum Order {
    Input;
    Completion;
}

type Job<T> {
    index: i64;
    value: T;
    lease: semaphore.Lease;
}

type Inbox<T> {
    sink: Sink<Job<T>>;
}

type Completed<T> {
    index: i64;
    value: T;
    lease: semaphore.Lease;
}

fn produce<I, T>(consume source: I, consume output: Sink<T>) where I: Iterator<Item = T> {
    for value in source {
        if output.send(value).is_err() {
            return;
        }
    }
}

/// Read ahead into a bounded channel using one producer task.
///
/// `capacity` must be positive. The source and its items must be Send. The
/// channel holds at most `capacity` items, with one further item in the producer.
pub gen fn prefetch<I, T>(consume source: I, capacity: i64 = 8) -> T where I: Iterator<Item = T> + Send, T: Send {
    assert(capacity > 0);
    scope {
        let (output, input): (Sink<T>, Stream<T>) = stream.pipe(capacity).expect("pipeline capacity");
        let producer = fork produce(source, output);
        for value in input {
            yield value;
        }
        await producer;
    };
}

fn dispatch<I, T, U>(consume source: I, consume inboxes: Vec<Inbox<T>>, consume ready: Stream<i64>, consume permits: semaphore.Semaphore, consume output: Sink<Result<Completed<U>, ScopeFailure>>) where I: Iterator<Item = T> {
    scope {
        var index = 0;
        for value in source {
            let lease = permits.lease();
            let worker = match ready.recv() {
                .Some(worker) => worker,
                .None => return,
            };
            if inboxes[worker].sink.send(Job { index, value, lease }).is_err() {
                return;
            }
            index = index + 1;
        }
    } handle failure {
        let _ = output.send(.Err(failure));
    };
}

fn work<T, U>(id: i64, consume input: Stream<Job<T>>, consume output: Sink<Result<Completed<U>, ScopeFailure>>, consume ready: Sink<i64>, transform: fn[clone, suspends](consume T) -> U) {
    scope {
        loop {
            if ready.send(id).is_err() {
                return;
            }
            let job = match input.recv() {
                .Some(job) => job,
                .None => return,
            };
            let Job { index, value, lease } = job;
            let mapped = transform(value);
            if output.send(.Ok(Completed { index, value: mapped, lease })).is_err() {
                return;
            }
        }
    } handle failure {
        let _ = output.send(.Err(failure));
    };
}

/// Transform items with at most `concurrency` workers.
///
/// Input order is the default; Completion emits each available result. A
/// shared admission limit bounds active jobs and results waiting for emission.
/// Each worker receives its own copy of the cloneable transform, whose captures
/// must be Send. Failures propagate through the owning scope; items are not retried.
/// The transform owns each input. It may return that same resource to forward
/// ownership downstream, or return a new value. Inputs left in the transform
/// receive ordinary cleanup on return, fault or cancellation.
/// `concurrency` must be positive.
pub gen fn map<I, T, U>(consume source: I, transform: fn[clone, suspends](consume T) -> U, concurrency: i64 = 4, order: Order = .Input) -> U where I: Iterator<Item = T> + Send, T: Send, U: Send {
    assert(concurrency > 0);
    scope {
        let (output, input): (Sink<Result<Completed<U>, ScopeFailure>>, Stream<Result<Completed<U>, ScopeFailure>>) = stream.pipe(concurrency).expect("pipeline concurrency");
        let (ready_sink, ready): (Sink<i64>, Stream<i64>) = stream.pipe(concurrency).expect("pipeline workers");
        var inboxes: Vec<Inbox<T>> = [];
        var workers = [];
        for id in 0..concurrency {
            let (inbox, jobs): (Sink<Job<T>>, Stream<Job<T>>) = stream.pipe(1).expect("pipeline worker");
            inboxes.push(Inbox { sink: inbox });
            workers.push(fork work(id, jobs, output.clone(), ready_sink.clone(), transform));
        }
        let producer = fork dispatch(source, inboxes, ready, semaphore.new(concurrency), output);
        ready_sink.close();
        var next = 0;
        var waiting: HashMap<i64, Completed<U>> = HashMap.new();
        for event in input {
            let completed = match event {
                .Ok(value) => value,
                .Err(failure) => panic(f"{failure}"),
            };
            match order {
                .Completion => {
                    let Completed { index: _, value, lease } = completed;
                    yield value;
                    lease.close();
                }
                .Input => {
                    waiting.insert(completed.index, completed);
                    loop {
                        let ordered = match waiting.remove(next) {
                            .Some(value) => value,
                            .None => break,
                        };
                        let Completed { index: _, value, lease } = ordered;
                        yield value;
                        lease.close();
                        next = next + 1;
                    }
                }
            }
        }
        await producer;
        await workers;
    };
}
