enum Colour {
    Red;
    Green;
}

actor Sink {
    var hits: i64;

    receive fn take(v: Colour) -> i64 {
        match v { Red => println("Red"), Green => println("Green"), }
        hits = hits + 1;
        hits
    }
}

fn main() {
    let x: Colour = .Red;
    let s = spawn Sink(hits: 0);
    match await s.take(x) {
        Result.Ok(n) => println(f"hits {n}"),
        Err(_) => println("err"),
    }
}
