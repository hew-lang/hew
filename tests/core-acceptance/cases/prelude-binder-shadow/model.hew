// Every spelling here is also a type parameter of a prelude std module
// (`std.iter`'s `Map<I, A, B>`, `std.result`'s `Result<T, E>`).
pub type A {
    code: i64,
}

pub type B {
    label: string,
}

pub type E {
    reason: string,
}

pub fn make(code: i64) -> A {
    A { code: code }
}

pub fn tag(label: string) -> B {
    B { label: label }
}

pub fn fail(reason: string) -> E {
    E { reason: reason }
}
