trait Named {
    fn name(self) -> string;
}

type Person {
    label: string;
}

impl Named for Person {
    fn name(self) -> string {
        f"person {self.label}"
    }
}

type Machine {
    id: i64;
}

impl Named for Machine {
    fn name(self) -> string {
        f"machine {self.id}"
    }
}

fn announce(value: dyn Named) {
    println(value.name());
}

fn build(id: i64) -> dyn Named {
    let made: dyn Named = Machine { id: id };
    made
}

fn main() {
    let first: dyn Named = Person { label: "grace" };
    announce(first);
    announce(build(7));
    let held: dyn Named = Person { label: "ada" };
    println(held.name());
    // Reassignment must release the erased Person before the Machine lands.
    var slot: dyn Named = Person { label: "linus" };
    slot = Machine { id: 12 };
    println(slot.name());
}
