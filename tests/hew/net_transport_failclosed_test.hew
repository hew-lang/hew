import std.crypto.password;

import std.net.http.codec;

import std.stream;

#[test]
fn test_negative_pipe_capacity_is_rejected() {
    let opened: Result<(stream.Sink<string>, stream.Stream<string>), string> = stream.pipe(-1);
    match opened {
        .Ok(_) => panic("expected negative pipe capacity to fail"),
        .Err(err) => assert(err == "stream.pipe: invalid capacity -1 (must be >= 0)"),
    }
}

#[test]
fn test_password_cost_overflow_is_rejected() {
    match password.hash_custom("secret", 4294967299) {
        .Ok(_) => panic("expected oversized password cost to fail"),
        .Err(err) => assert(err == password.PasswordError.InvalidCost(4294967299)),
    }
}

#[test]
fn test_malformed_password_hash_is_not_a_mismatch() {
    match password.verify("secret", "not-a-phc-hash") {
        .Ok(_) => panic("expected malformed password hash to fail"),
        .Err(err) => assert(err == password.PasswordError.MalformedHash),
    }
}

#[test]
fn test_async_http_query_and_ipv6_authority_split() {
    let (query_addr, query_path) = codec.split_address("http://example.com?x=1");
    assert(query_addr == "example.com:80");
    assert(query_path == "/?x=1");
    let (ipv6_addr, ipv6_path) = codec.split_address("http://[::1]:8080/status");
    assert(ipv6_addr == "[::1]:8080");
    assert(ipv6_path == "/status");
    assert(codec.host_of("http://[::1]:8080/status") == "[::1]");
}

#[test]
fn test_async_http_invalid_status_is_rejected() {
    assert(codec.response_text(-1, "body").is_err());
    assert(codec.response_text(600, "body").is_err());
}

#[test]
fn test_codec_distinguishes_incomplete_invalid_and_empty_headers() {
    assert(codec.parse_request("GET / HTTP/1.1\r\n").expect("incomplete header").is_none());
    assert(codec.parse_request("POST / HTTP/1.1\r\nContent-Length: 2\r\n\r\na").expect("incomplete body").is_none());
    let request = codec.parse_request("GET / HTTP/1.1\r\nX-Empty:\r\n\r\n").expect("valid").expect("complete");
    assert(request.header("x-empty") == .Some(""));
    assert(request.header("missing").is_none());
    match codec.parse_request("BAD\r\n\r\n") {
        .Err(error) => assert(error.status() == 400),
        _ => panic("malformed request accepted"),
    }
    assert(codec.parse_response("HTTP/1.1 200 OK\r\n").expect("incomplete header").is_none());
    assert(codec.parse_response("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\na").expect("incomplete body").is_none());
    assert(codec.parse_response("HTTP/1.1 nope\r\n\r\n").is_err());
    let response = codec.parse_response("HTTP/1.1 200 OK\r\nX-Empty:\r\n\r\n").expect("valid").expect("complete");
    assert(response.header("x-empty") == .Some(""));
    assert(response.header("missing").is_none());
    assert(codec.build_request("GET", "host\r\nInjected: yes", "/", "", "").is_err());
}
