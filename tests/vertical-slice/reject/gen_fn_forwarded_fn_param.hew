// Reject: `consume` on the generator's parameter moves the value into the
// generator frame, so the forwarding function has to own what it hands on.
// `forward` borrows its own `f`, so the forward is a consume of a borrow and
// the refusal names `forward`, not the generator. Declaring `consume f` on
// `forward` too is the fix, and carries the transfer all the way down.
gen fn mapped(n: i64, consume f: fn(i64) -> i64) -> i64 {
    var i = 0;
    while i < n {
        yield f(i);
        i = i + 1;
    }
}

fn forward(f: fn(i64) -> i64) -> Generator<i64, ()> {
    mapped(1, f)
}

fn main() {
    let suffix = "owned-" + "heap";
    for v in forward(|x: i64| x + suffix.len()) {
        println(v);
    }
}
