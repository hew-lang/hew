// W4.002 reject fixture: `.recv()` inside a machine transition body must
// be rejected at HIR-lower time when compiling for wasm32, exercising the
// Item::Machine arm of `check_wasm_blocking_recv_gate` added in this change.
//
// The .recv() call is on a real `Stream<i64>` obtained from the successful
// `stream.pipe(capacity)` result so the type checker accepts the program; the
// wasm32 gate then rejects the blocking `.recv()` at HIR-lower time.
import std.stream;

machine M {
    events {
        Tick,
    }

    state Idle,
    state Done,

    on Tick: Idle => Done {
        match stream.pipe(8) {
            .Ok((_tx, rx)) => {
                let _received: Option<i64> = rx.recv();
                Done
            },
            .Err(_) => Done,
        }
    }

    default { state }
}

fn main() {}
