fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        var sets: Vec<HashSet<string>> = Vec.new();
        var set: HashSet<string> = HashSet.new();
        set.insert("nested" + "-member");
        sets.push(set);
        for yielded in sets.iter() {
            total = total + yielded.len();
        }
        i = i + 1;
    }
    total % 7
}
