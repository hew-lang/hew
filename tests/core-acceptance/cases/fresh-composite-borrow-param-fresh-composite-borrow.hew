type Inner { a: string, b: string }
type Outer { inner: Inner }
fn mkOuter(i: i64) -> Outer { Outer { inner: Inner { a: f"x{i % 10}", b: f"y{i % 10}" } } }
fn borrowSum(o: Outer) -> i64 { o.inner.a.len() + o.inner.b.len() }
fn main() -> i64 {
    var total: i64 = 0;
    for i in 0..50 {
        total = total + borrowSum(mkOuter(i));
    }
    if total != 50 * 4 { return 73; }
    0
}
