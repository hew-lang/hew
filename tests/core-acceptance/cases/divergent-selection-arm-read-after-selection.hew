fn make() -> Vec<i64> {
    var v: Vec<i64> = Vec.new();
    v.push(40);
    v.push(2);
    return v;
}

fn probe(c: bool) -> i64 {
    let a = make();
    let b = make();
    let out = match c { true => a, false => b };
    out.len() + a.len()
}

fn main() -> i64 {
    var total: i64 = 0;
    for seed in 0..50 {
        total = total + probe(true);
        println("frame");
    }
    total - 50 * 4
}
