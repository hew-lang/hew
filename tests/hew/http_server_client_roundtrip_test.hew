//! The separate HTTP client and server modules exchange a real loopback
//! request in one process. Importing the client first must preserve both
//! resource implementations and their exact response values.

import std.net.http.client;

import std.net.http.server as http;

/// The `Client` runs the blocking outbound request on its own worker; the test
/// thread serves the single request. `status`/`body` are read back via asks
/// that the mailbox necessarily processes AFTER `fetch` completes.
actor Client {
    let url: string;
    var status: i64;
    var body: string;

    receive fn fetch(unused: i64) {
        assert(client.set_timeout(3000ms).is_ok());
        let resp = client.get(url).expect("HTTP request succeeds");
        status = resp.status();
        body = resp.body().expect("HTTP body decodes");
        resp.close();
    }

    receive fn status_result() -> i64 {
        status
    }

    receive fn body_result() -> string {
        body
    }
}

/// One-process round-trip: bind, fire the client, accept + respond 200 with the
/// request path echoed, then assert the client observed EXACTLY 200 and the
/// echoed body. A wrong surviving impl copy (topo-order risk) would either fail
/// to respond or corrupt the body — a `> 0` smoke check would not catch that,
/// so the assertions pin the exact status and the exact echoed body.
#[test]
#[real_time]
fn test_server_client_roundtrip_returns_200_and_echoes_path() {
    match http.listen("127.0.0.1:0") {
        .Ok(server) => {
            let port = server.port();
            let client = spawn Client { url: f"http://127.0.0.1:{port}/ping", status: 0, body: "" };
            let request = fork client.fetch(0);
            let req = server.accept().expect("accept connection");
            let path = req.path();
            req.respond_text(200, "pong:" + path).expect("send response");
            server.close();
            assert((await request).is_ok());
            match client.status_result() {
                .Ok(status) => assert(status == 200),
                .Err(_e) => assert(false),
            }
            match client.body_result() {
                .Ok(body) => assert(body == "pong:/ping"),
                .Err(_e) => assert(false),
            }
        }
        .Err(_err) => {
            assert(false);
        }
    }
}
