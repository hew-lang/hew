//! Compression and decompression (gzip, deflate, zlib).
//!
//! Compress and decompress binary data using gzip, raw deflate, or
//! zlib formats. Compression helpers take and return `bytes` values.
//! Decompression callers must pass an explicit `max_output_len` to fail
//! closed on oversized payloads; a conservative starting point is
//! `64 * 1024 * 1024`.
//!
//! # Examples
//!
//! ```
//! import std.encoding.compress;
//!
//! fn main() {
//!     let data: bytes = bytes.new();
//!     data.push(72);
//!     data.push(101);
//!     data.push(108);
//!     data.push(108);
//!     data.push(111);
//!     let compressed = compress.gzip_compress(data);
//!     let decompressed = compress.gzip_decompress(compressed, 64 * 1024 * 1024);
//!     println(decompressed.len());  // 5
//! }
//! ```
/// Gzip-compress `data` without panicking.
///
/// A failed codec call and a codec call that legitimately produced no bytes
/// both yield an empty buffer, so the codec's own reason decides which one
/// happened.
pub fn gzip_compress(data: bytes) -> Result<bytes, string> {
    let out = unsafe {
        hew_gzip_compress_hew(data)
    };
    let reason = unsafe {
        hew_compress_last_error()
    };
    if reason.len() > 0 {
        Err(reason)
    } else {
        Ok(out)
    }
}
/// Gzip-decompress `data` without panicking.
pub fn gzip_decompress(data: bytes, max_output_len: i64) -> Result<bytes, string> {
    let out = unsafe {
        hew_gzip_decompress_hew(data, max_output_len)
    };
    let reason = unsafe {
        hew_compress_last_error()
    };
    if reason.len() > 0 {
        Err(reason)
    } else {
        Ok(out)
    }
}
