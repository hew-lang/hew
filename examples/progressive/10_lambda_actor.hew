// Test 10: Lambda Actor
// Trying a simple lambda-based actor
fn main() {
    // Create a simple counter lambda actor
    let counter = actor |msg: i64| {
        println(msg * 2);
    };
    match counter(5) {
        .Ok(_) => {},
        .Err(_) => panic("lambda call failed for 5"),
    }
    match counter(10) {
        .Ok(_) => {},
        .Err(_) => panic("lambda call failed for 10"),
    }
    match counter(15) {
        .Ok(_) => {},
        .Err(_) => panic("lambda call failed for 15"),
    }
    close(counter);
}
