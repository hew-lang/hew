//! Regression for the diverging-arm double-free on a call-scrutinee
//! `Result<Resource, _>`.
//!
//! `match make() { .Ok(w) => use(w), .Err(_) => panic(...) }` over a call that
//! returns a heap-owning `#[resource]` payload double-freed the payload: the
//! owning enum composite frees the payload through its recursive `EnumInPlace`
//! scope-exit drop, so the `Ok` binder is a non-owning interior alias that must
//! never get an independent drop. When the sibling arm diverges (panic/return)
//! it removes the CFG join that would otherwise meet the binder to `Uninit`, so
//! the binder stayed `Live` at the `Return` exit and its drop fired alongside
//! the composite's — over-releasing the payload. Sibling shape of issue #2648.

import std.testing;

#[resource]
type Ticket {
    id: i64,
}

impl Ticket {
    fn value(self) -> i64 {
        self.id
    }
    fn close(consuming self) {
        // A real resource close; the composite drop must run this exactly once
        // on both the Ok and the diverging-Err exit paths.
        let _ = self.id;
    }
}

fn issue(ok: bool) -> Result<Ticket, string> {
    if ok {
        Ok(Ticket { id: 7 })
    } else {
        Err("declined")
    }
}

#[test]
fn ok_arm_uses_payload_while_err_arm_panics() {
    match issue(true) {
        .Ok(ticket) => testing.assert_eq(ticket.value(), 7),
        .Err(_) => panic("expected a ticket"),
    }
}

#[test]
fn ok_arm_uses_payload_while_err_arm_returns() {
    match issue(true) {
        .Ok(ticket) => testing.assert_eq(ticket.value(), 7),
        .Err(_) => return,
    }
}

#[test]
fn err_arm_taken_with_diverging_ok_arm() {
    match issue(false) {
        .Ok(ticket) => {
            let _ = ticket.value();
            panic("expected a decline");
        },
        .Err(reason) => testing.assert_eq_str(reason, "declined"),
    }
}
