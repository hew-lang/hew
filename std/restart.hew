//! Restart delay policies for supervisor declarations.
//!
//! A supervisor without `backoff` restarts a crashed child immediately; the
//! restart intensity budget alone bounds a crash loop.

/// Per-role exponential delay, evaluated once when its supervisor is spawned.
/// The first crash waits `initial`; subsequent crashes double the delay up to
/// `maximum`. After a replacement runs for a healthy supervisor restart window,
/// the next crash starts at `initial` again. Waiting for a replacement does not
/// count as healthy execution. Each stable role keeps its own delay.
pub type Backoff {
    initial: duration;
    maximum: duration;
}

/// Construct a bounded exponential restart delay. An omitted `maximum` (or
/// `0ns`) caps the delay at 30 seconds, or at `initial` when that is longer.
pub fn exponential(initial: duration, maximum: duration = 0ns) -> Backoff {
    assert(initial > 0ns, "restart backoff initial delay must be positive");
    let cap = if maximum != 0ns {
        maximum
    } else if initial > 30s { initial } else { 30s };
    assert(cap >= initial, "restart backoff maximum must be at least initial");
    Backoff { initial: initial, maximum: cap }
}
