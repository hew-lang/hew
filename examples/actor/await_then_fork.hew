// After an actor completion call, fork work in a scope and read actor state.
// The scope waits for the forked child before it returns.

fn _background() {
    println("background-ran");
}

actor Worker {
    let factor: i64,
    receive fn compute(n: i64) -> i64 {
        n * factor
    }
}

actor Coordinator {
    let worker: LocalPid<Worker>,
    let bias: i64,
    receive fn run(n: i64) -> i64 {
        let r = worker.compute(n);
        // The fork runs AFTER the call returns: the spawn must read the live
        // resume context, not the unwound spilled `ctx` param.
        scope {
            fork {
                _background();
            };
        };
        match r {
            // `bias` is read after the call + fork — also from the live context.
            .Ok(v) => v + bias,
            .Err(_) => -1,
        }
    }
}

fn main() {
    let w = spawn Worker(factor: 6);
    let c = spawn Coordinator(worker: w, bias: 100);
    let r = c.run(7);
    match r {
        // compute(7) = 42; + bias(100) = 142
        .Ok(v) => println(f"result={v}"),
        .Err(_) => println("ask failed"),
    }
}
