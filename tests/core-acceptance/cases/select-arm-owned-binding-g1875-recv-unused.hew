import std.stream;

fn main() -> i64 {
    let (tx, rx): (stream.Sink<string>, stream.Stream<string>) = match stream.pipe(1) { .Ok(pair) => pair, .Err(error) => panic(error), };
    var i: i64 = 0;
    var hits: i64 = 0;
    while i < 50 {
        tx.send("recv-owned-heap-payload").expect("send");
        let r = select {
            _msg from rx.recv() => 1,
            after 1s => 0,
        };
        hits = hits + r;
        i = i + 1;
    }
    tx.close();
    rx.close();
    if hits == 50 { 0 } else { 1 }
}
