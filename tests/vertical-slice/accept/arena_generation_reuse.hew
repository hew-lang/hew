// Arena<T>: a removed slot is reused by the next insert, but the reused key
// carries a bumped generation so the old key stays closed.
import std::arena::{ Arena, Key };

fn main() {
    let store: Arena<string> = arena.new();
    let ka = store.insert("A");
    store.remove(ka);
    let kb = store.insert("B");
    println(ka.index == kb.index);
    println(kb.generation == ka.generation + 1);
    println(store.get(ka).is_none());
    println(store.get(kb).unwrap());
}
