type ParseFailure {
    detail: string,
}

impl Display for ParseFailure {
    fn fmt(value: ParseFailure) -> string {
        f"parse failed: {value.detail}"
    }
}

impl Error for ParseFailure {}

fn parse(text: string) -> i64 fails dyn Error {
    if text == "" {
        return error ParseFailure { detail: "empty input" }
    }
    return text.len()
}

fn main() -> Result<(), dyn Error> {
    let width = parse("hello")?;
    println(f"width={width}");
    let missing = parse("")?;
    println(f"unreachable={missing}");
    Ok(())
}
