// Max Stack - Stack that tracks maximum in O(1)
// Uses two Vecs: main stack and max-tracking stack
//
// A parameter is the callee's own copy, so push and pop hand both stacks back
// and the caller reassigns; pop also reports the value it removed.
fn run_test(name: string, passed: i64) -> i64 {
    if passed == 1 {
        println(f"PASS: {name}");
    } else {
        println(f"FAIL: {name}");
    }
    passed
}

fn ms_push(var data: Vec<i64>, var maxs: Vec<i64>, val: i64) -> (Vec<i64>, Vec<i64>) {
    data.push(val);
    if maxs.is_empty() {
        maxs.push(val);
    } else {
        let cm = maxs[maxs.len() - 1];
        if val > cm {
            maxs.push(val);
        } else {
            maxs.push(cm);
        }
    }
    (data, maxs)
}

// Push every value in order.
fn ms_push_all(var data: Vec<i64>, var maxs: Vec<i64>, values: Vec<i64>) -> (Vec<i64>, Vec<i64>) {
    for value in values {
        let (grown, tracked) = ms_push(data, maxs, value);
        data = grown;
        maxs = tracked;
    }
    (data, maxs)
}

fn ms_pop(var data: Vec<i64>, var maxs: Vec<i64>) -> (Vec<i64>, Vec<i64>, i64) {
    maxs.pop();
    let val = data.pop();
    (data, maxs, val)
}

fn ms_max(maxs: Vec<i64>) -> i64 {
    maxs[maxs.len() - 1]
}

fn main() {
    var total = 0;
    var passed = 0;
    var data: Vec<i64> = Vec.new();
    var maxs: Vec<i64> = Vec.new();
    // Test 1: push single, max is that element
    total = total + 1;
    let (data_five, maxs_five) = ms_push(data, maxs, 5);
    data = data_five;
    maxs = maxs_five;
    let r1 = if ms_max(maxs) == 5 {
        1
    } else {
        0
    };
    passed = passed + run_test("single element max", r1);

    // Test 2: push larger, max updates
    total = total + 1;
    let (data_eight, maxs_eight) = ms_push(data, maxs, 8);
    data = data_eight;
    maxs = maxs_eight;
    let r2 = if ms_max(maxs) == 8 {
        1
    } else {
        0
    };
    passed = passed + run_test("push larger updates max", r2);

    // Test 3: push smaller, max stays
    total = total + 1;
    let (data_three, maxs_three) = ms_push(data, maxs, 3);
    data = data_three;
    maxs = maxs_three;
    let r3 = if ms_max(maxs) == 8 {
        1
    } else {
        0
    };
    passed = passed + run_test("push smaller keeps max", r3);

    // Test 4: push even larger
    total = total + 1;
    let (data_twelve, maxs_twelve) = ms_push(data, maxs, 12);
    data = data_twelve;
    maxs = maxs_twelve;
    let r4 = if ms_max(maxs) == 12 {
        1
    } else {
        0
    };
    passed = passed + run_test("push even larger", r4);

    // Stack: [5, 8, 3, 12], maxs: [5, 8, 8, 12]

    // Test 5: pop removes largest, max reverts
    total = total + 1;
    let (data_p5, maxs_p5, _p5) = ms_pop(data, maxs);
    data = data_p5;
    maxs = maxs_p5;
    let r5 = if ms_max(maxs) == 8 {
        1
    } else {
        0
    };
    passed = passed + run_test("pop reverts max to 8", r5);

    // Test 6: pop again, max stays 8
    total = total + 1;
    let (data_p6, maxs_p6, _p6) = ms_pop(data, maxs);
    data = data_p6;
    maxs = maxs_p6;
    let r6 = if ms_max(maxs) == 8 {
        1
    } else {
        0
    };
    passed = passed + run_test("pop again max still 8", r6);

    // Test 7: pop the 8, max becomes 5
    total = total + 1;
    let (data_p7, maxs_p7, _p7) = ms_pop(data, maxs);
    data = data_p7;
    maxs = maxs_p7;
    let r7 = if ms_max(maxs) == 5 {
        1
    } else {
        0
    };
    passed = passed + run_test("pop 8 max becomes 5", r7);

    // Test 8: many elements
    total = total + 1;
    var d2: Vec<i64> = Vec.new();
    var m2: Vec<i64> = Vec.new();
    let many: Vec<i64> = [10, 30, 20, 50, 40, 90, 60];
    let (d2_many, m2_many) = ms_push_all(d2, m2, many);
    d2 = d2_many;
    m2 = m2_many;
    let r8 = if ms_max(m2) == 90 {
        1
    } else {
        0
    };
    passed = passed + run_test("many elements max=90", r8);

    // Test 9: pop back, max reverts correctly
    total = total + 1;
    let (d2_a, m2_a, _sixty) = ms_pop(d2, m2); // remove 60, max=90
    let (d2_b, m2_b, _ninety) = ms_pop(d2_a, m2_a); // remove 90, max=50
    d2 = d2_b;
    m2 = m2_b;
    let r9 = if ms_max(m2) == 50 {
        1
    } else {
        0
    };
    passed = passed + run_test("pop 2 max becomes 50", r9);

    // Summary
    println(f"{passed}/{total} tests passed");
    if passed == total {
        println("ALL PASS");
    } else {
        println("SOME FAILED");
    }
}
