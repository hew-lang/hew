// Lambda actor creation, message delivery, captured state and reply handling.
// One logger receives both output values, preserving their submission order.
fn main() {
    let out = actor |line: i64| {
        println(line);
    };
    let _ = out.send(42);
    let factor = 7;
    let scale = actor |n: i64| -> i64 {
        n * factor
    };
    let a = scale(3);
    match a {
        .Ok(v) => {
            let _ = out.send(v);
        }
        .Err(_) => {
            let _ = out.send(-1);
        }
    }
}
