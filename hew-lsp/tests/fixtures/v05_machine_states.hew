machine Traffic {
    events {
        Start,
        Stop,
        Started,
        Stopped,
    }

    emits {
        Started,
        Stopped,
    }

    state Idle {
        entry {
            emit Stopped {};
        }
    },
    state Running {
        entry {
            emit Started {};
        }
        exit {
            emit Stopped {};
        }
    },

    on Start: Idle => Running,
    on Stop: Running => Idle,

    default { state }
}

fn machine_states_probe() -> i32 {
    7
}

fn machine_states_use() -> i32 {
    machine_states_probe()
}
