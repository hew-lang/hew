machine Counter {
    events { Inc, Reset, }
    state Zero,
    state NonZero { value: i64, },
    on Inc: Zero => NonZero { NonZero { value: 1 } }
    on Inc: NonZero => NonZero reenter { NonZero { value: self.value + 1 } }
    on Reset: NonZero => Zero { .Zero }
    default { state }
}

fn main() {
    var a = Zero;
    a.step(.Inc);
    var b = Zero;
    b.step(.Inc);
    b.step(.Inc);
    let v: Vec<Counter> = Vec.new();
    v.push(a);
    v.push(b);
    for e in v {
        match e {
            .Zero => println("zero"),
            .NonZero { value } => println(f"n {value}"),
        }
    }
}
