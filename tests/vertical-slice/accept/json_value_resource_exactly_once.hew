// Selected values and captured copies survive their parent's lexical scope.
import std.encoding.json;

fn early_exit(flag: bool) {
    var value = json.object();
    value.set("n", json.from_int(11)).unwrap();
    let child = value.get_field("n").unwrap().unwrap();
    if flag {
        return;
    }
    println(child.get_int().unwrap());
}

fn _panic_exit() {
    var value = json.object();
    value.set("n", json.from_int(12)).unwrap();
    let _child = value.get_field("n").unwrap().unwrap();
    panic("json value panic probe");
}

fn cancel_exit() {
    var value = json.object();
    value.set("n", json.from_int(13)).unwrap();
    let _child = value.get_field("n").unwrap().unwrap();
    var i: i64 = 0;
    while i < 2 {
        i = i + 1;
    }
}

actor JsonCancelDriver {
    receive fn drive() {
        scope {
            cancel_exit();
        };
    }
}

fn main() {
    let (read, keys) = {
        var value = json.object();
        value.set("n", json.from_int(7)).unwrap();
        value.set("flag", json.from_bool(true)).unwrap();
        let child = value.get_field("n").unwrap().unwrap();
        (|| child.get_int().unwrap(), value.keys().unwrap())
    };
    println(read());
    println(keys.array_len().unwrap());

    // A parse failure returns an error without an owning value payload.
    match json.parse("{") {
        .Ok(_) => panic("malformed JSON unexpectedly parsed"),
        .Err(_) => {},
    }
    early_exit(true);
}
