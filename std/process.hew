//! Process execution.
//!
//! `run` and `run_argv` execute a command to completion and capture its
//! output. `start` launches a `Command` (never through a shell) and returns a
//! `Child` whose piped stdio are ordinary `Stream<bytes>` and `Sink<bytes>`
//! values. `Command.output(CaptureLimits { timeout, max_output_bytes })`
//! captures both output streams with a runtime limit and a shared byte budget.
//!
//! `start` and `Command.output` inherit the parent's environment and working
//! directory. `start_with_options` and `Command.output_with_options` accept a
//! `SpawnOptions` snapshot: `Environment.Inherit(bindings)` overlays inherited
//! variables, while `Environment.Clear(bindings)` passes only explicit
//! bindings, including none. Neither operation changes process-global state.
//! Both spawn paths use the same owned `Child` and native lifecycle.
//!
//! A `Child` owns its process until it is reaped. `wait` suspends the calling
//! task and holds no thread while the child runs: it parks on the I/O reactor
//! (a pidfd on Linux, a kqueue process filter on FreeBSD and macOS) or, on
//! Windows, on the system thread pool's wait for the process handle. Any
//! number of tasks may wait on children at once. The reaped status is kept,
//! so a second `wait` returns it again and a later `terminate` or `kill` does
//! nothing. Dropping a `Child` that is still running kills and reaps it.
//!
//! A child's stdout and stderr streams are `select` sources on every native
//! host. A losing selection leaves its data available for the next receive.
//! Windows retains at most 64 KiB of completed output per pipe; pending reads
//! use overlapped I/O and release their buffers after cancellation completes.
//!
//! # Examples
//!
//! ```hew,no_run
//! import std.encoding.utf8;
//! import std.process;
//!
//! fn main() {
//!     let output = process.run_argv("printf", ["<%s>", "hello world"]).expect("printf runs");
//!     println(output.stdout);
//!
//!     var command = process.command("cat", []);
//!     command.stdin = process.Stdio.Piped;
//!     command.stdout = process.Stdio.Piped;
//!     let child = process.start(command).expect("cat starts");
//!     let input = child.stdin().expect("stdin is piped");
//!     let echoed = child.stdout().expect("stdout is piped");
//!     input.send("ping".to_bytes()).expect("cat reads");
//!     input.finish();
//!     for chunk in echoed {
//!         println(utf8.decode_lossy(chunk));
//!     }
//!     println(f"{child.wait():?}");
//! }
//! ```
//!
//! ```hew,no_run
//! import std.process;
//!
//! fn main() {
//!     let options = process.SpawnOptions {
//!         environment: .Clear([process.EnvVar { name: "LANG", value: "C" }]),
//!         cwd: .None,
//!     };
//!     let command = process.command("tool", ["--version"]);
//!     let output = command.output_with_options(
//!         process.CaptureLimits { timeout: 5s, max_output_bytes: 4096 },
//!         options,
//!     ).expect("tool runs with only the approved binding");
//!     println(output.stdout);
//! }
//! ```

import std.stream;

import std.encoding.utf8;

/// The runtime-owned child-process handle behind a `Child`.
#[opaque]
type ChildHandle {
}

/// Where a child's standard stream goes.
pub enum Stdio {
    /// Share this program's stream.
    Inherit;
    /// Connect the stream to the null device.
    Null;
    /// Connect the stream to a pipe the parent takes once from the `Child`.
    Piped;
}

/// A program, its arguments and its stdio. The arguments reach the program
/// exactly as given; no shell interprets them.
pub type Command {
    program: string;
    args: Vec<string>;
    stdin: Stdio;
    stdout: Stdio;
    stderr: Stdio;
}

/// An explicit child environment binding. Empty values are allowed.
pub type EnvVar {
    name: string;
    value: string;
}

/// The environment of a new child, without changing the parent's environment.
pub enum Environment {
    /// Inherit the parent's environment, then apply these bindings.
    Inherit(Vec<EnvVar>);
    /// Start with no inherited variables, then apply these bindings.
    /// `Clear([])` requests an explicitly empty environment.
    Clear(Vec<EnvVar>);
}

/// Optional per-child configuration for `start_with_options` and
/// `Command.output_with_options`. Existing `Command` literals stay unchanged.
pub type SpawnOptions {
    environment: Environment;
    /// `None` inherits the parent's working directory. A relative directory
    /// resolves from the parent's working directory.
    cwd: Option<string>;
}

/// Limits for `Command.output`.
pub type CaptureLimits {
    /// A positive runtime limit, including draining output and waiting for exit.
    timeout: duration;
    /// The maximum retained raw stdout and stderr bytes together; zero permits
    /// no output. A chunk that would exceed this limit is rejected before append.
    max_output_bytes: i64;
}

impl Command {
    /// Run without a shell and capture stdout and stderr within `limits`.
    ///
    /// Captures a snapshot without changing this command's configuration.
    /// Stdout and stderr are piped regardless of their command settings. Stdin
    /// may be inherited or null; `Piped` is refused because this operation does
    /// not expose a writer. Use `start` for interactive input.
    ///
    /// A nonzero exit is ordinary `CommandOutput.status` data. Exceeding either
    /// limit returns a structured error without partial output, after killing
    /// and reaping a child that is still running. Cancellation does the same.
    /// The byte budget bounds retained raw output. Operating-system pipes,
    /// backend read buffers, the current chunk, allocation capacity and UTF-8
    /// conversion have separate memory costs.
    fn output(self, limits: CaptureLimits) -> CommandOutput fails ProcessError {
        self.output_with_options(limits, inherited_options())?
    }

    /// Capture output with a per-child environment and working directory.
    /// Limits, stdio, cancellation and cleanup follow `output`.
    fn output_with_options(self, limits: CaptureLimits, options: SpawnOptions) -> CommandOutput fails ProcessError {
        if limits.timeout <= 0ns {
            return error ProcessError.InvalidArguments("process output: timeout must be positive");
        }
        if limits.max_output_bytes < 0 {
            return error ProcessError.InvalidArguments("process output: max_output_bytes must be nonnegative");
        }
        if let Stdio.Piped = self.stdin {
            return error ProcessError.InvalidArguments("process output: piped stdin requires process.start");
        }
        var specification = self;
        specification.stdout = Stdio.Piped;
        specification.stderr = Stdio.Piped;
        scope within limits.timeout {
            let child = start_with_options(specification, options)?;
            drain_output(child, .Some(limits.max_output_bytes))?
        } handle failure {
            match failure {
                .Fault { message } => return error ProcessError.LaunchFailed(message),
                .Deadline { message } => return error ProcessError.TimedOut(limits.timeout),
            }
        }
    }
}

/// How a process ended.
pub enum ExitStatus {
    /// The process exited with this code.
    Exited(i64);
    /// A signal with this number ended the process (Unix only).
    Signalled(i64);
}

/// Captured output from a completed command.
pub type CommandOutput {
    status: ExitStatus;
    stdout: string;
    stderr: string;
}

/// Structured process failures.
pub enum ProcessError {
    InvalidArguments(string);
    LaunchFailed(string);
    /// The stream was not `Stdio.Piped` or was already taken.
    NotPiped;
    /// The operating system refused a wait or signal with this error code.
    System(i64);
    /// `Command.output` reached its configured runtime limit.
    TimedOut(duration);
    /// `Command.output` would retain more than this many raw output bytes.
    OutputLimitExceeded(i64);
}

/// A running or finished child process.
#[resource]
pub type Child {
    handle: ChildHandle;
}

impl Child {
    /// The child's operating-system process ID.
    fn id(self) -> i64 {
        unsafe {
            hew_process_id(self.handle)
        }
    }

    /// Take the write end of the child's stdin pipe. Finishing the sink
    /// closes the pipe, so the child reads end of input.
    fn stdin(self) -> Result<stream.Sink<bytes>, ProcessError> {
        unsafe {
            let pair = hew_process_take_pipe(self.handle, 0);
            if !hew_stream_pair_is_valid(pair) {
                return .Err(ProcessError.NotPiped);
            }
            let sink: stream.Sink<bytes> = stream.pair_sink(pair);
            pair.close();
            .Ok(sink)
        }
    }

    /// Take the read end of the child's stdout pipe.
    fn stdout(self) -> Result<stream.Stream<bytes>, ProcessError> {
        take_output(self.handle, 1)
    }

    /// Take the read end of the child's stderr pipe.
    fn stderr(self) -> Result<stream.Stream<bytes>, ProcessError> {
        take_output(self.handle, 2)
    }

    /// Wait for the child to exit and reap it. The task suspends and holds
    /// no thread; a wait cancelled by `scope within` releases its watch and
    /// leaves the child running and unreaped.
    fn wait(self) -> ExitStatus fails ProcessError {
        loop {
            match self.try_wait()? {
                .Some(status) => return status,
                .None => {}
            }
            let watch = unsafe {
                hew_process_exit_stream(self.handle)
            };
            if !unsafe {
                hew_stream_pair_is_valid(watch)
            } {
                let failure = unsafe {
                    hew_process_wait_error(self.handle)
                };
                return error ProcessError.System(failure as i64);
            }
            // The stream carries no items; it ends once the child exits.
            let exited: stream.Stream<bytes> = stream.pair_stream(watch);
            watch.close();
            let _ = exited.recv();
        }
    }

    /// Reap the child if it has exited, without waiting.
    fn try_wait(self) -> Result<Option<ExitStatus>, ProcessError> {
        let state = unsafe {
            hew_process_poll(self.handle)
        };
        if state < 0 {
            return .Err(ProcessError.System(0 - state as i64));
        }
        if state == 0 {
            return .Ok(.None);
        }
        let number = unsafe {
            hew_process_status(self.handle)
        };
        if unsafe {
            hew_process_signalled(self.handle)
        } {
            .Ok(.Some(ExitStatus.Signalled(number)))
        } else {
            .Ok(.Some(ExitStatus.Exited(number)))
        }
    }

    /// Ask the child to stop: SIGTERM on Unix. Windows has no request to
    /// stop, so this terminates the child like `kill`. A reaped child is not
    /// signalled.
    fn terminate(self) -> Result<(), ProcessError> {
        signal_result(unsafe {
            hew_process_signal(self.handle, false)
        })
    }

    /// Stop the child at once: SIGKILL on Unix, `TerminateProcess` on
    /// Windows. A reaped child is not signalled.
    fn kill(self) -> Result<(), ProcessError> {
        signal_result(unsafe {
            hew_process_signal(self.handle, true)
        })
    }

    /// Release the child at scope exit, killing and reaping it first if it
    /// is still running.
    fn close(consume self) {
        unsafe {
            hew_process_drop(self.handle)
        };
    }
}

impl Display for ExitStatus {
    fn fmt(self) -> string {
        match self {
            ExitStatus.Exited(code) => f"Exited({code})",
            ExitStatus.Signalled(signal) => f"Signalled({signal})",
        }
    }
}

impl Display for ProcessError {
    fn fmt(self) -> string {
        match self {
            ProcessError.InvalidArguments(message) => message,
            ProcessError.LaunchFailed(message) => message,
            ProcessError.NotPiped => "NotPiped: the stream was not piped or was already taken",
            ProcessError.System(code) => f"System({code}): the operating system refused the operation",
            ProcessError.TimedOut(timeout) => f"process output: timed out after {timeout.nanos()} ns",
            ProcessError.OutputLimitExceeded(limit) => f"process output: exceeded the {limit} byte output limit",
        }
    }
}

fn take_output(handle: ChildHandle, which: i32) -> Result<stream.Stream<bytes>, ProcessError> {
    unsafe {
        let pair = hew_process_take_pipe(handle, which);
        if !hew_stream_pair_is_valid(pair) {
            return .Err(ProcessError.NotPiped);
        }
        let output: stream.Stream<bytes> = stream.pair_stream(pair);
        pair.close();
        .Ok(output)
    }
}

fn signal_result(failure: i32) -> Result<(), ProcessError> {
    if failure == 0 { .Ok(()) } else { .Err(ProcessError.System(failure as i64)) }
}

fn stdio_mode(stdio: Stdio) -> i32 {
    match stdio {
        Stdio.Inherit => 0,
        Stdio.Null => 1,
        Stdio.Piped => 2,
    }
}

fn last_process_error(default_message: string) -> ProcessError {
    unsafe {
        let message = hew_process_last_error();
        hew_clear_error();
        if message == "" {
            ProcessError.LaunchFailed(default_message)
        } else {
            // A runtime execution failure is always a launch failure; never
            // classify it by searching attacker-controlled command text.
            ProcessError.LaunchFailed(message)
        }
    }
}

fn drain_output(consume child: Child, max_output_bytes: Option<i64>) -> CommandOutput fails ProcessError {
    let stdout_stream = child.stdout()?;
    let stderr_stream = child.stderr()?;
    var stdout = bytes.new();
    var stderr = bytes.new();
    var stdout_open = true;
    var stderr_open = true;
    var prefer_stdout = true;
    while stdout_open || stderr_open {
        // Read whichever pipe is ready. Once one ends, do not select its
        // ready EOF again while the other pipe still has data to drain.
        let (from_stdout, next) = if stdout_open && stderr_open && prefer_stdout {
            select {
                chunk from stdout_stream.recv() => (true, chunk),
                chunk from stderr_stream.recv() => (false, chunk),
            }
        } else if stdout_open && stderr_open {
            select {
                chunk from stderr_stream.recv() => (false, chunk),
                chunk from stdout_stream.recv() => (true, chunk),
            }
        } else if stdout_open {
            (true, stdout_stream.recv())
        } else {
            (false, stderr_stream.recv())
        };
        // Prefer the other pipe next when both remain continuously ready.
        prefer_stdout = !from_stdout;
        match next {
            .Some(chunk) => {
                if let .Some(limit) = max_output_bytes {
                    if chunk.len() > limit - stdout.len() - stderr.len() {
                        return error ProcessError.OutputLimitExceeded(limit);
                    }
                }
                if from_stdout {
                    stdout.append(chunk);
                } else {
                    stderr.append(chunk);
                }
            }
            .None => {
                if from_stdout {
                    stdout_open = false;
                } else {
                    stderr_open = false;
                }
            }
        }
    }
    let status = child.wait()?;
    CommandOutput { status, stdout: utf8.decode_lossy(stdout), stderr: utf8.decode_lossy(stderr) }
}

fn capture(consume child: Child) -> CommandOutput fails ProcessError {
    scope {
        drain_output(child, .None)?
    } handle failure {
        match failure {
            .Fault { message } => return error ProcessError.LaunchFailed(message),
            .Deadline { message } => return error ProcessError.LaunchFailed(message),
        }
    }
}

// ── Module-level functions ────────────────────────────────────────────
/// Run a shell command and capture its status and output.
/// Waiting for output or exit suspends the caller; cancellation reaps the child.
pub fn run(command: string) -> Result<CommandOutput, ProcessError> {
    let child = unsafe {
        hew_clear_error();
        let handle = hew_process_start_shell(command);
        if !hew_process_is_valid(handle) {
            let error = last_process_error("process.run: command execution failed");
            hew_process_drop(handle);
            return .Err(error);
        }
        Child { handle }
    };
    capture(child)
}

/// Run a program without the shell and capture its status and output.
/// Both output streams drain concurrently while the caller is suspended.
pub fn run_argv(command: string, args: Vec<string>) -> Result<CommandOutput, ProcessError> {
    let specification = Command { program: command, args, stdin: Stdio.Null, stdout: Stdio.Piped, stderr: Stdio.Piped };
    match start(specification) {
        .Ok(child) => capture(child),
        .Err(error) => .Err(error),
    }
}

/// A `Command` for `program` with `args` and every stream inherited.
pub fn command(program: string, args: Vec<string>) -> Command {
    Command { program: program, args: args, stdin: Stdio.Inherit, stdout: Stdio.Inherit, stderr: Stdio.Inherit }
}

/// Options matching the defaults of `start` and `Command.output`.
pub fn inherited_options() -> SpawnOptions {
    SpawnOptions { environment: Environment.Inherit([]), cwd: .None }
}

/// Launch with per-child environment bindings and an optional working directory.
///
/// Bindings are applied in order; the last binding for a name wins. Name
/// comparison follows the host (case-insensitive on Windows). Empty names,
/// names containing `=` or NUL, values containing NUL, and empty or NUL-containing
/// working directories return `InvalidArguments` without launching a child.
/// Other operating-system failures return `LaunchFailed`. Diagnostics never
/// include environment values.
///
/// Use an absolute program path with `cwd`: resolving a relative program path
/// against a changed working directory is platform-dependent. Program lookup
/// and any environment variables added by the child follow the host's rules;
/// clearing inheritance is not a sandbox.
pub fn start_with_options(command: Command, options: SpawnOptions) -> Result<Child, ProcessError> {
    let (inherit, bindings) = match options.environment {
        Environment.Inherit(bindings) => (true, bindings),
        Environment.Clear(bindings) => (false, bindings),
    };
    var names: Vec<string> = [];
    var values: Vec<string> = [];
    for binding in bindings {
        if binding.name.is_empty() || binding.name.contains("=") || binding.name.contains("\0") {
            return .Err(ProcessError.InvalidArguments("process: invalid environment variable name"));
        }
        if binding.value.contains("\0") {
            return .Err(ProcessError.InvalidArguments("process: environment value contains NUL"));
        }
        names.push(binding.name);
        values.push(binding.value);
    }
    let (has_cwd, cwd) = match options.cwd {
        .Some(directory) => {
            if directory.is_empty() || directory.contains("\0") {
                return .Err(ProcessError.InvalidArguments("process: invalid working directory"));
            }
            (true, directory)
        }
        .None => (false, ""),
    };
    unsafe {
        hew_clear_error();
        let handle = hew_process_start_with_options(command.program, command.args, stdio_mode(command.stdin), stdio_mode(command.stdout), stdio_mode(command.stderr), inherit, names, values, has_cwd, cwd);
        if hew_process_is_valid(handle) {
            .Ok(Child { handle })
        } else {
            let error = last_process_error(f"process.start_with_options: could not launch {command.program}");
            hew_process_drop(handle);
            .Err(error)
        }
    }
}

/// Launch `command` without waiting. A program that cannot be launched is
/// `Err(ProcessError.LaunchFailed)`.
pub fn start(command: Command) -> Result<Child, ProcessError> {
    unsafe {
        hew_clear_error();
        let handle = hew_process_start(command.program, command.args, stdio_mode(command.stdin), stdio_mode(command.stdout), stdio_mode(command.stderr));
        if hew_process_is_valid(handle) {
            .Ok(Child { handle: handle })
        } else {
            let error = last_process_error(f"process.start: could not launch {command.program}");
            hew_process_drop(handle);
            .Err(error)
        }
    }
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    #[runtime_capability(ambient)]
    fn hew_process_start_shell(command: string) -> ChildHandle;
    #[runtime_capability(ambient)]
    fn hew_process_start(program: string, args: Vec<string>, stdin: i32, stdout: i32, stderr: i32) -> ChildHandle;
    #[runtime_capability(ambient)]
    fn hew_process_start_with_options(program: string, args: Vec<string>, stdin: i32, stdout: i32, stderr: i32, inherit: bool, names: Vec<string>, values: Vec<string>, has_cwd: bool, cwd: string) -> ChildHandle;
    #[runtime_capability(resource_operation)]
    fn hew_process_is_valid(child: ChildHandle) -> bool;
    #[runtime_capability(resource_operation)]
    fn hew_process_id(child: ChildHandle) -> i64;
    #[runtime_capability(resource_operation)]
    fn hew_process_take_pipe(child: ChildHandle, which: i32) -> stream.StreamPair;
    #[runtime_capability(resource_operation)]
    fn hew_process_exit_stream(child: ChildHandle) -> stream.StreamPair;
    #[runtime_capability(resource_operation)]
    fn hew_process_wait_error(child: ChildHandle) -> i32;
    #[runtime_capability(resource_operation)]
    fn hew_process_poll(child: ChildHandle) -> i32;
    #[runtime_capability(resource_operation)]
    fn hew_process_signalled(child: ChildHandle) -> bool;
    #[runtime_capability(resource_operation)]
    fn hew_process_status(child: ChildHandle) -> i64;
    #[runtime_capability(resource_operation)]
    fn hew_process_signal(child: ChildHandle, force: bool) -> i32;
    #[runtime_capability(resource_operation)]
    fn hew_process_drop(handle: ChildHandle);
    #[runtime_capability(value)]
    fn hew_process_last_error() -> string;
    #[runtime_capability(value)]
    fn hew_clear_error();
    #[runtime_capability(resource_operation)]
    fn hew_stream_pair_is_valid(pair: stream.StreamPair) -> bool;
}
