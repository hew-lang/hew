enum Shape {
    Empty;
    Circle(i64);
    Rect { w: i64; h: i64 }
}

fn main() {
    let x: Shape = .Circle(3);
    let v: Vec<Shape> = Vec.new();
    v.push(x);
    match v.get(0) {
        Option.Some(e) => {
            match e {
                Empty => println("empty"),
                Circle(e_r) => println(f"circle {e_r}"),
                Rect { w, h } => println(f"rect {w}x{h}"),
            }
        },
        None => println("missing"),
    }
}
