enum Note {
    Text(string),
    Number(i64),
}
actor Maker {
    receive gen fn notes() -> Note {
        for i in 0..50 {
            yield Note.Text(f"note-{i}");
        }
    }
}
fn main() -> i64 {
    var count: i64 = 0;
    let m = spawn Maker;
    for n in m.notes() {
        count = count + 1;
    }
    if count != 50 { return 92; }
    0
}
