import std.encoding.toml;

fn main() -> i32 {
    for _ in 0..50 {
        var value = toml.array();
        match value.push(toml.from_int(7)) {
            .Ok(_) => {}
            .Err(_) => {
                return 1;
            }
        }
        var copy = value;
        match copy.push(toml.from_int(8)) {
            .Ok(_) => {}
            .Err(_) => {
                return 1;
            }
        }
        match value.array_get(0) {
            .Ok(.Some(child)) => {
                match child.get_int() {
                    .Ok(n) => {
                        println(f"{n}");
                    }
                    .Err(_) => {
                        return 1;
                    }
                }
            }
            .Ok(.None) => {
                return 1;
            }
            .Err(_) => {
                return 1;
            }
        }
        match toml.parse("=") {
            .Ok(_) => {
                return 1;
            }
            .Err(_) => {}
        }
    }
    0
}
