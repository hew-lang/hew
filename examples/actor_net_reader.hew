//! Status: runnable
//! Description: Actor Net Reader example.

import std.net.{Connection};

actor ServerReader {
    let conn: Connection,

    receive fn start(unused: i32) {
        let msg = conn.read_string() handle error {
            println(f"invalid UTF-8: {error}");
            return;
        };
        println(msg);
    }
}

fn main() {
    let listener = match net.listen(":9001") {
        .Ok(listener) => listener,
        .Err(_) => panic(f"network setup failed"),
    };
    let conn = listener.accept();
    let reader = spawn ServerReader(conn: conn);
    reader.start(0);
}
