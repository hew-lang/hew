actor Echo {
    var seen: i64;

    receive fn take(v: i64) -> i64 {
        seen = seen + v;
        seen
    }
}

fn main() {
    let k = spawn Echo(seen: 0);
    let m: HashMap<LocalPid<Echo>, i64> = HashMap.new();
    m.insert(k, 9);
    match m.get(k) {
        Some(v) => println(f"got {v}"),
        None => println("missing"),
    }
}
