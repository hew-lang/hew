// A lambda actor's captures are snapshots: without `capture(var ..)` a write
// is refused whether the enclosing binding is `let` or `var`.
fn main() {
    var hits: i64 = 0;
    let count = actor || -> i64 {
        hits += 1;
        hits
    };
    stop(count);
    stopped(count);
    let seen: Vec<i64> = [];
    let note = actor move |n: i64| {
        seen.push(n);
    };
    stop(note);
    stopped(note);
}
