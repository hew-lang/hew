type Bag { items: Vec<i64> }
impl Bag { fn touch(self) -> i64 { 1 } }

fn main() -> i64 {
    var total: i64 = 0;
    for i in 0..50 {
        var v: Vec<i64> = Vec.new();
        v.push(1); v.push(2); v.push(3);
        let b = Bag { items: v };
        total = total + b.touch();
    }
    if total != 50 { return 72; }
    0
}
