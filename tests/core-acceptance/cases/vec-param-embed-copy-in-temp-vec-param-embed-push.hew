type Wrap { f: Option<string> }

fn pushParam(p: string) -> i64 {
    var v: Vec<Wrap> = [];
    v.push(Wrap { f: .Some(p) });
    v.len()
}

fn main() -> i64 {
    for i in 0..50 {
        let p = f"item-{i}";
        if pushParam(p) != 1 { return 11; }
        if p.len() < 6 { return 12; }
    }
    0
}
