// Each multiple of 15 is both a multiple of 3 and a multiple of 5.
fn main() {
    for number in 1..=15 {
        if number % 15 == 0 {
            println("FizzBuzz");
        } else if number % 3 == 0 {
            println("Fizz");
        } else if number % 5 == 0 {
            println("Buzz");
        } else {
            println(number);
        }
    }
}
