// A held supervised role remains callable after its restart budget is spent.
// Completion through the permanently dead role returns a recoverable error.
// DEAD_CHILD:9 proves the error arm ran; the unrecovered root fault still
// determines the process exit status.
actor Worker {
    var value: i64 = 5;
    receive fn tick() {
        value = value + 1;
    }
    receive fn get_value() -> i64 {
        value
    }
    receive fn crash_me() {
        panic("worker crash");
    }
}

supervisor App {
    strategy: one_for_one;
    intensity: 1 within 60s;

    child w1: Worker { value: 5 };
}

fn main() -> i64 {
    let sup = spawn App;
    let w = sup.w1;
    // The budget is one restart, so the second crash leaves the role
    // permanently dead; each `restarted` waits for the ruling on the crash
    // its own call already observed.
    let _ = w.crash_me();
    let _ = {
        let __hew_migrated_role_1953 = sup.w1;
        restarted(__hew_migrated_role_1953);
        __hew_migrated_role_1953
    };
    let _ = w.crash_me();
    let _ = {
        let __hew_migrated_role_2013 = sup.w1;
        restarted(__hew_migrated_role_2013);
        __hew_migrated_role_2013
    };
    // A unit completion on the permanently dead role fails recoverably.
    let _ = w.tick();
    // A value completion on the same role reaches the error arm.
    let sentinel = match w.get_value() {
        .Ok(_) => 3,
        .Err(_) => 9,
    };
    println(f"DEAD_CHILD:{sentinel}");
    0
}
