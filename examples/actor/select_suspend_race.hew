// cut-select-waitset — the live non-blocking actor `select{}`.
//
// `Coordinator.race_two` runs a `select{}` over two actor-ask arms from INSIDE
// a handler. The select registers each arm's readiness observer on a shared
// await-cancel arbiter and `coro.suspend`s — freeing the worker. The first
// arm to become ready wins the arbiter and RESUMES the coordinator; the losing
// arm is cancelled.
//
// Running with HEW_WORKERS=1 is the worker-freeing proof: a single worker must
// suspend the coordinator, run the two worker actors, then resume the
// coordinator with the winner. A blocking `hew_select_first` would deadlock the
// lone worker (it would spin on the readiness flags while the worker that must
// run the askees is the very one it pins).
//
// `Fast` replies immediately and always wins; `Slow` waits on a gate that
// stays shut for the whole select, so it always loses — its channel is
// cancelled on the winning edge.
import std.stream;

actor Fast {
    let tag: i64,
    receive fn compute(n: i64) -> i64 {
        n + tag
    }
}

actor Slow {
    var gate: stream.Stream<i64>,
    receive fn compute(n: i64) -> i64 {
        gate.recv();
        n
    }
}

actor Coordinator {
    let fast: Fast,
    let slow: Slow,
    receive fn race_two(n: i64) -> i64 {
        let winner = select {
            reply from fast.compute(n) => match reply {
                .Ok(value) => value,
                .Err(_) => -7,
            },
            reply from slow.compute(99) => match reply {
                .Ok(value) => value,
                .Err(_) => -7,
            },
        };
        winner
    }
}

fn main() {
    let f = spawn Fast(tag: 100);
    // Nothing is sent on the gate; dropping its sink at exit lets Slow finish.
    let (_shut, gate) = stream.pipe(1).expect("gate");
    let s = spawn Slow(gate: gate);
    let c = spawn Coordinator(fast: f, slow: s);
    // Fast.compute(7) = 7 + 100 = 107; Slow cannot reply, so the select binds
    // 107. The Slow arm is the loser (cancelled).
    let r = c.race_two(7);
    match r {
        .Ok(v) => println(f"winner={v}"),
        .Err(_) => println("race failed"),
    }
}
