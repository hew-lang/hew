//! Status: runnable
//! Description: Test Select Race example.

actor FastWorker {
    receive fn compute(x: i32) -> i32 {
        x * 2
    }
}

actor SlowWorker {
    receive fn compute(x: i32) -> i32 {
        x * 3
    }
}

fn main() {
    let fast = spawn FastWorker;
    let slow = spawn SlowWorker;
    // Test select - fast should win
    let result = select {
        r = fast.compute(5) => r,
        r = slow.compute(5) => r,
        after 2s => -1 as i32,
    };
    println("select result:");
    println(result);

    // Test batch fork - both results
    let results = await fork (fast.compute(10), slow.compute(10));
    let fast_result = match results.0 {
        .Ok(value) => value,
        .Err(_) => -1,
    };
    let slow_result = match results.1 {
        .Ok(value) => value,
        .Err(_) => -1,
    };
    println("fork results:");
    println(fast_result);
    println(slow_result);
}
