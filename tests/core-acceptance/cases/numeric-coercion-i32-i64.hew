// Mixed-width integer arithmetic: an `i32` operand widens to its `i64` peer,
// and a binding whose type is still an integer literal takes the concrete
// width its arithmetic requires instead of exporting the `i64` default while
// the expression narrows on its own.
fn get_code() -> i32 {
    42
}

fn total_i64(base: i64) -> i64 {
    base + get_code()
}

fn main() -> i32 {
    var passed = 0;
    passed = passed + get_code();
    println(f"accumulated {passed}");

    var wide: i64 = 100;
    wide = wide + get_code();
    println(f"wide {wide}");
    println(f"call {total_i64(8)}");

    let narrow: i32 = 2;
    let literal = 3;
    let product: i32 = literal * narrow;
    println(f"product {product}");

    var index = 0;
    let sizes: Vec<i64> = [10, 20, 30];
    var sum: i64 = 0;
    while index < sizes.len() {
        sum = sum + sizes[index];
        index = index + 1;
    }
    println(f"sum {sum}");
    passed
}
