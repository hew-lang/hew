// MIR-corpus fixture: Sink/Stream scope-exit auto-close.
//
// The function intentionally does not call tx.close() or rx.close(); the
// elaborated MIR must emit scope-exit pipe close drops for both handles.
import std.stream;

fn main() {
    let (tx, rx): (stream.Sink<string>, stream.Stream<string>) = match stream.pipe(1) {
        .Ok(pair) => pair,
        .Err(err) => panic(f"stream.pipe failed: {err}"),
    };
    tx.send("ready").expect("send");
    match rx.try_recv() {
        .Some(msg) => println(msg),
        .None => println("empty"),
    }
}
