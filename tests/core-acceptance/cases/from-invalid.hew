// `From` impls the failure-edge rule cannot use are refused where they are
// declared: a trait-object target and a blanket over a bare type parameter.
enum AppError {
    Bad;
}

impl Display for AppError {
    fn fmt(self) -> string {
        "Bad"
    }
}

impl Error for AppError {}

impl From<i64> for dyn Error {
    fn from(value: i64) -> dyn Error {
        AppError.Bad
    }
}

impl<T> From<T> for AppError {
    fn from(value: T) -> AppError {
        AppError.Bad
    }
}

fn main() {
    println("unreachable");
}
