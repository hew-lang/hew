//! Keyed memoization with optional expiry and bounded FIFO or LRU eviction.
//!
//! A cache is an ordinary value: copying it creates an independent snapshot.
//! Keys and values must support `Clone`; reads return independent values.
//! Use `cache.new(.Some(128), .Some(5s))` for at most 128 retained entries,
//! each expiring five seconds after insertion. Omit either option to disable
//! that limit. A zero capacity or TTL disables retention; negative limits fail.
//!
//! `get`, `insert` and `touch` accept an observation `instant`, defaulting to
//! the monotonic clock. Supply explicit instants from the same clock. An entry
//! expires at its exact deadline. Reads do not extend TTL. `touch(key)` restarts
//! the TTL on a live entry and returns `false` for a missing or expired key.
//!
//! Use `eviction: .Lru` to evict the least recently used entry. Successful reads
//! and touches update LRU order independently of TTL. FIFO is the default and
//! orders entries by insertion. In either policy, replacement puts a key at the
//! newest end, and insertion reclaims expired entries before evicting live ones.
//! Expiry is lazy. `get` and `touch` reclaim the requested expired entry;
//! `insert`, `prune` and `len` reclaim all expired entries. Pruning skips the scan
//! when every entry is known to be live.
//!
//! Use `set_limits(capacity, ttl)` to change a populated cache. The cache
//! removes entries expired under either TTL using their existing timestamps,
//! then evicts by its policy until the new capacity fits. A zero limit clears
//! the cache and disables retention. Use `values.set_limits(values.capacity(),
//! .Some(5s))` to change only the TTL, or pass `values.ttl()` when changing
//! only the capacity.
//!
//! `get_or_load(key, || load())` calls its loader only on a miss. Successful
//! values are cached with a fresh `instant.now()` after loading finishes.
//! Ordinary errors are returned without caching or evicting live entries.
//! A fault or cancellation also leaves no partially initialized entry.
//!
//! See the complete product-cache example in `examples/keyed_cache.hew`.
//!
//! ```hew
//! import std.cache;
//!
//! fn main() {
//!     var values: cache.Cache<string, i64> = cache.new(capacity: .Some(2)).expect("valid capacity");
//!     values.insert("first", 10);
//!     let loaded: Result<i64, string> = values.get_or_load("second", || .Ok(20));
//!     println(loaded.expect("loaded value"));
//!     let snapshot = values;
//!     values.insert("third", 30);
//!     println(values.get("first").is_none());
//!     var saved = snapshot;
//!     println(saved.get("first").expect("snapshot retains first"));
//! }
//! // Output:
//! // 20
//! // true
//! // 10
//! ```

/// Invalid cache limits.
pub enum CacheError {
    InvalidCapacity(i64);
    InvalidTtl(duration);
}

/// Eviction order when a bounded cache runs out of space.
pub enum Eviction {
    /// Evict the oldest insertion.
    Fifo;
    /// Evict the least recently read, inserted or touched entry.
    Lru;
}

impl Error for CacheError {}

impl Display for CacheError {
    fn fmt(self) -> string {
        match self {
            .InvalidCapacity(capacity) => f"cache: capacity must be nonnegative, got {capacity}",
            .InvalidTtl(ttl) => f"cache: TTL must be nonnegative, got {ttl}",
        }
    }
}

type Entry<V> {
    value: V;
    inserted: instant;
}

type Links<K> {
    older: Option<K>;
    newer: Option<K>;
}

/// An owning value cache. Eviction and invalidation release retained values
/// automatically; no close operation is needed.
pub type Cache<K: Hash + Eq, V> {
    private entries: HashMap<K, Entry<V>>;
    // Eviction order. Reads can update links without copying cached values.
    private links: HashMap<K, Links<K>>;
    private first: Option<K>;
    private last: Option<K>;
    private capacity: Option<i64>;
    private ttl: Option<duration>;
    private eviction: Eviction;
    // Lower bound on retained timestamps, independent of eviction order.
    private oldest: Option<instant>;
}

/// Create an empty cache. Unspecified limits are unbounded.
pub fn new<K: Hash + Eq + Clone, V: Clone>(capacity: Option<i64> = .None, ttl: Option<duration> = .None, eviction: Eviction = .Fifo) -> Cache<K, V> fails CacheError {
    validate_limits(capacity, ttl)?;
    Cache {
        entries: HashMap.new(),
        links: HashMap.new(),
        first: .None,
        last: .None,
        capacity: capacity,
        ttl: ttl,
        eviction: eviction,
        oldest: .None,
    }
}

fn validate_limits(capacity: Option<i64>, ttl: Option<duration>) fails CacheError {
    match capacity {
        .Some(limit) => if limit < 0 {
            return error .InvalidCapacity(limit);
        }
        .None => {}
    }
    match ttl {
        .Some(lifetime) => if lifetime < 0ns {
            return error .InvalidTtl(lifetime);
        }
        .None => {}
    }
}

impl<K: Hash + Eq + Clone, V: Clone> Cache<K, V> {
    /// Configured maximum number of retained entries, if bounded.
    pub fn capacity(self) -> Option<i64> {
        self.capacity
    }

    /// Configured lifetime of each retained entry, if timed.
    pub fn ttl(self) -> Option<duration> {
        self.ttl
    }

    /// Change both limits and apply them to the current entries. Invalid
    /// limits leave the cache unchanged, including entries awaiting expiry.
    /// Live entries retain their timestamps and eviction order.
    pub fn set_limits(var self, capacity: Option<i64>, ttl: Option<duration>, now: instant = instant.now()) fails CacheError {
        validate_limits(capacity, ttl)?;
        if capacity == .Some(0) || ttl == .Some(0ns) {
            self.clear();
        } else {
            // Expiry under either limit is irreversible. The shorter active
            // lifetime removes exactly that union in one pass.
            let expiry = match (self.ttl, ttl) {
                (.Some(old), .Some(new)) => .Some(if old <= new { old } else { new }),
                (.Some(old), .None) => .Some(old),
                (.None, new) => new,
            };
            if let .Some(lifetime) = expiry {
                self.prune_expired(lifetime, now);
            }
            if let .Some(limit) = capacity {
                while self.entries.len() > limit {
                    self.evict_first();
                }
            }
        }
        self.capacity = capacity;
        self.ttl = ttl;
        if ttl.is_none() {
            self.oldest = .None;
        }
    }

    /// Return an independent value and record an LRU hit. An expired entry is removed.
    pub fn get(var self, key: K, now: instant = instant.now()) -> Option<V> {
        match self.live_entry(key, now) {
            .Some(entry) => {
                self.record_access(key);
                .Some(entry.value)
            }
            .None => .None,
        }
    }

    /// Restart the TTL of a live entry and mark it as recently used under LRU.
    /// Return false for an absent or expired key.
    pub fn touch(var self, key: K, now: instant = instant.now()) -> bool {
        match self.live_entry(key, now) {
            .Some(entry) => {
                if self.ttl.is_some() && now > entry.inserted {
                    self.entries[key].inserted = now;
                }
                self.record_access(key);
                true
            }
            .None => false,
        }
    }

    /// Insert or replace a value. Expired entries are reclaimed first; a full
    /// bounded cache evicts according to its policy. Zero limits retain nothing.
    pub fn insert(var self, consume key: K, consume value: V, now: instant = instant.now()) {
        self.prune(now);
        if self.capacity == .Some(0) || self.ttl == .Some(0ns) {
            return;
        }
        if self.entries.contains_key(key) {
            self.invalidate(key);
        }
        match self.capacity {
            .Some(limit) => if self.entries.len() >= limit {
                self.evict_first();
            }
            .None => {}
        }
        if self.ttl.is_some() {
            self.oldest = .Some(earliest(self.oldest, now));
        }
        self.append(key);
        self.entries.insert(key, Entry { value: value, inserted: now });
    }

    /// Return a hit or run the explicit loader once. Failed loads retain no
    /// error and do not evict another live entry. TTL starts after success.
    pub fn get_or_load<E>(var self, consume key: K, consume load: fn[once, suspends]() -> Result<V, E>) -> V fails E {
        match self.get(key) {
            .Some(value) => value,
            .None => {
                let value = load()?;
                self.insert(key, value.clone());
                value
            }
        }
    }

    /// Remove a key regardless of its age. Return whether it was retained.
    pub fn invalidate(var self, key: K) -> bool {
        if self.entries.remove(key).is_none() {
            return false;
        }
        let links = self.links.remove(key).expect("retained key has eviction links");
        self.detach(links);
        if self.entries.is_empty() {
            self.oldest = .None;
        }
        true
    }

    /// Reclaim all entries whose TTL has elapsed. Return the number removed.
    pub fn prune(var self, now: instant = instant.now()) -> i64 {
        match self.ttl {
            .Some(lifetime) => self.prune_expired(lifetime, now),
            .None => 0,
        }
    }

    fn prune_expired(var self, lifetime: duration, now: instant) -> i64 {
        if let .Some(oldest) = self.oldest {
            if !expired(oldest, lifetime, now) {
                return 0;
            }
        }
        var oldest_retained: Option<instant> = .None;
        var next = self.first;
        var removed: i64 = 0;
        while let .Some(key) = next {
            next = self.links[key].newer;
            let inserted = self.entries[key].inserted;
            if expired(inserted, lifetime, now) {
                self.invalidate(key);
                removed += 1;
            } else {
                oldest_retained = .Some(earliest(oldest_retained, inserted));
            }
        }
        self.oldest = oldest_retained;
        removed
    }

    /// Count live entries, reclaiming expired entries first.
    pub fn len(var self, now: instant = instant.now()) -> i64 {
        self.prune(now);
        self.entries.len()
    }

    /// Release every retained key and value, preserving the configured limits.
    pub fn clear(var self) {
        self.entries.clear();
        self.links.clear();
        self.first = .None;
        self.last = .None;
        self.oldest = .None;
    }

    fn live_entry(var self, key: K, now: instant) -> Option<Entry<V>> {
        match self.entries.get(key) {
            .Some(entry) => {
                if let .Some(lifetime) = self.ttl {
                    if expired(entry.inserted, lifetime, now) {
                        self.invalidate(key);
                        return .None;
                    }
                }
                .Some(entry)
            }
            .None => .None,
        }
    }

    fn evict_first(var self) {
        self.invalidate(self.first.expect("cache has an eviction candidate"));
    }

    fn detach(var self, links: Links<K>) {
        if let .Some(key) = links.older {
            self.links[key].newer = links.newer;
        } else {
            self.first = links.newer;
        }
        if let .Some(key) = links.newer {
            self.links[key].older = links.older;
        } else {
            self.last = links.older;
        }
    }

    fn append(var self, key: K) {
        let last = self.last;
        if let .Some(previous) = last {
            self.links[previous].newer = .Some(key);
        } else {
            self.first = .Some(key);
        }
        self.links.insert(key, Links { older: last, newer: .None });
        self.last = .Some(key);
    }

    fn record_access(var self, key: K) {
        if let .Lru = self.eviction {
            if self.last != .Some(key) {
                self.detach(self.links[key]);
                self.append(key);
            }
        }
    }
}

fn expired(inserted: instant, lifetime: duration, now: instant) -> bool {
    now >= inserted && now.duration_since(inserted) >= lifetime
}

fn earliest(bound: Option<instant>, time: instant) -> instant {
    match bound {
        .Some(previous) if previous <= time => previous,
        _ => time,
    }
}
