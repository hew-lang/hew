// Local actor methods admit Send function values without exporting a wire
// protocol. Authenticated export rejects the same payload in the paired
// negative_fn_msg_remote_send fixture.
fn inc(x: i64) -> i64 {
    x + 1
}

actor Worker {
    receive fn carry(f: fn(i64) -> i64) {}
}

fn send_local(pid: Worker) {
    let _ = pid.carry(inc);
}
