fn scenario_link_remote_non_crashlinked(kv: KeyValue) -> i64 {
    let linker = spawn Linker { policy_sel: 1 };
    let linker_id = linker.link_go(kv);
    let lid = match linker_id {
        Result.Ok(id) => id,
        Result.Err(_) => {
            println("FAIL link_remote_non_crashlinked link-ask-error");
            return 2;
        }
    };
    if lid == 0 {
        println("FAIL link_remote_non_crashlinked link-register-failed");
        return 3;
    }
    let t = mailbox(kv).stop_self();
    match t {
        Result.Err(_) => {
            println("FAIL link_remote_non_crashlinked stop-send-error");
            return 4;
        }
        Result.Ok(_) => {}
    }
    sleep(1500ms);
    let st = unsafe {
        hew_link_probe_terminal_state(lid)
    };
    if st >= 0 {
        println(f"FAIL link_remote_non_crashlinked linker-crashed reason={st}");
        return 5;
    }
    let ping = linker.ping();
    match ping {
        Result.Ok(_) => {
            println("PASS link_remote_non_crashlinked linker-survived");
            0
        }
        Result.Err(_) => {
            println("FAIL link_remote_non_crashlinked linker-unreachable");
            6
        }
    }
}

// The same actor operations reach a local actor beside an imported peer:
// submission, completion, monitor and link preserve ordinary actor behaviour.
fn scenario_local_route(kv: KeyValue) -> i64 {
    let local_store: HashMap<string, string> = HashMap.new();
    let local = spawn KeyValue { store: local_store };
    match mailbox(local).put(KvPut { key: "colour", val: "teal" }) {
        Result.Ok(_) => {}
        Result.Err(_) => {
            println("FAIL local_route local-send");
            return 2;
        }
    }
    match (scope within 3s {
        local.handle(KvReq.GetKey("colour"))
    } handle failure {
        match failure {
            .Deadline { message } => .Err(ActorError.TimedOut),
            .Fault { message } => panic(message),
        }
    }) {
        Result.Ok(KvResp.Value(v)) => println(f"PASS local_route local-ask={v}"),
        Result.Ok(_) => {
            println("FAIL local_route local-ask-shape");
            return 3;
        }
        Result.Err(_) => {
            println("FAIL local_route local-ask");
            return 4;
        }
    }
    match (scope within 3s {
        kv.handle(KvReq.GetKey("colour"))
    } handle failure {
        match failure {
            .Deadline { message } => .Err(ActorError.TimedOut),
            .Fault { message } => panic(message),
        }
    }) {
        Result.Ok(KvResp.Value(v)) => println(f"PASS local_route peer-ask=[{v}]"),
        Result.Ok(_) => {
            println("FAIL local_route peer-ask-shape");
            return 5;
        }
        Result.Err(_) => {
            println("FAIL local_route peer-ask");
            return 6;
        }
    }
    let probe = spawn MonitorProbe { active_monitor: .Err(LinkError.NoContext), expect_remote: false };
    match probe.arm(local, 0) {
        Result.Ok(0) => {}
        _ => {
            println("FAIL local_route monitor-arm");
            return 7;
        }
    }
    var down: i64 = 100;
    for _ in 0..100 {
        down = match probe.status() {
            Result.Ok(value) => value,
            Result.Err(_) => -100,
        };
        if down != 100 {
            break;
        }
        sleep(20ms);
    }
    if down != 6 {
        println(f"FAIL local_route monitor-down={down}");
        return 8;
    }
    println("PASS local_route monitor-down=exited");
    let doomed_store: HashMap<string, string> = HashMap.new();
    let doomed = spawn KeyValue { store: doomed_store };
    let linker = spawn Linker { policy_sel: 0 };
    match linker.link_go(doomed) {
        Result.Ok(id) if id != 0 => {}
        _ => {
            println("FAIL local_route link-register");
            return 10;
        }
    }
    let _ = mailbox(doomed).crash_self();
    var linker_alive = true;
    for _ in 0..100 {
        linker_alive = match linker.ping() {
            Result.Ok(_) => true,
            Result.Err(_) => false,
        };
        if !linker_alive {
            break;
        }
        sleep(20ms);
    }
    if linker_alive {
        println("FAIL local_route linker-survived");
        return 11;
    }
    println("PASS local_route link-crash");
    0
}

