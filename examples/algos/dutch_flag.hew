// Dutch National Flag: 3-way partition (0s, 1s, 2s)
fn main() {
    var arr: Vec<i32> = [2, 0, 1, 2, 1, 0];
    var lo = 0;
    var mid = 0;
    var hi = arr.len() - 1;
    while mid <= hi {
        let val = arr[mid];
        if val == 0 {
            let tmp = arr[lo];
            arr.set(lo, arr[mid]);
            arr.set(mid, tmp);
            lo = lo + 1;
            mid = mid + 1;
        } else if val == 1 {
            mid = mid + 1;
        } else {
            let tmp = arr[hi];
            arr.set(hi, arr[mid]);
            arr.set(mid, tmp);
            hi = hi - 1;
        }
    }
    // Expected: [0,0,1,1,2,2]
    let expected: Vec<i32> = [0, 0, 1, 1, 2, 2];
    var pass = true;
    for i in 0..6 {
        if arr[i] != expected[i] {
            pass = false;
            println("FAIL at index:");
            println(i);
        }
    }
    if pass {
        println("PASS");
    } else {
        println("FAIL");
    }
}
