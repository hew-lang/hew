// `stream.open` and `stream.pipe` share one nominal `Stream<bytes>`, so the
// checker admits a select over a file stream. Select observes a pipe's queue
// and has no readiness source for a file, so the selecting actor traps on its
// own turn: a sibling actor keeps serving and the caller sees a crashed actor.
import std.stream;

actor Watcher {
    receive fn watch(consume src: stream.Stream<bytes>) -> i64 {
        select {
            v from src.recv() => match v {
                .Some(_) => 1,
                .None => 0,
            },
        }
    }
}

actor Sibling {
    receive fn ping(n: i64) -> i64 {
        n + 1
    }
}

fn main() {
    let sibling = spawn Sibling();
    let watcher = spawn Watcher();
    let source = match stream.open("tests/core-acceptance/cases/select-file-stream-refused.hew") {
        .Ok(handle) => handle,
        .Err(error) => {
            println(error);
            return;
        },
    };
    match watcher.watch(source) {
        .Ok(_) => println("select over a file stream must not answer"),
        .Err(_) => println("watcher crashed"),
    }
    match sibling.ping(41) {
        .Ok(value) => println(f"sibling {value}"),
        .Err(_) => println("sibling crashed"),
    }
}
