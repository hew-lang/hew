//! HTTP/1.1 client and server using ordinary accept and recv calls.
//! Client and server must run concurrently, so `main` launches both handlers
//! with `fork`: a discarded receive call is an ask, and waiting on the server
//! would leave nobody to make the request.

import std.encoding.utf8;

import std.net;

import std.stream;

import std.net.http.http_async_server;

import std.net.http.http_async_client;

import std.string;

actor Server {
    let addr: string,
    var ready: stream.Sink<i64>,
    receive fn serve(unused: i64) {
        let listener = match net.listen(addr) {
            .Ok(listener) => listener,
            .Err(_) => panic(f"network setup failed"),
        };
        // The client dials only after the listener is bound.
        ready.send(1).expect("ready");
        let conn = listener.accept();
        var raw = "";
        var reads = 0;
        var done = false;
        while !done {
            // `None` is the peer's end of stream; an empty chunk ends the loop.
            let chunk = match conn.recv() {
                .Some(data) => utf8.decode(data) handle error {
                    println(f"invalid UTF-8: {error}");
                    return;
                },
                .None => "",
            };
            reads = reads + 1;
            if string.is_empty(chunk) {
                done = true;
            } else {
                raw = raw + chunk;
                if http_async_server.over_limit(raw) {
                    done = true;
                } else if http_async_server.request_complete(raw) {
                    done = true;
                }
            }
            if reads > http_async_server.MAX_READS {
                done = true;
            }
        }
        let req = http_async_server.parse_request(raw);
        var reply = http_async_server.response_text(req.reject_status(), "rejected");
        if req.is_valid() {
            reply = match req.path() {
                "/hello" => http_async_server.response_text(200, "hi from hew"),
                _ => http_async_server.response_text(404, "nope"),
            };
        }
        let _ = conn.send(reply.to_bytes());
        let _ = conn.close();
        let _ = listener.close();
    }
}

actor Client {
    let url: string,
    receive fn go(unused: i64) {
        let parts = http_async_client.split_address(url);
        let host = http_async_client.host_of(url);
        let conn = match net.connect(parts.0) {
            .Ok(conn) => conn,
            .Err(_) => panic(f"network setup failed"),
        };
        let _ = conn.send(http_async_client.build_get(host, parts.1).to_bytes());
        var raw = "";
        var reads = 0;
        var done = false;
        while !done {
            // `None` is the peer's end of stream; an empty chunk ends the loop.
            let chunk = match conn.recv() {
                .Some(data) => utf8.decode(data) handle error {
                    println(f"invalid UTF-8: {error}");
                    return;
                },
                .None => "",
            };
            reads = reads + 1;
            if string.is_empty(chunk) {
                done = true;
            } else {
                raw = raw + chunk;
                if http_async_client.response_over_limit(raw) {
                    done = true;
                }
            }
            if reads > http_async_client.CLIENT_MAX_READS {
                done = true;
            }
        }
        let _ = conn.close();
        let resp = http_async_client.parse_response(raw);
        let line = match resp.status() {
            200 => f"client-received: {resp.body()}",
            _ => f"client-error: {resp.status()}",
        };
        println(line);
    }
}

fn main() {
    let (ready_tx, ready) = stream.pipe(1).expect("ready");
    let s = spawn Server(addr: "127.0.0.1:18110", ready: ready_tx);
    let c = spawn Client(url: "http://127.0.0.1:18110/hello");
    let serving = fork s.serve(0);
    ready.recv();
    let fetching = fork c.go(0);
    let _ = await fetching;
    let _ = await serving;
    println("main-done");
}
