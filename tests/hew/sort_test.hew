//! Tests for std::sort — sort_ints, sort_strings, sort_floats and the
//! reverse_* family. Each function returns a new vector; the original
//! is never mutated.

import std.sort;

// ── sort_ints ─────────────────────────────────────────────────────────
#[test]
fn test_sort_ints_ascending_order() {
    var v: Vec<i64> = Vec.new();
    v.push(3);
    v.push(1);
    v.push(4);
    v.push(1);
    v.push(5);
    let out = sort.sort_ints(v);
    assert(out.len() == 5);
    assert(out[0] == 1);
    assert(out[1] == 1);
    assert(out[2] == 3);
    assert(out[3] == 4);
    assert(out[4] == 5);
}

#[test]
fn test_sort_ints_does_not_mutate_original() {
    var v: Vec<i64> = Vec.new();
    v.push(9);
    v.push(3);
    v.push(7);
    sort.sort_ints(v);
    assert(v[0] == 9);
    assert(v[1] == 3);
    assert(v[2] == 7);
}

#[test]
fn test_sort_ints_already_sorted() {
    var v: Vec<i64> = Vec.new();
    v.push(1);
    v.push(2);
    v.push(3);
    let out = sort.sort_ints(v);
    assert(out[0] == 1);
    assert(out[1] == 2);
    assert(out[2] == 3);
}

#[test]
fn test_sort_ints_reverse_sorted_input() {
    var v: Vec<i64> = Vec.new();
    v.push(5);
    v.push(4);
    v.push(3);
    v.push(2);
    v.push(1);
    let out = sort.sort_ints(v);
    assert(out[0] == 1);
    assert(out[4] == 5);
}

#[test]
fn test_sort_ints_single_element() {
    var v: Vec<i64> = Vec.new();
    v.push(42);
    let out = sort.sort_ints(v);
    assert(out.len() == 1);
    assert(out[0] == 42);
}

#[test]
fn test_sort_ints_empty() {
    let v: Vec<i64> = Vec.new();
    let out = sort.sort_ints(v);
    assert(out.len() == 0);
}

#[test]
fn test_sort_ints_negative_values() {
    var v: Vec<i64> = Vec.new();
    v.push(0);
    v.push(-5);
    v.push(3);
    v.push(-2);
    let out = sort.sort_ints(v);
    assert(out[0] == -5);
    assert(out[1] == -2);
    assert(out[2] == 0);
    assert(out[3] == 3);
}

#[test]
fn test_sort_ints_comparison_bound_1024_reverse() {
    var v: Vec<i64> = Vec.new();
    for i in 0 .. 1024 {
        v.push(1023 - i);
    }
    let (out, comparisons) = sort.sort_ints_counted(v);
    // n * ceil(log2(n)) is a deterministic upper bound for the production
    // merge core. Selection sort performs 523,776 comparisons here.
    assert(comparisons <= 1024 * 10);
    assert(out.len() == 1024);
    for i in 0 .. 1024 {
        assert(out[i] == i);
        assert(v[i] == 1023 - i);
    }
}

#[test]
fn test_sort_ints_non_power_of_two_permutation_and_equal_values() {
    var v: Vec<i64> = Vec.new();
    for i in 0 .. 17 {
        v.push(i * 7 % 5);
    }
    let out = sort.sort_ints(v);
    assert(out.len() == 17);
    for i in 1 .. out.len() {
        assert(out[i - 1] <= out[i]);
    }
    var input_sum = 0;
    var output_sum = 0;
    var input_squares = 0;
    var output_squares = 0;
    for i in 0 .. 17 {
        input_sum = input_sum + v[i];
        output_sum = output_sum + out[i];
        input_squares = input_squares + v[i] * v[i];
        output_squares = output_squares + out[i] * out[i];
        assert(v[i] == i * 7 % 5);
    }
    assert(output_sum == input_sum);
    assert(output_squares == input_squares);
    var equal: Vec<i64> = Vec.new();
    for _i in 0 .. 33 {
        equal.push(7);
    }
    let equal_out = sort.sort_ints(equal);
    for i in 0 .. 33 {
        assert(equal_out[i] == 7);
        assert(equal[i] == 7);
    }
}

// ── sort_strings ──────────────────────────────────────────────────────
#[test]
fn test_sort_strings_alphabetical_order() {
    var v: Vec<string> = Vec.new();
    v.push("banana");
    v.push("apple");
    v.push("cherry");
    let out = sort.sort_strings(v);
    assert(out.len() == 3);
    assert(out[0] == "apple");
    assert(out[1] == "banana");
    assert(out[2] == "cherry");
}

#[test]
fn test_sort_strings_does_not_mutate_original() {
    var v: Vec<string> = Vec.new();
    v.push("zebra");
    v.push("ant");
    sort.sort_strings(v);
    assert(v[0] == "zebra");
    assert(v[1] == "ant");
}

#[test]
fn test_sort_strings_single_element() {
    var v: Vec<string> = Vec.new();
    v.push("only");
    let out = sort.sort_strings(v);
    assert(out.len() == 1);
    assert(out[0] == "only");
}

#[test]
fn test_sort_strings_empty() {
    let v: Vec<string> = Vec.new();
    let out = sort.sort_strings(v);
    assert(out.len() == 0);
}

#[test]
fn test_sort_strings_duplicate_entries() {
    var v: Vec<string> = Vec.new();
    v.push("b");
    v.push("a");
    v.push("b");
    let out = sort.sort_strings(v);
    assert(out[0] == "a");
    assert(out[1] == "b");
    assert(out[2] == "b");
}

#[test]
fn test_sort_strings_comparison_bound_256_duplicate_reverse() {
    var v: Vec<string> = Vec.new();
    for i in 0 .. 256 {
        let key = match i % 8 {
            0 => "hotel",
            1 => "golf",
            2 => "foxtrot",
            3 => "echo",
            4 => "delta",
            5 => "charlie",
            6 => "bravo",
            _ => "alpha",
        };
        v.push(key);
    }
    let (out, comparisons) = sort.sort_strings_counted(v);
    // n * ceil(log2(n)) is a deterministic upper bound for the production
    // merge core. Selection sort performs 32,640 comparisons here.
    assert(comparisons <= 256 * 8);
    assert(out.len() == 256);
    for i in 1 .. 256 {
        assert(out[i - 1] <= out[i]);
    }
    for i in 0 .. 32 {
        assert(out[i] == "alpha");
        assert(out[32 + i] == "bravo");
        assert(out[64 + i] == "charlie");
        assert(out[96 + i] == "delta");
        assert(out[128 + i] == "echo");
        assert(out[160 + i] == "foxtrot");
        assert(out[192 + i] == "golf");
        assert(out[224 + i] == "hotel");
    }
    assert(v[0] == "hotel");
    assert(v[7] == "alpha");
    assert(v[248] == "hotel");
    assert(v[255] == "alpha");
}

// ── sort_floats ───────────────────────────────────────────────────────
#[test]
fn test_sort_floats_ascending_order() {
    var v: Vec<f64> = Vec.new();
    v.push(3.5);
    v.push(1.25);
    v.push(2.0);
    let out = sort.sort_floats(v);
    assert(out.len() == 3);
    assert(out[0] == 1.25);
    assert(out[1] == 2.0);
    assert(out[2] == 3.5);
}

#[test]
fn test_sort_floats_negative_values() {
    var v: Vec<f64> = Vec.new();
    v.push(1.0);
    v.push(-3.0);
    v.push(0.5);
    v.push(-1.5);
    let out = sort.sort_floats(v);
    assert(out[0] == -3.0);
    assert(out[1] == -1.5);
    assert(out[2] == 0.5);
    assert(out[3] == 1.0);
}

#[test]
fn test_sort_floats_single_element() {
    var v: Vec<f64> = Vec.new();
    v.push(9.9);
    let out = sort.sort_floats(v);
    assert(out.len() == 1);
    assert(out[0] == 9.9);
}

#[test]
fn test_sort_floats_empty() {
    let v: Vec<f64> = Vec.new();
    let out = sort.sort_floats(v);
    assert(out.len() == 0);
}

// ── reverse_ints ──────────────────────────────────────────────────────
#[test]
fn test_reverse_ints_three_elements() {
    var v: Vec<i64> = Vec.new();
    v.push(1);
    v.push(2);
    v.push(3);
    let out = sort.reverse_ints(v);
    assert(out[0] == 3);
    assert(out[1] == 2);
    assert(out[2] == 1);
}

#[test]
fn test_reverse_ints_does_not_mutate_original() {
    var v: Vec<i64> = Vec.new();
    v.push(1);
    v.push(2);
    v.push(3);
    sort.reverse_ints(v);
    assert(v[0] == 1);
}

#[test]
fn test_reverse_ints_single_element() {
    var v: Vec<i64> = Vec.new();
    v.push(7);
    let out = sort.reverse_ints(v);
    assert(out.len() == 1);
    assert(out[0] == 7);
}

#[test]
fn test_reverse_ints_empty() {
    let v: Vec<i64> = Vec.new();
    let out = sort.reverse_ints(v);
    assert(out.len() == 0);
}

#[test]
fn test_reverse_then_sort_round_trips() {
    var v: Vec<i64> = Vec.new();
    v.push(3);
    v.push(1);
    v.push(2);
    let sorted = sort.sort_ints(v);
    let reversed = sort.reverse_ints(sorted);
    let re_sorted = sort.sort_ints(reversed);
    assert(re_sorted[0] == 1);
    assert(re_sorted[1] == 2);
    assert(re_sorted[2] == 3);
}

// ── reverse_strings ───────────────────────────────────────────────────
#[test]
fn test_reverse_strings_three_elements() {
    var v: Vec<string> = Vec.new();
    v.push("a");
    v.push("b");
    v.push("c");
    let out = sort.reverse_strings(v);
    assert(out[0] == "c");
    assert(out[1] == "b");
    assert(out[2] == "a");
}

#[test]
fn test_reverse_strings_single_element() {
    var v: Vec<string> = Vec.new();
    v.push("solo");
    let out = sort.reverse_strings(v);
    assert(out.len() == 1);
    assert(out[0] == "solo");
}

#[test]
fn test_reverse_strings_empty() {
    let v: Vec<string> = Vec.new();
    let out = sort.reverse_strings(v);
    assert(out.len() == 0);
}

// ── reverse_floats ────────────────────────────────────────────────────
#[test]
fn test_reverse_floats_three_elements() {
    var v: Vec<f64> = Vec.new();
    v.push(1.0);
    v.push(2.5);
    v.push(3.0);
    let out = sort.reverse_floats(v);
    assert(out[0] == 3.0);
    assert(out[1] == 2.5);
    assert(out[2] == 1.0);
}

#[test]
fn test_reverse_floats_single_element() {
    var v: Vec<f64> = Vec.new();
    v.push(4.4);
    let out = sort.reverse_floats(v);
    assert(out.len() == 1);
    assert(out[0] == 4.4);
}

#[test]
fn test_reverse_floats_empty() {
    let v: Vec<f64> = Vec.new();
    let out = sort.reverse_floats(v);
    assert(out.len() == 0);
}

// ── sort_by (hew-lang/hew#2933) ──────────────────────────────────────
//
// Generic over any `T`; there is no `v.sort_by(less)` fluent method form
// (the checker reserves inherent `impl Vec<T> { ... }` blocks for
// `std/builtins.hew`) — see `sort_by`'s doc comment for the compiler-gap
// detail.
#[test]
fn test_sort_by_ascending_with_custom_comparator() {
    var v: Vec<i64> = Vec.new();
    v.push(3);
    v.push(1);
    v.push(2);
    let out = sort.sort_by(v, |a: i64, b: i64| a < b);
    assert(out.len() == 3);
    assert(out[0] == 1);
    assert(out[1] == 2);
    assert(out[2] == 3);
}

#[test]
fn test_sort_by_descending_comparator_reverses_order() {
    // Negative control: a `>` comparator produces the opposite order from
    // `<`, proving the comparator (not a hardcoded ascending sort) drives
    // the result.
    var v: Vec<i64> = Vec.new();
    v.push(3);
    v.push(1);
    v.push(2);
    let out = sort.sort_by(v, |a: i64, b: i64| a > b);
    assert(out.len() == 3);
    assert(out[0] == 3);
    assert(out[1] == 2);
    assert(out[2] == 1);
}

#[test]
fn test_sort_by_does_not_mutate_original() {
    var v: Vec<i64> = Vec.new();
    v.push(3);
    v.push(1);
    v.push(2);
    let _out = sort.sort_by(v, |a: i64, b: i64| a < b);
    assert(v.len() == 3);
    assert(v[0] == 3);
    assert(v[1] == 1);
    assert(v[2] == 2);
}

#[test]
fn test_sort_by_strings() {
    var v: Vec<string> = Vec.new();
    v.push("banana");
    v.push("apple");
    v.push("cherry");
    let out = sort.sort_by(v, |a: string, b: string| a < b);
    assert(out[0] == "apple");
    assert(out[1] == "banana");
    assert(out[2] == "cherry");
}
