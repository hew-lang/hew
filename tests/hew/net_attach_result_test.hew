//! Compiled consumer for the consuming TCP attach Result contract.
//!
//! Success transfers the server connection to the reactor. Refusal also
//! consumes and closes it, so neither match arm retains a connection to close.

import std.net;

import std.net.{AttachError};

import std.testing;

actor AttachedHandler {
    receive fn on_data(data: bytes) {}

    receive fn on_close() {}
}

actor RefusedHandler {
    mailbox 1 overflow drop_old;

    receive fn on_data(data: bytes) {}

    receive fn on_close() {}
}

#[test]
fn test_tcp_attach_returns_ok_and_transfers_close_authority() {
    let listener = match net.listen("127.0.0.1:0") { .Ok(value) => value, .Err(error) => panic(to_string(error)), };
    let client = match net.connect(f"127.0.0.1:{listener.local_port()}") { .Ok(value) => value, .Err(error) => panic(to_string(error)), };
    let server = listener.accept();
    let handler: LocalPid<AttachedHandler> = spawn AttachedHandler;
    match server.attach(handler) {
        .Ok(()) => testing.assert_true(true),
        .Err(AttachError.Refused) => panic("unbounded handler attach was refused"),
    }
    client.close();
    listener.close();
    sleep(100ms);
}

#[test]
fn test_tcp_attach_returns_err_after_closing_refused_connection() {
    let listener = match net.listen("127.0.0.1:0") { .Ok(value) => value, .Err(error) => panic(to_string(error)), };
    let client = match net.connect(f"127.0.0.1:{listener.local_port()}") { .Ok(value) => value, .Err(error) => panic(to_string(error)), };
    let server = listener.accept();
    let handler: LocalPid<RefusedHandler> = spawn RefusedHandler;
    match server.attach(handler) {
        .Ok(()) => panic("drop-old handler attach unexpectedly succeeded"),
        .Err(AttachError.Refused) => testing.assert_true(true),
    }
    client.close();
    listener.close();
}

#[test]
fn test_attach_error_display_prints_the_refusal_reason() {
    testing.assert_eq_str(to_string(AttachError.Refused), "the runtime refused the active-mode registration");
}
