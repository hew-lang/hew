import std.net.{Listener, Connection};

extern "C" {
    fn hew_tcp_listener_local_port(listener: Listener) -> i32;
}

actor Session {
    let conn: Connection;

    receive fn pump(unused: i64) {
        let body = conn.read_string();
        println(f"session-received: {body}");
    }
}

fn main() {
    let listener = match net.listen("127.0.0.1:0") {
        .Ok(listener) => listener,
        .Err(err) => panic(f"network setup failed: {err}"),
    };
    let port = unsafe {
        hew_tcp_listener_local_port(listener)
    };
    let conn = match net.connect(f"127.0.0.1:{port}") {
        .Ok(conn) => conn,
        .Err(err) => panic(f"network setup failed: {err}"),
    };
    let session = spawn Session(conn: conn);
    session.pump(0);
    let client = listener.accept();
    let _ = client.write_string("hello");
    sleep(300ms);
    let _ = client.close();
    println("server-done");
}
