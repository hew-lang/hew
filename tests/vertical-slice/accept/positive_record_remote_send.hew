// Accept: a record message with an explicit wire schema crosses a
// RemotePid<T>::send boundary.
#[wire]
type Ping {
    n: i64 @1,
}

actor Worker {
    receive fn ping(msg: Ping) {}
}

impl ActorMsg for Worker {
    type Msg = Ping;
    type Reply = ();
}

fn send_remote(pid: RemotePid<Worker>) -> Result<(), SendError> {
    pid.send(Ping { n: 42 })
}
