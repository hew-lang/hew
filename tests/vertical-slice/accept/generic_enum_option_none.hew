// Accept: generic enum Maybe<T> with None variant — end-to-end lowering.
// Maybe::None must lower through HIR EnumLayoutRegistry → MIR → codegen
// and the default arm must match, exiting 99.
enum Maybe<T> {
    Some(T);
    None;
}

fn main() -> i64 {
    let x: Maybe<i64> = Maybe::None;
    match x {
        Maybe::Some(v) => v,
        Maybe::None => 99,
    }
}
