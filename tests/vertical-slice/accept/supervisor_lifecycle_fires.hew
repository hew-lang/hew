// Proving fixture: an actor's init() / #[on(start)] hooks fire under
// supervision, on BOTH the initial supervised spawn AND a supervisor-triggered
// restart -- the lifecycle-under-supervision contract.
//
// Distinguishing-from-garbage design (the load-bearing test property):
//   - `value` has no default and `init` assigns it, so under D447 it is a
//     deferred field: the supervisor's child declaration cannot name it and
//     100 is reachable only by RUNNING init().
//   - #[on(start)] then adds 10 -> 110. So `get()` returns:
//       * 110 only if BOTH init() and #[on(start)] ran,
//       * 100 if init ran but on_start did not.
//   The sibling supervised_actor_init_block.hew has an EMPTY init(), so it
//   cannot tell init-firing from spawn-argument seeding. This fixture's init()
//   is the only writer of `value`, so it can.
//
// Determinism: the restart is observed with `await_restart`, the cooperative
// barrier that suspends until the named child's slot is Live again. The
// supervisor's restart counter advances only AFTER restart_child_from_spec +
// store_child_slot complete, and the lifecycle wrapper fires inside
// restart_child_from_spec (before store_child_slot), so when the barrier
// resumes the restarted child has already run init()/#[on(start)] and is Live.
// No sleep_ms; no race.
//
// Exit code 220 (= 110 initial + 110 after restart) proves init()+#[on(start)]
// fired on the initial supervised spawn AND again on the restarted incarnation.
// A run where either hook is skipped reads a different number -- a distinct,
// visible failure, never a false pass.
actor Counter {
    var value: i64,
    init() {
        value = 100;
    }
    receive fn get() -> i64 {
        value
    }
    receive fn crash_me() {
        panic("supervised lifecycle restart trigger");
    }
    #[on(start)]
    fn boot() {
        value = value + 10;
    }
}

supervisor App {
    strategy: one_for_one,
    intensity: 3 within 60s,

    child counter: Counter,
}

fn main() -> i64 {
    let sup = spawn App;
    let c = sup.counter;
    let initial = match c.get() {
        .Ok(v) => v,
        .Err(_) => {
            return 1;
        },
    };
    if initial != 110 {
        return initial;
    }
    let _ = c.crash_me();
    let _ = await_restart sup.counter;
    let c2 = sup.counter;
    let after = match c2.get() {
        .Ok(v) => v,
        .Err(_) => {
            return 3;
        },
    };
    initial + after
}
