// A captured fluent chain transfers one TOML array owner, while array_get
// creates an independent deep owner that survives closing the root.
import std.encoding.toml;

fn early_exit(flag: bool) {
    let value = toml.table();
    value.with("n", toml.from_int(11));
    let child = value.get_field("n");
    if flag {
        return;
    }
    println(child.get_int());
}

fn _panic_exit() {
    let value = toml.table();
    value.with("n", toml.from_int(12));
    let _child = value.get_field("n");
    panic("toml value panic probe");
}

fn cancel_exit() {
    let value = toml.table();
    value.with("n", toml.from_int(13));
    let _child = value.get_field("n");
    var i: i64 = 0;
    while i < 2 {
        i = i + 1;
    }
}

actor TomlCancelDriver {
    receive fn drive() {
        scope {
            cancel_exit();
        };
    }
}

fn main() {
    let value = toml.array().push(toml.from_int(8)).push_int(10);
    let child = value.array_get(0);
    value.close();
    println(child.get_int());

    // A parse failure returns no parent owner to mutate or free.
    match toml.parse("=") {
        .Ok(parsed) => {
            parsed.free();
            panic("malformed TOML unexpectedly parsed");
        },
        .Err(_) => {},
    }
    early_exit(true);
}
