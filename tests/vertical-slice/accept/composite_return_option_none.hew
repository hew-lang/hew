// Accept: user function returning Maybe<i64> with None (unit variant).
// Exercises Move of tag-only struct to ReturnSlot.
// Exit 99 proves the None arm matched in the caller.
enum Maybe<T> {
    Some(T);
    None;
}

fn nothing() -> Maybe<i64> {
    Maybe.None
}

fn main() -> i64 {
    let r = nothing();
    match r {
        Maybe.Some(v) => v,
        Maybe.None => 99,
    }
}
