#[resource]
type Conn { fd: i64 }
impl Conn {
    fn close(consume self) { println(f"close {self.fd}"); }
}
actor Holder {
    receive fn take(c: Conn) { println(f"got {c.fd}"); }
}
fn main() {
    let h = spawn Holder();
    let c = Conn { fd: 1 };
    let _ = h.take(c);
    println(f"after {c.fd}");
}
