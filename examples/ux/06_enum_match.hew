enum Signal {
    Red;
    Amber;
    Green;
}

fn instruction(signal: Signal) -> string {
    match signal {
        .Red => "Stop",
        .Amber => "Prepare to stop",
        .Green => "Go",
    }
}

fn main() {
    for signal in [Signal.Red, .Amber, .Green] {
        println(instruction(signal));
    }
}
