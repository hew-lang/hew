// Unrolled Linked List using Vec<i64> with index-based pointers
// Each block holds up to BLOCK_CAP (4) elements.
// Block layout: [count, e0, e1, e2, e3, next] = 6 slots per block
// Block i starts at index i*6
//
// A parameter is the callee's own copy, so every helper that writes the block
// pool returns it and the caller reassigns. Helpers that also report an index
// return a tuple.
fn block_count(n: Vec<i64>, b: i64) -> i64 {
    n[b * 6]
}

fn block_elem(n: Vec<i64>, b: i64, idx: i64) -> i64 {
    n[b * 6 + 1 + idx]
}

fn block_next(n: Vec<i64>, b: i64) -> i64 {
    n[b * 6 + 5]
}

fn set_count(var n: Vec<i64>, b: i64, c: i64) -> Vec<i64> {
    n.set(b * 6, c);
    n
}

fn set_elem(var n: Vec<i64>, b: i64, idx: i64, val: i64) -> Vec<i64> {
    n.set(b * 6 + 1 + idx, val);
    n
}

fn set_block_next(var n: Vec<i64>, b: i64, nx: i64) -> Vec<i64> {
    n.set(b * 6 + 5, nx);
    n
}

fn alloc_block(var n: Vec<i64>) -> (Vec<i64>, i64) {
    let b = n.len() / 6;
    n.push(0);
    n.push(0);
    n.push(0);
    n.push(0);
    n.push(0);
    n.push(-1);
    (n, b)
}

// Insert at end of unrolled list. Returns the pool and the head.
fn unrolled_insert(var n: Vec<i64>, head: i64, val: i64) -> (Vec<i64>, i64) {
    if head == -1 {
        let (grown, b) = alloc_block(n);
        n = set_elem(grown, b, 0, val);
        n = set_count(n, b, 1);
        return (n, b);
    }
    // Find last block
    var last = head;
    while block_next(n, last) != -1 {
        last = block_next(n, last);
    }
    let cnt = block_count(n, last);
    if cnt < 4 {
        n = set_elem(n, last, cnt, val);
        n = set_count(n, last, cnt + 1);
    } else {
        let (grown, b) = alloc_block(n);
        n = set_elem(grown, b, 0, val);
        n = set_count(n, b, 1);
        n = set_block_next(n, last, b);
    }
    (n, head)
}

// Insert every value in order; returns the pool and the head.
fn unrolled_insert_all(var n: Vec<i64>, head: i64, values: Vec<i64>) -> (Vec<i64>, i64) {
    var curr_head = head;
    for value in values {
        let (grown, new_head) = unrolled_insert(n, curr_head, value);
        n = grown;
        curr_head = new_head;
    }
    (n, curr_head)
}

// Collect all elements in order
fn unrolled_iterate(n: Vec<i64>, head: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec.new();
    var b = head;
    while b != -1 {
        let cnt = block_count(n, b);
        for i in 0 .. cnt {
            result.push(block_elem(n, b, i));
        }
        b = block_next(n, b);
    }
    result
}

// Total element count
fn unrolled_len(n: Vec<i64>, head: i64) -> i64 {
    var total = 0;
    var b = head;
    while b != -1 {
        total = total + block_count(n, b);
        b = block_next(n, b);
    }
    total
}

// Count blocks
fn block_count_total(n: Vec<i64>, head: i64) -> i64 {
    var c = 0;
    var b = head;
    while b != -1 {
        c = c + 1;
        b = block_next(n, b);
    }
    c
}

// Get element by logical index
fn unrolled_get(n: Vec<i64>, head: i64, idx: i64) -> i64 {
    var b = head;
    var remaining = idx;
    while b != -1 {
        let cnt = block_count(n, b);
        if remaining < cnt {
            return block_elem(n, b, remaining);
        }
        remaining = remaining - cnt;
        b = block_next(n, b);
    }
    -1
}

fn vecs_equal(a: Vec<i64>, b: Vec<i64>) -> i64 {
    if a.len() != b.len() {
        return 0;
    }
    for i in 0 .. a.len() {
        if a[i] != b[i] {
            return 0;
        }
    }
    1
}

// --- Tests ---
fn test_insert_and_iterate() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let values: Vec<i64> = [10, 20, 30];
    let (n, head) = unrolled_insert_all(pool, -1, values);
    let r = unrolled_iterate(n, head);
    var e: Vec<i64> = Vec.new();
    e.push(10);
    e.push(20);
    e.push(30);
    if vecs_equal(r, e) == 1 {
        println("PASS: insert and iterate");
        return 1;
    }
    println("FAIL: insert and iterate");
    0
}

fn test_block_split() -> i64 {
    let pool: Vec<i64> = Vec.new();
    // Insert 5 elements - should create 2 blocks (4+1)
    let values: Vec<i64> = [1, 2, 3, 4, 5];
    let (n, head) = unrolled_insert_all(pool, -1, values);
    if block_count_total(n, head) == 2 {
        if unrolled_len(n, head) == 5 {
            println("PASS: block split");
            return 1;
        }
    }
    println("FAIL: block split");
    0
}

fn test_cross_block_iteration() -> i64 {
    var n: Vec<i64> = Vec.new();
    var head = -1;
    // Insert 10 elements across 3 blocks (4+4+2)
    for i in 0 .. 10 {
        let (grown, new_head) = unrolled_insert(n, head, (i + 1) * 10);
        n = grown;
        head = new_head;
    }
    let r = unrolled_iterate(n, head);
    var ok = 1;
    for i in 0 .. 10 {
        if r[i] != (i + 1) * 10 {
            ok = 0;
        }
    }
    if ok == 1 {
        if r.len() == 10 {
            println("PASS: cross-block iteration");
            return 1;
        }
    }
    println("FAIL: cross-block iteration");
    0
}

fn test_random_access() -> i64 {
    var n: Vec<i64> = Vec.new();
    var head = -1;
    for i in 0 .. 8 {
        let (grown, new_head) = unrolled_insert(n, head, i * 100);
        n = grown;
        head = new_head;
    }
    let v0 = unrolled_get(n, head, 0);
    let v3 = unrolled_get(n, head, 3);
    let v5 = unrolled_get(n, head, 5);
    let v7 = unrolled_get(n, head, 7);
    if v0 == 0 {
        if v3 == 300 {
            if v5 == 500 {
                if v7 == 700 {
                    println("PASS: random access");
                    return 1;
                }
            }
        }
    }
    println("FAIL: random access");
    0
}

fn test_single_block() -> i64 {
    let pool: Vec<i64> = Vec.new();
    let (n, head) = unrolled_insert(pool, -1, 42);
    if block_count_total(n, head) == 1 {
        if unrolled_get(n, head, 0) == 42 {
            println("PASS: single block");
            return 1;
        }
    }
    println("FAIL: single block");
    0
}

fn test_many_blocks() -> i64 {
    var n: Vec<i64> = Vec.new();
    var head = -1;
    // 20 elements = 5 blocks of 4
    for i in 0 .. 20 {
        let (grown, new_head) = unrolled_insert(n, head, i);
        n = grown;
        head = new_head;
    }
    if block_count_total(n, head) == 5 {
        if unrolled_len(n, head) == 20 {
            // Verify order
            let r = unrolled_iterate(n, head);
            var ok = 1;
            for i in 0 .. 20 {
                if r[i] != i {
                    ok = 0;
                }
            }
            if ok == 1 {
                println("PASS: many blocks");
                return 1;
            }
        }
    }
    println("FAIL: many blocks");
    0
}

fn main() {
    println("=== Unrolled List Tests ===");
    var passed = 0;
    let total = 6;
    passed = passed + test_insert_and_iterate();
    passed = passed + test_block_split();
    passed = passed + test_cross_block_iteration();
    passed = passed + test_random_access();
    passed = passed + test_single_block();
    passed = passed + test_many_blocks();
    println("");
    print("Passed: ");
    print(passed);
    println(f"/{total}");
    if passed == total {
        println("OVERALL: PASS");
    } else {
        println("OVERALL: FAIL");
    }
}
