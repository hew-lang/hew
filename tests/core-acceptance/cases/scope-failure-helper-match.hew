// A `ScopeFailure` passed to a helper by its written type matches on the same
// declaration the handler binding carries.
import std.stream;

fn verdict(failure: ScopeFailure) -> string {
    match failure {
        .Deadline { .. } => "deadline",
        .Fault { message } => {
            assert(message == "boom");
            "fault boom"
        }
    }
}

fn main() {
    let (_never, gate): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("gate");
    let late = scope within 20ms {
        gate.recv();
        "done"
    } handle failure { verdict(failure) };
    println(late);
    let broken = scope {
        panic("boom");
        "done"
    } handle failure { verdict(failure) };
    println(broken);
}
