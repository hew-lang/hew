//! TCP connection-failure and end-of-stream example using `conn.recv()`.
//! A failed connection follows the error arm; a connected peer that closes
//! yields `None`. These are distinct outcomes.

import std.net;

actor Reader {
    receive fn go(unused: i64) {

        // Nothing listens here: the connect fails, or a peer that hangs up
        // after connecting ends the stream with `None`.
        let conn = match net.connect("127.0.0.1:9") {
            .Ok(conn) => conn,
            .Err(_) => {
                println("connect refused");
                return;
            },
        };
        match conn.recv() {
            .Some(body) => println(f"read {body.len()} bytes"),
            .None => println("end of stream"),
        }
        let _ = conn.close();
    }
}

fn main() {
    let r = spawn Reader;
    let _ = r.go(0);
    sleep(300ms);
    println("done");
}
