//! Tests for std::text::semver — parse, accessors, compare, matches,
//! and to_string. Version is a value type; no explicit free() is required.

import std.text.semver;

import std.testing;

// ── parse / accessors ─────────────────────────────────────────────────
#[test]
fn test_parse_simple_version_components() {
    let v = semver.parse("1.2.3");
    testing.assert_eq(v.major(), 1);
    testing.assert_eq(v.minor(), 2);
    testing.assert_eq(v.patch(), 3);
}

#[test]
fn test_parse_zero_version() {
    let v = semver.parse("0.0.0");
    testing.assert_eq(v.major(), 0);
    testing.assert_eq(v.minor(), 0);
    testing.assert_eq(v.patch(), 0);
}

#[test]
fn test_parse_pre_release_label() {
    let v = semver.parse("2.0.0-alpha.1");
    testing.assert_eq(v.major(), 2);
    testing.assert_eq_str(v.pre(), "alpha.1");
}

#[test]
fn test_parse_no_pre_release_returns_empty_string() {
    let v = semver.parse("1.0.0");
    testing.assert_eq_str(v.pre(), "");
}

#[test]
fn test_parse_large_component_values() {
    let v = semver.parse("10.20.30");
    testing.assert_eq(v.major(), 10);
    testing.assert_eq(v.minor(), 20);
    testing.assert_eq(v.patch(), 30);
}

#[test]
fn test_unbounded_core_components_round_trip_and_compare_by_magnitude() {
    let huge = semver.parse("184467440737095516161844674407370955161.2.3");
    let smaller = semver.parse("99999999999999999999999999999999999999.9.9");
    testing.assert_eq_str(huge.to_string(), "184467440737095516161844674407370955161.2.3");
    testing.assert_eq(huge.compare(smaller), 1);
}

#[test]
fn test_unbounded_minor_and_patch_participate_in_precedence() {
    let minor_hi = semver.parse("1.100000000000000000000000000000000000000.0");
    let minor_lo = semver.parse("1.99999999999999999999999999999999999999.999");
    testing.assert_eq(minor_hi.compare(minor_lo), 1);
    let patch_hi = semver.parse("1.0.100000000000000000000000000000000000000");
    let patch_lo = semver.parse("1.0.99999999999999999999999999999999999999");
    testing.assert_eq(patch_hi.compare(patch_lo), 1);
}

// ── to_string ─────────────────────────────────────────────────────────
#[test]
fn test_to_string_round_trips_simple_version() {
    let v = semver.parse("1.2.3");
    testing.assert_eq_str(v.to_string(), "1.2.3");
}

#[test]
fn test_to_string_includes_pre_release() {
    let v = semver.parse("1.0.0-beta");
    testing.assert_eq_str(v.to_string(), "1.0.0-beta");
}

// ── compare ───────────────────────────────────────────────────────────
#[test]
fn test_compare_equal_versions_returns_zero() {
    let a = semver.parse("1.2.3");
    let b = semver.parse("1.2.3");
    testing.assert_eq(a.compare(b), 0);
}

#[test]
fn test_compare_greater_major_returns_one() {
    let a = semver.parse("2.0.0");
    let b = semver.parse("1.9.9");
    testing.assert_eq(a.compare(b), 1);
}

#[test]
fn test_compare_lesser_major_returns_neg_one() {
    let a = semver.parse("1.0.0");
    let b = semver.parse("2.0.0");
    testing.assert_eq(a.compare(b), -1);
}

#[test]
fn test_compare_minor_difference() {
    let a = semver.parse("1.3.0");
    let b = semver.parse("1.2.0");
    testing.assert_eq(a.compare(b), 1);
    testing.assert_eq(b.compare(a), -1);
}

#[test]
fn test_compare_patch_difference() {
    let a = semver.parse("1.2.4");
    let b = semver.parse("1.2.3");
    testing.assert_eq(a.compare(b), 1);
}

// ── matches ───────────────────────────────────────────────────────────
#[test]
fn test_matches_exact_version() {
    let v = semver.parse("1.2.3");
    testing.assert_true(v.matches("=1.2.3"));
}

#[test]
fn test_matches_gte_satisfied() {
    let v = semver.parse("1.2.3");
    testing.assert_true(v.matches(">=1.0.0"));
    testing.assert_true(v.matches(">=1.2.3"));
}

#[test]
fn test_matches_gte_not_satisfied() {
    let v = semver.parse("1.0.0");
    testing.assert_false(v.matches(">=2.0.0"));
}

#[test]
fn test_matches_gt_strictly_greater() {
    let v = semver.parse("2.0.0");
    testing.assert_true(v.matches(">1.9.9"));
    testing.assert_false(v.matches(">2.0.0"));
}

#[test]
fn test_matches_lt_strictly_less() {
    let v = semver.parse("1.0.0");
    testing.assert_true(v.matches("<2.0.0"));
    testing.assert_false(v.matches("<1.0.0"));
}

#[test]
fn test_matches_lte_satisfied() {
    let v = semver.parse("1.0.0");
    testing.assert_true(v.matches("<=1.0.0"));
    testing.assert_true(v.matches("<=2.0.0"));
    testing.assert_false(v.matches("<=0.9.9"));
}

// ── prerelease precedence (SemVer 2.0 §11) ────────────────────────────
// Exercises the alphanumeric strcmp path in compare_pre_id, which was
// previously misread due to an i32/i64 FFI ABI mismatch on
// hew_string_compare (a negative strcmp result was zero-extended to a
// large positive i64, so the `< 0` arm never fired).
#[test]
fn test_compare_prerelease_alpha_less_than_beta() {
    let a = semver.parse("1.0.0-alpha");
    let b = semver.parse("1.0.0-beta");
    testing.assert_eq(a.compare(b), -1);
    testing.assert_eq(b.compare(a), 1);
}

#[test]
fn test_compare_prerelease_equal_labels() {
    let a = semver.parse("1.0.0-alpha");
    let b = semver.parse("1.0.0-alpha");
    testing.assert_eq(a.compare(b), 0);
}

#[test]
fn test_compare_prerelease_shorter_has_lower_precedence() {
    // 1.0.0-alpha < 1.0.0-alpha.1 (a larger set of fields, all preceding equal)
    let a = semver.parse("1.0.0-alpha");
    let b = semver.parse("1.0.0-alpha.1");
    testing.assert_eq(a.compare(b), -1);
    testing.assert_eq(b.compare(a), 1);
}

#[test]
fn test_compare_prerelease_numeric_ids_compared_numerically() {
    // rc.2 < rc.11 numerically (not lexically)
    let a = semver.parse("1.0.0-rc.2");
    let b = semver.parse("1.0.0-rc.11");
    testing.assert_eq(a.compare(b), -1);
    testing.assert_eq(b.compare(a), 1);
}

#[test]
fn test_compare_prerelease_numeric_lower_than_alphanumeric() {
    // beta.2 < beta.fix — numeric identifier has lower precedence than alphanumeric
    let a = semver.parse("1.0.0-beta.2");
    let b = semver.parse("1.0.0-beta.fix");
    testing.assert_eq(a.compare(b), -1);
    testing.assert_eq(b.compare(a), 1);
}

#[test]
fn test_compare_prerelease_lower_than_release() {
    // A version with a prerelease has lower precedence than the release.
    let a = semver.parse("1.0.0-rc.1");
    let b = semver.parse("1.0.0");
    testing.assert_eq(a.compare(b), -1);
    testing.assert_eq(b.compare(a), 1);
}

#[test]
fn test_compare_prerelease_full_chain() {
    // SemVer 2.0 §11 example chain: alpha < alpha.1 < beta < rc.1 < release.
    let alpha = semver.parse("1.0.0-alpha");
    let alpha1 = semver.parse("1.0.0-alpha.1");
    let beta = semver.parse("1.0.0-beta");
    let rc1 = semver.parse("1.0.0-rc.1");
    let rel = semver.parse("1.0.0");
    testing.assert_eq(alpha.compare(alpha1), -1);
    testing.assert_eq(alpha1.compare(beta), -1);
    testing.assert_eq(beta.compare(rc1), -1);
    testing.assert_eq(rc1.compare(rel), -1);
}

// ── parse error boundaries ─────────────────────────────────────────────
// The parse() doc explicitly states it panics on malformed input.
// These tests exercise the two explicit panic branches in the
// implementation: missing first dot (no major separator) and missing
// second dot (no minor.patch separator).
#[test]
#[should_panic]
fn test_parse_panics_on_missing_first_dot() {
    // "1" has no dot at all — hits the `first_dot < 0` panic branch.
    semver.parse("1");
}

#[test]
#[should_panic]
fn test_parse_panics_on_missing_second_dot() {
    // "1.2" has a first dot but no second — hits the `second_dot < 0` panic branch.
    semver.parse("1.2");
}

// ── SemVer 2.0 grammar is exact ───────────────────────────────────────
fn expect_rejected(s: string) {
    match semver.try_parse(s) {
        .Ok(v) => panic(f"expected `{s}` to be rejected, got {v.to_string()}"),
        .Err(_) => {},
    }
}

fn expect_accepted(s: string) {
    match semver.try_parse(s) {
        .Ok(_) => {},
        .Err(reason) => panic(f"expected `{s}` to parse: {reason}"),
    }
}

#[test]
fn test_try_parse_rejects_leading_zeros_in_numeric_components() {
    expect_rejected("01.2.3");
    expect_rejected("1.02.3");
    expect_rejected("1.2.03");
}

#[test]
fn test_try_parse_rejects_empty_numeric_components() {
    expect_rejected("1..3");
    expect_rejected(".2.3");
    expect_rejected("1.2.");
}

#[test]
fn test_try_parse_rejects_extra_version_components() {
    expect_rejected("1.2.3.4");
}

#[test]
fn test_try_parse_rejects_an_empty_pre_release() {
    expect_rejected("1.2.3-");
}

#[test]
fn test_try_parse_rejects_an_empty_pre_release_identifier() {
    expect_rejected("1.2.3-alpha..1");
}

#[test]
fn test_try_parse_rejects_a_leading_zero_in_a_numeric_pre_release_identifier() {
    expect_rejected("1.2.3-01");
}

#[test]
fn test_try_parse_rejects_an_illegal_character_in_a_pre_release_identifier() {
    expect_rejected("1.2.3-alpha_1");
}

#[test]
fn test_try_parse_rejects_an_empty_build_metadata() {
    expect_rejected("1.2.3+");
    expect_rejected("1.2.3+a..b");
    expect_rejected("1.2.3+a_b");
}

#[test]
fn test_try_parse_accepts_the_spec_examples() {
    expect_accepted("0.0.4");
    expect_accepted("1.2.3");
    expect_accepted("10.20.30");
    expect_accepted("1.1.2-prerelease+meta");
    expect_accepted("1.1.2+meta");
    expect_accepted("1.0.0-alpha");
    expect_accepted("1.0.0-alpha.beta");
    expect_accepted("1.0.0-alpha.1");
    expect_accepted("1.0.0-alpha0.valid");
    expect_accepted("1.0.0-alpha.0valid");
    expect_accepted("1.0.0-rc.1+build.1");
    expect_accepted("2.0.0-rc.1+build.123");
    expect_accepted("1.2.3-beta");
    expect_accepted("1.0.0-0A.is.legal");
}

#[test]
fn test_numeric_pre_release_identifiers_compare_beyond_i64() {
    // Numeric identifiers compare numerically at arbitrary length. Both of
    // these exceed what an i64 can hold, so a to_int fallback collapses them
    // to the same value.
    let lo = semver.parse("1.0.0-99999999999999999999");
    let hi = semver.parse("1.0.0-99999999999999999998");
    testing.assert_eq(lo.compare(hi), 1);
    testing.assert_eq(hi.compare(lo), -1);
}

#[test]
fn test_longer_numeric_pre_release_identifiers_have_higher_precedence() {
    let short = semver.parse("1.0.0-9999999999999999999");
    let long = semver.parse("1.0.0-10000000000000000000");
    testing.assert_eq(short.compare(long), -1);
    testing.assert_eq(long.compare(short), 1);
}

#[test]
#[should_panic]
fn test_parse_panics_at_legacy_boundary_on_a_leading_zero() {
    let _ = semver.parse("01.2.3");
}
