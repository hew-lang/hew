    use BindingId(30) n site=SiteId(145) ty=i64 intent=Read
    return site=Some(SiteId(144)) ty=duration
  decisions:
    site=s0 ty=i64 value_class=BitCopy intent=Unknown strategy=ParamBoundary(ParamBoundaryFact { param_index: 0, param_count: 1, caller_visible_projection: false, mode: BorrowReadOnly }) why="checker-authoritative parameter boundary classification"
    site=s144 ty=duration value_class=BitCopy intent=Read strategy=BorrowRead why="first vertical-slice classifier"
    site=s145 ty=i64 value_class=BitCopy intent=Read strategy=BorrowRead why="first vertical-slice classifier"
    site=s146 ty=duration value_class=BitCopy intent=Read strategy=BorrowRead why="first vertical-slice classifier"
  blocks:
    id=0 kind=normal
      successor: none
    id=1 kind=normal
      successor: none
    id=2 kind=normal
      successor: none
    id=3 kind=cleanup
      successor: none
  drop_plans:
    branch[bb0: bb1/bb2] ->
      (none)
    panic[bb1] ->
      (none)
    return[bb2] ->
      (none)

