// Read live actor state after a completion call returns.
// The reply and the state field must both contribute to the result.

actor Worker {
    let factor: i64,
    receive fn compute(n: i64) -> i64 {
        n * factor
    }
}

actor Coordinator {
    let worker: LocalPid<Worker>,
    let bias: i64,
    receive fn run(n: i64) -> i64 {
        let r = worker.compute(n);
        match r {
            // `bias` is an actor-state field read AFTER the call returns.
            .Ok(v) => v + bias,
            .Err(_) => -1,
        }
    }
}

fn main() {
    let w = spawn Worker(factor: 6);
    let c = spawn Coordinator(worker: w, bias: 100);
    let r = c.run(7);
    match r {
        // compute(7) = 42; + bias(100) = 142
        .Ok(v) => println(f"result={v}"),
        .Err(_) => println("ask failed"),
    }
}
