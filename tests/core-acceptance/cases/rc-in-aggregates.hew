// A shared handle is an ordinary owned member: records, tuples, vectors and
// map values each retain it on ingress and release it with the aggregate, so
// the payload survives exactly as long as some owner names it.

#[resource]
type Tag { id: i64 }

impl Tag {
    fn close(consume self) {
        println(f"close {self.id}");
    }
}

type Holder { name: string, shared: Rc<Tag> }

// Building the record retains, and cloning the record retains again.
fn record_member(source: Rc<Tag>) {
    let holder = Holder { name: "first", shared: source.clone() };
    println(f"record strong={holder.shared.strong_count()}");
    let copied = clone holder;
    println(f"record clone strong={copied.shared.strong_count()} name={copied.name}");
}

fn tuple_member(source: Rc<Tag>) {
    let pair = (source.clone(), "tag");
    println(f"tuple strong={pair.0.strong_count()} label={pair.1}");
    let copied = clone pair;
    println(f"tuple clone strong={copied.0.strong_count()}");
}

fn collection_members(source: Rc<Tag>) {
    var handles: Vec<Rc<Tag>> = Vec.new();
    for _i in 0..3 {
        handles.push(source.clone());
    }
    println(f"vector len={handles.len()} strong={source.strong_count()}");
    var by_key: HashMap<i64, Rc<Tag>> = HashMap.new();
    by_key.insert(1, source.clone());
    by_key.insert(2, source.clone());
    println(f"map len={by_key.len()} strong={source.strong_count()}");
}

// Descriptor-backed data inside the allocation: the payload release the
// runtime holds re-enters the release walker from inside a drop, and the
// replacement `set` installs displaces the old payload through the same path.
fn managed_payload() {
    var deep: Vec<i64> = Vec.new();
    for i in 0..4000 {
        deep.push(i);
    }
    let held = Rc.new(deep);
    let alias = held.clone();
    println(f"managed strong={alias.strong_count()}");

    var table: HashMap<i64, string> = HashMap.new();
    for i in 0..2000 {
        table.insert(i, f"entry{i}");
    }
    let mapped = Rc.new(table);
    var replacement: HashMap<i64, string> = HashMap.new();
    replacement.insert(1, "only");
    mapped.set(replacement);
    println(f"replaced strong={mapped.strong_count()}");
}

fn main() {
    let root = Rc.new(Tag { id: 7 });
    record_member(root.clone());
    println(f"after record strong={root.strong_count()}");
    tuple_member(root.clone());
    println(f"after tuple strong={root.strong_count()}");
    collection_members(root.clone());
    println(f"after collections strong={root.strong_count()}");
    managed_payload();
    println("root about to release");
}
