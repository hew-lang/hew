// Guard: a `Vec<indirect-enum>` pipe element stays rejected UPSTREAM by the
// element-layout witness, at both the send and the recv site. This
// is the existing check-time reject, not a new diagnostic: no recv surface
// can currently type a `Vec<indirect-enum>` element, so the recv-`Some`
// binding seam is unreachable for this element class. The guard exists so a
// future weakening of the witness cannot silently open the recv path
// without a release seam behind it.
import std.stream;

indirect enum Wrapped {
    Val(i64),
}

fn main() {
    let (tx, rx): (stream.Sink<Vec<Wrapped>>, stream.Stream<Vec<Wrapped>>) = match stream.pipe(4) {
        .Ok(pair) => pair,
        .Err(err) => panic(f"stream.pipe failed: {err}"),
    };
    let v: Vec<Wrapped> = Vec.new();
    v.push(Wrapped.Val(1));
    v.push(Wrapped.Val(2));
    tx.send(v).expect("send");
    tx.close();
    match rx.try_recv() {
        .Some(item) => println(item.len()),
        .None => println("drained"),
    }
    println("done");
}
