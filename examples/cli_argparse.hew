//! Status: runnable
//! Description: Schema-driven flags, values, subcommands and help with std.cli.
//
// Try:
//   cli_argparse --verbose serve --port=8080 -Ipublic --include=assets -- index.html
//   cli_argparse serve --help
//   cli_argparse serve --port=invalid
//   cli_argparse version

import std.cli;

import std.os;

fn application() -> cli.Command {
    var app = cli.command("cli_argparse", "A small file-serving command-line application");
    app.argument(cli.flag("verbose", .Some("v"), "Show progress"));
    var serve = cli.command("serve", "Choose files and configure a server");
    serve.argument(cli.integer("port", .Some("p"), "PORT", "Port number (default: 8080)"));
    serve.argument(cli.choice("mode", .None, "MODE", "Serving mode", ["safe", "fast"]));
    serve.argument(cli.option("include", .Some("I"), "PATH", "Include a directory").repeated());
    serve.positionals("FILE");
    app.subcommand(serve);
    app.subcommand(cli.command("version", "Show the example version"));
    app
}

fn main() {
    let app = application();
    let argv = os.args();
    var arguments: Vec<string> = Vec.new();
    for index in 1..argv.len() {
        arguments.push(argv[index]);
    }
    if arguments.is_empty() {
        print(app.help());
        return;
    }
    match app.parse(arguments) {
        .Ok(.Help(text)) => print(text),
        .Ok(.Parsed(matches)) => {
            let selected = matches.selected();
            if selected.name == "version" {
                println("cli example 1.0");
                return;
            }
            let port = selected.integer("port") ?? 8080;
            if port < 1 || port > 65535 {
                println("port must be between 1 and 65535");
                exit(2);
            }
            println(f"port: {port}");
            let mode = selected.value("mode") ?? "safe";
            println(f"mode: {mode}");
            if matches.root().flag("verbose") {
                println("verbose progress enabled");
            }
            for directory in selected.values("include") {
                println(f"include: {directory}");
            }
            for file in selected.positionals {
                println(f"file: {file}");
            }
        }
        .Err(error) => {
            println(f"{error}");
            println("Use --help, or serve --help, for usage.");
            exit(2);
        }
    }
}
