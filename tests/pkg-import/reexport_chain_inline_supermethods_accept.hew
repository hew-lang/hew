// Each level of a two-hop re-export chain uses its own explicit trait impl.
import hew.reexchaina.{Top};
import hew.reexmid.{Mid};
import hew.reexbase.{Base};

type W {
    id: i64,
}

impl Base for W {
    fn base(w: W) -> i64 {
        w.id
    }
}

impl Mid for W {
    fn mid(w: W) -> i64 {
        w.id + 10
    }
}

impl Top for W {
    fn top(w: W) -> i64 {
        w.id + 100
    }
}

fn main() {
    let w = W { id: 5 };
    println(f"base {w.base()} mid {w.mid()} top {w.top()}");
}
