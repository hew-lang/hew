fn test_first_f64_empty_returns_none() {
    let v: Vec<f64> = Vec.new();
    assert(vec.first_f64(v).is_none());
}

// ── first_str ─────────────────────────────────────────────────────────────
#[test]
fn test_first_str_non_empty() {
    var v: Vec<string> = Vec.new();
    v.push("hello");
    v.push("world");
    let result = vec.first_str(v);
    assert(result.is_some());
    assert(result.unwrap_or("") == "hello");
}

#[test]
fn test_first_str_single_element_returns_some() {
    var v: Vec<string> = Vec.new();
    v.push("only");
    let result = vec.first_str(v);
    assert(result.is_some());
    assert(result.unwrap_or("") == "only");
}

#[test]
fn test_first_str_empty_returns_none() {
    let v: Vec<string> = Vec.new();
    assert(vec.first_str(v).is_none());
}

