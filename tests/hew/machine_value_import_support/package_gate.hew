fn decorate(value: string) -> string { "package:" + value }

pub machine Gate {
    events { Open, }
    emits { Changed { label: string }, }
    state Closed { label: string },
    state Opened { label: string },
    on Open: Closed => Opened {
        emit Changed { label: decorate(self.label) };
        .Opened { label: self.label }
    }
    default { state }
}

pub fn package_gate() -> Gate { .Closed { label: "right" } }
