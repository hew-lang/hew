// Two callers share a bucket of tokens. Each accepted request uses one.
import std.math;

actor RateLimiter {
    var tokens: i64 = 5;

    receive fn acquire() -> bool {
        if tokens <= 0 {
            return false;
        }
        tokens -= 1;
        true
    }

    receive fn refill() -> i64 {
        tokens = math.min(tokens + 3, 5);
        tokens
    }
}

fn send_requests(limiter: RateLimiter, count: i64) -> i64 {
    var accepted = 0;
    for _ in 0..count {
        if limiter.acquire().expect("the limiter is running") {
            accepted += 1;
        }
    }
    accepted
}

fn main() {
    let limiter = spawn RateLimiter;
    let first = fork send_requests(limiter, 4);
    let second = fork send_requests(limiter, 4);
    let accepted = (await first) + (await second);
    println(f"Accepted {accepted} of 8 requests");

    // Each tick returns after the refill, so the next request sees the new tokens.
    for _ in 0..2 {
        sleep(20ms);
        let tokens = limiter.refill().expect("the limiter is running");
        println(f"Refilled to {tokens} tokens");
    }
    let next = send_requests(limiter, 3);
    println(f"Accepted {next} of 3 requests after refill");
    stop(limiter);
    stopped(limiter);
}
