// Reject fixture: `m.get(k)` over a value with no clone hands `Some` a loan of
// the slot the map still owns. Consuming that payload would release a value
// the map still holds, so it meets the consume wall; `remove(k)` is the way to
// move a value out.
#[resource]
type Tok {
    id: i64,
}

impl Tok {
    fn close(consume self) {
        println(f"close {self.id}");
    }
}

fn main() {
    var m: HashMap<string, Tok> = HashMap.new();
    m.insert("a", Tok { id: 1 });
    match m.get("a") {
        Option.Some(t) => t.close(),
        Option.None => println("none"),
    }
}
