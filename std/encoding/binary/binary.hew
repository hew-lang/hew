//! Fixed-width integer and IEEE 754 binary32 encoding in little-endian and
//! big-endian byte order.
//!
//! All integers are `i64` at the Hew API boundary: unsigned widths carry the
//! bit pattern without sign extension; signed widths use two's complement.
//!
//! The checked functions (`slice`, `read_*`, `put_uint_*`, `put_f32_*`)
//! return `Result<_, BinaryError>` and never abort, so a parser written with
//! `?` turns short or malformed input into an error value:
//!
//! ```
//! import std.encoding.binary;
//!
//! fn parse(record: bytes) -> (i64, f64) fails binary.BinaryError {
//!     (binary.read_uint_le(record, 0, 2)?, binary.read_f32_le(record, 2)?)
//! }
//!
//! fn main() {
//!     var record = binary.put_uint_le(7, 2).expect("width 2");
//!     record.append(binary.put_f32_le(21.5).expect("finite"));
//!     println(f"{parse(record):?}");          // Ok((7, 21.5))
//!     println(f"{parse(record[0..3]):?}");    // Err(OutOfRange(2, 4, 3))
//! }
//! ```
//!
//! The fixed-width `get_*` functions read from offset 0 and abort when the
//! buffer is too short; the `put_*` functions keep only the low bits of their
//! argument. Use them where the length is already established.

import std.math;

/// Byte order of a multi-byte field.
pub enum ByteOrder {
    /// Most significant byte first (network order).
    Big;
    /// Least significant byte first.
    Little;
}

/// Why a checked read or write was refused.
pub enum BinaryError {
    /// `OutOfRange(offset, width, available)`: the field at `offset` spanning
    /// `width` bytes does not lie within the `available` bytes.
    OutOfRange(i64, i64, i64);
    /// The requested integer width lies outside `0..=8` bytes.
    InvalidWidth(i64);
    /// The value is an infinity or NaN, which binary32 fields here never carry.
    NonFinite;
    /// The value does not fit the field: an unsigned integer outside its
    /// width, or a float beyond the largest finite binary32.
    Overflow;
}

/// Print a `BinaryError`'s variant and its fields.
impl Display for BinaryError {
    fn fmt(self) -> string {
        match self {
            BinaryError.OutOfRange(offset, width, available) => f"OutOfRange({offset}, {width}, {available})",
            BinaryError.InvalidWidth(width) => f"InvalidWidth({width})",
            BinaryError.NonFinite => "NonFinite",
            BinaryError.Overflow => "Overflow",
        }
    }
}

// ── Internal width helpers ─────────────────────────────────────────────

// INTERNAL-ABI: explicit `let masked: i64` annotation keeps the mask in i64
// storage before the u8 narrowing `bytes.push` takes.
fn lo_byte(v: i64) -> u8 { // INTERNAL-ABI: masks to low 8 bits; u8 matches bytes.push contract
    let masked: i64 = v & 0xFF;
    masked as u8
}

/// The low `width` bytes of `v`, least significant first or last.
fn encode(v: i64, width: i64, order: ByteOrder) -> bytes {
    var b: bytes = bytes.new();
    for k in 0..width {
        let shift = match order {
            ByteOrder.Little => 8 * k,
            ByteOrder.Big => 8 * (width - 1 - k),
        };
        b.push(lo_byte(v >> shift));
    }
    b
}

/// The unsigned value of `width` bytes at `at`; the caller checked the range.
fn decode(data: bytes, at: i64, width: i64, order: ByteOrder) -> i64 {
    var v: i64 = 0;
    for k in 0..width {
        let byte = data[at + k] as i64;
        let shift = match order {
            ByteOrder.Little => 8 * k,
            ByteOrder.Big => 8 * (width - 1 - k),
        };
        v = v | byte << shift;
    }
    v
}

fn check_width(width: i64) -> Result<(), BinaryError> {
    if width < 0 || width > 8 {
        return .Err(BinaryError.InvalidWidth(width));
    }
    .Ok(())
}

fn check_range(data: bytes, at: i64, width: i64) -> Result<(), BinaryError> {
    let available = data.len();
    if at < 0 || at > available || width > available - at {
        return .Err(BinaryError.OutOfRange(at, width, available));
    }
    .Ok(())
}

/// Sign-extend the low `width` bytes of `u`.
fn sign_extend(u: i64, width: i64) -> i64 {
    if width == 0 || width == 8 {
        return u;
    }
    let half: i64 = 1 << (8 * width - 1);
    if u >= half {
        u - (half << 1)
    } else {
        u
    }
}

// ── Checked slices ─────────────────────────────────────────────────────

/// The bytes `start..end` of `data`, sharing its allocation.
///
/// Returns `OutOfRange(start, end - start, data.len())` unless
/// `0 <= start <= end <= data.len()`.
pub fn slice(data: bytes, start: i64, end: i64) -> Result<bytes, BinaryError> {
    if start < 0 || end < start || end > data.len() {
        return .Err(BinaryError.OutOfRange(start, end - start, data.len()));
    }
    .Ok(data[start..end])
}

// ── Checked integer reads and writes ───────────────────────────────────

fn read_uint(data: bytes, at: i64, width: i64, order: ByteOrder) -> i64 fails BinaryError {
    check_width(width)?;
    check_range(data, at, width)?;
    decode(data, at, width, order)
}

/// Read an unsigned little-endian integer of `width` bytes (0 to 8) at `at`.
///
/// Width 8 returns the 64-bit pattern, so values past `i64` max are negative.
pub fn read_uint_le(data: bytes, at: i64, width: i64) -> Result<i64, BinaryError> {
    read_uint(data, at, width, ByteOrder.Little)
}

/// Read an unsigned big-endian integer of `width` bytes (0 to 8) at `at`.
///
/// Width 8 returns the 64-bit pattern, so values past `i64` max are negative.
pub fn read_uint_be(data: bytes, at: i64, width: i64) -> Result<i64, BinaryError> {
    read_uint(data, at, width, ByteOrder.Big)
}

/// Read a two's-complement little-endian integer of `width` bytes at `at`,
/// sign-extended to `i64`.
pub fn read_int_le(data: bytes, at: i64, width: i64) -> i64 fails BinaryError {
    sign_extend(read_uint(data, at, width, ByteOrder.Little)?, width)
}

/// Read a two's-complement big-endian integer of `width` bytes at `at`,
/// sign-extended to `i64`.
pub fn read_int_be(data: bytes, at: i64, width: i64) -> i64 fails BinaryError {
    sign_extend(read_uint(data, at, width, ByteOrder.Big)?, width)
}

fn put_uint(value: i64, width: i64, order: ByteOrder) -> bytes fails BinaryError {
    check_width(width)?;
    if width < 8 && (value < 0 || value >= 1 << (8 * width)) {
        return error BinaryError.Overflow;
    }
    encode(value, width, order)
}

/// Encode `value` as an unsigned little-endian integer of `width` bytes.
///
/// `Overflow` unless `0 <= value < 2^(8 * width)`; width 8 writes the 64-bit
/// pattern of any `i64`.
pub fn put_uint_le(value: i64, width: i64) -> Result<bytes, BinaryError> {
    put_uint(value, width, ByteOrder.Little)
}

/// Encode `value` as an unsigned big-endian integer of `width` bytes.
///
/// `Overflow` unless `0 <= value < 2^(8 * width)`; width 8 writes the 64-bit
/// pattern of any `i64`.
pub fn put_uint_be(value: i64, width: i64) -> Result<bytes, BinaryError> {
    put_uint(value, width, ByteOrder.Big)
}

// ── Checked IEEE 754 binary32 ──────────────────────────────────────────
//
// Hew has no f32 bit cast yet, so a binary32 field is converted through the
// f64 bit pattern: every finite binary32 value, including -0.0 and the
// subnormals, is exactly representable as an f64.

/// The f64 holding the binary32 value with bit pattern `bits`.
fn f32_bits_to_f64(bits: i64) -> Result<f64, BinaryError> {
    let sign = (bits >> 31) & 1;
    let exponent = (bits >> 23) & 0xFF;
    let mantissa = bits & 0x7FFFFF;
    if exponent == 0xFF {
        return .Err(BinaryError.NonFinite);
    }
    var pattern: i64 = sign << 63;
    if exponent != 0 {
        pattern = pattern | (exponent - 127 + 1023) << 52 | mantissa << 29;
    } else if mantissa != 0 {
        // Subnormal: mantissa * 2^-149, normalized around its leading bit.
        var top = 22;
        while (mantissa >> top) & 1 == 0 {
            top = top - 1;
        }
        let fraction = mantissa - (1 << top);
        pattern = pattern | (top - 149 + 1023) << 52 | fraction << (52 - top);
    }
    .Ok(math.from_bits(pattern as u64))
}

/// The binary32 bit pattern nearest to `value`.
fn f64_to_f32_bits(value: f64) -> Result<i64, BinaryError> {
    if !value.is_finite() {
        return .Err(BinaryError.NonFinite);
    }
    let rounded = (value as f32) as f64;
    if !rounded.is_finite() {
        return .Err(BinaryError.Overflow);
    }
    let pattern = rounded.to_bits() as i64;
    let sign = (pattern >> 63) & 1;
    let exponent = ((pattern >> 52) & 0x7FF) - 1023;
    let fraction = pattern & 0xFFFFFFFFFFFFF;
    var bits: i64 = sign << 31;
    if (pattern & 0x7FFFFFFFFFFFFFFF) == 0 {
        return .Ok(bits);
    }
    if exponent >= -126 {
        bits = bits | (exponent + 127) << 23 | fraction >> 29;
    } else {
        // Subnormal binary32: the full significand scaled to 2^-149 units.
        let significand = fraction | 1 << 52;
        bits = bits | significand >> (-97 - exponent);
    }
    .Ok(bits)
}

/// Read a little-endian binary32 at `at` as an `f64`.
///
/// `NonFinite` for an infinity or NaN pattern.
pub fn read_f32_le(data: bytes, at: i64) -> f64 fails BinaryError {
    f32_bits_to_f64(read_uint(data, at, 4, ByteOrder.Little)?)?
}

/// Read a big-endian binary32 at `at` as an `f64`.
///
/// `NonFinite` for an infinity or NaN pattern.
pub fn read_f32_be(data: bytes, at: i64) -> f64 fails BinaryError {
    f32_bits_to_f64(read_uint(data, at, 4, ByteOrder.Big)?)?
}

/// Encode `value`, rounded to the nearest binary32, as 4 little-endian bytes.
///
/// `NonFinite` for an infinity or NaN; `Overflow` when the value rounds past
/// the largest finite binary32.
pub fn put_f32_le(value: f64) -> bytes fails BinaryError {
    encode(f64_to_f32_bits(value)?, 4, ByteOrder.Little)
}

/// Encode `value`, rounded to the nearest binary32, as 4 big-endian bytes.
///
/// `NonFinite` for an infinity or NaN; `Overflow` when the value rounds past
/// the largest finite binary32.
pub fn put_f32_be(value: f64) -> bytes fails BinaryError {
    encode(f64_to_f32_bits(value)?, 4, ByteOrder.Big)
}

// ── Fixed-width writes (keep the low bits) ─────────────────────────────

/// Encode the low 16 bits of `v` as 2 little-endian bytes.
pub fn put_u16_le(v: i64) -> bytes {
    encode(v, 2, ByteOrder.Little)
}

/// Encode the low 32 bits of `v` as 4 little-endian bytes.
pub fn put_u32_le(v: i64) -> bytes {
    encode(v, 4, ByteOrder.Little)
}

/// Encode `v` as 8 little-endian bytes.
pub fn put_u64_le(v: i64) -> bytes {
    encode(v, 8, ByteOrder.Little)
}

/// Encode the low 16 bits of `v` as 2 big-endian bytes.
pub fn put_u16_be(v: i64) -> bytes {
    encode(v, 2, ByteOrder.Big)
}

/// Encode the low 32 bits of `v` as 4 big-endian bytes.
pub fn put_u32_be(v: i64) -> bytes {
    encode(v, 4, ByteOrder.Big)
}

/// Encode `v` as 8 big-endian bytes.
pub fn put_u64_be(v: i64) -> bytes {
    encode(v, 8, ByteOrder.Big)
}

/// Encode a signed 16-bit value as 2 little-endian bytes.
pub fn put_i16_le(v: i64) -> bytes {
    encode(v, 2, ByteOrder.Little)
}

/// Encode a signed 32-bit value as 4 little-endian bytes.
pub fn put_i32_le(v: i64) -> bytes {
    encode(v, 4, ByteOrder.Little)
}

/// Encode a signed 64-bit value as 8 little-endian bytes.
pub fn put_i64_le(v: i64) -> bytes {
    encode(v, 8, ByteOrder.Little)
}

/// Encode a signed 16-bit value as 2 big-endian bytes.
pub fn put_i16_be(v: i64) -> bytes {
    encode(v, 2, ByteOrder.Big)
}

/// Encode a signed 32-bit value as 4 big-endian bytes.
pub fn put_i32_be(v: i64) -> bytes {
    encode(v, 4, ByteOrder.Big)
}

/// Encode a signed 64-bit value as 8 big-endian bytes.
pub fn put_i64_be(v: i64) -> bytes {
    encode(v, 8, ByteOrder.Big)
}

// ── Fixed-width reads from offset 0 (abort when short) ─────────────────

/// Decode 2 little-endian bytes as an unsigned 16-bit integer.
///
/// Aborts if `buf.len() < 2`.
pub fn get_u16_le(buf: bytes) -> i64 {
    decode(buf, 0, 2, ByteOrder.Little)
}

/// Decode 4 little-endian bytes as an unsigned 32-bit integer.
///
/// Aborts if `buf.len() < 4`.
pub fn get_u32_le(buf: bytes) -> i64 {
    decode(buf, 0, 4, ByteOrder.Little)
}

/// Decode 8 little-endian bytes as a 64-bit integer.
///
/// Aborts if `buf.len() < 8`.
pub fn get_u64_le(buf: bytes) -> i64 {
    decode(buf, 0, 8, ByteOrder.Little)
}

/// Decode 2 big-endian bytes as an unsigned 16-bit integer.
///
/// Aborts if `buf.len() < 2`.
pub fn get_u16_be(buf: bytes) -> i64 {
    decode(buf, 0, 2, ByteOrder.Big)
}

/// Decode 4 big-endian bytes as an unsigned 32-bit integer.
///
/// Aborts if `buf.len() < 4`.
pub fn get_u32_be(buf: bytes) -> i64 {
    decode(buf, 0, 4, ByteOrder.Big)
}

/// Decode 8 big-endian bytes as a 64-bit integer.
///
/// Aborts if `buf.len() < 8`.
pub fn get_u64_be(buf: bytes) -> i64 {
    decode(buf, 0, 8, ByteOrder.Big)
}

/// Decode 2 little-endian bytes as a signed 16-bit integer.
///
/// Aborts if `buf.len() < 2`.
pub fn get_i16_le(buf: bytes) -> i64 {
    sign_extend(get_u16_le(buf), 2)
}

/// Decode 4 little-endian bytes as a signed 32-bit integer.
///
/// Aborts if `buf.len() < 4`.
pub fn get_i32_le(buf: bytes) -> i64 {
    sign_extend(get_u32_le(buf), 4)
}

/// Decode 8 little-endian bytes as a signed 64-bit integer.
///
/// Aborts if `buf.len() < 8`.
pub fn get_i64_le(buf: bytes) -> i64 {
    get_u64_le(buf)
}

/// Decode 2 big-endian bytes as a signed 16-bit integer.
///
/// Aborts if `buf.len() < 2`.
pub fn get_i16_be(buf: bytes) -> i64 {
    sign_extend(get_u16_be(buf), 2)
}

/// Decode 4 big-endian bytes as a signed 32-bit integer.
///
/// Aborts if `buf.len() < 4`.
pub fn get_i32_be(buf: bytes) -> i64 {
    sign_extend(get_u32_be(buf), 4)
}

/// Decode 8 big-endian bytes as a signed 64-bit integer.
///
/// Aborts if `buf.len() < 8`.
pub fn get_i64_be(buf: bytes) -> i64 {
    get_u64_be(buf)
}
