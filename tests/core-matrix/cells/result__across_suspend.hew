actor Holder {
    var ready: bool;

    receive fn hold(v: Result<i64, string>) -> i64 {
        sleep(2ms);
        match v { Result.Ok(v_v) => println(f"ok {v_v}"), Err(v_e) => println(f"err {v_e}"), }
        ready = true;
        1
    }
}

fn main() {
    let x: Result<i64, string> = Result.Ok(6);
    let h = spawn Holder(ready: false);
    match await h.hold(x) {
        Result.Ok(n) => println(f"held {n}"),
        Err(_) => println("err"),
    }
}
