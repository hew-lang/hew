// Cross-iteration double consume. The checker reports the second
// iteration's consume as a use of a moved value, with a note at the first
// iteration's consume, before SIR verification sees the loop.
#[resource]
type Conn {
    fd: i64;
}

impl Conn {
    fn close(consume self) {}
    fn detach(consume self) -> i64 {
        self.fd
    }
}

fn move_in_loop() {
    let held = Conn { fd: 1 };
    for _i in 0..3 {
        let _ = held.detach();
    }
}

fn main() {
    move_in_loop();
}
