import std.net.websocket;

fn main() {
    for _ in 0..50 {
        match websocket.listen("not an address") {
            .Ok(server) => {
                server.close();
                panic("invalid WebSocket address unexpectedly bound");
            }
            .Err(.InvalidArgument(detail)) => println(detail.len()),
            .Err(_) => panic("expected invalid address detail"),
        }
    }
}
