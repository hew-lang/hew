//! Live witness for compiler-typed active-mode WebSocket attach.
//!
//! The peer closes after the runtime reader is installed. Successful test
//! completion proves codegen passed the concrete actor's `on_message` and
//! `on_close` protocol IDs: a stale numeric index would hit the actor dispatch
//! trap on the background reader thread.

import std.net;

import std.net.websocket;

actor WebSocketHandlerProbe {
    receive fn on_message(text: string) {}

    receive fn on_close() {}
}

actor WebSocketPeer {
    let url: string,

    receive fn connect_and_hold() {
        match websocket.connect(url) {
            .Ok(conn) => {
                sleep(500ms);
                conn.close();
            },
            .Err(err) => {
                panic(f"loopback WebSocket connect failed");
            },
        }
    }
}

#[test]
fn test_websocket_typed_attach_dispatches_protocol_ids() {
    match websocket.listen("127.0.0.1:0") {
        .Ok(server) => {
            let peer = spawn WebSocketPeer(url: f"ws://127.0.0.1:{server.port()}/");
            peer.connect_and_hold();
            let conn = server.accept();
            let handler: LocalPid<WebSocketHandlerProbe> = spawn WebSocketHandlerProbe;
            conn.attach(handler);
            sleep(750ms);
            conn.close();
            server.close();
        },
        .Err(err) => {
            panic(f"loopback WebSocket listen failed");
        },
    }
}
