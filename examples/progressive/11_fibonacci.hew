// The two base cases end the recursion. Use small inputs here because each
// larger value recursively computes its two predecessors.
fn fibonacci(n: i64) -> i64 {
    if n <= 1 { n } else { fibonacci(n - 1) + fibonacci(n - 2) }
}

fn main() {
    for n in [0, 1, 5, 10] {
        println(f"fibonacci({n}) = {fibonacci(n)}");
    }
}
