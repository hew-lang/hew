// Selected values and captured copies survive their parent's lexical scope.
import std.encoding.yaml;

fn early_exit(flag: bool) {
    var value = yaml.object();
    value.set("n", yaml.from_int(11)).unwrap();
    let child = value.get_field("n").unwrap().unwrap();
    if flag {
        return;
    }
    println(child.get_int().unwrap());
}

fn _panic_exit() {
    var value = yaml.object();
    value.set("n", yaml.from_int(12)).unwrap();
    let _child = value.get_field("n").unwrap().unwrap();
    panic("yaml value panic probe");
}

fn cancel_exit() {
    var value = yaml.object();
    value.set("n", yaml.from_int(13)).unwrap();
    let _child = value.get_field("n").unwrap().unwrap();
    var i: i64 = 0;
    while i < 2 {
        i = i + 1;
    }
}

actor YamlCancelDriver {
    receive fn drive() {
        scope {
            cancel_exit();
        };
    }
}

fn main() {
    let read = {
        var value = yaml.object();
        value.set("n", yaml.from_int(9)).unwrap();
        value.set("none", yaml.null()).unwrap();
        let child = value.get_field("n").unwrap().unwrap();
        || child.get_int().unwrap()
    };
    println(read());

    // A parse failure returns an error without an owning value payload.
    match yaml.parse("[") {
        .Ok(_) => panic("malformed YAML unexpectedly parsed"),
        .Err(_) => {},
    }
    early_exit(true);
}
