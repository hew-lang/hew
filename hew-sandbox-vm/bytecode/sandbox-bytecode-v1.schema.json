{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hew.sh/schemas/sandbox/bytecode-v1.schema.json",
  "title": "Hew Sandbox Bytecode Package v1",
  "description": "A projection of verified ownership SIR. See package-v1.md and opcodes-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hew_version",
    "compiler_version",
    "profile",
    "strings",
    "bytes",
    "regex_patterns",
    "aggregates",
    "variants",
    "runtime_families",
    "externs",
    "suspend_kinds",
    "functions",
    "value_capabilities",
    "closures",
    "vtables"
  ],
  "properties": {
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": [
              "record",
              "opaque",
              "nominal",
              "task",
              "actor_call",
              "generator",
              "stream",
              "sink"
            ]
          },
          "ty": { "type": "string" },
          "close": { "type": "integer", "minimum": 0 },
          "release": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "structural_render": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": [
              "scalar",
              "unit",
              "display",
              "identity",
              "tuple",
              "vector",
              "map",
              "record",
              "enum"
            ]
          }
        }
      }
    },
    "schema_version": {
      "const": "hew.sandbox.bytecode.v1"
    },
    "hew_version": {
      "type": "string",
      "minLength": 1
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "exit"],
      "properties": {
        "function": {
          "$ref": "#/$defs/id"
        },
        "exit": {
          "enum": ["unit", "status"]
        }
      }
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bytes": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "regex_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aggregates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "fields"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "cases"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "fields"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "runtime_families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "detail": {}
        }
      }
    },
    "externs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "symbol"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "suspend_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/function"
      }
    },
    "value_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "ty"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "capability": {
            "enum": ["Eq", "Hash"]
          },
          "ty": {
            "type": "string"
          },
          "callable": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "closures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "body", "fields"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "body": {
            "$ref": "#/$defs/id"
          },
          "fields": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "vtables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slots"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slot", "method", "callee", "receiver"],
              "properties": {
                "slot": {
                  "type": "integer",
                  "minimum": 0
                },
                "method": {
                  "type": "string"
                },
                "callee": {
                  "$ref": "#/$defs/id"
                },
                "receiver": {
                  "enum": ["copy", "borrow", "borrow_mut", "move"]
                }
              }
            }
          }
        }
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "supervisors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/supervisor"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "span": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "own": {
      "enum": ["none", "owned", "guaranteed"]
    },
    "operand": {
      "$ref": "#/$defs/id"
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "decision"],
      "properties": {
        "value": {
          "$ref": "#/$defs/id"
        },
        "decision": {
          "enum": ["borrow", "borrow_mut", "copy", "move", "snapshot"]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "args"],
      "properties": {
        "to": {
          "$ref": "#/$defs/id"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operand"
          }
        }
      }
    },
    "valueDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "own"],
      "properties": {
        "value": {
          "$ref": "#/$defs/id"
        },
        "own": {
          "$ref": "#/$defs/own"
        }
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "const": "never"
        },
        {
          "$ref": "#/$defs/valueDef"
        }
      ]
    },
    "trap": {
      "enum": [
        "integer_overflow",
        "divide_by_zero",
        "shift_out_of_range",
        "vector_bounds"
      ]
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "params", "entry", "places", "blocks"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valueDef"
          }
        },
        "entry": {
          "$ref": "#/$defs/id"
        },
        "places": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "origin"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "origin": {
                "enum": [
                  "local",
                  "aggregate",
                  "capture",
                  "runtime",
                  "actor_state"
                ]
              },
              "base": {
                "type": "object"
              },
              "shape": {
                "$ref": "#/$defs/id"
              },
              "field": {
                "type": "integer",
                "minimum": 0
              },
              "environment": {
                "$ref": "#/$defs/id"
              },
              "initialized": {
                "type": "boolean"
              }
            }
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "params", "ops", "term"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valueDef"
          }
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/op"
          }
        },
        "term": {
          "$ref": "#/$defs/term"
        }
      }
    },
    "op": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "enum": [
            "const.int",
            "const.bool",
            "const.float",
            "const.char",
            "const.unit",
            "const.duration",
            "const.str",
            "const.bytes",
            "copy_value",
            "move",
            "fork",
            "destroy_value",
            "begin_borrow",
            "end_borrow",
            "finish_linear_receiver",
            "alloc_place",
            "store.init",
            "store.assign",
            "load.copy",
            "load.take",
            "load.borrow",
            "end_lifetime",
            "tuple.make",
            "tuple.get",
            "aggregate.make",
            "aggregate.project_copy",
            "aggregate.project_borrow",
            "destructure",
            "array.make",
            "array.repeat",
            "variant.make",
            "variant.is",
            "variant.project_copy",
            "variant.project_borrow",
            "variant.destructure",
            "unary",
            "binary",
            "cast",
            "str.eq",
            "bytes.eq",
            "function.make",
            "closure.make",
            "callable.coerce",
            "dyn.make",
            "register_defer",
            "generator.make",
            "stream.pipe",
            "task_scope.enter",
            "task_scope.close",
            "task.spawn",
            "actor.ingress_adapter"
          ]
        },
        "dst": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "term": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "enum": [
            "return",
            "goto",
            "branch",
            "switch.variant",
            "checked.binary",
            "unreachable",
            "call",
            "indirect.call",
            "dyn.call",
            "value.call",
            "runtime.call",
            "extern.call",
            "actor.call",
            "wire.codec",
            "panic",
            "trap",
            "checked_raise",
            "cleanup.dispatch",
            "resume_unwind",
            "enter_defer",
            "finish_defer",
            "recover_fault",
            "suspend"
          ]
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state_fields", "stop", "handlers", "overflow"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "state_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mutable", "deferred"],
            "properties": {
              "mutable": {
                "type": "boolean"
              },
              "deferred": {
                "type": "boolean"
              }
            }
          }
        },
        "init": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "$ref": "#/$defs/id"
        },
        "crash": {
          "$ref": "#/$defs/id"
        },
        "exit": {
          "$ref": "#/$defs/id"
        },
        "down": {
          "$ref": "#/$defs/id"
        },
        "stop": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "handlers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "message_id",
              "callable",
              "params",
              "streams",
              "fallible",
              "result_shape"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "message_id": {
                "$ref": "#/$defs/id"
              },
              "every_ns": {
                "type": "integer"
              },
              "callable": {
                "$ref": "#/$defs/id"
              },
              "params": {
                "$ref": "#/$defs/id"
              },
              "streams": {
                "type": "boolean"
              },
              "fallible": {
                "type": "boolean"
              },
              "result_shape": {
                "type": ["integer", "null"],
                "minimum": 0
              }
            }
          }
        },
        "mailbox_capacity": {
          "$ref": "#/$defs/id"
        },
        "overflow": {
          "type": "string"
        },
        "max_heap_bytes": {
          "$ref": "#/$defs/id"
        },
        "coalesce": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fallback", "keys"],
          "properties": {
            "fallback": {
              "type": "string"
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["message", "param", "kind"],
                "properties": {
                  "message": {
                    "$ref": "#/$defs/id"
                  },
                  "param": {
                    "$ref": "#/$defs/id"
                  },
                  "kind": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "crash_info": {
          "$ref": "#/$defs/id"
        },
        "crash_action": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "supervisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "strategy", "max_restarts", "window_secs", "children"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "strategy": {
          "type": "string"
        },
        "max_restarts": {
          "$ref": "#/$defs/id"
        },
        "window_secs": {
          "$ref": "#/$defs/id"
        },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role", "restart", "spawn"],
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["actor"],
                    "properties": {
                      "actor": {
                        "$ref": "#/$defs/id"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["supervisor"],
                    "properties": {
                      "supervisor": {
                        "$ref": "#/$defs/id"
                      }
                    }
                  }
                ]
              },
              "restart": {
                "type": "string"
              },
              "pool_count": {
                "$ref": "#/$defs/id"
              },
              "spawn": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      }
    }
  }
}
