fn main() {
    let x: Vec<i64> = Vec::new();
    x.push(10);
    x.push(20);
    let v: Vec<Vec<i64>> = Vec::new();
    v.push(x);
    match v.get(0) {
        Some(e) => {
            let e_l = e.len();
            let e_0 = e[0];
            println(f"len={e_l} v0={e_0}");
        },
        None => println("missing"),
    }
}
