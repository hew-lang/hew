// Each consuming extern call acquires an independent string owner, so
// dropping one owner leaves the caller able to pass the value again.
extern "C" {
    fn hew_string_drop(consume s: string);
}

fn main() -> i64 {
    let text = "a" + "b";
    unsafe {
        hew_string_drop(text)
    };
    unsafe {
        hew_string_drop(text)
    };
    println("done");
    0
}
