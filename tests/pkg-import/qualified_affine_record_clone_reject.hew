// Imported module-qualified affine identities must retain their resource/linear
// marker at the structural record-clone gate. Both clone syntaxes route through
// the same checker authority and must reject before HIR.
import hew::affineclone;

fn main() {
    let r1: affineclone.ResourceToken = ResourceToken { id: 1 };
    let _r1_copy = r1.clone();
    let r2: affineclone.ResourceToken = ResourceToken { id: 2 };
    let _r2_copy = clone r2;

    let l1: affineclone.LinearTicket = LinearTicket { id: 3 };
    let _l1_copy = l1.clone();
    let _ = l1.redeem();
    let l2: affineclone.LinearTicket = LinearTicket { id: 4 };
    let _l2_copy = clone l2;
    let _ = l2.redeem();
}
