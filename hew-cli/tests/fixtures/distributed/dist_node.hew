fn scenario_stale_incarnation_restart(old: KeyValue, kx: string, port: string) -> i64 {
    let old_location = discover_with_retry("kv").expect("old metadata");
    let old_node = old_location.node_id();
    let old_incarnation = old_location.incarnation();
    println(f"READY_STALE_CAPTURED node={old_node.display()} incarnation={old_incarnation}");
    let _ = wait_for_file(f"{kx}/server.restarted");
    let _ = Node.connect(f"127.0.0.1:{port}");
    let fresh_peer = fixture_peer();
    let fresh = fresh_peer.receive_service<KeyValue>().expect("fresh kv grant");
    let _wire = fresh_peer.receive_service<WireProbe>().expect("fresh wire grant");
    let _identity = fresh_peer.receive_service<IdentityProbe>().expect("fresh identity grant");
    assert(!(old is fresh));
    var attempts: i64 = 0;
    loop {
        let candidate = discover_with_retry("kv");
        match candidate {
            Result.Ok(fresh_location) => {
                let fresh_incarnation = fresh_location.incarnation();
                if fresh_location.node_id() == old_node && fresh_incarnation > old_incarnation {
                    match fresh.handle(KvReq.GetKey("restart-proof")) {
                        Result.Err(_) => {
                            println("FAIL stale_incarnation_restart fresh-pid-unusable");
                            return 4;
                        }
                        Result.Ok(KvResp.Ack) => {
                            println("FAIL stale_incarnation_restart fresh-pid-wrong-reply");
                            return 5;
                        }
                        Result.Ok(KvResp.Value(_)) => {}
                    }
                    match old.handle(KvReq.GetKey("restart-proof")) {
                        // A stale incarnation is Dead: that destination cannot return.
                        Result.Err(ActorError.Dead) => {
                            println(f"PASS stale_incarnation_restart old={old_incarnation} new={fresh_incarnation} error=Dead");
                            return 0;
                        }
                        Result.Err(_) => {
                            println("FAIL stale_incarnation_restart old-pid-wrong-error");
                            return 6;
                        }
                        Result.Ok(_) => {
                            println("FAIL stale_incarnation_restart old-pid-succeeded");
                            return 7;
                        }
                    }
                }
            }
            Result.Err(_) => {}
        }
        attempts = attempts + 1;
        if attempts >= 200 {
            println("FAIL stale_incarnation_restart replacement-not-observed");
            return 3;
        }
        sleep(100ms);
    }
}

fn scenario_persistent_seed(old: KeyValue, kx: string) -> i64 {
    assert(old.handle(KvReq.Put(KvPut { key: "seed-first", val: "authenticated" })).expect("seed call") == KvResp.Ack);
    match old.handle(KvReq.GetKey("seed-first")) {
        .Ok(KvResp.Value(value)) => assert(value == "authenticated"),
        _ => panic("initial seed call"),
    }
    let old_location = cluster.wait_registered("kv").expect("seed location");
    let before = cluster.snapshot().expect("authenticated membership");
    assert(before.local_registrations().is_empty());
    var predecessor = before.local;
    for member in before.members {
        if member.id == old_location.node_id() {
            predecessor = member;
        }
    }
    assert(predecessor.id == old_location.node_id());
    assert(predecessor.session == old_location.incarnation());
    scope {
        let interrupted = fork old.handle(KvReq.Stall);
        let _ = wait_for_file(f"{kx}/seed.inflight");
        println("READY_SEED_RESTART");
        match await interrupted {
            .Err(ActorError.ConnectionDropped) => {}
            _ => panic("in-flight seed request must fail once"),
        }
    };
    let _ = wait_for_file(f"{kx}/server.restarted");
    let fresh_peer = fixture_peer();
    let fresh = fresh_peer.receive_service<KeyValue>().expect("fresh seed grant");
    let _wire = fresh_peer.receive_service<WireProbe>().expect("fresh wire grant");
    let _identity = fresh_peer.receive_service<IdentityProbe>().expect("fresh identity grant");
    let fresh_location = cluster.wait_registered("kv").expect("fresh seed location");
    cluster.wait_departed(predecessor).expect("predecessor departure despite rejoin");
    let after = cluster.snapshot().expect("rejoined membership");
    var rejoined = false;
    for member in after.members {
        if member.id == predecessor.id && member.session == fresh_location.incarnation() {
            rejoined = true;
        }
    }
    assert(rejoined);
    assert(fresh_location.incarnation() > old_location.incarnation());
    match fresh.handle(KvReq.GetKey("seed-held")) {
        .Ok(KvResp.Value(value)) => assert(value == ""),
        _ => panic("interrupted request replayed on restart"),
    }
    assert(fresh.handle(KvReq.Put(KvPut { key: "colour", val: "green" })).expect("fresh seed call") == KvResp.Ack);
    match fresh.handle(KvReq.GetKey("colour")) {
        .Ok(KvResp.Value(value)) => assert(value == "green"),
        _ => panic("rejoined seed call"),
    }
    println("PASS persistent_seed absent-start authenticated-call higher-session no-replay fresh-call");
    0
}

fn run_client(scenario: string) -> i64 {
    let kx = os.env("HEW_DIST_KX_DIR") ?? "";
    start_admitted(kx, "client", "server", "127.0.0.1:0");
    if scenario == "persistent_seed" || scenario == "persistent_seed_stop" {
        println("READY_SEED_STARTED");
        if scenario == "persistent_seed_stop" {
            let _ = wait_for_file(f"{kx}/seed.stop-now");
            Node.shutdown();
            println("PASS persistent_seed_stop active-attempt-joined");
            return 0;
        }
    }
    let bound_port = wait_for_server_listening(kx);
    let port = os.env("HEW_DIST_PROXY_PORT") ?? bound_port;
    if scenario != "persistent_seed" {
        let _ = Node.connect(f"127.0.0.1:{port}");
    }
    let status = if scenario == "handshake_reject" {
        scenario_handshake_reject()
    } else if scenario == "quarantine_rejoin" {
        scenario_quarantine_rejoin()
    } else if scenario == "remote_stopped_crash" || scenario == "remote_stopped_cleanup_fault" {
        scenario_remote_stopped(kx, scenario == "remote_stopped_cleanup_fault")
    } else if scenario == "mesh_large" {
        scenario_mesh_large(kx)
    } else if scenario == "message_size" {
        scenario_message_size(kx)
    } else if scenario == "stable_role" {
        scenario_stable_role(kx)
    } else if scenario == "service_grants" {
        scenario_service_grants(kx, port)
    } else {
        let peer = fixture_peer();
        let kv = peer.receive_service<KeyValue>().expect("kv grant");
        let wp = peer.receive_service<WireProbe>().expect("wire grant");
        let identity = peer.receive_service<IdentityProbe>().expect("identity grant");
        if scenario == "persistent_seed" {
            scenario_persistent_seed(kv, kx)
        } else if scenario == "deadline_budget" {
            scenario_deadline_budget()
        } else if scenario == "identity_location" {
            scenario_identity_location(identity)
        } else if scenario == "identity_display_low" {
            scenario_identity_display(identity, scenario, 3)
        } else if scenario == "identity_display_high" {
            scenario_identity_display(identity, scenario, 50)
        } else if scenario == "wire_cbor" {
            scenario_wire_cbor(wp)
        } else if scenario == "remote_setup_exit_race" {
            let monitor_target = peer.receive_service<KeyValue>().expect("monitor race grant");
            let link_target = peer.receive_service<KeyValue>().expect("link race grant");
            scenario_remote_setup_exit_race(monitor_target, link_target)
        } else if scenario == "stale_incarnation_restart" {
            scenario_stale_incarnation_restart(kv, kx, port)
        } else if scenario == "remote_ask" {
            scenario_remote_ask(kv)
        } else if scenario == "inbound_isolation" {
            scenario_inbound_isolation(kv, kx)
        } else if scenario == "linker_local_crash" {
            scenario_linker_local_crash()
        } else if scenario == "link_remote_typed_crash" {
            scenario_link_remote_typed_crash(kv)
        } else if scenario == "local_route" {
            scenario_local_route(kv)
        } else if scenario == "remote_monitor_clean_exit" {
            scenario_remote_monitor_clean_exit(kv)
        } else if scenario == "remote_monitor_crash" {
            scenario_remote_monitor_crash(kv)
        } else if scenario == "remote_monitor_conn_drop" {
            scenario_remote_monitor_conn_drop(kv)
        } else if scenario == "remote_monitor_setup_after_drop" {
            scenario_remote_monitor_setup_after_drop(kv)
        } else if scenario == "partition_ask" {
            scenario_partition_ask(kv)
        } else if scenario == "repoint_preserves_ref" {
            scenario_repoint_preserves_ref(kv, kx)
        } else if scenario == "monitor_watcher_node_death" {
            scenario_client_watcher_node_death(kv)
        } else if scenario == "link_remote_clean_exit" {
            scenario_link_remote_clean_exit(kv)
        } else if scenario == "link_remote_crash" {
            scenario_link_remote_crash(kv)
        } else if scenario == "link_remote_partition" {
            scenario_link_remote_partition(kv)
        } else if scenario == "link_remote_non_crashlinked" {
            scenario_link_remote_non_crashlinked(kv)
        } else if scenario == "cross_node_monitor_close_reclaim" {
            scenario_client_monitor_close_reclaim(kv)
        } else if scenario == "monitor_leak_low" {
            scenario_client_monitor_leak(kv, kx, scenario, 3)
        } else if scenario == "monitor_leak_high" {
            scenario_client_monitor_leak(kv, kx, scenario, 50)
        } else {
            println(f"FAIL {scenario} unknown-scenario");
            90
        }
    };
    Node.shutdown();
    status
}

#[wire]
machine TransitHistory<T> {
    events {
        Resume { seed: T; }
        Advance;
        Leave;
    }
    emits {
        Changed { value: T; }
        Counted { value: i64; }
    }
    state Off;
    parallel state On {
        seed: T;
        region left {
            state L0 { value: T; }
            state L1 { value: T; }
            initial L0 { value: state.seed };
        }
        region right {
            state InnerRight {
                count: i64;
                state R0 { child: i64; }
                state R1 { child: i64; }
                initial R0 { child: 4 };
            }
            initial InnerRight { count: 7 };
        }
    }
    on Resume: Off => On history { seed: event.seed }
    on Advance: L0 => L1 {
        emit Changed { value: state.value };
        L1 { value: state.value }
    }
    on Advance: R0 => R1 {
        emit Counted { value: state.count + 1 };
        R1 { count: state.count + 1, child: 99 }
    }
    on Leave: On => Off;
    default { state }
}

#[wire]
type TransitMachineReply {
    state: TransitHistory<string> @1;
    report: TransitHistoryStep<string> @2;
    retained: TransitHistoryStep<string> @3;
}

fn check_transit_machine(service: TransitCounter) {
    var current_machine: TransitHistory<string> = .Off;
    let _initial = current_machine.step(.Resume { seed: "saved".to_upper() }).expect("machine step failed");
    let advanced = current_machine.step(.Advance).expect("machine step failed");
    assert(advanced.rules == [1, 2]);
    assert(advanced.outputs == [.Changed { value: "SAVED" }, .Counted { value: 8 }]);
    let _leave = current_machine.step(.Leave).expect("machine step failed");
    let paused = current_machine;
    let reply = service.machine_step(paused, .Resume { seed: "fresh" }, advanced).expect("relayed history resume");
    assert(reply.retained == advanced);
    assert(reply.report.rules == [0] && reply.report.outputs.is_empty());
    assert(reply.report.input == "Resume" && reply.report.disposition == .Taken);
    match reply.state {
        .On { seed, left: .L1 { value }, right: .R0 { count, child } } => {
            assert(seed == "fresh" && value == "SAVED" && count == 8 && child == 4);
        }
        _ => panic("relayed shallow parallel history"),
    }
    let next = service.machine_step(reply.state, .Advance, reply.report).expect("relayed parallel continuation");
    assert(next.report.rules == [2]);
    assert(next.report.outputs == [.Counted { value: 9 }]);
    assert(next.retained == reply.report);
    match next.state {
        .On { seed, left: .L1 { value }, right: .R1 { count, child } } => {
            assert(seed == "fresh" && value == "SAVED" && count == 9 && child == 99);
        }
        _ => panic("relayed next exact machine state"),
    }
    assert(current_machine == paused && advanced.outputs == [.Changed { value: "SAVED" }, .Counted { value: 8 }]);
}

actor TransitCounter {
    var machine_calls: i64 = 0;
    #[wire]
    receive fn machine_step(value: TransitHistory<string>, event: TransitHistory.Event<string>, retained: TransitHistoryStep<string>) -> TransitMachineReply {
        machine_calls += 1;
        var current = value;
        let report = current.step(event).expect("machine step failed");
        TransitMachineReply { state: current, report, retained }
    }
    #[wire]
    receive fn machine_count() -> i64 {
        machine_calls
    }
    var total: i64 = 0;
    var stalled: i64 = 0;
    #[wire]
    receive fn add(amount: i64) -> i64 {
        total += amount;
        total
    }
    #[wire]
    receive fn read() -> i64 {
        total
    }
    #[wire]
    receive fn held(kx: string) -> i64 {
        stalled += 1;
        publish_atomic(kx, "transit.inflight", "1");
        let _ = wait_for_file(f"{kx}/transit.release");
        stalled
    }
    #[wire]
    receive fn held_count() -> i64 {
        stalled
    }
    #[wire]
    receive fn echo(value: string) -> string {
        value
    }
    #[wire]
    receive fn location() -> string {
        let location = Node.lookup("transit-server").expect("origin name");
        f"{location}"
    }
}

fn run_transitive(role: string) -> i64 {
    let kx = os.env("HEW_DIST_KX_DIR") ?? "";
    start_admitted(kx, role, "server", "127.0.0.1:0");
    let counter = spawn TransitCounter;
    Node.register(f"transit-{role}", counter);
    if role == "server" {
        let _ = signal_server_listening(kx);
        println(f"READY {unsafe { hew_dist_bound_port() }}");
        let client = cluster.wait_registered("transit-client").expect("authenticated client origin");
        let peer = Node.peer(client.node_id()).expect("authenticated client session");
        let export = peer.export(counter).expect("offer origin actor");
        let _ = wait_for_file(f"{kx}/transit.revoke");
        export.close();
        publish_atomic(kx, "transit.revoked", "1");
        let replacement = peer.export(counter).expect("fresh grant");
        let _ = wait_for_file(f"{kx}/transit.done");
        assert(counter.read().expect("one accepted mutation") == 42);
        assert(counter.machine_count().expect("two accepted machine steps") == 2);
        replacement.close();
    } else if role == "relay" {
        let port = os.env("HEW_DIST_ORIGIN_PORT").expect("origin address");
        Node.connect(f"127.0.0.1:{port}").expect("relay admits origin");
        let own_port = f"{unsafe { hew_dist_bound_port() }}";
        publish_atomic(kx, "relay.ready", own_port);
        println(f"READY {own_port}");
        let _ = wait_for_file(f"{kx}/transit.done");
    } else {
        let port = os.env("HEW_DIST_RELAY_PORT").expect("relay address");
        Node.connect(f"127.0.0.1:{port}").expect("client admits relay");
        let origin = cluster.wait_registered("transit-server").expect("transitive origin discovery");
        let relay = cluster.wait_registered("transit-relay").expect("relay discovery");
        assert(origin.node_id() != relay.node_id());
        let peer = Node.peer(origin.node_id()).expect("end-to-end origin session");
        let service: TransitCounter = peer.receive_service<TransitCounter>().expect("origin grant");
        assert(service.location().expect("authenticated origin location") == f"{origin}");
        assert(service.add(42).expect("transitive actor call") == 42);
        check_transit_machine(service);
        if os.env("HEW_DIST_TRANSPORT") == .Some("quic-mesh") {
            let large = "relay".repeat(32768);
            assert(service.echo(large).expect("large relayed TLS request and reply") == large);
            assert(service.echo("after").expect("following relayed TLS frame") == "after");
        }
        publish_atomic(kx, "transit.revoke", "1");
        let _ = wait_for_file(f"{kx}/transit.revoked");
        match service.add(100) {
            .Err(ActorError.RoutingFailed) => {}
            .Err(error) => panic(f"unexpected revoked grant failure: {error}"),
            .Ok(_) => panic("revoked origin grant retained authority"),
        }
        var refused: TransitHistory<string> = .Off;
        let retained = refused.step(.Resume { seed: "refused" }).expect("machine step failed");
        match service.machine_step(refused, .Advance, retained) {
            .Err(ActorError.RoutingFailed) => {}
            .Err(error) => panic(f"unexpected revoked machine grant failure: {error}"),
            .Ok(_) => panic("revoked machine call executed"),
        }
        let fresh: TransitCounter = peer.receive_service<TransitCounter>().expect("fresh origin grant");
        assert(fresh.read().expect("refused request did not execute") == 42);
        assert(fresh.machine_count().expect("refused machine call did not execute") == 2);
        println("PASS relayed machine history state fresh/SAVED/8/4 next fresh/SAVED/9/99 rules 1,2/0/2 retained output SAVED no-replay");
        publish_atomic(kx, "transit.done", "1");
        println("PASS transitive origin-session discovery grant call revoke no-replay");
    }
    Node.shutdown();
    0
}

fn wait_transit_successor(previous: Location) -> Location {
    let observation = cluster.watch().expect("successor observation");
    loop {
        let current = observation.snapshot().expect("successor snapshot");
        for item in current.registrations {
            if item.name == "transit-server" && item.location.node_id() == previous.node_id() && item.location.incarnation() > previous.incarnation() {
                return item.location;
            }
        }
        assert(observation.changes.recv().is_some());
    }
}

fn run_transitive_restart(role: string) -> i64 {
    let kx = os.env("HEW_DIST_KX_DIR") ?? "";
    let port = if role == "server" {
        os.env("HEW_DIST_ORIGIN_BIND_PORT") ?? "0"
    } else {
        "0"
    };
    start_admitted(kx, role, "server", f"127.0.0.1:{port}");
    let counter = spawn TransitCounter;
    Node.register(f"transit-{role}", counter);
    if role == "server" {
        let _ = signal_server_listening(kx);
        println(f"READY {unsafe { hew_dist_bound_port() }}");
        let client = cluster.wait_registered("transit-client").expect("authenticated client origin");
        let peer = Node.peer(client.node_id()).expect("authenticated client peer");
        let export = peer.export(counter).expect("restart origin grant");
        let _ = wait_for_file(f"{kx}/transit.done");
        export.close();
    } else if role == "relay" {
        let own_port = f"{unsafe { hew_dist_bound_port() }}";
        publish_atomic(kx, "relay.ready", own_port);
        println(f"READY {own_port}");
        let _ = wait_for_file(f"{kx}/transit.done");
    } else {
        let relay_port = os.env("HEW_DIST_RELAY_PORT").expect("relay address");
        Node.connect(f"127.0.0.1:{relay_port}").expect("client admits relay");
        let old_location = cluster.wait_registered("transit-server").expect("first origin");
        let peer = Node.peer(old_location.node_id()).expect("first end-to-end peer");
        let old: TransitCounter = peer.receive_service<TransitCounter>().expect("first grant");
        assert(old.add(42).expect("initial mutation") == 42);
        scope {
            let interrupted = fork old.held(kx);
            let _ = wait_for_file(f"{kx}/transit.inflight");
            println("READY_TRANSIT_RESTART");
            match await interrupted {
                .Err(ActorError.ConnectionDropped) => {}
                _ => panic("carrier loss did not fail its one admitted call"),
            }
        };
        let fresh_location = wait_transit_successor(old_location);
        let fresh_peer = Node.peer(fresh_location.node_id()).expect("higher origin session");
        let fresh: TransitCounter = fresh_peer.receive_service<TransitCounter>().expect("fresh origin grant");
        assert(fresh.read().expect("fresh state") == 0);
        assert(fresh.held_count().expect("no replay") == 0);
        match old.read() {
            .Err(ActorError.Dead) => {}
            _ => panic("old origin session regained authority"),
        }
        assert(fresh.add(7).expect("fresh call") == 7);
        publish_atomic(kx, "transit.done", "1");
        println("PASS transitive carrier-loss higher-session old-grant-fenced no-replay fresh-call");
    }
    Node.shutdown();
    0
}

fn main() -> i64 {
    let role = os.env("HEW_DIST_ROLE") ?? "";
    var scenario = os.env("HEW_DIST_SCENARIO") ?? "";
    if scenario == "" {
        scenario = "remote_ask";
    }
    if scenario == "transitive_restart" {
        return run_transitive_restart(role);
    }
    if scenario == "transitive" {
        return run_transitive(role);
    }
    if role == "server" {
        run_server(scenario);
        0
    } else {
        if role == "client" {
            run_client(scenario)
        } else {
            println(f"FAIL config unknown-role={role}");
            99
        }
    }
}
