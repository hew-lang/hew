// Generic pipeline input and output types are inferred from the source and callback.
import std.pipeline;
import std.stream;

fn main() {
    let (sink, source): (Sink<string>, Stream<string>) = stream.pipe(1).expect("pipe");
    sink.send("pipeline").expect("send");
    sink.finish();
    for length in pipeline.map(source, |value: string| value.len()) {
        println(length);
    }
}
