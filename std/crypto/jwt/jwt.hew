//! JSON Web Token encoding and validation.
//!
//! Encode, decode, and validate JWTs using HMAC algorithms.
//!
//! # Examples
//!
//! ```
//! import std.crypto.jwt;
//!
//! fn main() {
//!     let claims = "{\"sub\":\"1234\",\"exp\":4102444800}";
//!     match jwt.encode(claims, "example only secret, never use in production", "HS256") {
//!         .Ok(token) => println(token),
//!         .Err(err) => println(err),
//!     }
//! }
//! ```

/// Structured JWT errors surfaced by the native C ABI.
pub enum JwtError {
    AlgorithmUnsupported;
    InvalidKey;
    TokenMalformed;
    SignatureInvalid;
    ClaimsExpired;
    AllocationFailure;
    ClaimsInvalid;
}

fn jwt_error_from_i32(code: i32) -> Option<JwtError> { // INTERNAL-ABI: C ABI error tag is i32 repr(C)
    match code {
        0 => .None,
        1 => .Some(JwtError.AlgorithmUnsupported),
        2 => .Some(JwtError.InvalidKey),
        3 => .Some(JwtError.TokenMalformed),
        4 => .Some(JwtError.SignatureInvalid),
        5 => .Some(JwtError.ClaimsExpired),
        6 => .Some(JwtError.AllocationFailure),
        7 => .Some(JwtError.ClaimsInvalid),
        _ => .Some(JwtError.TokenMalformed),
    }
}

impl Error for JwtError {}

impl Display for JwtError {
    fn fmt(self) -> string {
        match self {
            JwtError.AlgorithmUnsupported => "JWT algorithm is not supported",
            JwtError.InvalidKey => "JWT key input is invalid",
            JwtError.TokenMalformed => "JWT payload or token is malformed",
            JwtError.SignatureInvalid => "JWT signature verification failed",
            JwtError.ClaimsExpired => "JWT claims have expired",
            JwtError.AllocationFailure => "JWT native allocation failed",
            JwtError.ClaimsInvalid => "JWT required claims are missing or invalid",
        }
    }
}

// ── Algorithm mapping (pure Hew) ─────────────────────────────────────
/// Map an algorithm name (e.g. "HS256") to its integer code for the FFI layer.
fn algo_to_i32(algorithm: string) -> i32 { // INTERNAL-ABI: C ABI algorithm code; values 0-2 and sentinel -1 fit i32
    match algorithm {
        "HS256" => 0 as i32,
        "HS384" => 1 as i32,
        "HS512" => 2 as i32,
        _ => -1 as i32,
    }
}

/// Return the last JWT error observed on this thread.
fn last_error() -> Option<JwtError> {
    jwt_error_from_i32(unsafe {
        hew_jwt_last_error_code()
    })
}

/// Encode a JSON payload into a signed JWT string.
///
/// Returns `Err(JwtError)` when the payload, key, algorithm, or allocation
/// path fails.
pub fn encode(payload: string, secret: string, algorithm: string) -> Result<string, JwtError> {
    let algo = algo_to_i32(algorithm);
    let token = unsafe {
        hew_jwt_encode_hew(payload, secret, algo)
    };
    match last_error() {
        .None => .Ok(token),
        .Some(err) => .Err(err),
    }
}

/// Decode and verify a JWT, returning its payload as a JSON string.
///
/// Returns `Err(JwtError)` when the token is malformed, expired, signed with a
/// different key, lacks a valid `exp` claim, has an invalid `nbf` claim, or
/// cannot be allocated. HMAC secrets must be at least 32, 48 or 64 bytes for
/// HS256, HS384 or HS512 respectively. A token carrying an `aud` claim must be
/// decoded with `decode_with_policy`. Time claims are checked without clock-skew
/// leeway.
pub fn decode(token: string, secret: string, algorithm: string) -> Result<string, JwtError> {
    let algo = algo_to_i32(algorithm);
    let payload = unsafe {
        hew_jwt_decode_hew(token, secret, algo)
    };
    match last_error() {
        .None => .Ok(payload),
        .Some(err) => .Err(err),
    }
}

/// Decode and verify a JWT for one issuer and audience.
///
/// In addition to the checks performed by `decode`, this requires matching
/// `iss` and `aud` claims. An audience array is accepted when it contains the
/// expected audience. Use this at authentication boundaries where the expected
/// token issuer and recipient are known.
pub fn decode_with_policy(token: string, secret: string, algorithm: string, issuer: string, audience: string) -> Result<string, JwtError> {
    let algo = algo_to_i32(algorithm);
    let payload = unsafe {
        hew_jwt_decode_with_policy_hew(token, secret, algo, issuer, audience)
    };
    match last_error() {
        .None => .Ok(payload),
        .Some(err) => .Err(err),
    }
}

/// Decode a JWT without verifying its signature.
///
/// **Warning:** This does not validate the token. Only use for
/// inspecting untrusted tokens when you don't need authenticity.
///
/// # Examples
///
/// ```
/// import std.crypto.jwt;
///
/// fn main() {
///     let token = jwt.encode("{\"sub\":\"1234\"}", "example only secret, never use in production", "HS256") handle error {
///         println(f"operation failed: {error}");
///         return;
///     };
///     let payload = jwt.decode_insecure(token).expect("encoded token");
///     println(payload);
/// }
/// ```
pub fn decode_insecure(token: string) -> string fails JwtError {
    let payload = unsafe {
        hew_jwt_decode_insecure(token)
    };
    match last_error() {
        .None => payload,
        .Some(err) => return error err,
    }
}

/// Validate a JWT signature, required expiration and optional not-before claim.
///
/// Returns `true` if the token is valid, `false` otherwise.
///
/// # Examples
///
/// ```
/// import std.crypto.jwt;
///
/// fn main() {
///     let claims = "{\"sub\":\"1234\",\"exp\":4102444800}";
///     let secret = "example only secret, never use in production";
///     let token = jwt.encode(claims, secret, "HS256") handle error {
///         println(f"operation failed: {error}");
///         return;
///     };
///     if jwt.validate(token, secret, "HS256") {
///         println("valid");
///     }
/// }
/// ```
pub fn validate(token: string, secret: string, algorithm: string) -> bool {
    let algo = algo_to_i32(algorithm);
    (unsafe {
        hew_jwt_validate(token, secret, algo)
    }) == 1
}

/// Validate a JWT for one issuer and audience without returning its claims.
pub fn validate_with_policy(token: string, secret: string, algorithm: string, issuer: string, audience: string) -> bool {
    let algo = algo_to_i32(algorithm);
    (unsafe {
        hew_jwt_validate_with_policy(token, secret, algo, issuer, audience)
    }) == 1
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    fn hew_jwt_encode_hew(payload: string, secret: string, algorithm: i32) -> string;
    fn hew_jwt_decode_hew(token: string, secret: string, algorithm: i32) -> string;
    fn hew_jwt_decode_with_policy_hew(token: string, secret: string, algorithm: i32, issuer: string, audience: string) -> string;
    fn hew_jwt_last_error_code() -> i32;
    fn hew_jwt_decode_insecure(token: string) -> string;
    fn hew_jwt_validate(token: string, secret: string, algorithm: i32) -> i32;
    fn hew_jwt_validate_with_policy(token: string, secret: string, algorithm: i32, issuer: string, audience: string) -> i32;
}
