enum Colour {
    Red;
    Green;
}

fn main() {
    let x: Colour = Red;
    let m: HashMap<string, Colour> = HashMap::new();
    m.insert("k", x);
    match m.get("k") {
        Some(e) => {
            match e { Red => println("Red"), Green => println("Green"), }
        },
        None => println("missing"),
    }
}
