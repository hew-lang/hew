import std.net;

import std.net.quic;

import std.net.smtp;

import std.net.tls;

import std.net.websocket;

fn main() {
    let tls_port: i64 = 443;
    let tls_size: i64 = 4096;
    let tls_stream: tls.TlsStream = tls.connect("example.com", tls_port);
    let _tls_chunk: Result<bytes, net.NetError> = tls.read(tls_stream, tls_size);
    let smtp_port: i64 = 587;
    let _smtp_conn: Result<smtp.Conn, string> = smtp.connect("smtp.example.com", smtp_port, "user", "pass");
    let _smtp_tls_conn: Result<smtp.Conn, string> = smtp.connect_tls("smtp.example.com", 465, "user", "pass");
    let _smtp_send_status: Result<(), string> = smtp.send("smtp.example.com", smtp_port, "user", "pass", "from@example.com", "to@example.com", "subject", "body");
    let _smtp_send_html_status: Result<(), string> = smtp.send_html("smtp.example.com", smtp_port, "user", "pass", "from@example.com", "to@example.com", "subject", "<p>body</p>");
    let ws_listen: Result<websocket.Server, net.NetError> = websocket.listen("127.0.0.1:0");
    var ws_port: i64 = 0;
    match ws_listen {
        .Ok(ws_server) => {
            ws_port = ws_server.port();
            ws_server.close();
        },
        .Err(_err) => {},
    }
    let timeout_ms: i64 = 1500;
    let conn: net.Connection = match net.connect_timeout("127.0.0.1:8080", 1, 500000) { .Ok(value) => value, .Err(error) => panic("network operation failed"), };
    let _read_timeout_status: Result<(), net.NetError> = conn.set_read_timeout(timeout_ms);
    let _write_timeout_status: Result<(), net.NetError> = conn.set_write_timeout(timeout_ms);
    let quic_conn: quic.QUICConnection = quic.new_client().connect("127.0.0.1:4433", "localhost");
    let quic_obs: quic.QUICConnectionObservation = quic_conn.observe();
    let quic_rtt: i64 = quic_obs.rtt_ms;
    println(ws_port + quic_rtt);
}
