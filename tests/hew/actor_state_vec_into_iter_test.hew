//! Consuming iteration (`into_iter()`) over a Vec held in ACTOR STATE drains
//! the field and leaves it a VALID empty vec: the cursor owns the moved
//! buffer (`hew_vec_take_all`), the state slot keeps its stamped element
//! descriptor, later dispatches may re-iterate (empty) or refill it, and
//! actor teardown frees the slot exactly once (dogfood F3, 2026-08-13:
//! second use panicked on a missing descriptor / freed heap, and teardown
//! crashed after #[on(stop)]).

import std.testing;

trait Formatter {
    fn format(val: Self, msg: string) -> string;
}

type TagFormatter {
    tag: string;
}

impl Formatter for TagFormatter {
    fn format(f: TagFormatter, msg: string) -> string {
        f"{f.tag}:{msg}"
    }
}

fn make_formatter(tag: string) -> dyn Formatter {
    let f: dyn Formatter = TagFormatter { tag: tag };
    f
}

actor DynHolder {
    var plugins: Vec<dyn Formatter> = Vec.new();
    receive fn drain_format(msg: string) -> i64 {
        var count: i64 = 0;
        for p in plugins.into_iter() {
            let _line = p.format(msg);
            count = count + 1;
        }
        count
    }
    receive fn refill() {
        plugins.push(make_formatter("W"));
    }
    receive fn plugin_count() -> i64 {
        plugins.len()
    }
    #[on(start)]
    fn boot() {
        plugins.push(make_formatter("U"));
        plugins.push(make_formatter("V"));
    }
}

actor StrHolder {
    var items: Vec<string> = Vec.new();
    receive fn drain_count() -> i64 {
        var count: i64 = 0;
        for _s in items.into_iter() {
            count = count + 1;
        }
        count
    }

    // Previously: deterministic "Vec owned operation requires an element
    // layout descriptor" panic. Now: the drained field is a valid empty vec.

    // Refill after the drain: the descriptor-stamped empty vec accepts a
    // fresh element, and a later drain yields exactly that element.

    // Previously: the second dispatch iterated freed heap (a hang or crash).
    #[on(start)]
    fn boot() {
        items.push("a");
        items.push("b");
    }
}

#[test]
fn test_second_dispatch_after_dyn_state_drain_sees_valid_empty_vec() {
    let h = spawn DynHolder;
    let first = await h.drain_format("m1");
    match first {
        .Ok(n) => testing.assert_eq(n, 2),
        .Err(_) => testing.assert_eq(0, 1),
    }
    let second = await h.drain_format("m2");
    match second {
        .Ok(n) => testing.assert_eq(n, 0),
        .Err(_) => testing.assert_eq(0, 2),
    }
}

#[test]
fn test_push_into_drained_dyn_state_field_lands_in_valid_vec() {
    let h = spawn DynHolder;
    let first = await h.drain_format("m1");
    match first {
        .Ok(n) => testing.assert_eq(n, 2),
        .Err(_) => testing.assert_eq(0, 1),
    }
    h.refill();
    let count = await h.plugin_count();
    match count {
        .Ok(n) => testing.assert_eq(n, 1),
        .Err(_) => testing.assert_eq(0, 2),
    }
    let third = await h.drain_format("m3");
    match third {
        .Ok(n) => testing.assert_eq(n, 1),
        .Err(_) => testing.assert_eq(0, 3),
    }
}

#[test]
fn test_second_dispatch_after_string_state_drain_terminates() {
    let h = spawn StrHolder;
    let first = await h.drain_count();
    match first {
        .Ok(n) => testing.assert_eq(n, 2),
        .Err(_) => testing.assert_eq(0, 1),
    }
    let second = await h.drain_count();
    match second {
        .Ok(n) => testing.assert_eq(n, 0),
        .Err(_) => testing.assert_eq(0, 2),
    }
}
