// Regression for the regex no-match-vs-empty-string equality boundary.
import std.text.regex;

fn main() {
    let pat = regex.new("[0-9]+").expect("valid pattern");
    let hit = pat.find("abc123def").expect("digit run");
    println(f"hit_eq={hit == "123"}");
    let miss = pat.find("abcdef");
    println(f"miss_none={miss.is_none()}");
    let empty = regex.new("^").expect("valid empty match");
    let empty_hit = empty.find("abcdef");
    println(f"empty_some={empty_hit.is_some()}");
    println(f"empty_text={empty_hit.expect("empty match") == ""}");
    empty.close();
    pat.close();
}
