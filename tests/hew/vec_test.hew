// ── negative-value edge cases ─────────────────────────────────────────────
#[test]
fn test_min_i32_with_negatives() {
    var v: Vec<i32> = Vec.new();
    v.push(5);
    v.push(-3);
    v.push(2);
    assert(vec.min_i32(v).unwrap_or(-999) == -3);
}

#[test]
fn test_max_i32_with_negatives() {
    var v: Vec<i32> = Vec.new();
    v.push(-5);
    v.push(-1);
    v.push(-9);
    assert(vec.max_i32(v).unwrap_or(-999) == -1);
}

#[test]
fn test_min_f64_with_negatives() {
    var v: Vec<f64> = Vec.new();
    v.push(1.0);
    v.push(-2.5);
    v.push(0.5);
    assert(vec.min_f64(v).unwrap_or(0.0) == -2.5);
}

#[test]
fn test_max_f64_with_negatives() {
    var v: Vec<f64> = Vec.new();
    v.push(-1.0);
    v.push(-0.5);
    v.push(-3.0);
    assert(vec.max_f64(v).unwrap_or(0.0) == -0.5);
}

#[test]
fn test_index_of_i32_negative_value() {
    var v: Vec<i32> = Vec.new();
    v.push(10);
    v.push(-7);
    v.push(3);
    let result = vec.index_of_i32(v, -7);
    assert(result.is_some());
    assert(result.unwrap_or(-1) == 1);
}

#[test]
fn test_index_of_i32_zero_value() {
    var v: Vec<i32> = Vec.new();
    v.push(1);
    v.push(0);
    v.push(2);
    let result = vec.index_of_i32(v, 0);
    assert(result.is_some());
    assert(result.unwrap_or(-1) == 1);
}

// ── min/max empty-vector returns None ─────────────────────────────────────
#[test]
fn test_min_i32_empty_none() {
    let v: Vec<i32> = Vec.new();
    assert(vec.min_i32(v).is_none());
}

#[test]
fn test_max_i32_empty_none() {
    let v: Vec<i32> = Vec.new();
    assert(vec.max_i32(v).is_none());
}

#[test]
fn test_min_i64_empty_none() {
    let v: Vec<i64> = Vec.new();
    assert(vec.min_i64(v).is_none());
}

#[test]
fn test_max_i64_empty_none() {
    let v: Vec<i64> = Vec.new();
    assert(vec.max_i64(v).is_none());
}

#[test]
fn test_min_f64_empty_none() {
    let v: Vec<f64> = Vec.new();
    assert(vec.min_f64(v).is_none());
}

#[test]
fn test_max_f64_empty_none() {
    let v: Vec<f64> = Vec.new();
    assert(vec.max_f64(v).is_none());
}
