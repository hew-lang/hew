// The handler updates its own state and replies with the new total.
actor ParcelCounter {
    var parcels: i64 = 0;

    receive fn unload(count: i64) -> i64 {
        parcels += count;
        parcels
    }
}

fn main() {
    let counter = spawn ParcelCounter;
    for load in [5, 10] {
        let total = counter.unload(load).expect("the depot counter is running");
        println(f"{total} parcels at the depot");
    }
    stop(counter);
    stopped(counter);
}
