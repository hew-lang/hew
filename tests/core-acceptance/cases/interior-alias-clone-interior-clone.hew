type Row { name: string, }

fn run_cycle() -> i64 {
    let rows: Vec<Row> = [ Row { name: "interior-clone-heap-name".to_upper() } ];
    let first = rows.get(0);
    var got: i64 = 0;
    match first {
        .Some(r) => { let copied = r.name.to_upper(); if copied.len() > 0 { got = copied.len(); } }
        .None => {}
    }
    got
}

fn run_loop(frames: i64) -> i64 {
    var total: i64 = 0;
    for i in 0..frames { total = total + run_cycle(); }
    total
}

fn main() -> i64 { run_loop(50) }
