//! Status: runnable
//! Description: HTTP static file server in Hew

// HTTP static file server in Hew
//
// Accepts connections in main and serves files with MIME type detection.
//
// Usage: http_server [port] [root_dir]
// Defaults: port=8080, root_dir="."
import std.net.http.{Request, Server};

import std.fs;

import std.os;

import std.net.mime;

fn serve_forever(root: string, srv: Server) {
    loop {
        let req = srv.accept();
        serve_request(root, req);
    }
}

fn serve_request(root: string, req: Request) {
    let request_path = req.path();
    if request_path.contains("..") {
        req.respond_text(403, "403 Forbidden");
    } else {
        var file_path = root + request_path;
        if request_path.ends_with("/") {
            file_path = file_path + "index.html";
        }
        if fs.exists(file_path) {
            match fs.read(file_path) {
                .Ok(body) => {
                    let content_type = mime.from_path(file_path);
                    req.respond(200, content_type, body);
                },
                .Err(_) => {
                    req.respond_text(500, "500 Internal Server Error");
                },
            }
        } else {
            let index_path = file_path + "/index.html";
            if fs.exists(index_path) {
                match fs.read(index_path) {
                    .Ok(body) => {
                        let content_type = mime.from_path(index_path);
                        req.respond(200, content_type, body);
                    },
                    .Err(_) => {
                        req.respond_text(500, "500 Internal Server Error");
                    },
                }
            } else {
                req.respond_text(404, "404 Not Found");
            }
        }
    }
    req.close();
}

fn main() {
    var port: string = "8080";
    var root: string = ".";
    let argc = os.args().len();
    if argc > 1 {
        match os.args().get(1) {
            .Some(value) => {
                port = value;
            },
            .None => {},
        }
    }
    if argc > 2 {
        match os.args().get(2) {
            .Some(value) => {
                root = value;
            },
            .None => {},
        }
    }
    let addr = f"0.0.0.0:{port}";
    println("=== Hew HTTP Static File Server ===");
    println(f"Listening on http://{addr}  root={root}");
    match http.listen(addr) {
        .Ok(srv) => {
            serve_forever(root, srv);
        },
        .Err(err) => {
            let reason = to_string(err);
            let detail = http.listen_error();
            println(f"cannot listen on {addr}: {reason} - {detail}");
        },
    }
}
