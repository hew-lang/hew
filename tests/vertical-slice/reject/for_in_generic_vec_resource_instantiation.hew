import std.link_monitor.{MonitorRef};

#[resource]
type Handle {
    name: string,
}

impl Handle {
    fn close(consume self) {}
}

type Wrapper {
    handle: Handle,
}

// `for item in items` binds the element as a borrow, so counting is fine and
// no shallow clone is made. The fail-closed property lives at the escape: a
// borrowed element with no copy operation cannot be transferred out.
fn _take_first<T>(items: Vec<T>) -> Option<T> {
    for item in items {
        return Some(item);
    }
    None
}

// The parameter is enough to instantiate `_take_first<Handle>`; no Handle
// constructor or unsafe value fabrication is needed for the fail-closed proof.
fn _take_handle(items: Vec<Handle>) -> Option<Handle> {
    _take_first(items)
}

// An unmarked outer record must not hide the nested resource marker.
fn _take_wrapper(items: Vec<Wrapper>) -> Option<Wrapper> {
    _take_first(items)
}

// MonitorRef is a builtin field-bearing resource record. Its u64 field is
// structurally cloneable, but the monitor registration itself is not.
fn _take_monitor_ref(items: Vec<MonitorRef>) -> Option<MonitorRef> {
    _take_first(items)
}

fn main() {
    let handles: Vec<Handle> = Vec.new();
    let wrappers: Vec<Wrapper> = Vec.new();
    let monitors: Vec<MonitorRef> = Vec.new();
    let _a = _take_handle(handles);
    let _b = _take_wrapper(wrappers);
    let _c = _take_monitor_ref(monitors);
}
