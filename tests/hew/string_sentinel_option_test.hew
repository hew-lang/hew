//! Tests for the D46 sentinel->Option sweep on string inspectors:
//! `find -> Option<i64>` and `get -> Option<char>`. Hits assert the exact index/value;
//! misses assert `None`; the index-0 hit pins that `Some(0)` is distinct
//! from `None` (the old `-1` sentinel's footgun neighbourhood).

// ── find ────────────────────────────────────────────────────────────────────
#[test]
fn test_find_hit_returns_exact_scalar_index() {
    assert(("hello world".find("world") ?? -1) == 6);
    assert(("abcabc".find("bc") ?? -1) == 1);
}

#[test]
fn test_find_at_index_zero_is_some_zero_not_none() {
    // The canonical mistranslation trap: a hit at index 0 must be
    // distinguishable from a miss.
    let r = ":x".find(":");
    assert(r.is_some());
    assert((r ?? -1) == 0);
}

#[test]
fn test_find_miss_returns_none() {
    assert("hello".find("zzz").is_none());
    assert("".find("a").is_none());
}

#[test]
fn test_find_empty_needle_is_some_zero() {
    // strstr semantics: the empty needle matches at offset 0.
    assert(("abc".find("") ?? -1) == 0);
}

// ── get (scalar-indexed) ──────────────────────────────────────────────────
#[test]
fn test_get_in_range_returns_exact_scalar() {
    let c = "abc".get(1);
    assert(c.is_some());
    assert((c ?? '?') == 'b');
}

#[test]
fn test_get_index_zero_is_some() {
    assert(("abc".get(0) ?? '?') == 'a');
}

#[test]
fn test_get_out_of_bounds_returns_none_not_trap() {
    assert("abc".get(3).is_none());
    assert("abc".get(99).is_none());
    assert("abc".get(-1).is_none());
    assert("".get(0).is_none());
}
