import std.encoding.json;
import std.encoding.yaml;
import std.encoding.toml;

#[max_heap(32)]
actor JsonReader {
    receive fn read(consume value: json.Value) -> i64 {
        value.get_int().expect("int")
    }
}

#[max_heap(32)]
actor YamlReader {
    receive fn read(consume value: yaml.Value) -> i64 {
        value.get_int().expect("int")
    }
}

#[max_heap(32)]
actor TomlReader {
    receive fn read(consume value: toml.Value) -> i64 {
        value.get_int().expect("int")
    }
}

fn main() -> i64 {
    let scalar = spawn JsonReader;
    println(scalar.read(json.from_int(7)).expect("scalar fits"));
    stop(scalar);
    stopped(scalar);

    let large = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
    let json_reader = spawn JsonReader;
    match json_reader.read(json.from_string(large)) {
        .Err(.Trapped) => println("json limit"),
        _ => return 2,
    }
    stopped(json_reader);
    let yaml_reader = spawn YamlReader;
    match yaml_reader.read(yaml.from_string(large)) {
        .Err(.Trapped) => println("yaml limit"),
        _ => return 3,
    }
    stopped(yaml_reader);
    let toml_reader = spawn TomlReader;
    match toml_reader.read(toml.from_string(large)) {
        .Err(.Trapped) => println("toml limit"),
        _ => return 4,
    }
    stopped(toml_reader);
    println(large.len());
    0
}
