//! Result methods.
//!
//! Every program sees these methods without an import, like `.len()`.

impl<T, E> Result<T, E> {
    /// Returns `true` if the result contains an `Ok` value.
    pub fn is_ok(self) -> bool {
        match self {
            .Ok(_) => true,
            .Err(_) => false,
        }
    }
    /// Returns `true` if the result contains an `Err` value.
    pub fn is_err(self) -> bool {
        match self {
            .Ok(_) => false,
            .Err(_) => true,
        }
    }
    /// Unwrap the `Ok` value, or return `fallback` if `Err`.
    pub fn unwrap_or(consume self, consume fallback: T) -> T {
        match self {
            .Ok(v) => v,
            .Err(_) => fallback,
        }
    }
    /// Unwrap the `Ok` value, or compute a fallback from the error with `f`.
    pub fn unwrap_or_else(consume self, f: fn(E) -> T) -> T {
        match self {
            .Ok(v) => v,
            .Err(e) => f(e),
        }
    }
    /// Discard the error, converting to `Some` on `Ok` or `None` on `Err`.
    pub fn ok(consume self) -> Option<T> {
        match self {
            .Ok(v) => .Some(v),
            .Err(_) => .None,
        }
    }
    /// Discard the value, converting to `Some` on `Err` or `None` on `Ok`.
    pub fn err(consume self) -> Option<E> {
        match self {
            .Ok(_) => .None,
            .Err(e) => .Some(e),
        }
    }
    /// Apply `f` to the contained `Ok` value, or return the `Err` unchanged.
    pub fn map<U>(consume self, f: fn(T) -> U) -> Result<U, E> {
        match self {
            .Ok(v) => .Ok(f(v)),
            .Err(e) => .Err(e),
        }
    }
    /// Apply `f` to the contained `Err` value, or return the `Ok` unchanged.
    pub fn map_err<F>(consume self, f: fn(E) -> F) -> Result<T, F> {
        match self {
            .Ok(v) => .Ok(v),
            .Err(e) => .Err(f(e)),
        }
    }
    /// Apply `f` (itself `Result`-returning) to the contained `Ok` value, or
    /// return the `Err` unchanged.
    pub fn and_then<U>(consume self, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match self {
            .Ok(v) => f(v),
            .Err(e) => .Err(e),
        }
    }
    /// Return the result unchanged if it is `Ok`, otherwise the result
    /// computed by `f` from the error.
    pub fn or_else<F>(consume self, f: fn(E) -> Result<T, F>) -> Result<T, F> {
        match self {
            .Ok(v) => .Ok(v),
            .Err(e) => f(e),
        }
    }
}

// Methods that print the error.
impl<T, E: Display> Result<T, E> {
    /// Unwrap the `Ok` value. On `Err(e)` the program traps with
    /// `{reason}: {e}`: the reason says why success was expected, and the
    /// error says what happened instead.
    pub fn expect(consume self, reason: string) -> T {
        match self {
            .Ok(v) => v,
            .Err(e) => panic(f"{reason}: {e}"),
        }
    }
}

// Methods that need the error to describe itself.
impl<T, E: Error> Result<T, E> {
    /// Say what the caller was doing when the operation failed. `Ok` passes
    /// through; `Err(e)` becomes the message `"{doing}: {e}"` erased to
    /// `dyn Error`.
    pub fn context(consume self, doing: string) -> Result<T, dyn Error> {
        match self {
            .Ok(value) => .Ok(value),
            .Err(e) => .Err(f"{doing}: {e}"),
        }
    }
}
