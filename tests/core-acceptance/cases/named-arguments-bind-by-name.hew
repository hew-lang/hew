// Named arguments bind to the parameter they name, in any order, and the
// source still evaluates them left to right as written.
import std.string;

fn sub(a: i64, b: i64) -> i64 { a - b }

fn trace(label: string, value: i64) -> i64 {
    println(f"eval {label}");
    value
}

fn span(start: i64, end: i64) -> string { f"{start}..{end}" }

fn pick<T>(first: T, second: T) -> T { second }

type Card { h: i64 }

impl Card {
    fn describe(self, prefix: string, suffix: string) -> string { f"{prefix}h:{self.h}{suffix}" }
}

type Counter { total: i64 }

impl Counter {
    fn add(var self, amount: i64, times: i64) { self.total = self.total + amount * times; }
}

trait Shape {
    fn scaled(self, factor: i64, offset: i64) -> i64;
}

type Square { side: i64 }

impl Shape for Square {
    fn scaled(self, factor: i64, offset: i64) -> i64 { self.side * factor - offset }
}

fn through_bound<T: Shape>(shape: T) -> i64 { shape.scaled(offset: 1, factor: 10) }

fn through_dyn(shape: dyn Shape) -> i64 { shape.scaled(offset: 1, factor: 10) }

fn main() {
    println(sub(b: 3, a: 10));
    println(sub(10, b: 3));
    println(sub(10, 3));
    println(span(end: trace("end", 9), start: trace("start", 2)));
    println(pick(second: "b", first: "a"));
    let card = Card { h: 1 };
    println(card.describe(suffix: "]", prefix: "["));
    var counter = Counter { total: 0 };
    counter.add(times: 3, amount: 2);
    println(counter.total);
    let square = Square { side: 2 };
    println(square.scaled(offset: 1, factor: 10));
    println(through_bound(square));
    println(through_dyn(Square { side: 2 }));
    println(string.pad_left(pad: "*", width: 5, s: "ab"));
}
