//! Regression coverage for owned resource payloads bound by conditional patterns.

import std.stream;
import std.testing;

/// The conditional patterns below all bind one owned `Sink` out of a `Result`.
/// The paired `Stream` stays with the caller, so what the arm did with the
/// sink is observable as the text the stream collects.
fn opened(consume sink: stream.Sink<string>) -> Result<stream.Sink<string>, string> {
    Ok(sink)
}

#[test]
fn test_if_let_resource_can_close_explicitly() {
    let (writer, input): (stream.Sink<string>, stream.Stream<string>) = stream.pipe(4).expect("pipe");
    if let .Ok(sink) = opened(writer) {
        sink.send("rc1").expect("send");
        sink.close();
    }
    testing.assert_eq_str(input.collect(), "rc1");
}

#[test]
fn test_if_let_resource_empty_body_drops_at_scope_exit() {
    let (writer, input): (stream.Sink<string>, stream.Stream<string>) = stream.pipe(4).expect("pipe");
    if let .Ok(sink) = opened(writer) {}
    testing.assert_eq_str(input.collect(), "");
}

#[test]
fn test_match_resource_can_close_explicitly() {
    let (writer, input): (stream.Sink<string>, stream.Stream<string>) = stream.pipe(4).expect("pipe");
    match opened(writer) {
        .Ok(sink) => {
            sink.send("match").expect("send");
            sink.close();
        },
        .Err(_) => panic("expected a sink"),
    }
    testing.assert_eq_str(input.collect(), "match");
}

#[test]
fn test_while_let_resource_can_close_explicitly() {
    let (writer, input): (stream.Sink<string>, stream.Stream<string>) = stream.pipe(4).expect("pipe");
    while let .Ok(sink) = opened(writer) {
        sink.send("while").expect("send");
        sink.close();
        break;
    }
    testing.assert_eq_str(input.collect(), "while");
}

type Endpoint { host: string, port: i64 }

enum ParseError {
    Invalid(string),
}

fn parse_error_message(e: ParseError) -> string {
    match e {
        ParseError.Invalid(detail) => f"invalid: {detail}",
    }
}

fn try_parse(addr: string) -> Result<Endpoint, ParseError> {
    if addr == "" {
        return Err(ParseError.Invalid("empty address"))
    }
    Ok(Endpoint { host: addr, port: 7 })
}

/// Both arms of this match bind a payload out of ONE scrutinee mint. The
/// obligation checker folds every payload discharge back onto that mint, so
/// granting a second arm's binder its own scope-close release over-releases the
/// scrutinee. Guards the `std.net` connect surface, which lowers to this shape.
fn describe_endpoint(addr: string) -> string {
    let Endpoint { host, port } = match try_parse(addr) {
        .Ok(endpoint) => endpoint,
        .Err(err) => {
            panic(f"describe_endpoint failed: {parse_error_message(err)}");
            Endpoint { host: "", port: 0 }
        },
    };
    f"{host}:{port}"
}

#[test]
fn test_match_payload_binders_share_one_scrutinee_release() {
    testing.assert_eq_str(describe_endpoint("localhost"), "localhost:7");
}

fn sink_from_if_let(consume writer: stream.Sink<string>) -> Result<stream.Sink<string>, string> {
    if let .Ok(sink) = opened(writer) {
        return Ok(sink);
    }
    Err("open failed")
}

#[test]
fn test_if_let_resource_can_be_returned() {
    let (writer, input): (stream.Sink<string>, stream.Stream<string>) = stream.pipe(4).expect("pipe");
    match sink_from_if_let(writer) {
        .Ok(sink) => {
            sink.send("returned").expect("send");
            sink.close();
        },
        .Err(_) => panic("expected a sink"),
    }
    testing.assert_eq_str(input.collect(), "returned");
}
