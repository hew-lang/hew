import std.stream;

fn ready() -> i64 {
    7
}

fn pending() -> i64 {
    sleep(10s);
    9
}

fn success() -> Result<i64, string> {
    .Ok(11)
}

fn failure() -> Result<i64, string> {
    .Err("ordinary error")
}

fn joined() -> i64 fails string {
    let task = fork success();
    await task?
}

fn failed_group() -> i64 fails string {
    await race [
        failure(),
    ]?
}

fn notify(done: stream.Sink<i64>) -> i64 {
    done.send(7).expect("ready notification");
    7
}

fn main() {
    let (done, notified): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("pipe");
    let completed = fork notify(done);
    println(notified.recv().expect("completed notification"));
    let group = race [
        completed,
        pending(),
    ];
    println("created");
    println(await group);
    let nested = race [
        race [
            ready(),
            pending(),
        ],
        pending(),
    ];
    println(await nested);
    scope {
        let _ = race [
            ready(),
            pending(),
        ];
        println("background");
    };
    println("joined");
    println(joined().expect("joined result"));
    match failed_group() {
        .Ok(value) => println(value),
        .Err(message) => println(message),
    }
}
