// Retained future semantic fixture for a unit-returning suspending closure.
// `read_once` awaits a captured Connection and discards the read value. Once
// function types carry suspension metadata, this will exercise the closure
// driver's unit-result cleanup path. Today invocation sites cannot select that
// driver safely, so MIR deliberately rejects this fixture with `suspension
// inside a closure` before code generation.
import std.net.{Listener};

extern "C" {
    fn hew_tcp_listener_local_port(listener: Listener) -> i32;
}

actor Reader {
    let addr: string;
    receive fn go(unused: i64) {
        sleep(200ms);
        let conn = net.connect(addr);
        let read_once = || {
            let _ = await conn.read_string();
        };
        read_once();
        println("reader-unit-done");
        let _ = conn.close();
    }
}

fn main() {
    let listener = net.listen("127.0.0.1:0");
    let port = unsafe {
        hew_tcp_listener_local_port(listener)
    };
    let reader = spawn Reader(addr: f"127.0.0.1:{port}");
    reader.go(0);
    let client = listener.accept();
    let _ = client.write_string("hello-from-server");
    sleep(500ms);
    let _ = client.close();
    println("server-done");
}
