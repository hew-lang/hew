//! Legacy fallible-close declarations awaiting alignment with resource cleanup.
//!
//! The resource contract uses `fn close(consume self)` returning unit. Scope
//! exit releases the resource automatically; explicit close consumes it early.
//! Operations that can fail, such as flushing or finishing a protocol exchange,
//! belong in a separate fallible operation before cleanup, when the type provides
//! one. Check that operation's result before releasing the resource.
//!
//! Implementation gap: the trait below still declares a Result-returning close.
//! It is not the template for new resource types.

import std.fs;

/// Legacy trait whose fallible signature is pending migration.
/// Use a consuming, unit-returning close for resource cleanup.
pub trait Closable {
    /// Legacy fallible release signature; see the module's implementation gap.
    fn close(val: Self) -> Result<(), CloseError>;
}

/// Error carried by the legacy fallible-close trait.
/// This is not the error contract for automatic resource cleanup.
pub enum CloseError {
    /// The close failed with an underlying I/O error.
    Io(fs.IoError),
    /// The resource was already closed before this call.
    ///
    AlreadyClosed,
}

impl Display for CloseError {
    fn fmt(err: CloseError) -> string {
        match err {
            CloseError.Io(e) => f"{e}",
            CloseError.AlreadyClosed => "the resource was already closed",
        }
    }
}
