import std.fs;

fn failed(path: string) -> bool {
    match fs.read(path) {
        .Ok(_) => false,
        .Err(_) => true,
    }
}

fn main() -> i64 {
    if !failed("resource-missing.bin") { return 1; }
    if !failed("resource-invalid.bin") { return 2; }
    if !failed(".") { return 3; }
    match fs.read("resource-empty.bin") {
        .Ok(text) => { if text != "" { return 4; } },
        .Err(_) => return 5,
    }
    match fs.read("resource-nul.bin") {
        .Ok(text) => { if text != "a\0b" { return 6; } },
        .Err(_) => return 7,
    }
    println("read results");
    0
}
