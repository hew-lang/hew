// A `scope { fork ... }` body inside an actor handler forks a free function
// and joins it before the scope returns, so the child's output always
// precedes the handler's.

fn worker() {
    println("worker ran");
}

actor _Driver {
    receive fn drive() {
        scope {
            fork { worker(); }
        };
        println("scope joined");
    }
}

fn main() -> i64 {
    let d = spawn _Driver;
    let _ = d.drive();
    0
}
