//! Multiple TCP readers using ordinary `conn.read()` calls.
//! Each reader must run concurrently with the server that supplies its data;
//! completion calls in the launch loop need review before running this demo.

import std.encoding.utf8;

import std.net;

const READER_COUNT: i64 = 4;

actor Reader {
    let id: i64,
    let port: string,

    receive fn go(unused: i64) {
        sleep(150ms);
        let conn = match net.connect(f"127.0.0.1:{port}") {
            .Ok(conn) => conn,
            .Err(_) => panic(f"network setup failed"),
        };
        let body = utf8.decode(conn.read()) handle error {
            println(f"invalid UTF-8: {error}");
            return;
        };
        println(f"reader-{id}-got: {body}");
        let _ = conn.close();
    }
}

fn main() {
    let listener = match net.listen("127.0.0.1:18078") {
        .Ok(listener) => listener,
        .Err(_) => panic(f"network setup failed"),
    };
    var i = 0;
    while i < READER_COUNT {
        let r = spawn Reader(id: i, port: "18078");
        let _ = r.go(0);
        i = i + 1;
    }
    var accepted = 0;
    while accepted < READER_COUNT {
        let client = listener.accept();
        let _ = client.write_string(f"payload-{accepted}");
        accepted = accepted + 1;
    }
    sleep(800ms);
    println("server-done");
}
