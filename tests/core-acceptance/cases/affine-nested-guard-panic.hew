enum Choice { Values(Generator<string, ()>, i64), Empty }

gen fn words(label: string) -> string {
    defer println(label + " cleaned");
    yield label;
    yield "later";
}

fn started(label: string) -> Generator<string, ()> {
    let values = words(label);
    match await values.next() { .Some(value) => println(value), .None => panic("empty"), }
    values
}

fn check(weight: i64) -> bool {
    if weight > 0 {
        panic("guard failure");
    }
    true
}

fn choose(consume choice: Option<Choice>) -> string {
    match choice {
        .Some(.Values(values, 0)) => "zero",
        .Some(.Values(values, weight)) if check(weight) => "checked",
        .Some(.Values(values, _)) => "fallback",
        .Some(.Empty) => "empty",
        .None => "none",
    }
}

fn main() {
    let label = "main".to_upper();
    defer println(label + " cleaned");
    println(await choose(Some(Choice.Values(await started("guarded"), 3))));
    println("unreachable");
}
