        ""
    }
    #[extern_symbol(hew_string_to_lowercase)]
    fn to_lower(self) -> string {
        ""
    }
    #[extern_symbol(hew_string_trim)]
    fn trim(self) -> string {
        ""
    }
    #[extern_symbol(hew_string_clone)]
    fn clone(self) -> string {
        ""
    }
    #[extern_symbol(hew_string_replace)]
    fn replace(self, from: string, to: string) -> string {
        ""
    }
    #[extern_symbol(hew_string_split)]
    fn split(self, sep: string) -> Vec<string> {
        Vec.new()
    }
    #[extern_symbol(hew_string_lines)]
    fn lines(self) -> Vec<string> {
        Vec.new()
    }
    #[extern_symbol(hew_string_find)]
    fn find(self, needle: string) -> Option<i64> {
        .None
    }
    #[extern_symbol(hew_string_find_from)]
    fn find_from(self, needle: string, start: i64) -> Option<i64> {
        .None
    }
    #[extern_symbol(hew_string_repeat)]
    fn repeat(self, n: i64) -> string {
        ""
    }
    #[extern_symbol(hew_string_get)]
    fn get(self, index: i64) -> Option<char> {
        .None
    }
    #[extern_symbol(hew_string_to_bytes)]
    fn to_bytes(self) -> bytes {
        bytes.new()
    }
    #[extern_symbol(hew_string_push)]
    fn push(self, value: char) {}
    #[extern_symbol(hew_string_clear)]
    fn clear(self) {}
}

// ── Trait: ToString ──────────────────────────────────────────────────
/// Trait for types that can be converted to a string representation.
///
/// Provides a standard interface for string conversion across modules.
///
/// # Examples
///
/// ```
/// import std.string;
///
/// // Implement for custom types:
/// // impl ToString for MyType {
/// //     fn to_str(m: MyType) -> string { ... }
/// // }
/// ```
pub trait ToString {
    /// Convert this value to its string representation.
    fn to_str(self) -> string;
}
