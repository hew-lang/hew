//! Two-module same-name generic layout oracle, right module.
//!
//! Declares a generic value record `Key<T>` whose sole field `v` is `string`
//! — the same bare name as `hew::keyleft`'s `Key<T>` (whose `v` is `i64`).
//! Each instantiation must reach codegen under its own module-qualified
//! layout symbol (`hew$keyright$Key$$i32`), never a shared bare `Key$$i32`;
//! the fixture `two_module_same_generic_valueclass_accept` pins both symbols.

/// Generic value record with a string payload field.
pub type Key<T> {
    v: string;
}

/// Build a `Key<T>` from a string.
pub fn mk<T>(x: string) -> Key<T> {
    Key { v: x }
}
