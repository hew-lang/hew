type Node { id: i64, }

fn frame(seed: i64) -> Result<Rc<Node>, string> {
    let shared: Rc<Node> = Rc.new(Node { id: seed });
    .Ok(shared)
}

fn main() -> i64 {
    var total: i64 = 0;
    for seed in 0..50 {
        let held = frame(seed);
        match held.is_ok() {
            true => { total = total + 1; }
            false => { }
        }
        println("frame");
    }
    total - 50
}
