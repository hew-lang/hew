// Machines are pure value evaluators and cannot carry resource identity.
#[resource]
type Handle {
    fd: i64,
}

impl Handle {
    fn close(consume self) {
        println(f"CLOSE fd={self.fd}");
    }
}

machine Session {
    events {
        Open,
        UseIt,
    }

    state Idle,
    state Active { h: Handle, },

    on Open: Idle => Active { h: Handle { fd: 42 } }
    on UseIt: Active => Active reenter { h: state.h }

    default { state }
}

fn main() {
    var s = Session.Idle;
    let _ = s.step(SessionEvent.Open);
    for i in 0 .. 3 {
        let _ = s.step(SessionEvent.UseIt);
    }
}
