actor Worker {
    receive fn ping() {}
    receive fn instance() -> Worker { this }
    receive fn crash() { panic("restart identity"); }
}

supervisor Inner {
    child worker: Worker;
}

supervisor Group {
    child first: Worker;
    child second: Worker;
    child inner: Inner;
}

fn same(left: Worker, right: Worker) -> bool {
    left is right
}

fn main() {
    let first = spawn Worker;
    let second = spawn Worker;
    let alias = first;
    assert(same(first, alias));
    assert(!(first is second));
    let compare = |left, right| left is right;
    assert(compare(alias, first));
    let group = spawn Group;
    let other = spawn Group;
    let role: Worker = group.first;
    let nested: Inner = group.inner;
    assert(nested is group.inner);
    let nested_occupant = nested.worker.instance().expect("nested occupant");
    assert(role is group.first);
    assert(!(role is group.second));
    assert(!(role is other.first));
    let occupant = role.instance().expect("current occupant");
    assert(!(role is occupant));
    assert(!(occupant is role));
    let _ = role.crash();
    restarted(role);
    assert(role is group.first);
    let replacement = role.instance().expect("replacement occupant");
    assert(!(occupant is replacement));
    assert(!(role is replacement));
    assert(nested_occupant is nested.worker.instance().expect("actor restart leaves nested role alone"));
    stop(nested);
    restarted(nested);
    assert(nested is group.inner);
    assert(replacement is role.instance().expect("nested restart leaves actor role alone"));
    assert(!(nested_occupant is nested.worker.instance().expect("nested replacement")));
    restarted(first); // Direct incarnations have no role replacement to settle.
    stop(first);
    stopped(first);
    stop(second);
    stopped(second);
    stop(group);
    stopped(group);
    stop(other);
    stopped(other);
    println("identity preserved");
}
