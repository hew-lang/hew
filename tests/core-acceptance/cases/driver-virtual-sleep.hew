// A minute of sleeping on the deterministic driver's virtual clock returns
// at once; the case's hang guard is far shorter than the sleep.
import std.time.datetime;

fn main() {
    let start = instant.now();
    assert(datetime.now_ms() == 1767225600000);
    assert(datetime.now_nanos() == 0);
    sleep(60s);
    assert(datetime.now_ms() == 1767225660000);
    assert(datetime.now_nanos() == 60000000000);
    println(start.elapsed() >= 60s);
}
