import std.failure;
actor Worker {
    var label: string = "initial",
    receive fn rename(value: string) { label = value; }
    receive fn get() -> string { label }
    receive fn fail() { label = label + "!"; panic("crash incarnation"); }
    #[on(crash)] fn crashed(info: failure.CrashInfo) -> failure.CrashAction {
        assert(label == "CHANGED!");
        assert(info.code != 0);
        println(label);
        failure.CrashAction.Restart
    }
}
supervisor Group { intensity: 1 within 60s, child worker: Worker, }
fn main() {
    let group = spawn Group;
    group.worker.rename("changed".to_upper()).expect("rename");
    let _ = group.worker.fail();
    let _ = await_restart group.worker;
    assert(group.worker.get().expect("fresh") == "initial");
    close(group);
    println("last valid crash state, fresh restart");
}
