    site=s250 ty=i64 value_class=BitCopy intent=Read strategy=BorrowRead why="first vertical-slice classifier"
    site=s251 ty=duration value_class=BitCopy intent=Read strategy=BorrowRead why="first vertical-slice classifier"
  blocks:
    id=0 kind=normal
      successor: none
    id=1 kind=normal
      successor: none
    id=2 kind=normal
      successor: none
    id=3 kind=cleanup
      successor: none
  drop_plans:
    branch[bb0: bb1/bb2] ->
      (none)
    panic[bb1] ->
      (none)
    return[bb2] ->
      (none)

