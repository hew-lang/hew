// Two anonymous children each execute a multi-statement body, and the bodies
// overlap: every child reaches its blocking read before the parent releases
// any of them. The parent reads both children's `ready` before it writes a
// single `finish`, so a runtime that ran the bodies one after another would
// deadlock on the second read rather than print a different order.
//
// Every printed marker is sequenced by the parent, so the output is exact:
// the child prints its end marker and then answers `done`, and the parent
// waits for that answer before releasing the next child.
import std.net;

actor Driver {
    receive fn run() -> i64 {
        let first_listener = match net.listen("127.0.0.1:0") {
            .Ok(listener) => listener,
            .Err(_) => return 1,
        };
        let second_listener = match net.listen("127.0.0.1:0") {
            .Ok(listener) => listener,
            .Err(_) => return 1,
        };
        let first_addr = f"127.0.0.1:{first_listener.local_port()}";
        let second_addr = f"127.0.0.1:{second_listener.local_port()}";

        scope {
            fork {
                let conn = first_listener.accept();
                let _ = conn.write_string("ready");
                let _ = conn.read_string();
                println("first-end");
                let _ = conn.write_string("done");
            };
            fork {
                let conn = second_listener.accept();
                let _ = conn.write_string("ready");
                let _ = conn.read_string();
                println("second-end");
                let _ = conn.write_string("done");
            };

            let first_client = match net.connect(first_addr) {
                .Ok(conn) => conn,
                .Err(_) => return 1,
            };
            let second_client = match net.connect(second_addr) {
                .Ok(conn) => conn,
                .Err(_) => return 1,
            };
            let _ = first_client.read_string();
            let _ = second_client.read_string();
            println("both-started");
            let _ = first_client.write_string("finish");
            let _ = first_client.read_string();
            let _ = second_client.write_string("finish");
            let _ = second_client.read_string();
        };
        println("complete");
        0
    }
}

fn main() {
    let driver = spawn Driver;
    match driver.run() {
        .Ok(_) => {},
        .Err(_) => panic("driver failed"),
    }
}
