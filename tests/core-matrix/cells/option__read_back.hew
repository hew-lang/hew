fn main() {
    let x: Option<i64> = Option.Some(5);
    let v: Vec<Option<i64>> = Vec.new();
    v.push(x);
    match v.get(0) {
        Option.Some(e) => {
            match e { Option.Some(e_v) => println(f"some {e_v}"), Option.None => println("none"), }
        },
        Option.None => println("missing"),
    }
}
