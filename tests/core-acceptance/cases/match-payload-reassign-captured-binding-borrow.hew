enum Box {  Full(Vec<i64>), Empty }
fn main() -> i64 {
    let b = Box.Full(seed());
    let f = || -> i64 {
        match b {
            Box.Full(v) => v.len(),
            Box.Empty => 0,
        }
    };
    f()
}

fn seed() -> Vec<i64> {
    var v: Vec<i64> = Vec.new();
    v.push(1);
    v.push(2);
    v.push(3);
    v
}
