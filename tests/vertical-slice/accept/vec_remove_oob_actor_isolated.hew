// EXIT: 1
actor VecRemoveCrasher {
    receive fn boom() {
        let xs: Vec<i64> = Vec.new();
        xs.push(1);
        xs.remove(99);
    }
}

actor VecRemoveProbe {
    receive fn ping() -> i64 {
        0
    }
}

fn main() -> i64 {
    let crasher = spawn VecRemoveCrasher;
    let probe = spawn VecRemoveProbe;
    let _ = crasher.boom();
    sleep(300ms);
    match probe.ping() {
        .Ok(v) => v,
        .Err(_) => 1,
    }
}
