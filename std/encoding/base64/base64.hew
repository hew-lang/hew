//! Base64 encoding and decoding — pure Hew implementation.
//!
//! Encode binary data to Base64 strings and decode Base64 strings back
//! to binary data. Supports both standard and URL-safe alphabets.
//!
//! # Examples
//!
//! ```
//! import std.encoding.base64;
//!
//! fn main() {
//!     var data: bytes = bytes.new();
//!     data.push(72);   // H
//!     data.push(105);  // i
//!     let s = base64.encode(data);
//!     println(s);   // "SGk="
//!     let back = base64.decode(s).expect("encoded text is Base64");
//!     println(back.len());  // 2
//!     println(f"{base64.decode("!!!!").is_err()}");  // true
//! }
//! ```

import std.encoding.utf8;

/// Encode binary data to a standard Base64 string.
pub fn encode(data: bytes) -> string {
    encode_impl(data, false)
}

/// Encode binary data to a URL-safe Base64 string.
pub fn encode_url(data: bytes) -> string {
    encode_impl(data, true)
}

/// Text that is not Base64.
pub enum DecodeError {
    /// The length cannot hold whole bytes: padded text that is not a multiple
    /// of four characters, or one character left after the last full group.
    InvalidLength(i64);
    /// The character at `index` is not in the Base64 alphabet.
    InvalidCharacter { index: i64; text: string; }
}

impl Error for DecodeError {}

/// Decode a standard or URL-safe Base64 string to binary data. The empty
/// string decodes to no bytes; any other text that is not Base64 fails.
pub fn decode(s: string) -> bytes fails DecodeError {
    let slen = s.len();
    var out: bytes = bytes.new();
    if slen == 0 {
        return out;
    }
    let padded = s[slen - 1] == '=';
    if padded && slen % 4 != 0 {
        return error .InvalidLength(slen);
    }
    var end = slen;
    if padded {
        end -= 1;
        if end > 0 && s[end - 1] == '=' {
            end -= 1;
        }
    }
    // Keep the bits left over after each complete output byte.
    var bits: i64 = 0;
    var available = 0;
    for index in 0..end {
        let ch = s[index];
        let value = decode_char(ch) ?? return error .InvalidCharacter { index, text: f"{ch}" };
        bits = (bits << 6) | value;
        available += 6;
        if available >= 8 {
            available -= 8;
            out.push((bits >> available) as u8);
            bits = bits & ((1 << available) - 1);
        }
    }
    if end % 4 == 1 {
        return error .InvalidLength(slen);
    }
    out
}

// ── Internal helpers ─────────────────────────────────────────────────
/// Map a 6-bit index (0–63) to its Base64 ASCII code.
///
/// RFC 4648 §4 (standard): A–Z, a–z, 0–9, '+', '/'
/// RFC 4648 §5 (URL-safe):  A–Z, a–z, 0–9, '-', '_'
fn b64_char(idx: i32, url_safe: bool) -> i32 { // INTERNAL-ABI: byte-level 6-bit index arithmetic; values 0-127 fit i32
    if idx < 26 {
        return 65 + idx;
    } // A-Z
    if idx < 52 {
        return 97 + idx - 26;
    } // a-z
    if idx < 62 {
        return 48 + idx - 52;
    } // 0-9
    if idx == 62 {
        if url_safe {
            return 45;
        } // '-'
        return 43; // '+'
    }
    if url_safe {
        return 95;
    } // '_'
    47 as i32 // '/'
}

/// Encode binary data to a Base64 string using the standard or URL-safe alphabet.
fn encode_impl(data: bytes, url_safe: bool) -> string {
    let dlen = data.len();
    var out: bytes = bytes.new();
    var i = 0;
    // Process complete 3-byte groups
    while i + 3 <= dlen {
        let a = data[i];
        let b = data[i + 1];
        let c = data[i + 2];
        out.push(b64_char(a as i32 >> 2, url_safe) as u8);
        out.push(b64_char((a as i32 & 3) << 4 | b as i32 >> 4, url_safe) as u8);
        out.push(b64_char((b as i32 & 15) << 2 | c as i32 >> 6, url_safe) as u8);
        out.push(b64_char(c as i32 & 63, url_safe) as u8);
        i = i + 3;
    }
    // Handle remaining bytes (always pad with '=')
    let remaining = dlen - i;
    if remaining == 1 {
        let a = data[i];
        out.push(b64_char(a as i32 >> 2, url_safe) as u8);
        out.push(b64_char((a as i32 & 3) << 4, url_safe) as u8);
        out.push(61); // '='
        out.push(61);
    } else if remaining == 2 {
        let a = data[i];
        let b = data[i + 1];
        out.push(b64_char(a as i32 >> 2, url_safe) as u8);
        out.push(b64_char((a as i32 & 3) << 4 | b as i32 >> 4, url_safe) as u8);
        out.push(b64_char((b as i32 & 15) << 2, url_safe) as u8);
        out.push(61); // '='
    }
    utf8.decode(out) handle error {
        panic("Base64 encoder produces ASCII");
    }
}

fn decode_char(ch: char) -> Option<i64> {
    let code = ch as i64;
    if ch >= 'A' && ch <= 'Z' {
        return .Some(code - ('A' as i64));
    }
    if ch >= 'a' && ch <= 'z' {
        return .Some(code - ('a' as i64) + 26);
    }
    if ch >= '0' && ch <= '9' {
        return .Some(code - ('0' as i64) + 52);
    }
    match ch {
        '+' | '-' => .Some(62),
        '/' | '_' => .Some(63),
        _ => .None,
    }
}
