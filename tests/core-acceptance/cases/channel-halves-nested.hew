// A pipe half is an ordinary value: it rides in a record field and in a
// Vec, is used from there, and is closed exactly once. Before the endpoint had
// one spelling, a half stored in either container failed physical lowering
// because the declared member type and the constructor's own result keyed
// different glue recipes for the same pointer word.
import std.stream;

type Halves {
    tx: stream.Sink<string>,
    rx: stream.Stream<string>,
}

fn main() {
    let (tx, rx) = match stream.pipe(4) {
        .Ok(pair) => pair,
        .Err(error) => {
            println(error);
            return;
        },
    };
    let pair = Halves { tx: tx, rx: rx };
    pair.tx.send("through a record").expect("send");
    pair.tx.close();
    match pair.rx.recv() {
        .Some(item) => println(f"record {item}"),
        .None => println("record closed"),
    }
    match pair.rx.recv() {
        .Some(item) => println(f"record {item}"),
        .None => println("record closed"),
    }
    pair.rx.close();

    let (producer, consumer) = match stream.pipe(2) {
        .Ok(pair) => pair,
        .Err(error) => {
            println(error);
            return;
        },
    };
    var senders: Vec<stream.Sink<string>> = [];
    senders.push(producer);
    let stored = senders.pop();
    stored.send("through a vec").expect("send");
    stored.close();
    match consumer.recv() {
        .Some(item) => println(f"vec {item}"),
        .None => println("vec closed"),
    }
    consumer.close();
}
