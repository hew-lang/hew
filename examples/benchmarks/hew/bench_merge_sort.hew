fn merge(var v: Vec<i64>, left: i64, mid: i64, right: i64) -> Vec<i64> {
    var left_arr: Vec<i64> = Vec.new();
    var right_arr: Vec<i64> = Vec.new();
    var i = left;
    while i <= mid {
        left_arr.push(v[i]);
        i = i + 1;
    }
    i = mid + 1;
    while i <= right {
        right_arr.push(v[i]);
        i = i + 1;
    }
    var li = 0;
    var ri = 0;
    var k = left;
    let left_len = left_arr.len();
    let right_len = right_arr.len();
    while li < left_len {
        if ri < right_len {
            if left_arr[li] <= right_arr[ri] {
                v.set(k, left_arr[li]);
                li = li + 1;
            } else {
                v.set(k, right_arr[ri]);
                ri = ri + 1;
            }
        } else {
            v.set(k, left_arr[li]);
            li = li + 1;
        }
        k = k + 1;
    }
    while ri < right_len {
        v.set(k, right_arr[ri]);
        ri = ri + 1;
        k = k + 1;
    }
    v
}

fn merge_sort_range(var v: Vec<i64>, left: i64, right: i64) -> Vec<i64> {
    if left < right {
        let mid = left + (right - left) / 2;
        v = merge_sort_range(v, left, mid);
        v = merge_sort_range(v, mid + 1, right);
        v = merge(v, left, mid, right);
    }
    v
}

fn merge_sort(var v: Vec<i64>) -> Vec<i64> {
    let n = v.len();
    if n > 1 {
        v = merge_sort_range(v, 0, n - 1);
    }
    v
}

fn make_test_array() -> Vec<i64> {
    var v: Vec<i64> = Vec.new();
    var i = 100;
    while i > 0 {
        v.push(i);
        i = i - 1;
    }
    v
}

const ITERS: i64 = 100000;

fn main() {
    for i in 0 .. ITERS {
        let v = make_test_array();
        let _ = merge_sort(v);
    }
    println(ITERS);
}
