//! Operating system interfaces.
//!
//! Access command-line arguments, environment variables, system
//! information and termination requests.
//!
//! # Examples
//!
//! ```
//! import std.os;
//!
//! fn main() {
//!     let arguments = os.args();
//!     match arguments.get(0) {
//!         .Some(first) => println(first),
//!         .None => println("no program argument"),
//!     }
//!     let home = os.home_dir();
//!     println(home);
//! }
//! ```

import std.stream;

/// Return all command-line arguments, including the program name.
///
/// # Examples
///
/// ```
/// import std.os;
///
/// fn main() {
///     let arguments = os.args();
///     match arguments.get(0) {
///         .Some(program) => println(program),
///         .None => println("no program argument"),
///     }
/// }
/// ```
pub fn args() -> Vec<string> {
    let count = unsafe {
        hew_args_count() as i64
    };
    var values: Vec<string> = Vec.new();
    for index in 0..count {
        let value = unsafe {
            hew_args_get(index as i32)
        };
        values.push(value);
    }
    values
}

/// Get the value of an environment variable.
///
/// Returns `None` if the variable is not set.
///
/// # Examples
///
/// ```
/// import std.os;
///
/// fn main() {
///     let path = os.env("PATH");
/// }
/// ```
pub fn env(name: string) -> Option<string> {
    unsafe {
        if hew_env_has(name) {
            .Some(hew_env_get(name))
        } else {
            .None
        }
    }
}

/// Invalid environment-variable name.
pub enum EnvError {
    InvalidName(string);
}

impl Display for EnvError {
    fn fmt(self) -> string {
        match self {
            EnvError.InvalidName(name) => f"invalid environment variable name: `{name}`",
        }
    }
}

/// Set an environment variable for the current process.
///
/// Environment names must be non-empty and cannot contain `=`.
pub fn set_env(name: string, value: string) -> Result<(), EnvError> {
    if name == "" || name.contains("=") {
        return .Err(EnvError.InvalidName(name));
    }
    unsafe {
        if hew_env_set(name, value) == 0 {
            .Ok(())
        } else {
            .Err(EnvError.InvalidName(name))
        }
    }
}

/// Remove an environment variable.
///
/// Environment names must be non-empty and cannot contain `=`.
pub fn remove_env(name: string) -> Result<(), EnvError> {
    if name == "" || name.contains("=") {
        return .Err(EnvError.InvalidName(name));
    }
    unsafe {
        if hew_env_remove(name) == 0 {
            .Ok(())
        } else {
            .Err(EnvError.InvalidName(name))
        }
    }
}

/// Check whether an environment variable is set.
pub fn has_env(name: string) -> bool {
    unsafe {
        hew_env_has(name)
    }
}

/// Returns the current working directory.
pub fn cwd() -> string {
    unsafe {
        hew_cwd()
    }
}

/// Returns the user's home directory.
pub fn home_dir() -> string {
    unsafe {
        hew_home_dir()
    }
}

/// Returns the system hostname.
pub fn hostname() -> string {
    unsafe {
        hew_hostname()
    }
}

/// Returns the current process ID.
pub fn pid() -> i64 {
    unsafe {
        hew_pid() as i64
    }
}

/// Returns the system temporary directory path.
///
/// Uses the platform-appropriate temp directory (e.g. `/tmp` on Unix,
/// `%TEMP%` on Windows). Trailing separators are stripped.
///
/// # Examples
///
/// ```
/// import std.os;
///
/// fn main() {
///     let tmp = os.temp_dir();
///     let path = tmp + "/myfile.txt";
/// }
/// ```
pub fn temp_dir() -> string {
    unsafe {
        hew_temp_dir()
    }
}

/// Receive the process's termination requests: SIGTERM and SIGINT on Unix,
/// Ctrl-C, Ctrl-Break and console close on Windows.
///
/// Each request delivers one `()`; requests that arrive before the next
/// receive coalesce into one. While any such stream is open, a request no
/// longer starts runtime shutdown: the program decides when to stop, and
/// returning from `main` drains its actors as usual. Closing every stream
/// restores the default reaction (spec §5.9). The stream never ends on its
/// own, and it is a `select` source. Windows ends the process as soon as a
/// console close request is handed over, so the program cannot rely on acting
/// on that one; Ctrl-C and Ctrl-Break leave it running.
///
/// # Examples
///
/// ```hew,no_run
/// import std.os;
///
/// fn main() {
///     let stop = os.shutdown_signal();
///     var ticks = 0;
///     loop {
///         let stopping = select {
///             request from stop.recv() => true,
///             after 10ms => false,
///         };
///         ticks += 1;
///         if stopping || ticks == 3 {
///             break;
///         }
///     }
///     println(f"stopped after {ticks} ticks");
/// }
/// ```
pub fn shutdown_signal() -> stream.Stream<()> {
    unsafe {
        let pair = hew_shutdown_signal_stream();
        if !hew_stream_pair_is_valid(pair) {
            panic(f"shutdown_signal: {hew_stream_last_error()}");
        }
        let requests: stream.Stream<()> = stream.pair_stream(pair);
        pair.close();
        requests
    }
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    fn hew_shutdown_signal_stream() -> stream.StreamPair;
    fn hew_stream_pair_is_valid(pair: stream.StreamPair) -> bool;
    fn hew_stream_last_error() -> string;
    fn hew_args_count() -> i32;
    fn hew_args_get(index: i32) -> string;
    fn hew_env_get(name: string) -> string;
    fn hew_env_set(name: string, value: string) -> i32;
    fn hew_env_remove(name: string) -> i32;
    fn hew_env_has(name: string) -> bool;
    fn hew_cwd() -> string;
    fn hew_home_dir() -> string;
    fn hew_hostname() -> string;
    fn hew_pid() -> i32;
    fn hew_temp_dir() -> string;
}
