import std.process;

import std.os;

import std.io;

import std.fs;

import "../fixtures/process-probe.hew" as process_probe;

fn reaped(marker: string) {
    let pid = fs.read(marker).expect("child wrote its PID");
    assert(!process_probe.alive(pid));
    fs.delete(marker).expect("remove PID marker");
}

fn command(program: string, args: Vec<string>) -> process.Command {
    var command = process.command(program, args);
    command.stdin = process.Stdio.Null;
    command
}

fn invalid(command: process.Command, limits: process.CaptureLimits) {
    match command.output(limits) {
        .Err(.InvalidArguments(_)) => {}
        _ => panic("invalid capture configuration accepted"),
    }
}

fn main() -> i32 {
    let args = os.args();
    if args.len() > 1 {
        if args[1] == "empty" {
            return 7;
        }
        if args[1] == "exact" {
            io.write("é\0").expect("standard I/O");
            io.write_err("雪").expect("standard I/O");
            return 7;
        }
        fs.write(args[2], f"{os.pid()}").expect("write child PID");
        if args[1] != "silent" {
            let chunk = "雪".repeat(32768);
            for _ in 0..64 {
                if args[1] == "stderr" {
                    io.write_err(chunk).expect("standard I/O");
                } else {
                    io.write(chunk).expect("standard I/O");
                    io.write_err(chunk).expect("standard I/O");
                }
            }
        }
        sleep(30s);
        return 0;
    }
    assert(process_probe.alive(f"{os.pid()}"));
    let executable = args[0];
    let limits = process.CaptureLimits { timeout: 5s, max_output_bytes: 6 };
    var specification = command(executable, ["exact"]);
    specification.stdout = process.Stdio.Null;
    let unchanged = specification;
    let exact = unchanged.output(limits).expect("exact byte budget");
    assert(unchanged.stdout == process.Stdio.Null && unchanged.stderr == process.Stdio.Inherit);
    assert(exact.status == process.ExitStatus.Exited(7));
    assert(exact.stdout == "é\0" && exact.stderr == "雪");
    let empty = command(executable, ["empty"]).output(process.CaptureLimits { timeout: 5s, max_output_bytes: 0 }).expect("zero byte output");
    assert(empty.status == process.ExitStatus.Exited(7));
    assert(empty.stdout == "" && empty.stderr == "");
    match command(executable, ["exact"]).output(process.CaptureLimits { timeout: 5s, max_output_bytes: 5 }) {
        .Err(.OutputLimitExceeded(limit)) => assert(limit == 5),
        _ => panic("combined raw byte budget was not enforced"),
    }
    println("raw bytes counted across both pipes; exit status retained");
    let marker = f"{os.temp_dir()}/hew-process-bounded-{os.pid()}";
    for mode in ["both", "stderr"] {
        match command(executable, [mode, marker]).output(process.CaptureLimits { timeout: 5s, max_output_bytes: 4096 }) {
            .Err(.OutputLimitExceeded(limit)) => assert(limit == 4096),
            _ => panic("output flood did not hit the byte budget"),
        }
        reaped(marker);
    }
    println("output floods bounded and reaped with either pipe silent");
    let timeout = 500ms;
    match command(executable, ["silent", marker]).output(process.CaptureLimits { timeout, max_output_bytes: 4096 }) {
        .Err(.TimedOut(limit)) => assert(limit == timeout),
        _ => panic("silent child did not hit the runtime limit"),
    }
    reaped(marker);
    println("runtime limit returned after child cleanup");
    let cancelled = scope within 500ms {
        let _ = command(executable, ["silent", marker]).output(process.CaptureLimits { timeout: 10s, max_output_bytes: 4096 });
        false
    } handle failure {
        match failure {
            .Deadline { message } => true,
            .Fault { message } => panic(message),
        }
    };
    assert(cancelled);
    reaped(marker);
    println("outer cancellation reaped the bounded command");
    let never_launch = command(executable, ["silent", marker]);
    invalid(never_launch, process.CaptureLimits { timeout: 0ns, max_output_bytes: 4096 });
    invalid(never_launch, process.CaptureLimits { timeout: duration.from_nanos(-1), max_output_bytes: 4096 });
    invalid(never_launch, process.CaptureLimits { timeout: 5s, max_output_bytes: -1 });
    var piped = never_launch;
    piped.stdin = process.Stdio.Piped;
    invalid(piped, limits);
    assert(!fs.exists(marker));
    println("invalid limits and untaken stdin refused before launch");
    0
}
