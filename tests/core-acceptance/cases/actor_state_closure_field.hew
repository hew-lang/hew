actor Audit {
    receive fn record(id: i64) {
        sleep(1ms);
        println(f"closed {id}");
    }
}

#[resource]
type Ticket {
    audit: Audit;
    id: i64;
}

impl Ticket {
    fn close(consume self) {
        self.audit.record(self.id).expect("audit close");
    }
}

actor Worker {
    var callback: fn(i64) -> i64 = |value: i64| value;
    receive fn apply(value: i64) -> i64 {
        callback(value)
    }
    receive fn configure(audit: Audit) {
        let held = Rc.new(Ticket { audit: audit, id: 5 });
        callback = move |value: i64| {
            assert(held.strong_count() > 0);
            value + 40
        };
    }
}

fn main() {
    let audit = spawn Audit;
    let worker = spawn Worker;
    println(worker.apply(1).expect("default closure"));
    worker.configure(audit).expect("configure closure");
    println(worker.apply(2).expect("capturing closure"));
    {
        let __hew_migrated_actor_895 = worker;
        stop(__hew_migrated_actor_895);
        stopped(__hew_migrated_actor_895);
    };
    println("barrier");
    {
        let __hew_migrated_actor_938 = audit;
        stop(__hew_migrated_actor_938);
        stopped(__hew_migrated_actor_938);
    };
}
