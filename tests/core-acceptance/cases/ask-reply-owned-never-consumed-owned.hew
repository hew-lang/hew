actor Replier {
    let tag: string,
    receive fn fetch() -> string { tag.to_upper() }
}
fn main() -> i64 {
    var i: i64 = 0;
    while i < 400 {
        let a = spawn Replier(tag: "alpha-owned-reply");
        let b = spawn Replier(tag: "beta-owned-reply");
        let r = select {
            reply from a.fetch() => 10,
            reply from b.fetch() => 20,
        };
        let _ = r;
        i = i + 1;
    }
    0
}
