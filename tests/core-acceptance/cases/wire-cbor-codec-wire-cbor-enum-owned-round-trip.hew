#[wire]
type Inner { name: string @1, }
#[wire]
enum Payload { Empty, Full(string, Vec<string>, Inner), }

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        var tags: Vec<string> = Vec.new();
        tags.push("alpha-element");
        tags.push("beta-element");
        let p = Payload.Full("payload-label-value", tags, Inner { name: "inner-owned-name" });
        let raw = p.encode();
        let back = Payload.decode(raw);
        let n = match back { Payload.Empty => 0, Payload.Full(_, _, _) => 1, };
        total = total + n;
        i = i + 1;
    }
    total
}
