actor Worker {
    receive fn fail() {
        panic("boom");
    }
    #[on(crash)]
    fn crashed(info: CrashInfo) -> CrashAction {
        CrashAction.GiveUp
    }
}

supervisor Tree {
    strategy: one_for_one,
    intensity: 3 within 60s,
    child worker: Worker,
}

fn main() {
    let tree = spawn Tree;
    let worker = tree.worker;
    let _ = worker.fail();
    println(match worker.fail() {
        .Err(.Dead) => "killed",
        _ => "unexpected",
    });
    stop(tree);
    stopped(tree);
}
