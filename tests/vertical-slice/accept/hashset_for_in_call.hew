// A call-result HashSet reaches its declared IntoIterator impl with the
// original receiver type. The source call is evaluated once and the cursor
// owns its element snapshot. Elements 10, 20, 30 sum to 60; the count guard
// also rejects an incorrectly empty iteration.
fn make_set() -> HashSet<i64> {
    var s: HashSet<i64> = HashSet.new();
    s.insert(10);
    s.insert(20);
    s.insert(30);
    s
}

pub fn main() -> i64 {
    var total = 0;
    var count = 0;
    for x in make_set() {
        total = total + x;
        count = count + 1;
    }
    if count != 3 {
        return 100 + count;
    }
    total
}
