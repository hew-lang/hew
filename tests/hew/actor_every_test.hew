//! e2e coverage for `#[every(duration)]` periodic receive handlers.
//!
//! A spawned actor's periodic handler must tick without any explicit send
//! (HEW-SPEC-2026 §2.1.2: armed at spawn, repeats until stop, no payload),
//! the handler's state mutation must be observable through a normal ask
//! (ticks serialize through the message loop like any other message), and
//! two instances of the same actor must tick independently.
//!
//! Each test waits for tick counts to be reached rather than for a window of
//! time to pass, so scheduler load delays it but cannot fail it.

actor Pulse {
    var count: i64 = 0,
    #[every(50ms)]
    receive fn tick() {
        count += 1;
    }
    receive fn total() -> i64 {
        count
    }
}

fn total_of(p: Pulse) -> i64 {
    match p.total() {
        .Ok(n) => n,
        .Err(_) => panic("total ask failed"),
    }
}

fn wait_for_ticks(p: Pulse, at_least: i64) {
    while total_of(p) < at_least {
        sleep(10ms);
    }
}

#[test]
fn periodic_handler_ticks_after_spawn() {
    let p = spawn Pulse(count: 0);
    wait_for_ticks(p, 3);
}

#[test]
fn two_instances_tick_independently() {
    // `b` starts from zero after `a` has ticked, and both keep ticking once
    // both exist: the timers are per-instance, not shared across the type.
    let a = spawn Pulse(count: 0);
    wait_for_ticks(a, 3);
    let b = spawn Pulse(count: 0);
    let a_before = total_of(a);
    wait_for_ticks(b, 1);
    wait_for_ticks(a, a_before + 1);
}
