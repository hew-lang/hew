//! Tests for std::string helpers.

import std.string;

fn assert_string_vec_eq(actual: Vec<string>, expected: Vec<string>) {
    assert(actual.len() == expected.len());
    for i in 0..expected.len() {
        assert(actual[i] == expected[i]);
    }
}

fn assert_int_result_eq(actual: Result<i64, string.NumberError>, expected: i64) {
    match actual {
        .Ok(value) => assert(value == expected),
        .Err(error) => {
            panic(f"{error}");
            assert(0 == expected);
        }
    }
}

fn assert_int_result_string_eq(actual: Result<i64, string.NumberError>, expected: string) {
    match actual {
        .Ok(value) => assert(f"{value}" == expected),
        .Err(error) => {
            panic(f"{error}");
            assert("" == expected);
        }
    }
}

fn assert_int_result_err(actual: Result<i64, string.NumberError>, expected: string) {
    match actual {
        .Ok(value) => {
            panic(f"expected Err(\"{expected}\"), got Ok({value})");
            assert(value == 0);
        }
        .Err(error) => assert(f"{error}" == expected),
    }
}

fn assert_float_result_eq(actual: Result<f64, string.NumberError>, expected: f64) {
    match actual {
        .Ok(value) => assert(value == expected),
        .Err(error) => {
            panic(f"{error}");
            assert(expected == 0.0);
        }
    }
}

fn assert_float_result_err(actual: Result<f64, string.NumberError>, expected: string) {
    match actual {
        .Ok(value) => {
            panic(f"expected Err(\"{expected}\"), got Ok({value})");
            assert(value == 0.0);
        }
        .Err(error) => assert(f"{error}" == expected),
    }
}

#[test]
fn test_from_int_formats_positive_and_negative_values() {
    assert(f"{42}" == "42");
    assert(f"{-7}" == "-7");
}

#[test]
fn test_from_float_formats_decimal_values() {
    assert(f"{3.5}" == "3.5");
    assert(f"{-0.25}" == "-0.25");
}

#[test]
fn test_from_bool_formats_boolean_values() {
    assert(f"{true}" == "true");
    assert(f"{false}" == "false");
}

#[test]
fn test_from_char_formats_single_character_strings() {
    assert(f"{(65).try_to_char().expect("valid Unicode scalar")}" == "A");
    assert(f"{(10).try_to_char().expect("valid Unicode scalar")}" == "\n");
}

#[test]
#[should_panic]
fn test_from_char_rejects_i64_max_instead_of_narrowing() {
    f"{(9223372036854775807).try_to_char().expect("valid Unicode scalar")}";
}

#[test]
fn test_to_int_parses_signed_decimal_strings() {
    assert(("12345".to_int() handle _ { -1 }) == 12345);
    assert(("-19".to_int() handle _ { 0 }) == -19);
    assert(("+8".to_int() handle _ { -1 }) == 8);
}

#[test]
fn test_to_int_parses_real_zero_as_ok() {
    // `Ok(0)` proves a genuine zero is distinguishable from a failed parse.
    let z = "0".to_int();
    assert(z.is_ok());
    assert((z handle _ { -1 }) == 0);
}

#[test]
fn test_to_int_returns_error_for_invalid_and_partial_inputs() {
    assert("".to_int().is_err());
    assert("+".to_int().is_err());
    assert("42abc".to_int().is_err());
}

#[test]
fn test_to_int_accepts_i64_bounds() {
    assert_int_result_eq("9223372036854775807".to_int(), 9223372036854775807);
    assert_int_result_string_eq("-9223372036854775808".to_int(), "-9223372036854775808");
}

#[test]
fn test_to_int_rejects_overflow() {
    assert_int_result_err("9223372036854775808".to_int(), "integer literal outside the i64 range: `9223372036854775808`");
    assert_int_result_err("-9223372036854775809".to_int(), "integer literal outside the i64 range: `-9223372036854775809`");
}

#[test]
fn test_to_int_rejects_sign_only_and_partial_parse_inputs() {
    assert_int_result_err("-".to_int(), "invalid number literal: `-`");
    assert_int_result_err("12x".to_int(), "invalid number literal: `12x`");
}

#[test]
fn test_to_float_parses_decimal_and_scientific_literals() {
    assert_float_result_eq("3.125".to_float(), 3.125);
    assert_float_result_eq("1.25e3".to_float(), 1250.0);
    assert_float_result_eq("-2E-2".to_float(), -0.02);
}

#[test]
fn test_to_float_accepts_leading_and_trailing_decimal_forms() {
    assert_float_result_eq(".5".to_float(), 0.5);
    assert_float_result_eq("1.".to_float(), 1.0);
    assert_float_result_eq("+.75".to_float(), 0.75);
}

#[test]
fn test_to_float_returns_error_for_invalid_literals() {
    assert_float_result_err("4.5x".to_float(), "invalid number literal: `4.5x`");
    assert_float_result_err("+".to_float(), "invalid number literal: `+`");
}

#[test]
fn test_to_float_accepts_decimal_and_scientific_literals() {
    assert_float_result_eq("0.5".to_float(), 0.5);
    assert_float_result_eq("6e2".to_float(), 600.0);
    assert_float_result_eq("7E-1".to_float(), 0.7);
}

#[test]
fn test_try_to_float_round_trips_from_float_output() {
    let positive = f"{3.5}";
    let negative = f"{-0.25}";
    assert_float_result_eq(positive.to_float(), 3.5);
    assert_float_result_eq(negative.to_float(), -0.25);
}

#[test]
fn test_to_float_rejects_invalid_literals() {
    assert_float_result_err("1.2.3".to_float(), "invalid number literal: `1.2.3`");
    assert_float_result_err("9e2ms".to_float(), "invalid number literal: `9e2ms`");
    assert_float_result_err("-".to_float(), "invalid number literal: `-`");
}

#[test]
fn test_pad_left_adds_padding_until_width() {
    assert("7".pad_left(3, '0') == "007");
    assert("hello".pad_left(3, '0') == "hello");
}

#[test]
fn test_pad_right_adds_padding_until_width() {
    assert("7".pad_right(3, '0') == "700");
    assert("hello".pad_right(3, '0') == "hello");
}

#[test]
fn test_padding_counts_unicode_characters_not_utf8_bytes() {
    assert("é".pad_left(3, '0') == "00é");
    assert("é".pad_right(3, '0') == "é00");
    assert("hi".pad_left(4, '雪') == "雪雪hi");
    assert("".pad_right(2, '雪') == "雪雪");
}

#[test]
fn test_count_counts_non_overlapping_occurrences() {
    assert("aaaa".count("aa") == 2);
    assert("banana".count("na") == 2);
    assert("hello".count("") == 0);
}

#[test]
fn test_split_splits_and_keeps_trailing_empty_segment() {
    var expected: Vec<string> = Vec.new();
    expected.push("a");
    expected.push("b");
    expected.push("");
    assert_string_vec_eq(("a,b,").split(","), expected);
}

#[test]
fn test_split_empty_separator_returns_codepoints() {
    // split(s, "") splits into one element per Unicode codepoint.
    // "abc" is 3 ASCII codepoints → ["a", "b", "c"].
    var expected: Vec<string> = Vec.new();
    expected.push("a");
    expected.push("b");
    expected.push("c");
    assert_string_vec_eq(("abc").split(""), expected);
}

#[test]
fn test_lines_splits_lf_and_preserves_trailing_empty_line() {
    var expected: Vec<string> = Vec.new();
    expected.push("alpha");
    expected.push("beta");
    expected.push("");
    assert_string_vec_eq(("alpha\nbeta\n").lines(), expected);
}

#[test]
fn test_lines_normalizes_crlf_sequences() {
    var expected: Vec<string> = Vec.new();
    expected.push("alpha");
    expected.push("beta");
    assert_string_vec_eq(("alpha\r\nbeta").lines(), expected);
}

#[test]
fn test_lines_returns_single_empty_line_for_empty_input() {
    var expected: Vec<string> = Vec.new();
    expected.push("");
    assert_string_vec_eq(("").lines(), expected);
}

#[test]
fn test_join_handles_empty_and_single_element_inputs() {
    let empty: Vec<string> = Vec.new();
    assert((empty).join(",") == "");
    var single: Vec<string> = Vec.new();
    single.push("solo");
    assert((single).join(",") == "solo");
}

#[test]
fn test_join_inserts_separator_between_elements() {
    var parts: Vec<string> = Vec.new();
    parts.push("red");
    parts.push("green");
    parts.push("blue");
    assert((parts).join("|") == "red|green|blue");
}

// ── is_ascii boundary tests (regression lock for #2082 / PR #2081 fix) ──────
// ── from_char multi-byte round-trip (regression lock for A195 fix) ───────────
#[test]
fn test_from_char_emits_full_utf8_for_two_byte_codepoint() {
    // U+00E9 (é) is a two-byte UTF-8 sequence: 0xC3 0xA9.
    // Before the A195 fix, only the first byte was encoded, producing a
    // one-byte garbage string rather than "é".
    assert(f"{(233).try_to_char().expect("valid Unicode scalar")}" == "é");
}

#[test]
fn test_from_char_emits_full_utf8_for_four_byte_codepoint() {
    // U+1F600 (😀) encodes as four UTF-8 bytes: 0xF0 0x9F 0x98 0x80.
    assert(f"{(128512).try_to_char().expect("valid Unicode scalar")}" == "😀");
}

// ── split empty-separator multi-byte exact values ─────────────────────────────
#[test]
fn test_split_empty_separator_returns_multibyte_codepoints_as_individual_elements() {
    // "café" is 5 bytes but 4 Unicode codepoints. The empty-separator split
    // must yield 4 elements with "é" as a single two-byte string, never split
    // at the byte boundary.
    var expected: Vec<string> = Vec.new();
    expected.push("c");
    expected.push("a");
    expected.push("f");
    expected.push("é");
    assert_string_vec_eq(("café").split(""), expected);
}

// ── split non-empty separator exact element values ────────────────────────────
#[test]
fn test_split_returns_exact_element_values_for_nonempty_separator() {
    // Checks each element, not just the count, to catch off-by-one errors in
    // the split position that a len()-only assertion would miss.
    var expected: Vec<string> = Vec.new();
    expected.push("red");
    expected.push("green");
    expected.push("blue");
    assert_string_vec_eq(("red,green,blue").split(","), expected);
}
