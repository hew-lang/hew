import std.os;

import std.stream;

import std.fs;

fn main() -> i64 {
    fs.write(f"{os.temp_dir()}/hew-if-let-resource-oracle-{os.pid()}.txt", "frame").expect("write");
    for i in 0..200 {
        if let .Ok(input) = stream.open(f"{os.temp_dir()}/hew-if-let-resource-oracle-{os.pid()}.txt") {
            let _ = input.try_recv();
            input.close();
            println("closed");
        } else {
            return 70;
        }
    }
    0
}
