import std.encoding.json;
import std.encoding.cbor;
import std.encoding.yaml;
import std.encoding.toml;
import std.encoding.msgpack;
import std.encoding.wire;

type Sample {
    exact: i64;
    payload: bytes;
    label: string;
}

fn check(back: Sample) {
    assert(back.exact == 9007199254740993);
    assert(back.payload == bytes [0, 128, 255]);
    assert(back.label == "Montréal");
}

#[test]
fn formats_preserve_typed_values_and_errors() {
    let value = Sample { exact: 9007199254740993, payload: bytes [0, 128, 255], label: "Montréal" };
    check(json.decode<Sample>(json.encode(value)).expect("JSON"));
    check(cbor.decode<Sample>(cbor.encode(value)).expect("CBOR"));
    check(yaml.decode<Sample>(yaml.encode(value)).expect("YAML"));
    check(toml.decode<Sample>(toml.encode(value)).expect("TOML"));
    check(msgpack.decode<Sample>(msgpack.encode(value)).expect("MessagePack"));
    assert(json.decode<u64>("18446744073709551615").expect("u64") == 18446744073709551615);
    let map = json.decode<HashMap<string, i64>>("{\"north\":9007199254740993}").expect("map");
    assert(map.get("north").expect("key") == value.exact);
    let set = cbor.decode<HashSet<i64>>(cbor.encode([4, 5])).expect("set");
    assert(set.contains(5));
    match json.decode<Sample>("{") {
        .Err(wire.DecodeError.Syntax { offset, line, column, reason }) => {
            assert(offset == 1);
            assert(line == .Some(1));
            assert(column == .Some(2));
            assert(reason.len() > 0);
        }
        _ => panic("expected a syntax location"),
    }
    match json.decode<i8>("128") {
        .Err(wire.DecodeError.Range { path, value, target }) => {
            assert(path == "");
            assert(value == "128");
            assert(target == "i8");
        }
        _ => panic("expected a typed range error"),
    }
    match json.decode<Sample>("{}") {
        .Err(wire.DecodeError.Missing { path }) => assert(path == ".exact"),
        _ => panic("expected a missing field"),
    }
}

#[test]
fn generated_input_uses_the_typed_codec_bridge(value: Sample) {
    let back = cbor.decode<Sample>(cbor.encode(value)).expect("generated round-trip");
    assert(back.exact == value.exact);
    assert(back.payload == value.payload);
    assert(back.label == value.label);
}
