// Exercises cooperative supervisor stop and terminal observation end-to-end.
//
// Verifies:
//   - `spawn AppSupervisor` routes through the synthesised bootstrap body
//     (hew_supervisor_new + add_child_spec + hew_supervisor_start).
//   - `stop(sup)` requests shutdown and `stopped(sup)` waits for cleanup.
//   - main returns 0 once the supervisor is terminal.
actor Worker {
    receive fn ping(_n: i64) {
        _n;
    }
}

supervisor AppSupervisor {
    strategy: one_for_one;
    intensity: 3 within 60s;

    child w1: Worker;
}

fn main() -> i64 {
    let sup = spawn AppSupervisor;
    stop(sup);
    stopped(sup);
    0
}
