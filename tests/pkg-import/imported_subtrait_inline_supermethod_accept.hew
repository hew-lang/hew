// Imported subtrait and supertrait impls retain their declaring identities.
import hew.supertraits.{Base, Sub};

type W {
    id: i64,
}

impl Base for W {
    fn base(w: W) -> i64 {
        w.id
    }
}

impl Sub for W {
    fn tag(w: W) -> i64 {
        w.id + 100
    }
}

fn main() {
    let w = W { id: 5 };
    println(f"tag {w.tag()} base {w.base()}");
}
