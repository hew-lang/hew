machine Turnstile {
    events {
        Coin;
        Push;
    }

    state Locked;
    state Unlocked;

    on Coin: Locked => Unlocked;
    on Push: Unlocked => Locked;

    default { state }
}

fn machine_methods_probe() -> i32 {
    7
}

fn machine_methods_use() -> i32 {
    var gate = Turnstile.Locked;
    let _ = gate.step(.Coin);
    println(gate.state_name());
    machine_methods_probe()
}
