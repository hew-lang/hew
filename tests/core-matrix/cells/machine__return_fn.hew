machine Counter {
    events { Inc, Reset, }
    state Zero,
    state NonZero { value: i64, },
    on Inc: Zero => NonZero { value: 1 }
    on Inc: NonZero => NonZero reenter { value: state.value + 1 }
    on Reset: NonZero => Zero,
    default { state }
}

fn make() -> Counter {
    var m = Zero;
    m.step(.Inc);
    m
}

fn main() {
    let x = make();
    match x {
        .Zero => println("zero"),
        .NonZero { value } => println(f"n {value}"),
    }
}
