type Name { label: string, }

fn first<T: Clone>(v: Vec<T>) -> Option<T> {
    v.get(0)
}

fn run_cycle() -> i64 {
    var vn: Vec<Name> = Vec.new();
    vn.push(Name { label: "owned-ok".to_upper() });
    let got = match first(vn) {
        .Some(g) => g,
        .None => { return 0; }
    };
    got.label.len()
}

fn run_loop(frames: i64) -> i64 {
    var total: i64 = 0;
    for i in 0..frames { total = total + run_cycle(); }
    total
}

fn main() -> i64 { run_loop(50) }
