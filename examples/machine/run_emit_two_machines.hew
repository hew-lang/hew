// Runnable fixture: two machine TYPES declaring a same-tag-index event,
// proving each machine's step report carries only its OWN outputs — never
// another machine's, even when both declare an event at the same
// event-declaration index.
//
// `Alarm` and `Beacon` both declare `Ring` at event-declaration index 1
// (after `Trigger` at index 0) — same tag, different machine types. Only
// `Alarm` emits `Ring` (triggered by its own `Trigger` step, a distinct
// event from the one it emits — machines cannot emit the event that
// re-triggers their own transition). `Beacon`'s own `Trigger` step never
// emits, so its report's outputs are always empty.
//
// `tests/exec/machine_exec.rs::run_emit_two_machines_fixture_executes` is
// the end-to-end signal for this fixture.
machine Alarm {
    events {
        Trigger,
        Ring,
    }

    emits {
        Ring,
    }

    state Armed,
    state Tripped,

    on Trigger: Armed => Tripped {
        emit Ring {};
        Alarm.Tripped
    }
    on Trigger: Tripped => Tripped reenter {
        Alarm.Tripped
    }
    on Ring: _ => _ {
        state
    }
}

machine Beacon {
    events {
        Trigger,
        Ring,
    }

    state Idle,
    state Lit,

    on Trigger: Idle => Lit {
        Beacon.Lit
    }
    on Trigger: Lit => Lit reenter {
        Beacon.Lit
    }
    on Ring: _ => _ {
        state
    }
}

fn main() {
    var a = Armed;
    var b = Idle;
    let a_report = a.step(.Trigger);
    let b_report = b.step(.Trigger);
    println(a_report.outputs.len());
    println(b_report.outputs.len());
}
