//! Coalesce regression: string keys preserve the latest same-key payload while
//! a distinct key survives the bounded-mailbox flood.

import std.stream;

actor StringCoalescer {
    var processed: i64 = 0,
    var latest_one: i64 = -1,
    var latest_two: i64 = -1,

    mailbox 2 overflow coalesce(symbol) fallback drop_new,

    // Holds the actor: reports that it is running, then waits for its gate.
    receive fn hold(started: stream.Sink<i64>, gate: stream.Stream<i64>) {
        started.send(1).expect("started");
        gate.recv();
    }

    receive fn update(symbol: string, value: i64) {
        processed = processed + 1;
        if symbol == "one" {
            latest_one = value;
        } else {
            latest_two = value;
        }
    }

    receive fn count() -> i64 {
        processed
    }

    receive fn one() -> i64 {
        latest_one
    }

    receive fn two() -> i64 {
        latest_two
    }
}

#[test]
fn coalesce_string_key_latest_wins_and_distinct_keys_survive() {
    let worker = spawn StringCoalescer(processed: 0, latest_one: -1, latest_two: -1);
    let intake = mailbox(worker);
    let (started_tx, started) = stream.pipe(1).expect("started");
    let (release, gate) = stream.pipe(1).expect("gate");
    let _ = intake.hold(started_tx, gate);
    started.recv();
    let _ = intake.update("one", 1);
    let _ = intake.update("two", 20);
    let _ = intake.update("one", 2);
    let _ = intake.update("one", 3);
    let _ = intake.update("one", 4);
    release.send(1).expect("release");
    match worker.count() {
        .Ok(value) => assert(value == 2),
        .Err(_) => assert(false),
    }
    match worker.one() {
        .Ok(value) => assert(value == 4),
        .Err(_) => assert(false),
    }
    match worker.two() {
        .Ok(value) => assert(value == 20),
        .Err(_) => assert(false),
    }
}
