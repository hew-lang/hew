trait Named {
    fn name(val: Self) -> string;
}

type P {
    n: string;
}

impl Named for P {
    fn name(val: P) -> string {
        val.n
    }
}

type Q {
    n: string;
}

impl Named for Q {
    fn name(val: Q) -> string {
        val.n
    }
}

fn show_named(v: dyn Named) {
    let s = v.name();
    println(s);
}

actor Sink {
    var hits: i64;

    receive fn take(v: dyn Named) -> i64 {
        show_named(v);
        hits = hits + 1;
        hits
    }
}

fn main() {
    let x: dyn Named = P { n: "p0" };
    let s = spawn Sink(hits: 0);
    match await s.take(x) {
        Result.Ok(n) => println(f"hits {n}"),
        Result.Err(_) => println("err"),
    }
}
