// Reject fixture: the lazy stream adapters are not part of the pipe surface.
// `Stream<T>.map/filter` once type-checked on a builtin signature with no MIR
// lowering behind it, and dead-ended in HIR lowering with two internal-shaped
// `E_NOT_YET_IMPLEMENTED` notes. They are gone from the surface now, so the
// call is refused at the method lookup with one honest diagnostic naming the
// receiver type. A regression that re-adds the signature without a lowering
// behind it fails this gate.
// Expected: exactly one error, `no method `map` on `Stream<string>``, and NO
// leftover `E_NOT_YET_IMPLEMENTED` / "reached verification" internal noise.
fn use_stream(s: Stream<string>) {
    let _t = s.map(|x: string| x);
}

fn main() {}
