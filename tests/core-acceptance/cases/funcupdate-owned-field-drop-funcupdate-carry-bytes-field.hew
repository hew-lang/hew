import std.string;

type Pair {
    keep: bytes;
    churn: string;
}

fn main() -> i64 {
    var p = Pair { keep: ("k").repeat(32).to_bytes(), churn: ("a").repeat(32) };
    var i: i64 = 0;
    while i < 50 {
        p = Pair { ..p, churn: ("b").repeat(32) };
        i = i + 1;
    }
    p.keep.len()
}
