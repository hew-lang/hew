// Max-Heap using implicit array representation
// Parent of i = (i-1)/2, left child = 2*i+1, right child = 2*i+2
//
// A parameter is the callee's own copy, so push and pop hand the heap back and
// the caller reassigns; pop also reports the value it removed.
fn heap_push(var heap: Vec<i32>, val: i32) -> Vec<i32> {
    heap.push(val);
    var i = heap.len() - 1;
    while i > 0 {
        let parent = (i - 1) / 2;
        if heap[i] > heap[parent] {
            let tmp = heap[i];
            heap.set(i, heap[parent]);
            heap.set(parent, tmp);
            i = parent;
        } else {
            i = 0;
        }
    }
    heap
}

// Push every value in order.
fn heap_push_all(var heap: Vec<i32>, values: Vec<i32>) -> Vec<i32> {
    for value in values {
        heap = heap_push(heap, value);
    }
    heap
}

fn heap_peek(heap: Vec<i32>) -> i32 {
    heap[0]
}

fn heap_pop(var heap: Vec<i32>) -> (Vec<i32>, i32) {
    let max_val = heap[0];
    let last = heap.pop();
    if !heap.is_empty() {
        heap.set(0, last);
        var i = 0;
        var done = false;
        while !done {
            let left = 2 * i + 1;
            let right = 2 * i + 2;
            var largest = i;
            if left < heap.len() {
                if heap[left] > heap[largest] {
                    largest = left;
                }
            }
            if right < heap.len() {
                if heap[right] > heap[largest] {
                    largest = right;
                }
            }
            if largest != i {
                let tmp = heap[i];
                heap.set(i, heap[largest]);
                heap.set(largest, tmp);
                i = largest;
            } else {
                done = true;
            }
        }
    }
    (heap, max_val)
}

// Build heap from array (heapify)
fn build_heap(arr: Vec<i32>, var heap: Vec<i32>) -> Vec<i32> {
    for x in arr {
        heap.push(x);
    }
    // Heapify from last non-leaf node
    var i = heap.len() / 2 - 1;
    while i >= 0 {
        var cur = i;
        var done = false;
        while !done {
            let left = 2 * cur + 1;
            let right = 2 * cur + 2;
            var largest = cur;
            if left < heap.len() {
                if heap[left] > heap[largest] {
                    largest = left;
                }
            }
            if right < heap.len() {
                if heap[right] > heap[largest] {
                    largest = right;
                }
            }
            if largest != cur {
                let tmp = heap[cur];
                heap.set(cur, heap[largest]);
                heap.set(largest, tmp);
                cur = largest;
            } else {
                done = true;
            }
        }
        i = i - 1;
    }
    heap
}

fn check_max_heap_property(heap: Vec<i32>) -> bool {
    var ok = true;
    for i in 0 .. heap.len() {
        let left = 2 * i + 1;
        let right = 2 * i + 2;
        if left < heap.len() {
            if heap[i] < heap[left] {
                ok = false;
            }
        }
        if right < heap.len() {
            if heap[i] < heap[right] {
                ok = false;
            }
        }
    }
    ok
}

fn test_basic_max_heap() -> i32 {
    var heap: Vec<i32> = Vec.new();
    let seeds1: Vec<i32> = [5, 3, 7, 1, 9];
    heap = heap_push_all(heap, seeds1);
    let pk = heap_peek(heap);
    if pk == 9 {
        println("PASS: max-heap peek returns maximum");
        1
    } else {
        print("FAIL: max-heap peek expected 9 got ");
        println(pk);
        0
    }
}

fn test_extract_max_order() -> i32 {
    var heap: Vec<i32> = Vec.new();
    let seeds2: Vec<i32> = [5, 3, 7, 1, 4, 6, 2];
    heap = heap_push_all(heap, seeds2);
    let (after_e1, e1) = heap_pop(heap);
    heap = after_e1;
    let (after_e2, e2) = heap_pop(heap);
    heap = after_e2;
    let (after_e3, e3) = heap_pop(heap);
    heap = after_e3;
    let (after_e4, e4) = heap_pop(heap);
    heap = after_e4;
    let (after_e5, e5) = heap_pop(heap);
    heap = after_e5;
    let (after_e6, e6) = heap_pop(heap);
    heap = after_e6;
    let (after_e7, e7) = heap_pop(heap);
    heap = after_e7;
    var ok = true;
    if e1 != 7 {
        ok = false;
    }
    if e2 != 6 {
        ok = false;
    }
    if e3 != 5 {
        ok = false;
    }
    if e4 != 4 {
        ok = false;
    }
    if e5 != 3 {
        ok = false;
    }
    if e6 != 2 {
        ok = false;
    }
    if e7 != 1 {
        ok = false;
    }
    if ok {
        println("PASS: extract_max returns descending order");
        1
    } else {
        print("FAIL: extract order: ");
        print(e1);
        print(" ");
        print(e2);
        print(" ");
        print(e3);
        print(" ");
        print(e4);
        print(" ");
        print(e5);
        print(" ");
        print(e6);
        print(" ");
        println(e7);
        0
    }
}

fn test_build_heap() -> i32 {
    var arr: Vec<i32> = Vec.new();
    arr.push(3);
    arr.push(1);
    arr.push(6);
    arr.push(5);
    arr.push(2);
    arr.push(4);
    var heap: Vec<i32> = Vec.new();
    heap = build_heap(arr, heap);
    let ok = check_max_heap_property(heap);
    if ok {
        if heap_peek(heap) == 6 {
            println("PASS: build_heap maintains max-heap property");
            return 1;
        }
    }
    println("FAIL: build_heap");
    0
}

fn test_heap_property_after_ops() -> i32 {
    var heap: Vec<i32> = Vec.new();
    let seeds3: Vec<i32> = [10, 20, 15, 30, 5];
    heap = heap_push_all(heap, seeds3);
    let (after_drop4, _dropped4) = heap_pop(heap);
    heap = after_drop4;
    heap = heap_push(heap, 25);
    let (after_drop5, _dropped5) = heap_pop(heap);
    heap = after_drop5;
    let ok = check_max_heap_property(heap);
    if ok {
        println("PASS: heap property after mixed ops");
        1
    } else {
        println("FAIL: heap property violated");
        0
    }
}

fn test_heapsort() -> i32 {
    var heap: Vec<i32> = Vec.new();
    let seeds6: Vec<i32> = [8, 3, 10, 1, 5, 7];
    heap = heap_push_all(heap, seeds6);
    // Extract all to get sorted descending
    var sorted: Vec<i32> = Vec.new();
    while !heap.is_empty() {
        let (drained, top) = heap_pop(heap);
        heap = drained;
        sorted.push(top);
    }
    // Verify descending order
    var ok = true;
    var i = 1;
    while i < sorted.len() {
        if sorted[i] > sorted[i - 1] {
            ok = false;
        }
        i = i + 1;
    }
    if ok {
        if sorted.len() == 6 {
            println("PASS: heapsort produces sorted output");
            return 1;
        }
    }
    println("FAIL: heapsort");
    0
}

fn main() {
    println("=== Max-Heap ===");
    var passed = 0;
    let total = 5;
    passed = passed + test_basic_max_heap();
    passed = passed + test_extract_max_order();
    passed = passed + test_build_heap();
    passed = passed + test_heap_property_after_ops();
    passed = passed + test_heapsort();
    println("");
    print(passed);
    print("/");
    print(total);
    println(" tests passed");
    if passed == total {
        println("PASS");
    } else {
        println("FAIL");
    }
}
