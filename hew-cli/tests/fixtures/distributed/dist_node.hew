// dist_node.hew — shared two-process distributed E2E node program.
//
// ONE program, two roles, selected at runtime by environment variables. Both
// the server and the client are compiled from this single file so the
// serializable message types (KvReq / KvResp / KvPut) are identical on both
// sides of the wire by construction — there is no second file to drift out of
// sync.
//
// Driven by the Rust harness in hew-cli/tests/distributed_two_process_e2e.rs.
// Configuration is read from the environment so new scenarios can be added by
// the harness without changing the program's command-line shape:
//
//   HEW_DIST_ROLE     "server" | "client"   (required)
//   HEW_DIST_SCENARIO scenario name for the client role  (default "remote_ask")
//
// Readiness protocol (deterministic, no fixed sleeps for correctness):
//   - The server binds an ephemeral loopback port and, AFTER the actor is
//     registered, publishes it in `<kx>/server.ready` and prints "READY <port>"
//     on a line of its own. A replacement server rebinds the published port.
//     A node that cannot start prints FAIL and exits 2 without either signal.
//   - The client receives typed actor grants over its authenticated peer.
//     Registry lookup is used only for discovery metadata.
//
// Output contract (the harness asserts on these, with teeth):
//   - "PASS <scenario> <detail>"  on success
//   - "FAIL <scenario> <detail>"  on any mismatch; main returns non-zero
import std.os;

import std.fs;

import std.stream;

import std.net;
import std.net.cluster;

import std.encoding.utf8;

import std.failure.{CrashNotification, CrashKind, DownTarget};

import std.observe;
import std.link_monitor.{DownNotification, DownReason, MonitorRef, PartitionPolicy, set_partition_policy,};

// hew_node_api_unregister: the repoint_preserves_ref scenario re-points a
// registered name to a DIFFERENT actor. `Node::unregister` is not yet a Hew
// surface, so the server calls the runtime api directly.
extern "C" {
    fn hew_actor_self_id() -> i64;
    fn hew_dist_setup_race_kind() -> i64;
}

// Every exported handler payload declares its wire schema: fields
// carry explicit @N tags and enum variants are tagged by declaration order.
#[wire]
type KvPut {
    key: string @1;
    val: string @2;
}

#[wire]
enum KvReq {
    Put(KvPut) @0;
    GetKey(string) @1;
    // Cross-node monitor scenarios: fire-and-forget commands that drive the
    // remote actor to a terminal state so a monitoring client observes the
    // cross-node DOWN with the right reason.
    StopSelf @2;
    CrashSelf @3;
    // scenario_partition_ask phase A: hold the reply past the client's ask
    // deadline so the pending ask is deterministically resolvable ONLY by the
    // armed partition probe (no reply, no socket drop — the route stays live).
    Stall @4;
}

#[wire]
enum KvResp {
    Ack @0;
    Value(string) @1;
}

// ── #[wire] cross-process body types ─────────────────────────────────────────
//
// These types exercise the tag-keyed CBOR body with a nested record: a struct as
// an @N-keyed map, an enum as a unit tag (Ping) or a map-of-one (Move). Both the
// request (WireCmd) and the reply (WireResult) are #[wire] types, so the
// explicit-@N body is proven crossing the wire in both directions.
#[wire]
type WirePoint {
    x: i64 @1;
    y: i64 @2;
}

// Enum variant wire tags are the declaration ordinal (Ping = 0, Move = 1);
// the #[wire] enum surface tags variants positionally. The struct fields above
// carry EXPLICIT @N tags — that is the explicit-tag body this scenario proves.
#[wire]
enum WireCmd {
    Ping @0;
    Move(WirePoint) @1;
}

// WireResult is the #[wire] struct reply: `tag` is which variant the server saw
// (0 = Ping, 1 = Move); `sum` is x + y for Move, or 0 for Ping.
#[wire]
type WireResult {
    tag: i64 @1;
    sum: i64 @2;
}

actor ServiceFacade {
    let file: fs.ReadFile;
    let started: Sink<i64>;
    let gate: Stream<i64>;
    var held_calls: i64 = 0;
    var last_submission: string = "";
    #[wire]
    receive fn read() -> bytes {
        self.file.read().expect("supplied read")
    }
    #[wire]
    receive fn add(left: i64, right: i64) -> i64 {
        left + right
    }
    #[wire]
    receive fn handle(value: i64) -> i64 {
        value + 1
    }
    #[wire]
    receive fn finish() {}
    #[wire]
    receive fn held() -> i64 {
        held_calls += 1;
        started.send(1).expect("held service started");
        let _ = gate.recv();
        held_calls
    }
    #[wire]
    receive fn submission(value: string) {
        assert(value == "owned submission");
        started.send(1).expect("submission started");
        gate.recv().expect("submission released");
        held_calls += 1;
    }
    #[wire]
    receive fn remember(value: string) {
        last_submission = value;
    }
    #[wire]
    receive fn remembered() -> string {
        last_submission
    }
    #[wire]
    receive fn calls() -> i64 {
        held_calls
    }
    #[wire]
    receive fn decline() -> i64 fails string {
        return error "declared-service-error";
    }
}

#[confined]
fn supplied_sum(service: ServiceFacade) -> i64 {
    service.add(right: 5, left: 37).expect("supplied add")
}

fn authenticated_peer() -> net.PeerSession {
    let local = Node.id().expect("local identity");
    let observation = cluster.watch().expect("watch authenticated peers");
    loop {
        for member in observation.snapshot().expect("peer snapshot").members {
            if member.id != local && member.state == cluster.State.Alive {
                match Node.peer(member.id) {
                    .Ok(peer) => return peer,
                    .Err(_) => {}
                }
            }
        }
        assert(observation.changes.recv().is_some());
    }
}

fn new_service_facade(path: string) -> ServiceFacade {
    let (started, _begins): (Sink<i64>, Stream<i64>) = stream.pipe(1).expect("started");
    let (_release, gate): (Sink<i64>, Stream<i64>) = stream.pipe(1).expect("gate");
    spawn ServiceFacade { file: fs.open_read(path).expect("file"), started: started, gate: gate }
}

fn connect_service_peer(port: string) {
    var attempts: i64 = 0;
    loop {
        match Node.connect(f"127.0.0.1:{port}") {
            .Ok(_) => return,
            .Err(_) => {
                attempts += 1;
                if attempts >= 100 {
                    panic("service peer reconnect");
                }
                sleep(20ms);
            }
        }
    }
}

fn scenario_server_service_grants(kx: string) {
    let path = f"{kx}/service.txt";
    let _ = fs.write(path, "supplied-file");
    let (started, begins): (Sink<i64>, Stream<i64>) = stream.pipe(1).expect("started");
    let (release, gate): (Sink<i64>, Stream<i64>) = stream.pipe(1).expect("gate");
    let facade = spawn ServiceFacade { file: fs.open_read(path).expect("file"), started: started, gate: gate };
    assert(supplied_sum(facade) == 42);
    Node.register("service-facade", facade);
    let peer = authenticated_peer();
    let generic = spawn GenericEcho<i64>;
    let generic_export = peer.export(generic).expect("generic offer admission");
    let export = peer.export(facade).expect("offer admission");
    let alias_export = peer.export(facade).expect("independent offer admission");
    publish_atomic(kx, "service.admitted", "1");
    let _ = begins.recv();
    publish_atomic(kx, "service.submission-started", "1");
    let _ = wait_for_file(f"{kx}/service.submission-acked");
    release.send(1).expect("release acknowledged submission");
    let _ = begins.recv();
    publish_atomic(kx, "service.held", "1");
    let _ = wait_for_file(f"{kx}/service.reconnected");
    release.send(1).expect("release interrupted service turn");
    let _ = wait_for_file(f"{kx}/service.disconnected");
    export.close();
    publish_atomic(kx, "service.revoked", "1");
    let _ = wait_for_file(f"{kx}/service.reuse-refused");
    alias_export.close();
    publish_atomic(kx, "service.alias-revoked", "1");
    let _ = wait_for_file(f"{kx}/service.alias-refused");
    let live_export = peer.export(facade).expect("second offer");
    publish_atomic(kx, "service.second", "1");
    let _ = wait_for_file(f"{kx}/service.retire");
    stop(facade);
    stopped(facade);
    let replacement = new_service_facade(path);
    let replacement_export = peer.export(replacement).expect("replacement offer");
    publish_atomic(kx, "service.actor-restarted", "1");
    let _ = wait_for_file(f"{kx}/service.restart-node");
    Node.shutdown();
    stop(replacement);
    stopped(replacement);
    let port = wait_for_server_listening(kx);
    Node.start(NodeConfig { bind: f"127.0.0.1:{port}", transport: NodeTransport.Tcp, key: f"{kx}/server.key", cluster: f"{kx}/server.enrollment", seeds: [] }).expect("restart node");
    publish_atomic(kx, "service.node-restarted", "1");
    let restarted_peer = authenticated_peer();
    let restarted = new_service_facade(path);
    let restarted_export = restarted_peer.export(restarted).expect("restarted node offer");
    let _ = wait_for_file(f"{kx}/service.done");
}

fn scenario_service_grants(kx: string, port: string) -> i64 {
    let peer = authenticated_peer();
    let _ = wait_for_file(f"{kx}/service.admitted");
    match peer.receive_service<GenericEcho<string>>() {
        .Err(ActorError.RoutingFailed) => {}
        _ => panic("incompatible generic service admitted"),
    }
    let generic = peer.receive_service<GenericEcho<i64>>().expect("generic service");
    assert(generic.handle(42).expect("generic service reply") == 42);
    match peer.receive_service<WireProbe>() {
        .Err(ActorError.RoutingFailed) => {}
        _ => panic("incompatible service interface admitted"),
    }
    let service = peer.receive_service<ServiceFacade>().expect("receive service");
    let alias = peer.receive_service<ServiceFacade>().expect("independent service grant");
    assert(service is alias);
    scope within 20ms {
        let _ = peer.receive_service<ServiceFacade>();
        panic("absent offer completed");
    } handle failure {
        match failure {
            .Deadline { message } => {}
            .Fault { message } => panic(message),
        }
    };
    assert(supplied_sum(service) == 42);
    assert(utf8.decode(service.read().expect("service read")).expect("utf8") == "supplied-file");
    service.finish().expect("unit completion");
    match service.decline() {
        .Err(ActorError.Failed(message)) => assert(message == "declared-service-error"),
        _ => panic("service declared failure envelope"),
    }
    // Discovery remains available; the Rust companion rejects using this
    // metadata as a callable actor or observation target.
    let _ = discover_with_retry("service-facade").expect("raw location metadata");
    match mailbox(service).submission("owned submission".to_upper().to_lower()) {
        .Ok(Delivery.Accepted) => {}
        _ => panic("imported mailbox admission"),
    }
    let _ = wait_for_file(f"{kx}/service.submission-started");
    publish_atomic(kx, "service.submission-acked", "1");
    assert(service.calls().expect("submission completed") == 1);
    let reused_service = scope {
        let interrupted = fork {
            let outcome = service.held();
            (service, outcome)
        };
        let _ = wait_for_file(f"{kx}/service.held");
        connect_service_peer(port);
        publish_atomic(kx, "service.reconnected", "1");
        let (returned, outcome) = await interrupted;
        match outcome {
            .Err(ActorError.ConnectionDropped) => {}
            _ => panic("interrupted service call replayed"),
        }
        returned
    };
    let same_session_calls = reused_service.calls();
    match same_session_calls {
        .Ok(value) => assert(value == 2),
        .Err(error) => {
            let routes = observe.read("node.routes") ?? -1;
            let peers = observe.read("node.peers") ?? -1;
            let alive = observe.read("swim.alive") ?? -1;
            let suspect = observe.read("swim.suspect") ?? -1;
            let dead = observe.read("swim.dead") ?? -1;
            println(f"GRANT_TRACE same-session failure routes={routes} peers={peers} alive={alive} suspect={suspect} dead={dead}");
            panic(f"same-session grant: {error}");
        }
    }
    assert(supplied_sum(reused_service) == 42);
    publish_atomic(kx, "service.disconnect", "1");
    let _ = wait_for_file(f"{kx}/service.disconnected");
    let _ = wait_for_file(f"{kx}/service.revoked");
    publish_atomic(kx, "service.reconnect", "1");
    connect_service_peer(port);
    match reused_service.add(1, 2) {
        .Err(ActorError.RoutingFailed) => {}
        _ => panic("revoked disconnected service executed"),
    }
    assert(reused_service is alias);
    assert(supplied_sum(alias) == 42);
    match mailbox(reused_service).remember("retained request".to_upper()) {
        .Err(ActorError.Rejected(failure)) => {
            match failure.message.to(alias).expect("resubmit definitely rejected request") {
                Delivery.Accepted => {}
                _ => panic("retained request discarded"),
            }
        }
        _ => panic("revoked mailbox must return its unaccepted request"),
    }
    assert(alias.remembered().expect("independent grant still admits") == "RETAINED REQUEST");
    publish_atomic(kx, "service.reuse-refused", "1");
    let _ = wait_for_file(f"{kx}/service.alias-revoked");
    match alias.add(1, 2) {
        .Err(ActorError.RoutingFailed) => {}
        _ => panic("independently revoked alias executed"),
    }
    publish_atomic(kx, "service.alias-refused", "1");
    println("PASS service_grants identity-equal independent-revocation rejected-request-retained");
    let actor_service = peer.receive_service<ServiceFacade>().expect("second service");
    publish_atomic(kx, "service.retire", "1");
    let _ = wait_for_file(f"{kx}/service.actor-restarted");
    match actor_service.add(1, 2) {
        .Err(ActorError.Dead) => {}
        _ => panic("retired actor grant executed"),
    }
    stopped(actor_service);
    let replacement = peer.receive_service<ServiceFacade>().expect("replacement service");
    assert(!(actor_service is replacement));
    assert(supplied_sum(replacement) == 42);
    publish_atomic(kx, "service.restart-node", "1");
    let _ = wait_for_file(f"{kx}/service.node-restarted");
    connect_service_peer(port);
    match replacement.add(1, 2) {
        .Err(ActorError.Dead) => {}
        _ => panic("retired node session grant executed"),
    }
    match peer.receive_service<ServiceFacade>() {
        .Err(ActorError.Dead) => {}
        _ => panic("stale peer session imported service"),
    }
    let restarted = authenticated_peer().receive_service<ServiceFacade>().expect("restarted service");
    assert(supplied_sum(restarted) == 42);
    publish_atomic(kx, "service.done", "1");
    println("PASS service_grants file=supplied-file sum=42 unit declared-failure incompatible generic-incompatible cancelled raw-metadata mailbox-acked-before-completion reconnect no-replay disconnected-revoke actor-restart node-restart");
    0
}

actor GenericEcho<T> {
    #[wire]
    receive fn handle(value: T) -> T {
        value
    }
}

actor SpecializedEcho<T> {
    #[wire]
    receive fn handle(value: T) -> T {
        value
    }
}

actor DeadlineLeaf {
    var calls: i64 = 0;
    #[wire]
    receive fn handle(command: i64) -> i64 {
        if command == 1 {
            calls += 1;
        }
        calls
    }
}

fn deadline_nested(leaf: DeadlineLeaf, remote: DeadlineLeaf) -> bool {
    let local_expired = match leaf.handle(1) {
        .Err(ActorError.TimedOut) => true,
        _ => false,
    };
    let remote_expired = match remote.handle(1) {
        .Err(ActorError.TimedOut) => true,
        _ => false,
    };
    local_expired && remote_expired
}

actor DeadlineWorker {
    let leaf: DeadlineLeaf;
    let remote_leaf: DeadlineLeaf;
    var gate: Stream<i64>;
    var started: Sink<i64>;
    var calls: i64 = 0;
    #[wire]
    receive fn handle(command: i64) -> string {
        if command == 0 {
            started.send(1).expect("held turn began");
            gate.recv().expect("release held turn");
            return "held reply".to_upper();
        }
        if command == 1 {
            calls += 1;
        }
        if command == 2 {
            calls += 1;
            started.send(1).expect("mutation began");
            gate.recv().expect("caller abandoned reply");
            let expired = scope within 1s {
                let child = fork deadline_nested(leaf, remote_leaf);
                await child
            } handle failure {
                panic("request expiry cancelled a claimed handler");
            };
            assert(expired);
            calls += 1;
            return "owned late reply".to_upper();
        }
        f"{calls}"
    }
}

actor DeadlineGate {
    var release: Sink<i64>;
    var started: Stream<i64>;
    #[wire]
    receive fn handle(command: i64) -> i64 {
        if command == 0 {
            started.recv().expect("worker claimed request");
        } else {
            release.send(1).expect("release worker");
        }
        command
    }
}

fn serve_deadline_actors(peer: net.PeerSession) {
    let (release, gate): (Sink<i64>, Stream<i64>) = stream.pipe(1).expect("deadline gate");
    let (started, begins): (Sink<i64>, Stream<i64>) = stream.pipe(1).expect("deadline began");
    let leaf = spawn DeadlineLeaf;
    Node.register("deadline-server-leaf", leaf);
    let leaf_export = peer.export(leaf).expect("server leaf grant");
    let remote_leaf = peer.receive_service<DeadlineLeaf>().expect("client leaf grant");
    let worker = spawn DeadlineWorker { leaf: leaf, remote_leaf: remote_leaf, gate: gate, started: started };
    let control = spawn DeadlineGate { release: release, started: begins };
    let worker_export = peer.export(worker).expect("worker grant");
    let control_export = peer.export(control).expect("control grant");
    sleep(2m);
}

fn scenario_deadline_budget() -> i64 {
    let leaf = spawn DeadlineLeaf;
    Node.register("deadline-client-leaf", leaf);
    let peer = fixture_peer();
    let leaf_export = peer.export(leaf).expect("client leaf grant");
    let server_leaf = peer.receive_service<DeadlineLeaf>().expect("server leaf grant");
    let worker = peer.receive_service<DeadlineWorker>().expect("deadline worker");
    let gate = peer.receive_service<DeadlineGate>().expect("deadline gate");
    scope {
        let held = fork worker.handle(0);
        gate.handle(0).expect("held turn claimed");
        match (scope within 50ms {
            worker.handle(1)
        } handle failure {
            match failure {
                .Deadline { message } => .Err(ActorError.TimedOut),
                .Fault { message } => panic(message),
            }
        }) {
            .Err(ActorError.TimedOut) => {}
            _ => panic("queued request must time out"),
        }
        gate.handle(1).expect("release held turn");
        assert((await held).expect("held reply") == "HELD REPLY");
    };
    assert(worker.handle(3).expect("queued mutation absent") == "0");
    println("PASS deadline_budget queued-not-started");
    scope {
        let held = fork worker.handle(0);
        gate.handle(0).expect("relay waits behind a claimed turn");
        scope within 1s {
            let started = fork worker.handle(2);
            sleep(250ms);
            gate.handle(1).expect("release turn ahead of relay");
            gate.handle(0).expect("mutation claimed");
            let _ = await started;
            panic("claimed caller must expire");
        } handle failure {
            match failure {
                .Deadline { message } => {}
                .Fault { message } => panic(message),
            }
        };
        assert((await held).expect("held relay reply") == "HELD REPLY");
    };
    // A relative wire budget starts on receipt. This margin is shorter than
    // the relay's queue wait, so resetting its budget at dispatch fails below.
    sleep(50ms);
    gate.handle(1).expect("claimed handler stays alive");
    assert(worker.handle(3).expect("claimed mutation completed once") == "2");
    assert(leaf.handle(0).expect("remote nested work absent") == 0);
    assert(server_leaf.handle(0).expect("local nested work absent") == 0);
    assert(worker.handle(1).expect("later independent budget") == "3");
    println("PASS deadline_budget claimed-finishes-nested-times-out");
    stop(leaf);
    stopped(leaf);
    0
}

actor HeldEcho {
    var gate: stream.Stream<i64>;
    #[wire]
    receive fn handle(value: string) -> string {
        gate.recv();
        value
    }
}

actor EchoRelease {
    var gate: stream.Sink<i64>;
    #[wire]
    receive fn handle(count: i64) -> i64 {
        for i in 0..count {
            gate.send(i).expect("release held reply");
        }
        count
    }
}

actor InboundResults {
    var successes: i64 = 0;
    var refused: i64 = 0;
    var closed: i64 = 0;
    var wrong: i64 = 0;
    receive fn record(status: i64) {
        match status {
            0 => {
                successes += 1;
            }
            1 => {
                refused += 1;
            }
            2 => {
                closed += 1;
            }
            _ => {
                wrong += 1;
            }
        }
    }
    receive fn counts() -> (i64, i64, i64, i64) {
        (successes, refused, closed, wrong)
    }
}

// Hold terminal cleanup until the observer has registered on the authenticated
// connection. This makes the first stopped call live and the next one late.
#[resource]
type RemoteCloseState {
    directory: string;
    fail_close: bool;
}

impl RemoteCloseState {
    fn close(consume self) {
        publish_atomic(self.directory, "close.entered", "1");
        assert(wait_for_file(f"{self.directory}/close.release") == "1");
        if self.fail_close {
            panic("remote secondary cleanup fault");
        }
    }
}

actor RemoteClosingActor {
    let state: RemoteCloseState;

    #[wire]
    receive fn crash() {
        panic("remote original handler fault");
    }
}

fn scenario_server_remote_stopped(kx: string, fail_close: bool) {
    let target = spawn RemoteClosingActor { state: RemoteCloseState { directory: kx, fail_close: fail_close } };
    let peer = fixture_peer();
    let export = peer.export(target).expect("terminal observation grant");
    assert(wait_for_file(f"{kx}/close.entered") == "1");
    var attempts = 0;
    while (unsafe {
        hew_dist_monitor_remote_watcher_count()
    }) == 0 {
        attempts = attempts + 1;
        assert(attempts < 600);
        sleep(10ms);
    }
    publish_atomic(kx, "close.release", "1");
    // Keep both the export grant and authenticated connection alive until the
    // client has consumed the live result and registered after completion.
    assert(wait_for_file(f"{kx}/close.observed") == "1");
}

fn scenario_remote_stopped(kx: string, fail_close: bool) -> i64 {
    let peer = fixture_peer();
    let target = peer.receive_service<RemoteClosingActor>().expect("terminal observation service");
    mailbox(target).crash().expect("crash request admitted");
    assert(wait_for_file(f"{kx}/close.entered") == "1");
    for pass in 0..2 {
        let cleanup_failed = scope within 10s {
            stopped(target);
            false
        } handle failure {
            match failure {
                .Fault { message } => {
                    assert(message.contains("remote secondary cleanup fault"));
                    assert(!message.contains("remote original handler fault"));
                    true
                }
                .Deadline { message } => panic(message),
            }
        };
        assert(cleanup_failed == fail_close);
        println(f"PASS remote_stopped pass={pass} cleanup={cleanup_failed}");
    }
    publish_atomic(kx, "close.observed", "1");
    0
}

actor KeyValue {
    var store: HashMap<string, string>;
    #[wire]
    receive fn handle(req: KvReq) -> KvResp {
        match req {
            KvReq.Put(kv) => {
                store.insert(kv.key, kv.val);
                KvResp.Ack
            }
            KvReq.GetKey(k) => {
                match store.get(k) {
                    .Some(v) => KvResp.Value(v),
                    .None => KvResp.Value(""),
                }
            }
            // Clean exit: the actor stops itself, transitioning to the Stopped
            // terminal state, which the cross-node monitor reports as a DOWN
            // carrying the clean-exit reason.
            KvReq.StopSelf => {
                stop(self);
                KvResp.Ack
            }
            // Crash: a deliberate panic transitions the actor to the Crashed
            // terminal state, reported as a DOWN carrying the crash reason.
            KvReq.CrashSelf => {
                panic("crash requested by cross-node monitor scenario");
                KvResp.Ack
            }
            // Deterministic pend for scenario_partition_ask phase A: hold the
            // reply well past the client's ask deadline (3 s) so the armed
            // partition probe is the only path that can resolve the pending ask
            // early. The harness SIGKILLs this process before the sleep ends.
            KvReq.Stall => {
                if (os.env("HEW_DIST_SCENARIO") ?? "") == "persistent_seed" {
                    store.insert("seed-held", "started");
                    let kx = os.env("HEW_DIST_KX_DIR") ?? "";
                    publish_atomic(kx, "seed.inflight", "1");
                }
                sleep(10s);
                KvResp.Ack
            }
        }
    }
    #[wire]
    receive fn stop_self() {
        stop(self);
    }
    #[wire]
    receive fn crash_self() {
        panic("crash requested by cross-node monitor scenario");
    }
    #[wire]
    receive fn put(value: KvPut) {
        store.insert(value.key, value.val);
    }
    #[wire]
    receive fn count() -> i64 {
        store.len()
    }
}

// Actor for the #[wire] cross-process scenario. It receives a #[wire] enum and
// replies with a #[wire] struct, so the explicit-@N tagged body is exercised on
// both the request and the reply leg of a remote ask.
actor WireProbe {
    let calls: i64;
    #[wire]
    receive fn handle(cmd: WireCmd) -> WireResult {
        match cmd {
            WireCmd.Ping => WireResult { tag: 0, sum: 0 },
            WireCmd.Move(p) => WireResult { tag: 1, sum: p.x + p.y },
        }
    }
}

#[wire]
type DistIdentity {
    node_id: string @1;
    location: string @2;
    incarnation: u32 @3;
}

#[wire]
enum IdentityReq {
    Inspect @0;
}

#[wire]
enum IdentityResp {
    Value(DistIdentity) @0;
}

actor IdentityProbe {
    #[wire]
    receive fn handle(_req: IdentityReq) -> IdentityResp {
        let self_pid: Result<Location, LookupError> = Node.lookup("identity");
        let identity = match self_pid {
            Result.Ok(pid) => DistIdentity { node_id: pid.node_id().display(), location: pid.display(), incarnation: pid.incarnation() },
            Result.Err(_) => DistIdentity { node_id: "", location: "", incarnation: 0 },
        };
        IdentityResp.Value(identity)
    }
}

#[wire]
enum RoleReq {
    Read @0;
    Add(i64) @1;
    Crash @2;
}

actor RoleService {
    var value: i64;
    #[wire]
    receive fn handle(request: RoleReq) -> i64 {
        match request {
            RoleReq.Read => value,
            RoleReq.Add(amount) => {
                value += amount;
                value
            }
            RoleReq.Crash => {
                let kx = os.env("HEW_DIST_KX_DIR") ?? "";
                fs.append(f"{kx}/role.calls", "x").expect("record admitted crash");
                panic("restart exported role");
            }
        }
    }
}

supervisor RoleRack {
    strategy: one_for_one;
    intensity: 3 within 60s;
    child worker: RoleService { value: 0 };
}

supervisor RoleGroup {
    child rack: RoleRack;
}

actor RoleObserver {
    var registration: Result<MonitorRef, LinkError>;
    let completed: Sink<Location>;
    receive fn arm(service: RoleService) {
        registration = monitor(service);
        assert(registration_id(registration) != 0);
    }
    #[on(down)]
    fn on_down(note: DownNotification) {
        match note.target {
            DownTarget.Remote(location) => completed.send(location).expect("one-shot role notice"),
            _ => panic("role observation lost its remote identity"),
        }
    }
}

fn scenario_server_stable_role(peer: net.PeerSession, kx: string) {
    let group = spawn RoleGroup;
    let rack = group.rack;
    let role = rack.worker;
    assert(Node.register("stable-role", role) == 0);
    let original = Node.lookup("stable-role").expect("role registration");
    let export = peer.export(role).expect("role grant");
    let _ = wait_for_file(f"{kx}/role.crashed");
    restarted(role);
    assert(role.handle(RoleReq.Read).expect("replacement") == 0);
    assert(Node.lookup("stable-role").expect("role survives restart") == original);
    assert(fs.read(f"{kx}/role.calls").expect("crash count") == "x");
    publish_atomic(kx, "role.restarted", "1");
    let _ = wait_for_file(f"{kx}/role.fresh");
    stop(rack);
    restarted(rack);
    assert(Node.lookup("stable-role").expect("nested owner replacement preserves role") == original);
    assert(role.handle(RoleReq.Read).expect("replacement nested owner") == 0);
    let new_export = peer.export(role).expect("new export after nested owner restart");
    publish_atomic(kx, "role.owner-restarted", "1");
    let _ = wait_for_file(f"{kx}/role.owner-fresh");
    stop(group);
    stopped(group);
    match Node.lookup("stable-role") {
        .Err(.NotFound) => {}
        _ => panic("closed role retained discovery"),
    }
    publish_atomic(kx, "role.closed", "1");
    let _ = wait_for_file(f"{kx}/role.done");
    new_export.close();
    export.close();
}

fn scenario_stable_role(kx: string) -> i64 {
    let service = fixture_peer().receive_service<RoleService>().expect("stable role grant");
    let original = discover_with_retry("stable-role").expect("role metadata");
    let (completed, notices): (Sink<Location>, Stream<Location>) = stream.pipe(1).expect("role notices");
    let observer = spawn RoleObserver { registration: .Err(.NoContext), completed: completed };
    observer.arm(service).expect("monitor role");
    assert(service.handle(RoleReq.Add(5)).expect("first worker") == 5);
    match service.handle(RoleReq.Crash) {
        .Err(_) => {}
        _ => panic("crashed call replayed or completed"),
    }
    assert(notices.recv().expect("selected worker completed") == original);
    publish_atomic(kx, "role.crashed", "1");
    let _ = wait_for_file(f"{kx}/role.restarted");
    assert(Node.lookup("stable-role").expect("same role metadata") == original);
    assert(service.handle(RoleReq.Read).expect("same grant replacement") == 0);
    assert(service.handle(RoleReq.Add(7)).expect("fresh role call") == 7);
    publish_atomic(kx, "role.fresh", "1");
    let _ = wait_for_file(f"{kx}/role.owner-restarted");
    assert(service.handle(RoleReq.Read).expect("existing grant after nested owner restart") == 0);
    let new_service = fixture_peer().receive_service<RoleService>().expect("new grant after owner restart");
    assert(new_service.handle(RoleReq.Add(9)).expect("new export call") == 9);
    assert(service.handle(RoleReq.Read).expect("same semantic target") == 9);
    publish_atomic(kx, "role.owner-fresh", "1");
    let _ = wait_for_file(f"{kx}/role.closed");
    match service.handle(RoleReq.Read) {
        .Err(_) => {}
        _ => panic("closed role retained call authority"),
    }
    publish_atomic(kx, "role.done", "1");
    println("PASS stable_role same-location same-grant one-shot-monitor no-replay replacement-call nested-owner-restart new-export owner-close");
    0
}

// Route capacity is a wire boundary; ordinary local actors retain their values.
actor SizeProbe {
    var calls: i64 = 0;
    var remembered_len: i64 = 0;
    #[wire]
    receive fn accept(value: string) -> i64 {
        calls += 1;
        value.len()
    }
    #[wire]
    receive fn expanded(values: Vec<i64>) -> i64 {
        calls += 1;
        values.len()
    }
    #[wire]
    receive fn record(value: string) {
        calls += 1;
        remembered_len = value.len();
    }
    #[wire]
    receive fn reply(size: i64) -> string {
        calls += 1;
        "r".repeat(size)
    }
    #[wire]
    receive fn decline(size: i64) -> i64 fails string {
        calls += 1;
        return error "e".repeat(size);
    }
    #[wire]
    receive fn held(kx: string) -> i64 {
        publish_atomic(kx, "size.pending", "1");
        let _ = wait_for_file(f"{kx}/size.release");
        calls += 1;
        42
    }
    #[wire]
    receive fn count() -> i64 {
        calls
    }
    #[wire]
    receive fn last_len() -> i64 {
        remembered_len
    }
}

actor SizeWaiter {
    let service: SizeProbe;
    let completed: Sink<i64>;
    receive fn run(kx: string) {
        let value = service.held(kx).expect("pending call survives unrelated size refusal");
        completed.send(value).expect("pending call completion");
    }
}

fn scenario_server_message_size(peer: net.PeerSession, kx: string) {
    let service = spawn SizeProbe;
    let export = peer.export(service).expect("size grant");
    let _ = wait_for_file(f"{kx}/size.done");
    assert(service.count().expect("exact remote executions") == 6);
    export.close();
    stop(service);
    stopped(service);
}

fn scenario_mesh_large(kx: string) -> i64 {
    let peer = fixture_peer();
    let service: SizeProbe = peer.receive_service<SizeProbe>().expect("mesh size service");
    assert(service.accept("x".repeat(131072)).expect("large mesh request") == 131072);
    assert(service.accept("after").expect("following request") == 5);
    assert(service.reply(131072).expect("large mesh reply") == "r".repeat(131072));
    assert(service.reply(5).expect("following reply") == "rrrrr");
    match service.decline(131072) {
        .Err(ActorError.Failed(value)) => assert(value == "e".repeat(131072)),
        _ => panic("large mesh declared error changed"),
    }
    assert(service.accept("final").expect("following declared error") == 5);
    assert(service.count().expect("each handler ran once") == 6);
    publish_atomic(kx, "size.done", "1");
    println("PASS mesh_large request reply declared-error following-frame no-replay");
    0
}

fn scenario_message_size(kx: string) -> i64 {
    let service = fixture_peer().receive_service<SizeProbe>().expect("size grant");
    let local = spawn SizeProbe;
    assert(local.accept("x".repeat(70000)).expect("local values do not use Noise framing") == 70000);
    assert(local.reply(70000).expect("large local reply").len() == 70000);
    match local.decline(70000) {
        .Err(ActorError.Failed(value)) => assert(value.len() == 70000),
        _ => panic("local declared failure acquired a transport cap"),
    }
    assert(service.accept("small").expect("initial call") == 5);
    let (completed, completion): (Sink<i64>, Stream<i64>) = stream.pipe(1).expect("pending size call");
    let waiter = spawn SizeWaiter { service: service, completed: completed };
    mailbox(waiter).run(kx).expect("start unrelated pending call");
    let _ = wait_for_file(f"{kx}/size.pending");
    match service.accept("x".repeat(70000)) {
        .Err(ActorError.MessageTooLarge) => {}
        _ => panic("oversized request lacked its typed failure"),
    }
    match mailbox(service, on_full: .Reject).record("retained".repeat(10000)) {
        .Err(ActorError.Rejected(failure)) => {
            assert(failure.reason == SendError.MessageTooLarge);
            failure.message.to(local).expect("unaccepted request moves to local actor");
        }
        _ => panic("oversized submission lost its unaccepted request"),
    }
    assert(local.last_len().expect("sealed request preserved its value") == 80000);
    match policy(service, on_full: .Reject).accept("q".repeat(70000)) {
        .Err(ActorError.Rejected(failure)) => {
            assert(failure.reason == SendError.MessageTooLarge);
            assert(failure.message.to(local).expect("unaccepted completion redirects locally") == 70000);
        }
        _ => panic("oversized reject-policy call lost its request"),
    }
    // The native vector storage fits the Noise plaintext capacity, but its
    // CBOR elements expand to nine bytes each. Check complete encoded size.
    var expanded: Vec<i64> = Vec.new();
    for i in 0..8000 {
        expanded.push(9223372036854775807);
    }
    match service.expanded(expanded) {
        .Err(ActorError.MessageTooLarge) => {}
        _ => panic("encoded expansion escaped the route limit"),
    }
    publish_atomic(kx, "size.release", "1");
    assert(completion.recv().expect("unrelated pending call retained") == 42);
    assert(service.count().expect("requests refused before claim") == 2);
    match policy(service, on_full: .Reject).reply(70000) {
        .Err(ActorError.MessageTooLarge) => {}
        _ => panic("oversized reply did not produce a terminal failure"),
    }
    match service.decline(70000) {
        .Err(ActorError.MessageTooLarge) => {}
        _ => panic("oversized declared error did not produce a terminal failure"),
    }
    assert(service.count().expect("reply handlers executed once") == 4);
    assert(service.reply(3).expect("connection survives size failures") == "rrr");
    match service.decline(3) {
        .Err(ActorError.Failed(value)) => assert(value == "eee"),
        _ => panic("small declared error changed after size refusal"),
    }
    assert(service.count().expect("no replay or truncation") == 6);
    stop(waiter);
    stopped(waiter);
    stop(local);
    stopped(local);
    publish_atomic(kx, "size.done", "1");
    println("PASS message_size local-large request-refused retained-request encoded-expansion reply-failed declared-error connection-survives no-replay");
    0
}

// ── Cross-node link ───────────────────────────────────────────────────────────
//
// The link scenarios prove the OTP "linked processes die together" semantic
// across the node boundary: a LOCAL actor links a REMOTE actor with
// `set_partition_policy(PartitionPolicy.CrashLinked)` and `link(actor)`, and when the remote actor
// dies (clean exit, crash, or partition) the LOCAL linked actor CRASHES too.
//
// The headline divergence from monitor: a `CrashLinked` link-down lands in the
// local actor's MAILBOX as a HewSysMsg::Exit and crashes a non-trapping actor — it
// does NOT land in a monitor recv slot (a link that reused the monitor recv-slot
// delivery would fail-OPEN: the linked actor would never crash). The fixture
// proves the crash by LOCALLY monitoring the linker actor from `main`: when the
// cross-node link-down crashes the linker, the local monitor observes a DOWN
// carrying the Crashed reason (5). A non-`CrashLinked` policy must NOT crash the
// linker — that negative case gives the policy discriminator teeth.
//
// `Linker` holds the remote KeyValue pid and a policy selector; on a `link_go`
// ask it establishes the cross-node link from inside its own handler (so the
// implicit `self` subject of `link` is THIS actor — the one that must
// crash on the remote's death). The ask reply is the linker's own actor id, so
// `main` learns the id to poll its terminal state after the remote dies.
//
// `main` then polls `hew_link_probe_terminal_state(linker_id)`: the runtime
// records each actor's terminal reason in a probe-only ledger (gated by
// HEW_LINK_PROBE), so the death survives the actor's free. A `CrashLinked`
// cascade records Crashed (5); a survivor never reaches terminal (sentinel).
extern "C" {
    fn hew_link_probe_terminal_state(actor_id: i64) -> i64;
    fn hew_dist_bound_port() -> i64;
}

// Test-introspection probes for the SWIM rejoin-admission gate: drive a gossip
// entry into the local cluster, read a peer's membership state, and read whether a
// peer is quarantined. These let the rejoin scenario exercise the admission gate
// deterministically (no failure-detector race).
extern "C" {
    fn hew_dist_inject_swim_gossip(node_id: u16, state: i32, incarnation: u64) -> i64;
    fn hew_dist_member_state(node_id: u16) -> i64;
    fn hew_dist_quarantine_contains(node_id: u16) -> i64;
    // Deterministic partition seam for scenario_partition_ask: fail every pending
    // remote ask CLOSED with Partition through the production reply-table fan-out
    // (the same seam the SWIM-DEAD verdict reaches). Returns the count failed (0
    // when none are pending yet). Not user-callable.
    fn hew_dist_partition_pending_remote_asks() -> i64;
    // Shutdown-phase probe: 1 once main-exit teardown has begun, else 0. Lets
    // the PartitionInjector's bounded poll stand down instead of holding the
    // shutdown drain open as outstanding work.
    fn hew_is_shutting_down() -> i32;
}

// Deterministic partition seam for `scenario_partition_ask`. A fire-and-forget
// injector that, the instant the client's remote ask registers as pending,
// resolves it CLOSED with Partition through the production reply-table fan-out
// (`hew_dist_partition_pending_remote_asks`). This removes the dependence on the
// OS socket-teardown detector and the SWIM failure detector — whose latency is
// unbounded under host load — that otherwise made the typed fail-closed verdict
// race the ask deadline (the historical source of this test's flake).
//
// The harness still kills the server (a real teardown), so the route genuinely
// dies; the injector fixes only WHEN the in-flight ask is failed closed, not
// WHETHER. The fan-out's teeth live in scenario_partition_ask phase A: the
// stalled ask there is resolvable ONLY by this probe (route live, reply held
// past the deadline), so a broken/no-op fan-out surfaces as a deadline
// timeout -> FAIL — it cannot hide behind the kill's routing-failure or
// socket-drop outcomes, which resolve phase B's ask regardless.
actor PartitionInjector {
    receive fn arm() {

        // Poll until a remote ask is pending, then fail it closed via the
        // production fan-out. Bounded (~30s, under the harness 40s cap) so a true
        // deadlock surfaces as a timeout rather than an infinite spin; on give-up
        // the ask falls back to the socket / failure-detector path (the original
        // behaviour) -- never a fabricated success.
        var spins: i64 = 0;
        loop {
            let failed = unsafe {
                hew_dist_partition_pending_remote_asks()
            };
            if failed >= 1 {
                return;
            }
            // Stand down once main-exit teardown begins: the ask this poller
            // exists to partition has already resolved (or never registered —
            // the send itself failed), and a poller still sleep-parking here
            // is outstanding work that would hold the shutdown drain open to
            // its timeout and turn the client's clean exit into a failure.
            let shutting_down = unsafe {
                hew_is_shutting_down()
            };
            if shutting_down != 0 {
                return;
            }
            spins = spins + 1;
            if spins >= 15000 {
                return;
            }
            sleep(2ms);
        }
    }
}

actor RemoteCrashObserver {
    let expected: Location;
    var notices: i64 = 0;

    receive fn attach(peer: KeyValue) -> Result<(), LinkError> {
        assert(set_partition_policy(PartitionPolicy.CrashLinked));
        link(peer)
    }

    receive fn count() -> i64 {
        notices
    }

    #[on(link)]
    fn on_link(note: CrashNotification) {
        match note.target {
            DownTarget.Remote(location) => {
                assert(location == expected);
            }
            DownTarget.Local(_) => panic("remote link reported a local origin"),
            DownTarget.Role(_) => panic("remote link reported a local role origin"),
        }
        assert(note.kind == CrashKind.Fault);
        notices = notices + 1;
    }
}

actor Linker {
    // 0 = CrashLinked (the linked actor crashes); 1 = MonitorLost (non-fatal).
    let policy_sel: i64;

    // Establish the cross-node link from inside this actor's own handler so the
    // implicit `self` subject of `link` is THIS actor. The remote peer is
    // passed as a message argument rather than retained in actor state. Returns
    // its own process-local actor id (or 0 on registration failure) so `main`
    // can poll its terminal state.
    receive fn link_go(peer: KeyValue) -> i64 {
        let policy = if policy_sel == 0 {
            PartitionPolicy.CrashLinked
        } else {
            PartitionPolicy.MonitorLost
        };
        assert(set_partition_policy(policy));
        let status = link(peer);
        let ok = match status {
            Result.Ok(_) => true,
            Result.Err(_) => false,
        };
        // Return this actor's process-local runtime id on success, 0 on failure.
        if ok {
            unsafe {
                hew_actor_self_id()
            }
        } else {
            0
        }
    }
    // Liveness probe: a surviving linker answers; a crashed one cannot.
    receive fn ping() -> i64 {
        7
    }
    receive fn crash_local() -> i64 {
        panic("local Linker crash");
        0
    }
}

// The registration id of a held monitor. The state seat keeps the MonitorRef
// live, so the id is read through a borrow rather than moved out of the seat.
fn registration_id(setup: Result<MonitorRef, LinkError>) -> u64 {
    match setup {
        Result.Ok(monitor_ref) => monitor_ref.id().value,
        Result.Err(_) => 0,
    }
}

fn local_registration_id(setup: Result<MonitorRef, LinkError>) -> u64 {
    match setup {
        Result.Ok(monitor_ref) => monitor_ref.id().value,
        Result.Err(_) => 0,
    }
}

actor MonitorProbe {
    var active_monitor: Result<MonitorRef, LinkError>;
    var expected_monitor_id: u64 = 0;
    var down_count: i64 = 0;
    var down_reason: i64 = 100;
    let expect_remote: bool = true;

    // drive: 0 = clean stop, 1 = crash, 2 = leave target alive.
    receive fn arm(peer: KeyValue, drive: i64) -> i64 {
        active_monitor = monitor(peer);
        expected_monitor_id = registration_id(active_monitor);
        if expected_monitor_id == 0 {
            return 1;
        }
        if drive == 0 {
            match mailbox(peer).stop_self() {
                Result.Ok(_) => 0,
                Result.Err(_) => 2,
            }
        } else {
            if drive == 1 {
                match mailbox(peer).crash_self() {
                    Result.Ok(_) => 0,
                    Result.Err(_) => 3,
                }
            } else {
                0
            }
        }
    }
    receive fn status() -> i64 {
        if down_count == 0 {
            100
        } else {
            if down_count == 1 {
                down_reason
            } else {
                -99
            }
        }
    }
    receive fn monitor_id() -> u64 {
        expected_monitor_id
    }

    // ── Strict TCP-Noise credential staging (issue #2652) ───────────────────────
    //
    // Both processes run under strict peer binding: plain TCP is Unverified
    // (delivery-only) and cannot lookup / ask / gossip / SWIM. Each node mints a
    // stable Noise identity, publishes its public credential to a shared key-
    // exchange directory, waits for the peer's, and binds it with allow_peer BEFORE
    // the handshake — a real mutual authenticated pin, never an injected posture.
    // The allow_peer integer is a receiver-local route slot, not distributed identity.

    // Atomically publish `content` at `<dir>/<name>` via temp-then-rename, so a
    // reader polling for the file never observes a partial write.

    // Bounded poll for a published file, returning its contents (or "" on timeout).
    // ~30 s ceiling (600 * 50 ms) — generous for a warm host while still failing
    // closed if the peer never publishes.

    // Mint this node's stable Noise identity, publish its identity_key() for the
    // peer to pin, wait for the peer's published credential, and bind it to a
    // receiver-local route slot. Runs before Node::start so the listener and the
    // handshake adopt the staged allowlist (config locks once Starting/Running).

    // Server → client listener-liveness signal. The client waits on this before it
    // connects, because it cannot observe the harness READY line.

    // Bounded poll for the remote actor: retry Node::lookup until registry gossip
    // resolves it, instead of a single fixed-interval sleep. ~50 attempts at 100 ms
    // = 5 s deadline, generous for loopback gossip while still failing closed if the
    // peer never registers.

    // Same bounded poll, typed for the WireProbe actor (the #[wire] scenario).

    // Strict TCP-Noise: mint this node's stable Noise identity, publish its
    // public credential for the peer to pin, and bind the client credential to
    // receiver-local route slot 2 before the listener adopts the allowlist.

    // Also register the #[wire] probe actor so the wire_cbor scenario has a
    // remote target. Registering both keeps run_server scenario-independent.

    // Listener-liveness signal: emitted ONLY after the actors are registered.
    // The client waits on this file before it connects, because it cannot
    // observe the harness READY line and a failed one-shot connect is not
    // retried.

    // Readiness signal: emitted ONLY after the actors are registered, so the
    // harness never launches the client against a half-started node.

    // For this scenario the server drives the assertion: poll the watcher
    // count until it drops to 0 (prune fired) and print the result.
    // The harness reads this PASS line from the server's stdout.

    // The server watches its target-side count rise then fall after
    // the client closes its cross-node monitor (CTRL_DEMONITOR received).

    // After the client captures the original actor's pid, re-point
    // "kv" to a DIFFERENT live actor. Future lookups must observe the
    // replacement while the already-issued Location remains valid.

    // All other scenarios: stay alive until the harness kills us.

    // Scenario: remote_ask
    //
    // The client connects, puts two entries via fire-and-forget send, then issues
    // two blocking remote asks and checks the exact returned values. This is the
    // first assertion: a real cross-process ask round-trip with exact-value teeth.

    // Brief settle so the fire-and-forget sends are applied before the ask.
    // (send is async; the ask below is the synchronization point we assert on.)

    // Scenario: wire_cbor
    //
    // Sends a #[wire] enum (WireCmd) with EXPLICIT @N variant tags via two remote
    // asks — a payload variant (Move, the map-of-one body) and a unit variant (Ping,
    // the bare-tag body) — and checks the #[wire] struct reply (WireResult, an
    // @N-keyed map) field-by-field. This is the distinct thing this scenario proves: an
    // explicit-@N tagged CBOR body crossing two OS processes in both directions,
    // which the plain-record/enum remote_ask scenario does not exercise.

    // Payload variant: Move(WirePoint { x: 3, y: 4 }) → server replies
    // WireResult { tag: 1, sum: 7 }.

    // Unit variant: Ping → server replies WireResult { tag: 0, sum: 0 }.

    // Scenario: identity_location
    //
    // Proves the runtime identity tuple across two OS processes. Registry gossip
    // yields an exact remote Location whose node key and slot match the actor's
    // self-reported identity and whose node key is distinct from this client.

    // Scenario: remote_monitor_clean_exit
    //
    // The client monitors the remote KeyValue actor, then tells it to stop. The
    // monitor must deliver exactly one DOWN carrying the clean-exit reason (6).

    // Scenario: remote_monitor_crash
    //
    // The client monitors the remote KeyValue actor, then tells it to crash. The
    // monitor must deliver exactly one DOWN carrying the crash reason (5).

    // Scenario: remote_monitor_conn_drop
    //
    // The client monitors the remote actor, then the harness kills the server
    // process. The monitor must deliver exactly one DOWN carrying the MonitorLost
    // sentinel (-1) for the connection-drop / partition cause — distinct from the
    // clean-exit and crash reasons.

    // Scenario: remote_monitor_setup_after_drop
    //
    // The harness kills the server after READY_DROP. Once route teardown reaches the
    // client, monitor(actor) must succeed and deliver an immediate
    // MonitorLost DOWN rather than hand back an inert MonitorRef.

    // Scenario: partition_ask
    //
    // The partition gate, in two phases.
    //
    // Phase A (probe proof): with the route still LIVE, the client asks
    // KvReq::Stall — the server holds the reply past the ask's whole deadline —
    // so the armed partition probe's fan-out is the ONLY path that can resolve
    // the pending ask early. Phase A REQUIRES reason=Partition, fast: it proves
    // the armed probe actually fired. A sabotaged/no-op fan-out times out here
    // and FAILS; it cannot hide behind the kill's teardown outcomes.
    //
    // Phase B (real teardown): the client signals READY_DROP so the harness can
    // kill the server (dropping the route to the peer), then issues a remote ask
    // to the now-unreachable actor. The invariant under test is: the ask FAILS
    // CLOSED — it resolves to a typed ActorError without hanging — rather than
    // blocking to the client ceiling or fabricating a value.
    //
    // The EXACT fail-closed cause is timing-dependent: a two-process SIGKILL races
    // three independent fail paths, any of which is a correct fail-closed verdict
    // for a peer that is gone:
    //   * RoutingFailed   — the reader thread tore down the route before the ask was
    //                       set up, so the ask is refused before it leaves the node.
    //   * ConnectionDropped — the socket-drop path failed the pending ask.
    //   * Partition       — the SWIM failure detector declared the peer dead and
    //                       fanned out to the pending ask (the deterministic
    //                       socket-open-but-peer-dead path).
    //   * NodeNotRunning / SendFailed / StaleRef — narrower fail-closed races on the
    //                       same teardown.
    // Which one wins shifts with host load (under CI load RoutingFailed dominates;
    // on a quiet host the ask is more often still pending and surfaces as
    // ConnectionDropped). The gate therefore accepts ANY fail-closed cause EXCEPT
    // Timeout: a Timeout means the ask waited its WHOLE deadline because none of the
    // proactive fail-closed paths fired — that is the hang-to-deadline this gate
    // exists to catch, so it is retried (in case the verdict is mid-propagation)
    // and then fails.
    //
    // Teeth that remain: (a) a Result::Ok after READY_DROP is rejected (the route is
    // still live — never-partitioned), so a wrong success cannot pass; (b) every ask
    // carries a 1 s timeout, so an unresolved ask cannot hang past that, and the
    // whole scenario is bounded far under the 40 s client ceiling; (c) the resolving
    // fast-fail must return BEFORE its own 1 s deadline (no-hang bound, asserted
    // explicitly), so a fail-closed-by-timeout cannot masquerade as a proactive one.
    //
    // The deterministic SWIM-DEAD-while-socket-open Partition path is proven exactly
    // in-process by the runtime unit test
    // `swim_dead_wakes_pending_remote_ask_with_partition`; this two-process fixture
    // pins the broader no-hang + typed-fail-closed invariant across the wire.

    // Signal the harness to kill the server now that the route is established.

    // Arm the deterministic partition seam: a concurrent injector fails the
    // in-flight remote ask closed with Partition through the production
    // reply-table fan-out the instant it registers, so the typed fail-closed
    // verdict no longer races the socket-teardown / SWIM detector latency (the
    // historical source of this test's flake). The harness kill above is the real
    // teardown; the injector only bounds WHEN the pending ask is failed closed,
    // never WHETHER. The reply table holds only application asks (the lookup that
    // resolved `kv` already completed), so the sole pending entry is this scenario's
    // `kv.ask` — draining it cannot disturb any healthy in-flight request.

    // Per-ask timeout: an unresolved ask cannot block longer than this, so even a
    // pure Timeout is bounded far under the client ceiling — the no-hang floor.

    // No-hang bound: a PROACTIVE fail-closed verdict resolves the ask well before
    // its own deadline. If an Err comes back only at (or past) the full timeout,
    // the proactive path did not fire — treat it as a Timeout, not a fast-fail.

    // The route is still live (kill in flight) — a success here is
    // NOT a partition. Retry briefly; never accept it as a pass.

    // A Timeout — or any Err that only surfaced at the full deadline —
    // means no proactive fail-closed path fired (a hang-to-deadline).
    // Retry a bounded number of times in case the verdict is still
    // propagating, then fail.

    // A proactive, fast typed fail-closed verdict — the invariant
    // holds. Name the cause for diagnostics; any of these is a
    // correct outcome for a peer that is gone.

    // Scenario: repoint_preserves_ref
    //
    // The client seeds the ORIGINAL actor, then waits until a future lookup returns a
    // DIFFERENT exact Location. The captured ref must still address the original
    // live actor, while the replacement starts with independent state.

    // Scenario: monitor_watcher_node_death
    //
    // Two-process fixture: the watcher node dies and the target-side
    // RemoteWatcher entries it registered are pruned, keeping the table bounded.
    //
    // Server role: registers the target actor, prints READY, then polls
    // hew_dist_monitor_remote_watcher_count() until it drops to 0 (the prune
    // fired) and prints the exact count that was registered before the death.
    // Target actor stays alive and re-monitorable afterward.
    //
    // Client role: connects, registers a monitor on the server's "kv" actor,
    // prints READY_CLIENT_WATCHER so the harness knows the watch is live, then
    // sleeps until the harness kills it. The kill simulates a watcher-node crash.

    // Phase 1: wait until at least one RemoteWatcher entry appears (the client
    // connected and registered its monitor via CTRL_MONITOR_REQ).

    // Signal that the monitor registration has been received and processed.
    // The harness reads this line before killing the client, ensuring the
    // kill arrives after — not before — the target-side entry is recorded.

    // Emit diagnostic count to distinguish no-runtime (-1) from table-empty (0).

    // Phase 2: poll until the count drops back to 0 (prune fired on connection-drop).

    // Table is empty: the prune fired correctly.

    // ── Cross-node link scenarios ────────────────────────────────────────────────

    // Spawn a Linker, send it to establish the cross-node link (capturing its actor
    // id from the reply), drive the remote actor to a terminal state, then poll the
    // linker's terminal state. With CrashLinked the linker must reach Crashed (5):
    // the cross-node link-down landed in its mailbox as a HewSysMsg::Exit and crashed
    // it. `policy_sel` 0 = CrashLinked. `drive` selects how the remote dies.

    // Establish the link from inside the linker's own handler; the reply is its
    // actor id (or -1 on a registration failure).

    // Drive the remote actor to its terminal state per the scenario.

    // drive == "partition": the harness kills the server; nothing to send.

    // Signal readiness so the harness kills the server now that the link is
    // established. The remote actor stays alive; only the connection drops.

    // Poll the linker's terminal state until the cascade crashes it (or a bound
    // elapses). The probe returns the recorded terminal reason or -999 while live.

    // Reached a terminal state other than Crashed — unexpected for a
    // CrashLinked cascade (a clean Stopped would be a fail-open bug).

    // Negative case: a non-CrashLinked link policy (MonitorLost) must NOT crash the
    // linker when the remote dies. After driving the remote to a clean exit, the
    // linker must STILL answer a liveness ask — proving the policy discriminator has
    // teeth and a non-CrashLinked link does not synthesize a fatal EXIT.

    // Give the cross-node link-down ample time to (wrongly) crash the linker.

    // The probe must NOT report a terminal state — the linker survived.

    // Liveness confirmation: a surviving linker still answers an ask.

    // Cross-node demonitor reclamation (server-driven, mirrors the watcher-node-death
    // proof). The client monitors the remote actor, then explicitly
    // closes the MonitorRef. The close must route to the cross-node teardown (not
    // the local-table no-op), sending a CTRL_DEMONITOR to the peer. The SERVER
    // observes its target-side entry appear (count>0) then disappear (count==0)
    // after the demonitor — proving the close reached the peer (the watcher-side
    // entry was reclaimed locally AND the peer was told). The server prints the
    // PASS; this client just registers, signals ready, closes, and exits cleanly.

    // Scenario: quarantine_rejoin
    //
    // Proves the fail-closed rejoin-admission boundary through the full compiled
    // stack. A buried peer (DEAD) is quarantined; a stale (<=-incarnation) ALIVE
    // gossip replay must NOT resurrect it, while a strictly-higher-incarnation rejoin
    // IS admitted and evicts the quarantine entry. The membership gossip frames are
    // driven deterministically through the runtime so there is no failure-detector
    // race; the resurrection-guard negative half is the assertion with teeth.
    //
    // MEMBER_* states: ALIVE = 0, DEAD = 2.

    // Establish the peer ALIVE at incarnation 5, then bury it (DEAD at 5). The
    // DEAD verdict quarantines it at incarnation 5.

    // Negative half (the resurrection guard): a stale ALIVE replay at an
    // incarnation <= the buried one must NOT resurrect the peer. Try equal (5) and
    // lower (4); after each the peer must stay DEAD and quarantined.

    // Positive half: a strictly-higher-incarnation rejoin (6 > 5) IS admitted;
    // the peer returns ALIVE and the quarantine entry is evicted.

    // Strict TCP-Noise: bind the server credential to receiver-local route slot
    // 1 before connecting.

    // Wait for the server's listener to be live: a failed one-shot connect is
    // not retried, so connecting before the server binds would fail closed.

    // Connect using the server's configured route slot; admission derives and
    // verifies the peer NodeId from the authenticated Noise key.

    // Scenario dispatch. New scenarios add a branch here plus a scenario_*
    // function above; the harness selects via HEW_DIST_SCENARIO. The #[wire]
    // scenario targets the WireProbe actor ("wire"); the rest target KeyValue
    // ("kv").

    // Membership-gate scenario: driven entirely through injected gossip on the
    // local cluster, so it needs no remote actor lookup.
    #[on(down)]
    fn on_down(note: DownNotification) {
        down_count = down_count + 1;
        if note.monitor.value != expected_monitor_id {
            down_reason = -98;
            return;
        }
        let remote = match note.target {
            DownTarget.Remote(_) => true,
            DownTarget.Local(_) => false,
            DownTarget.Role(_) => false,
        };
        if remote != expect_remote {
            down_reason = -97;
            return;
        }
        down_reason = match note.reason {
            DownReason.Stopped => 6,
            DownReason.Terminated => 7,
            DownReason.Crashed(_) => 5,
            DownReason.MonitorLost => -1,
            DownReason.LocalShutdown => -3,
        };
    }
}

actor SetupRaceStopper {
    let monitor_target: KeyValue;
    let link_target: KeyValue;
    receive fn run() {
        var monitor_stopped = false;
        var link_stopped = false;
        loop {
            let kind = unsafe {
                hew_dist_setup_race_kind()
            };
            if kind == 1 && !monitor_stopped {
                let _ = monitor_target.handle(KvReq.StopSelf);
                monitor_stopped = true;
            }
            if kind == 2 && !link_stopped {
                let _ = link_target.handle(KvReq.StopSelf);
                link_stopped = true;
            }
            if monitor_stopped && link_stopped {
                return;
            }
            sleep(1ms);
        }
    }
}

actor LinkSetupRaceProbe {
    // `monitor()` on a LOCAL pid (the linker below is `spawn`ed, not remote)
    // returns the same Result<MonitorRef, LinkError> for imported actors.
    var active_monitor: Result<MonitorRef, LinkError>;
    var expected_monitor_id: u64 = 0;
    var down_count: i64 = 0;
    var down_reason: i64 = 100;
    receive fn arm(peer: KeyValue) -> i64 {
        let linker = spawn Linker { policy_sel: 0 };
        active_monitor = monitor(linker);
        expected_monitor_id = local_registration_id(active_monitor);
        if expected_monitor_id == 0 {
            return 0;
        }
        match linker.link_go(peer) {
            Result.Ok(linker_id) => linker_id,
            Result.Err(_) => 0,
        }
    }
    receive fn status() -> i64 {
        if down_count == 0 {
            100
        } else {
            if down_count == 1 {
                down_reason
            } else {
                -99
            }
        }
    }
    #[on(down)]
    fn on_down(note: DownNotification) {
        down_count = down_count + 1;
        if note.monitor.value != expected_monitor_id {
            down_reason = -98;
            return;
        }
        match note.target {
            DownTarget.Local(_) => {}
            DownTarget.Role(_) => {}
            DownTarget.Remote(_) => {
                down_reason = -97;
                return;
            }
        }
        down_reason = match note.reason {
            DownReason.Crashed(_) => 5,
            DownReason.Stopped => 6,
            DownReason.Terminated => 7,
            DownReason.MonitorLost => -1,
            DownReason.LocalShutdown => -3,
        };
    }
}

actor MonitorCloseProbe {
    receive fn register_and_close(peer: KeyValue) -> i64 {
        let setup: Result<MonitorRef, LinkError> = monitor(peer);
        match setup {
            Result.Err(_) => 1,
            Result.Ok(monitor_ref) => {
                println("READY_CLIENT_WATCHER cross_node_monitor_close_reclaim");
                sleep(800ms);
                monitor_ref.close();
                sleep(800ms);
                0
            }
        }
    }
}

actor MonitorLeakProbe {
    var down_count: i64 = 0;
    receive fn run(peer: KeyValue, iterations: i64) -> i64 {
        var completed: i64 = 0;
        var previous_id: u64 = 0;
        while completed < iterations {
            let setup: Result<MonitorRef, LinkError> = monitor(peer);
            match setup {
                Result.Err(_) => return -1,
                Result.Ok(monitor_ref) => {
                    let monitor_id = monitor_ref.id().value;
                    if monitor_id == 0 || monitor_id <= previous_id {
                        return -2;
                    }
                    previous_id = monitor_id;
                    sleep(10ms);
                    monitor_ref.close();
                }
            }
            if unsafe {
                hew_dist_monitor_pending_observation_count()
            } != 0 {
                return -3;
            }
            completed = completed + 1;
        }
        sleep(100ms);
        if down_count != 0 {
            return -4;
        }
        completed
    }
    #[on(down)]
    fn on_down(_note: DownNotification) {
        down_count = down_count + 1;
    }
}

fn publish_atomic(dir: string, name: string, content: string) {
    let tmp = f"{dir}/{name}.tmp";
    let _ = fs.write(tmp, content);
    let _ = fs.rename(tmp, f"{dir}/{name}");
}

fn wait_for_file(path: string) -> string {
    var attempts: i64 = 0;
    loop {
        if fs.exists(path) {
            match fs.read(path) {
                .Ok(contents) => {
                    if !contents.is_empty() {
                        return contents;
                    }
                }
                .Err(_) => {}
            }
        }
        attempts = attempts + 1;
        if attempts >= 600 {
            return "";
        }
        sleep(50ms);
    }
}

// Load this node's identity and its operator-issued cluster enrolment.
fn start_admitted(kx: string, my_role: string, peer_role: string, bind: string) {
    let key = f"{kx}/{my_role}.key";
    let _ = wait_for_file(f"{kx}/{peer_role}.pub");
    let cluster = if (os.env("HEW_DIST_FOREIGN_CLUSTER") ?? "") == "1" {
        f"{kx}/{my_role}.foreign.enrollment"
    } else {
        f"{kx}/{my_role}.enrollment"
    };
    let active_scenario = os.env("HEW_DIST_SCENARIO") ?? "";
    let seed_scenario = active_scenario == "persistent_seed" || active_scenario == "persistent_seed_stop";
    if seed_scenario && my_role == "server" {
        let _ = wait_for_file(f"{kx}/seed.start-server");
    }
    let seeds = if active_scenario == "transitive_restart" && my_role == "relay" {
        let port = os.env("HEW_DIST_ORIGIN_PORT").expect("origin seed");
        [f"127.0.0.1:{port}"]
    } else if seed_scenario && my_role == "client" {
        let port = os.env("HEW_DIST_SEED_PORT") ?? "";
        [f"127.0.0.1:{port}"]
    } else {
        Vec.new()
    };
    let transport = if (os.env("HEW_DIST_TRANSPORT") ?? "tcp") == "quic-mesh" {
        NodeTransport.QuicMesh
    } else {
        NodeTransport.Tcp
    };
    let config = NodeConfig { bind: bind, transport: transport, key: key, cluster: cluster, seeds: seeds };
    match Node.start(config) {
        Result.Ok(_) => {}
        Result.Err(_) => {
            println(f"FAIL {my_role} admitted-start");
            exit(2);
        }
    }
}

/// The port the server's listener is bound to, published for the client.
fn signal_server_listening(kx: string) -> string {
    let port = f"{unsafe { hew_dist_bound_port() }}";
    publish_atomic(kx, "server.ready", port);
    port
}

/// The port the server published once it was listening.
fn wait_for_server_listening(kx: string) -> string {
    wait_for_file(f"{kx}/server.ready")
}

fn fixture_peer() -> net.PeerSession {
    authenticated_peer()
}

fn discover_with_retry(name: string) -> Result<Location, LookupError> {
    for _ in 0..300 {
        match Node.lookup(name) {
            .Ok(location) => return .Ok(location),
            .Err(_) => sleep(20ms),
        }
    }
    Node.lookup(name)
}

fn run_server(scenario: string) {
    let kx = os.env("HEW_DIST_KX_DIR") ?? "";
    // A replacement server comes back on the port its predecessor published.
    let base_addr = if (os.env("HEW_DIST_RESTARTED") ?? "") == "1" {
        f"127.0.0.1:{wait_for_server_listening(kx)}"
    } else {
        "127.0.0.1:0"
    };
    let addr = if scenario == "persistent_seed" {
        let port = os.env("HEW_DIST_SEED_PORT") ?? "";
        f"127.0.0.1:{port}"
    } else {
        base_addr
    };
    start_admitted(kx, "server", "client", addr);
    let s: HashMap<string, string> = HashMap.new();
    let kv = spawn KeyValue { store: s };
    Node.register("kv", kv);
    let wp = spawn WireProbe { calls: 0 };
    Node.register("wire", wp);
    let identity = spawn IdentityProbe;
    Node.register("identity", identity);
    let port = signal_server_listening(kx);
    if (os.env("HEW_DIST_RESTARTED") ?? "") == "1" {
        publish_atomic(kx, "server.restarted", "1");
    }
    println(f"READY {port}");
    let peer = if scenario == "handshake_reject" || scenario == "quarantine_rejoin" {
        sleep(2m);
        return;
    } else {
        fixture_peer()
    };
    if scenario == "remote_stopped_crash" || scenario == "remote_stopped_cleanup_fault" {
        scenario_server_remote_stopped(kx, scenario == "remote_stopped_cleanup_fault");
        Node.shutdown();
        return;
    }
    if scenario == "service_grants" {
        scenario_server_service_grants(kx);
        Node.shutdown();
        return;
    }
    if scenario == "message_size" || scenario == "mesh_large" {
        scenario_server_message_size(peer, kx);
        Node.shutdown();
        return;
    }
    if scenario == "stable_role" {
        scenario_server_stable_role(peer, kx);
        Node.shutdown();
        return;
    }
    let kv_export = peer.export(kv).expect("kv grant");
    let wire_export = peer.export(wp).expect("wire grant");
    let identity_export = peer.export(identity).expect("identity grant");
    let race_exports = if scenario == "remote_setup_exit_race" {
        let monitor_store: HashMap<string, string> = HashMap.new();
        let monitor_target = spawn KeyValue { store: monitor_store };
        Node.register("monitor-race", monitor_target);
        let link_store: HashMap<string, string> = HashMap.new();
        let link_target = spawn KeyValue { store: link_store };
        Node.register("link-race", link_target);
        let stopper = spawn SetupRaceStopper { monitor_target: monitor_target, link_target: link_target };
        let _ = fork stopper.run();
        Option.Some((peer.export(monitor_target).expect("monitor race grant"), peer.export(link_target).expect("link race grant")))
    } else {
        Option.None
    };
    let generic_exports = if scenario == "remote_ask" {
        Option.Some((peer.export(spawn GenericEcho<u64>).expect("number grant"), peer.export(spawn GenericEcho<WirePoint>).expect("point grant"), peer.export(spawn SpecializedEcho<string>).expect("specialized grant")))
    } else {
        Option.None
    };
    if scenario == "deadline_budget" {
        serve_deadline_actors(peer);
        Node.shutdown();
        return;
    }
    if scenario == "inbound_isolation" {
        scenario_server_inbound_isolation(kx);
        return;
    }
    if scenario == "monitor_watcher_node_death" {
        scenario_server_watcher_node_death(0);
    } else {
        if scenario == "cross_node_monitor_close_reclaim" {
            scenario_server_monitor_close_reclaim();
        } else if scenario == "monitor_leak_low" {
            scenario_server_monitor_leak(kx, "monitor_leak_low", 3);
        } else if scenario == "monitor_leak_high" {
            scenario_server_monitor_leak(kx, "monitor_leak_high", 50);
        } else {
            if scenario == "repoint_preserves_ref" {
                // Re-point only after the client holds its captured ref and has
                // seeded the original actor.
                let _ = wait_for_file(f"{kx}/client.seeded");
                // Registering the name again re-points it to the new actor.
                let s2: HashMap<string, string> = HashMap.new();
                let kv2 = spawn KeyValue { store: s2 };
                Node.register("kv", kv2);
                let replacement_export = peer.export(kv2).expect("replacement grant");
                println("SERVER_REPOINTED repoint_preserves_ref");
                sleep(2m);
            } else {
                sleep(2m);
            }
        }
    }
    Node.shutdown();
}

fn scenario_server_inbound_isolation(kx: string) {
    let (release, gate) = stream.pipe(128).expect("reply gate");
    let slow = spawn HeldEcho { gate: gate };
    let releaser = spawn EchoRelease { gate: release };
    Node.register("held", slow);
    Node.register("release", releaser);
    let trapped = spawn KeyValue { store: HashMap.new() };
    Node.register("trapped", trapped);
    let peer = fixture_peer();
    let slow_export = peer.export(slow).expect("held grant");
    let release_export = peer.export(releaser).expect("release grant");
    let trapped_export = peer.export(trapped).expect("trapped grant");
    let _ = wait_for_file(f"{kx}/client.stop-inbound");
    Node.shutdown();
    assert(releaser.handle(64).expect("release stopped peer replies") == 64);
    stop(slow);
    stopped(slow);
    stop(releaser);
    stopped(releaser);
}

fn held_request(target: HeldEcho, results: InboundResults, index: i64, closing: bool) {
    let value = f"owned request {index}";
    let status = match (scope within 15s {
        target.handle(value)
    } handle failure {
        match failure {
            .Deadline { message } => .Err(ActorError.TimedOut),
            .Fault { message } => panic(message),
        }
    }) {
        .Ok(reply) => if !closing && reply == value {
            0
        } else {
            3
        }
        .Err(ActorError.RoutingFailed) => 1,
        .Err(ActorError.ConnectionDropped) => if closing {
            2
        } else {
            3
        }
        .Err(_) => 3,
    };
    results.record(status).expect("record completion");
}

fn await_inbound_refusal(results: InboundResults, count: i64) {
    for i in 0..5000 {
        let counts = results.counts().expect("pending counts");
        assert(counts.3 == 0);
        if counts.1 == count {
            return;
        }
        sleep(1ms);
    }
    panic("inbound capacity was not reached");
}

fn scenario_inbound_isolation(kv: KeyValue, kx: string) -> i64 {
    let slow = fixture_peer().receive_service<HeldEcho>().expect("held grant");
    let release = fixture_peer().receive_service<EchoRelease>().expect("release grant");
    let trapped = fixture_peer().receive_service<KeyValue>().expect("trapped grant");
    let results = spawn InboundResults;
    var requests = [fork held_request(slow, results, 0, false)];
    for i in 1..65 {
        requests.push(fork held_request(slow, results, i, false));
    }
    await_inbound_refusal(results, 1);
    match (scope within 1s {
        kv.handle(KvReq.GetKey("absent"))
    } handle failure {
        match failure {
            .Deadline { message } => .Err(ActorError.TimedOut),
            .Fault { message } => panic(message),
        }
    }).expect("healthy service") {
        KvResp.Value(value) => assert(value == ""),
        KvResp.Ack => panic("healthy service returned the wrong reply"),
    }
    println("PASS inbound_isolation healthy-with-64-pending");
    assert((scope within 1s {
        release.handle(64)
    } handle failure {
        match failure {
            .Deadline { message } => .Err(ActorError.TimedOut),
            .Fault { message } => panic(message),
        }
    }).expect("release replies") == 64);
    let _ = await requests;
    let counts = results.counts().expect("completed counts");
    assert(counts.0 == 64 && counts.1 == 1 && counts.2 == 0 && counts.3 == 0);
    println("PASS inbound_isolation 64-completed-1-refused");
    match (scope within 1s {
        trapped.handle(KvReq.CrashSelf)
    } handle failure {
        match failure {
            .Deadline { message } => .Err(ActorError.TimedOut),
            .Fault { message } => panic(message),
        }
    }) {
        .Err(ActorError.Trapped) => {}
        _ => panic("remote handler fault lost its status"),
    }
    println("PASS inbound_isolation trapped");
    var closing = [fork held_request(slow, results, 0, true)];
    for i in 1..65 {
        closing.push(fork held_request(slow, results, i, true));
    }
    await_inbound_refusal(results, 2);
    publish_atomic(kx, "client.stop-inbound", "ready");
    let _ = await closing;
    let shutdown_counts = results.counts().expect("shutdown counts");
    assert(shutdown_counts.0 == 64 && shutdown_counts.1 == 2 && shutdown_counts.2 == 64 && shutdown_counts.3 == 0);
    println("PASS inbound_isolation shutdown-retired-64");
    stop(results);
    stopped(results);
    0
}

fn scenario_remote_ask(kv: KeyValue) -> i64 {
    // A successful write reply establishes completion before the read starts.
    match kv.handle(KvReq.Put(KvPut { key: "hello", val: "world" })) {
        .Ok(KvResp.Ack) => {}
        _ => {
            println("FAIL remote_ask put-hello-completion");
            return 2;
        }
    }
    match kv.handle(KvReq.Put(KvPut { key: "count", val: "42" })) {
        .Ok(KvResp.Ack) => {}
        _ => {
            println("FAIL remote_ask put-count-completion");
            return 3;
        }
    }
    let ask1 = kv.handle(KvReq.GetKey("hello"));
    match ask1 {
        Result.Err(_) => {
            println("FAIL remote_ask get-hello-ask-error");
            return 4;
        }
        Result.Ok(resp) => {
            match resp {
                KvResp.Value(v) => {
                    if v == "world" {
                        println("PASS remote_ask get-hello=world");
                    } else {
                        println(f"FAIL remote_ask get-hello={v}");
                        return 5;
                    }
                }
                KvResp.Ack => {
                    println("FAIL remote_ask get-hello-got-ack");
                    return 5;
                }
            }
        }
    }
    let ask2 = kv.handle(KvReq.GetKey("count"));
    match ask2 {
        Result.Err(_) => {
            println("FAIL remote_ask get-count-ask-error");
            return 6;
        }
        Result.Ok(resp) => {
            match resp {
                KvResp.Value(v) => {
                    if v == "42" {
                        println("PASS remote_ask get-count=42");
                    } else {
                        println(f"FAIL remote_ask get-count={v}");
                        return 7;
                    }
                }
                KvResp.Ack => {
                    println("FAIL remote_ask get-count-got-ack");
                    return 7;
                }
            }
        }
    }
    let peer = fixture_peer();
    match peer.receive_service<GenericEcho<i64>>() {
        .Err(ActorError.RoutingFailed) => {}
        _ => panic("wrong generic grant admitted"),
    }
    let number = peer.receive_service<GenericEcho<u64>>().expect("generic number grant");
    // Positive integers have the same CBOR representation for these types.
    // The concrete actor identity must reject the wrong substitution first.
    assert(number.handle(42).expect("generic number reply") == 42);
    println("PASS remote_ask generic-identity");
    let points = fixture_peer().receive_service<GenericEcho<WirePoint>>().expect("generic point grant");
    let point = points.handle(WirePoint { x: 3, y: 4 }).expect("generic point reply");
    assert(point.x == 3 && point.y == 4);
    println("PASS remote_ask generic-point=3,4");
    let specialized = fixture_peer().receive_service<SpecializedEcho<string>>().expect("specialized grant");
    assert(specialized.handle("specialized".to_upper()).expect("specialized reply") == "SPECIALIZED");
    println("PASS remote_ask specialized-echo");
    0
}

