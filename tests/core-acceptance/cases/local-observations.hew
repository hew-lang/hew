import std.link_monitor.{MonitorRef};
import std.failure.{CrashNotification};

actor Target {
    receive fn ping() -> i64 {
        42
    }
}

actor Watcher {
    var exits: i64 = 0;
    receive fn observe(target: Target) -> i64 {
        link(target).expect("link live target");
        link(target).expect("duplicate link is idempotent");
        unlink(target);
        unlink(target);
        let first: MonitorRef = monitor(target).expect("monitor live target");
        first.close();
        let second = monitor(target).expect("independent monitor");
        second.close();
        let _scoped = monitor(target).expect("scope-owned registration");
        1
    }
    receive fn observe_dead(target: Target) -> i64 {
        // A retired target is not an error: it answers with its exit.
        link(target).expect("link a retired target");
        2
    }
    receive fn exits() -> i64 {
        exits
    }
    #[on(link)]
    fn on_peer_exit(note: CrashNotification) {
        assert(note.actor_id > 0);
        exits = exits + 1;
    }
}

fn link_from_helper(target: Target) -> Result<(), LinkError> {
    link(target)
}

fn monitor_from_helper(target: Target) -> Result<MonitorRef, LinkError> {
    monitor(target)
}

fn main() {
    let target = spawn Target;
    assert(match link_from_helper(target) {
        .Err(LinkError.NoContext) => true,
        _ => false,
    });
    assert(match monitor_from_helper(target) {
        .Err(LinkError.NoContext) => true,
        _ => false,
    });
    let watcher = spawn Watcher;
    assert(watcher.observe(target).expect("live observations") == 1);
    stop(target);
    stopped(target);
    assert(watcher.observe_dead(target).expect("retired observations") == 2);
    while watcher.exits().expect("exit count") == 0 {
        sleep(1ms);
    }
    assert(watcher.exits().expect("exit count") == 1);
    stop(watcher);
    stopped(watcher);
    println("local observations own subscriptions and report context");
}
