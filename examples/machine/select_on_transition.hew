// A reusable subscription receives typed notices in an ordinary select loop.
import std.concurrency.lifecycle.{Lifecycle};

import std.machine.watch;

fn main() {
    let initial: Lifecycle<i64> = .Created;
    let (owner, feed) = watch.observe(initial, capacity: 8, subscribers: 1).expect("observe lifecycle");
    var lifecycle = owner;
    let updates = feed.subscribe().expect("subscribe");
    let timed_out = select {
        item from updates.recv() => false,
        after 1ms => true,
    };
    assert(timed_out);
    let _ = lifecycle.step(.Initialise);
    let _ = lifecycle.step(.Started { handle: 7 });
    lifecycle.close();
    var previous = updates.initial().state.state_name();
    loop {
        select {
            item from updates.recv() => {
                match item {
                    .Ok(.Some(notice)) => {
                        let current = notice.state.state_name();
                        println(f"{previous} -> {current}");
                        previous = current;
                        if current == "Running" {
                            println("observer: child is up");
                        }
                    }
                    .Ok(.None) => {
                        println("watch closed");
                        return;
                    }
                    .Err(lag) => {
                        panic(f"history incomplete: {lag}");
                    }
                }
            }
            after 1s => panic("watch did not advance"),
        };
    }
}
