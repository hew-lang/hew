//! @name Dress for the weather
//! @description Choose a coat for the temperature and add an umbrella when it rains.

fn forecast(degrees: i64, raining: bool) {
    if degrees < 0 {
        println("Wear a winter coat.");
    } else if degrees < 15 {
        println("Bring a jacket.");
    } else {
        println("A light shirt is enough.");
    }
    if raining {
        println("Pack an umbrella.");
    }
}

fn main() {
    forecast(-3, false);
    forecast(8, true);
    forecast(21, false);
}
