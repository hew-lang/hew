// Removed Result-only API names must fail at the public API boundary.
import std.crypto.crypto;
import std.encoding.json;
import std.metrics;
import std.net;
import std.process;
import std.stream;
import std.string;
// Character classification is provided by char methods.
import std.time.datetime;

fn main() {
    let _ = process.try_run;
    let _ = stream.try_pipe;
    let _ = string.try_to_int;
    let _ = net.try_connect;
    let _ = crypto.try_random_bytes;

    let _ = datetime.try_parse;
    let _ = metrics.try_counter;
    let _ = json.try_parse;
}
