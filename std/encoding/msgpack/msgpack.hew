//! MessagePack serialization.
//!
//! Encode and decode values using the MessagePack binary format.
//! Supports conversion between JSON strings and MessagePack bytes,
//! as well as encoding individual typed values.
//!
//! # Examples
//!
//! ```
//! import std.encoding.msgpack;
//!
//! fn main() {
//!     let packed = msgpack.from_json("{\"x\": 1}") handle error {
//!         println(f"operation failed: {error}");
//!         return;
//!     };
//!     println(packed.len());
//!     let json = msgpack.to_json(packed) handle error {
//!         println(f"operation failed: {error}");
//!         return;
//!     };
//!     println(json);
//! }
//! ```

import std.encoding.wire;

/// Encode a JSON string to MessagePack binary.
///
/// Returns `Err(reason)` on invalid JSON or serialization failure. The codec's
/// own reason slot decides success, not the length of the result, so a
/// legitimately short encoding is never mistaken for a failure.
pub fn from_json(json: string) -> Result<bytes, string> {
    let data = unsafe {
        hew_msgpack_from_json_hew(json)
    };
    let reason = unsafe {
        hew_msgpack_last_error()
    };
    if reason.len() > 0 {
        .Err(reason)
    } else {
        .Ok(data)
    }
}

/// Decode a MessagePack `bytes` buffer to a JSON string.
///
/// Returns `Err(reason)` on invalid input or deserialization failure.
pub fn to_json(data: bytes) -> Result<string, string> {
    let json = unsafe {
        hew_msgpack_to_json_hew(data)
    };
    let reason = unsafe {
        hew_msgpack_last_error()
    };
    if reason.len() > 0 {
        .Err(reason)
    } else {
        .Ok(json)
    }
}

/// Encode any data value as MessagePack bytes. Records encode as objects keyed by
/// field name in declaration order.
#[intrinsic("codec.msgpack.encode")]
pub fn encode<T: Serializable>(value: T) -> bytes {}

/// Decode MessagePack bytes as `T`. A failure names the path of the value that did
/// not fit, for example `Type: .tags[1]: expected string, found integer`.
#[intrinsic("codec.msgpack.decode")]
pub fn decode<T: Serializable>(data: bytes) -> Result<T, wire.DecodeError> {}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    fn hew_msgpack_from_json_hew(json: string) -> bytes;
    fn hew_msgpack_to_json_hew(data: bytes) -> string;
    fn hew_msgpack_last_error() -> string;
}
