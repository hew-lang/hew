// link() and monitor() in value position share one typed error (HEW-SPEC-2026
// §5.7.1): link(pid) -> Result<(), LinkError> and
// monitor(pid) -> Result<MonitorRef, LinkError>.
//
// Inside an actor handler both subscribe and return Ok. Reached from main
// through a free function, the same calls have no actor to deliver to and
// return Err(LinkError.NoContext) at run time. A direct call in main is
// E_ACTOR_CONTEXT_REQUIRED at compile time; see
// reject/link_monitor_in_main.hew.
actor Child {
    receive fn ping() {}
}

actor Watcher {
    receive fn watch(child: Child) -> i64 {
        let linked = match link(child) {
            .Ok(()) => 1,
            .Err(_) => 0,
        };
        // The MonitorRef closes at scope exit, which ends the subscription.
        let monitored = match monitor(child) {
            .Ok(_) => 10,
            .Err(_) => 0,
        };
        linked + monitored
    }
}

fn observe_without_context(child: Child) -> i64 {
    let linked = match link(child) {
        .Ok(()) => 0,
        .Err(LinkError.NoContext) => 1,
        .Err(_) => 0,
    };
    let monitored = match monitor(child) {
        .Ok(_) => 0,
        .Err(LinkError.NoContext) => 10,
        .Err(_) => 0,
    };
    linked + monitored
}

fn main() {
    let child = spawn Child;
    let watcher = spawn Watcher;
    match watcher.watch(child) {
        .Ok(n) => println(f"in actor: {n}"),
        .Err(_) => println("in actor: send failed"),
    }
    println(f"from main: {observe_without_context(child)}");
}
