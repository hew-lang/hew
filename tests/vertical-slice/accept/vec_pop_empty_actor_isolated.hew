// EXIT: 1
actor VecPopCrasher {
    receive fn boom() {
        let xs: Vec<i64> = Vec.new();
        let _ = xs.pop();
    }
}

actor VecPopProbe {
    receive fn ping() -> i64 {
        0
    }
}

fn main() -> i64 {
    let crasher = spawn VecPopCrasher;
    let probe = spawn VecPopProbe;
    let _ = crasher.boom();
    sleep(300ms);
    match probe.ping() {
        .Ok(v) => v,
        .Err(_) => 1,
    }
}
