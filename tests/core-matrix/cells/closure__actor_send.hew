actor Sink {
    var hits: i64,

    receive fn take(v: fn(i64) -> i64) -> i64 {
        let v_r = v(21);
        println(f"{v_r}");
        hits = hits + 1;
        hits
    }
}

fn main() {
    let x = |v: i64| v * 2;
    let s = spawn Sink(hits: 0);
    match await s.take(x) {
        Result.Ok(n) => println(f"hits {n}"),
        Result.Err(_) => println("err"),
    }
}
