import std.net.http.client;

import std.net.http.server as http;

actor Client {
    let url: string;
    var complete: i64;

    receive fn fetch(unused: i64) {
        let _ = client.set_timeout(5000ms);
        let response = client.get(url).expect("HTTP request succeeds");
        if response.status() != 200 {
            panic("HTTP request retention response failed");
        }
        response.close();
        complete = 1;
    }

    receive fn finished() -> i64 {
        complete
    }
}

fn main() {
    match http.listen("127.0.0.1:0") {
        .Ok(server) => {
            let port = server.port();
            let client = spawn Client { url: f"http://127.0.0.1:{port}/retention", complete: 0 };
            let fetching = fork client.fetch(0);
            let request = server.accept().expect("accept connection");
            for _ in 0..50 {
                let host = request.header("Host").expect("read header").expect("Host is present");
                assert(host.starts_with("127.0.0.1:"));
                let checksum = request.method().len() + request.path().len() + request.body("utf-8").expect("request body decodes").len();
                println(checksum);
            }
            match request.respond_text(200, "ok") {
                .Ok(_) => {}
                .Err(_) => panic("HTTP retention response failed"),
            }
            assert((await fetching).is_ok());
            match client.finished() {
                .Ok(done) => {
                    if done != 1 {
                        panic("HTTP retention client stopped early");
                    }
                }
                .Err(_) => panic("HTTP retention client failed"),
            }
            server.close();
        }
        .Err(_) => panic("HTTP retention listener failed"),
    }
}
