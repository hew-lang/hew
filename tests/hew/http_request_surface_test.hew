//! Checked HTTP failures and response headers are exercised without external services.

import std.net;
import std.net.http.client;

actor RawPeer {
    let listener: net.Listener;
    let response: bytes;

    receive fn serve() {
        let connection = listener.accept().expect("accept HTTP client");
        let _request = connection.recv().expect("receive request");
        connection.send(response).expect("send HTTP response");
        connection.close();
    }
}

#[test]
#[real_time]
fn test_unsupported_method_returns_request_error() {
    match client.request("TRACE", "http://127.0.0.1/", "", []) {
        .Err(client.HttpError.Request(detail)) => assert(detail.contains("unsupported HTTP method")),
        _ => panic("unsupported method must return a request error"),
    }
    assert(client.request_string("TRACE", "http://127.0.0.1/", "", []).is_err());
}

#[test]
#[real_time]
fn test_transport_failure_is_not_an_empty_body() {
    let listener = net.listen("127.0.0.1:0").expect("reserve port");
    let port = listener.local_port();
    listener.close();
    match client.get_string(f"http://127.0.0.1:{port}/") {
        .Err(client.HttpError.Request(detail)) => assert(!detail.is_empty()),
        _ => panic("closed port must return a transport error"),
    }
}

#[test]
#[real_time]
fn test_absent_and_empty_headers_are_distinct() {
    let listener = net.listen("127.0.0.1:0").expect("listen");
    let port = listener.local_port();
    let peer = spawn RawPeer { listener, response: b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\nX-Empty: \r\nConnection: close\r\n\r\n" };
    let serving = fork peer.serve();
    let response = client.get(f"http://127.0.0.1:{port}/").expect("request");
    assert(response.body().expect("body") == "");
    assert(response.header("x-empty").expect("empty header") == .Some(""));
    assert(response.header("x-absent").expect("absent header") == .None);
    assert(response.content_type().expect("content type") == .None);
    assert((await serving).is_ok());
    stop(peer);
    stopped(peer);
}

#[test]
#[real_time]
fn test_invalid_utf8_body_returns_a_decoding_failure() {
    let listener = net.listen("127.0.0.1:0").expect("listen");
    let port = listener.local_port();
    let peer = spawn RawPeer { listener, response: b"HTTP/1.1 200 OK\r\nContent-Length: 1\r\nConnection: close\r\n\r\n\xff" };
    let serving = fork peer.serve();
    match client.get_string(f"http://127.0.0.1:{port}/") {
        .Err(client.HttpError.Request(detail)) => assert(detail.contains("body")),
        .Err(client.HttpError.Body(detail)) => assert(!detail.is_empty()),
        _ => panic("invalid UTF-8 must not become a successful empty body"),
    }
    assert((await serving).is_ok());
    stop(peer);
    stopped(peer);
}
