// Wall-clock values retain their nominal type and nanoseconds through ordinary storage.
type Envelope {
    sent: timestamp;
    label: string;
}

fn carry(value: timestamp) -> timestamp {
    value
}

actor Timeline {
    var current: timestamp;

    receive fn advance(offset: duration) -> timestamp {
        current += offset;
        current
    }
}

fn shift_overflows(value: timestamp, offset: duration) -> bool {
    var cleaned = false;
    let failed = scope {
        let owner = "timestamp cleanup".repeat(8);
        defer {
            assert(!owner.is_empty());
            cleaned = true;
        }
        let shifted = value + offset;
        assert(shifted >= timestamp.from_unix_secs(-9223372036854775808));
        false
    } handle _ { true };
    assert(cleaned);
    failed
}

fn main() fails TimestampError {
    let before = timestamp.from_unix_nanos(-1);
    let (seconds, nanos) = before.unix_parts();
    assert(seconds == -1);
    assert(nanos == 999999999);
    assert(before.unix_secs_floor() == -1);
    let epoch = timestamp.from_unix_secs(0);
    assert((before + 1ns).unix_secs_floor() == 0);
    assert(epoch - before == 1ns);
    assert((epoch - 1ns).unix_parts() == before.unix_parts());
    assert((1ns + before).unix_parts() == epoch.unix_parts());

    // This value predates the range of an i64 nanosecond epoch.
    let early = timestamp.from_unix_secs(-62167219200);
    let shifted = early + 123ns;
    let envelope = Envelope { sent: carry(shifted), label: "sample" };
    assert(envelope.sent.unix_parts() == (-62167219200, 123 as u32));
    assert(envelope.sent - early == 123ns);
    assert(before.unix_millis_floor()? == -1);
    assert(before.unix_micros_floor()? == -1);
    assert(before.unix_nanos()? == -1);
    for value in [-9223372036854775808, -1, 0, 1, 9223372036854775807] {
        assert(timestamp.from_unix_nanos(value).unix_nanos()? == value);
        assert(timestamp.from_unix_micros(value).unix_micros_floor()? == value);
        assert(timestamp.from_unix_millis(value).unix_millis_floor()? == value);
    }
    assert(timestamp.from_unix_parts(1, 1000000000).is_err());
    assert(early.unix_nanos().is_err());
    let last = timestamp.from_unix_parts(9223372036854775807, 999999999)?;
    let first = timestamp.from_unix_secs(-9223372036854775808);
    assert(first < before && before < epoch && epoch < last);
    assert(first == timestamp.from_unix_secs(-9223372036854775808));
    assert(last.unix_millis_floor().is_err());
    assert(first.unix_millis_floor().is_err());

    var moving = before;
    moving += 2ns;
    moving -= 1ns;
    assert(moving == epoch);
    let values: Vec<timestamp> = [before, early, last];
    assert(values[1] == early);
    let optional: Option<timestamp> = .Some(last);
    assert(optional.expect("stored timestamp") == last);
    let captured = || shifted + 1ns;
    assert(captured() - early == 124ns);
    var index: HashMap<timestamp, string> = HashMap.new();
    index.insert(before, "before".to_upper());
    index.insert(last, "last".to_upper());
    assert(index.get(timestamp.from_unix_nanos(-1)).expect("equal timestamp key") == "BEFORE");
    assert(index.get(last).expect("maximum timestamp key") == "LAST");
    assert(shift_overflows(last, 1ns));
    assert(shift_overflows(first, -1ns));
    var difference_cleaned = false;
    let difference_failed = scope {
        let owner = "difference cleanup".repeat(8);
        defer {
            assert(!owner.is_empty());
            difference_cleaned = true;
        }
        let difference = last - first;
        assert(difference >= 0ns);
        false
    } handle _ { true };
    assert(difference_failed && difference_cleaned);
    let minimum_duration = duration.from_nanos(-9223372036854775808);
    var negation_cleaned = false;
    let negation_failed = scope {
        let owner = "duration cleanup".repeat(8);
        defer {
            assert(!owner.is_empty());
            negation_cleaned = true;
        }
        let negated = -minimum_duration;
        assert(negated >= 0ns);
        false
    } handle _ { true };
    assert(negation_failed && negation_cleaned);

    let timeline = spawn Timeline { current: before };
    assert(timeline.advance(1ns).expect("advance through actor") == epoch);
    assert(timeline.advance(123ns).expect("preserve actor nanoseconds") == epoch + 123ns);
    stop(timeline);
    stopped(timeline);
    println("timestamp values ok");
}
