// `policy(target, on_full: ...)` is the completion view: a call through it
// waits for the handler exactly as a call on the handle does, and the policy
// decides only what happens when the destination mailbox is full. `.Reject`
// refuses instead of parking and reports `Rejected(SendError.Full)`, which is
// the one outcome from which the same call may safely be made again. `.Wait`
// is the bare-handle behaviour and is the control here.
actor Gate {
    mailbox 1,
    var done: i64 = 0,

    // A one-way handler the mailbox view can submit to, and a value-returning
    // one the completion views call.
    receive fn occupy(ms: i64) {
        sleep(ms * 1ms);
        done = done + 1;
    }

    receive fn tally() -> i64 { done }
}

fn describe(problem: ActorError<Never>) -> string {
    match problem {
        // The refusal reason is reached through `Rejected` and interpolated,
        // so its `Display` impl must be selected under the same identity the
        // payload carries.
        ActorError.Rejected(reason) => f"rejected: {reason}",
        ActorError.Trapped => "trapped",
        ActorError.Dead => "dead",
        ActorError.Timeout => "timeout",
        ActorError.NodeNotRunning => "node not running",
        ActorError.RoutingFailed => "routing failed",
        ActorError.EncodeFailed => "encode failed",
        ActorError.ConnectionDropped => "connection dropped",
        ActorError.Partition => "partition",
    }
}

fn main() {
    let gate = spawn Gate();
    let refusing = policy(gate, on_full: .Reject);
    let inbox = mailbox(gate, on_full: .Wait);
    // Two accepted submissions: one the actor is running for a long turn, one
    // occupying its single mailbox seat. Both return only once accepted, so
    // the seat is provably taken before the next call is made.
    match inbox.occupy(2000) {
        .Ok(outcome) => println(f"submitted: {outcome}"),
        .Err(_) => panic("the first submission was refused"),
    }
    match inbox.occupy(0) {
        .Ok(_) => {},
        .Err(_) => panic("the queued submission was refused"),
    }
    // No seat left while the long turn runs, so the refusing view refuses.
    match refusing.tally() {
        .Ok(v) => println(v),
        .Err(problem) => println(describe(problem)),
    }
    // A bare-handle call waits for a seat instead, and completes.
    match gate.tally() {
        .Ok(v) => println(v),
        .Err(problem) => println(describe(problem)),
    }
    // Nothing was accepted from the refusal, so the same call is safe to make
    // again; the queue has drained and it is admitted.
    match refusing.tally() {
        .Ok(v) => println(v),
        .Err(problem) => println(describe(problem)),
    }
    close(gate);
    println("closed");
}
