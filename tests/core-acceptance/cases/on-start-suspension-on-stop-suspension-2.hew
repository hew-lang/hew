actor Slow {
    var value: i64 = 1;
    #[on(stop)]
    fn stopping() {
        sleep(1ms);
        println(f"stopped {value}");
    }
    receive fn get() -> i64 {
        value
    }
}

fn main() {
    let a0 = spawn Slow;
    stop(a0);
    stopped(a0);
