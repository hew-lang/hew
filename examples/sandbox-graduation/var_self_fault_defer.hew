// A `var self` method that fails leaves its receiver, as last written, in the
// caller's variable, capture or field, where a pending defer still reads it.
type Counter {
    n: i64,
    label: string,
}

impl Counter {
    fn bump(var self, fail: bool) {
        self.n = self.n + 1;
        if fail {
            panic("bump failed");
        }
    }
}

type Point {
    x: i64,
    y: i64,
}

impl Point {
    fn shift(var self, fail: bool) {
        self.x = self.x + 1;
        if fail {
            panic("shift failed");
        }
    }
}

type Shape {
    origin: Point,
    name: string,
}

fn main() {
    var c = Counter { n: 1, label: "count" };
    defer println(f"{c.label} {c.n}");
    c.bump(false);
    let shape = Shape { origin: Point { x: 10, y: 0 }, name: "shape" };
    var step = capture(var shape) |fail: bool| {
        defer println(f"{shape.name} {shape.origin.x}");
        shape.origin.shift(fail);
    };
    step(false);
    step(true);
    println("unreachable");
}
