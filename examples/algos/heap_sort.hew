// Heap Sort - build max-heap in-place, then extract elements
// A parameter is the callee's own copy, so every helper that mutates the
// vector returns it and the caller reassigns.
fn swap(var v: Vec<i64>, i: i64, j: i64) -> Vec<i64> {
    let tmp = v[i];
    v.set(i, v[j]);
    v.set(j, tmp);
    v
}

fn sift_down(var v: Vec<i64>, start: i64, end: i64) -> Vec<i64> {
    var root = start;
    var done = 0;
    while done == 0 {
        let left = 2 * root + 1;
        if left > end {
            done = 1;
        } else {
            var largest = root;
            if v[left] > v[largest] {
                largest = left;
            }
            let right = left + 1;
            if right <= end {
                if v[right] > v[largest] {
                    largest = right;
                }
            }
            if largest != root {
                v = swap(v, root, largest);
                root = largest;
            } else {
                done = 1;
            }
        }
    }
    v
}

fn heap_sort(var v: Vec<i64>) -> Vec<i64> {
    let n = v.len();
    if n >= 2 {
        // Build max-heap
        var i = n / 2 - 1;
        while i >= 0 {
            v = sift_down(v, i, n - 1);
            i = i - 1;
        }
        // Extract elements
        var end = n - 1;
        while end > 0 {
            v = swap(v, 0, end);
            end = end - 1;
            v = sift_down(v, 0, end);
        }
    }
    v
}

fn vec_eq(a: Vec<i64>, b: Vec<i64>) -> i64 {
    if a.len() != b.len() {
        return 0;
    }
    var i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return 0;
        }
        i = i + 1;
    }
    1
}

fn make_vec_5(a: i64, b: i64, c: i64, d: i64, e: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec.new();
    v.push(a);
    v.push(b);
    v.push(c);
    v.push(d);
    v.push(e);
    v
}

fn run_test(name: string, var input: Vec<i64>, expected: Vec<i64>) -> i64 {
    input = heap_sort(input);
    let pass = vec_eq(input, expected);
    if pass == 1 {
        println(f"Test {name} ... PASS");
    } else {
        println(f"Test {name} ... FAIL");
    }
    pass
}

fn main() {
    var total = 0;
    var passed = 0;
    total = total + 1;
    passed = passed + run_test("reverse", make_vec_5(5, 4, 3, 2, 1), make_vec_5(1, 2, 3, 4, 5));
    total = total + 1;
    passed = passed + run_test("sorted", make_vec_5(1, 2, 3, 4, 5), make_vec_5(1, 2, 3, 4, 5));
    total = total + 1;
    passed = passed + run_test("duplicates", make_vec_5(3, 1, 3, 1, 2), make_vec_5(1, 1, 2, 3, 3));
    total = total + 1;
    var single: Vec<i64> = Vec.new();
    single.push(42);
    var exp_single: Vec<i64> = Vec.new();
    exp_single.push(42);
    passed = passed + run_test("single", single, exp_single);
    total = total + 1;
    let empty: Vec<i64> = Vec.new();
    let exp_empty: Vec<i64> = Vec.new();
    passed = passed + run_test("empty", empty, exp_empty);

    // Larger test
    total = total + 1;
    var big: Vec<i64> = Vec.new();
    big.push(9);
    big.push(3);
    big.push(7);
    big.push(1);
    big.push(5);
    big.push(8);
    big.push(2);
    big.push(6);
    big.push(4);
    big.push(0);
    var exp_big: Vec<i64> = Vec.new();
    for x in 0 .. 10 {
        exp_big.push(x);
    }
    passed = passed + run_test("ten_elements", big, exp_big);
    println(f"{passed}/{total} tests passed");
    if passed == total {
        println("ALL PASS");
    } else {
        println("SOME FAIL");
    }
}
