// Aliased subtrait and supertrait impls resolve to their source declarations.
import hew.supertraits.{Base as B, Sub as S};

type W {
    id: i64;
}

impl B for W {
    fn base(self) -> i64 {
        self.id
    }
}

impl S for W {
    fn tag(self) -> i64 {
        self.id + 1
    }
}

fn main() {
    let w = W { id: 4 };
    println(f"tag {w.tag()} base {w.base()}");
}
