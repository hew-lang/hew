import std.encoding.xml;

#[test]
fn try_parse_returns_node() {
    match xml.parse("<root><child/></root>") {
        .Ok(node) => assert(node.get_tag() == "root"),
        .Err(_) => assert(false),
    }
}

#[test]
fn try_parse_returns_parser_error() {
    match xml.parse("<root>") {
        .Ok(node) => {
            node.close();
            assert(false);
        },
        .Err(message) => assert(message.starts_with("xml:")),
    }
}
