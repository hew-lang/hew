//! Checked encoding access and ordinary value behaviour.

import std.encoding.json;

import std.testing;

#[test]
fn test_lookup_distinguishes_missing_null_and_wrong_kind() {
    var doc = json.object();
    doc.set("present", json.null()).expect("set succeeds");
    match doc.get_field("missing") {
        .Ok(.None) => {},
        _ => panic("missing field must be None"),
    }
    let value = doc.get_field("present").expect("get_field succeeds").expect("get_field returns a value");
    testing.assert_true(value.type_of() == Kind.Null);
    match value.get_field("x") {
        .Err(AccessError.WrongKind(Kind.Object, Kind.Null)) => {},
        _ => panic("null receiver must be a shape error"),
    }
    match json.from_bool(false).get_int() {
        .Err(AccessError.WrongKind(Kind.Integer, Kind.Bool)) => {},
        _ => panic("boolean must not become zero"),
    }
    match json.from_int(0).get_string() {
        .Err(AccessError.WrongKind(Kind.String, Kind.Integer)) => {},
        _ => panic("integer must not become an empty string"),
    }
    match json.from_string("").get_bool() {
        .Err(AccessError.WrongKind(Kind.Bool, Kind.String)) => {},
        _ => panic("string must not become false"),
    }
}

#[test]
fn test_copy_mutation_and_extraction_survive_parent_scope() {
    let selected = {
        var original = json.object();
        var child = json.array();
        child.push(json.from_int(7)).expect("push succeeds");
        original.set("items", child).expect("set succeeds");
        child.push(json.from_int(8)).expect("push succeeds");
        var edited = original;
        edited.set("items", json.from_string("changed")).expect("set succeeds");
        testing.assert_eq_str(edited.get_field("items").expect("get_field succeeds").expect("get_field returns a value").get_string().expect("get_string succeeds"), "changed");
        testing.assert_eq(child.array_len().expect("array_len succeeds"), 2);
        original.get_field("items").expect("get_field succeeds").expect("get_field returns a value")
    };
    testing.assert_eq(selected.array_len().expect("array_len succeeds"), 1);
    testing.assert_eq(selected.array_get(0).expect("array_get succeeds").expect("array_get returns a value").get_int().expect("get_int succeeds"), 7);
}

#[test]
fn test_failed_mutation_preserves_receiver_and_child() {
    var receiver = json.from_string("original");
    var child = json.array();
    child.push(json.from_int(9)).expect("push succeeds");
    match receiver.set("x", child) {
        .Err(AccessError.WrongKind(Kind.Object, Kind.String)) => {},
        _ => panic("set must reject a scalar receiver"),
    }
    match receiver.push(child) {
        .Err(AccessError.WrongKind(Kind.Array, Kind.String)) => {},
        _ => panic("push must reject a scalar receiver"),
    }
    testing.assert_eq_str(receiver.get_string().expect("get_string succeeds"), "original");
    testing.assert_eq(child.array_get(0).expect("array_get succeeds").expect("array_get returns a value").get_int().expect("get_int succeeds"), 9);
}

#[test]
fn test_array_absence_and_index_validation() {
    var values = json.array();
    values.push(json.null()).expect("push succeeds");
    testing.assert_true(values.array_get(0).expect("array_get succeeds").expect("array_get returns a value").type_of() == Kind.Null);
    match values.array_get(1) {
        .Ok(.None) => {},
        _ => panic("missing index"),
    }
    match values.array_get(2147483647) {
        .Ok(.None) => {},
        _ => panic("large missing index"),
    }
    match values.array_get(-1) {
        .Err(AccessError.InvalidIndex(index)) => testing.assert_eq(index, -1),
        _ => panic("negative index must fail"),
    }
    match values.array_get(4294967296) {
        .Err(AccessError.InvalidIndex(index)) => testing.assert_eq(index, 4294967296),
        _ => panic("index must not wrap to zero"),
    }
    match json.object().array_get(0) {
        .Err(AccessError.WrongKind(Kind.Array, Kind.Object)) => {},
        _ => panic("wrong container is not an absent element"),
    }
}

#[test]
fn test_exact_signed_and_unsigned_integer_boundaries() {
    let maximum: u64 = 9223372036854775807 as u64 * 2 + 1;
    let unsigned = json.from_u64(maximum);
    testing.assert_true(unsigned.get_u64().expect("get_u64 succeeds") == maximum);
    testing.assert_true(json.parse(unsigned.stringify().expect("stringify succeeds")).expect("parse succeeds").get_u64().expect("get_u64 succeeds") == maximum);
    match unsigned.get_int() {
        .Err(AccessError.IntegerRange) => {},
        _ => panic("u64 max cannot fit i64"),
    }
    let above_signed: u64 = 9223372036854775807 as u64 + 1;
    testing.assert_true(json.parse("9223372036854775808").expect("parse succeeds").get_u64().expect("get_u64 succeeds") == above_signed);
    let signed_max = json.from_int(9223372036854775807);
    testing.assert_eq(signed_max.get_int().expect("get_int succeeds"), 9223372036854775807);
    testing.assert_true(signed_max.get_u64().expect("get_u64 succeeds") == 9223372036854775807);
    let signed_min = json.parse("-9223372036854775808").expect("parse succeeds");
    testing.assert_eq(signed_min.get_int().expect("get_int succeeds"), -9223372036854775808);
    match signed_min.get_u64() {
        .Err(AccessError.IntegerRange) => {},
        _ => panic("negative unsigned conversion"),
    }
    testing.assert_false(json.from_int(9007199254740992) == json.from_int(9007199254740993));
    testing.assert_eq(json.from_int(9007199254740993).get_int().expect("get_int succeeds"), 9007199254740993);
    match json.from_string("1").get_u64() {
        .Err(AccessError.WrongKind(Kind.Integer, Kind.String)) => {},
        _ => panic("unsigned access must check kind"),
    }
}

#[test]
fn test_checked_scalars_and_format_equality() {
    testing.assert_eq_str(json.from_string("").get_string().expect("get_string succeeds"), "");
    testing.assert_false(json.from_bool(false).get_bool().expect("get_bool succeeds"));
    let floating = json.parse("1.0").expect("parse succeeds");
    testing.assert_true(floating.get_float().expect("get_float succeeds") == 1.0);
    testing.assert_false(floating == json.from_int(1));
    match json.from_int(1).get_float() {
        .Err(AccessError.WrongKind(Kind.Float, Kind.Integer)) => {},
        _ => panic("integer must not silently become a float"),
    }
    testing.assert_true(json.parse("-0.0").expect("parse succeeds") == json.parse("0.0").expect("parse succeeds"));
}

#[test]
fn test_parse_error_then_successful_encoding() {
    match json.parse("[") {
        .Err(ParseError.Invalid(message)) => testing.assert_true(!message.is_empty()),
        _ => panic("malformed input must return the parser diagnostic"),
    }
    let encoded = json.null().stringify().expect("stringify succeeds");
    testing.assert_true(json.parse(encoded).expect("parse succeeds").type_of() == Kind.Null);
}

#[test]
fn test_object_order_duplicate_policy_and_keys() {
    let doc = json.parse("{\"z\":1,\"a\":2,\"z\":3}").expect("parse succeeds");
    testing.assert_eq_str(doc.stringify().expect("stringify succeeds"), "{\"a\":2,\"z\":3}");
    let keys = doc.keys().expect("keys succeeds");
    testing.assert_eq(keys.array_len().expect("array_len succeeds"), 2);
    testing.assert_eq_str(keys.array_get(0).expect("array_get succeeds").expect("array_get returns a value").get_string().expect("get_string succeeds"), "a");
    testing.assert_eq_str(keys.array_get(1).expect("array_get succeeds").expect("array_get returns a value").get_string().expect("get_string succeeds"), "z");
    testing.assert_eq(json.object().keys().expect("keys succeeds").array_len().expect("array_len succeeds"), 0);
}

#[test]
fn test_float_constructor_rejects_nonfinite_values() {
    let large = json.parse("1e308").expect("parse succeeds").get_float().expect("get_float succeeds");
    let infinity = large * large;
    match json.from_float(infinity) {
        .Err(EncodeError.NonFiniteFloat) => {},
        _ => panic("infinity"),
    }
    testing.assert_true(infinity > large);
    match json.from_float(-infinity) {
        .Err(EncodeError.NonFiniteFloat) => {},
        _ => panic("negative infinity"),
    }
    match json.from_float(infinity - infinity) {
        .Err(EncodeError.NonFiniteFloat) => {},
        _ => panic("NaN"),
    }
    testing.assert_true(json.from_float(1.25).expect("from_float succeeds").get_float().expect("get_float succeeds") == 1.25);
    let finite_max = json.parse("1.7976931348623157e308").expect("parse succeeds").get_float().expect("get_float succeeds");
    testing.assert_true(json.from_float(finite_max).expect("from_float succeeds").get_float().expect("get_float succeeds") == finite_max);
}
