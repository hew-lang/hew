actor Worker {
    var label: string;
    let count: i64;
    var mode: string;
    var attempts: i64 = 0;
    init(name: string, size: i64, fast: bool) {
        label = name.to_upper();
        count = size + 1;
        if fast {
            mode = "quick";
        } else {
            mode = "slow".to_upper();
        }
        self.label = label + "!";
        attempts = attempts + 1;
        println(describe());
    }
    fn describe() -> string {
        label + "/" + mode
    }
    receive fn label() -> string {
        label
    }
    receive fn count() -> i64 {
        count
    }
    receive fn mode() -> string {
        mode
    }
    receive fn attempts() -> i64 {
        attempts
    }
}

fn show(worker: Worker) {
    println(worker.label().expect("label"));
    println(worker.count().expect("count"));
    println(worker.mode().expect("mode"));
    println(worker.attempts().expect("attempts"));
}

fn main() {
    let quick = spawn Worker(name: "ready", size: 6, fast: true);
    show(quick);
    {
        let __hew_migrated_actor_1023 = quick;
        stop(__hew_migrated_actor_1023);
        stopped(__hew_migrated_actor_1023);
    };
    let slow = spawn Worker(name: "later", size: 41, fast: false);
    show(slow);
    {
        let __hew_migrated_actor_1124 = slow;
        stop(__hew_migrated_actor_1124);
        stopped(__hew_migrated_actor_1124);
    };
}
