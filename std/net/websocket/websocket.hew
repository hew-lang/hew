//! WebSocket client and server for bidirectional communication.
//!
//! Client and server connections share the `Conn` type: `send_text`,
//! `send_binary`, `recv` and `recv_timeout` behave the same in both
//! directions. A received `Message` is `Text` or `Binary`; `recv` returns
//! `.None` once the peer closes. `wss://` verifies the server with the same
//! `tls.Trust` and deadline as `std.net.tls`.
//!
//! # Client example
//!
//! ```hew,no_run
//! import std.net.websocket;
//!
//! fn main() {
//!     var options = websocket.options();
//!     options.subprotocols = ["chat"];
//!     let ws = websocket.connect("ws://localhost:8080/ws", options).expect("connect");
//!     ws.send_text("hello").expect("send");
//!     match ws.recv_timeout(3s) {
//!         .Ok(.Some(websocket.Message.Text(text))) => println(text),
//!         .Ok(.Some(websocket.Message.Binary(data))) => println(f"{data.len()} bytes"),
//!         .Ok(.None) => println("closed"),
//!         .Err(e) => println(f"ws: {e}"),
//!     }
//! }
//! ```
//!
//! # Server example
//!
//! ```hew,no_run
//! import std.net.websocket;
//!
//! fn main() {
//!     let server = websocket.listen("0.0.0.0:8080").expect("listen");
//!     let conn = server.accept();
//!     if let .Ok(.Some(message)) = conn.recv() {
//!         match message {
//!             websocket.Message.Text(text) => conn.send_text(f"got {text}").expect("send"),
//!             websocket.Message.Binary(data) => conn.send_binary(data).expect("send"),
//!         }
//!     }
//! }
//! ```

import std.net;

import std.net.tls;

/// One received WebSocket data message.
pub enum Message {
    Text(string);
    Binary(bytes);
}

/// How `connect` negotiates and verifies a client connection.
pub type ConnectOptions {
    /// Subprotocols offered in preference order; when non-empty the server
    /// must select one or the connect fails.
    subprotocols: Vec<string>;
    /// Trust and deadlines for `wss://` (and the deadlines for `ws://`).
    tls: tls.TlsOptions;
}

/// No subprotocols and `tls.options()`.
pub fn options() -> ConnectOptions {
    ConnectOptions { subprotocols: [], tls: tls.options() }
}

// Error-slot errno sentinels mirrored from `hew-std/src/websocket.rs`.
const WS_INVALID_ARGUMENT: i64 = -1;

const WS_TIMED_OUT: i64 = -2;

// `hew_ws_recv_next` statuses mirrored from `hew-std/src/websocket.rs`.
const RECV_TEXT: i32 = 0;

const RECV_BINARY: i32 = 1;

const RECV_CLOSED: i32 = 2;

const RECV_TIMED_OUT: i32 = 3;

/// The `NetError` for this actor's last WebSocket failure.
fn last_net_error() -> net.NetError {
    let errno = unsafe {
        hew_ws_last_errno()
    };
    if errno == WS_INVALID_ARGUMENT {
        net.NetError.InvalidArgument(last_error())
    } else if errno == WS_TIMED_OUT {
        net.NetError.TimedOut(0)
    } else {
        net.net_error_from_errno(errno)
    }
}

/// An open WebSocket connection handle.
///
/// Created by `websocket.connect(url, options)` or `server.accept()`.
/// Released at scope exit or by `close()`.
#[resource]
#[opaque]
pub type Conn {
}

// ── Conn methods ──────────────────────────────────────────────────────
/// Methods available on a WebSocket `Conn`.
trait ConnMethods {
    /// The subprotocol the server selected, or `.None` when none was offered
    /// or the connection was accepted by a server.
    fn subprotocol(self) -> Option<string>;

    /// Send a text message. After an error the connection is unusable.
    fn send_text(self, text: string) -> Result<(), net.NetError>;

    /// Send a binary message. After an error the connection is unusable.
    fn send_binary(self, data: bytes) -> Result<(), net.NetError>;

    /// Wait for the next message; `.None` once the peer has closed.
    fn recv(self) -> Result<Option<Message>, net.NetError>;

    /// Wait at most `timeout` for the next message: `Err(TimedOut(0))` when
    /// it passes, `.None` once the peer has closed.
    fn recv_timeout(self, timeout: duration) -> Result<Option<Message>, net.NetError>;

    /// Attach this connection to an actor (Erlang-style active mode).
    /// The runtime reads frames in a background thread and delivers each
    /// text message as an `on_message` actor message; binary messages are
    /// not delivered in active mode. The connection remains the caller's
    /// resource; attach transfers read authority only. Outbound sends and
    /// close remain valid.
    ///
    /// `handler` is the actor that will receive `on_message` and `on_close`.
    /// The compiler synthesises both protocol message IDs from the concrete
    /// actor type behind the handle.
    fn attach(self, handler: WebSocketHandler);
}

impl ConnMethods for Conn {
    fn subprotocol(self) -> Option<string> {
        let selected = unsafe {
            hew_ws_subprotocol(self)
        };
        if selected.is_empty() {
            .None
        } else {
            .Some(selected)
        }
    }
    fn send_text(self, text: string) -> Result<(), net.NetError> {
        if unsafe {
            hew_ws_send_text(self, text)
        } == 0 {
            .Ok(())
        } else {
            .Err(last_net_error())
        }
    }
    fn send_binary(self, data: bytes) -> Result<(), net.NetError> {
        if unsafe {
            hew_ws_send_binary(self, data)
        } == 0 {
            .Ok(())
        } else {
            .Err(last_net_error())
        }
    }
    fn recv(self) -> Result<Option<Message>, net.NetError> {
        next_message(self, -1)
    }
    fn recv_timeout(self, timeout: duration) -> Option<Message> fails net.NetError {
        let ms = net.duration_ms("websocket.Conn.recv_timeout", timeout.millis())?;
        next_message(self, ms)?
    }
    /// Compiler-lowered active-mode attach.
    ///
    /// The runtime delivers owned messages using the selected actor handlers.
    #[runtime(family = WebSocketAttachLocal, symbol = hew_ws_attach_native, lowering = actor_ingress, target = native, classification = "non-declarable-stdlib", receiver = opaque, data = on_message, close = on_close)]
    fn attach(self, handler: WebSocketHandler) {}
}

/// Receive one message, waiting at most `deadline_ms` (negative: no limit).
fn next_message(conn: Conn, deadline_ms: i64) -> Result<Option<Message>, net.NetError> {
    let status = unsafe {
        hew_ws_recv_next(conn, deadline_ms)
    };
    if status == RECV_TEXT {
        .Ok(.Some(Message.Text(unsafe {
            hew_ws_take_text(conn)
        })))
    } else if status == RECV_BINARY {
        .Ok(.Some(Message.Binary(unsafe {
            hew_ws_take_binary(conn)
        })))
    } else if status == RECV_CLOSED {
        .Ok(.None)
    } else if status == RECV_TIMED_OUT {
        .Err(net.NetError.TimedOut(0))
    } else {
        .Err(last_net_error())
    }
}

impl Conn {
    /// Release this connection early. Scope exit performs the same release.
    fn close(consume self) {
        unsafe {
            hew_ws_close(self)
        };
    }
}

// ── Server type ─────────────────────────────────────────────────────
/// A WebSocket server listening for incoming connections.
///
/// Created by calling `websocket.listen(addr)`, which returns `Err` when the
/// address cannot be bound. Use `accept()` to wait
/// for the next client connection.
#[resource]
#[opaque]
pub type Server {
}

/// Methods available on a WebSocket `Server`.
trait ServerMethods {
    /// Accept the next WebSocket connection. Blocks until a client
    /// connects and completes the handshake.
    fn accept(self) -> Conn;

    /// Get the port the server is listening on.
    fn port(self) -> i64;
}

impl ServerMethods for Server {
    fn accept(self) -> Conn {
        unsafe {
            hew_ws_server_accept(self)
        }
    }
    fn port(self) -> i64 {
        unsafe {
            hew_ws_server_port(self) as i64
        }
    }
}

impl Server {
    /// Stop listening and release this server early.
    fn close(consume self) {
        unsafe {
            hew_ws_server_close(self)
        };
    }
}

// ── WebSocket Handler trait ──────────────────────────────────────────
/// Trait for actors that handle WebSocket connections.
///
/// Implement this on an actor and call `conn.attach(actor)` to have
/// the runtime deliver frames as actor messages. The actor never calls
/// recv() — the runtime reads in a background thread.
///
/// # Example
///
/// ```
/// import std.net.websocket;
///
/// actor Echo {
///     let conn: websocket.Conn;
///     receive fn on_message(text: string) {
///         let _ = conn.send_text("echo: " + text);
///     }
///     receive fn on_close() {
///         println("disconnected");
///     }
/// }
/// ```
pub trait WebSocketHandler {
    /// Called when a text message arrives; binary messages are not
    /// delivered in active mode.
    fn on_message(text: string);

    /// Called when the connection closes or errors.
    fn on_close();
}

// ── Module-level functions ────────────────────────────────────────────
/// Return the detail of this actor's most recent WebSocket failure.
///
/// Returns the empty string when the last call succeeded. Call it immediately
/// after an `Err` for the precise, non-secret reason.
pub fn last_error() -> string {
    unsafe {
        hew_ws_last_error()
    }
}

/// Open a WebSocket connection to `url` (client).
///
/// `ws://` and `wss://` are supported; `wss://` verifies the server with
/// `options.tls.trust`. Up to three redirects are followed, but never from
/// `wss://` to `ws://` or back (`InvalidArgument`).
/// `options.tls.handshake_timeout` bounds the TCP connect, the TLS handshake
/// and the upgrade together (`TimedOut`); resolving the host name is not
/// bounded by it. `options.tls.io_timeout` bounds each send. A non-empty
/// `options.subprotocols` must have one selected by the server. A bad URL or
/// subprotocol name is `InvalidArgument`; `websocket.last_error()` has the
/// precise detail of any failure.
///
/// # Examples
///
/// ```hew,no_run
/// import std.net.websocket;
///
/// fn main() {
///     match websocket.connect("ws://127.0.0.1:9001/", websocket.options()) {
///         .Ok(conn) => conn.close(),
///         .Err(e) => println(f"connect failed: {e}"),
///     }
/// }
/// ```
pub fn connect(url: string, options: ConnectOptions) -> Conn fails net.NetError {
    for protocol in options.subprotocols {
        if protocol.is_empty() || protocol.contains(",") || protocol.contains(" ") {
            return error net.NetError.InvalidArgument(f"websocket.connect: subprotocol {protocol:?} is not a token");
        }
    }
    let handshake_ms = net.duration_ms("websocket.connect handshake_timeout", options.tls.handshake_timeout.millis())?;
    let io_ms = net.duration_ms("websocket.connect io_timeout", options.tls.io_timeout.millis())?;
    let (trust, pem): (i32, bytes) = match options.tls.trust {
        tls.Trust.Bundled => (0, bytes.new()),
        tls.Trust.Pem(document) => (1, document),
    };
    let protocols = options.subprotocols.join(",");
    let conn = unsafe {
        hew_ws_connect(url, protocols, trust, pem, handshake_ms, io_ms)
    };
    if unsafe {
        hew_ws_conn_is_valid(conn)
    } {
        return conn;
    }
    return error last_net_error();
}

/// Start a WebSocket server listening on the given address.
///
/// Returns `Err(net.NetError)` when the address cannot be bound. Use
/// `websocket.last_error()` for the precise detail.
///
/// # Examples
///
/// ```hew,no_run
/// import std.net;
/// import std.net.websocket;
///
/// fn main() {
///     match websocket.listen("127.0.0.1:0") {
///         .Ok(server) => server.close(),
///         .Err(_) => println(f"listen failed"),
///     }
/// }
/// ```
pub fn listen(addr: string) -> Result<Server, net.NetError> {
    let server = unsafe {
        hew_ws_server_new(addr)
    };
    let ok = unsafe {
        hew_ws_server_is_valid(server)
    };
    if ok {
        return .Ok(server);
    }
    .Err(last_net_error())
}

// ── FFI bindings (implementation detail) ──────────────────────────────
extern "C" {
    fn hew_ws_connect(url: string, protocols: string, trust: i32, pem: bytes, handshake_ms: i64, io_ms: i64) -> Conn;
    fn hew_ws_conn_is_valid(ws: Conn) -> bool;
    fn hew_ws_server_is_valid(server: Server) -> bool;
    fn hew_ws_last_errno() -> i64;
    fn hew_ws_last_error() -> string;
    fn hew_ws_subprotocol(ws: Conn) -> string;
    fn hew_ws_send_text(ws: Conn, text: string) -> i32;
    fn hew_ws_send_binary(ws: Conn, data: bytes) -> i32;
    fn hew_ws_recv_next(ws: Conn, deadline_ms: i64) -> i32;
    fn hew_ws_take_text(ws: Conn) -> string;
    fn hew_ws_take_binary(ws: Conn) -> bytes;
    fn hew_ws_close(consume ws: Conn);
    fn hew_ws_server_new(addr: string) -> Server;
    fn hew_ws_server_port(server: Server) -> i32;
    fn hew_ws_server_accept(server: Server) -> Conn;
    fn hew_ws_server_close(consume server: Server);
}
