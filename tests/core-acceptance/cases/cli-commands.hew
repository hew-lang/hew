import std.cli;

fn application() -> cli.Command {
    var app = cli.command("harbour", "Manage a release");
    app.argument(cli.flag("verbose", .Some("v"), "Show progress"));
    var deploy = cli.command("deploy", "Deploy selected files");
    deploy.argument(cli.integer("jobs", .Some("j"), "COUNT", "Worker count"));
    deploy.argument(cli.choice("mode", .None, "MODE", "Deployment mode", ["safe", "fast"]));
    deploy.argument(cli.option("include", .Some("I"), "PATH", "Include a directory").repeated());
    deploy.argument(cli.option("label", .None, "TEXT", "Release label"));
    deploy.positionals("FILE");
    app.subcommand(deploy);
    app
}

fn parsed(app: cli.Command, args: Vec<string>) -> cli.Matches {
    match app.parse(args) {
        .Ok(.Parsed(matches)) => matches,
        .Ok(.Help(_)) => panic("expected arguments"),
        .Err(error) => panic(f"{error}"),
    }
}

fn rejected(app: cli.Command, args: Vec<string>) -> cli.ParseError {
    match app.parse(args) {
        .Err(error) => error,
        .Ok(_) => panic("invalid arguments accepted"),
    }
}

fn main() {
    assert("--label=雪".starts_with("--"));
    assert("雪🦀".starts_with("雪"));
    assert(!"雪🦀".starts_with("🦀"));
    assert(!"雪".starts_with("雪🦀"));
    assert("雪".starts_with(""));
    assert("".starts_with(""));
    assert(!"".starts_with("雪"));
    assert(!"e\u{301}".starts_with("é"));
    let app = application();
    let supplied = ["-vv", "deploy", "--jobs=4", "--mode", "safe", "-Ilib", "--include=generated", "--label=", "--", "雪", "-report", ""];
    let matches = parsed(app, supplied);
    assert(supplied.len() == 12);
    assert(matches.root().flag("verbose"));
    let deploy = matches.selected();
    assert(deploy.name == "deploy");
    assert(deploy.integer("jobs") == .Some(4));
    assert(deploy.value("mode") == .Some("safe"));
    assert(deploy.value("label") == .Some(""));
    assert(deploy.values("include") == ["lib", "generated"]);
    assert(deploy.positionals == ["雪", "-report", ""]);
    println("deploy: jobs=4 mode=safe includes=lib,generated");
    println("tail: 雪|-report|empty");
    let negative = parsed(app, ["deploy", "-j-2", "-I雪"]);
    assert(negative.selected().integer("jobs") == .Some(-2));
    assert(negative.selected().values("include") == ["雪"]);
    assert(parsed(app, ["deploy", "--jobs", "-3"]).selected().integer("jobs") == .Some(-3));
    println("negative integers and Unicode values");
    match rejected(app, ["deploy", "--jobs", "many"]) {
        .InvalidValue(name, value, _) => assert(name == "jobs" && value == "many"),
        _ => panic("expected invalid integer"),
    }
    assert(rejected(app, ["deploy", "-j1", "--jobs=2"]) == .RepeatedOption("jobs"));
    assert(rejected(app, ["deploy", "--jobs", "--mode", "safe"]) == .MissingValue("jobs"));
    match rejected(app, ["deploy", "--mode=unsafe"]) {
        .InvalidValue(name, value, _) => assert(name == "mode" && value == "unsafe"),
        _ => panic("expected invalid choice"),
    }
    assert(rejected(app, ["deploy", "--jo=2"]) == .UnknownOption("--jo=2"));
    assert(rejected(app, ["deploy", "--verbose"]) == .UnknownOption("--verbose"));
    assert(rejected(app, ["unknown"]) == .UnknownCommand("harbour", "unknown"));
    assert(rejected(app, Vec.new()) == .MissingCommand("harbour"));
    println("invalid values, missing values and duplicate options refused");
    match app.parse(["deploy", "--help"]) {
        .Ok(.Help(help)) => {
            assert(help.contains("harbour"));
            assert(help.contains("--jobs"));
            assert(help.contains("--include"));
            assert(help.contains("Worker count"));
        }
        .Ok(_) => panic("help parsed as application arguments"),
        .Err(error) => panic(f"{error}"),
    }
    println("subcommand help");
    var ambiguous = cli.command("ambiguous", "Invalid declaration");
    ambiguous.argument(cli.flag("first", .Some("x"), "First"));
    ambiguous.argument(cli.flag("second", .Some("x"), "Second"));
    match ambiguous.parse(["-x"]) {
        .Err(.InvalidDefinition(_)) => println("ambiguous schema refused"),
        _ => panic("ambiguous option accepted"),
    }
}
