//! Negative controls for the networking scalar and endpoint boundaries.
//!
//! Every native networking entry point narrows an `i64` argument to the `i32`
//! its C ABI declares. These tests reject the values that narrowing turned
//! into a different, plausible request: `2^32 + 500` as a 500 ms deadline,
//! `2^32 + 80` as port 80, and an address whose port never parsed at all as
//! `127.0.0.1:0`.

import std.net;

import std.net.http.http_client;

import std.net.tls;

import std.testing;

fn wrapped_to_500() -> i64 {
    4294967796 // 2^32 + 500: narrows to 500 as i32
}

fn wrapped_to_80() -> i64 {
    4294967376 // 2^32 + 80: narrows to 80 as i32
}

fn expect_invalid(label: string, result: Result<i64, net.NetError>) -> string {
    match result {
        .Ok(value) => {
            panic(f"{label}: expected rejection, got {value}");
            ""
        },
        .Err(err) => to_string(err),
    }
}

#[test]
fn test_duration_above_abi_range_is_rejected_not_narrowed() {
    let message = expect_invalid("try_duration_ms", net.duration_ms("net.probe", wrapped_to_500()));
    testing.assert_eq_str(message, "InvalidArgument(net.probe: invalid duration 4294967796 ms (must be <= 2147483647))");
    let negative = expect_invalid("try_duration_ms", net.duration_ms("net.probe", -1));
    testing.assert_eq_str(negative, "InvalidArgument(net.probe: invalid duration -1 ms (must be >= 0))");
}

#[test]
fn test_duration_within_abi_range_is_preserved() {
    match net.duration_ms("net.probe", 500) {
        .Ok(ms) => testing.assert_eq(ms, 500),
        .Err(_) => panic("expected 500 ms to be accepted"),
    }
    match net.duration_ms("net.probe", 0) {
        .Ok(ms) => testing.assert_eq(ms, 0),
        .Err(_) => panic("expected 0 ms to be accepted"),
    }
    match net.duration_ms("net.probe", net.abi_i32_max()) {
        .Ok(ms) => testing.assert_eq(ms, net.abi_i32_max()),
        .Err(_) => panic("expected the ABI ceiling to be accepted"),
    }
}

#[test]
fn test_size_above_abi_range_is_rejected() {
    let size = expect_invalid("try_size_arg", net.size_arg("tls.TlsStream.read", 4294967296));
    testing.assert_eq_str(size, "InvalidArgument(tls.TlsStream.read: invalid size 4294967296 (must be <= 2147483647))");
    match net.size_arg("tls.TlsStream.read", 4096) {
        .Ok(size_ok) => testing.assert_eq(size_ok, 4096),
        .Err(_) => panic("expected a 4096-byte read size to be accepted"),
    }
}

#[test]
fn test_port_above_abi_range_is_rejected_not_narrowed() {
    let wrapped = expect_invalid("try_port_arg", net.port_arg("tls.connect", wrapped_to_80()));
    testing.assert_eq_str(wrapped, "InvalidArgument(tls.connect: invalid port 4294967376 (must be 0..=65535))");
    let over = expect_invalid("try_port_arg", net.port_arg("tls.connect", 65536));
    testing.assert_eq_str(over, "InvalidArgument(tls.connect: invalid port 65536 (must be 0..=65535))");
    match net.port_arg("tls.connect", 443) {
        .Ok(port) => testing.assert_eq(port, 443),
        .Err(_) => panic("expected port 443 to be accepted"),
    }
}

fn expect_endpoint_rejected(addr: string) -> string {
    match net.parse_endpoint("net.connect_timeout", addr) {
        .Ok(endpoint) => {
            panic(f"expected '{addr}' to be rejected, got {endpoint.host}:{endpoint.port}");
            ""
        },
        .Err(err) => to_string(err),
    }
}

#[test]
fn test_missing_port_is_rejected_not_defaulted_to_zero() {
    testing.assert_eq_str(expect_endpoint_rejected("localhost"), "InvalidArgument(net.connect_timeout: invalid endpoint 'localhost' (missing ':port'))");
    testing.assert_eq_str(expect_endpoint_rejected(""), "InvalidArgument(net.connect_timeout: invalid endpoint '' (empty address))");
}

#[test]
fn test_non_numeric_and_out_of_range_ports_are_rejected() {
    testing.assert_eq_str(expect_endpoint_rejected("localhost:http"), "InvalidArgument(net.connect_timeout: invalid endpoint 'localhost:http' (port 'http' is not a number))");
    testing.assert_eq_str(expect_endpoint_rejected("localhost:"), "InvalidArgument(net.connect_timeout: invalid endpoint 'localhost:' (empty port))");
    testing.assert_eq_str(expect_endpoint_rejected("localhost:99999"), "InvalidArgument(net.connect_timeout: invalid port 99999 (must be 0..=65535))");
}

#[test]
fn test_unbracketed_ipv6_is_rejected_not_split_at_the_first_colon() {
    testing.assert_eq_str(expect_endpoint_rejected("::1:9000"), "InvalidArgument(net.connect_timeout: invalid endpoint '::1:9000' (unbracketed IPv6 literal; write [address]:port))");
    testing.assert_eq_str(expect_endpoint_rejected("[::1"), "InvalidArgument(net.connect_timeout: invalid endpoint '[::1' (unterminated '[' in IPv6 literal))");
    testing.assert_eq_str(expect_endpoint_rejected("[::1]"), "InvalidArgument(net.connect_timeout: invalid endpoint '[::1]' (missing ':port'))");
    testing.assert_eq_str(expect_endpoint_rejected("[]:9000"), "InvalidArgument(net.connect_timeout: invalid endpoint '[]:9000' (empty bracketed host))");
    testing.assert_eq_str(expect_endpoint_rejected("[::1]9000"), "InvalidArgument(net.connect_timeout: invalid endpoint '[::1]9000' (expected ':port' after ']'))");
}

fn endpoint_text(addr: string) -> string {
    match net.parse_endpoint("net.connect_timeout", addr) {
        .Ok(endpoint) => f"{endpoint.host}|{endpoint.port}",
        .Err(err) => {
            panic(f"expected '{addr}' to parse: {err}");
            ""
        },
    }
}

#[test]
fn test_valid_endpoints_are_preserved_exactly() {
    testing.assert_eq_str(endpoint_text("127.0.0.1:9000"), "127.0.0.1|9000");
    testing.assert_eq_str(endpoint_text("localhost:8080"), "localhost|8080");
    testing.assert_eq_str(endpoint_text("[::1]:9000"), "::1|9000");
    testing.assert_eq_str(endpoint_text(":0"), "127.0.0.1|0");
    testing.assert_eq_str(endpoint_text("example.com:65535"), "example.com|65535");
}

#[test]
fn test_connect_timeout_deadline_overflow_is_rejected() {
    match net.connect_timeout("127.0.0.1:9", 4294967, 0) {
        .Ok(_) => panic("expected an out-of-range deadline to be rejected"),
        .Err(err) => testing.assert_eq_str(to_string(err), "InvalidArgument(net.connect_timeout: invalid timeout_sec 4294967 (deadline exceeds 2147483647 ms))"),
    }
    match net.connect_timeout("127.0.0.1:9", 2147483, 648000) {
        .Ok(_) => panic("expected an accumulated deadline overflow to be rejected"),
        .Err(err) => testing.assert_eq_str(to_string(err), "InvalidArgument(net.connect_timeout: invalid deadline (timeout_sec 2147483 + timeout_usec 648000 exceeds 2147483647 ms))"),
    }
    match net.connect_timeout("127.0.0.1:9", -1, 0) {
        .Ok(_) => panic("expected a negative timeout_sec to be rejected"),
        .Err(err) => testing.assert_eq_str(to_string(err), "InvalidArgument(net.connect_timeout: invalid timeout_sec -1 (must be >= 0))"),
    }
}

#[test]
fn test_connect_timeout_rejects_a_malformed_address_before_connecting() {
    match net.connect_timeout("::1:9000", 1, 0) {
        .Ok(_) => panic("expected an unbracketed IPv6 address to be rejected"),
        .Err(err) => testing.assert_eq_str(to_string(err), "InvalidArgument(net.connect_timeout: invalid endpoint '::1:9000' (unbracketed IPv6 literal; write [address]:port))"),
    }
}

#[test]
#[should_panic]
fn test_connect_timeout_panics_at_legacy_boundary_on_a_wrapped_deadline() {
    let _ = net.connect_timeout("127.0.0.1:9", 4294967, 0);
}

#[test]
#[should_panic]
fn test_connect_timeout_panics_at_legacy_boundary_on_a_missing_port() {
    let _ = net.connect_timeout("localhost", 1, 0);
}

#[test]
fn test_http_client_timeout_above_abi_range_is_rejected() {
    match http_client.set_timeout(wrapped_to_500()) {
        .Ok(_) => panic("expected a wrapped HTTP timeout to be rejected"),
        .Err(err) => testing.assert_eq_str(to_string(err), "InvalidArgument(http_client.set_timeout: invalid duration 4294967796 ms (must be <= 2147483647))"),
    }
    match http_client.set_timeout(1000) {
        .Ok(_) => {},
        .Err(_) => panic("expected a 1000 ms HTTP timeout to be accepted"),
    }
    http_client.set_timeout(0);
}

#[test]
#[should_panic]
fn test_http_client_set_timeout_panics_at_legacy_boundary() {
    http_client.set_timeout(4294967796);
}

#[test]
#[should_panic]
fn test_tls_connect_panics_at_legacy_boundary_on_a_wrapped_port() {
    let _ = tls.connect("127.0.0.1", 4294967376);
}
