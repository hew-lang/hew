//! Hexadecimal encoding and decoding.
//!
//! Encode binary data to hexadecimal strings (lowercase or uppercase)
//! and decode hexadecimal strings back to binary data.
//!
//! # Examples
//!
//! ```
//! import std.encoding.hex;
//!
//! fn main() {
//!     var data: bytes = bytes.new();
//!     data.push(0xDE);
//!     data.push(0xAD);
//!     let s = hex.encode(data);
//!     println(s);   // "dead"
//!     let back = hex.decode(s).expect("encoded text is hex");
//!     println(back.len());  // 2
//!     println(f"{hex.decode("abc").is_err()}");  // true
//! }
//! ```

import std.encoding.utf8;

/// Encode binary data to a lowercase hex string.
pub fn encode(data: bytes) -> string {
    encode_impl(data, false)
}

/// Encode binary data to an uppercase hex string.
pub fn encode_upper(data: bytes) -> string {
    encode_impl(data, true)
}

/// Text that is not hexadecimal.
pub enum DecodeError {
    /// The text has an odd number of digits, so its last byte is incomplete.
    InvalidLength(i64);
    /// The character at `index` is not a hex digit.
    InvalidCharacter { index: i64; text: string; }
}

impl Error for DecodeError {}

/// Decode a hex string to binary data. The empty string decodes to no bytes;
/// any other text that is not pairs of hex digits fails.
pub fn decode(s: string) -> bytes fails DecodeError {
    let slen = s.len();
    var out: bytes = bytes.new();
    if slen % 2 != 0 {
        return error .InvalidLength(slen);
    }
    for i in (0..slen).step_by(2) {
        let hi = nibble(s, i)?;
        let lo = nibble(s, i + 1)?;
        out.push((hi * 16 + lo) as u8);
    }
    out
}

/// Encode binary data to a hex string, optionally uppercase.
fn encode_impl(data: bytes, upper: bool) -> string {
    var out: bytes = bytes.new();
    for i in 0..data.len() {
        let b = data[i];
        let hi = b as i32 / 16;
        let lo = b as i32 % 16;
        out.push(nibble_to_char(hi, upper) as u8);
        out.push(nibble_to_char(lo, upper) as u8);
    }
    utf8.decode(out) handle error {
        panic("Hex encoder produces ASCII");
    }
}

/// Convert a 4-bit nibble (0–15) to its ASCII hex character code.
fn nibble_to_char(n: i32, upper: bool) -> i32 { // INTERNAL-ABI: byte-level nibble arithmetic; values 0-15 fit i32
    if n < 10 {
        48 + n
    } else {
        if upper { 55 + n } else { 87 + n }
    }
}

fn nibble(text: string, index: i64) -> i64 fails DecodeError {
    let digit = text[index];
    digit.to_digit(16) ?? return error .InvalidCharacter { index, text: f"{digit}" }
}
