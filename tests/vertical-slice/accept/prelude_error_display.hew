// The prelude error enums declared in `std/builtins.hew` (SendError,
// LookupError, ActorError, LinkError) print variant-first via `f"{e}"`.
fn main() {
    let send_err = SendError.Closed;
    println(f"{send_err}");
    let lookup_err = LookupError.NotFound;
    println(f"{lookup_err}");
    let ask_err: ActorError<Never, Never> = ActorError.NodeNotRunning;
    println(f"{ask_err}");
    let link_err = LinkError.NoContext;
    println(f"{link_err}");
}
