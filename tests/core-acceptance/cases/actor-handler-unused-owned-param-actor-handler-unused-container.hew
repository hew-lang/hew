actor ProbeSink { 
    var seen: i64,
    receive fn take(values: Vec<string>) { seen = seen + 1; }
    receive fn count() -> i64 { seen }
}
fn main() -> i64 {
    let sink = spawn ProbeSink(seen: 0);
    var i: i64 = 0;
    while i < 50 {
        let values: Vec<string> = ["left".to_upper(), "right".to_upper()];
        let _ = sink.take(values);
        i = i + 1;
    }
    match sink.count() { .Ok(n) => if n == 50 { 0 } else { 75 }, .Err(_) => 76 }
}
