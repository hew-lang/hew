// The imported diamond shares one Base impl across both branches.
import hew.supertraits.{Base, Left, Right, Diamond};

type DM {
    id: i64,
}

impl Base for DM {
    fn base(w: DM) -> i64 {
        w.id
    }
}

impl Left for DM {
    fn left(w: DM) -> i64 {
        w.id + 10
    }
}

impl Right for DM {
    fn right(w: DM) -> i64 {
        w.id + 20
    }
}

impl Diamond for DM {
    fn diamond(w: DM) -> i64 {
        w.id + 30
    }
}

fn main() {
    let w = DM { id: 1 };
    println(f"diamond {w.diamond()} left {w.left()} right {w.right()} base {w.base()}");
}
