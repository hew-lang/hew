//! TCP read from an actor using the ordinary `conn.recv()` call.
//! `fork` starts the reader concurrently before main accepts and serves
//! the connection; an ordinary call would wait for the reader first.

import std.encoding.utf8;

import std.net;

actor Reader {
    let port: string,
    receive fn go(unused: i64) {

        // Give main a moment to start listening, then connect and read.
        sleep(200ms);
        let conn = match net.connect(f"127.0.0.1:{port}") {
            .Ok(conn) => conn,
            .Err(_) => panic(f"network setup failed"),
        };
        match conn.recv() {
            .Some(data) => {
                let body = utf8.decode(data) handle error {
                    println(f"invalid UTF-8: {error}");
                    return;
                };
                println(f"reader-received: {body}");
            },
            .None => println("reader-received: peer closed"),
        }
        let _ = conn.close();
    }
}

fn main() {
    let listener = match net.listen("127.0.0.1:18077") {
        .Ok(listener) => listener,
        .Err(_) => panic(f"network setup failed"),
    };
    let reader = spawn Reader(port: "18077");
    fork reader.go(0);
    let client = listener.accept();
    let _ = client.send("hello-from-server".to_bytes());
    sleep(500ms);
    let _ = client.close();
    println("server-done");
}
