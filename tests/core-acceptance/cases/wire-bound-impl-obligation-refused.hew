// A Hash and Eq impl bounded by `T: Serializable` does not apply to a key
// whose argument is a resource, so the map has no key operations.
#[resource]
type Handle {
    fd: i64;
}

type Key<T> {
    id: T;
}

impl<T: Serializable> Eq for Key<T> {
    fn eq(self, other: Key<T>) -> bool {
        true
    }
}

impl<T: Serializable> Hash for Key<T> {
    fn hash(self) -> i64 {
        7
    }
}

fn main() {
    let handles: HashMap<Key<Handle>, i64> = HashMap.new();
    println(f"{handles.len()}");
}
