import std.encoding.utf8;

extern "C" {
    fn hew_bytes_from_str(s: string) -> bytes;
}

fn main() {
    let xs: Vec<((bytes, i64), bool)> = Vec.new();
    let a: bytes = unsafe {
        hew_bytes_from_str("ab")
    };
    let b: bytes = unsafe {
        hew_bytes_from_str("cd")
    };
    xs.push(((a, 11), true));
    xs.push(((b, 12), false));
    let ys = xs.clone();
    let first = ys[0];
    let second = ys[1];
    let (f_inner, f_flag) = first;
    let (f_b, f_n) = f_inner;
    let (s_inner, s_flag) = second;
    let (s_b, s_n) = s_inner;
    let decoded_f_b = utf8.decode(f_b) handle error {
        println(f"invalid UTF-8: {error}");
        return;
    };
    let decoded_s_b = utf8.decode(s_b) handle error {
        println(f"invalid UTF-8: {error}");
        return;
    };
    println(f"{ys.len()}:{decoded_f_b}:{f_n}:{f_flag}:{decoded_s_b}:{s_n}:{s_flag}");
}
