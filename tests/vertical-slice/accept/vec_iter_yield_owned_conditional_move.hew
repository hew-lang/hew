// A conditional insertion transfers an independent yielded value into the returned map.
fn keep_big(rows: Vec<i64>, var keep: HashMap<string, Vec<i64>>) -> HashMap<string, Vec<i64>> {
    var all: Vec<Vec<i64>> = [];
    all.push(rows);
    for row in all {
        if row.len() > 2 {
            keep.insert("big", row);
        }
        let probe = keep.get("big");
        match probe {
            .Some(found) => {
                println(f"n={found.len()}");
            },
            .None => {},
        }
    }
    keep
}

fn main() {
    var keep: HashMap<string, Vec<i64>> = HashMap.new();
    keep = keep_big([1, 2, 3], keep);
    keep = keep_big([4, 5], keep);
    println("conditional-move-ok");
}
