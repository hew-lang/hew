// Accept: user function returning Maybe<i64> with Some payload.
// Exercises MachineVariantCtor → Move to ReturnSlot → aggregate ret.
// Exit 42 proves the caller received and destructured the composite.
enum Maybe<T> {
    Some(T);
    None;
}

fn maybe() -> Maybe<i64> {
    Maybe::Some(42)
}

fn main() -> i64 {
    let r = maybe();
    match r {
        Maybe::Some(v) => v,
        Maybe::None => 0,
    }
}
