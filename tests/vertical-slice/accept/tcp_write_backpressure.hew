// Accept fixture (IO-C1): TCP write-side backpressure surfaces as a typed
// `Result<(), SendError>`.
//
// A producer connects to a peer that NEVER reads. With a short write timeout
// set, a write large enough to overflow the OS send buffer cannot complete
// within the deadline, so `conn.send(...)` resolves to
// `Err(SendError.WriteTimedOut(n))` with the part of the payload the OS took.
// This proves the deadline is observable, correctly classified at the Hew
// call site and reports a committed prefix.
//
// Exit-code contract (each code is distinct so the assertion proves the exact
// arm reached, not just non-zero):
//   42 -> small send succeeded (Ok) AND the large send returned
//         Err(SendError.WriteTimedOut(n)) with 0 < n < payload length.
//    7 -> large send returned Err, but NOT a WriteTimedOut with a partial prefix
//    5 -> large write returned Ok (no backpressure observed — signal missing)
//    3 -> small write itself failed (setup wrong)
//   99 -> control flow never reached the producer (main fallback)
import std.net.{Listener};

fn main() {
    let listener = match net.listen("127.0.0.1:0") {
        .Ok(listener) => listener,
        .Err(_) => exit(3),
    };
    let port = listener.local_port() as i32;
    // Producer side: connect, then accept the peer but never read from it.
    let conn = match net.connect(f"127.0.0.1:{port}") {
        .Ok(conn) => conn,
        .Err(_) => exit(3),
    };
    let peer = listener.accept().expect("accept");
    // Bound the wait so a full send buffer fails fast instead of blocking.
    let _ = conn.set_write_timeout(100);
    // A small write fits in the send buffer and succeeds immediately.
    let small_ok = match conn.send("ping".to_bytes()) {
        .Ok(_) => true,
        .Err(_) => false,
    };
    if !small_ok {
        exit(3);
    }
    // Build a 16 MiB payload — comfortably larger than the autotuned send +
    // receive buffer capacity on a loopback socket on every supported platform.
    // The peer never drains, so once the kernel buffers fill, the write waits
    // out the 100ms timeout and reports how much of the payload it committed.
    let big = "0123456789abcdef".repeat(1024 * 1024).to_bytes();
    let code = match conn.send(big) {
        .Ok(_) => 5,
        .Err(e) => {
            match e {
                SendError.WriteTimedOut(committed) if committed > 0 && committed < 16 * 1024 * 1024 => 42,
                _ => 7,
            }
        }
    };
    let _ = peer.close();
    let _ = conn.close();
    exit(code);
}
