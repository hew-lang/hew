// Buffered notifications and the FIFO driver let both bounded tasks finish
// before their parent resumes. The race releases the unobserved result once.
import std.stream;

#[resource]
type Handle {
    label: string;
}

impl Handle {
    fn close(consume self) {
        println("closed " + self.label);
    }
}

fn make(label: string, done: stream.Sink<i64>) -> Handle {
    println(label + " done");
    done.send(1).expect("completion notification");
    Handle { label: label }
}

fn main() {
    let (first_done, first_ready): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("first pipe");
    let (second_done, second_ready): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("second pipe");
    let first = fork make("fast", first_done);
    let second = fork make("slow", second_done);
    first_ready.recv().expect("first completion");
    second_ready.recv().expect("second completion");
    let winner = await race [
        first,
        second,
    ];
    println("picked " + winner.label);
    winner.close();
}
