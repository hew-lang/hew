//! QUIC transport for internode messaging.
//!
//! Provides multiplexed, bidirectional byte streams over QUIC/UDP connections.
//! QUIC connections carry multiple independent streams so that head-of-line
//! blocking never stalls unrelated traffic — ideal for actor supervisor chains
//! and distributed messaging between Hew nodes.
//!
//! # Architecture
//!
//! ```text
//!  ┌──────────────────────────────────────────────────────────┐
//!  │ QUICEndpoint                                             │
//!  │  bound to a local UDP address (client or server)         │
//!  │                                                          │
//!  │  ┌─────────────────────────────────────────────────┐    │
//!  │  │ QUICConnection  (one per remote peer)            │    │
//!  │  │  ┌──────────────┐  ┌──────────────┐             │    │
//!  │  │  │ QUICStream   │  │ QUICStream   │  …          │    │
//!  │  │  │ (send/recv)  │  │ (send/recv)  │             │    │
//!  │  │  └──────────────┘  └──────────────┘             │    │
//!  │  └─────────────────────────────────────────────────┘    │
//!  └──────────────────────────────────────────────────────────┘
//! ```
//!
//! # Examples
//!
//! ## Server
//!
//! ```hew,no_run
//! import std.net;
//! import std.net.quic;
//!
//! fn main() {
//!     let ep = quic.new_server(":4433").expect("QUIC operation succeeds");
//!     let conn = ep.accept().expect("QUIC operation succeeds");
//!     let stream = conn.accept_stream().expect("QUIC operation succeeds");
//!     let data = stream.recv().expect("QUIC operation succeeds");
//!     match stream.send(data) {
//!         .Ok(_) => {}
//!         .Err(err) => panic(to_string(err)),
//!     }
//!     match stream.finish() {
//!         .Ok(_) => {}
//!         .Err(err) => panic(to_string(err)),
//!     }
//!     stream.close();
//!     // Drain connection events so the peer has received all in-flight data
//!     // before the connection is torn down. Calling conn.close() before
//!     // both the stream-closed (kind=3) and peer-disconnected (kind=1)
//!     // events arrive can race delivery on the wire. Across separate
//!     // processes the exact order is not guaranteed.
//!     let ev1 = conn.on_event(); ev1.close();
//!     let ev2 = conn.on_event(); ev2.close();
//!     conn.close();
//!     ep.close();
//! }
//! ```
//!
//! ## Client
//!
//! ```hew,no_run
//! import std.net;
//! import std.net.quic;
//!
//! fn main() {
//!     let ep = quic.new_client().expect("QUIC operation succeeds");
//!     let conn = ep.connect("127.0.0.1:4433", "localhost").expect("QUIC connection");
//!     let stream = conn.open_stream().expect("QUIC operation succeeds");
//!     match stream.send(b"hello quic") {
//!         .Ok(_) => {}
//!         .Err(err) => panic(to_string(err)),
//!     }
//!     let reply = stream.recv().expect("QUIC operation succeeds");
//!     match stream.finish() {
//!         .Ok(_) => {}
//!         .Err(err) => panic(to_string(err)),
//!     }
//!     // Drain to EOF before closing.  Without this recv() the local close
//!     // can race the server's final STREAM_FIN frame and the reply may be
//!     // lost in transit.
//!     let eof = stream.recv().expect("QUIC operation succeeds");
//!     stream.close();
//!     conn.close();
//!     ep.close();
//! }
//! ```

import std.net;

import std.encoding.utf8;

/// A QUIC endpoint bound to a local UDP address.
///
/// An endpoint can operate as a client (dial outgoing connections) or as
/// a server (accept incoming connections), or both simultaneously.
///
/// Created by `quic.new_client()` or `quic.new_server(addr)`.
/// Must be released with `close()`.
#[resource]
#[opaque]
pub type QUICEndpoint {
}

/// An established QUIC connection to a remote peer.
///
/// A connection multiplexes many independent streams over a single UDP path.
/// Obtained from `endpoint.connect()` (client) or `endpoint.accept()` (server).
/// Must be released with `disconnect()`.
#[resource]
#[opaque]
pub type QUICConnection {
}

/// A bidirectional QUIC stream within a connection.
///
/// Streams are independent of each other: a slow receiver on one stream does
/// not delay data arriving on another stream of the same connection.
///
/// Obtained from `conn.open_stream()` or `conn.accept_stream()`.
/// Finish the send side with `finish()` when no more data will be sent;
/// the receive side drains naturally.
#[resource]
#[opaque]
pub type QUICStream {
}

/// An observed QUIC event emitted by an endpoint or connection.
///
/// Used by the blocking event API to react to queued connection and channel
/// events. Pair this with `observe()` for non-destructive snapshots.
#[opaque]
type QUICEventHandle {
}

#[resource]
pub type QUICEvent {
    handle: QUICEventHandle;
}

/// Non-destructive endpoint observation.
pub type QUICEndpointObservation {
    local_addr: string;
    accepted_connections: i64;
    last_error: string;
}

/// Non-destructive connection observation.
pub type QUICConnectionObservation {
    local_addr: string;
    peer_addr: string;
    opened_streams: i64;
    accepted_streams: i64;
    rtt_ms: i64;
    bytes_sent: i64;
    bytes_received: i64;
    closed: bool;
    last_error: string;
}

/// Non-destructive stream observation.
pub type QUICStreamObservation {
    bytes_sent: i64;
    bytes_received: i64;
    send_closed: bool;
    recv_closed: bool;
    last_error: string;
}

/// A receive failure or malformed UTF-8 in a received buffer.
pub enum ReadError {
    Network(net.NetError);
    Decode(utf8.Utf8Error);
}

impl Error for ReadError {}

// ── QUICEndpoint methods ──────────────────────────────────────────────
/// Methods available on a `QUICEndpoint`.
trait QUICEndpointMethods {
    /// Dial a remote QUIC server.
    ///
    /// `addr` is a `"host:port"` address; `server_name` is the TLS SNI name
    /// used to verify the server's certificate.
    ///
    /// Return an established connection or the protocol failure.
    fn connect(self, addr: string, server_name: string) -> QUICConnection fails net.NetError;

    /// Block until a remote peer opens an incoming connection (server side).
    ///
    /// Return an established connection or the protocol failure.
    fn accept(self) -> QUICConnection fails net.NetError;

    /// Block until the next queued QUIC event on this endpoint.
    ///
    /// Events are recorded by successful `connect()` and `accept()` calls and
    /// by connection failures observed by the runtime.
    fn on_event(self) -> QUICEvent;

    /// Return a non-destructive snapshot of endpoint state.
    fn observe(self) -> QUICEndpointObservation;
}

impl QUICEndpointMethods for QUICEndpoint {
    fn connect(self, addr: string, server_name: string) -> QUICConnection fails net.NetError {
        let value = unsafe {
            hew_quic_endpoint_connect(self, addr, server_name)
        };
        if unsafe {
            hew_quic_conn_is_valid(value)
        } {
            value
        } else {
            return error net.NetError.Protocol(unsafe {
                hew_quic_endpoint_last_error(self)
            });
        }
    }
    fn accept(self) -> QUICConnection fails net.NetError {
        let value = unsafe {
            hew_quic_endpoint_accept(self)
        };
        if unsafe {
            hew_quic_conn_is_valid(value)
        } {
            value
        } else {
            return error net.NetError.Protocol(unsafe {
                hew_quic_endpoint_last_error(self)
            });
        }
    }
    fn on_event(self) -> QUICEvent {
        unsafe {
            QUICEvent { handle: hew_quic_endpoint_on_event(self) }
        }
    }
    fn observe(self) -> QUICEndpointObservation {
        QUICEndpointObservation { local_addr: unsafe {
            hew_quic_endpoint_local_addr(self)
        }, accepted_connections: unsafe {
            hew_quic_endpoint_accepted_connections(self)
        }, last_error: unsafe {
            hew_quic_endpoint_last_error(self)
        } }
    }
}

impl QUICEndpoint {
    /// Release this endpoint early. Scope exit performs the same release.
    fn close(consume self) {
        unsafe {
            hew_quic_endpoint_close(self)
        };
    }
}

// ── QUICConnection methods ────────────────────────────────────────────
/// Methods available on a `QUICConnection`.
trait QUICConnectionMethods {
    /// Open a new bidirectional stream on this connection.
    ///
    /// Return an open stream or the protocol failure.
    fn open_stream(self) -> QUICStream fails net.NetError;

    /// Block until the remote peer opens an incoming stream.
    ///
    /// Return an open stream or the protocol failure.
    fn accept_stream(self) -> QUICStream fails net.NetError;

    /// Block until the next queued QUIC event on this connection.
    ///
    /// Events are recorded when streams open, when the peer disconnects, and
    /// when stream operations fail.
    fn on_event(self) -> QUICEvent;

    /// Return a non-destructive snapshot of connection state and telemetry.
    fn observe(self) -> QUICConnectionObservation;
}

impl QUICConnectionMethods for QUICConnection {
    fn open_stream(self) -> QUICStream fails net.NetError {
        let value = unsafe {
            hew_quic_conn_open_stream(self)
        };
        if unsafe {
            hew_quic_stream_is_valid(value)
        } {
            value
        } else {
            return error net.NetError.Protocol(unsafe {
                hew_quic_conn_last_error(self)
            });
        }
    }
    fn accept_stream(self) -> QUICStream fails net.NetError {
        let value = unsafe {
            hew_quic_conn_accept_stream(self)
        };
        if unsafe {
            hew_quic_stream_is_valid(value)
        } {
            value
        } else {
            return error net.NetError.Protocol(unsafe {
                hew_quic_conn_last_error(self)
            });
        }
    }
    fn on_event(self) -> QUICEvent {
        unsafe {
            QUICEvent { handle: hew_quic_conn_on_event(self) }
        }
    }
    fn observe(self) -> QUICConnectionObservation {
        QUICConnectionObservation { local_addr: unsafe {
            hew_quic_conn_local_addr(self)
        }, peer_addr: unsafe {
            hew_quic_conn_peer_addr(self)
        }, opened_streams: unsafe {
            hew_quic_conn_opened_streams(self)
        }, accepted_streams: unsafe {
            hew_quic_conn_accepted_streams(self)
        }, rtt_ms: unsafe {
            hew_quic_conn_rtt_ms(self) as i64
        }, bytes_sent: unsafe {
            hew_quic_conn_bytes_sent(self)
        }, bytes_received: unsafe {
            hew_quic_conn_bytes_received(self)
        }, closed: unsafe {
            hew_quic_conn_is_closed(self)
        }, last_error: unsafe {
            hew_quic_conn_last_error(self)
        } }
    }
}

impl QUICConnection {
    /// Gracefully close this connection and release its resources.
    fn close(consume self) {
        unsafe {
            hew_quic_conn_disconnect(self)
        };
    }
}

// ── QUICStream methods ────────────────────────────────────────────────
/// Methods available on a `QUICStream`.
trait QUICStreamMethods {
    /// Send raw bytes on this stream.
    ///
    /// Returns `Ok(())` on success or `Err(net.NetError)` on failure.
    fn send(self, data: bytes) -> Result<(), net.NetError>;

    /// Block until data arrives and return the received bytes.
    ///
    /// Returns an empty buffer on stream EOF and an error on transport failure.
    fn recv(self) -> bytes fails net.NetError;

    /// Receive bytes with a per-call deadline.
    ///
    /// `timeout <= 0ns` disables the deadline. On deadline expiry returns
    /// `Err(net.NetError.TimedOut(0))`. On stream EOF returns `Ok(empty)`.
    fn recv_timeout(self, timeout: duration) -> bytes fails net.NetError;

    /// Send bytes with a per-call deadline.
    ///
    /// `timeout <= 0ns` disables the deadline. On deadline expiry returns
    /// `Err(net.NetError.TimedOut(0))`.
    fn send_timeout(self, data: bytes, timeout: duration) fails net.NetError;

    /// Signal that no more data will be sent on this stream.
    ///
    /// The receive side of the remote peer will see EOF after all buffered
    /// data has been delivered. This does not release the local stream handle;
    /// call `close()` when you are finished with the stream. Returns `Ok(())`
    /// on success or `Err(net.NetError)` on failure.
    fn finish(self) -> Result<(), net.NetError>;

    /// Abruptly stop this stream with an application-defined error code.
    ///
    /// Unlike `finish`, pending data is discarded. Call `close()` afterwards to
    /// release the local stream handle. Returns `Ok(())` on success or
    /// `Err(net.NetError)` on failure.
    fn stop(self, error_code: i64) -> Result<(), net.NetError>;

    /// Send a UTF-8 string on this stream.
    ///
    /// Convenience wrapper around `send` that converts `msg` to bytes first.
    /// Returns `Ok(())` on success or `Err(net.NetError)` on failure.
    fn send_string(self, msg: string) -> Result<(), net.NetError>;

    /// Block until data arrives and return it as a UTF-8 string.
    ///
    /// Validates one received buffer; malformed or incomplete UTF-8 is an
    /// error. An empty buffer represents stream EOF.
    /// Retain raw bytes across reads when decoding streaming text.
    fn recv_string(self) -> string fails ReadError;

    /// Return a non-destructive snapshot of stream state.
    fn observe(self) -> QUICStreamObservation;
}

impl QUICStreamMethods for QUICStream {
    fn send(self, data: bytes) -> Result<(), net.NetError> {
        // Capture the stream failure before another operation changes its observation.
        unsafe {
            let status = hew_quic_stream_send(self, data);
            if status == QUIC_ABSENT_HANDLE {
                .Err(net.NetError.InvalidArgument("this QUIC stream was never opened"))
            } else if status < 0 {
                .Err(net.NetError.Protocol(hew_quic_stream_last_error(self)))
            } else {
                .Ok(())
            }
        }
    }
    fn recv(self) -> bytes fails net.NetError {
        self.recv_timeout(0ms)?
    }
    fn recv_timeout(self, timeout: duration) -> bytes fails net.NetError {
        let deadline = quic_deadline_ms("quic.stream_recv_timeout", timeout)?;
        let payload: bytes = unsafe { // INTERNAL-ABI: deadline range-checked above
            hew_quic_stream_recv_timeout_hew(self, deadline as i32)
        };
        let status: i32 = unsafe { // INTERNAL-ABI: 0=ok-or-EOF, -1=transport error, -2=timeout, -3=absent handle
            hew_quic_stream_last_recv_status()
        };
        if status == QUIC_ABSENT_HANDLE {
            return error net.NetError.InvalidArgument("this QUIC stream was never opened");
        } else if status == -2 {
            return error net.net_error_timed_out();
        } else if status < 0 {
            return error net.NetError.Protocol(unsafe {
                hew_quic_stream_last_error(self)
            });
        } else {
            payload
        }
    }
    fn send_timeout(self, data: bytes, timeout: duration) fails net.NetError {
        let deadline = quic_deadline_ms("quic.stream_send_timeout", timeout)?;
        let status: i32 = unsafe { // INTERNAL-ABI: 0=ok, -1=error, -2=timeout, -3=absent handle; deadline range-checked above
            hew_quic_stream_send_timeout_hew(self, data, deadline as i32)
        };
        if status == QUIC_ABSENT_HANDLE {
            return error net.NetError.InvalidArgument("this QUIC stream was never opened");
        } else if status == -2 {
            return error net.net_error_timed_out();
        } else if status < 0 {
            return error net.NetError.Protocol(unsafe {
                hew_quic_stream_last_error(self)
            });
        }
    }
    fn finish(self) -> Result<(), net.NetError> {
        // Capture the stream failure before another operation changes its observation.
        unsafe {
            let status = hew_quic_stream_finish(self);
            if status == QUIC_ABSENT_HANDLE {
                .Err(net.NetError.InvalidArgument("this QUIC stream was never opened"))
            } else if status < 0 {
                .Err(net.NetError.Protocol(hew_quic_stream_last_error(self)))
            } else {
                .Ok(())
            }
        }
    }
    fn stop(self, error_code: i64) -> Result<(), net.NetError> { // INTERNAL-ABI: QUIC protocol mandates 62-bit error codes; i64 is 64-bit i64 so no narrowing needed
        // Capture the stream failure before another operation changes its observation.
        unsafe {
            let status = hew_quic_stream_stop(self, error_code);
            if status == QUIC_ABSENT_HANDLE {
                .Err(net.NetError.InvalidArgument("this QUIC stream was never opened"))
            } else if status < 0 {
                .Err(net.NetError.Protocol(hew_quic_stream_last_error(self)))
            } else {
                .Ok(())
            }
        }
    }
    fn send_string(self, msg: string) -> Result<(), net.NetError> {
        unsafe {
            let payload = hew_string_to_bytes(msg);
            self.send(payload)
        }
    }
    fn recv_string(self) -> string fails ReadError {
        let payload = match self.recv() {
            .Ok(payload) => payload,
            .Err(error) => return error ReadError.Network(error),
        };
        match utf8.decode(payload) {
            .Ok(text) => text,
            .Err(error) => return error ReadError.Decode(error),
        }
    }
    fn observe(self) -> QUICStreamObservation {
        QUICStreamObservation { bytes_sent: unsafe {
            hew_quic_stream_bytes_sent(self)
        }, bytes_received: unsafe {
            hew_quic_stream_bytes_received(self)
        }, send_closed: unsafe {
            hew_quic_stream_send_closed(self)
        }, recv_closed: unsafe {
            hew_quic_stream_recv_closed(self)
        }, last_error: unsafe {
            hew_quic_stream_last_error(self)
        } }
    }
}

impl QUICStream {
    /// Release this stream early. Scope exit performs the same release.
    fn close(consume self) {
        unsafe {
            hew_quic_stream_close(self)
        };
    }
}

// ── QUICEvent methods ─────────────────────────────────────────────────
/// Methods available on a `QUICEvent`.
trait QUICEventMethods {
    /// Return the event kind as an integer.
    ///
    /// Event kinds:
    ///   0 — connected, 1 — disconnected, 2 — stream opened,
    ///   3 — stream closed, −1 — error.
    fn kind(self) -> i32;
} // INTERNAL-ABI: opaque event-kind enum (0=connected, 1=disconnected, 2=stream-opened, 3=stream-closed, -1=error)
impl QUICEventMethods for QUICEvent {
    fn kind(self) -> i32 { // INTERNAL-ABI: opaque event-kind enum
        unsafe {
            hew_quic_event_kind(self.handle)
        }
    }
}

impl QUICEvent {
    /// Release this event early.
    fn close(consume self) {
        unsafe {
            hew_quic_event_free(self.handle)
        };
    }
}

// ── Module-level constructors ─────────────────────────────────────────
/// Create a QUIC client endpoint bound to an ephemeral local port.
///
/// The endpoint is configured with a permissive TLS verifier suitable
/// for development. Pass TLS configuration explicitly for production use.
///
/// # Examples
///
/// ```hew,no_run
/// import std.net.quic;
///
/// fn main() {
///     let ep = quic.new_client().expect("QUIC operation succeeds");
///     let conn = ep.connect("node2.example.com:4433", "node2.example.com").expect("QUIC operation succeeds");
/// }
/// ```
pub fn new_client() -> QUICEndpoint fails net.NetError {
    let endpoint = unsafe {
        hew_quic_new_client()
    };
    if unsafe {
        hew_quic_endpoint_is_valid(endpoint)
    } {
        endpoint
    } else {
        return error net.NetError.Protocol(unsafe {
            hew_quic_last_error()
        });
    }
}

/// Create a QUIC client endpoint that trusts the given CA bundle.
///
/// `ca_pem` must contain one or more PEM-encoded certificates.
pub fn new_client_with_ca(ca_pem: string) -> QUICEndpoint fails net.NetError {
    let endpoint = unsafe {
        hew_quic_new_client_with_ca(ca_pem)
    };
    if unsafe {
        hew_quic_endpoint_is_valid(endpoint)
    } {
        endpoint
    } else {
        return error net.NetError.Protocol(unsafe {
            hew_quic_last_error()
        });
    }
}

/// Bind a QUIC server endpoint on `addr`.
///
/// `addr` uses `"host:port"` or `":port"` notation.  A self-signed
/// certificate is generated automatically for development use.
///
/// # Examples
///
/// ```hew,no_run
/// import std.net.quic;
///
/// fn main() {
///     let ep = quic.new_server(":4433").expect("QUIC operation succeeds");
///     let conn = ep.accept().expect("QUIC operation succeeds");
/// }
/// ```
pub fn new_server(addr: string) -> QUICEndpoint fails net.NetError {
    let endpoint = unsafe {
        hew_quic_new_server(addr)
    };
    if unsafe {
        hew_quic_endpoint_is_valid(endpoint)
    } {
        endpoint
    } else {
        return error net.NetError.Protocol(unsafe {
            hew_quic_last_error()
        });
    }
}

/// Bind a QUIC server endpoint on `addr` with explicit TLS material.
///
/// `cert_pem` may contain a PEM-encoded certificate chain; `key_pem` must
/// contain the matching PEM-encoded private key.
pub fn new_server_with_tls(addr: string, cert_pem: string, key_pem: string) -> QUICEndpoint fails net.NetError {
    let endpoint = unsafe {
        hew_quic_new_server_with_tls(addr, cert_pem, key_pem)
    };
    if unsafe {
        hew_quic_endpoint_is_valid(endpoint)
    } {
        endpoint
    } else {
        return error net.NetError.Protocol(unsafe {
            hew_quic_last_error()
        });
    }
}

// Distinct from the transport failure (-1) and per-call timeout (-2).
const QUIC_ABSENT_HANDLE: i64 = 0 - 3;

/// Validate a QUIC per-call deadline before the C ABI narrows it to `i32`.
///
/// A non-positive deadline disables the deadline and is normalized to zero;
/// a positive one must be representable, so `2^32 + 500` is rejected rather
/// than narrowed into a 500 ms deadline.
fn quic_deadline_ms(context: string, timeout: duration) -> Result<i64, net.NetError> {
    if timeout <= 0ns {
        return .Ok(0);
    }
    net.duration_ms(context, timeout)
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    fn hew_quic_endpoint_is_valid(endpoint: QUICEndpoint) -> bool;
    fn hew_quic_conn_is_valid(connection: QUICConnection) -> bool;
    fn hew_quic_stream_is_valid(stream: QUICStream) -> bool;
    // Endpoint constructors
    fn hew_quic_new_client() -> QUICEndpoint;
    fn hew_quic_new_client_with_ca(ca_pem: string) -> QUICEndpoint;
    fn hew_quic_new_server(addr: string) -> QUICEndpoint;
    fn hew_quic_new_server_with_tls(addr: string, cert_pem: string, key_pem: string) -> QUICEndpoint;
    fn hew_quic_last_error() -> string;

    // Endpoint methods
    fn hew_quic_endpoint_connect(ep: QUICEndpoint, addr: string, server_name: string) -> QUICConnection;
    fn hew_quic_endpoint_accept(ep: QUICEndpoint) -> QUICConnection;
    fn hew_quic_endpoint_close(consume ep: QUICEndpoint);
    fn hew_quic_endpoint_on_event(ep: QUICEndpoint) -> QUICEventHandle;
    fn hew_quic_endpoint_local_addr(ep: QUICEndpoint) -> string;
    fn hew_quic_endpoint_accepted_connections(ep: QUICEndpoint) -> i64;
    fn hew_quic_endpoint_last_error(ep: QUICEndpoint) -> string;

    // Connection methods
    fn hew_quic_conn_open_stream(conn: QUICConnection) -> QUICStream;
    fn hew_quic_conn_accept_stream(conn: QUICConnection) -> QUICStream;
    fn hew_quic_conn_disconnect(consume conn: QUICConnection) -> i32;
    fn hew_quic_conn_on_event(conn: QUICConnection) -> QUICEventHandle;
    fn hew_quic_conn_local_addr(conn: QUICConnection) -> string;
    fn hew_quic_conn_peer_addr(conn: QUICConnection) -> string;
    fn hew_quic_conn_opened_streams(conn: QUICConnection) -> i64;
    fn hew_quic_conn_accepted_streams(conn: QUICConnection) -> i64;
    fn hew_quic_conn_rtt_ms(conn: QUICConnection) -> i32;
    fn hew_quic_conn_bytes_sent(conn: QUICConnection) -> i64;
    fn hew_quic_conn_bytes_received(conn: QUICConnection) -> i64;
    fn hew_quic_conn_is_closed(conn: QUICConnection) -> bool;
    fn hew_quic_conn_last_error(conn: QUICConnection) -> string;

    // Stream methods
    fn hew_quic_stream_send(stream: QUICStream, data: bytes) -> i32;
    fn hew_quic_stream_recv(stream: QUICStream) -> bytes;
    fn hew_quic_stream_send_timeout_hew(stream: QUICStream, data: bytes, deadline_ms: i32) -> i32; // INTERNAL-ABI: 0=ok, -1=error, -2=timeout
    fn hew_quic_stream_recv_timeout_hew(stream: QUICStream, deadline_ms: i32) -> bytes;
    fn hew_quic_stream_last_recv_timed_out() -> i32; // INTERNAL-ABI: thread-local timeout sentinel; 1=timeout, 0=ok-or-error
    fn hew_quic_stream_last_recv_status() -> i32; // INTERNAL-ABI: thread-local status; 0=ok-or-EOF, -1=transport error, -2=timeout
    fn hew_quic_stream_finish(stream: QUICStream) -> i32;
    fn hew_quic_stream_stop(stream: QUICStream, error_code: i64) -> i32;
    fn hew_quic_stream_close(consume stream: QUICStream) -> i32;
    fn hew_quic_stream_bytes_sent(stream: QUICStream) -> i64;
    fn hew_quic_stream_bytes_received(stream: QUICStream) -> i64;
    fn hew_quic_stream_send_closed(stream: QUICStream) -> bool;
    fn hew_quic_stream_recv_closed(stream: QUICStream) -> bool;
    fn hew_quic_stream_last_error(stream: QUICStream) -> string;

    // Event methods
    fn hew_quic_event_kind(event: QUICEventHandle) -> i32;
    fn hew_quic_event_free(event: QUICEventHandle);

    // string conversion helpers (shared runtime builtins)
    fn hew_string_to_bytes(s: string) -> bytes;
}
