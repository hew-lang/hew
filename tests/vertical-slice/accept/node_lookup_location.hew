// Accept: Node::lookup returns discovery metadata for a
// registration, and a different name remains LookupError.NotFound.
import std.os;

actor Worker {
    receive fn ping() {}
}

fn main() -> i64 {
    let started = Node.start(NodeConfig { bind: "127.0.0.1:0", transport: NodeTransport.Tcp, key: f"{os.temp_dir()}/hew-node-lookup-location-{os.pid()}.key", peers: Vec.new(), seeds: Vec.new() });
    match started {
        .Ok(_) => {}
        .Err(_) => return 1,
    }
    let worker = spawn Worker;
    if Node.register("node-lookup-location-worker", worker) != 0 {
        return 2;
    }
    let missing: Result<Location, LookupError> = Node.lookup("node-lookup-location-missing");
    match missing {
        .Ok(_) => return 3,
        .Err(LookupError.NotFound) => {}
        .Err(_) => return 4,
    }
    let found: Result<Location, LookupError> = Node.lookup("node-lookup-location-worker");
    let status = match found {
        .Ok(location) => {
            let again = Node.lookup("node-lookup-location-worker").expect("same registration");
            assert(location == again);
            assert(location.node_id() == Node.id().expect("running node"));
            assert(location.slot() > 0);
            assert(location.incarnation() > 0);
            0
        }
        .Err(_) => 5,
    };
    Node.shutdown();
    status
}
