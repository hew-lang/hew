//! Behavioural tests for std::crypto::encrypt.

import std.crypto.encrypt;

import std.testing;

fn test_key() -> bytes {
    "0123456789abcdef0123456789abcdef".to_bytes()
}

fn tamper_last_byte(ciphertext: bytes) -> bytes {
    let last_index = ciphertext.len() - 1;
    let tampered: bytes = bytes.new();
    var i = 0;
    while i < ciphertext.len() {
        let byte = ciphertext[i];
        if i == last_index {
            if byte == 0 {
                tampered.push(1);
            } else {
                tampered.push(byte - 1);
            }
        } else {
            tampered.push(byte);
        }
        i = i + 1;
    }
    tampered
}

#[test]
fn test_try_open_roundtrip_succeeds() {
    let seal_key = test_key();
    let open_key = test_key();
    let ciphertext = encrypt.seal(seal_key, "hew survives");
    match encrypt.try_open(open_key, ciphertext) {
        .Ok(plaintext) => testing.assert_eq_str(plaintext, "hew survives"),
        .Err(err) => panic(f"try_open unexpectedly failed: {err}"),
    }
}

#[test]
fn test_try_open_tampered_ciphertext_returns_err_and_survives() {
    let seal_key = test_key();
    let open_key = test_key();
    let ciphertext = encrypt.seal(seal_key, "hew survives tamper");
    let tampered = tamper_last_byte(ciphertext);
    var survived = false;
    match encrypt.try_open(open_key, tampered) {
        .Ok(_) => panic("try_open accepted tampered ciphertext"),
        .Err(err) => {
            match err {
                CryptoError.AuthFailed => {
                    survived = true;
                },
                _ => panic(f"expected AuthFailed, got {err}"),
            }
        },
    }
    testing.assert_true(survived);
    testing.assert_eq(40 + 2, 42);
}

// ── #37: an unusable key is reported, not fatal at the FFI boundary ───
#[test]
fn test_try_seal_rejects_a_short_key() {
    match encrypt.try_seal("too-short".to_bytes(), "hew") {
        .Ok(ciphertext) => panic(f"expected a short key to be rejected, got {ciphertext.len()} bytes"),
        .Err(err) => testing.assert_eq_str(to_string(err), "encrypt key must be 32 bytes"),
    }
}

#[test]
fn test_try_seal_rejects_an_empty_key() {
    match encrypt.try_seal("".to_bytes(), "hew") {
        .Ok(ciphertext) => panic(f"expected an empty key to be rejected, got {ciphertext.len()} bytes"),
        .Err(err) => testing.assert_eq_str(to_string(err), "encrypt key must be 32 bytes"),
    }
}

#[test]
fn test_try_seal_rejects_an_oversized_key() {
    let long_key = "an oversized key of forty-eight ascii bytes!!!!!".to_bytes();
    match encrypt.try_seal(long_key, "hew") {
        .Ok(ciphertext) => panic(f"expected a 48-byte key to be rejected, got {ciphertext.len()} bytes"),
        .Err(err) => testing.assert_eq_str(to_string(err), "encrypt key must be 32 bytes"),
    }
}

#[test]
fn test_try_seal_preserves_a_valid_roundtrip() {
    match encrypt.try_seal(test_key(), "hew round trip") {
        .Ok(ciphertext) => {
            match encrypt.try_open(test_key(), ciphertext) {
                .Ok(plaintext) => testing.assert_eq_str(plaintext, "hew round trip"),
                .Err(err) => panic(f"try_open unexpectedly failed: {err}"),
            }
        },
        .Err(err) => panic(f"try_seal unexpectedly failed: {err}"),
    }
}

#[test]
fn test_try_seal_of_empty_plaintext_is_not_an_empty_ciphertext() {
    // An empty plaintext still seals to a nonce plus a GCM tag, so an empty
    // result would be a fabricated success rather than a valid empty value.
    match encrypt.try_seal(test_key(), "") {
        .Ok(ciphertext) => {
            testing.assert_eq(ciphertext.len(), 28);
            match encrypt.try_open(test_key(), ciphertext) {
                .Ok(plaintext) => testing.assert_eq_str(plaintext, ""),
                .Err(err) => panic(f"try_open of an empty plaintext failed: {err}"),
            }
        },
        .Err(err) => panic(f"try_seal of an empty plaintext failed: {err}"),
    }
}

#[test]
fn test_try_seal_status_does_not_leak_into_the_next_seal() {
    match encrypt.try_seal("short".to_bytes(), "hew") {
        .Ok(_) => panic("expected a short key to be rejected"),
        .Err(_) => {},
    }
    match encrypt.try_seal(test_key(), "hew") {
        .Ok(ciphertext) => testing.assert_gt(ciphertext.len(), 0),
        .Err(err) => panic(f"a later valid seal must not inherit the earlier failure: {err}"),
    }
}

#[test]
#[should_panic]
fn test_seal_panics_at_legacy_boundary_on_a_short_key() {
    let _ = encrypt.seal("short".to_bytes(), "hew");
}

#[test]
fn test_crypto_error_display_formats_each_variant() {
    testing.assert_eq_str(to_string(CryptoError.None), "no error");
    testing.assert_eq_str(to_string(CryptoError.InvalidKey), "encrypt key must be 32 bytes");
    testing.assert_eq_str(to_string(CryptoError.AuthFailed), "encrypt authentication failed");
}
