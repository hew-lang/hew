machine Gate {
    events {
        Open { label: string },
        Close,
    }
    emits {
        Opened { label: string },
        Closed { label: string },
    }
    state Shut,
    state Ajar { label: string },

    on Open: Shut => Ajar {
        emit Opened { label: event.label };
        .Ajar { label: event.label }
    }
    on Close: Ajar => Shut {
        emit Closed { label: self.label };
        .Shut
    }
    default { state }
}

actor Probe {
    var gate: Gate,

    receive fn open(label: string) -> string {
        let report = gate.step(.Open { label: label });
        var seen = "none";
        for output in report.outputs {
            match output {
                .Opened { label: opened } => { seen = opened; }
                .Closed { label: closed } => panic(closed),
            }
        }
        f"{seen}/{gate.state_name()}"
    }

    receive fn close() -> string {
        let report = gate.step(.Close);
        var seen = "none";
        for output in report.outputs {
            match output {
                .Closed { label: closed } => { seen = closed; }
                .Opened { label: opened } => panic(opened),
            }
        }
        f"{seen}/{gate.state_name()}"
    }
}

fn drive() {
    let probe = spawn Probe(gate: .Shut);
    println(probe.open("front".to_upper()).expect("open"));
    println(probe.close().expect("close"));
}

fn main() {
    drive();
}
