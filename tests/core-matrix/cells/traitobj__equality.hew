trait Named {
    fn name(val: Self) -> string;
}

type P {
    n: string;
}

impl Named for P {
    fn name(val: P) -> string {
        val.n
    }
}

type Q {
    n: string;
}

impl Named for Q {
    fn name(val: Q) -> string {
        val.n
    }
}

fn show_named(v: dyn Named) {
    let s = v.name();
    println(s);
}

fn main() {
    let a: dyn Named = P { n: "p0" };
    let b: dyn Named = P { n: "p0" };
    let c: dyn Named = P { n: "p1" };
    let same = a == b;
    let diff = a == c;
    println(f"{same} {diff}");
}
