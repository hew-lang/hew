fn main() {
    let x: HashMap<string, i64> = HashMap.new();
    x.insert("a", 1);
    x.insert("b", 2);
    let v: Vec<HashMap<string, i64>> = Vec.new();
    v.push(x);
    match v.get(0) {
        Option.Some(e) => {
            let e_l = e.len();
            let e_a = match e.get("a") { Option.Some(e_g) => e_g, Option.None => -1, };
            println(f"len={e_l} a={e_a}");
        },
        Option.None => println("missing"),
    }
}
