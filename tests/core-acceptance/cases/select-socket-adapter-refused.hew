// A line adapter drives its checked producer without consuming a partial
// line. A losing selection retains its buffer for the next observation.
import std.net;

import std.stream;

actor Watcher {
    var src: Stream<string>;
    receive fn partial() -> i64 {
        select {
            v from src.recv() => match v {
                .Some(value) => value.len(),
                .None => 0,
            }
            after 20ms => -1,
        }
    }
    receive fn complete() -> i64 {
        select {
            v from src.recv() => match v {
                .Some(value) => {
                    assert(value == "partial line");
                    value.len()
                }
                .None => 0,
            }
            after 10s => -1,
        }
    }
}

actor Sibling {
    receive fn ping(n: i64) -> i64 {
        n + 1
    }
}

fn main() {
    let listener = net.listen("127.0.0.1:0").expect("listen");
    let port = listener.local_port();
    let client = net.connect(f"127.0.0.1:{port}").expect("connect");
    let server = listener.accept().expect("accept");
    let (input, output) = server.split();
    let sibling = spawn Sibling;
    let watcher = spawn Watcher { src: input.lines() };
    client.send(b"partial ").expect("partial send");
    assert(watcher.partial().expect("partial observation") == -1);
    println("partial line stayed pending");
    client.send(b"line\r\n").expect("complete send");
    println(watcher.complete().expect("complete observation"));
    match sibling.ping(41) {
        .Ok(value) => println(f"sibling {value}"),
        .Err(_) => println("sibling crashed"),
    }
    output.close();
    stop(watcher);
    stopped(watcher);
    stop(sibling);
    stopped(sibling);
    client.close();
    listener.close();
}
