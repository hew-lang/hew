#[resource]
type Tok {
    id: i64
}

impl Tok {
    fn close(self) {
        println(f"close {self.id}");
    }
}

fn main() {
    let k = Tok { id: 1 };
    let m: HashMap<Tok, i64> = HashMap::new();
    m.insert(k, 9);
    match m.get(k) {
        Some(v) => println(f"got {v}"),
        None => println("missing"),
    }
}
