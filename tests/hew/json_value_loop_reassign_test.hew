//! JSON values can be copied, mutated and reassigned on every loop iteration.

import std.encoding.json;

fn rendered_count() -> string {
    var values = json.array();
    for n in 0 .. 3 {
        var next = values;
        next.push(json.from_int(n)).expect("push succeeds");
        // Mutating the copy must preserve the array being replaced.
        assert(values.array_len().expect("array_len succeeds") == n);
        values = next;
    }
    values.stringify().expect("stringify succeeds")
}

fn rendered_without_reassignment() -> string {
    let values = json.array();
    values.stringify().expect("stringify succeeds")
}

#[test]
fn reassigns_json_value_copy_in_loop() {
    assert(rendered_count() == "[0,1,2]");
}

#[test]
fn nonreassigned_json_value_preserves_payload() {
    assert(rendered_without_reassignment() == "[]");
}
