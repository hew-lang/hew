//! Request and response header vectors own their strings after handle release.

import std.net.http.server as http;
import std.net.http.client;

actor Client {
    let url: string;

    receive fn fetch() {
        let response = client.request("GET", url, "", [("X-Owned", "request value"), ("X-Empty", "")]).expect("request");
        assert(response.status() == 200);
        assert(response.body().expect("body") == "reply");
        assert(response.content_type().expect("content type") == .Some("text/plain; charset=utf-8"));
        assert(response.header("CONTENT-TYPE").expect("header") == .Some("text/plain; charset=utf-8"));
        let headers = response.headers();
        response.close();
        assert(!headers.is_empty());
        assert(headers.iter().any(|header| header.0 == "content-type" && header.1 == "text/plain; charset=utf-8"));
        // The vector leaves scope without consuming its elements in a loop.
    }
}

#[test]
#[real_time]
fn test_owned_headers_survive_request_and_response_handles() {
    let server = http.listen("127.0.0.1:0").expect("listen");
    let client = spawn Client { url: f"http://127.0.0.1:{server.port()}/headers" };
    let fetching = fork client.fetch();
    let request = server.accept().expect("accept");
    assert(request.header("x-empty").expect("empty header") == .Some(""));
    assert(request.header("x-absent").expect("absent header") == .None);
    let headers = request.headers();
    request.respond_text(200, "reply").expect("respond");
    assert(headers.iter().any(|header| header.0.to_lower() == "x-owned" && header.1 == "request value"));
    assert((await fetching).is_ok());
    stop(client);
    stopped(client);
}
