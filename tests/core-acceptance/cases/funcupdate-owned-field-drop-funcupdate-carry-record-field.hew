import std.string;

type Inner {
    label: string;
    n: i64;
}

type Pair {
    keep: Inner;
    churn: string;
}

fn main() -> i64 {
    var p = Pair { keep: Inner { label: ("k").repeat(32), n: 1 }, churn: ("a").repeat(32) };
    var i: i64 = 0;
    while i < 50 {
        p = Pair { ..p, churn: ("b").repeat(32) };
        i = i + 1;
    }
    p.keep.n
}
