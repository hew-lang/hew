// Sequential actor completion calls, including calls inside a loop.
// Each call returns its own Result before the next call begins.

actor Worker {
    let factor: i64,
    receive fn compute(n: i64) -> i64 {
        n * factor
    }
}

actor Coordinator {
    let worker: LocalPid<Worker>,
    let rounds: i64,

    // Two sequential calls: 7*6 + 7*6 = 84.
    receive fn two(n: i64) -> i64 {
        let a = worker.compute(n);
        let b = worker.compute(n);
        match a {
            .Ok(va) => match b {
                .Ok(vb) => va + vb,
                .Err(_) => -1,
            },
            .Err(_) => -1,
        }
    }

    // Three sequential calls: 42 * 3 = 126.
    receive fn three(n: i64) -> i64 {
        let a = worker.compute(n);
        let b = worker.compute(n);
        let c = worker.compute(n);
        match a {
            .Ok(va) => match b {
                .Ok(vb) => match c {
                    .Ok(vc) => va + vb + vc,
                    .Err(_) => -1,
                },
                .Err(_) => -1,
            },
            .Err(_) => -1,
        }
    }

    // A call inside a loop: `rounds` (4) calls accumulate 42 each -> 168.
    receive fn loop_sum(n: i64) -> i64 {
        var total: i64 = 0;
        for i in 0 .. rounds {
            let r = worker.compute(n);
            match r {
                .Ok(v) => {
                    total = total + v;
                },
                .Err(_) => {
                    total = total - 1;
                },
            }
        }
        total
    }
}

fn main() {
    let w = spawn Worker(factor: 6);
    let c = spawn Coordinator(worker: w, rounds: 4);
    let r2 = c.two(7);
    match r2 {
        .Ok(v) => println(f"two={v}"),
        .Err(_) => println("two failed"),
    }
    let r3 = c.three(7);
    match r3 {
        .Ok(v) => println(f"three={v}"),
        .Err(_) => println("three failed"),
    }
    let rl = c.loop_sum(7);
    match rl {
        .Ok(v) => println(f"loop={v}"),
        .Err(_) => println("loop failed"),
    }
}
