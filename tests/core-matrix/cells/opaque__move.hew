#[opaque]
type DqH {
}

#[resource]
type Dq {
    handle: DqH;
    tag: i64;
}

impl Dq {
    fn close(self) {
        unsafe {
            hew_deque_free(self.handle)
        };
        println(f"close {self.tag}");
    }
}

extern "C" {
    fn hew_deque_new() -> DqH;
    fn hew_deque_free(dq: DqH);
    fn hew_deque_len(dq: DqH) -> i64;
}

fn main() {
    let x = Dq { handle: unsafe {
        hew_deque_new()
    }, tag: 1 };
    let y = x;
    let y_l = unsafe {
        hew_deque_len(y.handle)
    };
    let y_t = y.tag;
    println(f"dq {y_t} len={y_l}");
}
