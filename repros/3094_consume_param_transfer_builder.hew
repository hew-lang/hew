// Reproduction for #3094: a user-defined `#[resource]`
// wrapper whose fluent builder consumes a child and returns its consuming
// receiver, matching the shipped encoding value-tree contract. `free()` is a
// consuming compatibility alias of the compiler-visible `close()` disposer, and
// the resource is also returned through a `Result` payload so aggregate
// ownership is exercised.
//
// The native handle is a real json value tree, so the transfer sink
// (`hew_json_array_push`) and the disposer (`hew_json_free`) are the runtime's
// own ownership-taking entry points: the fixture links and runs, and a
// double-free or leak of a transferred child is a live abort, not a
// type-check-only claim.
//
// Expected after #3094 is fixed: clean check, clean run, exit 0. The corpus
// ratchet keeps this source failing until it can return to the accept suite.
#[opaque]
type Handle {
}

#[resource]
type Value {
    handle: Handle;
}

trait ValueMethods {
    fn free(consuming self);

    #[returns_receiver]
    fn push(consuming self, consume child: Value) -> Self;
}

pub enum BuildError {
    Failed(string);
}

impl ValueMethods for Value {
    fn free(consuming self) {
        self.close();
    }
    #[returns_receiver]
    fn push(consuming self, consume child: Value) -> Value {
        unsafe {
            hew_json_array_push(self.handle, child.release())
        };
        self
    }
}

impl Value {
    fn close(consuming self) {
        unsafe {
            hew_json_free(self.handle)
        };
    }
    fn release(consuming self) -> Handle {
        self.handle
    }
}

extern "C" {
    fn hew_json_free(consume handle: Handle);
    fn hew_json_array_push(handle: Handle, consume child: Handle);
    fn hew_json_array_new() -> Handle;
    fn hew_json_type(handle: Handle) -> i32;
}

fn try_build() -> Result<Value, BuildError> {
    let value = Value { handle: unsafe {
        hew_json_array_new()
    } };
    if unsafe {
        hew_json_type(value.handle)
    } >= 0 {
        let child = Value { handle: unsafe {
            hew_json_array_new()
        } };
        Ok(value.push(child))
    } else {
        value.close();
        Err(BuildError.Failed("bad handle"))
    }
}

fn close_canonical() {
    match try_build() {
        .Ok(value) => {
            value.close();
        },
        .Err(BuildError.Failed(_)) => {},
    }
}

fn close_compatibility_alias() {
    match try_build() {
        .Ok(value) => {
            value.free();
        },
        .Err(BuildError.Failed(_)) => {},
    }
}

fn main() {
    close_canonical();
    close_compatibility_alias();
}
