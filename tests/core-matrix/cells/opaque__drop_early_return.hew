#[opaque]
type DqH {
}

#[resource]
type Dq {
    handle: DqH,
    tag: i64,
}

impl Dq {
    fn close(self) {
        unsafe { hew_deque_free(self.handle) };
        println(f"close {self.tag}");
    }
}

extern "C" {
    fn hew_deque_new() -> DqH;
    fn hew_deque_free(dq: DqH);
    fn hew_deque_len(dq: DqH) -> i64;
}

fn run(early: bool) -> i64 {
    let h = Dq { handle: unsafe { hew_deque_new() }, tag: 1 };
    if early {
        println("early");
        return 1;
    }
    println("late");
    2
}

fn main() {
    let n = run(true);
    println(f"n={n}");
}
