//! Behavioural tests for std::time::datetime.

import std.time.datetime;

fn assert_parse_ok(actual: Result<timestamp, datetime.DateTimeError>) -> timestamp {
    match actual {
        .Ok(value) => value,
        .Err(message) => {
            panic(f"{message}");
            timestamp.from_unix_secs(0)
        }
    }
}

#[test]
fn test_try_parse_full_timestamp_formats_back_to_date() {
    let parsed = assert_parse_ok(datetime.parse("2025-07-10T00:00:00Z", "%Y-%m-%dT%H:%M:%SZ"));
    match datetime.format(parsed, "%Y-%m-%d") {
        .Ok(formatted) => assert(formatted == "2025-07-10"),
        .Err(message) => panic(f"{message}"),
    }
}

#[test]
fn test_try_parse_invalid_timestamp_returns_err() {
    match datetime.parse("not-a-date", "%Y-%m-%dT%H:%M:%SZ") {
        .Ok(value) => {
            panic(f"expected invalid parse to fail, got {value}");
            assert(value == timestamp.from_unix_secs(0));
        }
        .Err(.Parse(message)) => assert(!message.is_empty()),
        .Err(other) => panic(f"expected a parse failure, got {other}"),
    }
}

#[test]
fn test_try_format_rejects_invalid_directive_with_error() {
    match datetime.format(timestamp.from_unix_secs(0), "%Q") {
        .Ok(_) => assert(false),
        .Err(error) => assert(error == datetime.DateTimeError.Format("invalid datetime format directive")),
    }
}

#[test]
fn test_year_rejects_out_of_range_epoch() {
    match datetime.year(timestamp.from_unix_secs(9223372036854775807)) {
        .Err(.Range(_)) => {}
        _ => panic("expected checked calendar range error"),
    }
}

#[test]
fn test_add_days_and_add_hours_shift_fixed_timestamp() {
    let base = assert_parse_ok(datetime.parse("2025-07-10T00:00:00Z", "%Y-%m-%dT%H:%M:%SZ"));
    let plus_two_days = datetime.add_days(base, 2);
    let plus_six_hours = datetime.add_hours(base, 6);
    assert(datetime.to_iso8601(plus_two_days).expect("calendar") == "2025-07-12T00:00:00Z");
    assert(datetime.to_iso8601(plus_six_hours).expect("calendar") == "2025-07-10T06:00:00Z");
}

#[test]
fn test_diff_secs_matches_fixed_interval() {
    let start = assert_parse_ok(datetime.parse("2025-07-10T00:00:00Z", "%Y-%m-%dT%H:%M:%SZ"));
    let end = assert_parse_ok(datetime.parse("2025-07-10T03:30:00Z", "%Y-%m-%dT%H:%M:%SZ"));
    assert(datetime.diff_secs(end, start) == 12600);
}

#[test]
fn test_now_surfaces_positive_time_values() {
    assert(timestamp.now() > timestamp.from_unix_secs(0));
}
