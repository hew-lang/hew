import std.crypto.password;

import std.net.http.http_async_client;

import std.net.http.http_async_server;

import std.stream;

#[test]
fn test_negative_pipe_capacity_is_rejected() {
    let opened: Result<(stream.Sink<string>, stream.Stream<string>), string> = stream.pipe(-1);
    match opened {
        .Ok(_) => panic("expected negative pipe capacity to fail"),
        .Err(err) => assert(err == "stream.pipe: invalid capacity -1 (must be >= 0)"),
    }
}

#[test]
fn test_password_cost_overflow_is_rejected() {
    match password.hash_custom("secret", 4294967299) {
        .Ok(_) => panic("expected oversized password cost to fail"),
        .Err(err) => assert(err == "password.hash_custom: invalid cost 4294967299 (must be 1..=2147483647)"),
    }
}

#[test]
fn test_malformed_password_hash_is_not_a_mismatch() {
    match password.verify("secret", "not-a-phc-hash") {
        .Ok(_) => panic("expected malformed password hash to fail"),
        .Err(err) => assert(err == "password.verify: malformed password hash"),
    }
}

#[test]
fn test_async_http_query_and_ipv6_authority_split() {
    let (query_addr, query_path) = http_async_client.split_address("http://example.com?x=1");
    assert(query_addr == "example.com:80");
    assert(query_path == "/?x=1");
    let (ipv6_addr, ipv6_path) = http_async_client.split_address("http://[::1]:8080/status");
    assert(ipv6_addr == "[::1]:8080");
    assert(ipv6_path == "/status");
    assert(http_async_client.host_of("http://[::1]:8080/status") == "[::1]");
}

#[test]
fn test_async_http_invalid_status_is_rejected() {
    assert(http_async_server.response_text(-1, "body") == "");
    assert(http_async_server.response_text(600, "body") == "");
}
