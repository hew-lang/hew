fn duration::fmt -> string
  statements:
    use BindingId(57) val site=SiteId(264) ty=duration intent=Read
    bind BindingId(4294967231) __hew_produced_value site=SiteId(262) ty=string
    bind BindingId(4294967230) __hew_produced_value site=SiteId(261) ty=string
    use BindingId(4294967230) __hew_produced_value site=SiteId(261) ty=string intent=Consume
    return site=Some(SiteId(261)) ty=string
    drop BindingId(4294967230) __hew_produced_value ty=string
    drop BindingId(4294967231) __hew_produced_value ty=string
  decisions:
    site=s0 ty=duration value_class=BitCopy intent=Unknown strategy=ParamBoundary(ParamBoundaryFact { param_index: 0, param_count: 1, caller_visible_projection: false, mode: BorrowReadOnly }) why="checker-authoritative parameter boundary classification"
    site=s261 ty=string value_class=CowValue intent=Read strategy=CowShare why="first vertical-slice classifier"
    site=s262 ty=string value_class=CowValue intent=Read strategy=CowShare why="first vertical-slice classifier"
    site=s263 ty=i64 value_class=BitCopy intent=Read strategy=BorrowRead why="first vertical-slice classifier"
    site=s264 ty=duration value_class=BitCopy intent=Read strategy=BorrowRead why="first vertical-slice classifier"
    site=s267 ty=string value_class=CowValue intent=Read strategy=CowShare why="first vertical-slice classifier"
  blocks:
