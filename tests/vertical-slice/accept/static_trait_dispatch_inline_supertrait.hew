trait Super {
    fn name(val: Self) -> string;
}

trait Sub: Super {
}

type Widget {
    label: string,
}

impl Super for Widget {
    fn name(w: Widget) -> string {
        "inline"
    }
}

impl Sub for Widget {
}

fn get_name<T: Sub>(item: T) -> string {
    item.name()
}

fn main() -> i64 {
    println(get_name(Widget { label: "direct" }));
    0
}
