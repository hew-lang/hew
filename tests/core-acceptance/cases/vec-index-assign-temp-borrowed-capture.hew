type Holder { items: Vec<string> }
fn mkItems() -> Vec<string> {
    var xs: Vec<string> = Vec.new();
    xs.push("deep-elem-a");
    xs.push("deep-elem-b");
    return xs;
}
fn main() {
    let h = Holder { items: mkItems() };
    let assign = || {
        var v: Vec<Holder> = Vec.new();
        v.push(Holder { items: mkItems() });
        v[0] = h;
        v[0].items.len() + h.items.len()
    };
    print(assign());
    print(assign());
    print("OK");
}
