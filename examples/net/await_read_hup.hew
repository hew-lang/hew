//! TCP connection-failure and end-of-stream example using `conn.read()`.
//! A failed connection follows the error arm; a connected peer that closes
//! can produce an empty read. These are distinct outcomes.

import std.net;

actor Reader {
    receive fn go(unused: i64) {

        // Nothing listens here: the connect fails or the read errors. Either
        // failure follows its own path; EOF after connection is an empty read.
        let conn = match net.connect("127.0.0.1:9") {
            .Ok(conn) => conn,
            .Err(_) => panic(f"network setup failed"),
        };
        let body = conn.read();
        println(f"read {body.len()} bytes");
        let _ = conn.close();
    }
}

fn main() {
    let r = spawn Reader;
    let _ = r.go(0);
    sleep(300ms);
    println("done");
}
