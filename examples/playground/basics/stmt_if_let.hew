//! @name Announce a platform
//! @description Announce the confirmed platform or ask passengers to check the board.

fn announce(destination: string, platform: Option<i64>) {
    if let .Some(number) = platform {
        println(f"{destination} departs from platform {number}.");
    } else {
        println(f"Check the board for {destination}.");
    }
}

fn main() {
    announce("Jasper", .Some(2));
    announce("Churchill", .None);
}
