// Negative oracle: two opt-ins of the same bare name from divergent-layout
// modules collide at import publication and must fail closed atomically.
//
// Both `widgetpub8` and `widgetpub64` publish `Gadget` bare (each via
// `::{ Gadget }`). The second import must emit an import-binding collision and
// publish none of its candidates rather than silently first-winning a layout.
//
// Harness verb: hew check (negative — see run.sh).
import hew.widgetpub8.{ Gadget };
import hew.widgetpub64.{ Gadget };

fn main() {
    let a = Gadget { v: 7 };
    println(f"a={a.v}");
}
