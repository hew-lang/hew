// Imported functions preserve the identity of returned public actor handles
// and lower the private actors used to build them.
import pipeline_support.actors;

fn main() {
    let source: actors.Source = actors.run();
    source.push(3, "alpha").expect("first");
    source.push(7, "beta").expect("second");
    let (count, sum, label) = source.result().expect("result");
    println(count);
    println(sum);
    println(label);
    source.finish().expect("finish");
    stop(source);
    stopped(source);
}
