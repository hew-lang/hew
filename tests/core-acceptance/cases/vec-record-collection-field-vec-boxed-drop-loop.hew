type Boxed {
    payload: [i64],
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        let xs = [Boxed { payload: [10, 20] }, Boxed { payload: [30] }];
        let a = xs[0];
        total = total + a.payload[0] + xs.len();
        i = i + 1;
    }
    total
}
