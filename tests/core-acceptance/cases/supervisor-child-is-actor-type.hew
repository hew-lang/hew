// A supervisor child accessor yields the child's actor type: the pool member
// and the static role are called through the child's own receive handlers and
// return the child's own reply types. A supervisor is addressed by its own name
// the way an actor is, and a plain spawned actor of the same declaration still
// travels through a function by that type.
actor Worker {
    let id: i64,
    var seen: i64 = 0,
    receive fn work(n: i64) -> i64 {
        seen = seen + 1;
        n * id
    }
    receive fn seen_count() -> i64 { seen }
}

supervisor Pool {
    strategy: simple_one_for_one,
    pool workers: Worker(id: 3) count: 2,
}

supervisor Desk {
    child primary: Worker(id: 7),
}

fn ask(worker: Worker, n: i64) -> i64 {
    match worker.work(n) {
        .Ok(v) => v,
        .Err(_) => panic("worker refused its call"),
    }
}

fn main() {
    let pool: Pool = spawn Pool();
    let desk: Desk = spawn Desk();

    // A pool member is the child's actor type: its handlers and their reply
    // types are the child's own.
    match pool.workers[0].work(4) {
        .Ok(v) => println(v),
        .Err(_) => panic("pool member refused its call"),
    }
    match pool.workers[1].seen_count() {
        .Ok(v) => println(v),
        .Err(_) => panic("pool member lost its state"),
    }

    // A static role is the same.
    match desk.primary.work(6) {
        .Ok(v) => println(v),
        .Err(_) => panic("static role refused its call"),
    }
    match desk.primary.seen_count() {
        .Ok(v) => println(v),
        .Err(_) => panic("static role lost its state"),
    }

    // An ordinary spawned actor of the same declaration travels by its type.
    let free = spawn Worker(id: 11);
    println(ask(free, 2));

    close(free);
    close(desk);
    close(pool);
}
