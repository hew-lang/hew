// J: two string vars reassigned in a loop that also has a continue edge.
import std.string;

type Row {
    path: string;
    branch: string;
}

pub fn rows(listing: string) -> Vec<Row> {
    var out: Vec<Row> = Vec.new();
    let worktree_prefix = "worktree ";
    let branch_prefix = "branch refs/heads/";
    var path = "";
    var branch = "";
    for line in (listing).split("\n") {
        if (line.clone()).starts_with(worktree_prefix.clone()) {
            if path != "" {
                out.push(Row { path: path.clone(), branch: branch.clone() });
            }
            path = line[worktree_prefix.len()..];
            branch = "";
            continue;
        }
        if (line.clone()).starts_with(branch_prefix.clone()) {
            branch = line[branch_prefix.len()..];
        }
    }
    if path != "" {
        out.push(Row { path: path, branch: branch });
    }
    out
}

pub fn main() {
    println(rows("worktree /a\nbranch refs/heads/main\n").len());
}
