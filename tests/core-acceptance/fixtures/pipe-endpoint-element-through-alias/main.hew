//! An aliased module import keeps the pipe endpoint's element: a
//! `Sink<string>` handed to a `Sink<i64>` parameter is refused at the
//! checker, with both elements in the diagnostic.

import std.stream as pipes;

fn wants_i64(tx: pipes.Sink<i64>) {
    tx.close();
}

fn main() {
    let opened = pipes.pipe<string>(4);
    match opened {
        .Ok(parts) => {
            let (tx, rx) = parts;
            wants_i64(tx);
            rx.close();
        }
        .Err(reason) => println(reason),
    }
}
