type Name { label: string, }

fn run_cycle() -> i64 {
    var m: HashMap<string, Name> = HashMap.new();
    m.insert("k", Name { label: "owned-ok".to_upper() });
    let got: Name = m["k"];
    let removed = m.remove("k");
    match removed {
        .Some(_) => got.label.len(),
        .None => 0,
    }
}

fn run_loop(frames: i64) -> i64 {
    var total: i64 = 0;
    for i in 0..frames { total = total + run_cycle(); }
    total
}

fn main() -> i64 { run_loop(50) }
