//! Cross-module machine identity and ownership regression coverage.
//!
//! The private lifecycle is intentionally exposed only through a public
//! factory, matching an opaque imported nominal. The public payload lifecycle
//! exercises direct construction, matching, transition, calls, returns, and a
//! record field while its heap string makes the clone/drop path observable.

import tests::hew::imported_machine_support::machine_defs;

import std::testing;

type Envelope {
    value: machine_defs.PayloadLifecycle;
    marker: i64;
}

fn carry_hidden(value: machine_defs.RunLifecycle) -> machine_defs.RunLifecycle {
    value
}

fn carry_payload(
    value: machine_defs.PayloadLifecycle,
) -> machine_defs.PayloadLifecycle {
    value
}

fn payload_label(value: machine_defs.PayloadLifecycle) -> string {
    match value {
        machine_defs.PayloadLifecycle::Loaded { label } => label,
        machine_defs.PayloadLifecycle::Empty => "empty",
    }
}

#[test]
fn imported_private_machine_crosses_an_owned_call_boundary() {
    let value = machine_defs.initial();
    let carried = carry_hidden(value);
    let tag = match carried {
        machine_defs.RunLifecycle::Running => 1,
        _ => 0,
    };
    testing.assert_eq(tag, 1);
}

#[test]
fn imported_payload_machine_covers_construction_calls_returns_and_record_storage() {
    let direct = machine_defs.make("caller-to-callee".to_upper());
    let returned = machine_defs.bounce(direct);
    let envelope = Envelope { value: returned, marker: 17 };
    testing.assert_eq(envelope.marker, 17);
    testing.assert_eq_str(payload_label(envelope.value), "CALLER-TO-CALLEE");

    let made = machine_defs.make("callee-to-caller".to_upper());
    let carried = carry_payload(made);
    testing.assert_eq_str(payload_label(carried), "CALLEE-TO-CALLER");
}

#[test]
fn imported_machine_transitions_and_supports_dotted_unit_construction() {
    var value = machine_defs.PayloadLifecycle.Empty;
    value.step(machine_defs.PayloadLifecycleEvent::Load);
    testing.assert_eq_str(payload_label(value), "TRANSITIONED");
}
