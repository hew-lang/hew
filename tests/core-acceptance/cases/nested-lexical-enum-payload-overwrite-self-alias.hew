enum Box {
    Full(string),
    Empty,
}

fn self_alias(i: i64) -> i64 {
    var opt = Box.Full(f"self-{i}");
    opt = opt;
    match opt {
        .Full(s) => s.len(),
        .Empty => 0,
    }
}

fn main() -> i64 {
    var total = 0;
    for i in 0..50 {
        total = total + self_alias(i);
        println("frame");
    }
    if total > 0 { 0 } else { 91 }
}
