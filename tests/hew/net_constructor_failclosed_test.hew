//! Negative controls for the fallible resource constructors.
//!
//! `http.listen`, `websocket.listen`, `websocket.connect` and `Url.resolve`
//! each used to hand back a handle whose backing pointer was null on failure,
//! which is indistinguishable from a live resource until the first use. Each
//! test here proves the failure is now reported at construction and that the
//! success path is unchanged.
//!
//! Every address is loopback and every port is ephemeral: a port is claimed by
//! binding `127.0.0.1:0`, read back, and either held (to force a conflict) or
//! released (to force a refusal). No fixed port is held and nothing sleeps.

import std.net.http.server as http;

import std.net.url;

import std.net.websocket;

/// Claim an ephemeral loopback port and release it.
///
/// Nothing listens on the returned port, so a connect to it is refused
/// immediately rather than waiting on a timeout.
fn closed_loopback_port() -> i64 {
    match websocket.listen("127.0.0.1:0") {
        .Ok(server) => {
            let port = server.port();
            server.close();
            port
        }
        .Err(_err) => {
            panic("could not claim an ephemeral loopback port");
            0
        }
    }
}

#[test]
#[real_time]
fn test_http_listen_on_an_ephemeral_port_succeeds() {
    match http.listen("127.0.0.1:0") {
        .Ok(server) => {
            server.close();
            assert(true);
        }
        .Err(_err) => {
            panic("expected an ephemeral loopback bind to succeed");
        }
    }
}

/// A bind failure used to return a null-backed `Server` that looked live.
#[test]
#[real_time]
fn test_http_listen_reports_a_bind_failure_instead_of_a_null_backed_server() {
    match websocket.listen("127.0.0.1:0") {
        .Ok(held) => {
            let port = held.port();
            let addr = f"127.0.0.1:{port}";
            match http.listen(addr) {
                .Ok(server) => {
                    server.close();
                    held.close();
                    panic("expected a bind to an occupied port to fail");
                }
                .Err(err) => {
                    held.close();
                    let reason = to_string(err);
                    assert(reason.contains("AddressInUse"));
                }
            }
        }
        .Err(_err) => {
            panic("could not claim an ephemeral loopback port");
        }
    }
}

#[test]
#[real_time]
fn test_http_listen_reports_an_unparsable_address_as_a_failure() {
    match http.listen("not an address") {
        .Ok(server) => {
            server.close();
            panic("expected an unparsable address to be rejected");
        }
        .Err(err) => {
            match err {
                NetError.InvalidArgument(detail) => {
                    assert(detail == "http.listen: cannot bind `not an address`: invalid socket address");
                }
                _ => panic(f"expected InvalidArgument, got {err}"),
            }
        }
    }
}

/// A failed construction must not poison a later valid listener.
#[test]
#[real_time]
fn test_http_listen_succeeds_after_a_bind_failure() {
    match websocket.listen("127.0.0.1:0") {
        .Ok(held) => {
            let port = held.port();
            let addr = f"127.0.0.1:{port}";
            match http.listen(addr) {
                .Ok(server) => {
                    server.close();
                    held.close();
                    panic("expected a bind to an occupied port to fail");
                }
                .Err(_err) => {
                    held.close();
                }
            }
        }
        .Err(_err) => {
            panic("could not claim an ephemeral loopback port");
        }
    }
    match http.listen("127.0.0.1:0") {
        .Ok(server) => {
            assert(server.port() > 0);
            server.close();
        }
        .Err(_err) => {
            panic("expected an ephemeral loopback bind to succeed");
        }
    }
}

#[test]
#[real_time]
fn test_websocket_listen_on_an_ephemeral_port_succeeds() {
    match websocket.listen("127.0.0.1:0") {
        .Ok(server) => {
            let port = server.port();
            server.close();
            assert(port > 0);
        }
        .Err(_err) => {
            panic("expected an ephemeral loopback bind to succeed");
        }
    }
}

#[test]
#[real_time]
fn test_websocket_listen_reports_a_bind_failure_instead_of_a_null_backed_server() {
    match websocket.listen("127.0.0.1:0") {
        .Ok(held) => {
            let port = held.port();
            let addr = f"127.0.0.1:{port}";
            match websocket.listen(addr) {
                .Ok(server) => {
                    server.close();
                    held.close();
                    panic("expected a bind to an occupied port to fail");
                }
                .Err(err) => {
                    held.close();
                    let reason = to_string(err);
                    assert(reason.contains("AddressInUse"));
                }
            }
        }
        .Err(_err) => {
            panic("could not claim an ephemeral loopback port");
        }
    }
}

#[test]
#[real_time]
fn test_websocket_listen_reports_an_unparsable_address_as_invalid_argument() {
    match websocket.listen("not an address") {
        .Ok(server) => {
            server.close();
            panic("expected an unparsable address to be rejected");
        }
        .Err(err) => {
            match err {
                NetError.InvalidArgument(detail) => {
                    assert(detail == "websocket.listen: cannot bind `not an address`");
                }
                _ => panic(f"expected InvalidArgument, got {err}"),
            }
        }
    }
}

/// A refused connection used to be reported by a null handle plus a message on
/// stderr, so the caller saw a `Conn` it could not tell from a live one.
#[test]
#[real_time]
fn test_websocket_connect_reports_a_refused_connection_as_a_failure() {
    let port = closed_loopback_port();
    let target = f"ws://127.0.0.1:{port}/";
    match websocket.connect(target, websocket.options()) {
        .Ok(conn) => {
            conn.close();
            panic("expected a connect to a closed port to fail");
        }
        .Err(err) => {
            match err {
                NetError.ConnectionRefused(errno) => {
                    assert(errno != 0);
                }
                _ => panic(f"expected ConnectionRefused, got {err}"),
            }
        }
    }
}

#[test]
#[real_time]
fn test_websocket_connect_reports_an_unparsable_url_as_a_failure() {
    match websocket.connect("not a url", websocket.options()) {
        .Ok(conn) => {
            conn.close();
            panic("expected an unparsable url to be rejected");
        }
        .Err(err) => {
            match err {
                NetError.InvalidArgument(detail) => {
                    assert(detail == "websocket.connect: HTTP format error: invalid uri character");
                }
                _ => panic(f"expected InvalidArgument, got {err}"),
            }
        }
    }
}

#[test]
#[real_time]
fn test_websocket_listen_succeeds_after_a_connection_failure() {
    let port = closed_loopback_port();
    let target = f"ws://127.0.0.1:{port}/";
    match websocket.connect(target, websocket.options()) {
        .Ok(conn) => {
            conn.close();
            panic("expected a connect to a closed port to fail");
        }
        .Err(_err) => {}
    }
    match websocket.listen("127.0.0.1:0") {
        .Ok(server) => {
            assert(server.port() > 0);
            server.close();
        }
        .Err(_err) => {
            panic("expected an ephemeral loopback bind to succeed");
        }
    }
}

#[test]
fn test_url_resolve_returns_the_joined_url() {
    let base = url.parse("https://example.com/a/b").expect("valid URL");
    match base.resolve("../c") {
        .Ok(joined) => {
            assert(joined.to_string() == "https://example.com/c");
            joined.close();
        }
        .Err(_msg) => {
            panic("expected a relative path to resolve");
        }
    }
}

/// A failed join produced a null handle wrapped in a `Url`, which read as an
/// empty string rather than as a failure.
#[test]
fn test_url_resolve_reports_an_unresolvable_path_as_a_failure() {
    let base = url.parse("https://example.com/a/b").expect("valid URL");
    match base.resolve("http://[") {
        .Ok(joined) => {
            joined.close();
            panic("expected an unresolvable path to be rejected");
        }
        .Err(msg) => {
            assert(f"{msg}".contains("cannot resolve"));
        }
    }
}
