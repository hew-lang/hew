import std.string;

fn main() -> i64 {
    let n: i64 = -4200;
    let n_text = string.from_int(n);
    println(n_text);
    match string.to_int(n_text) {
        .Ok(back) => println(back == n),
        .Err(_) => println(false),
    }

    let f: f64 = 3.5;
    let f_text = f"{f}";
    println(f_text);
    match string.to_float(f_text) {
        .Ok(back) => println(back == f),
        .Err(_) => println(false),
    }

    let b: u8 = 250;
    println(f"{b}");

    match string.to_int("not-a-number") {
        .Ok(_) => println("unexpected ok"),
        .Err(message) => println(message),
    }
    match string.to_float("not-a-number") {
        .Ok(_) => println("unexpected ok"),
        .Err(message) => println(message),
    }
    0
}
