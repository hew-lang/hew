// Positive control: ownership markers remain valid on nominal `type`
// declarations and retain their established resource/linear behaviour.
#[resource]
type ResourceToken { id: i64 }
impl ResourceToken {
    fn close(consume self) {}
}

#[linear]
type LinearTicket { id: i64 }
impl LinearTicket {
    fn redeem(consume self) {}
}

fn main() {
    let resource = ResourceToken { id: 1 };
    resource.close();
    let ticket = LinearTicket { id: 2 };
    ticket.redeem();
}
