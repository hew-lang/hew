//! Negative controls for the networking scalar and endpoint boundaries.
//!
//! Every native networking entry point narrows an `i64` argument to the `i32`
//! its C ABI declares. These tests reject the values that narrowing turned
//! into a different, plausible request: `2^32 + 500` as a 500 ms deadline,
//! `2^32 + 80` as port 80, and an address whose port never parsed at all as
//! `127.0.0.1:0`.

import std.net;

import std.net.http.client;

fn wrapped_to_500() -> i64 {
    4294967796 // 2^32 + 500: narrows to 500 as i32
}

fn wrapped_to_80() -> i64 {
    4294967376 // 2^32 + 80: narrows to 80 as i32
}

fn expect_invalid(label: string, result: Result<i64, net.NetError>) -> string {
    match result {
        .Ok(value) => {
            panic(f"{label}: expected rejection, got {value}");
            ""
        }
        .Err(err) => to_string(err),
    }
}

#[test]
fn test_duration_above_abi_range_is_rejected_not_narrowed() {
    let message = expect_invalid("try_duration_ms", net.duration_ms("net.probe", duration.from_millis(wrapped_to_500())));
    assert(message == "InvalidArgument(net.probe: invalid duration 4294967796 ms (must be <= 2147483647))");
    let negative = expect_invalid("try_duration_ms", net.duration_ms("net.probe", -1ns));
    assert(negative == "InvalidArgument(net.probe: invalid negative duration (must be >= 0ns))");
}

#[test]
fn test_duration_within_abi_range_is_preserved() {
    match net.duration_ms("net.probe", 500ms) {
        .Ok(ms) => assert(ms == 500),
        .Err(_) => panic("expected 500 ms to be accepted"),
    }
    match net.duration_ms("net.probe", 0ns) {
        .Ok(ms) => assert(ms == 0),
        .Err(_) => panic("expected 0 ms to be accepted"),
    }
    match net.duration_ms("net.probe", duration.from_millis(net.abi_i32_max())) {
        .Ok(ms) => assert(ms == net.abi_i32_max()),
        .Err(_) => panic("expected the ABI ceiling to be accepted"),
    }
}

#[test]
fn test_positive_submillisecond_duration_rounds_up() {
    assert(net.duration_ms("net.probe", 1ns) == .Ok(1));
    assert(net.duration_ms("net.probe", 1000001ns) == .Ok(2));
    assert(net.duration_ms("net.probe", duration.from_millis(net.abi_i32_max()) + 1ns).is_err());
}

#[test]
fn test_size_above_abi_range_is_rejected() {
    let size = expect_invalid("try_size_arg", net.size_arg("tls.TlsStream.read", 4294967296));
    assert(size == "InvalidArgument(tls.TlsStream.read: invalid size 4294967296 (must be <= 2147483647))");
    match net.size_arg("tls.TlsStream.read", 4096) {
        .Ok(size_ok) => assert(size_ok == 4096),
        .Err(_) => panic("expected a 4096-byte read size to be accepted"),
    }
}

#[test]
fn test_port_above_abi_range_is_rejected_not_narrowed() {
    let wrapped = expect_invalid("try_port_arg", net.port_arg("tls.connect", wrapped_to_80()));
    assert(wrapped == "InvalidArgument(tls.connect: invalid port 4294967376 (must be 0..=65535))");
    let over = expect_invalid("try_port_arg", net.port_arg("tls.connect", 65536));
    assert(over == "InvalidArgument(tls.connect: invalid port 65536 (must be 0..=65535))");
    match net.port_arg("tls.connect", 443) {
        .Ok(port) => assert(port == 443),
        .Err(_) => panic("expected port 443 to be accepted"),
    }
}

fn expect_endpoint_rejected(addr: string) -> string {
    match net.parse_endpoint("net.connect_timeout", addr) {
        .Ok(endpoint) => {
            panic(f"expected '{addr}' to be rejected, got {endpoint.host}:{endpoint.port}");
            ""
        }
        .Err(err) => to_string(err),
    }
}

#[test]
fn test_missing_port_is_rejected_not_defaulted_to_zero() {
    assert(expect_endpoint_rejected("localhost") == "InvalidArgument(net.connect_timeout: invalid endpoint 'localhost' (missing ':port'))");
    assert(expect_endpoint_rejected("") == "InvalidArgument(net.connect_timeout: invalid endpoint '' (empty address))");
}

#[test]
fn test_non_numeric_and_out_of_range_ports_are_rejected() {
    assert(expect_endpoint_rejected("localhost:http") == "InvalidArgument(net.connect_timeout: invalid endpoint 'localhost:http' (port 'http' is not a number))");
    assert(expect_endpoint_rejected("localhost:") == "InvalidArgument(net.connect_timeout: invalid endpoint 'localhost:' (empty port))");
    assert(expect_endpoint_rejected("localhost:99999") == "InvalidArgument(net.connect_timeout: invalid port 99999 (must be 0..=65535))");
}

#[test]
fn test_unbracketed_ipv6_is_rejected_not_split_at_the_first_colon() {
    assert(expect_endpoint_rejected("::1:9000") == "InvalidArgument(net.connect_timeout: invalid endpoint '::1:9000' (unbracketed IPv6 literal; write [address]:port))");
    assert(expect_endpoint_rejected("[::1") == "InvalidArgument(net.connect_timeout: invalid endpoint '[::1' (unterminated '[' in IPv6 literal))");
    assert(expect_endpoint_rejected("[::1]") == "InvalidArgument(net.connect_timeout: invalid endpoint '[::1]' (missing ':port'))");
    assert(expect_endpoint_rejected("[]:9000") == "InvalidArgument(net.connect_timeout: invalid endpoint '[]:9000' (empty bracketed host))");
    assert(expect_endpoint_rejected("[::1]9000") == "InvalidArgument(net.connect_timeout: invalid endpoint '[::1]9000' (expected ':port' after ']'))");
}

fn endpoint_text(addr: string) -> string {
    match net.parse_endpoint("net.connect_timeout", addr) {
        .Ok(endpoint) => f"{endpoint.host}|{endpoint.port}",
        .Err(err) => {
            panic(f"expected '{addr}' to parse: {err}");
            ""
        }
    }
}

#[test]
fn test_valid_endpoints_are_preserved_exactly() {
    assert(endpoint_text("127.0.0.1:9000") == "127.0.0.1|9000");
    assert(endpoint_text("localhost:8080") == "localhost|8080");
    assert(endpoint_text("[::1]:9000") == "::1|9000");
    assert(endpoint_text(":0") == "127.0.0.1|0");
    assert(endpoint_text("example.com:65535") == "example.com|65535");
}

#[test]
#[real_time]
fn test_connect_timeout_deadline_overflow_is_rejected() {
    for timeout in [duration.from_millis(4294967000), duration.from_millis(2147483647) + 1ns, -1ns] {
        match net.connect_timeout("127.0.0.1:9", timeout) {
            .Ok(_) => panic("expected an invalid deadline to be rejected"),
            .Err(net.NetError.InvalidArgument(_)) => {}
            .Err(err) => panic(f"invalid deadline reached the network: {err}"),
        }
    }
}

#[test]
#[real_time]
fn test_connect_timeout_rejects_a_malformed_address_before_connecting() {
    match net.connect_timeout("::1:9000", 1s) {
        .Ok(_) => panic("expected an unbracketed IPv6 address to be rejected"),
        .Err(err) => assert(to_string(err) == "InvalidArgument(net.connect_timeout: invalid endpoint '::1:9000' (unbracketed IPv6 literal; write [address]:port))"),
    }
}

#[test]
fn test_http_client_timeout_above_abi_range_is_rejected() {
    match client.set_timeout(duration.from_millis(wrapped_to_500())) {
        .Ok(_) => panic("expected a wrapped HTTP timeout to be rejected"),
        .Err(err) => assert(to_string(err) == "InvalidArgument(client.set_timeout: invalid duration 4294967796 ms (must be <= 2147483647))"),
    }
    match client.set_timeout(1000ms) {
        .Ok(_) => {}
        .Err(_) => panic("expected a 1000 ms HTTP timeout to be accepted"),
    }
    assert(client.set_timeout(0ms).is_ok());
}
