import std.iter;

fn main() {
    let s = "Hello";
    println(s[1..3]);
    println("aba".replace("a", "x"));
    let idx = match "banana".find("na") {
        .Some(v) => v,
        .None => -1,
    };
    println(idx);
    let parts = "a,b,c".split(",");
    println(parts.len());
    let ls = "x\ny".lines();
    println(ls.len());
    println("ha".repeat(3));
    let c = "abc".get(1) ?? '?';
    println(to_string(c));
    let cs = iter.collect("Hi".iter());
    println(cs.len());
    println('1'.is_digit());
    println('a'.is_letter());
    println('3'.is_alphanumeric());
    println(s.clone());
}
