#[wire]
type Pair {
    first: string @1;
    second: string @2;
}

actor Store {
    var calls: i64 = 0;
    receive fn handle(value: Pair) -> string {
        calls = calls + 1;
        value.first + value.second
    }
    receive fn count() -> i64 {
        calls
    }
    receive fn identity() -> Store {
        self
    }
}

supervisor Service {
    #[intercept]
    fn observe<A>(call: Call<A>) -> Outcome<A> {
        println("intercepted");
        call.proceed()
    }
    child store: Store;
}

type LocalOnly {
    value: string;
}

actor Echo<T> {
    receive fn handle(value: T) -> T {
        value
    }
}

actor Tagged<T> {
    var marker: T;
    var calls: i64 = 0;
    receive fn handle(value: string) -> i64 {
        calls = calls + 1;
        calls
    }
}

actor Specialized<T> {
    receive fn handle(value: T) -> T {
        value
    }
}

fn pair() -> Pair {
    Pair { first: "first".to_upper(), second: "second".to_upper() }
}

fn main() {
    let store = spawn Store;
    assert(store.count().expect("initial count") == 0);
    assert(store.handle(pair()).expect("owned reply") == "FIRSTSECOND");
    assert(store.handle(pair()).expect("second owned reply") == "FIRSTSECOND");
    assert(store.handle(pair()).expect("completion") == "FIRSTSECOND");
    assert(store.count().expect("count") == 3);

    // Stateful supervisor interception forwards the same concrete actor state.
    let service = spawn Service;
    let supervised_handle = service.store.identity().expect("supervised handle");
    assert(supervised_handle.handle(pair()).expect("intercepted reply") == "FIRSTSECOND");
    assert(supervised_handle.handle(pair()).expect("second intercepted reply") == "FIRSTSECOND");
    assert(supervised_handle.handle(pair()).expect("intercepted completion") == "FIRSTSECOND");
    assert(supervised_handle.count().expect("supervised count") == 3);
    // A local-only specialization needs no wire schema or codec.
    let local = spawn Echo<LocalOnly>;
    let local_reply = local.handle(LocalOnly { value: "local".to_upper() }).expect("local generic reply");
    assert(local_reply.value == "LOCAL");
    stop(local);
    stopped(local);
    let echo = spawn Echo<string>;
    assert(echo.handle("echo".to_upper()).expect("generic reply") == "ECHO");

    // Each actor keeps its own concrete state and handler payload types.
    let tagged = spawn Tagged<string> { marker: "marker".to_upper() };
    assert(tagged.handle("first".to_upper()).expect("generic state reply") == 1);
    assert(tagged.handle("second".to_upper()).expect("second generic state reply") == 2);
    assert(tagged.handle("third".to_upper()).expect("generic state completion") == 3);
    let other_tagged = spawn Tagged<Pair> { marker: pair() };
    assert(other_tagged.handle("independent").expect("other specialization") == 1);
    stop(other_tagged);
    stopped(other_tagged);
    let specialized = spawn Specialized<string>;
    assert(specialized.handle("specialized".to_upper()).expect("specialized reply") == "SPECIALIZED");
    let nested = spawn Specialized<Vec<string>>;
    let values = nested.handle(["nested".to_upper()]).expect("nested reply");
    assert(values.get(0).expect("nested value") == "NESTED");
    let unmatched = spawn Specialized<i64>;
    assert(unmatched.handle(42).expect("unmatched local reply") == 42);
    stop(unmatched);
    stopped(unmatched);
    stop(nested);
    stopped(nested);
    stop(specialized);
    stopped(specialized);
    stop(tagged);
    stopped(tagged);
    stop(echo);
    stopped(echo);
    stop(service);
    stopped(service);
    stop(store);
    stopped(store);
    println("ordinary actor type identity");
}
