//! Option helper functions — pure Hew alternatives to the Rust FFI runtime.
//!
//! These functions provide idiomatic Hew wrappers for common `Option<T>`
//! operations.  They use `match` on the built-in `Option` type and avoid
//! FFI calls entirely for the supported element types.
//!
//! Options may carry both bitcopy and heap-owning payloads. Heap-owning values
//! are released through tag-aware drop glue when the option remains owned.
//!
//! # Examples
//!
//! ```
//! import std.option;
//!
//! fn main() {
//!     let x = Some(42);
//!     println(option.is_some_int(x));        // true
//!     println(option.unwrap_or_int(x, 0));   // 42
//!
//!     let y: Option<i64> = None;
//!     println(option.is_none_int(y));         // true
//!     println(option.unwrap_or_int(y, -1));   // -1
//! }
//! ```

// ── Predicates ──────────────────────────────────────────────────────
/// Returns `true` if the option contains a value.
pub fn is_some_int(opt: Option<i64>) -> bool {
    match opt {
        .Some(_) => true,
        .None => false,
    }
}

/// Returns `true` if the option is `None`.
pub fn is_none_int(opt: Option<i64>) -> bool {
    match opt {
        .Some(_) => false,
        .None => true,
    }
}

// ── Unwrap ──────────────────────────────────────────────────────────
/// Unwrap the `i64` value.  Panics if the option is `None`.
pub fn unwrap_int(opt: Option<i64>) -> i64 {
    match opt {
        .Some(v) => v,
        .None => {
            panic("option: unwrap called on None");
            0
        },
    }
}

/// Unwrap the `i64` value, or return `fallback` if `None`.
pub fn unwrap_or_int(opt: Option<i64>, fallback: i64) -> i64 {
    match opt {
        .Some(v) => v,
        .None => fallback,
    }
}

// ── Map ─────────────────────────────────────────────────────────────
/// Apply `f` to the contained `i64` value, or return `None` if empty.
pub fn map_int(opt: Option<i64>, f: fn(i64) -> i64) -> Option<i64> {
    match opt {
        .Some(v) => Some(f(v)),
        .None => None,
    }
}

// ── Contains ────────────────────────────────────────────────────────
/// Returns `true` if the option contains `needle`.
pub fn contains_int(opt: Option<i64>, needle: i64) -> bool {
    match opt {
        .Some(v) => v == needle,
        .None => false,
    }
}

// ── string variants ────────────────────────────────────────────────
/// Returns `true` if the option contains a value.
pub fn is_some_str(opt: Option<string>) -> bool {
    match opt {
        .Some(_) => true,
        .None => false,
    }
}

/// Returns `true` if the option is `None`.
pub fn is_none_str(opt: Option<string>) -> bool {
    match opt {
        .Some(_) => false,
        .None => true,
    }
}

/// Unwrap the `string` value.  Panics if the option is `None`.
pub fn unwrap_str(opt: Option<string>) -> string {
    match opt {
        .Some(v) => v,
        .None => {
            panic("option: unwrap called on None");
            ""
        },
    }
}

/// Unwrap the `string` value, or return `fallback` if `None`.
pub fn unwrap_or_str(opt: Option<string>, fallback: string) -> string {
    match opt {
        .Some(v) => v,
        .None => fallback,
    }
}

/// Apply `f` to the contained `string` value, or return `None` if empty.
pub fn map_str(opt: Option<string>, f: fn(string) -> string) -> Option<string> {
    match opt {
        .Some(v) => Some(f(v)),
        .None => None,
    }
}

/// Returns `true` if the option contains `needle`.
pub fn contains_str(opt: Option<string>, needle: string) -> bool {
    match opt {
        .Some(v) => v == needle,
        .None => false,
    }
}

// ── Float variants ─────────────────────────────────────────────────
/// Returns `true` if the option contains a value.
pub fn is_some_f64(opt: Option<f64>) -> bool {
    match opt {
        .Some(_) => true,
        .None => false,
    }
}

/// Returns `true` if the option is `None`.
pub fn is_none_f64(opt: Option<f64>) -> bool {
    match opt {
        .Some(_) => false,
        .None => true,
    }
}

/// Unwrap the `f64` value.  Panics if the option is `None`.
pub fn unwrap_f64(opt: Option<f64>) -> f64 {
    match opt {
        .Some(v) => v,
        .None => {
            panic("option: unwrap called on None");
            0.0
        },
    }
}

/// Unwrap the `f64` value, or return `fallback` if `None`.
pub fn unwrap_or_f64(opt: Option<f64>, fallback: f64) -> f64 {
    match opt {
        .Some(v) => v,
        .None => fallback,
    }
}

/// Apply `f` to the contained `f64` value, or return `None` if empty.
pub fn map_f64(opt: Option<f64>, f: fn(f64) -> f64) -> Option<f64> {
    match opt {
        .Some(v) => Some(f(v)),
        .None => None,
    }
}

/// Returns `true` if the option contains `needle`.
pub fn contains_f64(opt: Option<f64>, needle: f64) -> bool {
    match opt {
        .Some(v) => v == needle,
        .None => false,
    }
}

impl<T> Option<T> {
    fn is_some(opt: Option<T>) -> bool {
        match opt {
            .Some(_) => true,
            .None => false,
        }
    }
    fn is_none(opt: Option<T>) -> bool {
        match opt {
            .Some(_) => false,
            .None => true,
        }
    }
    fn expect(opt: Option<T>, reason: string) -> T {
        match opt {
            .Some(v) => v,
            .None => panic(f"expect failed: {reason}"),
        }
    }
    fn unwrap_or(opt: Option<T>, fallback: T) -> T {
        match opt {
            .Some(v) => v,
            .None => fallback,
        }
    }
}

// ── Generic combinators ────────────────────────────────────────────────
//
// These are plain module functions (`option.map(opt, f)`), not `impl`
// methods: the checker reserves inherent `impl Option<T> { ... }` blocks for
// a fixed marker set of methods (`is_some`/`is_none`/`expect`/`unwrap_or`,
// handled directly in `hew-hir`'s call lowering — see the impl block above,
// which is otherwise dead code, silently dropped at HIR lowering time). Any
// other method name in that block, including a fluent `map`/`and_then`, hits
// `E_HIR: impl-block shape not yet lowered: inherent impls on builtin
// nominal types ... are reserved for the standard library` the moment the
// module compiles — not only when the method is called. A `.map()` fluent
// spelling on `Option<T>` needs that HIR restriction lifted or the marker
// list extended; report by number to the owning compiler lane
// (hew-lang/hew#2933).
/// Apply `f` to the contained value, or return `None` unchanged.
pub fn map<T, U>(opt: Option<T>, f: fn(T) -> U) -> Option<U> {
    match opt {
        .Some(v) => Some(f(v)),
        .None => None,
    }
}

/// Apply `f` (itself `Option`-returning) to the contained value, or return
/// `None` unchanged. Chains a fallible lookup without nesting
/// `Option<Option<U>>`.
pub fn and_then<T, U>(opt: Option<T>, f: fn(T) -> Option<U>) -> Option<U> {
    match opt {
        .Some(v) => f(v),
        .None => None,
    }
}

/// Unwrap the value, or compute a fallback from `f` if `None`. Prefer this
/// over the builtin `unwrap_or` when the fallback is expensive to build,
/// since `f` runs only on the `None` path.
pub fn unwrap_or_else<T>(opt: Option<T>, f: fn() -> T) -> T {
    match opt {
        .Some(v) => v,
        // Braced, not a bare `f()`: the pinned tree-sitter-hew grammar
        // (a sibling repo, not this compiler) does not yet parse a
        // zero-argument call as a bare match-arm body.
        .None => {
            f()
        },
    }
}

/// Convert to a `Result`, using `err` as the `Err` value when `None`.
pub fn ok_or<T, E>(opt: Option<T>, err: E) -> Result<T, E> {
    match opt {
        .Some(v) => Ok(v),
        .None => Err(err),
    }
}
