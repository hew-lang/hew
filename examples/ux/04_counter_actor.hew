actor TicketDesk {
    var issued: i64 = 0;

    receive fn take_ticket() -> i64 {
        issued += 1;
        issued
    }
}

fn main() {
    let desk = spawn TicketDesk;
    for name in ["Ada", "Sam"] {
        match desk.take_ticket() {
            .Ok(number) => println(f"{name} has ticket {number}"),
            .Err(reason) => println(f"{name} could not get a ticket: {reason}"),
        }
    }
    stop(desk);
    stopped(desk);
}
