// Machines are pure value evaluators and cannot carry resource identity.
#[resource]
type Handle {
    fd: i64,
}

impl Handle {
    fn close(consume self) {
        println(f"CLOSE fd={self.fd}");
    }
}

machine Mixed {
    events {
        Open { fd: i64, }
        ,Touch,
    }

    state Idle,
    state Active { h: Handle, label: string, },

    on Open(fd): Idle => Active { h: Handle { fd: fd }, label: "conn".to_upper() }
    on Touch: Active => Active reenter { h: state.h, label: state.label }

    default { state }
}

machine Plain {
    events {
        Open { fd: i64, }
        ,Shut,
    }

    state Idle,
    state Live { h: Handle, },

    on Open(fd): Idle => Live { h: Handle { fd: fd } }
    on Shut: Live => Idle,

    default { state }
}

fn main() {
    var s = Mixed.Idle;
    let _ = s.step(MixedEvent.Open { fd: 7 });
    var p = Plain.Idle;
    let _ = p.step(PlainEvent.Open { fd: 8 });
    let _ = p.step(PlainEvent.Shut);
}
