type Wrap { name: string }
actor Fan { 
    var seen: i64,
    var held: Wrap,
    receive fn route(label: string, count: i64) {
        var j: i64 = 0;
        while j < count {
            let next = if j > 0 {
                Wrap { name: label }
            } else {
                Wrap { name: label }
            };
            held = next;
            j = j + 1;
        }
        seen = seen + 1;
    }
    receive fn total() -> i64 { seen + held.name.len() }
}
fn main() -> i64 {
    let fan = spawn Fan(seen: 0, held: Wrap { name: "seed" });
    var i: i64 = 0;
    while i < 50 {
        let _ = fan.route("branch".to_upper(), i % 5);
        i = i + 1;
    }
    match fan.total() { .Ok(n) => if n > 50 { 0 } else { 89 }, .Err(_) => 90 }
}
