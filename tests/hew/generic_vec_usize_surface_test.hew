//! Vec<usize> must share the canonical platform-sized integer Vec ABI.

fn first_usize<T>(xs: Vec<T>) -> T {
    xs[0]
}

#[test]
fn test_generic_vec_usize_push_get_pop() {
    var values: Vec<usize> = Vec.new();
    let first: usize = 5;
    let second: usize = 8;
    values.push(first);
    values.push(second);
    assert((first_usize(values) as i64) == 5);
    assert((values[1] as i64) == 8);
    assert((values.pop() as i64) == 8);
}
