// `a is b` BORROWS both operands: codegen reads field 0 of each `BytesTriple`
// and compares the two buffer addresses, releasing nothing. So an unbound
// `bytes` temporary in operand position keeps its single drop obligation, and
// a bound operand must survive the compare and still be released exactly once.
// LSan catches the missed release (`mk() is mk()` leaked both buffers before
// #3134); ASan catches an over-release of a buffer that outlives the compare.
fn make(n: i64) -> bytes {
    var b = bytes.new();
    b.push(n as u8);
    return b;
}

fn main() {
    var rounds: i64 = 0;
    for i in 0..256 {
        // Two fresh temporaries, neither bound to a name: the leak direction.
        if make(i) is make(i) {
            panic("distinct buffers must not compare identical");
        }

        // One bound operand against a fresh temporary: the held buffer must
        // outlive the compare, so an over-release shows up here.
        let held = make(i);
        if held is make(i) {
            panic("a held buffer must not be identical to a fresh one");
        }
        if !(held is held) {
            panic("a buffer must be identical to itself");
        }
        if held.len() != 1 {
            panic("the held buffer must survive the compare");
        }
        rounds = rounds + 1;
    }
    if rounds != 256 {
        panic("loop did not complete");
    }
}
