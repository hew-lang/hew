//! Status: runnable
//! Description: observe_supervisor_showcase.hew — Supervision-focused exemplar for hew-observe

// Live telemetry: HEW_OBSERVE=hot HEW_PPROF=127.0.0.1:6060 hew run \
//     examples/observe_supervisor_showcase.hew -- --wait-for-recording
// Start a recording in Observe, then press Enter to fail one worker.

import std.io;
import std.os;

// ── Actor types ─────────────────────────────────────────────────────────

// A resilient task worker. Default field values + constructor args mean it
// boots cleanly under a supervisor with no init() block. This is the
// canonical supervised-child shape for a live Supervisors tab.
actor Worker {
    let id: i32;
    var processed: i32 = 0;
    receive fn process(item: i32) {
        processed = processed + 1;
    }
    receive fn stats() -> i32 {
        processed
    }
    // Deliberate crash: panic() trips the supervisor, which restarts this
    // child. The restart bumps the child's "restarts" counter — visible in
    // the Supervisors tab as `(restarts: N)`.
    receive fn crash() {
        panic("worker hit a poison message");
    }
}

// A lightweight stateful service. Used as the one_for_all children so a
// single crash restarts the whole group — useful for contrasting the two
// restart strategies side by side in the Supervisors tab.
actor Service {
    let port: i32;
    var requests: i32 = 0;
    receive fn handle() {
        requests = requests + 1;
    }
    receive fn load() -> i32 {
        requests
    }
}

// ── Supervisors ─────────────────────────────────────────────────────────

// one_for_one: when a child crashes, ONLY that child restarts. The siblings
// keep their state and keep running. This is the worker-pool pattern.
supervisor WorkerPool {
    strategy: one_for_one;
    intensity: 10 within 60s;

    child alpha: Worker { id: 1, processed: 0 };
    child beta: Worker { id: 2, processed: 0 };
    child gamma: Worker { id: 3, processed: 0 };
}

// one_for_all: when ANY child crashes, the supervisor restarts ALL of them.
// This is for tightly-coupled services that must come up together (e.g. a
// connection pool plus its health checker). We do not crash this tree — it
// stays at restarts:0 so the two strategies read cleanly in the tab.
supervisor ServiceStack {
    strategy: one_for_all;
    intensity: 5 within 30s;

    child api: Service { port: 8080, requests: 0 };
    child cache: Service { port: 6379, requests: 0 };
}

fn main() -> i32 {
    let workers = spawn WorkerPool;
    let stack = spawn ServiceStack;
    let alpha = workers.alpha;
    let beta = workers.beta;
    let gamma = workers.gamma;
    let api = stack.api;
    let cache = stack.cache;
    for item in 0..50 {
        alpha.process(item as i32).expect("alpha accepts work");
        beta.process(item as i32).expect("beta accepts work");
        gamma.process(item as i32).expect("gamma accepts work");
        api.handle().expect("API accepts requests");
        cache.handle().expect("cache accepts requests");
    }
    if os.args().contains("--wait-for-recording") {
        println("Start recording in Observe, then press Enter to fail alpha.");
        let line = io.read_line() handle error {
            io.write_err(f"reading the recording prompt: {error}\n").expect("standard error");
            return 1;
        };
        if line.is_none() {
            io.write_err("recording prompt needs an input line\n").expect("standard error");
            return 1;
        }
    }
    match alpha.crash() {
        .Ok(_) => panic("alpha's failing handler unexpectedly replied"),
        .Err(failure) => println(f"alpha failed: {failure}"),
    }
    restarted(alpha);
    assert(alpha.stats().expect("replacement alpha replies") == 0);
    assert(beta.stats().expect("beta still replies") == 50);
    assert(gamma.stats().expect("gamma still replies") == 50);
    println("Alpha restarted. Beta and gamma kept their counters.");
    println("Sending a new batch each second for one minute.");
    for round in 0..60 {
        for offset in 0..25 {
            let item = (round + offset) as i32;
            alpha.process(item).expect("replacement alpha accepts work");
            beta.process(item).expect("beta accepts work");
            gamma.process(item).expect("gamma accepts work");
        }
        api.handle().expect("API accepts requests");
        cache.handle().expect("cache accepts requests");
        sleep(1s);
    }
    let recovered = alpha.stats().expect("replacement alpha replies");
    let unaffected = beta.stats().expect("beta still replies");
    println(f"Alpha processed {recovered} after restart. Beta processed {unaffected} in total.");
    0
}
