//! File path and glob utilities.
//!
//! Manipulate file paths (join, split, check existence) and expand
//! glob patterns to lists of matching paths.
//!
//! # Examples
//!
//! ```
//! import std.path;
//!
//! fn main() {
//!     let dir = path.dirname("/home/user/file.txt");
//!     let ext = path.extension("photo.jpg");
//!     let result = match path.glob("*.hew") {
//!         .Ok(result) => result,
//!         .Err(error) => panic(to_string(error)),
//!     };
//!     for i in 0..result.len() {
//!         println(result.get(i));
//!     }
//!     result.close();
//! }
//! ```

/// The result of a glob expansion.
///
/// Created by `path.glob(pattern)`. Glob results close automatically at scope
/// exit; call `close()` to release one early.
#[opaque]
type GlobResultHandle {
}

#[resource]
pub type GlobResult {
    handle: GlobResultHandle;
}

/// Errors produced by `std.path` glob expansion and indexing.
pub enum PathError {
    /// The glob walk did not complete — an unreadable directory, an
    /// allocation failure, or a platform with no implementation.
    GlobFailed(string);
    /// A match index was negative or at/past the match count.
    IndexOutOfRange(string);
}

/// Print the human-readable detail carried by a `PathError`.
impl Display for PathError {
    fn fmt(self) -> string {
        match self {
            PathError.GlobFailed(message) => message,
            PathError.IndexOutOfRange(message) => message,
        }
    }
}

/// Methods available on a `GlobResult`.
trait GlobResultMethods {
    /// Return the number of matched paths.
    fn len(self) -> i64;

    /// Return the matched path at the given index.
    fn get(self, index: i64) -> string;

    /// Return the matched path at the given index, or `None` when the index
    /// is outside `0 .. len()`.
    fn try_get(self, index: i64) -> Option<string>;
}

impl GlobResultMethods for GlobResult {
    /// Return the number of matched paths.
    fn len(self) -> i64 {
        unsafe {
            hew_glob_count(self.handle) as i64
        }
    }
    /// Return the matched path at the given index.
    ///
    /// Panics when `index` is outside `0 .. len()`. Use `try_get` to handle an
    /// out-of-range index without terminating.
    fn get(self, index: i64) -> string {
        match self.try_get(index) {
            .Some(matched) => matched,
            .None => {
                panic(f"path.GlobResult.get: index {index} out of range for {self.len()} match(es)");
                ""
            }
        }
    }
    /// Return the matched path at the given index, or `None` when out of range.
    fn try_get(self, index: i64) -> Option<string> {
        // The range check runs in `i64` so an index above `i32` range is
        // rejected as out of range rather than wrapping into a valid slot.
        if index < 0 || index >= self.len() {
            return .None;
        }
        unsafe {
            .Some(hew_glob_get(self.handle, index as i32))
        }
    } // INTERNAL-ABI: C ABI takes i32 index; the i64 range check above precedes it
}

impl GlobResult {
    /// Release this glob result early.
    fn close(consume self) {
        unsafe {
            hew_glob_free(self.handle)
        };
    }
}

// ── Module-level functions ────────────────────────────────────────────
/// Expand a glob pattern and return all matching paths.
///
/// Returns an error when the expansion cannot complete (for example a matching
/// directory that cannot be read).
///
/// # Examples
///
/// ```hew,no_run
/// import std.path;
///
/// fn main() {
///     let files = match path.glob("src/**/*.hew") {
///         .Ok(files) => files,
///         .Err(error) => panic(to_string(error)),
///     };
/// }
/// ```
/// Expand a glob pattern, reporting expansion failure separately from a
/// completed walk that matched nothing.
///
/// # Examples
///
/// ```
/// import std.path;
///
/// fn main() {
///     match path.glob("src/**/*.hew") {
///         .Ok(files) => println(f"{files.len()} match(es)"),
///         .Err(err) => println(f"{err}"),
///     }
/// }
/// ```
pub fn glob(pattern: string) -> Result<GlobResult, PathError> {
    unsafe {
        let handle = hew_glob(pattern);
        if hew_glob_is_valid(handle) {
            .Ok(GlobResult { handle: handle })
        } else {
            // Preserve the detail before releasing the invalid handle.  The
            // success arm transfers that same single owner to `GlobResult`;
            // the failure arm consumes it here, so neither arm can leak or
            // double-free it.
            let detail = hew_glob_error(handle);
            hew_glob_free(handle);
            .Err(PathError.GlobFailed(detail))
        }
    }
}

/// Combine two path segments with the platform path separator.
///
/// # Examples
///
/// ```
/// import std.path;
///
/// fn main() {
///     println(path.combine("/home/user", "file.txt"));   // "/home/user/file.txt"
/// }
/// ```
pub fn combine(a: string, b: string) -> string {
    let windows = native_separator() == "\\";
    if windows && has_volume(b) {
        return b;
    }
    if rooted(b, windows) {
        if windows && has_volume(a) && !b.starts_with("\\\\") && !b.starts_with("//") {
            return a[0..volume_end(a)] + b;
        }
        return b;
    }
    if a.is_empty() {
        return b;
    }
    if ends_separator(a, windows) || (windows && a.ends_with(":")) {
        return a + b;
    }
    a + native_separator() + b
}

/// Return the directory portion of a path.
///
/// # Examples
///
/// ```
/// import std.path;
///
/// fn main() {
///     println(path.dirname("/home/user/file.txt"));   // "/home/user"
/// }
/// ```
pub fn dirname(p: string) -> string {
    let windows = native_separator() == "\\";
    let s = strip_trailing_separator(p, windows);
    let root = root_end(s, windows);
    let pos = last_separator_pos(s, windows);
    if pos < root {
        return s[0..root];
    }
    s[0..pos]
}

/// Return the final component of a path.
///
/// # Examples
///
/// ```
/// import std.path;
///
/// fn main() {
///     println(path.basename("/home/user/file.txt"));   // "file.txt"
/// }
/// ```
pub fn basename(p: string) -> string {
    let windows = native_separator() == "\\";
    let s = strip_trailing_separator(p, windows);
    let root = root_end(s, windows);
    if s.len() <= root {
        return "";
    }
    let pos = last_separator_pos(s, windows);
    if pos < root {
        return s[root..s.len()];
    }
    s[pos + 1 .. s.len()]
}

/// Return the file extension (without the dot).
///
/// # Examples
///
/// ```
/// import std.path;
///
/// fn main() {
///     println(path.extension("photo.jpg"));   // "jpg"
/// }
/// ```
pub fn extension(p: string) -> string {
    let base = basename(p);
    let dot_pos = last_dot_pos(base);
    if dot_pos <= 0 {
        return "";
    }
    base[dot_pos + 1 .. base.len()]
}

/// Test whether a path exists on the filesystem.
pub fn exists(p: string) -> bool {
    unsafe {
        hew_path_exists(p)
    }
}

/// Test whether a path refers to a regular file.
pub fn is_file(p: string) -> bool {
    unsafe {
        hew_path_is_file(p)
    }
}

/// Test whether a path refers to a directory.
pub fn is_dir(p: string) -> bool {
    unsafe {
        hew_path_is_dir(p)
    }
}

/// Return the absolute form of a path.
///
/// This is a lexical join against the current working directory: it does
/// NOT resolve `..` or symlinks. `absolute("../../etc/passwd")` returns
/// `<cwd>/../../etc/passwd`, not a collapsed or containment-checked path.
/// Pass the result through `normalize` for a lexically clean path, or use
/// a host-provided, symlink-aware canonicalization step before treating a
/// path as safe to open — `normalize` alone does not guard against `..`
/// escaping through a symlinked directory.
pub fn absolute(p: string) -> string {
    unsafe {
        hew_path_absolute(p)
    }
}

/// Lexically clean a path: collapse repeated separators, drop `.` segments,
/// and resolve `..` segments against the preceding component. This function
/// currently interprets portable `/` separators on every platform; Windows
/// drive and UNC normalization is not implemented. Follows Go's `path.Clean`
/// semantics. Does not touch the filesystem — it has no
/// symlink awareness, so a cleaned path can still escape a directory the
/// caller intended to stay inside if any component is a symlink. Returns
/// `"."` for an empty path.
///
/// # Examples
///
/// ```
/// import std.path;
///
/// fn main() {
///     path.normalize("/var/www/../../etc/passwd");  // "/etc/passwd"
///     path.normalize("a/./b/../c");                 // "a/c"
///     path.normalize("../../etc/passwd");           // "../../etc/passwd"
///     path.normalize("");                           // "."
/// }
/// ```
pub fn normalize(p: string) -> string {
    if p == "" {
        return ".";
    }
    let rooted = p.starts_with("/");
    let parts = p.split("/");
    var stack: Vec<string> = Vec.new();
    for i in 0..parts.len() {
        let seg = parts[i];
        if seg == "" || seg == "." {
            continue;
        }
        if seg == ".." {
            if stack.len() > 0 && stack[stack.len() - 1] != ".." {
                stack.pop();
            } else if !rooted {
                stack.push(seg);
            }
            // Rooted with an empty (or all-"..") stack: `..` above root
            // collapses to root, matching filepath.Clean.
            continue;
        }
        stack.push(seg);
    }
    let joined = (stack).join("/");
    if rooted {
        return "/" + joined;
    }
    if joined == "" {
        return ".";
    }
    joined
}

// ── Helpers ──────────────────────────────────────────────────────────
// The VM uses portable '/' paths. Native code supplies only the platform
// separator; lexical interpretation stays here for every consumer.
fn native_separator() -> string {
    unsafe {
        hew_path_separator()
    }
}

fn ends_separator(p: string, windows: bool) -> bool {
    p.ends_with("/") || (windows && p.ends_with("\\"))
}

fn rooted(p: string, windows: bool) -> bool {
    p.starts_with("/") || (windows && p.starts_with("\\"))
}

fn has_volume(p: string) -> bool {
    has_drive(p) || p.starts_with("\\\\") || p.starts_with("//")
}

fn has_drive(p: string) -> bool {
    match p.find(":") {
        .Some(1) => true,
        _ => false,
    }
}

fn first_separator_pos(p: string, start: i64, windows: bool) -> i64 {
    let rest = p[start..p.len()];
    let slash = match rest.find("/") {
        .Some(index) => start + index,
        .None => p.len(),
    };
    if windows {
        let backslash = match rest.find("\\") {
            .Some(index) => start + index,
            .None => p.len(),
        };
        if backslash < slash {
            return backslash;
        }
    }
    slash
}

fn volume_end(p: string) -> i64 {
    if has_drive(p) {
        return 2;
    }
    if p.starts_with("\\\\") || p.starts_with("//") {
        let server = first_separator_pos(p, 2, true);
        if server < p.len() {
            return first_separator_pos(p, server + 1, true);
        }
        return server;
    }
    0
}

fn root_end(p: string, windows: bool) -> i64 {
    let volume = if windows { volume_end(p) } else { 0 };
    if volume < p.len() && rooted(p[volume..p.len()], windows) {
        return volume + 1;
    }
    volume
}

fn strip_trailing_separator(p: string, windows: bool) -> string {
    let root = root_end(p, windows);
    var end = p.len();
    while end > root && ends_separator(p[0..end], windows) {
        end -= 1;
    }
    if end == p.len() {
        return p;
    }
    p[0..end]
}

fn last_separator_pos(s: string, windows: bool) -> i64 {
    var last: i64 = -1;
    var start: i64 = 0;
    while start < s.len() {
        let next = first_separator_pos(s, start, windows);
        if next == s.len() {
            break;
        }
        last = next;
        start = next + 1;
    }
    last
}

/// Return the index of the last `.` in `s`, or `-1` if none.
fn last_dot_pos(s: string) -> i64 {
    let first = match s.find(".") {
        .Some(i) => i,
        .None => return -1,
    };
    var last = first;
    var search_from = first + 1;
    while search_from < s.len() {
        let rest = s[search_from..s.len()];
        let next = match rest.find(".") {
            .Some(i) => i,
            .None => return last,
        };
        last = search_from + next;
        search_from = last + 1;
    }
    last
}

// ── FFI bindings (host operations only) ────────────────────────
extern "C" {
    fn hew_glob(pattern: string) -> GlobResultHandle;
    fn hew_glob_is_valid(result: GlobResultHandle) -> bool;
    fn hew_glob_error(result: GlobResultHandle) -> string;
    fn hew_glob_count(result: GlobResultHandle) -> i32;
    fn hew_glob_get(result: GlobResultHandle, index: i32) -> string;
    fn hew_glob_free(result: GlobResultHandle);
    fn hew_path_exists(path: string) -> bool;
    fn hew_path_is_file(path: string) -> bool;
    fn hew_path_is_dir(path: string) -> bool;
    fn hew_path_absolute(path: string) -> string;
    fn hew_path_separator() -> string;
}
