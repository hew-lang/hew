// Owned string keys and values remain independent after each yield.

pub fn main() -> i64 {
    var m: HashMap<string, string> = HashMap.new();
    m.insert("k1", "value_one");
    m.insert("k2", "value_two");
    m.insert("k3", "value_three");
    var total = 0;
    var count = 0;
    for (k, v) in m {
        total = total + k.len() + v.len();
        count = count + 1;
    }
    if count != 3 {
        return 100 + count;
    }
    total
}
