// COEXIST: state-field spawn args alongside init() params.
// `count` has a default, so a spawn may still name it and init may replace
// it; `multiplier` is an init() param. The spawn supplies count = 5, then
// init sets count *= multiplier (2), giving 10.
// Then total() returns count (10) + base (100) = 110.
actor Calc {
    var count: i64 = 0,
    var base: i64,
    init(multiplier: i64) {
        count = count * multiplier;
    }
    receive fn total() -> i64 {
        count + base
    }
}

fn main() -> i64 {
    // `count` and `base` are state fields; `multiplier` is an init() param.
    let calc = spawn Calc(multiplier: 2, count: 5, base: 100);
    match calc.total() {
        .Ok(v) => v,
        .Err(_e) => -1,
    }
}
