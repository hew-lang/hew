//! Seedable pseudo-random number generation.
//!
//! Backed by a CPython-compatible MT19937 Mersenne Twister implemented in
//! `hew-runtime/src/random.rs`. State is thread-local — one generator per
//! thread. A fixed seed produces a deterministic, reproducible sequence that
//! matches CPython's `random` module output for the same seed.
//!
//! # Examples
//!
//! ```
//! import std.random;
//!
//! fn main() {
//!     random.seed(42);
//!     println(random.random());   // ≈ 0.6394267984578837
//!     println(random.randint(0, 10).expect("valid random draw"));
//! }
//! ```
//!
//! # `Rng`: independent seeded generators
//!
//! The module-level functions above (`seed`, `random`, `randint`, `shuffle`,
//! `choices`, `gauss`) share one implicit generator per thread. `Rng` is a
//! plain value a caller holds and passes around instead, so several
//! independent streams can run in the same thread. It uses xoshiro256++
//! implemented in ordinary Hew rather than
//! MT19937, so its output does not match the module-level functions for the
//! same seed.
//!
//! ```
//! import std.random;
//!
//! fn main() {
//!     var rng = random.Rng.new(42);
//!     println(rng.next_u64());
//!     println(rng.next_f64());
//!     println(rng.range(0, 10).expect("valid random draw"));
//! }
//! ```

import std.crypto.hash;

/// Inputs that cannot describe a random draw.
pub enum RandomError {
    InvalidRange { lower: i64; upper: i64; }
    InvalidWeights(string);
    UnsupportedCount(i64);
}

impl Error for RandomError {}

// ── Rng: independent seeded generators ─────────────────────────────────
/// An independent, seedable pseudo-random generator (xoshiro256++).
///
/// Unlike the module-level functions, an `Rng` value is not shared
/// thread-local state: create one with `Rng.new(seed)` and hold it wherever
/// it is needed. Two `Rng` values created with the same seed produce
/// identical sequences. Advancing a generator requires a mutable `var` binding.
/// Copying a generator creates an independent stream at the same position.
pub type Rng {
    s0: u64;
    s1: u64;
    s2: u64;
    s3: u64;
}

impl Rng {
    /// Create an independent generator from any signed seed.
    pub fn new(seed: i64) -> Rng {
        let s0 = (seed as u64).wrapping_add(0x9E3779B97F4A7C15);
        let s1 = s0.wrapping_add(0x9E3779B97F4A7C15);
        let s2 = s1.wrapping_add(0x9E3779B97F4A7C15);
        let s3 = s2.wrapping_add(0x9E3779B97F4A7C15);
        Rng { s0: mix_seed(s0), s1: mix_seed(s1), s2: mix_seed(s2), s3: mix_seed(s3) }
    }

    /// Advance the xoshiro256++ stream by one word.
    pub fn next_u64(var self) -> u64 {
        let result = self.s0.wrapping_add(self.s3).rotate_left(23).wrapping_add(self.s0);
        let shifted = self.s1 << 17;
        self.s2 = self.s2 ^ self.s0;
        self.s3 = self.s3 ^ self.s1;
        self.s1 = self.s1 ^ self.s2;
        self.s0 = self.s0 ^ self.s3;
        self.s2 = self.s2 ^ shifted;
        self.s3 = self.s3.rotate_left(45);
        result
    }

    /// Draw a 53-bit float in the half-open interval [0, 1).
    pub fn next_f64(var self) -> f64 {
        (self.next_u64() >> 11) as f64 * (1.0 / 9007199254740992.0)
    }

    /// Draw without bias from the half-open interval [lo, hi).
    pub fn range(var self, lo: i64, hi: i64) -> i64 fails RandomError {
        if hi <= lo {
            return error RandomError.InvalidRange { lower: lo, upper: hi };
        }
        let width = (hi as u64).wrapping_sub(lo as u64);
        if width == 1 {
            return lo;
        }
        let maximum: u64 = 18446744073709551615;
        let mask = maximum >> width.wrapping_sub(1).leading_zeros();
        loop {
            let offset = self.next_u64() & mask;
            if offset < width {
                return lo.wrapping_add(offset as i64);
            }
        }
    }

    /// Return an independently shuffled copy, advancing this generator.
    pub fn shuffle<T>(var self, v: Vec<T>) -> Vec<T> {
        shuffled(v, |limit: i64| self.range(0, limit).expect("positive shuffle bound"))
    }
}

// Splitmix64 expands the seed into the reference xoshiro state.
fn mix_seed(word: u64) -> u64 {
    let first = (word ^ (word >> 30)).wrapping_mul(0xBF58476D1CE4E5B9);
    let second = (first ^ (first >> 27)).wrapping_mul(0x94D049BB133111EB);
    second ^ (second >> 31)
}

// ── Cryptographically secure randomness ─────────────────────────────────
/// Return a cryptographically secure random `u64` drawn from OS entropy.
pub fn crypto_u64() -> u64 fails hash.RandomError {
    let b = hash.random_bytes(8)?;
    var v: u64 = 0;
    for i in 0..8 {
        v = v | b[i] as u64 << i as u64 * 8;
    }
    v
}

// ── FFI bindings ──────────────────────────────────────────────────────
// All functions delegate to `hew-runtime/src/random.rs` via C ABI.
// The runtime entry points are thread-local: each OS thread has its own
// MT state, seeded from OS entropy at first use.
/// Seed the PRNG so subsequent calls produce a deterministic sequence.
///
/// The seed is reduced to its low 32 bits and passed to CPython's
/// `init_by_array`. Calling `seed` with the same value always produces
/// the same stream.
pub fn seed(s: i64) {
    unsafe {
        hew_random_seed(s)
    }
}

/// Return a random float in [0.0, 1.0) with 53-bit precision.
///
/// Uses CPython's `random()` algorithm (two 27/26-bit MT words combined).
pub fn random() -> f64 {
    unsafe {
        hew_random_random()
    }
}

/// Return a random float drawn from a Gaussian (normal) distribution
/// with the given `mean` and `sigma` (standard deviation).
///
/// Uses the Box-Muller method with spare-value caching, matching
/// CPython's `random.gauss` implementation.
pub fn gauss(mean: f64, sigma: f64) -> f64 {
    unsafe {
        hew_random_gauss(mean, sigma)
    }
}

/// Return a random integer in the half-open range [`lo`, `hi`).
///
/// Returns `RandomError.InvalidRange` when `hi <= lo`.
pub fn randint(lo: i64, hi: i64) -> i64 fails RandomError {
    if hi <= lo {
        return error RandomError.InvalidRange { lower: lo, upper: hi };
    }
    unsafe {
        hew_random_randint(lo, hi)
    }
}

/// Return an independently shuffled copy using Fisher-Yates.
/// The input and any aliases of it remain unchanged.
///
/// Matches CPython's `random.shuffle` output for the same seed.
pub fn shuffle<T>(v: Vec<T>) -> Vec<T> {
    shuffled(v, |limit: i64| randint(0, limit).expect("positive shuffle bound"))
}

fn shuffled<T>(var values: Vec<T>, consume var draw: fn[var](i64) -> i64) -> Vec<T> {
    var remaining = values.len();
    while remaining > 1 {
        let other = draw(remaining);
        remaining -= 1;
        let saved = values[remaining];
        values[remaining] = values[other];
        values[other] = saved;
    }
    values
}

/// Weighted choice by bisecting cumulative weights. Returns the chosen index.
///
/// `weights` is a `Vec<f64>` of cumulative weights (each entry is the sum of
/// all weights up to and including that index), `total` is the grand total,
/// and `n` must be `1`.
pub fn choices(weights: Vec<f64>, total: f64, n: i64) -> i64 fails RandomError {
    if weights.len() == 0 {
        return error RandomError.InvalidWeights("weights must not be empty");
    }
    if total <= 0.0 || total != total {
        return error RandomError.InvalidWeights("total must be a positive finite value");
    }
    if n != 1 {
        return error RandomError.UnsupportedCount(n);
    }
    var previous = 0.0;
    for i in 0..weights.len() {
        let weight = weights[i];
        if weight <= previous || weight != weight {
            return error RandomError.InvalidWeights("weights must be strictly increasing");
        }
        previous = weight;
    }
    if previous != total {
        return error RandomError.InvalidWeights("total must equal the final cumulative weight");
    }
    unsafe {
        hew_random_choices_vec(weights, total, n)
    }
}

// ── Runtime externs ───────────────────────────────────────────────────
extern "C" {
    fn hew_random_seed(seed: i64);
    fn hew_random_random() -> f64;
    fn hew_random_gauss(mu: f64, sigma: f64) -> f64;
    fn hew_random_randint(lo: i64, hi: i64) -> i64;
    fn hew_random_choices_vec(v: Vec<f64>, total: f64, n: i64) -> i64;
}
