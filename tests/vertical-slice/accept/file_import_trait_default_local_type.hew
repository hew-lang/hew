// Regression probe: a trait default method whose BODY uses a type declared
// in the trait's own file (constructs `Badge`, calls the free function
// `badge_tag`) must lower correctly when the default is materialised onto an
// impl in the importing file. The materialised body keeps the trait file's
// spans while the impl lives here, so a split source context would misresolve
// the trait-file-local names.
import "file_import_trait_default_local_type_lib.hew";

type Widget {
    id: string,
}

impl Describe for Widget {
    fn ident(self) -> string {
        self.id
    }
}

fn main() {
    let w = Widget { id: "w1" };
    println(w.describe());
}
