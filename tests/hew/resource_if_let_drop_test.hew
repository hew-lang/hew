//! Regression coverage for owned resource payloads bound by conditional patterns.

import std.fs;
import std.stream;
import std.testing;

fn cleanup(path: string) {
    if fs.exists(path) {
        let _ = fs.delete(path);
    }
}

#[test]
fn test_if_let_resource_can_close_explicitly() {
    let path = "tests/hew/_resource_if_let_close.txt";
    cleanup(path);
    if let .Ok(sink) = stream.to_file(path) {
        sink.write("rc1");
        sink.close();
    }
    let contents = match fs.read(path) {
        .Ok(contents) => contents,
        .Err(_) => panic("expected resource output"),
    };
    testing.assert_eq_str(contents, "rc1");
    cleanup(path);
}

#[test]
fn test_if_let_resource_empty_body_drops_at_scope_exit() {
    let path = "tests/hew/_resource_if_let_drop.txt";
    cleanup(path);
    if let .Ok(sink) = stream.to_file(path) {}
    let contents = match fs.read(path) {
        .Ok(contents) => contents,
        .Err(_) => panic("expected resource output"),
    };
    testing.assert_eq_str(contents, "");
    cleanup(path);
}

#[test]
fn test_match_resource_can_close_explicitly() {
    let path = "tests/hew/_resource_match_close.txt";
    cleanup(path);
    match stream.to_file(path) {
        .Ok(sink) => {
            sink.write("match");
            sink.close();
        },
        .Err(_) => panic("expected file sink"),
    }
    let contents = match fs.read(path) {
        .Ok(contents) => contents,
        .Err(_) => panic("expected resource output"),
    };
    testing.assert_eq_str(contents, "match");
    cleanup(path);
}

#[test]
fn test_while_let_resource_can_close_explicitly() {
    let path = "tests/hew/_resource_while_let_close.txt";
    cleanup(path);
    while let .Ok(sink) = stream.to_file(path) {
        sink.write("while");
        sink.close();
        break;
    }
    let contents = match fs.read(path) {
        .Ok(contents) => contents,
        .Err(_) => panic("expected resource output"),
    };
    testing.assert_eq_str(contents, "while");
    cleanup(path);
}

type Endpoint { host: string, port: i64 }

enum ParseError {
    Invalid(string),
}

fn parse_error_message(e: ParseError) -> string {
    match e {
        ParseError.Invalid(detail) => f"invalid: {detail}",
    }
}

fn try_parse(addr: string) -> Result<Endpoint, ParseError> {
    if addr == "" {
        return Err(ParseError.Invalid("empty address"))
    }
    Ok(Endpoint { host: addr, port: 7 })
}

/// Both arms of this match bind a payload out of ONE scrutinee mint. The
/// obligation checker folds every payload discharge back onto that mint, so
/// granting a second arm's binder its own scope-close release over-releases the
/// scrutinee. Guards the `std.net` connect surface, which lowers to this shape.
fn describe_endpoint(addr: string) -> string {
    let Endpoint { host, port } = match try_parse(addr) {
        .Ok(endpoint) => endpoint,
        .Err(err) => {
            panic(f"describe_endpoint failed: {parse_error_message(err)}");
            Endpoint { host: "", port: 0 }
        },
    };
    f"{host}:{port}"
}

#[test]
fn test_match_payload_binders_share_one_scrutinee_release() {
    testing.assert_eq_str(describe_endpoint("localhost"), "localhost:7");
}

fn open_from_if_let(path: string) -> Result<stream.Sink<string>, string> {
    if let .Ok(sink) = stream.to_file(path) {
        return Ok(sink);
    }
    Err("open failed")
}

#[test]
fn test_if_let_resource_can_be_returned() {
    let path = "tests/hew/_resource_if_let_return.txt";
    cleanup(path);
    match open_from_if_let(path) {
        .Ok(sink) => {
            sink.write("returned");
            sink.close();
        },
        .Err(_) => panic("expected file sink"),
    }
    let contents = match fs.read(path) {
        .Ok(contents) => contents,
        .Err(_) => panic("expected resource output"),
    };
    testing.assert_eq_str(contents, "returned");
    cleanup(path);
}
