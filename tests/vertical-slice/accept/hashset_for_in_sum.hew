// HashSet for-in reaches the declared IntoIterator impl and owns its
// element snapshot through VecIter. Elements 10, 20, 30 sum to 60; the count
// guard checks that all are visited and the set stays live after the loop.
pub fn main() -> i64 {
    var s: HashSet<i64> = HashSet.new();
    s.insert(10);
    s.insert(20);
    s.insert(30);
    var total = 0;
    var count = 0;
    for x in s {
        total = total + x;
        count = count + 1;
    }
    if count != 3 {
        return 100 + count;
    }
    if s.len() != 3 {
        return 99;
    }
    total
}
