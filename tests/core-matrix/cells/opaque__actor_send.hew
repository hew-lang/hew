#[opaque]
type DqH {
}

#[resource]
type Dq {
    handle: DqH;
    tag: i64;
}

impl Dq {
    fn close(self) {
        unsafe { hew_deque_free(self.handle) };
        println(f"close {self.tag}");
    }
}

extern "C" {
    fn hew_deque_new() -> DqH;
    fn hew_deque_free(dq: DqH);
    fn hew_deque_len(dq: DqH) -> i64;
}

actor Sink {
    var hits: i64;

    receive fn take(v: Dq) -> i64 {
        let v_l = unsafe { hew_deque_len(v.handle) };
        let v_t = v.tag;
        println(f"dq {v_t} len={v_l}");
        hits = hits + 1;
        hits
    }
}

fn main() {
    let x = Dq { handle: unsafe { hew_deque_new() }, tag: 1 };
    let s = spawn Sink(hits: 0);
    match await s.take(x) {
        Result.Ok(n) => println(f"hits {n}"),
        Result.Err(_) => println("err"),
    }
}
