// A machine value that ends its scope in a state holding a `#[resource]`
// closes that handle exactly once — the same contract a bare `#[resource]`
// local has always had. The release is tag-aware: it runs only for the state
// the machine is actually in, so a machine that transitioned back to a
// payload-free state releases nothing a second time, and an early return with
// the handle still live releases it once.
//
// Before the machine drop class existed, a machine value was
// `ValueClass::Unknown` and fell through every scope-exit drop class: the
// handle leaked with no diagnostic while `hew check` reported OK.
//
// `hold` returns with the machine in `Active` — the leak shape.
// `release` steps back to `Idle` first — the source-state release, which must
// not be followed by a second close at scope exit.
// `bail` returns early with the handle live — the early-exit path.
//
// Expected stdout:
//   hold
//   CLOSE fd=1
//   release
//   CLOSE fd=2
//   bail
//   CLOSE fd=3
//   done
#[resource]
type Handle {
    fd: i64;
}

impl Handle {
    fn close(self) {
        println(f"CLOSE fd={self.fd}");
    }
}

machine ConnSession {
    events {
        Connect { fd: i64; }
        Disconnect;
    }

    state Idle;
    state Active { h: Handle; }

    on Connect(fd): Idle => Active {
        Active { h: Handle { fd: fd } }
    }
    on Disconnect: Active => Idle {
        Idle
    }

    default { state }
}

fn hold() {
    var s = ConnSession::Idle;
    s.step(ConnSessionEvent::Connect { fd: 1 });
    println("hold");
}

fn release() {
    var s = ConnSession::Idle;
    s.step(ConnSessionEvent::Connect { fd: 2 });
    println("release");
    s.step(ConnSessionEvent::Disconnect);
}

fn bail(early: bool) {
    var s = ConnSession::Idle;
    s.step(ConnSessionEvent::Connect { fd: 3 });
    println("bail");
    if early {
        return;
    }
    s.step(ConnSessionEvent::Disconnect);
}

fn main() {
    hold();
    release();
    bail(true);
    println("done");
}
