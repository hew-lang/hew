// Aliased-trait positive trait-signature ACCEPT oracle.
//
// `hew::closableerr` exports the trait `Closable` whose `close` returns
// `Result<(), CloseError>` (bare inside the defining module). This importer
// brings the trait into scope under an ALIAS (`Closable as C`) and impls `close`
// returning the CORRECT type spelled through its module qualifier
// (`closableerr.CloseError`).
//
// The selective import also retains the lexical module qualifier
// `closableerr -> hew.closableerr`. After resolving the aliased trait `C` to
// its source identity, both the trait's bare `CloseError` and the impl's
// `closableerr.CloseError` canonicalize to
// `hew.closableerr.CloseError`. A broken alias resolution would either miss the
// signature lookup (and accept anything) or compare a short name with a full
// declaration identity and falsely reject this correct impl.
//
// Harness verb: hew check (positive — see run.sh).
import hew.closableerr.{Closable as C};

pub type ClosableHandle {
    id: i64;
}

impl C for ClosableHandle {
    fn close(handle: ClosableHandle) -> Result<(), closableerr.CloseError> {
        Ok(())
    }
}

fn main() {
    let m = ClosableHandle { id: 1 };
    match m.close() {
        Ok(_) => println("ok"),
        Err(_) => println("err"),
    }
}
