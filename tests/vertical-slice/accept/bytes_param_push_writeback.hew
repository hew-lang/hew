//! Behavioural proof that a `bytes` parameter is a value: a callee's `push`
//! grows the callee's own buffer, so the grown buffer is what the callee
//! returns and the caller rebinds.
//!
//! `fill` pushes the ASCII bytes for `Hi` and hands the buffer back; `forward`
//! re-receives it and pushes `!`. Threading the value through both calls is
//! what accumulates all three bytes — a callee that dropped its result would
//! read back short. A successful run prints `Hi! len=3` and exits 0.

import std.encoding.utf8;

fn fill(var b: bytes) -> bytes {
    b.push(72); // 'H'
    b.push(105); // 'i'
    b
}

fn forward(var b: bytes) -> bytes {
    b.push(33); // '!'
    b
}

fn main() -> i64 {
    var b: bytes = bytes.new();
    b = fill(b);
    b = forward(b);
    let decoded_b = utf8.decode(b) handle error {
        println(f"invalid UTF-8: {error}");
        return 1;
    };
    println(f"{decoded_b} len={b.len()}");
    0
}
