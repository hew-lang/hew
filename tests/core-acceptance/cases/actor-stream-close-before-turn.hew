import std.stream;

actor Producer {
    var total: i64 = 0;

    receive fn hold(consume gate: stream.Stream<i64>) {
        gate.recv().expect("release actor turn");
    }

    receive gen fn never_started() -> i64 {
        total += 1;
        yield total;
    }

    receive fn total_now() -> i64 {
        total
    }
}

fn main() {
    let producer = spawn Producer;
    let (release, gate): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("gate");
    mailbox(producer).hold(gate).expect("queue holding turn");
    let output = producer.never_started();
    output.close();
    release.send(1).expect("release holding turn");
    assert(producer.total_now().expect("query total") == 0);
    release.close();
    stop(producer);
    stopped(producer);
    println("closed before turn");
}
