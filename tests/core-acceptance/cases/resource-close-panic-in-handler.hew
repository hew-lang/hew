// The same shape inside an actor handler: the panic crashes the actor with the
// panic's own code and message, and `main` keeps running afterwards.
//
// Acceptance only: the trap raised from drop glue has no cleanup authority over
// the crashing handler's frame, so the vector this handler still owns is
// stranded (hew-lang/hew#3475). The safety twins are the same clear in `main`
// and a handler-local resource, which strand nothing.
#[resource]
type Conn { fd: i64, }

impl Conn {
    fn close(consume self) {
        println(f"close {self.fd}");
        if self.fd == 2 { panic("close failed"); }
    }
}

actor Pool {
    var drained: i64 = 0,
    receive fn drain() {
        var conns: Vec<Conn> = Vec.new();
        conns.push(Conn { fd: 1 });
        conns.push(Conn { fd: 2 });
        conns.clear();
        drained = 1;
    }
}

fn main() {
    let pool = spawn Pool;
    let _ = pool.drain();
    println("main continues");
}
