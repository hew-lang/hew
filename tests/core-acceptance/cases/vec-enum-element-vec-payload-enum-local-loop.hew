enum Shape { Dot, Label(string), }

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        var v: Vec<Shape> = Vec.new();
        v.push(Shape.Label("heap-owning-per-iteration-payload"));
        v.push(Shape.Dot);
        total = total + v.len();
        i = i + 1;
    }
    total
}
