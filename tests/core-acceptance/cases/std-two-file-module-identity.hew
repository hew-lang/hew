// Two files of one directory module, imported directly and together. Each
// import binds its own qualifier, and a type declared in one of the files has
// exactly one identity however it was reached, so that file still checks
// against itself and its fields stay reachable from the importer.
import std.net.http.codec.request;

import std.net.http.codec;

fn reject_code(raw: string) -> i64 {
    match request.parse_request(raw) {
        .Ok(.Some(_)) => 0,
        .Ok(.None) => -1,
        .Err(error) => error.status(),
    }
}

fn main() {
    println(reject_code("GET / HTTP/1.1\r\n\r\n"));
    println(reject_code("nonsense\r\n\r\n"));
    println(codec.request_complete("GET / HTTP/1.1\r\n\r\n"));
    // The sibling file's own surface stays reachable through its own binding.
    println(codec.build_get("example.com", "/").expect("request").starts_with("GET / HTTP/1.1"));
}
