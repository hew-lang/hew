import std.net.websocket;

actor Client {
    let url: string;
    let frames: i64;
    var complete: i64;

    receive fn send_frames(unused: i64) {
        match websocket.connect(url, websocket.options()) {
            .Ok(connection) => {
                for _ in 0 .. frames {
                    if connection.send_text("message-owner").is_err() {
                        panic("WebSocket retention send failed")
                    }
                }
                connection.close();
                complete = 1;
            }
            .Err(_) => panic("WebSocket retention connect failed"),
        }
    }

    receive fn finished() -> i64 {
        complete
    }
}

fn drive_client(client: Client) -> i64 {
    match client.send_frames(0) {
        .Ok(_) => 0,
        .Err(_) => panic("WebSocket retention client failed"),
    }
}

fn main() {
    match websocket.listen("127.0.0.1:0") {
        .Ok(server) => {
            let client = spawn Client(url: f"ws://127.0.0.1:{server.port()}/retention", frames: 50, complete: 0);
            // The client's turn sends every frame and fills the socket buffer
            // long before it returns, so it runs alongside the reads below.
            // Calling it inline would leave nobody to accept or drain.
            scope {
                let _driver = fork drive_client(client);
                let connection = server.accept();
                for _ in 0 .. 50 {
                    match connection.recv() {
                        .Ok(.Some(websocket.Message.Text(text))) => println(text.len()),
                        _ => panic("WebSocket retention expected a text message"),
                    }
                }
                match client.finished() {
                    .Ok(done) => {
                        if done != 1 {
                            panic("WebSocket retention client stopped early");
                        }
                    }
                    .Err(_) => panic("WebSocket retention client failed"),
                }
                connection.close();
            };
            server.close();
        }
        .Err(_) => panic("WebSocket retention listener failed"),
    }
}
