// Reject fixture: a map value with no copy operation fails closed at the
// operation that copies it out.
//
// `values()` copies every value out of the map, so a value whose class carries
// no copy operation has nothing to hand back. An unmarked `#[opaque]` id is a
// bare pass-through value that copies by bits (ir-ladder.md §1.1), so the value
// that genuinely refuses is std's convention: a `#[resource]` wrapper that owns
// the close. `clone()` on the same map is refused one step earlier, by the
// clone-capability rule that names the resource member.

#[opaque]
#[resource]
type Handle {}

impl Handle {
    fn close(consume self) {}
}

type WrappedHandle {
    h: Handle,
}

extern "C" {
    fn hew_handle_create() -> Handle;
}

fn main() -> i64 {
    var m: HashMap<string, WrappedHandle> = HashMap.new();
    let h = unsafe { hew_handle_create() };
    m.insert("h", WrappedHandle { h: h });
    let _values = m.values();
    0
}
