#[resource]
type Input {
    label: string;
}

impl Input {
    fn close(consume self) {
        println(self.label);
    }
}

fn open() -> Input {
    Input { label: "closed" }
}

fn take(consume input: Input, value: i64) {
    input.close();
    println(value);
}

fn fail() -> i64 {
    panic("argument");
}

fn main() {
    var value = 4;
    defer {
        println(value);
        panic("older");
    }
    defer {
        value = 5;
        let input = open();
        take(input, fail());
        value = 100;
    }
}
