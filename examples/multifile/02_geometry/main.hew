// 02_geometry — selective imports and peer-file type sharing.
//
// The `geo` module is made of three peer files:
//   geo.hew      — Point type + origin() factory
//   distance.hew — abs_int, manhattan, chebyshev  (use Point without import)
//   area.hew     — bounding_area                   (use Point + abs_int without import)
//
// The selective import below brings Point and the listed functions into
// scope. With `import geo;`, write geo.Point, geo.origin() and geo.manhattan().
//
// Run:   hew run   examples/multifile/02_geometry/main.hew
// Check: hew check examples/multifile/02_geometry/main.hew
import geo.{Point, origin, manhattan, chebyshev, bounding_area};

fn main() {
    let o = origin();
    let p = Point { x: 3, y: 4 };
    let q = Point { x: 6, y: 8 };
    println(f"origin  = ({o.x}, {o.y})");
    println(f"p       = ({p.x}, {p.y})");
    println(f"q       = ({q.x}, {q.y})");
    println(f"manhattan(o, p)   = {manhattan(o, p)}");
    println(f"chebyshev(p, q)   = {chebyshev(p, q)}");
    println(f"bounding_area(o, q) = {bounding_area(o, q)}");
}
