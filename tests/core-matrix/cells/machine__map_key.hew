machine Counter {
    events { Inc; Reset; }
    state Zero;
    state NonZero { value: i64; }
    on Inc: Zero => NonZero { NonZero { value: 1 } }
    on Inc: NonZero => NonZero reenter { NonZero { value: self.value + 1 } }
    on Reset: NonZero => Zero { Zero }
    default { state }
}

fn main() {
    var k = Zero;
    k.step(Inc);
    let m: HashMap<Counter, i64> = HashMap::new();
    m.insert(k, 9);
    match m.get(k) {
        Some(v) => println(f"got {v}"),
        None => println("missing"),
    }
}
