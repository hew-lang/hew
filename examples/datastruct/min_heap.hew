// Min-Heap using implicit array representation
// Parent of i = (i-1)/2, left child = 2*i+1, right child = 2*i+2
//
// A parameter is the callee's own copy, so push and pop hand the heap back and
// the caller reassigns; pop also reports the value it removed.
fn heap_push(var heap: Vec<i32>, val: i32) -> Vec<i32> {
    heap.push(val);
    // Sift up
    var i = heap.len() - 1;
    while i > 0 {
        let parent = (i - 1) / 2;
        if heap[i] < heap[parent] {
            let tmp = heap[i];
            heap.set(i, heap[parent]);
            heap.set(parent, tmp);
            i = parent;
        } else {
            i = 0; // stop
        }
    }
    heap
}

// Push every value in order.
fn heap_push_all(var heap: Vec<i32>, values: Vec<i32>) -> Vec<i32> {
    for value in values {
        heap = heap_push(heap, value);
    }
    heap
}

fn heap_peek(heap: Vec<i32>) -> i32 {
    heap[0]
}

fn heap_pop(var heap: Vec<i32>) -> (Vec<i32>, i32) {
    let min_val = heap[0];
    let last = heap.pop();
    if !heap.is_empty() {
        heap.set(0, last);
        // Sift down
        var i = 0;
        var done = false;
        while !done {
            let left = 2 * i + 1;
            let right = 2 * i + 2;
            var smallest = i;
            if left < heap.len() {
                if heap[left] < heap[smallest] {
                    smallest = left;
                }
            }
            if right < heap.len() {
                if heap[right] < heap[smallest] {
                    smallest = right;
                }
            }
            if smallest != i {
                let tmp = heap[i];
                heap.set(i, heap[smallest]);
                heap.set(smallest, tmp);
                i = smallest;
            } else {
                done = true;
            }
        }
    }
    (heap, min_val)
}

fn test_basic_min_heap() -> i32 {
    var heap: Vec<i32> = Vec.new();
    let seeds1: Vec<i32> = [5, 3, 7, 1, 4];
    heap = heap_push_all(heap, seeds1);
    let pk = heap_peek(heap);
    if pk == 1 {
        println("PASS: min-heap peek returns minimum");
        1
    } else {
        print("FAIL: min-heap peek expected 1 got ");
        println(pk);
        0
    }
}

fn test_extract_min_order() -> i32 {
    var heap: Vec<i32> = Vec.new();
    let seeds2: Vec<i32> = [5, 3, 7, 1, 4, 6, 2];
    heap = heap_push_all(heap, seeds2);
    // Extract all in order
    let (after_e1, e1) = heap_pop(heap);
    heap = after_e1;
    let (after_e2, e2) = heap_pop(heap);
    heap = after_e2;
    let (after_e3, e3) = heap_pop(heap);
    heap = after_e3;
    let (after_e4, e4) = heap_pop(heap);
    heap = after_e4;
    let (after_e5, e5) = heap_pop(heap);
    heap = after_e5;
    let (after_e6, e6) = heap_pop(heap);
    heap = after_e6;
    let (after_e7, e7) = heap_pop(heap);
    heap = after_e7;
    var ok = true;
    if e1 != 1 {
        ok = false;
    }
    if e2 != 2 {
        ok = false;
    }
    if e3 != 3 {
        ok = false;
    }
    if e4 != 4 {
        ok = false;
    }
    if e5 != 5 {
        ok = false;
    }
    if e6 != 6 {
        ok = false;
    }
    if e7 != 7 {
        ok = false;
    }
    if ok {
        println("PASS: extract_min returns sorted order");
        1
    } else {
        print("FAIL: extract order: ");
        print(e1);
        print(" ");
        print(e2);
        print(" ");
        print(e3);
        print(" ");
        print(e4);
        print(" ");
        print(e5);
        print(" ");
        print(e6);
        print(" ");
        println(e7);
        0
    }
}

fn test_heap_property() -> i32 {
    var heap: Vec<i32> = Vec.new();
    let seeds3: Vec<i32> = [10, 4, 15, 20, 0, 8];
    heap = heap_push_all(heap, seeds3);
    // Verify heap property: parent <= children
    var ok = true;
    for i in 0 .. heap.len() {
        let left = 2 * i + 1;
        let right = 2 * i + 2;
        if left < heap.len() {
            if heap[i] > heap[left] {
                ok = false;
            }
        }
        if right < heap.len() {
            if heap[i] > heap[right] {
                ok = false;
            }
        }
    }
    if ok {
        println("PASS: heap property maintained");
        1
    } else {
        println("FAIL: heap property violated");
        0
    }
}

fn test_single_element() -> i32 {
    var heap: Vec<i32> = Vec.new();
    heap = heap_push(heap, 42);
    let pk = heap_peek(heap);
    let (after_popped, popped) = heap_pop(heap);
    heap = after_popped;
    if pk == 42 {
        if popped == 42 {
            if heap.is_empty() {
                println("PASS: single element heap");
                return 1;
            }
        }
    }
    println("FAIL: single element heap");
    0
}

fn test_duplicates() -> i32 {
    var heap: Vec<i32> = Vec.new();
    let seeds4: Vec<i32> = [3, 1, 3, 1, 2];
    heap = heap_push_all(heap, seeds4);
    let (after_e1, e1) = heap_pop(heap);
    heap = after_e1;
    let (after_e2, e2) = heap_pop(heap);
    heap = after_e2;
    let (after_e3, e3) = heap_pop(heap);
    heap = after_e3;
    let (after_e4, e4) = heap_pop(heap);
    heap = after_e4;
    let (after_e5, e5) = heap_pop(heap);
    heap = after_e5;
    var ok = true;
    if e1 != 1 {
        ok = false;
    }
    if e2 != 1 {
        ok = false;
    }
    if e3 != 2 {
        ok = false;
    }
    if e4 != 3 {
        ok = false;
    }
    if e5 != 3 {
        ok = false;
    }
    if ok {
        println("PASS: duplicates handled");
        1
    } else {
        println("FAIL: duplicates");
        0
    }
}

fn main() {
    println("=== Min-Heap ===");
    var passed = 0;
    let total = 5;
    passed = passed + test_basic_min_heap();
    passed = passed + test_extract_min_order();
    passed = passed + test_heap_property();
    passed = passed + test_single_element();
    passed = passed + test_duplicates();
    println("");
    print(passed);
    print("/");
    print(total);
    println(" tests passed");
    if passed == total {
        println("PASS");
    } else {
        println("FAIL");
    }
}
