import std.string;

type Inner {
    label: string,
    n: i64,
}
type Pair {
    keep: Inner,
    churn: string,
}

fn main() -> i64 {
    var p = Pair { keep: Inner { label: string.repeat("k", 32), n: 1 }, churn: string.repeat("a", 32) };
    var i: i64 = 0;
    while i < 50 {
        p = Pair { churn: string.repeat("b", 32), ..p };
        i = i + 1;
    }
    p.keep.n
}
