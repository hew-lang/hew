import std.stream;

actor ForAwaitRecv {
    receive fn run(unused: i64) {
        let (tx, rx): (stream.Sink<string>, stream.Stream<string>) = match stream.pipe(1024) { .Ok(pair) => pair, .Err(error) => panic(error), };
        tx.send("f0").expect("send");
        tx.send("f1").expect("send");
        tx.send("f2").expect("send");
        tx.close();
        for item in rx {
            println("got");
        }
    }
}

fn main() {
    let w = spawn ForAwaitRecv;
    let _ = w.run(0);
}
