//! Tests for generic std::math helpers.

import std.math;

#[test]
fn test_abs_dispatches_by_numeric_type() {
    let i: i64 = -5;
    let f: f64 = -5.5;
    assert(math.abs(i) == 5);
    assert(math.abs(f) == 5.5);
}

#[test]
fn test_min_returns_the_smaller_value() {
    assert(math.min(3, 7) == 3);
    assert(math.min(3.5, 1.25) == 1.25);
}

#[test]
fn test_max_returns_the_larger_value() {
    assert(math.max(3, 7) == 7);
    assert(math.max(3.5, 1.25) == 3.5);
}

#[test]
fn test_clamp_honors_valid_interval() {
    assert(math.clamp(8, 0, 5).expect("valid bounds") == 5);
}

#[test]
fn test_clamp_rejects_reversed_interval() {
    match math.clamp(5, 10, 0) {
        .Err(.ReversedBounds { lower, upper }) => assert(lower == 10 && upper == 0),
        _ => panic("expected reversed bounds"),
    }
}

#[test]
fn test_float_predicates_classify_normal_zero_infinite_and_nan() {
    let nan = 0.0 / 0.0;
    let pos_inf = 1.0 / 0.0;
    let neg_inf = -1.0 / 0.0;
    let subnormal = math.from_bits(1);

    assert(math.is_nan(nan));
    assert(!math.is_nan(0.0));
    assert(!math.is_nan(-0.0));
    assert(!math.is_nan(pos_inf));
    assert(!math.is_nan(neg_inf));
    assert(!math.is_nan(subnormal));

    assert(math.is_infinite(pos_inf));
    assert(math.is_infinite(neg_inf));
    assert(!math.is_infinite(0.0));
    assert(!math.is_infinite(-0.0));
    assert(!math.is_infinite(nan));
    assert(!math.is_infinite(1.0e308));

    assert(math.is_finite(0.0));
    assert(math.is_finite(-0.0));
    assert(math.is_finite(42.5));
    assert(math.is_finite(-1.0e308));
    assert(math.is_finite(subnormal));
    assert(!math.is_finite(pos_inf));
    assert(!math.is_finite(neg_inf));
    assert(!math.is_finite(nan));
}
