type NestedHeapMoveInner { text: string, value: i64 }
type NestedHeapMoveCarrier {
    inner: NestedHeapMoveInner,
    sibling: string,
}

fn project(i: i64) -> string {
    let r = NestedHeapMoveCarrier {
        inner: NestedHeapMoveInner {
            text: string_concat("inner-", "payload"),
            value: i,
        },
        sibling: string_concat("sibling-", "payload"),
    };
    r.inner.text
}

fn main() -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 64 {
        let moved = project(i);
        total = total + moved.len();
        i = i + 1;
    }
    if total > 0 { 0 } else { 1 }
}
