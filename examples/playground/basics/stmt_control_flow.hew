//! @name Read the trail board
//! @description Combine match, if and if let to report conditions on a trail.

enum Condition {
    Open;
    Muddy;
    Closed;
}

fn trail(name: string, condition: Condition, distance_km: Option<i64>) {
    print(f"{name}: ");
    match condition {
        .Open => println("open"),
        .Muddy => println("muddy"),
        .Closed => {
            println("closed");
            return;
        }
    }
    if let .Some(km) = distance_km {
        println(f"  {km} km");
        if km >= 10 {
            println("  Bring lunch.");
        }
    }
}

fn main() {
    trail("Valley", .Open, .Some(12));
    trail("Spruce", .Muddy, .Some(3));
    trail("Ridge", .Closed, .Some(15));
    trail("River", .Open, .None);
}
