type Pair<A, B> { a: A, b: B, }

fn build(seed: string) -> i64 {
    let nums = Pair { a: 1, b: 2 };
    let strs = Pair { a: seed + "-a", b: seed + "-b" };
    nums.a + nums.b + strs.a.len() + strs.b.len()
}

fn main() -> i64 {
    var total: i64 = 0;
    for i in 0..64 {
        total = total + build("seed");
    }
    if total != 960 { return 74; }
    0
}
