//! DNS hostname resolution.
//!
//! Resolve hostnames to IP address strings using the system resolver.
//!
//! # Examples
//!
//! ```hew,no_run
//! import std.net.dns;
//!
//! fn main() {
//!     let addrs = dns.resolve("localhost") handle error {
//!         println(f"operation failed: {error}");
//!         return;
//!     };
//!     for addr in addrs {
//!         println(addr);
//!     }
//!
//!     let first = dns.lookup_host("localhost") handle error {
//!         println(f"operation failed: {error}");
//!         return;
//!     };
//!     println(first);
//! }
//! ```

import std.net;

/// Resolve a hostname to all associated IP addresses.
///
/// Returns `Err(NetError.Other(0))` when the hostname cannot be resolved.
/// Use this when structured error handling with `?` is preferred over an
/// empty-vector sentinel.
///
/// Note: DNS has no OS errno channel; the errno payload is always 0.
/// A follow-up issue will wire errno once hew_dns_resolve exposes it.
pub fn resolve(hostname: string) -> Result<Vec<string>, net.NetError> {
    let addrs = unsafe {
        hew_dns_resolve(hostname)
    };
    if addrs.len() == 0 {
        .Err(net.net_error_from_errno(0))
    } else {
        .Ok(addrs)
    }
}

/// Resolve a hostname to its first IP address.
///
/// Returns `Err(NetError.Other(0))` when the hostname cannot be resolved.
/// Use this when structured error handling with `?` is preferred over an
/// empty-string sentinel.
///
/// Note: DNS has no OS errno channel; the errno payload is always 0.
/// A follow-up issue will wire errno once hew_dns_lookup_host exposes it.
pub fn lookup_host(hostname: string) -> Result<string, net.NetError> {
    let ip = unsafe {
        hew_dns_lookup_host(hostname)
    };
    if ip == "" {
        .Err(net.net_error_from_errno(0))
    } else {
        .Ok(ip)
    }
}

/// Resolve a hostname to all associated IP addresses with a deadline.
///
/// `deadline_ms <= 0` disables the deadline. On deadline expiry or resolution
/// failure returns an empty vector. The resolver keeps running after the
/// deadline; its late answer is discarded.
///
/// # Examples
///
/// ```hew,no_run
/// import std.net.dns;
///
/// fn main() {
///     let addrs = dns.resolve_timed("slow.example.com", 500);
///     for addr in addrs {
///         println(addr);
///     }
/// }
/// ```
pub fn resolve_timed(hostname: string, deadline_ms: i64) -> Vec<string> {
    if deadline_ms <= 0 {
        return unsafe {
            hew_dns_resolve(hostname)
        };
    }
    scope within duration.from_millis(deadline_ms) {
        unsafe {
            hew_dns_resolve(hostname)
        }
    } handle failure {
        let none: Vec<string> = [];
        none
    }
}

/// Resolve a hostname to its first IP address with a deadline.
///
/// `deadline_ms <= 0` disables the deadline. On deadline expiry or resolution
/// failure returns an empty string.
pub fn lookup_host_timed(hostname: string, deadline_ms: i64) -> string {
    if deadline_ms <= 0 {
        return unsafe {
            hew_dns_lookup_host(hostname)
        };
    }
    scope within duration.from_millis(deadline_ms) {
        unsafe {
            hew_dns_lookup_host(hostname)
        }
    } handle failure { "" }
}

// ── FFI bindings ──────────────────────────────────────────────────────
extern "C" {
    #[offload]
    fn hew_dns_resolve(hostname: string) -> Vec<string>;
    #[offload]
    fn hew_dns_lookup_host(hostname: string) -> string;
}
