// Doubly Linked List using Vec<i64> with index-based pointers
// Node layout: nodes[i*3] = value, nodes[i*3+1] = prev, nodes[i*3+2] = next
// NIL = -1
//
// A parameter is the callee's own copy, so every helper that writes into the
// node pool returns it and the caller reassigns. Helpers that also report a
// head or a new node index return a tuple.
fn node_val(n: Vec<i64>, i: i64) -> i64 {
    n[i * 3]
}

fn node_prev(n: Vec<i64>, i: i64) -> i64 {
    n[i * 3 + 1]
}

fn node_next(n: Vec<i64>, i: i64) -> i64 {
    n[i * 3 + 2]
}

fn set_prev(var n: Vec<i64>, i: i64, p: i64) -> Vec<i64> {
    n.set(i * 3 + 1, p);
    n
}

fn set_next(var n: Vec<i64>, i: i64, nx: i64) -> Vec<i64> {
    n.set(i * 3 + 2, nx);
    n
}

fn alloc_node(var n: Vec<i64>, val: i64) -> (Vec<i64>, i64) {
    let idx = n.len() / 3;
    n.push(val);
    n.push(-1);
    n.push(-1);
    (n, idx)
}

// Insert at front, returns the pool and the new head
fn insert_front(var n: Vec<i64>, head: i64, val: i64) -> (Vec<i64>, i64) {
    let (grown, nd) = alloc_node(n, val);
    n = grown;
    if head != -1 {
        n = set_next(n, nd, head);
        n = set_prev(n, head, nd);
    }
    (n, nd)
}

// Insert at back, returns the pool and the new head
fn insert_back(var n: Vec<i64>, head: i64, val: i64) -> (Vec<i64>, i64) {
    let (grown, nd) = alloc_node(n, val);
    n = grown;
    if head == -1 {
        return (n, nd);
    }
    var curr = head;
    while node_next(n, curr) != -1 {
        curr = node_next(n, curr);
    }
    n = set_next(n, curr, nd);
    n = set_prev(n, nd, curr);
    (n, head)
}

// Delete node with given value, returns the pool and the new head
fn delete_val(var n: Vec<i64>, head: i64, val: i64) -> (Vec<i64>, i64) {
    var curr = head;
    var new_head = head;
    var found = 0;
    while curr != -1 {
        if node_val(n, curr) == val {
            if found == 0 {
                found = 1;
                let p = node_prev(n, curr);
                let nx = node_next(n, curr);
                if p != -1 {
                    n = set_next(n, p, nx);
                } else {
                    new_head = nx;
                }
                if nx != -1 {
                    n = set_prev(n, nx, p);
                }
            }
        }
        curr = node_next(n, curr);
    }
    (n, new_head)
}

fn traverse_forward(n: Vec<i64>, head: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec.new();
    var curr = head;
    while curr != -1 {
        result.push(node_val(n, curr));
        curr = node_next(n, curr);
    }
    result
}

fn traverse_backward(n: Vec<i64>, head: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec.new();
    if head == -1 {
        return result;
    }
    var curr = head;
    while node_next(n, curr) != -1 {
        curr = node_next(n, curr);
    }
    while curr != -1 {
        result.push(node_val(n, curr));
        curr = node_prev(n, curr);
    }
    result
}

fn vecs_equal(a: Vec<i64>, b: Vec<i64>) -> i64 {
    if a.len() != b.len() {
        return 0;
    }
    for i in 0 .. a.len() {
        if a[i] != b[i] {
            return 0;
        }
    }
    1
}

// Build a list by inserting each value at the front; returns pool and head.
fn build_front(vals: Vec<i64>) -> (Vec<i64>, i64) {
    var n: Vec<i64> = Vec.new();
    var head = -1;
    for val in vals {
        let (grown, new_head) = insert_front(n, head, val);
        n = grown;
        head = new_head;
    }
    (n, head)
}

// Build a list by appending each value; returns pool and head.
fn build_back(vals: Vec<i64>) -> (Vec<i64>, i64) {
    var n: Vec<i64> = Vec.new();
    var head = -1;
    for val in vals {
        let (grown, new_head) = insert_back(n, head, val);
        n = grown;
        head = new_head;
    }
    (n, head)
}

fn test_insert_front() -> i64 {
    let (n, head) = build_front([30, 20, 10]);
    let r = traverse_forward(n, head);
    var e: Vec<i64> = Vec.new();
    e.push(10);
    e.push(20);
    e.push(30);
    if vecs_equal(r, e) == 1 {
        println("PASS: insert_front");
        return 1;
    }
    println("FAIL: insert_front");
    0
}

fn test_insert_back() -> i64 {
    let (n, head) = build_back([10, 20, 30]);
    let r = traverse_forward(n, head);
    var e: Vec<i64> = Vec.new();
    e.push(10);
    e.push(20);
    e.push(30);
    if vecs_equal(r, e) == 1 {
        println("PASS: insert_back");
        return 1;
    }
    println("FAIL: insert_back");
    0
}

fn test_backward_traverse() -> i64 {
    let (n, head) = build_back([10, 20, 30]);
    let r = traverse_backward(n, head);
    var e: Vec<i64> = Vec.new();
    e.push(30);
    e.push(20);
    e.push(10);
    if vecs_equal(r, e) == 1 {
        println("PASS: backward traverse");
        return 1;
    }
    println("FAIL: backward traverse");
    0
}

fn test_delete() -> i64 {
    let (built, built_head) = build_back([10, 20, 30]);
    let (n, head) = delete_val(built, built_head, 20);
    let fwd = traverse_forward(n, head);
    var ef: Vec<i64> = Vec.new();
    ef.push(10);
    ef.push(30);
    let bwd = traverse_backward(n, head);
    var eb: Vec<i64> = Vec.new();
    eb.push(30);
    eb.push(10);
    if vecs_equal(fwd, ef) == 1 {
        if vecs_equal(bwd, eb) == 1 {
            println("PASS: delete + bidirectional");
            return 1;
        }
    }
    println("FAIL: delete + bidirectional");
    0
}

fn test_delete_head() -> i64 {
    let (built, built_head) = build_back([10, 20]);
    let (n, head) = delete_val(built, built_head, 10);
    if node_val(n, head) == 20 {
        if node_prev(n, head) == -1 {
            println("PASS: delete head");
            return 1;
        }
    }
    println("FAIL: delete head");
    0
}

fn test_delete_tail() -> i64 {
    let (built, built_head) = build_back([10, 20]);
    let (n, head) = delete_val(built, built_head, 20);
    let r = traverse_forward(n, head);
    if r.len() == 1 {
        if r[0] == 10 {
            println("PASS: delete tail");
            return 1;
        }
    }
    println("FAIL: delete tail");
    0
}

fn main() {
    println("=== Doubly Linked List Tests ===");
    var passed = 0;
    let total = 6;
    passed = passed + test_insert_front();
    passed = passed + test_insert_back();
    passed = passed + test_backward_traverse();
    passed = passed + test_delete();
    passed = passed + test_delete_head();
    passed = passed + test_delete_tail();
    println("");
    print("Passed: ");
    print(passed);
    println(f"/{total}");
    if passed == total {
        println("OVERALL: PASS");
    } else {
        println("OVERALL: FAIL");
    }
}
