type Key {
    label: string,
    divisor: i64,
}

impl Hash for Key {
    fn hash(self) -> i64 {
        let local = self.label.to_upper();
        let bytes = local.to_bytes();
        bytes.len() / self.divisor
    }
}

actor Store {
    var values: HashMap<Key, Vec<string>> = HashMap.new(),

    receive fn put(divisor: i64) {
        // The seat leaves by take. A trapping key hash consumes the receiver
        // on the failure edge, so the handler unwinds with the seat empty and
        // the actor's release must close the field exactly once.
        values.insert(
            Key { label: "key".to_upper(), divisor: divisor },
            ["payload".to_upper()],
        );
    }

    receive fn size() -> i64 {
        values.len()
    }
}

fn main() -> i64 {
    let store = spawn Store;

    // A sound key populates the seat first, so the trapping insert unwinds
    // with a live map behind it rather than an empty one.
    let _ = store.put(1);

    match store.put(0) {
        .Ok(_v) => {
            println("unexpected acceptance");
            1
        }
        .Err(_e) => {
            println("faulted");
            0
        }
    }
}
