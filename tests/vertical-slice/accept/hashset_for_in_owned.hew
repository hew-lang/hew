// A HashSet<string> produces an owned snapshot through IntoIterator.
// The VecIter cursor owns the snapshot and each yielded string is dropped at
// iteration-scope exit. Elements "aa", "bbb", "cccc" have total length 9.
pub fn main() -> i64 {
    var s: HashSet<string> = HashSet.new();
    s.insert("aa");
    s.insert("bbb");
    s.insert("cccc");
    var total_len = 0;
    var count = 0;
    for x in s {
        total_len = total_len + x.len();
        count = count + 1;
    }
    if count != 3 {
        return 100 + count;
    }
    total_len
}
