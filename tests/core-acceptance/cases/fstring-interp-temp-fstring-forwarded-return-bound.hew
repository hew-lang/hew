fn passthru(value: string) -> string { value }
fn main() -> i64 {
    var i: i64 = 0;
    var total: i64 = 0;
    while i < 50 {
        let returned = passthru(f"owned-carrier-token-{i}");
        println(f"value={returned}");
        total = total + i;
        i = i + 1;
    }
    if total != 1225 { return 82; }
    0
}
