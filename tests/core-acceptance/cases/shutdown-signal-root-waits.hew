// After a default termination request, main keeps waiting on the handles it
// already holds, while new root work and actor calls are refused.
import std.io;
import std.net;
import std.os;
import std.process;

actor Counter {
    receive fn bump() -> i64 {
        1
    }
}

fn main() {
    let counter = spawn Counter();
    let listener = net.listen("127.0.0.1:0").expect("listen");
    let client = net.connect(f"127.0.0.1:{listener.local_port()}").expect("connect");
    let conn = listener.accept();
    let child = process.start(process.command("sh", ["-c", "sleep 0.2; exit 3"])).expect("start");

    let _ = process.run(f"kill -TERM {os.pid()}").expect("kill");
    while counter.bump().is_ok() {
        sleep(1ms);
    }
    println("call refused");

    client.send("late".to_bytes()).expect("send on an open connection");
    match conn.recv() {
        .Some(data) => println(f"recv {data.len()} bytes"),
        .None => println("recv end"),
    }
    conn.close();
    match client.recv() {
        .Some(_) => println("client data"),
        .None => println("client end"),
    }
    client.close();
    match child.wait() {
        .Ok(status) => println(f"child {status}"),
        .Err(e) => println(f"child wait failed {e}"),
    }
    match io.read_line() {
        .Some(_) => println("stdin line"),
        .None => println("stdin end"),
    }

    match process.start(process.command("true", [])) {
        .Ok(_) => println("start admitted"),
        .Err(.LaunchFailed(_)) => println("start refused"),
        .Err(e) => println(f"start failed {e}"),
    }
    match process.run("true") {
        .Ok(_) => println("run admitted"),
        .Err(.LaunchFailed(_)) => println("run refused"),
        .Err(e) => println(f"run failed {e}"),
    }
    match net.connect(f"127.0.0.1:{listener.local_port()}") {
        .Ok(_) => println("connect admitted"),
        .Err(.Cancelled(_)) => println("connect cancelled"),
        .Err(e) => println(f"connect failed {e}"),
    }
    match net.listen("127.0.0.1:0") {
        .Ok(_) => println("listen admitted"),
        .Err(.Cancelled(_)) => println("listen cancelled"),
        .Err(e) => println(f"listen failed {e}"),
    }
    listener.close();
}
