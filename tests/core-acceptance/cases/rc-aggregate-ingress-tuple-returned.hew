type Node { id: i64, }

fn frame(seed: i64) -> (Rc<Node>, string) {
    let shared: Rc<Node> = Rc.new(Node { id: seed });
    (shared, "tag")
}

fn main() -> i64 {
    var total: i64 = 0;
    for seed in 0..50 {
        let pair = frame(seed);
        total = total + pair.1.len();
        println("frame");
    }
    total - 50 * 3
}
