// A `receive gen fn` producer that crashes mid-stream must fault-close
// the stream — never a silent, clean EOF. The gen body yields one value, then
// traps on a runtime div-by-zero; the consumer, having already received the
// first value, observes the fault on its next resume rather than a clean
// `None`.
actor Emitter {
    receive gen fn ticks() -> i64 {
        yield 1;
        let zero: i64 = 0;
        let bad = 1 / zero;
        yield bad;
    }
    receive fn ping() {}
}

fn main() {
    let e = spawn Emitter;
    for v in e.ticks() {
        println(f"{v}");
        // The producer runs ahead into its fault; a call queued behind its
        // turn returns only after the crash report printed, so the next
        // resume observes the fault second and the two stderr lines have
        // one order.
        let _ = e.ping();
    }
    println("unreached-eof");  // the consumer traps first; this must not print
}
