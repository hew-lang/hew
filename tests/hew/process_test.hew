//! Tests for std::process argument handling.

import std.fs;

import std.process;

import std.string;

import std.testing;

import std.time.datetime;

fn cleanup_file(file_path: string) {
    if fs.exists(file_path) {
        let _ = fs.delete(file_path);
    }
}

fn kill_zero_exit_code(pid: string) -> i64 {
    let args: Vec<string> = Vec.new();
    args.push("-0");
    args.push(pid);
    process.run_argv("kill", args).expect("failed to run kill probe").exit_code
}

fn read_pid_with_retry(pid_path: string) -> string {
    var attempts = 0;
    while attempts < 50 {
        if fs.exists(pid_path) {
            return string.trim(fs.read(pid_path));
        }
        sleep(100ms);
        attempts = attempts + 1;
    }
    panic("expected child to write its pid file");
    ""
}

fn spawn_child_for_implicit_drop(pid_path: string) -> string {
    let child = process.start(f"echo $$ > {pid_path}; sleep 60").expect("failed to start child");
    let pid = read_pid_with_retry(pid_path);
    testing.assert_true(kill_zero_exit_code(pid) == 0);
    pid
}

#[test]
fn test_try_run_argv_preserves_spaced_and_empty_arguments() {
    let args: Vec<string> = Vec.new();
    args.push("<%s>|<%s>|<%s>");
    args.push("hello world");
    args.push("");
    args.push("tail");
    match process.run_argv("printf", args) {
        .Ok(output) => {
            testing.assert_true(output.exit_code == 0);
            testing.assert_eq_str(output.stdout, "<hello world>|<>|<tail>");
            testing.assert_eq_str(output.stderr, "");
        },
        .Err(_) => panic("expected try_run_argv to succeed"),
    }
}

#[test]
fn test_try_run_args_rejects_mismatched_arg_count_with_guidance() {
    match process.run_args("printf", "one two", 1) {
        .Ok(_) => panic("expected arg_count mismatch"),
        .Err(err) => match err {
            ProcessError.InvalidArguments(message) => {
                testing.assert_true(message.contains("arg_count"));
                testing.assert_true(message.contains("process.run_argv"));
            },
            _ => panic("expected ProcessError::InvalidArguments"),
        },
    }
}

#[test]
fn test_run_argv_replaces_legacy_run_args_usage() {
    let args: Vec<string> = Vec.new();
    args.push("<%s>|<%s>");
    args.push("alpha");
    args.push("beta");
    let output = process.run_argv("printf", args).expect("failed to run printf");
    testing.assert_true(output.exit_code == 0);
    testing.assert_eq_str(output.stdout, "<alpha>|<beta>");
    testing.assert_eq_str(output.stderr, "");
}

#[test]
fn test_try_run_argv_missing_command_returns_launch_failed() {
    let args: Vec<string> = Vec.new();
    match process.run_argv("hew-process-command-that-does-not-exist", args) {
        .Ok(_) => panic("expected missing command error"),
        .Err(err) => match err {
            ProcessError.LaunchFailed(_) => {},
            _ => panic("expected ProcessError::LaunchFailed"),
        },
    }
}

#[test]
fn test_launch_classification_does_not_trust_attacker_controlled_command_text() {
    let args: Vec<string> = Vec.new();
    match process.run_argv("hew-missing-arg_count-args[0]-command", args) {
        .Ok(_) => panic("expected missing command error"),
        .Err(err) => match err {
            ProcessError.LaunchFailed(_) => {},
            _ => panic("command substrings must not change a launch failure into InvalidArguments"),
        },
    }
}

#[test]
fn test_try_run_argv_missing_command_preserves_real_error() {
    // Regression for #2506: the cooperative-yield checkpoint at
    // last_process_error's function entry must not clobber the real
    // launch-failure text with the "execution context not installed"
    // sentinel when main() has no installed execution context.
    // Cross-platform: a nonexistent command fails to launch
    // (ENOENT-equivalent) on every OS, so no Unix-only tool is used.
    let args: Vec<string> = Vec.new();
    match process.run_argv("hew-process-command-that-does-not-exist-2506", args) {
        .Ok(_) => panic("expected missing command to fail to launch"),
        .Err(err) => match err {
            ProcessError.LaunchFailed(message) => {
                testing.assert_true(!message.contains("execution context not installed"));
                testing.assert_true(message.contains("failed to execute"));
            },
            _ => panic("expected ProcessError::LaunchFailed"),
        },
    }
}

#[test]
fn test_child_drop_reaps_running_process() {
    let pid_path = f"tests/hew/_process_drop_{datetime.now_nanos()}.pid";
    cleanup_file(pid_path);
    let pid = spawn_child_for_implicit_drop(clone pid_path);
    var attempts = 0;
    var reaped = false;
    while attempts < 50 {
        if kill_zero_exit_code(pid) != 0 {
            reaped = true;
            break;
        }
        sleep(100ms);
        attempts = attempts + 1;
    }
    cleanup_file(pid_path);
    testing.assert_true(reaped);
}

// ── launch failure truth ────────────────────────────────────────────────
//
// #16: `process.start` handed back the raw spawn handle, so a failed launch
// became a `Child` that was never backed by a process. Waiting on it or
// killing it reported -1 forever with no way to tell that apart from a real
// child that failed.
#[test]
fn test_try_start_argv_reports_a_missing_executable_as_launch_failed() {
    let args: Vec<string> = Vec.new();
    args.push("--version");
    match process.start_argv("hew-process-executable-that-does-not-exist", args) {
        .Ok(child) => {
            child.kill();
            panic("expected a missing executable to fail to launch");
        },
        .Err(err) => match err {
            ProcessError.LaunchFailed(message) => {
                testing.assert_true(message.contains("failed to execute"));
                testing.assert_true(message.contains("hew-process-executable-that-does-not-exist"));
            },
            _ => panic("expected ProcessError::LaunchFailed"),
        },
    }
}

#[test]
fn test_try_start_argv_returns_a_live_child_for_a_real_executable() {
    let args: Vec<string> = Vec.new();
    args.push("hew-process-start-argv-live");
    match process.start_argv("echo", args) {
        .Ok(child) => testing.assert_true(child.wait() == 0),
        .Err(_) => panic("expected echo to launch"),
    }
}

#[test]
fn test_try_start_returns_a_live_child_for_a_shell_command() {
    match process.start("exit 7") {
        .Ok(child) => testing.assert_true(child.wait() == 7),
        .Err(_) => panic("expected the shell command to launch"),
    }
}

// ── Display ────────────────────────────────────────────────────────────────
#[test]
fn test_process_error_display_prints_the_carried_detail() {
    let invalid_arguments = ProcessError.InvalidArguments("boom");
    testing.assert_eq_str(to_string(invalid_arguments), "boom");
    let launch_failed = ProcessError.LaunchFailed("could not exec");
    testing.assert_eq_str(to_string(launch_failed), "could not exec");
}
