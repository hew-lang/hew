type Handler { action: fn(i64) -> i64, }
fn make_adder(n: i64) -> fn(i64) -> i64 { |x: i64| x + n }
fn use_then_drop(consume f: fn(i64) -> i64) -> i64 {
    let h = Handler { action: f };
    h.action(1)
}
fn run_loop(frames: i64) -> i64 {
    var total: i64 = 0;
    for i in 0..frames { total = total + use_then_drop(make_adder(i)); }
    total
}
fn main() -> i64 {
    let total = run_loop(50);
    if total != 1275 { return 82; }
    0
}
