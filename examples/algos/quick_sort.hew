// Quick Sort - partition around pivot, sort sub-arrays
// A parameter is the callee's own copy, so every helper that mutates the
// vector returns it (partition also reports the pivot index) and the
// caller reassigns.
fn swap(var v: Vec<i64>, i: i64, j: i64) -> Vec<i64> {
    let tmp = v[i];
    v.set(i, v[j]);
    v.set(j, tmp);
    v
}

fn partition(var v: Vec<i64>, lo: i64, hi: i64) -> (Vec<i64>, i64) {
    let pivot = v[hi];
    var i = lo;
    var j = lo;
    while j < hi {
        if v[j] < pivot {
            v = swap(v, i, j);
            i = i + 1;
        }
        j = j + 1;
    }
    v = swap(v, i, hi);
    (v, i)
}

fn quicksort_range(var v: Vec<i64>, lo: i64, hi: i64) -> Vec<i64> {
    if lo < hi {
        let (partitioned, p) = partition(v, lo, hi);
        v = partitioned;
        if p > 0 {
            v = quicksort_range(v, lo, p - 1);
        }
        v = quicksort_range(v, p + 1, hi);
    }
    v
}

fn quick_sort(var v: Vec<i64>) -> Vec<i64> {
    let n = v.len();
    if n >= 2 {
        v = quicksort_range(v, 0, n - 1);
    }
    v
}

fn vec_eq(a: Vec<i64>, b: Vec<i64>) -> i64 {
    if a.len() != b.len() {
        return 0;
    }
    var i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return 0;
        }
        i = i + 1;
    }
    1
}

fn make_vec_5(a: i64, b: i64, c: i64, d: i64, e: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec.new();
    v.push(a);
    v.push(b);
    v.push(c);
    v.push(d);
    v.push(e);
    v
}

fn run_test(name: string, var input: Vec<i64>, expected: Vec<i64>) -> i64 {
    input = quick_sort(input);
    let pass = vec_eq(input, expected);
    if pass == 1 {
        println(f"Test {name} ... PASS");
    } else {
        println(f"Test {name} ... FAIL");
    }
    pass
}

fn main() {
    var total = 0;
    var passed = 0;
    total = total + 1;
    passed = passed + run_test("reverse", make_vec_5(5, 4, 3, 2, 1), make_vec_5(1, 2, 3, 4, 5));
    total = total + 1;
    passed = passed + run_test("sorted", make_vec_5(1, 2, 3, 4, 5), make_vec_5(1, 2, 3, 4, 5));
    total = total + 1;
    passed = passed + run_test("duplicates", make_vec_5(3, 1, 3, 1, 2), make_vec_5(1, 1, 2, 3, 3));
    total = total + 1;
    var single: Vec<i64> = Vec.new();
    single.push(42);
    var exp_single: Vec<i64> = Vec.new();
    exp_single.push(42);
    passed = passed + run_test("single", single, exp_single);
    total = total + 1;
    let empty: Vec<i64> = Vec.new();
    let exp_empty: Vec<i64> = Vec.new();
    passed = passed + run_test("empty", empty, exp_empty);
    println(f"{passed}/{total} tests passed");
    if passed == total {
        println("ALL PASS");
    } else {
        println("SOME FAIL");
    }
}
