//! A bounded TCP listener running as a supervised actor.
//!
//! `net.Listener.accept()` is a reactor-backed suspending call. It parks the
//! actor turn while keeping the scheduler worker free. A fork or another
//! ordinary actor is not generic isolation for a synchronous foreign call;
//! this example uses the networking operation whose runtime contract provides
//! suspension and cancellation.
//!
//! The acceptor keeps at most two live clients and has a one-message mailbox.
//! It transfers each admitted connection's ownership to the active-mode
//! reactor with `attach(self)`. The third accepted client is closed as
//! overload. Stopping `Service` cancels the fourth, blocked accept, drains the
//! queued input, and closes both reactor-owned connections.

import std.net.{ConnectionHandler};

import std.stream;

actor Events {
    let output: stream.Sink<string>;

    receive fn mark(event: string) {
        output.send(event).expect("event receiver remains live");
    }
}

actor Acceptor {
    mailbox 1 overflow fail;
    let address: string;
    let events: Events;

    receive fn start() {
        let listener = net.listen(address).expect("listen");
        events.mark(f"port {listener.local_port()}").expect("record port");

        for index in 1 .. 4 {
            let conn = listener.accept();
            events.mark(f"accepted {index}").expect("record acceptance");
            if index <= 2 {
                conn.attach(self).expect("attach admitted client");
                events.mark(f"attached {index}").expect("record transfer");
            } else {
                conn.close();
                events.mark(f"overload {index}").expect("record overload");
            }
        }

        // Main waits for this event before probing scheduler progress and
        // stopping the supervisor, so this fourth accept is known to be idle.
        events.mark("accepting").expect("record blocked accept");
        let unexpected = listener.accept();
        unexpected.close();
        panic("fourth connection unexpectedly arrived");
    }

    receive fn on_data(data: bytes) {
        // Main fills this one-message mailbox while `start` is suspended in
        // accept. Shutdown drains the owned payload without dispatching it.
        println(f"unexpected dispatch of {data.len()} bytes");
    }

    receive fn on_close() {
        println("unexpected close dispatch");
    }
}

impl ConnectionHandler for Acceptor {
    fn on_data(data: bytes) {}
    fn on_close() {}
}

actor Probe {
    receive fn ping() {
        println("scheduler live");
    }
}

supervisor Service(events: Events) {
    strategy: one_for_one;
    intensity: 3 within 60s;
    child acceptor: Acceptor(address: "127.0.0.1:0", events: events);
}

fn next(events: stream.Stream<string>) -> string {
    match events.recv() {
        .Some(actual) => actual,
        .None => panic("event stream closed"),
    }
}

fn expect(events: stream.Stream<string>, expected: string) {
    assert(next(events) == expected);
}

fn expect_server_closed(consume conn: net.Connection) {
    if let .Some(_) = conn.recv() {
        panic("server sent unexpected data");
    }
    conn.close();
}

fn main() {
    let (event_output, event_input): (stream.Sink<string>, stream.Stream<string>) =
        stream.pipe(8).expect("event pipe");
    let events = spawn Events(output: event_output);
    let service = spawn Service(events: events);
    let probe = spawn Probe;

    mailbox(service.acceptor, on_full: .Wait).start().expect("start acceptor");
    let port_event = next(event_input);
    let address = "127.0.0.1:" + port_event.slice(5, port_event.len());

    let first = net.connect(address).expect("first client");
    expect(event_input, "accepted 1");
    expect(event_input, "attached 1");

    let second = net.connect(address).expect("second client");
    expect(event_input, "accepted 2");
    expect(event_input, "attached 2");

    let third = net.connect(address).expect("third client");
    expect(event_input, "accepted 3");
    expect(event_input, "overload 3");
    expect(event_input, "accepting");
    expect_server_closed(third);

    // Fill the acceptor's bounded queue while its active turn remains parked.
    first.send("queued input".to_bytes()).expect("queue active-mode input");

    // With one scheduler worker, this can run only if accept parks on the
    // reactor. Both attached clients are still active at this point.
    probe.ping().expect("scheduler remains responsive");

    stop(service);
    stopped(service);
    println("supervisor stopped");

    expect_server_closed(first);
    expect_server_closed(second);
    println("connections closed");

    event_input.close();
    stop(events);
    stopped(events);
    stop(probe);
    stopped(probe);
}

