// Every branch transfers or explicitly closes its resource exactly once.
// A consuming method owns self until method exit, where normal cleanup runs.
#[resource]
type Conn {
    fd: i64,
}

impl Conn {
    fn close(consume self) {
        print(self.fd);
        println(" closed");
    }
    fn finish(consume self) -> i64 {
        self.fd
    }
}

fn finish_on_either_path(flag: bool) -> i64 {
    let held = Conn { fd: 10 };
    if flag {
        return held.finish();
    }
    held.finish()
}

fn close_then_return(flag: bool) -> i64 {
    let held = Conn { fd: 11 };
    if flag {
        held.close();
        return 1;
    }
    held.close();
    0
}

fn let_else_cleanup(o: Option<i64>) -> i64 {
    let held = Conn { fd: 12 };
    let .Some(v) = o else {
        held.close();
        return -1;
    };
    held.close();
    v
}

fn mixed_arms(n: i64) -> i64 {
    let held = Conn { fd: 13 };
    match n {
        0 => {
            held.finish()
        },
        1 => {
            held.close();
            100
        },
        _ => {
            return held.finish();
        },
    }
}

fn main() {
    print(finish_on_either_path(true));
    println("");
    print(finish_on_either_path(false));
    println("");
    print(close_then_return(true));
    println("");
    print(close_then_return(false));
    println("");
    print(let_else_cleanup(Some(7)));
    println("");
    print(let_else_cleanup(None));
    println("");
    print(mixed_arms(0));
    println("");
    print(mixed_arms(1));
    println("");
    print(mixed_arms(2));
    println("");
}
