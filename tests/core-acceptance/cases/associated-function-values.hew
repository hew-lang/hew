type Holder<T> {
    value: T;
}

impl<T> Holder<T> {
    fn make(value: T) -> Holder<T> {
        Holder { value: value }
    }
    fn pair<U>(value: T, other: U) -> (T, U) {
        (value, other)
    }
}

fn main() {
    let make = Holder<i64>.make;
    println(make(5).value);
    let inferred = Holder.make;
    println(inferred("warm").value);
    let both = Holder<i64>.pair<string>;
    let (number, label) = both(7, "both");
    println(f"{number} {label}");
    let partial = Holder<i64>.pair;
    let (count, description) = partial(8, "partial");
    println(f"{count} {description}");
}
