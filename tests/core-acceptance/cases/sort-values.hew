import std.sort;

type Entry {
    rank: i64;
    label: string;
}

fn check_ints() -> i64 {
    var reverse: Vec<i64> = Vec.new();
    for i in 0..1024 {
        reverse.push(1023 - i);
    }
    let comparisons = 0;
    let reverse_out = sort.sort_by(reverse, capture(var comparisons) |a: i64, b: i64| {
        comparisons += 1;
        assert(comparisons <= 1024 * 10);
        a < b
    });
    for i in 0..1024 {
        if reverse_out[i] != i {
            return 11;
        }
        if reverse[i] != 1023 - i {
            return 12;
        }
    }
    var non_power: Vec<i64> = Vec.new();
    for i in 0..17 {
        non_power.push((i * 7) % 5);
    }
    let non_power_out = sort.sort(non_power);
    var before_sum = 0;
    var after_sum = 0;
    var before_squares = 0;
    var after_squares = 0;
    for i in 0..17 {
        if i > 0 && non_power_out[i - 1] > non_power_out[i] {
            return 13;
        }
        before_sum = before_sum + non_power[i];
        after_sum = after_sum + non_power_out[i];
        before_squares = before_squares + non_power[i] * non_power[i];
        after_squares = after_squares + non_power_out[i] * non_power_out[i];
        if non_power[i] != (i * 7) % 5 {
            return 14;
        }
    }
    if before_sum != after_sum || before_squares != after_squares {
        return 15;
    }
    var equal: Vec<i64> = Vec.new();
    for _i in 0..33 {
        equal.push(7);
    }
    let equal_out = sort.sort(equal);
    for i in 0..33 {
        if equal_out[i] != 7 || equal[i] != 7 {
            return 16;
        }
    }
    0
}

fn reverse_key(i: i64) -> string {
    match i % 8 {
        0 => "hotel",
        1 => "golf",
        2 => "foxtrot",
        3 => "echo",
        4 => "delta",
        5 => "charlie",
        6 => "bravo",
        _ => "alpha",
    }
}

fn check_strings() -> i64 {
    var duplicate_reverse: Vec<string> = Vec.new();
    for i in 0..256 {
        duplicate_reverse.push(reverse_key(i));
    }
    let comparisons = 0;
    let out = sort.sort_by(duplicate_reverse, capture(var comparisons) |a: string, b: string| {
        comparisons += 1;
        assert(comparisons <= 256 * 8);
        a < b
    });
    for i in 1..256 {
        if out[i - 1] > out[i] {
            return 21;
        }
    }
    for i in 0..32 {
        if out[i] != "alpha" {
            return 22;
        }
        if out[32 + i] != "bravo" {
            return 23;
        }
        if out[64 + i] != "charlie" {
            return 24;
        }
        if out[96 + i] != "delta" {
            return 25;
        }
        if out[128 + i] != "echo" {
            return 26;
        }
        if out[160 + i] != "foxtrot" {
            return 27;
        }
        if out[192 + i] != "golf" {
            return 28;
        }
        if out[224 + i] != "hotel" {
            return 29;
        }
    }
    if duplicate_reverse[0] != "hotel" || duplicate_reverse[7] != "alpha" {
        return 30;
    }
    if duplicate_reverse[248] != "hotel" || duplicate_reverse[255] != "alpha" {
        return 31;
    }
    var non_power: Vec<string> = Vec.new();
    for i in 0..17 {
        let value = match i % 3 {
            0 => "charlie",
            1 => "alpha",
            _ => "bravo",
        };
        non_power.push(value);
    }
    let non_power_out = sort.sort_by(non_power, |a: string, b: string| a < b);
    for i in 1..17 {
        if non_power_out[i - 1] > non_power_out[i] {
            return 32;
        }
    }
    for i in 0..17 {
        let expected = match i % 3 {
            0 => "charlie",
            1 => "alpha",
            _ => "bravo",
        };
        if non_power[i] != expected {
            return 33;
        }
    }
    0
}

fn main() {
    let empty: Vec<i64> = [];
    assert(sort.sort(empty).is_empty());
    assert(sort.reverse(empty).is_empty());
    let single: Vec<i64> = [9];
    assert(sort.sort(single)[0] == 9);
    assert(sort.reverse(single)[0] == 9);
    let numbers: Vec<i32> = [3, -1, 2];
    let ordered = sort.sort(numbers);
    let reversed = sort.reverse(ordered);
    assert(ordered[0] == -1 && ordered[2] == 3);
    assert(reversed[0] == 3 && reversed[2] == -1);
    assert(numbers[0] == 3 && numbers[1] == -1);
    let words: Vec<string> = ["🙂", "é", "Ω", "é"];
    let ordered_words = sort.sort(words);
    let reversed_words = sort.reverse(ordered_words);
    assert(ordered_words[0] == "é" && ordered_words[3] == "🙂");
    assert(reversed_words[0] == "🙂" && reversed_words[3] == "é");
    assert(words[0] == "🙂" && words[1] == "é");
    let entries: Vec<Entry> = [Entry { rank: 2, label: "last" }, Entry { rank: 1, label: "first" }, Entry { rank: 1, label: "second" }];
    let stable = sort.sort_by(entries, |a: Entry, b: Entry| a.rank < b.rank);
    assert(stable[0].label == "first" && stable[1].label == "second");
    assert(entries[0].label == "last");
    let int_status = check_ints();
    if int_status != 0 {
        println(f"sort-authority={int_status}");
        return;
    }
    let string_status = check_strings();
    if string_status != 0 {
        println(f"sort-authority={string_status}");
        return;
    }
    println("sort-authority=0");
}
