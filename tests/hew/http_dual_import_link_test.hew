//! HTTP request timeout configuration reports invalid values explicitly.

import std.net.http.server as http;

#[test]
#[real_time]
fn test_request_timeout_rejects_nonpositive_values() {
    let server = http.listen("127.0.0.1:0").expect("listen");
    assert(server.set_request_timeout(0ns).is_err());
    assert(server.set_request_timeout(-1ns).is_err());
    assert(server.set_request_timeout(1ns).is_ok());
    assert(server.set_request_timeout(1s).is_ok());
}
