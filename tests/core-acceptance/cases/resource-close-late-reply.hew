import std.stream;

actor Audit {
    var created: i64 = 0,
    var closed: i64 = 0,
    var last: i64 = 0,
    receive fn create(id: i64) {
        created += 1;
    }
    receive fn record(id: i64) {
        sleep(1ms);
        closed += 1;
        last = id;
    }
    // Every ticket the worker created must have closed before the worker
    // accepted its next message.
    receive fn receipt() -> i64 {
        assert(created == closed);
        closed
    }
    receive fn last_closed() -> i64 {
        last
    }
}

#[resource]
type Ticket {
    audit: Audit,
    id: i64,
}

impl Ticket {
    fn close(consume self) {
        self.audit.record(self.id).expect("audit");
    }
}

actor Worker {
    // Holds the ticket until the caller releases the gate, which it does only
    // after its own deadline has passed.
    receive fn create(audit: Audit, gate: stream.Stream<i64>) -> Ticket {
        audit.create(9).expect("audit");
        gate.recv();
        Ticket { audit: audit, id: 9 }
    }
    receive fn ready() {}
}

fn main() {
    let audit = spawn Audit;
    let worker = spawn Worker;
    // A deadline withdraws a request the worker has not dispatched yet, so no
    // ticket exists on that leg. Repeat until the worker dispatched the request
    // and the caller's deadline left the late reply with the handler; a
    // dispatched request always leaves it, because its gate opens only after
    // the deadline.
    var late = false;
    var closed_before = 0;
    while !late {
        var timed_out = false;
        let (release, gate): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("gate");
        scope within 2ms {
            let ticket = worker.create(audit, gate).expect("created");
            assert(ticket.id == 9);
        } handle failure {
            match failure {
                .Deadline { message } => {
                    timed_out = true;
                },
                .Fault { message } => panic(message),
            }
        };
        // A withdrawn request took its gate with it, so the release may find
        // no reader.
        let _ = release.send(1);
        worker.ready().expect("ready");
        let closed = audit.receipt().expect("receipt");
        late = timed_out && closed > closed_before;
        closed_before = closed;
    }
    println("deadline");
    let last = audit.last_closed().expect("last");
    assert(last == 9);
    println(f"closed {last}");
    println("ready");
    close(worker);
    close(audit);
}
