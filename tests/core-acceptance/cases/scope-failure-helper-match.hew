// A `ScopeFailure` passed to a helper by its written type matches on the same
// declaration the handler binding carries.
import std.stream;

fn verdict(failure: ScopeFailure) -> string {
    match failure {
        .Deadline { message } => if message.contains("Deadline") { "deadline" } else { "bad deadline" },
        .Fault { message } => if message.contains("boom") { "fault boom" } else { "bad fault" },
    }
}

fn main() {
    let (_never, gate): (stream.Sink<i64>, stream.Stream<i64>) = stream.pipe(1).expect("gate");
    let late = scope within 20ms {
        gate.recv();
        "done"
    } handle failure {
        verdict(failure)
    };
    println(late);
    let broken = scope {
        panic("boom");
        "done"
    } handle failure {
        verdict(failure)
    };
    println(broken);
}
