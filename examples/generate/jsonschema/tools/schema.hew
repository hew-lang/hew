// A small object-schema generator. Unsupported shapes fail before any output
// is published; the generation driver also parses and formats the result.
import std.encoding.json;

import std.fs;

import std.os;

import std.sort;

type Property {
    #[serial(key = "type")]
    kind: string;
}

type Schema {
    title: string;
    #[serial(key = "type")]
    kind: string;
    properties: HashMap<string, Property>;
    required: Vec<string>;
}

fn identifier(name: string) -> bool {
    let chars = name.chars();
    if chars.is_empty() {
        return false;
    }
    for index in 0..chars.len() {
        let c = chars[index];
        let letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
        if !letter && !(index > 0 && c >= '0' && c <= '9') {
            return false;
        }
    }
    true
}

fn hew_type(kind: string) -> string {
    match kind {
        "string" => "string",
        "integer" => "i64",
        "number" => "f64",
        "boolean" => "bool",
        _ => panic("this generator supports scalar object properties"),
    }
}

fn main() {
    let args = os.args();
    let text = fs.read(args[1]).expect("read JSON schema");
    let schema = json.decode<Schema>(text).expect("decode JSON schema");
    assert(schema.kind == "object");
    assert(identifier(schema.title));
    var source = "// @generated by hew generate (schema) from schema.json; do not edit\npub type " + schema.title + " {\n";
    for name in sort.sort_strings(schema.properties.keys()) {
        assert(identifier(name));
        let property = schema.properties.get(name).expect("known schema property");
        let scalar = hew_type(property.kind);
        let field_type = if schema.required.contains(name) {
            scalar
        } else {
            "Option<" + scalar + ">"
        };
        source = source + "    " + name + ": " + field_type + ";\n";
    }
    source = source + "}\n";
    fs.write(args[2] + "/service.hew", source).expect("write generated model");
}
