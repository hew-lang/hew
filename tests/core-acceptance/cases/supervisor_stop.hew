// A supervisor accepts a graceful stop request and releases its child before
// stopped(sup) returns.
actor Worker {
    receive fn ping(_n: i64) {
        _n;
    }
}

supervisor AppSupervisor {
    strategy: one_for_one;
    intensity: 3 within 60s;

    child w1: Worker;
}

fn main() -> i64 {
    let sup = spawn AppSupervisor;
    let w = sup.w1;
    let _ = w.ping(1);
    stop(sup);
    stopped(sup);
    0
}
